// lib.cla: intern pool and numeric/character helpers shared by clarusc's
// self-hosted modules (Tasks 5-9).

var strPool: list of string
var strIndex: map of int

// intern returns s's index in the pool, adding it if not already present.
func intern(s: string): int {
    var idx: int

    if strIndex.has(s) {
        return strIndex.get(s, -1)
    }
    idx = strPool.count
    strPool.add(s)
    strIndex[s] = idx
    return idx
}

// internText interns the contents of a text buffer (the lexer builds token
// text as text, not string). text has no direct "+ string" conversion, so
// route it through the same byte-copy pattern used elsewhere for text ->
// string (Chapter 3: Byte copies).
func internText(t: text): int {
    var buf: char[255]
    var n: int
    var s: string

    n = t.toBytes(buf)
    s.fromBytes(buf, n)
    return intern(s)
}

func poolGet(i: int): string {
    return strPool[i]
}

// Diag is a compiler diagnostic: a position plus an interned message. Shared
// by every clarusc phase (lexer, parser, checker) so they all accumulate
// into one list and format identically (Task 5's retrofit onto lib.cla; see
// docs/superpowers/plans/2026-07-23-clarusc-v1.md Task 5).
record Diag {
    line: int
    col: int
    msgIdx: int
}

// diags accumulates compiler diagnostics across lex/parse/check within one
// file's compilation BY DESIGN. Between independent programs or files, callers
// must call resetDiags() to start fresh (Task 10's per-program loop owns this).
var diags: list of Diag

// diagPaths runs parallel to diags: diagPaths[i] is the interned path string
// diags[i] belongs to. It is filled automatically by emitDiag from curPathIdx
// -- the Clarus analogue of the Go checker's `c.f`, which every diagnostic is
// stamped with (internal/check/check.go errorf). The driver sets curPathIdx to
// the file currently being lexed/parsed (per file) and, in the check phase, to
// each top-level decl's owning file, so a check error in an INCLUDED file is
// attributed to that file, not the entry path.
var diagPaths: list of int
var curPathIdx: int

// emitDiag appends a diagnostic at line:col with message msg to the shared
// diags list, stamping it with curPathIdx (the current file). Diagnostics
// accumulate across lex/parse/check within one compilation; call resetDiags()
// between independent programs.
func emitDiag(line: int, col: int, msg: string) {
    var d: Diag

    d.line = line
    d.col = col
    d.msgIdx = intern(msg)
    diags.add(d)
    diagPaths.add(curPathIdx)
}

// resetDiags empties the global diags list (and its parallel path stamps).
// Call this between compiling independent programs or files to avoid
// cross-program diagnostic leakage.
func resetDiags() {
    while diags.count > 0 {
        diags.pop()
    }
    while diagPaths.count > 0 {
        diagPaths.pop()
    }
    while declFileTab.count > 0 {
        declFileTab.pop()
    }
    curPathIdx = 0
}

// declFileTab maps a decl arena index to the interned path of the file that
// decl was parsed from -- the per-decl file identity the Go checker carries on
// each deferredDecl (check.go). setDeclFile records it during include
// expansion; getDeclFile is read in the check phase to switch curPathIdx per
// top-level decl. -1 means "not recorded" (fall back to the current path).
var declFileTab: list of int

func setDeclFile(d: int, pathIdx: int) {
    while declFileTab.count <= d {
        declFileTab.add(-1)
    }
    declFileTab[d] = pathIdx
}

func getDeclFile(d: int): int {
    if d < 0 or d >= declFileTab.count {
        return -1
    }
    return declFileTab[d]
}

// formatDiag renders d as "path:line:col: message", matching
// internal/source.Diag.String().
func formatDiag(path: string, d: Diag): string {
    return path + ":" + numToStr(d.line) + ":" + numToStr(d.col) + ": " + poolGet(d.msgIdx)
}

// digitsOf renders the decimal digits of n (which may be negative or zero)
// most-significant-first, with no sign. Peeling digits off the original
// (possibly negative) n via mod/div avoids ever negating n directly, so
// int.min (whose negation overflows a 32-bit int) is handled safely.
func digitsOf(n: int): string {
    var d: int
    var rest: string

    if n == 0 {
        return ""
    }
    d = n mod 10
    if d < 0 {
        d = 0 - d
    }
    rest = digitsOf(n / 10)
    return rest + char(48 + d)
}

// numToStr renders n as signed decimal, matching Go's %d.
func numToStr(n: int): string {
    var s: string

    if n == 0 {
        return "0"
    }
    if n < 0 {
        s = "-"
    } else {
        s = ""
    }
    return s + digitsOf(n)
}

// isLetter, isDigit, isAlnum, and isIdentStart mirror
// internal/lexer/lexer.go's byte predicates exactly (isIdentStart excludes
// '_' — it's valid only as an identifier continuation character, not a
// start).
func isDigit(c: char): bool {
    return c >= '0' and c <= '9'
}

func isLetter(c: char): bool {
    return c == '_' or c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z'
}

func isIdentStart(c: char): bool {
    return c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z'
}

func isAlnum(c: char): bool {
    return isLetter(c) or isDigit(c)
}

// SPDX-License-Identifier: MIT

// macgui.cla: ClarusC.APPL, the Mac-resident compiler's GUI front end
// (Task 10, mac-resident-clarusc phase). Everything the phase built so
// far (the self-hosted clarusc pipeline, clarusc/*.cla) becomes a real
// Mac application: pick a .cla file with a real Standard File dialog,
// compile it with the SAME drive.cla pipeline main.cla's host CLI uses,
// and -- on a clean compile -- emit a native 68k application and write
// it to disk with file.writeRes.
//
// Own include block, deliberately the SAME module set as main.cla's own
// (lib/tok/lex/ast/parse/types/check/ir/lower/shake/asm68k/peep68k/
// app68k/res68k/cprint/cg68k/uiblob/drive), because this program IS the
// compiler, just with a GUI front end instead of a CLI one -- it needs
// the whole self-hosted pipeline as a library at runtime. main.cla NEVER
// includes this file (a separate emit68k build, scripts/build-clarusc-
// mac.sh, not part of the clarusc.c bootstrap snapshot's own
// composition) -- the two front ends are siblings, not layered.
//
// DECLARATION ORDER NOTE: a top-level func's PARAMETER TYPES are resolved
// during checkProgram's phase 1, in file order (checkTopDeclPhase1 walks
// `combined` once, declaring as it goes) -- unlike a body's own local
// vars, which resolve in phase 2 against the now-complete top-level scope.
// So `app`/`window Log`/`menu File` are declared FIRST, below, before any
// function whose signature names the `Log` window type (gcLog/gcCompile).
include "lib.cla"
include "tok.cla"
include "lex.cla"
include "ast.cla"
include "parse.cla"
include "types.cla"
include "check.cla"
include "ir.cla"
include "lower.cla"
include "shake.cla"
include "asm68k.cla"
include "peep68k.cla"
include "app68k.cla"
include "res68k.cla"
include "cprint.cla"
include "cg68k.cla"
include "uiblob.cla"
include "drive.cla"
// runtime-ir-bake Task 4: drive.cla's driveCompile now names bake.cla
// symbols directly (see clarusc/test/dblcompile.cla's own comment on
// this same include, added for the identical reason) -- needed for
// driveCompile's standalone check to resolve regardless of whether this
// build ever takes the bake path. Task 6 (Mac integration): gcCompile
// below now DOES set haveRtbake, by default -- see its own doc comment.
include "bake.cla"

// gcGet1NamedResource: a SECOND declaration of the same trap Get1NamedResource
// (toolbox/resources.cla) already catalogs, with a `string` `name` param
// instead of `ptr` -- same precedent as runtime/clarus/ui.cla's own
// UiNewMenu (`ptr`) / UiNewMenuStr (`string`) pair, both trap 0xA931. A
// `str`-typed extern param auto-marshals the address of the caller's
// Str255 (docs/clarus-language-reference.md's own extern-marshaling
// rule), so this needs no separate "turn a string into a ptr" helper
// (uiscript.cla's UiStrAddr, which macgui.cla -- see the note below --
// cannot reach anyway).
//
// NOT `include "../toolbox/resources.cla"` and NOT UiStrAddr: both are
// runtime/catalog symbols only reachable AFTER driveManifestSplice, but
// this file's OWN top-level code (feHasKey below) is checked STANDALONE,
// with NO runtime module spliced in yet (main.cla's own --testapi doc
// comment: "clarusc enforces user code checks standalone before any
// runtime module is consulted") -- confirmed empirically building this
// file: referencing UiStrAddr directly from here failed
// "undefined: UiStrAddr" even though uiscript.cla (which declares it) is
// unconditionally spliced in moments later for any UI program. A LOCAL
// `external func` declaration, by contrast, is part of macgui.cla's own
// source (parsed in Phase A, before the standalone check ever runs), so
// it's visible right away -- toolbox/resources.cla's own Get1NamedResource
// entry is a `ptr`-taking declaration for a DIFFERENT reason (its own
// callers already have a ptr in hand); its file wasn't included here at
// all, so there's no name collision between the two.
external func gcGet1NamedResource(theType: int, name: string): ptr = trap 0xA820

// SysBeep (attempt/abort phase Task 6): declared verbatim from
// toolbox/osutils.cla:96 -- same "own local external func" rationale as
// gcGet1NamedResource just above (this file's top-level code checks
// standalone, before any catalog/runtime module is spliced in, so a
// catalog include isn't reachable here). Used by gcCompile's `aborted`
// handler to beep before showing the alert (design doc %4/%3.5).
external func SysBeep(duration: word) = trap 0xA9C8

// gcClfsType packs 'CLFS' big-endian (C=0x43 L=0x4C F=0x46 S=0x53) --
// the same resource type file.readResource's native implementation
// (runtime/clarus/native.cla's natReadResource) looks up, under its own
// name natClfsType. Duplicated here rather than depending on that
// runtime-internal constant: native.cla is spliced into this program
// automatically (driveManifestSplice, because this build targets
// emit68k), but reaching into a runtime module's own internals from user
// source is exactly the layering toolbox/*.cla catalogs exist to avoid.
const gcClfsType: int = 0x434C4653

// feHasKey (Task 8 round 2's seam; real-implemented here for the first
// time -- see drive.cla's expand() doc comment for the full identity-
// resolution rule this answers) -- whether a 'CLFS' resource named key
// exists in the CURRENT resource chain (the one this app's own resource
// fork carries, baked by scripts/build-clarusc-mac.sh's `--bake` flags
// for every runtime/clarus + toolbox source file). A cheap PRESENCE
// probe only -- gcGet1NamedResource alone, no content copy (feReadSource
// below does the real read separately, only when actually needed).
//
// Deliberately NO ReleaseResource call, even though toolbox/resources.cla
// catalogs it for the `ptr`-taking form: that same file's own KNOWN
// HAZARD note (corroborated by native.cla's natReadResource doc comment)
// found that calling ReleaseResource after a resource read hangs real
// hardware SOLID under a busy heap. Same workaround as natReadResource:
// leave the handle resident forever. Bounded cost -- this build's baked
// namespace is a few dozen files (runtime/clarus/*.cla + toolbox/*.cla),
// so the permanent per-distinct-name resident cost never accumulates
// into a real leak across a session's worth of compiles.
func feHasKey(key: string): bool {
    if key == "" {
        return false
    }
    return gcGet1NamedResource(gcClfsType, key) != ptr(0)
}

// feReadSource (Task 6's seam; the resource-backed half Task 6 left for
// this task) -- disk first (file.readText, identical to main.cla's own
// host-only feReadSource), then, only on a disk miss with a non-empty
// key, the baked 'CLFS' resource feHasKey above may have already
// confirmed exists (file.readResource).
func feReadSource(path: string, key: string, out: text): bool {
    if file.readText(path, out) {
        return true
    }
    if key == "" {
        return false
    }
    return file.readResource(key, out)
}

// feExpectedStamp (runtime-ir-bake Task 6) is macgui.cla's own
// implementation of bake.cla's front-end seam -- see
// bkCheckRtbakeHeader's own doc comment for the full contract. Unlike
// main.cla's host implementation (re-hash clarusc/clarusc.c off disk),
// ClarusC.APPL's own boot disk carries no such file (baking the 3.5MB
// bootstrap C source just to re-hash it on a 68k CPU every compile would
// be both wasteful of resource-fork space and slow) -- it reads the tiny
// 4-byte stamp sidecar scripts/build-clarusc-mac.sh embeds under
// bkStampResourceName instead (cliResolveBakeIr, main.cla; the SAME
// `clarusc --bake-ir` run that generated the CLIR artifact also computed
// and persisted this value, so the two always agree by construction --
// no independent re-verification is possible or needed on this lane).
// Absent resource, or a too-short read, returns 0 -- the SAME "can't
// verify" sentinel bake.cla's own writer already uses when clarusc.c is
// unreachable, which a real (never legitimately zero) stamp always fails
// to match, so bkCheckRtbakeHeader refuses cleanly rather than crashing.
//
// Save/restores bkLoadBuf/bkLoadPos around its own tiny parse: this
// function runs FROM INSIDE bkCheckRtbakeHeader (called partway through
// ITS OWN parse of the CLIR buffer being validated), which resumes
// reading from those same two globals immediately afterward -- clobbering
// them here without restoring would corrupt that resume position.
func feExpectedStamp(): int {
    var buf: text
    var savedBuf: text
    var savedPos: int
    var result: int

    buf = ""
    if not file.readResource(bkStampResourceName, buf) {
        return 0
    }
    if buf.length < 4 {
        return 0
    }
    savedBuf = bkLoadBuf
    savedPos = bkLoadPos
    bkLoadBuf = buf
    bkLoadPos = 0
    result = bkGetU32()
    bkLoadBuf = savedBuf
    bkLoadPos = savedPos
    return result
}

// gcProgressBuf accumulates drive.cla's compile-progress lines during
// the synchronous compile; gcFlushProgress restores base-log +
// accumulated lines at gcCompile's exit points. The LIVE view during
// the compile is gcTickerRing below -- the last gcTickerLines lines,
// repainted into the Log textview on every feProgress call (the
// runtime's sync-paint path, live-log phase, makes the assignment
// visible mid-handler).
var gcProgressBuf: text

// Rolling ticker state (live-log phase). gcLiveActive gates both the
// ticker and the Status bar: false outside gcCompile, so a stray
// feProgress can never repaint the restored log.
//
// gcTickerLines = 16 (fix round 2, live-log phase): the Output
// textview's visible height at the window's DEFAULT 480x300 size, with
// the Status label now occupying its own top lane (see window Log's own
// layout-order comment below), renders exactly 16 full text lines with
// no wasted space and no partial 17th line -- confirmed empirically with
// a throwaway LayoutProbe.cla fixture booted on Mini vMac (fast
// iteration lane; a real ClarusC.APPL compile is too slow to use for
// tuning this constant -- see the live-log phase's own findings) and a
// tight screencapture crop right at the textview's bottom edge: line 16
// is flush against the border, no 17th line visible at all, not even
// clipped. (Fix round 1 measured 17 against the OLD, broken layout,
// where Output's `fill: both` claimed the full 300px with Status pushed
// off-window entirely -- see the layout-order comment below for why that
// was wrong and how it was fixed; 16 is the correct number for the
// CORRECTED layout, which reserves a 24px top strip for Status.)
const gcTickerLines: int = 16
const gcBarWidth: int = 20
const gcSpinTicks: int = 30

var gcTickerRing: list of string
var gcBaseLog: text
var gcLiveActive: bool

// gcTickerAdd: push line into the ring (ponytail: O(N) shift, N=16 --
// a real ring index isn't worth it at this size) and repaint the Log
// textview with the ring's contents, oldest first.
func gcTickerAdd(line: string) {
    var w: Log
    var t: text
    var i: int

    if not gcLiveActive {
        return
    }
    if gcTickerRing.count < gcTickerLines {
        gcTickerRing.add(line)
    } else {
        i = 0
        while i < gcTickerLines - 1 {
            gcTickerRing[i] = gcTickerRing[i + 1]
            i = i + 1
        }
        gcTickerRing[gcTickerLines - 1] = line
    }
    w = Log.front
    if w == nil {
        return
    }
    i = 0
    while i < gcTickerRing.count {
        t.append(gcTickerRing[i])
        t.append("\n")
        i = i + 1
    }
    w.Output.text = t
}

// feProgress (onlog phase) is now a one-liner on BOTH front ends:
// main.cla's host CLI already routed drive.cla's compile-progress seam
// through log() (stderr), and this one now does too. The Log-window work
// this function used to do in-line moved, verbatim, into the `on App.log`
// handler below.
//
// The point is the persistent channel: log() writes the line to natLog's
// buffer FIRST (flushed as the ##CLARUS-LOG## trailer at quit) and only
// then fires the handler, so ClarusC.APPL's captured `out` finally
// carries the whole timestamped stage log -- the durable, human-readable
// compile log -- instead of just gcCompile's one bake-path verdict line.
// Previously every progress line existed ONLY as on-screen textview
// state, which nothing ever writes down.
//
// ponytail: natLogCap is 4096 bytes (runtime/clarus/native.cla) and
// natLog silently truncates past it, so a very long compile's trailer is
// clipped at the tail. Left alone deliberately -- raising the constant
// re-blesses every native golden for a ceiling no committed gate is
// anywhere near. Raise natLogCap if a real session ever loses lines that
// matter.
func feProgress(line: string) {
    log(line)
}

// The Log-window half of the progress seam (onlog phase), moved here
// verbatim from feProgress's old body -- gcProgressBuf accumulation
// (restored by gcFlushProgress at every gcCompile exit) plus the rolling
// ticker repaint (gcTickerAdd, which owns its own gcLiveActive gate and
// the runtime's sync-paint behavior). Unchanged in every respect except
// where it is called from.
//
// Reaching it through `on App.log` rather than through feProgress
// directly widens the set of lines the window shows by exactly the set
// of lines that were ALREADY going to the persistent channel and nowhere
// else: gcCompile's own bakeMsg log() (see its call site -- its separate
// gcBaseLog append is gone now, since this handler already routes it into
// gcProgressBuf) and any log() one of clarusc's own pipeline modules
// emits mid-compile (cg68k/bake diagnostics). Both are compile output a
// user watching the Log window wants; neither could reach it before.
// Runtime-internal writes never arrive here at all -- the panic path and
// the abort default call natLog directly, and a runtime module's own
// log() keeps lowering to the raw intrinsic (lower.cla's
// lowCurFnRuntimeOrigin).
on App.log(line: string) {
    gcProgressBuf.append(line)
    gcProgressBuf.append("\n")
    gcTickerAdd(line)
}

// gcStatusBase: the bar+label+step text of the current stage, kept so
// feProgressTick can repaint it with a rotating spinner glyph without
// rebuilding (live-log phase, 3b).
var gcStatusBase: string
var gcSpinIdx: int
var gcSpinLast: int

// feProgressStep (live-log phase, 3b): drive.cla's stage-progress seam.
// Renders a 20-char ASCII bar plus label plus step count --
// [#####---------------] Loading Runtime (Step 4/10) -- into the Log
// window's Status label; the runtime's sync-paint label path makes it
// visible mid-handler. Pure ASCII by constraint (no MacRoman bytes).
func feProgressStep(cur: int, total: int, label: string) {
    var w: Log
    var bar: string
    var filled: int
    var i: int

    if not gcLiveActive {
        return
    }
    w = Log.front
    if w == nil {
        return
    }
    filled = 0
    if total > 0 {
        filled = (cur * gcBarWidth) / total
    }
    if filled > gcBarWidth {
        filled = gcBarWidth
    }
    bar = "["
    i = 0
    while i < gcBarWidth {
        if i < filled {
            bar = bar + "#"
        } else {
            bar = bar + "-"
        }
        i = i + 1
    }
    bar = bar + "] "
    bar = bar + label
    bar = bar + " (Step "
    bar = bar + numToStr(cur)
    bar = bar + "/"
    bar = bar + numToStr(total)
    bar = bar + ")"
    gcStatusBase = bar
    gcSpinIdx = 0
    gcSpinLast = TickCount()
    w.Status.text = bar
}

// feProgressTick: liveness spinner. Throttled HERE (not at the callers)
// by TickCount -- repaint at most every gcSpinTicks ticks, so per-
// function callers cost one trap per call and ~2 repaints per second.
func feProgressTick() {
    var w: Log
    var t: int
    var line: string
    var glyph: string

    if not gcLiveActive {
        return
    }
    t = TickCount()
    if t - gcSpinLast < gcSpinTicks {
        return
    }
    gcSpinLast = t
    w = Log.front
    if w == nil {
        return
    }
    gcSpinIdx = gcSpinIdx + 1
    if gcSpinIdx == 4 {
        gcSpinIdx = 0
    }
    if gcSpinIdx == 0 {
        glyph = "|"
    } else if gcSpinIdx == 1 {
        glyph = "/"
    } else if gcSpinIdx == 2 {
        glyph = "-"
    } else {
        glyph = "\\"
    }
    line = gcStatusBase
    line = line + " "
    line = line + glyph
    // Same-stage repaint, not a stage transition -- suppress the trace
    // (rtUiTraceSuppressed, runtime/clarus/uiscript.cla) around this ONE
    // set so the spinner pulse doesn't flood the captured session log
    // with near-identical "T SET Log.Status.text" lines (Andrew's
    // request, clir-load-perf trace-noise phase). feProgressStep's own
    // stage-announce set (above) is untouched -- it stays traced, one
    // line per stage change, which TestMacResidentFailedCompileStaysAliveOnSnow
    // (internal/mactest/macresident_test.go) counts on. Nothing else runs
    // between the two assignments below, so the suppression window can
    // never swallow an unrelated trace line.
    rtUiTraceSuppressed = true
    w.Status.text = line
    rtUiTraceSuppressed = false
}

app ClarusC {
    name: "ClarusC"
    version: "1.0"
    author: "Andrew C. Young <andrew@vaelen.org>"
    about: "The Mac-resident Clarus compiler."
    id: "CLRC"
}

window Log {
    title: "ClarusC"
    size: 480, 300
    resizable: min(320, 160)

    // Layout fix (live-log phase, fix round 2): Status must be declared
    // BEFORE Output, and Output must give an EXPLICIT `at: 0, bottom`
    // (not bare `fill: both`). rt_ui_layout (runtime/mac/rt_ui.c) is a
    // single forward pass with no lookahead -- a `fill: both` widget's
    // height is always `contentH - its OWN y`, computed from the
    // window's total content height regardless of any widget declared
    // AFTER it. The original ordering (Output first with bare
    // `fill: both`, Status second at `at: next, bottom`) made Output
    // claim the FULL window height (y=0), which pushed Status's
    // "bottom" position to prevBottom+gap == just past the window's own
    // bottom edge -- entirely off-screen, not merely overlapped
    // (confirmed empirically: no trace of Status at all in a live Snow
    // screenshot). Since `textview` has no explicit width/height
    // property (only at/fill/scrollbar -- see the language reference's
    // widget property table), the only way to reserve a lane is
    // declaration order: Status first (so it lands in the normal
    // vertical-stack top position) reserves the top RTUI_LABEL_H+GAP
    // strip, then Output's explicit `at: 0, bottom` resolves against
    // Status's own bottom edge (prevBottom), and Output's `fill: both`
    // height computes as contentH-minus-that-offset -- filling
    // everything below Status down to the window's bottom edge. This
    // moves the status/progress strip to the TOP of the window (a true
    // bottom-pinned status bar alongside a fill-both log above it is not
    // expressible in this single-pass layout engine without a runtime
    // change, out of scope here).
    label Status { at: 0, 0; width: fill; text: "" }
    textview Output { at: 0, bottom; fill: both; scrollbar: both }
}

// Menu layout (Task 11's events script drives this by `menu N M`):
//   menu 1 -- Apple menu (rtUiBuildAppleMenu, ui.cla): automatic, never
//     declared in source -- built by the runtime for every UI program.
//   menu 2 -- File: item 1 "Compile..." (key K), item 2 "Quit" (key Q).
menu File {
    item Compile "Compile\xC9" key "K"
    item Quit    "Quit"        key "Q"
}

// gcFlushProgress: end the live-ticker view and restore the full log --
// the base text captured at compile start plus every accumulated
// progress line. Called at every gcCompile exit point; after it, gcLog
// appends diags/results exactly as before the live-log phase.
func gcFlushProgress(w: Log) {
    var buf: text

    gcLiveActive = false
    w.Status.text = ""
    gcStatusBase = ""
    buf = gcBaseLog
    buf.append(gcProgressBuf)
    w.Output.text = buf
    gcProgressBuf = ""
    gcBaseLog = ""
}

// gcLog appends line (plus a trailing Mac newline) to w's log textview.
// Reads Output.text back out, appends in place, then reassigns the whole
// value -- the same read-mutate-reassign idiom texteditor.cla's own
// save() uses to READ a textview's text (Body.text as a plain
// argument); WRITING one always goes through a whole-value assignment
// (Appendix C's own openPath: `d.Body.text = t`), never a direct method
// call on the property expression itself.
func gcLog(w: Log, line: string) {
    var buf: text

    buf = w.Output.text
    buf.append(line)
    buf.append("\n")
    w.Output.text = buf
}

// gcCompile drives one compile-and-emit run for path p, logging every
// step into w's textview. drive.cla's own module globals were built for
// a single-shot-per-process CLI (main.cla) -- this program compiles
// repeatedly in one process (once per "Compile..." action), so every
// per-compile-owned global that drive.cla/lib.cla/ast.cla document as
// "reset between independent programs" is reset HERE, before
// driveCompile runs: driveReset() (drive.cla: seenPaths/asmHeads/
// asmTails/dedupHits/hoistedHead/hoistCount/userHeadCount/entryFailed/
// combined/combined2 -- see its own doc comment for the full list, and
// for what does NOT need resetting here because it already self-resets
// elsewhere in the pipeline: ir.cla's arenas via irReset() inside
// driveCompile itself, check.cla/types.cla's state via checkReset()
// inside checkProgram itself, cg68k.cla's/shake.cla's own per-run lists
// via their own "rebuilt fresh at the top of every call" convention),
// resetDiags() (lib.cla: diags/diagPaths/declFileTab/curPathIdx), and
// astReset() (ast.cla: the four AST arenas) -- the same two calls
// main.cla's startCLI makes, but only ONCE (per-process); here, EVERY
// compile.
// gcResolveBakePath (runtime-ir-bake Task 6) decides, fresh for THIS
// compile, whether to take the CLIR bake path (the DEFAULT) or fall back
// to CLFS-source -- setting haveRtbake/rtbakeBytes (drive.cla's own
// per-compile-owned globals, reset here every call, never cached across
// compiles, matching driveCompile's own "install re-parses from scratch
// every call" discipline: bake.cla's own doc comment; TestLeakGate/
// DoubleCompileBake is the oracle for this on the host side) and
// returning a short status line naming which path ran, and why. Split
// out of gcCompile (which just logs the result on two channels -- see
// its own doc comment) purely to keep gcCompile itself under macgui.
// cla's per-function 32KB native segment budget, same reasoning as main.
// cla's cliResolveBake split (Task 5).
//
// Fallback is taken whenever the resource is absent, unreadable, or its
// header is refused (format/version/lane/stamp/body-hash mismatch --
// bkCheckRtbakeHeader, the SAME check bake.cla's own bkLoadRtbake runs
// internally, factored out so this decision can be made BEFORE
// committing to driveCompile: a refused bake must never surface as a
// user-facing compile failure, only a silent, logged fallback). The
// body-hash check (format v4, final-review fix wave) covers every byte
// after the header -- a truncated resource read or a corrupted section
// is now refused HERE too, not just inside driveCompile's own later full
// parse, so this claim now holds for section-level corruption as well
// as the header fields it always covered.
//
// A fourth reason exists but is NOT decided here: fallback-trigger-
// narrowing's per-module source hash (format v5, bkManifestHashes) can
// still trigger a from-source fallback for an otherwise-accepted bake,
// when a user `include` collides with a manifest module whose on-disk
// bytes have drifted from what the bake carries. That check runs per
// include, inside driveCompile itself (drive.cla's own expand()/
// driveCompile), well after this function has already returned "bake
// path" -- it logs its own line ("clarusc --rtbake: <path> differs from
// the baked copy; falling back to a from-source compile") through the
// same feProgress() seam gcCompile's bakeMsg uses below, so a drifted
// compile shows both lines in the Log window: this function's initial
// "bake path" verdict, then drive.cla's own drift line once the
// collision is actually reached.
func gcResolveBakePath(): string {
    var clirBuf: text

    haveRtbake = false
    // clir-load-perf Task 7 (design B): this session already parsed the
    // CLIR, and the resource cannot change under a running app -- so arm
    // drive.cla's `if haveRtbake` install gate and skip the resource
    // read, the ~1.3MB body hash, and (via drive.cla's own
    // `if not bkParsedValid`) the whole section parse. rtbakeBytes was
    // freed by gcCompile after that first parse; bkLoadRtbake is
    // unreachable while bkParsedValid holds, so the freed buffer is never
    // read. bkHeaderVerified deliberately stays FALSE here: nothing will
    // consume it, and leaving it clear keeps design A's consume-once
    // invariant trivially true.
    if bkParsedValid {
        haveRtbake = true
        return "clarusc: bake path (CLIR resource, parsed earlier this session)"
    }
    if not feHasKey(bkClirResourceName) {
        return "clarusc: CLFS-source fallback (no CLIR resource baked into this app)"
    }
    clirBuf = ""
    // Pre-compile feedback (attempt-abort Task 7, spec %5): the resource
    // read and the header check are the two slow steps that can precede
    // driveCompile's own first progress line, so both get a Status-bar
    // step (step 0 of drvFixedSteps -- driveCompile resets the stage
    // counter at its own top, drive.cla:1799, so this borrowed step
    // number never collides) plus a timestamped log line, in the SAME
    // format driveProgress itself uses. Reached directly via
    // feProgressStep/feProgress (not driveProgress/driveProgressStage --
    // those live in drive.cla and gate on want68k, which gcCompile now
    // arms before calling this function, but this function is itself
    // part of the macgui.cla front end that DEFINES those seams, so
    // calling them straight is the least-indirect path).
    feProgressStep(0, 10, "Loading Baked Runtime")
    feProgress("[" + dateTimeStr(now()) + "] Loading Baked Runtime")
    if not file.readResource(bkClirResourceName, clirBuf) {
        return "clarusc: CLFS-source fallback (CLIR resource present but unreadable: " + lastError.message + ")"
    }
    feProgressStep(0, 10, "Verifying Baked Runtime")
    feProgress("[" + dateTimeStr(now()) + "] Verifying Baked Runtime")
    if not bkCheckRtbakeHeader(clirBuf, bkLane68k) {
        resetDiags()
        return "clarusc: CLFS-source fallback (CLIR resource refused -- format/version/lane/stamp/body-hash mismatch)"
    }
    resetDiags()
    haveRtbake = true
    bkHeaderVerified = true
    rtbakeBytes = clirBuf
    return "clarusc: bake path (CLIR resource)"
}

func gcCompile(w: Log, p: string) {
    var entries: list of string
    var ok: bool
    var i: int
    var built: bool
    var appName: string
    var creator: string
    var fork: text
    var wrote: bool
    var bakeMsg: string

    driveReset()
    resetDiags()
    astReset()

    // Live-progress arming (attempt-abort Task 7, spec %5) moves ABOVE
    // gcResolveBakePath() so its own pre-compile Status-bar/log messages
    // (feProgressStep/feProgress gate on gcLiveActive; driveProgress-style
    // helpers elsewhere gate on want68k) actually paint instead of being
    // silent no-ops -- previously this arming ran AFTER gcResolveBakePath
    // returned, so the CLIR-resource read/header-check stretch (the
    // biggest silent gap before driveCompile's own first progress line)
    // showed nothing on screen. gcBaseLog is captured here from
    // w.Output.text BEFORE anything this compile produces -- it is now
    // PURELY the prior window contents (onlog phase: bakeMsg's own
    // separate append into it is gone, see its call site below).
    gcProgressBuf = ""
    gcBaseLog = w.Output.text
    gcTickerRing.clear()
    gcLiveActive = true
    hostPaths = false
    wantEmit = true
    want68k = true

    // bakeMsg records WHICH path ran, and why, on two channels: the
    // persistent one (natLog, flushed into RunMac's own captured stream
    // at quit -- the channel an automated test can actually read) and the
    // on-screen Log window a real user sees. Both still happen, and both
    // still land BEFORE gcFlushProgress later REPLACES w.Output.text
    // wholesale from gcBaseLog + accumulated progress (gcLog's own
    // append-in-place idiom would otherwise be silently discarded the
    // moment this compile finishes -- macresident_test.go's own doc
    // comment on gcLog's never-trace-visible behavior is the same reason,
    // restated here for this call site).
    bakeMsg = gcResolveBakePath()
    // onlog phase: ONE call, still two channels -- log() writes the
    // persistent channel (natLog, the ##CLARUS-LOG## trailer an automated
    // test reads) and then fires `on App.log`, which appends the line to
    // gcProgressBuf for the on-screen Log window. The explicit
    // `gcBaseLog.append(bakeMsg)` pair that used to supply the second
    // channel is GONE: keeping it would print the line twice, since
    // gcFlushProgress rebuilds w.Output.text as gcBaseLog + gcProgressBuf
    // and gcProgressBuf now carries it. Net effect on the window: the
    // same line, exactly once, but now in chronological position (after
    // gcResolveBakePath's own two "Loading/Verifying Baked Runtime"
    // progress lines, which physically precede it) instead of ahead of
    // them. Nothing is lost.
    log(bakeMsg)

    entries.add(p)

    // attempt/abort phase Task 6: the whole compile pipeline (driveCompile
    // through driveEmit68kFork through file.writeRes) now runs inside an
    // `attempt`, catching any abort() that fires from the ~150 converted
    // pipeline fatal sites in cg68k.cla/cprint.cla/uiblob.cla/bake.cla/
    // drive.cla/lower.cla. Without this, one of those internal-invariant
    // aborts would hit the synthesized top-level UI default (design doc
    // %3.5) and quit the whole app -- exactly the "silent ExitToShell"
    // defect (spec %1) this phase exists to fix. The existing ok/
    // entryFailed/built/wrote failure branches below are unrelated,
    // ordinary compile failures (not aborts) and keep their own
    // log+alert+return shape unchanged.
    attempt {
        ok = driveCompile(entries, false)

        // clir-load-perf Task 7 (design B): the parse is memoized, so
        // the raw CLIR bytes are dead weight -- ~1.3MB of a 12MB
        // partition. Freed HERE, right after driveCompile returns,
        // because that is the one point every bake-path compile that
        // RETURNS crosses whatever it decides (success, user diagnostics,
        // or an unreadable entry file) -- the four early returns below all
        // sit after it. A compile that ABORTS instead skips this and
        // holds the buffer until the session's next successful compile
        // frees it, which is exactly the pre-Task-7 status quo (the
        // buffer used to be held for the whole session unconditionally),
        // so no regression. Guarded on bkParsedValid rather than on `ok`
        // for the
        // same reason it is the flag drive.cla's parse gate reads: the
        // manifest-drift fallback clears it (its from-source recompile
        // means the pending parse is no longer trustworthy), and the
        // buffer must survive for the re-read/re-parse that follows.
        // gcResolveBakePath reads the resource again from scratch on any
        // compile where bkParsedValid is false, so a freed buffer is
        // never a buffer some later compile still needs.
        if bkParsedValid {
            rtbakeBytes = ""
        }

        // entryFailed (an unreadable entry file) is checked BEFORE diags,
        // exactly like main.cla's own startCLI -- driveCompile leaves diags
        // empty in this case.
        if entryFailed {
            gcFlushProgress(w)
            gcLog(w, "cannot open entry file: " + p)
            alert("cannot open entry file: " + p)
            return
        }

        if not ok {
            gcFlushProgress(w)
            i = 0
            while i < diags.count {
                gcLog(w, formatDiag(poolGet(diagPaths[i]), diags[i]))
                i = i + 1
            }
            alert(formatDiag(poolGet(diagPaths[0]), diags[0]))
            return
        }

        built = driveEmit68kFork("", false, 0, false)
        if not built {
            gcFlushProgress(w)
            gcLog(w, "emit68k failed")
            alert("emit68k failed")
            return
        }

        // Read driveLastFork/driveLastAppName/driveLastCreator IMMEDIATELY
        // after a successful driveEmit68kFork -- their own documented
        // validity window (drive.cla) is "until the NEXT driveEmit68kFork
        // call", and capturing all three into locals right away is the
        // simplest way to honor that even though nothing else in this
        // function calls driveEmit68kFork again before they're used.
        appName = driveLastAppName()
        creator = driveLastCreator()
        fork = driveLastFork()

        wrote = file.writeRes(appName, fork, "APPL", creator)
        if not wrote {
            gcFlushProgress(w)
            gcLog(w, "write failed: " + lastError.message)
            alert("write failed: " + lastError.message)
            return
        }

        driveProgressDone()
        gcFlushProgress(w)
        gcLog(w, "BUILT " + appName + " " + numToStr(fork.length) + " bytes")
    } aborted msg {
        gcFlushProgress(w)
        gcLog(w, msg)
        SysBeep(30)
        alert(msg)
        gcLiveActive = false
    }
}

on App.startEmpty {
    open Log
}

extend File {
    on Compile.select {
        var w: Log = Log.front
        var p: string(255)

        if w == nil {
            w = open Log
        }
        if askOpen(p, "TEXT") {
            gcCompile(w, p)
        }
    }

    on Quit.select { quit }
}

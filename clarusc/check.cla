// SPDX-License-Identifier: MIT

// check.cla: the type checker -- Task 9a's port of internal/check/check.go
// (the two-phase top-level walk, record/enum layout building) and
// internal/check/expr.go (checkExpr's full rule set) and
// internal/check/builtins.go (the universe scope + string/text/list/map/
// connection/listener/serviceBrowser/file/canvas method tables).
//
// DEFERRED TO TASK 9b (see task-9-report.md): stmt.go's control-flow
// family (if/while/for/switch/break/continue/return/quit/cancel/open/
// close/edit) -- checkStmt below only dispatches StAssign/StExprStmt, the
// two statement kinds this task's diagnostic list (condition-must-be-bool
// via `not`/`and`/`or`, cannot-assign-to-constant, cannot-assign-*) needs.
// Also deferred whole: ui.go (window/widget property and bind checking,
// canvas widget-instance dispatch) and events.go (the handler-path/events
// table, menu-item resolution). Window/menu DECLARATIONS are registered
// as symbols in phase 1 below (so declare-before-use and "undefined: X"
// work across functions/windows/menus), but their BODIES are not walked.
//
// ============================================================
// InvalidT no-cascade discipline (see types.cla's header comment)
// ============================================================
// Every check* function below returns InvalidT after reporting exactly one
// diagnostic, and treats an InvalidT operand as "already reported, don't
// pile on" -- never re-diagnosing an expression whose sub-expression was
// already InvalidT. -1 is this module's "no expected type" sentinel
// (mirrors Go's untyped `nil` for the `expected *types.Type` parameter);
// it is never a valid type-arena index.

include "lib.cla"
include "ast.cla"
include "types.cla"

// ================================================================
// Global checker state
// ================================================================

// connectionT/listenerT/serviceBrowserT are the resource kinds' singleton
// type indices. types.cla's typesInit seeds Invalid/Int/Bool/Fixed/Char/
// Text/Void/Address/ErrorType/saveChoice only -- these three are check.cla's
// own (builtins.go has no *types.Type package var for them either; see
// builtins.go's own comment). Rebuilt by checkReset every program, since
// typesReset empties typeArena and a stale index here would silently
// alias whatever the NEXT program allocates at that slot.
var connectionT: int
var listenerT: int
var serviceBrowserT: int

// Built-in-name index cache, pre-interned once per compile and cached in
// module globals (parse.cla's cwInit pattern -- see its own doc comment
// for why this can't be a plain global initializer): every hot-path spot
// below that used to compare `poolGet(nameIdx) == "int"` etc. compares
// nameIdx against these instead, since both sides are interned ints from
// the SAME compile's pool generation (index equality <=> string
// equality). cnInit is called from checkReset, checkProgram's first
// statement, so every cn* global is filled before any checker function
// that reads them can run. cnInit's own guard (cnInited) is a
// process-lifetime lazy-init idiom -- SAME class as cg68k.cla's
// rnInit()/rnInited (see its own doc comment) -- so checkReset resets
// cnInited = false right before calling cnInit(), forcing a fresh
// re-intern against the CURRENT compile's pool generation every time
// (memory-leak-fix Task 7: this cn* guard was an audit gap -- the Task 6
// report verdicted these globals safe on the mistaken assumption cnInit
// re-interns every compile, when in fact its own guard only let that
// happen on the first call in the process; found and fixed here while
// wiring libReset()).
var cnInited: bool
var cnInt: int
var cnBool: int
var cnFixed: int
var cnChar: int
var cnText: int
var cnPtr: int
var cnFile: int
var cnIsNew: int
var cnFront: int
var cnNow: int
var cnDateTimeStr: int
var cnDurationStr: int

func cnInit() {
    if cnInited { return }
    cnInited = true
    cnInt = intern("int")
    cnBool = intern("bool")
    cnFixed = intern("fixed")
    cnChar = intern("char")
    cnText = intern("text")
    cnPtr = intern("ptr")
    cnFile = intern("file")
    cnIsNew = intern("isNew")
    cnFront = intern("front")
    cnNow = intern("now")
    cnDateTimeStr = intern("dateTimeStr")
    cnDurationStr = intern("durationStr")
}

// universeScope holds the built-in type/function names; topScope is the
// user program's global scope, chained under it (mirrors Go's
// `universe := NewScope(nil); registerBuiltins(universe); c.scope :=
// NewScope(universe)` -- rebuilt fresh every checkProgram call, exactly as
// Files() does). curScope is whichever scope is currently active while
// walking a decl/block; curFuncRet is the enclosing function's return type
// (-1 for a procedure or outside any function -- Task 9b's checkReturnStmt
// will need to further distinguish these if it ever matters); curWindow is
// always -1 in 9a (no window-scoped handler body is ever checked yet, so
// the `window` keyword always reports "only valid inside a window-scoped
// handler" -- correct current behavior, not a stub bug).
var universeScope: int
var topScope: int
var curScope: int
var curFuncRet: int
var curWindow: int

// checkInExternPtrArgCtx (Task 7, toolbox-integration Feature C: `callback
// func`) is true only while checkArgsCall's own per-argument checkExpr
// call is checking an argument against an EXTERN call's ptr-typed
// parameter -- the one legal position a bare callback name may appear.
// checkIdent consults it to tell that ONE context from every other place
// a bare identifier can be checked (var init, return, a non-extern call
// arg, an extern call's non-ptr arg, a container element, ...); saved and
// restored around the one checkExpr call site that sets it true
// (checkArgsCall), so a nested call's own arguments (if any) never
// inherit an outer call's context.
var checkInExternPtrArgCtx: bool

// ---- record field layout ----
// types.cla's TyRec carries only nameIdx (the named-type identity); the
// field list itself is this module's own side table, keyed by that name --
// exactly Go's types.Type.Record *RecordInfo side pointer, restated as an
// arena + a name-keyed map instead of a Go pointer. recFieldsHeadByName
// (Task 6, layer1-compiler-perf) is keyed by nameIdx itself rather than
// poolGet(nameIdx) -- same intern-pool-index-equals-string-equality
// argument the interning side of this compiler relies on throughout --
// saving the poolGet round-trip on every field lookup, the hottest of
// which is member-select checking. OVERWRITTEN per record in
// checkRecordDecl (phase 1, source order), and only ever read for a
// record type that resolves in the current program's (reset) scope, so a
// stale entry for a record absent from the current program is never
// consulted -- checkReset resets it anyway (see its own comment there).
record FieldInfo {
    nameIdx: int
    typeIdx: int
    next: int
}

var fieldInfos: list of FieldInfo
var recFieldsHeadByName: intmap of int

func fieldInfoAppend(tailIdx: int, idx: int): int {
    if tailIdx >= 0 {
        fieldInfos[tailIdx].next = idx
    }
    return idx
}

func newFieldInfo(nameIdx: int, typeIdx: int): int {
    var fi: FieldInfo

    fi.nameIdx = nameIdx
    fi.typeIdx = typeIdx
    fi.next = -1
    fieldInfos.add(fi)
    return fieldInfos.count - 1
}

// recordFieldsHead returns the head index (into fieldInfos) of the field
// list for the record named by nameIdx, or -1 if none is registered.
func recordFieldsHead(nameIdx: int): int {
    return recFieldsHeadByName.get(nameIdx, -1)
}

func setRecordFields(nameIdx: int, head: int) {
    recFieldsHeadByName[nameIdx] = head
}

// ---- extern-record layout (Task 4, toolbox-integration Feature B) ----
// xrecSizeByName holds each declared `extern record`'s TOTAL packed size
// (Ch13's packing table, rounded up to even) -- the checker's OWN
// self-contained computation, not a read of ir.cla's irXRecSize authority:
// check.cla runs before lower.cla ever builds the IR record arenas (see
// main.cla's checkProgram-then-lower pipeline), so no such authority
// exists yet at check time. This is needed for exactly one checker rule
// ("only a 4-byte extern record can pass as int" -- checkArgsCall below);
// it implements the SAME packing algorithm ir.cla's irXRecFieldOffset/
// irXRecSize independently re-implement for lowering's own purposes (see
// that pair's own doc comment) -- keep the two in lockstep if the Ch13
// packing table ever changes. Plain name-keyed map, same no-namespacing
// convention as recFieldsHeadByName above (see its own doc comment for
// why that's safe). memory-leak-fix Task 7 also folds it into checkReset
// (bounded-memory charter), on top of that existing correctness argument.
var xrecSizeByName: map of int

func xrecSize(t: int): int {
    return xrecSizeByName.get(poolGet(typeNameIdx(t)), -1)
}

// xrecFirstDeclByName (Task 4 dedup) is a progGen-namespaced, name-keyed
// "first occurrence" registry -- the same field-for-field merge rule
// Ch13's Extern dedup section states for `extern record`. Unlike
// externFirstDeclByName (which memory-leak-fix Task 7 moved to a plain
// key + checkReset fold), this one keeps its progGen namespace; Task 7
// still folds it into checkReset too (bounded-memory charter), redundant
// with the namespacing but harmless.
var xrecFirstDeclByName: map of int

// xrecFieldTypeMatches compares two extern-record fields' TypeExprs
// structurally (Task 4 dedup): same TypeExprKind, and for the kinds that
// carry a payload (str[N]/pad[N]'s N, or a nested type's own name) that
// payload must match too. TxWord/TxByte carry no payload (kind equality
// alone suffices, same as TxWord's own doc comment). TxString/TxList/
// TxMap/TxArray never legally reach here (checkXRecFieldType already
// rejects them as an illegal field type on ANY xrec decl), so the
// catch-all `false` is unreachable on a check-clean pair, not a real gap.
func xrecFieldTypeMatches(a: int, b: int): bool {
    var ka: TypeExprKind
    var kb: TypeExprKind

    ka = typeExprKind(a)
    kb = typeExprKind(b)
    if ka != kb {
        return false
    }
    if ka == TxWord or ka == TxByte {
        return true
    }
    if ka == TxXStr {
        return xstrTypeN(a) == xstrTypeN(b)
    }
    if ka == TxPad {
        return padTypeN(a) == padTypeN(b)
    }
    if ka == TxNamed {
        return poolGet(namedTypeName(a)) == poolGet(namedTypeName(b))
    }
    return false
}

// xrecFieldsMatch compares two `extern record` DECLS' own field lists
// field-for-field (Task 4 dedup): same count, and at each position the
// same field NAME (a bare `pad[N]` field's nameIdx is -1 on both sides,
// so two pad runs at the same position compare by size alone, via
// xrecFieldTypeMatches) and the same field TYPE, in the same order.
// Unlike external func's dedup rule, field NAMES must match too -- see
// the Extern dedup section's own "unlike func-param name exemption" note.
func xrecFieldsMatch(declA: int, declB: int): bool {
    var fa: int
    var fb: int

    fa = recordDeclFieldsHead(declA)
    fb = recordDeclFieldsHead(declB)
    while fa != -1 and fb != -1 {
        if fieldName(fa) != fieldName(fb) {
            return false
        }
        if not xrecFieldTypeMatches(fieldType(fa), fieldType(fb)) {
            return false
        }
        fa = declNext(fa)
        fb = declNext(fb)
    }
    return fa == -1 and fb == -1
}

// XRecFieldCheck is checkXRecFieldType's return shape: ok reports whether
// te is a legal Ch13 field-palette type; badStrLen distinguishes the
// str[N]-out-of-range case (its own diagnostic) from every other illegal
// shape (the catch-all "field type must be..." diagnostic) so the two
// never both fire for one field. readType is the field's CHECKED type
// (what `ev.field` evaluates to -- IntT for byte/word/int alike, BoolT,
// PtrT, or a strT(N)); meaningless when !ok. size/align are the field's
// own packed byte size and alignment (1 or 2, Ch13's table); meaningless
// when !ok.
record XRecFieldCheck {
    ok: bool
    badStrLen: bool
    // badPadLen (Task 4 review fix, Minor 4): distinguishes a `pad[N]`
    // with N < 1 (Ch13's own "pad[N] (N >= 1)" table entry) from every
    // other illegal shape, same badStrLen/catch-all split str[N] already
    // gets.
    badPadLen: bool
    readType: int
    size: int
    align: int
}

// checkXRecFieldType validates one `extern record` field's TypeExpr (te)
// against Ch13's field palette and reports its checked read type + packed
// size/alignment -- the single place that decision is made, called once
// per field by checkRecordDecl's isXRec branch below (which walks the
// running byte OFFSET itself, applying `align` the same classic MPW 68k
// packing rule ir.cla's irXRecFieldOffset/irXRecSize apply -- see the
// worked sanity-check arithmetic in that pair's own doc comment).
// `pad[N]` (TxPad) is included here even though it has no readType (a pad
// field is never named/selectable, checkRecordDecl never adds a FieldInfo
// entry keyed by a real name for it) purely so its size/align contribute
// to the running total the same way every other field's does.
func checkXRecFieldType(te: int): XRecFieldCheck {
    var r: XRecFieldCheck
    var k: TypeExprKind
    var name: string
    var symIdx: int
    var n: int

    k = typeExprKind(te)
    if k == TxWord {
        r.ok = true
        r.readType = IntT
        r.size = 2
        r.align = 2
        return r
    }
    if k == TxByte {
        r.ok = true
        r.readType = IntT
        r.size = 1
        r.align = 1
        return r
    }
    if k == TxPad {
        n = padTypeN(te)
        if n < 1 {
            r.ok = false
            r.badPadLen = true
            return r
        }
        r.ok = true
        r.readType = InvalidT
        r.size = n
        r.align = 1
        return r
    }
    if k == TxXStr {
        n = xstrTypeN(te)
        if n < 1 or n > 255 {
            r.ok = false
            r.badStrLen = true
            return r
        }
        r.ok = true
        r.readType = strT(n)
        r.size = n + 1
        r.align = 1
        return r
    }
    if k == TxNamed {
        name = poolGet(namedTypeName(te))
        if name == "bool" {
            r.ok = true
            r.readType = BoolT
            r.size = 1
            r.align = 1
            return r
        }
        if name == "int" {
            r.ok = true
            r.readType = IntT
            r.size = 4
            r.align = 2
            return r
        }
        if name == "ptr" {
            r.ok = true
            r.readType = PtrT
            r.size = 4
            r.align = 2
            return r
        }
        symIdx = scopeLookup(curScope, namedTypeName(te))
        if symIdx != -1 and symbols[symIdx].isType and typeKind(symbols[symIdx].typeIdx) == TyXRec {
            r.ok = true
            r.readType = symbols[symIdx].typeIdx
            r.size = xrecSize(symbols[symIdx].typeIdx)
            r.align = 2
            return r
        }
        r.ok = false
        return r
    }
    // TxString/TxList/TxMap/TxArray (e.g. `text`, `fixed`, `char`, `string`,
    // a plain `record`/`overlay record` name, or an array/list/map form) --
    // none of these is in the Ch13 palette.
    r.ok = false
    return r
}

// ---- built-in method/function parameter specs (builtins.go's paramSpec) ----
// Exactly one match mode applies per ParamSpec: a plain expected type (t,
// the zero mode), AnyCharArray, AnyRecordish, or a fixed small OneOfKinds
// set (kindCount 2 or 3 -- every current builtin table needs at most 3).
record ParamSpec {
    t: int
    anyCharArray: bool
    anyRecordish: bool
    kindCount: int
    kind1: TypeKind
    kind2: TypeKind
    kind3: TypeKind
    next: int
}

var paramSpecs: list of ParamSpec
var sigHead: int
var sigTail: int
var sigCount: int

func paramSpecAppend(tailIdx: int, idx: int): int {
    if tailIdx >= 0 {
        paramSpecs[tailIdx].next = idx
    }
    return idx
}

func psPlain(t: int): int {
    var p: ParamSpec

    p.t = t
    p.anyCharArray = false
    p.anyRecordish = false
    p.kindCount = 0
    p.kind1 = TyInvalid
    p.kind2 = TyInvalid
    p.kind3 = TyInvalid
    p.next = -1
    paramSpecs.add(p)
    return paramSpecs.count - 1
}

func psAnyCharArray(): int {
    var p: ParamSpec

    p.t = -1
    p.anyCharArray = true
    p.anyRecordish = false
    p.kindCount = 0
    p.kind1 = TyInvalid
    p.kind2 = TyInvalid
    p.kind3 = TyInvalid
    p.next = -1
    paramSpecs.add(p)
    return paramSpecs.count - 1
}

func psAnyRecordish(): int {
    var p: ParamSpec

    p.t = -1
    p.anyCharArray = false
    p.anyRecordish = true
    p.kindCount = 0
    p.kind1 = TyInvalid
    p.kind2 = TyInvalid
    p.kind3 = TyInvalid
    p.next = -1
    paramSpecs.add(p)
    return paramSpecs.count - 1
}

func psOneOf2(k1: TypeKind, k2: TypeKind): int {
    var p: ParamSpec

    p.t = -1
    p.anyCharArray = false
    p.anyRecordish = false
    p.kindCount = 2
    p.kind1 = k1
    p.kind2 = k2
    p.kind3 = TyInvalid
    p.next = -1
    paramSpecs.add(p)
    return paramSpecs.count - 1
}

func psOneOf3(k1: TypeKind, k2: TypeKind, k3: TypeKind): int {
    var p: ParamSpec

    p.t = -1
    p.anyCharArray = false
    p.anyRecordish = false
    p.kindCount = 3
    p.kind1 = k1
    p.kind2 = k2
    p.kind3 = k3
    p.next = -1
    paramSpecs.add(p)
    return paramSpecs.count - 1
}

// ---- built-in method signatures (builtins.go's methodSig) ----
record MethodSig {
    paramsHead: int
    paramCount: int
    ret: int
}

var methodSigs: list of MethodSig

func newMethodSig(paramsHead: int, paramCount: int, ret: int): int {
    var s: MethodSig

    s.paramsHead = paramsHead
    s.paramCount = paramCount
    s.ret = ret
    methodSigs.add(s)
    return methodSigs.count - 1
}

// sigStart/sigAdd/sigEnd build one MethodSig's param chain: sigStart
// resets the scratch builder, sigAdd appends one ParamSpec (by its
// paramSpecs index), sigEnd allocates the MethodSig and returns its index.
// Used only by buildMethodTables, sequentially, never nested.
func sigStart() {
    sigHead = -1
    sigTail = -1
    sigCount = 0
}

func sigAdd(specIdx: int) {
    if sigHead == -1 {
        sigHead = specIdx
    }
    sigTail = paramSpecAppend(sigTail, specIdx)
    sigCount = sigCount + 1
}

func sigEnd(ret: int): int {
    return newMethodSig(sigHead, sigCount, ret)
}

// ---- built-in method tables (name -> methodSigs index) ----
var stringTextMethods: map of int
var textOnlyMethods: map of int
var connectionMethods: map of int
var listenerMethods: map of int
var serviceBrowserMethods: map of int
var fileFuncs: map of int
var canvasMethods: map of int
var canvasProperties: map of int

// ---- const values (Ch3: Constants) ----
// CVal mirrors check.go's ConstVal: exactly one of intVal/strIdx holds the
// value, per isStr -- the same flattened shape types.cla's Symbol already
// uses for a *declared* const's own payload (constIsStr/constInt/
// constStrIdx); CVal is this module's return-value vehicle for computing
// one (Clarus functions return a single value, so a 3-field record stands
// in for Go's multi-field ConstVal struct return).
record CVal {
    isStr: bool
    intVal: int
    strIdx: int
}

func cvInt(n: int): CVal {
    var cv: CVal

    cv.isStr = false
    cv.intVal = n
    cv.strIdx = -1
    return cv
}

func cvStr(s: string): CVal {
    var cv: CVal

    cv.isStr = true
    cv.intVal = 0
    cv.strIdx = intern(s)
    return cv
}

func cvZero(): CVal {
    return cvInt(0)
}

// ---- per-decl / per-expr side tables ----
// funcScopeByDecl/funcRetByDecl: keyed by a DkFunc decl's own arena index,
// recording checkFuncSig's fnScope/ret for checkFuncBody to
// consume in phase 2 WITHOUT re-resolving the signature (re-resolving
// against the wider phase-2 scope would both re-declare the function,
// tripping a false "redeclaration of X", and could wrongly resolve a
// forward-declared signature type that phase 1 correctly rejected).
//
// enumConstOf/constUseIsStr/constUseInt/constUseStr: keyed by an Ident
// expr's own arena index, mirroring Info.EnumConsts/Info.Consts -- the
// resolved value of a bare enum-member Ident, or of an Ident naming a
// `const`. Needed by Task 9b's switch-case-label checking and by any
// later lowering pass, not by any diagnostic this task's driver checks.
//
// exprTypeOf: keyed by an expr's own arena index, recording checkExpr's
// resolved TypeInfo index for that expr (mirrors Go's Info.Types). Needed
// by the later lowering pass, not by any diagnostic this task's driver
// checks.
//
// Every key in all seven of these maps (plus funcSigByDecl, joining the
// family just below, keyed the same decl-indexed way) used within a
// checkProgram call is always freshly written in THAT SAME call before
// anything in that call reads it (a func's decl index is registered in
// phase 1 before phase 2 reads it; an Ident's resolved value is read back
// only by the very same Ident occurrence that wrote it; an expr's type is
// read back only by code that runs after that same expr was checked), so
// a stale entry surviving from a previous program, under a decl/expr
// index a later program happens to reuse, is never CONSULTED before being
// overwritten -- correctness never depended on a bulk clear. enumConstOf/
// constUseIsStr/constUseInt/constUseStr/exprTypeOf are the exception to
// that argument (mac-resident-clarusc Task 11 fix round 2: they're
// written only CONDITIONALLY, not for every node of their own kind, so a
// stale hit at a reused index can misfire -- see checkReset's own doc
// comment there) and do get bulk-cleared in checkReset. funcScopeByDecl/
// funcRetByDecl/funcSigByDecl remain correctness-safe without a reset,
// but memory-leak-fix Task 7 folds them into checkReset too anyway --
// this phase's charter is bounded memory, not just correctness, and an
// intmap left to grow across every driveCompile call in one
// long-running ClarusC.APPL session is exactly the leak class this plan
// exists to close. externFirstDeclByName below is a DIFFERENT idiom
// (name-keyed, not decl-indexed); Task 7 also folds it (and menuItems'
// own menuKey) into checkReset, which retires the progGen-namespacing
// both previously needed -- see their own comments below.
var funcScopeByDecl: intmap of int
var funcRetByDecl: intmap of int

// funcSigByDecl (Task 3, Ch13 dedup) is an eighth decl-indexed side table,
// same family/idiom as the two above: keyed by a DkFunc/DkExternFunc
// decl's own arena index, it always holds THAT decl's own resolved
// FuncSig (checkFuncSig sets it unconditionally, whether or not
// scopeDeclare actually admitted the symbol into scope). checkExternFunc
// reads its OWN decl's sig through here rather than via scopeLookup, so a
// merge-candidate extern (Task 3: its scopeDeclare is skipped -- see
// checkFuncSig below) still gets its OWN param/return types checked
// against its OWN declared params, not the earlier decl's it's being
// compared against.
var funcSigByDecl: intmap of int

// externFirstDeclByName/externMergeCandidate (Task 3, Ch13: `external
// func` dedup -- duplicate extern declarations are legal iff identical,
// see checkFuncSig's DkExternFunc arm and checkExternFunc's tail).
// externFirstDeclByName maps a program's first-seen extern name to that
// decl's own arena index. Was progGen-namespaced (menuKey's own former
// idiom) so it never needed an explicit reset across repeated
// checkProgram calls in the same process; memory-leak-fix Task 7 folds it
// into checkReset instead (bounded-memory charter -- a progGen-namespaced
// key never repeats, so the map only ever grows) and drops the
// namespacing back to a plain name key. A non-extern decl (ordinary func)
// never touches this map, so a func-vs-extern name collision always falls
// through to the ordinary scopeDeclare/"redeclaration of X" path,
// unaffected by any of this.
// externMergeCandidate is scratch state: checkFuncSig sets it (to -1, or
// to the FIRST decl's index on a same-name repeat) every time it runs for
// a DkExternFunc decl; checkExternFunc reads it back immediately after
// its own checkFuncSig(d) call -- safe because nothing reenters
// checkFuncSig in between (single-threaded, no recursion here).
var externFirstDeclByName: map of int
var externMergeCandidate: int
var enumConstOf: intmap of int
var constUseIsStr: intmap of int
var constUseInt: intmap of int
var constUseStr: intmap of string
// exprTypeOf is keyed by expr arena index; lower.cla/cprint.cla (the emit
// path) read it via exprTypeGet AFTER checkProgram, in the SAME process, with
// no astReset in between -- `clarusc emit` runs one program per process, so
// those indices still name the AST that produced these entries.
var exprTypeOf: intmap of int

func enumConstGet(e: int): int {
    return enumConstOf.get(e, 0)
}

func exprTypeGet(e: int): int {
    return exprTypeOf.get(e, InvalidT)
}

// ================================================================
// Statement / handler checking state (stmt.go, events.go)
// ================================================================

// loopDepth counts enclosing while/for loop bodies (checkLoopBody
// increments/decrements it); switch case/else bodies do NOT increment it,
// so break/continue inside a case body binds the enclosing LOOP. Zero
// outside any loop. inCloseRequest is true only while checking a window's
// own closeRequest handler body -- the sole place `cancel` is valid.
var loopDepth: int
var inCloseRequest: bool

// appDeclSeen is true once a program's (at most one) app section has been
// checked -- checkAppDecl uses it to reject a second one outright, rather
// than re-validating its properties.
var appDeclSeen: bool

// usesFileSaveLoad is true once the program under check has called
// file.save/file.load (checkMethodCall's `file` arm sets it) -- main.cla's
// implicit runtime-module manifest reads this after checkProgram to decide
// whether the serialization runtime module needs pulling into the emit.
var usesFileSaveLoad: bool

// usesSortedMap is true once the program under check has named `sortedmap
// of T` anywhere a type is resolved (resolveType's TxSortedMap arm sets
// it, mirroring usesFileSaveLoad above) -- drive.cla's manifest splice
// reads this to decide whether the sortedmap runtime module needs pulling
// into the emit.
var usesSortedMap: bool

// usesDateTime is true once the program under check has called one of
// the date/time builtins (now/dateTimeStr/durationStr) -- drive.cla's
// manifest splice reads it to decide whether runtime/clarus/datetime.cla
// (plus exactly one per-lane rtNow variant) must be spliced. Mirrors
// usesSortedMap above.
var usesDateTime: bool

// progGen is bumped by every checkReset so a name-keyed side table that
// isn't itself bulk-cleared can namespace its keys and never consult a
// stale entry from a previous program compiled in the same process --
// still used by this file's own xrecFirstDeclByName (see its own comment)
// and by lower.cla's uiMenuIdx/uiWinHandlersIdx/winVarDefaultsHead.
// menuItems/externFirstDeclByName USED to rely on this too, but
// memory-leak-fix Task 7 folds both into checkReset directly (bounded-
// memory charter: a progGen-namespaced key never repeats, so those two
// maps only ever grew) and dropped their namespacing back to plain keys
// -- see their own comments below.
var progGen: int

// ================================================================
// Window/menu declaration side tables (ui.go's WindowInfo/MenuInfo)
// ================================================================
// types.cla's TyWindowRef carries only its name; the per-window layout
// (form-ness, form record, per-instance vars, widgets) is this module's own
// set of name-keyed side tables -- exactly Go's types.Type.Window
// *WindowInfo side pointer, restated as maps + arenas. Each is OVERWRITTEN
// per window in checkWindowDecl (phase 1, source order), and only ever read
// for a window that resolves in the current program's (reset) scope, so a
// stale entry for a window absent from the current program is never
// consulted -- the same argument recFieldsHeadByName relies on. Still
// correctness-safe without a reset; memory-leak-fix Task 7 folds
// windowIsForm/windowFormRecType/windowVarsHead/windowWidgetsHead into
// checkReset anyway (bounded-memory charter -- an unreset map only ever
// grows across repeated driveCompile calls in one long-running
// ClarusC.APPL session).

// per-instance vars reuse the FieldInfo arena (name+type+next); widgets get
// their own WidgetInfo arena.
record WidgetInfo {
    nameIdx: int
    kindIdx: int
    bindsIdx: int
    next: int
}

var widgetInfos: list of WidgetInfo

func newWidgetInfo(nameIdx: int, kindIdx: int, bindsIdx: int): int {
    var w: WidgetInfo

    w.nameIdx = nameIdx
    w.kindIdx = kindIdx
    w.bindsIdx = bindsIdx
    w.next = -1
    widgetInfos.add(w)
    return widgetInfos.count - 1
}

func widgetInfoAppend(tailIdx: int, idx: int): int {
    if tailIdx >= 0 {
        widgetInfos[tailIdx].next = idx
    }
    return idx
}

var windowIsForm: map of int
var windowFormRecType: map of int
// windowVarsHead/windowWidgetsHead (Task 6, layer1-compiler-perf) are
// keyed by the window's interned nameIdx rather than its poolGet name
// string -- same saved-round-trip argument as recFieldsHeadByName above.
// lower.cla reads both directly (no accessor function) at
// lowBareWindowMemberRef/lowWindowInstSelect (windowVarsHead) and
// through the public uiWidgetIndex/widgetBindsIdx helpers
// (windowWidgetsHead), all converted to nameIdx alongside this pair --
// see those functions' own doc comments there. windowIsForm/
// windowFormRecType stay name-keyed (no comparable hot path reads them).
var windowVarsHead: intmap of int
var windowWidgetsHead: intmap of int

// menuItems is the flattened set of every declared menu's item names,
// keyed (menuName | itemName). checkMenuDecl populates it; checkMenuItemName
// / checkMenuExtend read it. Was progGen-namespaced so it needed no reset;
// memory-leak-fix Task 7 folds it into checkReset instead (bounded-memory
// charter) and drops the namespacing back to a plain key -- safe because
// checkReset now clears the whole map before any window/menu in the new
// program gets checked.
var menuItems: map of int

func menuKey(menuName: string, itemName: string): string {
    return menuName + "|" + itemName
}

// ---- Ch8 widget/window property tables (ui.go) ----
// windowTopProps: allowed window-body property names. widgetDeclProps:
// allowed declaration-time properties, keyed "kind.prop". widgetRuntimeProps:
// a Widget.property Select's result type, keyed "kind.prop" (canvas's
// width/height folded in here rather than a nested map). Rebuilt every
// checkReset since widgetRuntimeProps values are type-arena indices.
var windowTopProps: map of int
var widgetDeclProps: map of int
var widgetRuntimeProps: map of int
var appProps: map of int

func buildUiTables() {
    windowTopProps["title"] = 1
    windowTopProps["size"] = 1
    windowTopProps["resizable"] = 1

    appProps["name"] = 1
    appProps["version"] = 1
    appProps["author"] = 1
    appProps["about"] = 1
    appProps["icon"] = 1
    appProps["id"] = 1
    appProps["doctype"] = 1
    appProps["stack"] = 1

    widgetDeclProps["button.caption"] = 1
    widgetDeclProps["button.at"] = 1
    widgetDeclProps["button.width"] = 1
    widgetDeclProps["button.default"] = 1
    widgetDeclProps["button.cancel"] = 1

    widgetDeclProps["field.label"] = 1
    widgetDeclProps["field.at"] = 1
    widgetDeclProps["field.width"] = 1
    widgetDeclProps["field.binds"] = 1

    widgetDeclProps["textview.at"] = 1
    widgetDeclProps["textview.fill"] = 1
    widgetDeclProps["textview.scrollbar"] = 1

    widgetDeclProps["check.caption"] = 1
    widgetDeclProps["check.at"] = 1
    widgetDeclProps["check.binds"] = 1

    widgetDeclProps["popup.label"] = 1
    widgetDeclProps["popup.at"] = 1
    widgetDeclProps["popup.binds"] = 1

    widgetDeclProps["table.rows"] = 1
    widgetDeclProps["table.at"] = 1
    widgetDeclProps["table.fill"] = 1

    widgetDeclProps["canvas.at"] = 1
    widgetDeclProps["canvas.fill"] = 1
    widgetDeclProps["canvas.buffered"] = 1

    widgetDeclProps["label.text"] = 1
    widgetDeclProps["label.at"] = 1
    widgetDeclProps["label.width"] = 1

    widgetRuntimeProps["button.caption"] = strT(255)
    widgetRuntimeProps["button.enabled"] = BoolT
    widgetRuntimeProps["field.text"] = strT(255)
    widgetRuntimeProps["field.enabled"] = BoolT
    widgetRuntimeProps["textview.text"] = TextT
    widgetRuntimeProps["check.checked"] = BoolT
    widgetRuntimeProps["popup.selected"] = IntT
    widgetRuntimeProps["table.selected"] = IntT
    widgetRuntimeProps["canvas.width"] = IntT
    widgetRuntimeProps["canvas.height"] = IntT
    widgetRuntimeProps["label.text"] = strT(255)
}

// ================================================================
// The Appendix B events table (events.go)
// ================================================================
// An event's fixed handler signature: a param chain (name + required type)
// plus its count. Keyed in eventTable by "context.event".
record EventParam {
    nameIdx: int
    typeIdx: int
    next: int
}

var eventParams: list of EventParam

record EventSpec {
    paramsHead: int
    paramCount: int
}

var eventSpecs: list of EventSpec

var eventTable: map of int

func newEventParam(nameIdx: int, typeIdx: int, next: int): int {
    var p: EventParam

    p.nameIdx = nameIdx
    p.typeIdx = typeIdx
    p.next = next
    eventParams.add(p)
    return eventParams.count - 1
}

func newEventSpec(paramsHead: int, count: int): int {
    var s: EventSpec

    s.paramsHead = paramsHead
    s.paramCount = count
    eventSpecs.add(s)
    return eventSpecs.count - 1
}

func addEvent(key: string, paramsHead: int, count: int) {
    eventTable[key] = newEventSpec(paramsHead, count)
}

// makeSpec1 builds a one-param spec on the fly -- for `on accepted(rec)`,
// whose param type is the form window's own record (resolved per window,
// so it isn't a fixed row of the table).
func makeSpec1(nameIdx: int, typeIdx: int): int {
    return newEventSpec(newEventParam(nameIdx, typeIdx, -1), 1)
}

// buildEventsTable transcribes Appendix B whole. Rebuilt every checkReset
// since every param type (and connectionT/AddressT/...) is a type-arena
// index invalidated by typesReset.
func buildEventsTable() {
    var p1: int
    var p2: int

    addEvent("app.launch", -1, 0)
    addEvent("app.startEmpty", -1, 0)
    addEvent("app.openDocument", newEventParam(intern("path"), strT(255), -1), 1)
    addEvent("app.startCLI", newEventParam(intern("args"), listT(strT(255)), -1), 1)

    addEvent("window.opened", -1, 0)
    addEvent("window.closeRequest", -1, 0)
    addEvent("window.closed", -1, 0)
    addEvent("window.resized", -1, 0)
    addEvent("window.key", newEventParam(intern("k"), CharT, -1), 1)

    addEvent("formWindow.cancelled", -1, 0)

    addEvent("button.click", -1, 0)
    addEvent("field.change", -1, 0)
    addEvent("field.enter", -1, 0)
    addEvent("textview.change", -1, 0)
    addEvent("check.change", -1, 0)
    addEvent("popup.change", -1, 0)

    addEvent("table.select", newEventParam(intern("i"), IntT, -1), 1)
    addEvent("table.doubleClick", newEventParam(intern("i"), IntT, -1), 1)

    p2 = newEventParam(intern("y"), IntT, -1)
    p1 = newEventParam(intern("x"), IntT, p2)
    addEvent("canvas.click", p1, 2)
    p2 = newEventParam(intern("y"), IntT, -1)
    p1 = newEventParam(intern("x"), IntT, p2)
    addEvent("canvas.drag", p1, 2)

    addEvent("menuItem.select", -1, 0)

    addEvent("connection.opened", -1, 0)
    addEvent("connection.received", newEventParam(intern("data"), TextT, -1), 1)
    addEvent("connection.closed", -1, 0)
    addEvent("connection.failed", newEventParam(intern("err"), ErrTIndex, -1), 1)

    addEvent("listener.accepted", newEventParam(intern("c"), connectionT, -1), 1)
    addEvent("listener.failed", newEventParam(intern("err"), ErrTIndex, -1), 1)

    p2 = newEventParam(intern("addr"), AddressT, -1)
    p1 = newEventParam(intern("name"), strT(255), p2)
    addEvent("serviceBrowser.found", p1, 2)
    addEvent("serviceBrowser.failed", newEventParam(intern("err"), ErrTIndex, -1), 1)
}

// formatEventParams renders an event spec's params for a "takes (...)"
// diagnostic (events.go's formatParams) -- "name: type, ..." or "" for a
// no-param event.
func formatEventParams(specIdx: int): string {
    var s: string
    var ep: int
    var first: bool

    s = ""
    first = true
    ep = eventSpecs[specIdx].paramsHead
    while ep != -1 {
        if not first {
            s = s + ", "
        }
        s = s + poolGet(eventParams[ep].nameIdx) + ": " + typeName(eventParams[ep].typeIdx)
        first = false
        ep = eventParams[ep].next
    }
    return s
}

// splitDots splits a dotted handler path ("Go.click", "closeRequest") into
// its segments -- events.go relies on Go's []string Path; the parser joined
// it into one interned string (ast.cla's DkHandler schema), so it's re-split
// here.
func splitDots(s: string): list of string {
    var parts: list of string
    var cur: string
    var i: int
    var c: char

    cur = ""
    i = 0
    while i < s.length {
        c = s[i]
        if c == '.' {
            parts.add(cur)
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    parts.add(cur)
    return parts
}

// ================================================================
// Diagnostic-rendering helpers (expr.go's typeName/kindsList/isResourceKind)
// ================================================================

// typeName renders t for diagnostics -- a byte-exact port of expr.go's
// typeName. Every call site passes a concrete (non-InvalidT) type, exactly
// as in Go (typeName is only ever called after an InvalidT guard).
func typeName(t: int): string {
    switch typeKind(t) {
    case TyInt {
        return "int"
    }
    case TyBool {
        return "bool"
    }
    case TyFixed {
        return "fixed"
    }
    case TyChar {
        return "char"
    }
    case TyStr {
        return "string"
    }
    case TyText {
        return "text"
    }
    case TyVoid {
        return "void"
    }
    case TyAddress {
        return "address"
    }
    case TyPtr {
        return "ptr"
    }
    case TyErrorType {
        return "error"
    }
    case TyConnection {
        return "connection"
    }
    case TyListener {
        return "listener"
    }
    case TyServiceBrowser {
        return "serviceBrowser"
    }
    case TyEnum {
        return poolGet(typeNameIdx(t))
    }
    case TyRec {
        return poolGet(typeNameIdx(t))
    }
    case TyOverlay {
        return poolGet(typeNameIdx(t))
    }
    case TyXRec {
        return poolGet(typeNameIdx(t))
    }
    case TyWindowRef {
        return poolGet(typeNameIdx(t))
    }
    case TyArr {
        return typeName(typeElem(t)) + "[]"
    }
    case TyList {
        return "list of " + typeName(typeElem(t))
    }
    case TyMap {
        return "map of " + typeName(typeElem(t))
    }
    case TySortedMap {
        return "sortedmap of " + typeName(typeElem(t))
    }
    case TyIntMap {
        return "intmap of " + typeName(typeElem(t))
    }
    }
    return "?"
}

// kindName renders a bare TypeKind (no arena entry) for a OneOfKinds
// diagnostic -- every kind ever used in a OneOfKinds set (String, Char,
// Address, Text) needs no capacity/elem/name to render, so this mirrors
// typeName's scalar cases without needing a throwaway typeArena entry.
func kindName(k: TypeKind): string {
    switch k {
    case TyInt {
        return "int"
    }
    case TyBool {
        return "bool"
    }
    case TyFixed {
        return "fixed"
    }
    case TyChar {
        return "char"
    }
    case TyStr {
        return "string"
    }
    case TyText {
        return "text"
    }
    case TyVoid {
        return "void"
    }
    case TyAddress {
        return "address"
    }
    case TyErrorType {
        return "error"
    }
    case TyConnection {
        return "connection"
    }
    case TyListener {
        return "listener"
    }
    case TyServiceBrowser {
        return "serviceBrowser"
    }
    case TyEnum {
        return "enum"
    }
    case TyRec {
        return "record"
    }
    case TyWindowRef {
        return "window"
    }
    case TyArr {
        return "array"
    }
    case TyList {
        return "list"
    }
    case TyMap {
        return "map"
    }
    case TySortedMap {
        return "sortedmap"
    }
    case TyIntMap {
        return "intmap"
    }
    }
    return "?"
}

// kindsList renders a OneOfKinds paramSpec's allowed kinds for a
// diagnostic, e.g. "string or address" / "a, b, or c" -- a byte-exact port
// of expr.go's kindsList, specialized to the kind1/kind2/kind3/count shape
// ParamSpec uses instead of a slice.
func kindsList(k1: TypeKind, k2: TypeKind, k3: TypeKind, count: int): string {
    if count == 1 {
        return kindName(k1)
    }
    if count == 2 {
        return kindName(k1) + " or " + kindName(k2)
    }
    return kindName(k1) + ", " + kindName(k2) + ", or " + kindName(k3)
}

// isResourceKind reports whether k is a window ref or one of the network
// resource kinds -- the only kinds `nil` is valid for.
func isResourceKind(k: TypeKind): bool {
    return k == TyWindowRef or k == TyConnection or k == TyListener or k == TyServiceBrowser
}

func isTextish(t: int): bool {
    return typeKind(t) == TyStr or typeKind(t) == TyText
}

// compatible is the checker's own assignability wrapper (expr.go's
// compatible), kept as a distinct name for parity with the Go source even
// though it is presently a bare alias for assignable.
func compatible(src: int, dst: int): bool {
    return assignable(src, dst)
}

func exprListCount(head: int): int {
    var n: int
    var a: int

    n = 0
    a = head
    while a != -1 {
        n = n + 1
        a = exprNext(a)
    }
    return n
}

// ================================================================
// Built-in universe (builtins.go)
// ================================================================

func declBuiltinType(scope: int, name: string, t: int) {
    var sym: Symbol

    sym.nameIdx = intern(name)
    sym.typeIdx = t
    sym.isFunc = false
    sym.sigIdx = -1
    sym.isType = true
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    scopeDeclare(scope, sym)
}

func declBuiltinVar(scope: int, name: string, t: int) {
    var sym: Symbol

    sym.nameIdx = intern(name)
    sym.typeIdx = t
    sym.isFunc = false
    sym.sigIdx = -1
    sym.isType = false
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    scopeDeclare(scope, sym)
}

// declBuiltinStrConst declares a predeclared `const NAME: string` (Ch3:
// Constants; reference:375's `const versionTag: string = "..."` is the
// user-facing precedent this reuses the shape of) -- same Symbol shape
// checkConstDecl builds for a user-written const, just seeded directly
// into the universe scope instead of coming off a DkConst AST node. Used
// for the four fileType* constants (native-gaps-cleanup Task 1, Part A).
func declBuiltinStrConst(scope: int, name: string, val: string) {
    var sym: Symbol

    sym.nameIdx = intern(name)
    sym.typeIdx = strT(255)
    sym.isFunc = false
    sym.sigIdx = -1
    sym.isType = false
    sym.isConst = true
    sym.constIsStr = true
    sym.constInt = 0
    sym.constStrIdx = intern(val)
    sym.isMenu = false
    scopeDeclare(scope, sym)
}

func declBuiltinFunc0(scope: int, name: string, ret: int) {
    var params: list of int
    var sigIdx: int
    var sym: Symbol

    sigIdx = newFuncSig(params, ret)
    sym.nameIdx = intern(name)
    sym.typeIdx = -1
    sym.isFunc = true
    sym.sigIdx = sigIdx
    sym.isType = false
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    scopeDeclare(scope, sym)
}

func declBuiltinFunc1(scope: int, name: string, p1: int, ret: int) {
    var params: list of int
    var sigIdx: int
    var sym: Symbol

    params.add(p1)
    sigIdx = newFuncSig(params, ret)
    sym.nameIdx = intern(name)
    sym.typeIdx = -1
    sym.isFunc = true
    sym.sigIdx = sigIdx
    sym.isType = false
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    scopeDeclare(scope, sym)
}

func declBuiltinFunc2(scope: int, name: string, p1: int, p2: int, ret: int) {
    var params: list of int
    var sigIdx: int
    var sym: Symbol

    params.add(p1)
    params.add(p2)
    sigIdx = newFuncSig(params, ret)
    sym.nameIdx = intern(name)
    sym.typeIdx = -1
    sym.isFunc = true
    sym.sigIdx = sigIdx
    sym.isType = false
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    scopeDeclare(scope, sym)
}

// registerUniverse populates scope with the built-in dialogs, resource/
// error/saveChoice type names, and lastError -- a byte-exact port of
// builtins.go's registerBuiltins.
func registerUniverse(scope: int) {
    declBuiltinType(scope, "connection", connectionT)
    declBuiltinType(scope, "listener", listenerT)
    declBuiltinType(scope, "serviceBrowser", serviceBrowserT)
    declBuiltinType(scope, "address", AddressT)
    declBuiltinType(scope, "error", ErrTIndex)
    declBuiltinType(scope, "saveChoice", SaveChoiceT)

    declBuiltinFunc1(scope, "alert", strT(255), -1)
    // askOpen(path, types) -- native-gaps-cleanup Task 2: `types` is a
    // mandatory second arg (comma-separated 4-char codes, "*" = all
    // files); see lowCall's "askOpen" arm (lower.cla) for the literal
    // filter validation and uidialogs.cla's nat_UiSFGetFile for the
    // runtime parse/pad/validate rule every lane implements.
    declBuiltinFunc2(scope, "askOpen", strT(255), strT(255), BoolT)
    declBuiltinFunc2(scope, "askSave", strT(255), strT(255), BoolT)
    declBuiltinFunc1(scope, "askSaveChanges", strT(255), SaveChoiceT)
    declBuiltinFunc1(scope, "log", strT(255), -1)

    // Date/time builtins (2026-08-10 datetime-instrumentation spec): a
    // datetime is a plain int (unsigned Mac-epoch seconds); see
    // runtime/clarus/datetime.cla for the backing functions these lower
    // to (lowCall's arms) when drive.cla splices it (usesDateTime).
    declBuiltinFunc0(scope, "now", IntT)
    declBuiltinFunc1(scope, "dateTimeStr", IntT, strT(255))
    declBuiltinFunc1(scope, "durationStr", IntT, strT(255))

    declBuiltinFunc1(scope, "peekb", PtrT, IntT)
    declBuiltinFunc1(scope, "peekw", PtrT, IntT)
    declBuiltinFunc1(scope, "peekl", PtrT, IntT)
    declBuiltinFunc2(scope, "pokeb", PtrT, IntT, -1)
    declBuiltinFunc2(scope, "pokew", PtrT, IntT, -1)
    declBuiltinFunc2(scope, "pokel", PtrT, IntT, -1)

    declBuiltinVar(scope, "lastError", ErrTIndex)

    // fileTypeText/Data/Picture/Application (native-gaps-cleanup Task 1,
    // Part A) -- predeclared four-character-code string constants for use
    // with app.doctype/file.writeText/file.save/askOpen; see
    // declBuiltinStrConst's own doc comment.
    declBuiltinStrConst(scope, "fileTypeText", "TEXT")
    declBuiltinStrConst(scope, "fileTypeData", "CLRD")
    declBuiltinStrConst(scope, "fileTypePicture", "PICT")
    declBuiltinStrConst(scope, "fileTypeApplication", "APPL")
}

// buildMethodTables populates the string/text/list-adjacent/connection/
// listener/serviceBrowser/file/canvas method-signature tables -- a
// byte-exact port of builtins.go's stringTextMethods/textOnlyMethods/
// connectionMethods/listenerMethods/serviceBrowserMethods/fileFuncs/
// canvasMethods/canvasProperties. (`list of T`/`map of T` operations are
// NOT table-driven -- their element type is per-declaration, see
// checkListMethod/checkMapMethod below, matching Go's own comment.)
func buildMethodTables() {
    sigStart()
    sigAdd(psAnyCharArray())
    sigAdd(psPlain(IntT))
    stringTextMethods["fromBytes"] = sigEnd(-1)

    sigStart()
    sigAdd(psAnyCharArray())
    stringTextMethods["toBytes"] = sigEnd(IntT)

    sigStart()
    sigAdd(psOneOf2(TyStr, TyChar))
    stringTextMethods["indexOf"] = sigEnd(IntT)

    sigStart()
    sigAdd(psOneOf3(TyStr, TyChar, TyText))
    textOnlyMethods["append"] = sigEnd(-1)

    sigStart()
    sigAdd(psOneOf2(TyStr, TyAddress))
    connectionMethods["open"] = sigEnd(-1)

    sigStart()
    sigAdd(psOneOf2(TyText, TyStr))
    connectionMethods["send"] = sigEnd(-1)

    sigStart()
    connectionMethods["close"] = sigEnd(-1)

    sigStart()
    sigAdd(psPlain(IntT))
    listenerMethods["listen"] = sigEnd(-1)

    sigStart()
    sigAdd(psPlain(strT(255)))
    sigAdd(psPlain(strT(255)))
    listenerMethods["register"] = sigEnd(-1)

    sigStart()
    sigAdd(psPlain(strT(255)))
    serviceBrowserMethods["find"] = sigEnd(-1)

    sigStart()
    sigAdd(psPlain(strT(255)))
    sigAdd(psPlain(TextT))
    fileFuncs["readText"] = sigEnd(BoolT)

    // file.writeText(path, text, type, creator) -- native-gaps-cleanup
    // Task 2: type/creator are mandatory (no defaults/sentinels); see
    // lowFileCall's "writeText" arm for the literal-argument validation
    // and runtime/clarus/native.cla's natFileWriteText (native lane) /
    // runtime/mac/rt_mac.c's rt_file_write_text (C lane) for the
    // pad/validate/stamp rule.
    sigStart()
    sigAdd(psPlain(strT(255)))
    sigAdd(psPlain(TextT))
    sigAdd(psPlain(strT(255)))
    sigAdd(psPlain(strT(255)))
    fileFuncs["writeText"] = sigEnd(BoolT)

    // file.readResource(name, out) -- Task 7 (mac-resident-clarusc):
    // fills `out` from the named 'CLFS' resource in the current resource
    // chain; same shape as readText above (str255 name, text out-param).
    // Host lane always fails (no resource fork on that filesystem, see
    // rt.c's rt_file_read_resource); native lane is
    // runtime/clarus/native.cla's natReadResource.
    sigStart()
    sigAdd(psPlain(strT(255)))
    sigAdd(psPlain(TextT))
    fileFuncs["readResource"] = sigEnd(BoolT)

    // file.writeRes(path, fork, doctype, creator) -- Task 7: writes
    // `fork`'s bytes verbatim as `path`'s resource fork (data fork left
    // empty), stamped with doctype/creator -- same mandatory-literal-
    // type/creator rule as writeText above (lowFileCall's "writeRes" arm
    // validates via lowCheckLiteral4CCArg). Host lane always fails (see
    // rt.c's rt_file_write_res); native lane is natWriteRes.
    sigStart()
    sigAdd(psPlain(strT(255)))
    sigAdd(psPlain(TextT))
    sigAdd(psPlain(strT(255)))
    sigAdd(psPlain(strT(255)))
    fileFuncs["writeRes"] = sigEnd(BoolT)

    // file.save(path, rec, type, creator) -- same Task 2 rule as
    // writeText above; file.load stays 2-arg (loading needs no type
    // info).
    sigStart()
    sigAdd(psPlain(strT(255)))
    sigAdd(psAnyRecordish())
    sigAdd(psPlain(strT(255)))
    sigAdd(psPlain(strT(255)))
    fileFuncs["save"] = sigEnd(BoolT)

    sigStart()
    sigAdd(psPlain(strT(255)))
    sigAdd(psAnyRecordish())
    fileFuncs["load"] = sigEnd(BoolT)

    sigStart()
    sigAdd(psPlain(strT(255)))
    fileFuncs["name"] = sigEnd(strT(255))

    // canvas (Ch11: Drawing) -- data only; unreachable in 9a/9b's expr
    // checking until a later task adds widget symbols (checkMethodCall's
    // TyWidget case below has nothing that ever types as TyWidget yet).
    sigStart()
    canvasMethods["clear"] = sigEnd(-1)

    sigStart()
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    canvasMethods["line"] = sigEnd(-1)

    sigStart()
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    canvasMethods["rect"] = sigEnd(-1)

    sigStart()
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    canvasMethods["fillRect"] = sigEnd(-1)

    sigStart()
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    canvasMethods["circle"] = sigEnd(-1)

    sigStart()
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    canvasMethods["fillCircle"] = sigEnd(-1)

    sigStart()
    sigAdd(psPlain(IntT))
    canvasMethods["pattern"] = sigEnd(-1)

    sigStart()
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(IntT))
    sigAdd(psPlain(strT(255)))
    canvasMethods["drawText"] = sigEnd(-1)

    canvasProperties["width"] = IntT
    canvasProperties["height"] = IntT
}

// ================================================================
// checkParamArg (expr.go)
// ================================================================

func checkParamArg(arg: int, specIdx: int) {
    var t: int

    if paramSpecs[specIdx].anyCharArray {
        t = checkExpr(arg, -1)
        if t == InvalidT {
            return
        }
        if not (typeKind(t) == TyArr and typeKind(typeElem(t)) == TyChar) {
            emitDiag(exprLine(arg), exprCol(arg), "cannot use " + typeName(t) + " where a char array is expected")
        }
        return
    }
    if paramSpecs[specIdx].anyRecordish {
        t = checkExpr(arg, -1)
        if t == InvalidT {
            return
        }
        if typeKind(t) == TyRec or ((typeKind(t) == TyList or typeKind(t) == TyMap) and typeKind(typeElem(t)) == TyRec) {
            return
        }
        emitDiag(exprLine(arg), exprCol(arg), "cannot use " + typeName(t) + " where a record is expected")
        return
    }
    if paramSpecs[specIdx].kindCount > 0 {
        t = checkExpr(arg, -1)
        if t == InvalidT {
            return
        }
        if typeKind(t) == paramSpecs[specIdx].kind1 {
            return
        }
        if paramSpecs[specIdx].kindCount >= 2 and typeKind(t) == paramSpecs[specIdx].kind2 {
            return
        }
        if paramSpecs[specIdx].kindCount >= 3 and typeKind(t) == paramSpecs[specIdx].kind3 {
            return
        }
        emitDiag(exprLine(arg), exprCol(arg), "cannot use " + typeName(t) + " here (expected " + kindsList(paramSpecs[specIdx].kind1, paramSpecs[specIdx].kind2, paramSpecs[specIdx].kind3, paramSpecs[specIdx].kindCount) + ")")
        return
    }
    t = checkExpr(arg, paramSpecs[specIdx].t)
    if t != InvalidT and not compatible(t, paramSpecs[specIdx].t) {
        emitDiag(exprLine(arg), exprCol(arg), "cannot use " + typeName(t) + " where " + typeName(paramSpecs[specIdx].t) + " is expected")
    }
}

// checkTableMethod checks a call against a fixed methodSig table (string,
// text, connection, listener, serviceBrowser, and the `file` namespace).
func checkTableMethod(table: map of int, sel: int, argsHead: int): int {
    var name: string
    var sigIdx: int
    var wantCount: int
    var haveCount: int
    var a: int
    var p: int

    name = poolGet(selectName(sel))
    if not table.has(name) {
        emitDiag(exprLine(sel), exprCol(sel), "undefined: " + name)
        return InvalidT
    }
    sigIdx = table.get(name, -1)
    wantCount = methodSigs[sigIdx].paramCount
    haveCount = exprListCount(argsHead)
    if haveCount != wantCount {
        emitDiag(exprLine(sel), exprCol(sel), "wrong number of arguments to " + name)
    } else {
        a = argsHead
        p = methodSigs[sigIdx].paramsHead
        while a != -1 {
            checkParamArg(a, p)
            a = exprNext(a)
            p = paramSpecs[p].next
        }
    }
    if methodSigs[sigIdx].ret == -1 {
        return VoidT
    }
    return methodSigs[sigIdx].ret
}

// checkListMethod checks `list of T` operations (Ch3: Lists).
func checkListMethod(lt: int, sel: int, argsHead: int): int {
    var elem: int
    var name: string
    var argCount: int

    elem = typeElem(lt)
    name = poolGet(selectName(sel))
    argCount = exprListCount(argsHead)

    if name == "add" or name == "push" or name == "unshift" {
        if argCount != 1 {
            emitDiag(exprLine(sel), exprCol(sel), "wrong number of arguments to " + name)
            return VoidT
        }
        checkParamArg(argsHead, psPlain(elem))
        return VoidT
    }
    if name == "pop" or name == "shift" or name == "first" or name == "last" {
        if argCount != 0 {
            emitDiag(exprLine(sel), exprCol(sel), "wrong number of arguments to " + name)
        }
        return elem
    }
    if name == "remove" {
        if argCount != 1 {
            emitDiag(exprLine(sel), exprCol(sel), "wrong number of arguments to " + name)
            return VoidT
        }
        checkParamArg(argsHead, psPlain(IntT))
        return VoidT
    }
    if name == "count" {
        if argCount != 0 {
            emitDiag(exprLine(sel), exprCol(sel), "count takes no arguments")
        }
        return IntT
    }
    if name == "clear" {
        if argCount != 0 {
            emitDiag(exprLine(sel), exprCol(sel), "clear takes no arguments")
        }
        return VoidT
    }
    emitDiag(exprLine(sel), exprCol(sel), "undefined: " + name)
    return InvalidT
}

// checkMapMethod checks `map of T`/`sortedmap of T`/`intmap of T`
// operations (Ch3: Maps) -- keyT parameterizes the key type checked for
// get/has/remove (strT(255) for map/sortedmap, IntT for intmap) so all
// three families share one implementation.
func checkMapMethod(mt: int, sel: int, argsHead: int, keyT: int): int {
    var elem: int
    var name: string
    var argCount: int
    var a1: int
    var a2: int

    elem = typeElem(mt)
    name = poolGet(selectName(sel))
    argCount = exprListCount(argsHead)

    if name == "get" {
        if argCount != 2 {
            emitDiag(exprLine(sel), exprCol(sel), "wrong number of arguments to " + name)
            return elem
        }
        a1 = argsHead
        a2 = exprNext(a1)
        checkParamArg(a1, psPlain(keyT))
        checkParamArg(a2, psPlain(elem))
        return elem
    }
    if name == "has" {
        if argCount != 1 {
            emitDiag(exprLine(sel), exprCol(sel), "wrong number of arguments to " + name)
            return BoolT
        }
        checkParamArg(argsHead, psPlain(keyT))
        return BoolT
    }
    if name == "remove" {
        if argCount != 1 {
            emitDiag(exprLine(sel), exprCol(sel), "wrong number of arguments to " + name)
            return VoidT
        }
        checkParamArg(argsHead, psPlain(keyT))
        return VoidT
    }
    if name == "count" {
        if argCount != 0 {
            emitDiag(exprLine(sel), exprCol(sel), "count takes no arguments")
        }
        return IntT
    }
    if name == "clear" {
        if argCount != 0 {
            emitDiag(exprLine(sel), exprCol(sel), "clear takes no arguments")
        }
        return VoidT
    }
    emitDiag(exprLine(sel), exprCol(sel), "undefined: " + name)
    return InvalidT
}

// checkMethodCall dispatches `x.name(args)` by the receiver's kind.
func checkMethodCall(sel: int, argsHead: int): int {
    var x: int
    var xt: int
    var name: string

    x = selectX(sel)
    if exprKind(x) == ExIdent and identName(x) == cnFile {
        name = poolGet(selectName(sel))
        if name == "save" or name == "load" {
            // Marks the program as needing the serialization runtime
            // module (main.cla's implicit-inclusion manifest consults this
            // at emit time; Task 7 wires the real module in).
            usesFileSaveLoad = true
        }
        return checkTableMethod(fileFuncs, sel, argsHead)
    }
    xt = checkExpr(x, -1)
    if xt == InvalidT {
        return InvalidT
    }
    name = poolGet(selectName(sel))
    switch typeKind(xt) {
    case TyList {
        return checkListMethod(xt, sel, argsHead)
    }
    case TyMap {
        return checkMapMethod(xt, sel, argsHead, strT(255))
    }
    case TySortedMap {
        return checkMapMethod(xt, sel, argsHead, strT(255))
    }
    case TyIntMap {
        return checkMapMethod(xt, sel, argsHead, IntT)
    }
    case TyText {
        if textOnlyMethods.has(name) {
            return checkTableMethod(textOnlyMethods, sel, argsHead)
        }
        return checkTableMethod(stringTextMethods, sel, argsHead)
    }
    case TyStr {
        return checkTableMethod(stringTextMethods, sel, argsHead)
    }
    case TyConnection {
        return checkTableMethod(connectionMethods, sel, argsHead)
    }
    case TyListener {
        return checkTableMethod(listenerMethods, sel, argsHead)
    }
    case TyServiceBrowser {
        return checkTableMethod(serviceBrowserMethods, sel, argsHead)
    }
    case TyWidget {
        // Only a canvas widget has methods (Ch11: Drawing); every other
        // widget kind -- and window-ref/menu-item values -- has none, so it
        // falls through to the "undefined" default below, matching
        // expr.go's checkMethodCall switch exactly.
        if poolGet(typeNameIdx(xt)) == "canvas" {
            return checkTableMethod(canvasMethods, sel, argsHead)
        }
        emitDiag(exprLine(sel), exprCol(sel), "undefined: " + name)
        return InvalidT
    }
    }
    emitDiag(exprLine(sel), exprCol(sel), "undefined: " + name)
    return InvalidT
}

// checkFileCall dispatches `file.fn(args)` -- the `file` namespace has no
// value or type of its own (Ch12: Files); recognized syntactically by
// name, like the `window` keyword.
func checkFileCall(sel: int, argsHead: int): int {
    return checkTableMethod(fileFuncs, sel, argsHead)
}

// ================================================================
// resolveType (check.go)
// ================================================================

// resolveType maps a TypeExpr as written in source to a type-arena index,
// reporting "undefined: X" for an unresolvable name and returning
// InvalidT -- never re-diagnosed by a caller.
func resolveType(te: int): int {
    var nameIdx: int
    var symIdx: int
    var et: int

    switch typeExprKind(te) {
    case TxNamed {
        nameIdx = namedTypeName(te)
        if nameIdx == cnInt {
            return IntT
        }
        if nameIdx == cnBool {
            return BoolT
        }
        if nameIdx == cnFixed {
            return FixedT
        }
        if nameIdx == cnChar {
            return CharT
        }
        if nameIdx == cnText {
            return TextT
        }
        if nameIdx == cnPtr {
            return PtrT
        }
        symIdx = scopeLookup(curScope, nameIdx)
        if symIdx == -1 or not symbols[symIdx].isType {
            emitDiag(typeExprLine(te), typeExprCol(te), "undefined: " + poolGet(nameIdx))
            return InvalidT
        }
        return symbols[symIdx].typeIdx
    }
    case TxWord {
        // Task 4 (native-5e, Ch13): the checked type system treats `word`
        // exactly as `int` -- callers pass ordinary int exprs, a word
        // return reads as int, and checkExternFunc's int/ptr/bool/char
        // param and return-type checks pass unchanged. The distinct
        // 16-bit-at-the-trap-boundary marshaling lives entirely in
        // lowResolveType (lower.cla) -- which reads this same TxWord
        // TypeExpr node straight off the AST, independent of this checked
        // type -- and cg68k.cla's cgCallExtPascal.
        return IntT
    }
    case TxString {
        return strT(stringTypeN(te))
    }
    case TxList {
        et = resolveType(listTypeElem(te))
        if et != InvalidT and typeKind(et) == TyPtr {
            emitDiag(typeExprLine(te), typeExprCol(te), "ptr cannot be a container element")
            return listT(InvalidT)
        }
        if et != InvalidT and typeKind(et) == TyOverlay {
            emitDiag(typeExprLine(te), typeExprCol(te), "overlay records cannot be container elements")
            return listT(InvalidT)
        }
        if et != InvalidT and typeKind(et) == TyXRec {
            emitDiag(typeExprLine(te), typeExprCol(te), "extern records cannot be container elements")
            return listT(InvalidT)
        }
        return listT(et)
    }
    case TxMap {
        et = resolveType(mapTypeVal(te))
        if et != InvalidT and typeKind(et) == TyPtr {
            emitDiag(typeExprLine(te), typeExprCol(te), "ptr cannot be a container element")
            return mapT(InvalidT)
        }
        if et != InvalidT and typeKind(et) == TyOverlay {
            emitDiag(typeExprLine(te), typeExprCol(te), "overlay records cannot be container elements")
            return mapT(InvalidT)
        }
        if et != InvalidT and typeKind(et) == TyXRec {
            emitDiag(typeExprLine(te), typeExprCol(te), "extern records cannot be container elements")
            return mapT(InvalidT)
        }
        return mapT(et)
    }
    case TxSortedMap {
        usesSortedMap = true
        et = resolveType(sortedMapTypeVal(te))
        if et != InvalidT and typeKind(et) == TyPtr {
            emitDiag(typeExprLine(te), typeExprCol(te), "ptr cannot be a container element")
            return sortedMapT(InvalidT)
        }
        if et != InvalidT and typeKind(et) == TyOverlay {
            emitDiag(typeExprLine(te), typeExprCol(te), "overlay records cannot be container elements")
            return sortedMapT(InvalidT)
        }
        if et != InvalidT and typeKind(et) == TyXRec {
            emitDiag(typeExprLine(te), typeExprCol(te), "extern records cannot be container elements")
            return sortedMapT(InvalidT)
        }
        return sortedMapT(et)
    }
    case TxIntMap {
        // map-hashtable phase Task 7: intmap lives in the always-spliced
        // map.cla (unlike sortedmap.cla, which is conditionally spliced),
        // so no usesIntMap flag is needed here -- drive.cla sets
        // cpIntMapPorted unconditionally, mirroring cpMapPorted.
        et = resolveType(intMapTypeVal(te))
        if et != InvalidT and typeKind(et) == TyPtr {
            emitDiag(typeExprLine(te), typeExprCol(te), "ptr cannot be a container element")
            return intMapT(InvalidT)
        }
        if et != InvalidT and typeKind(et) == TyOverlay {
            emitDiag(typeExprLine(te), typeExprCol(te), "overlay records cannot be container elements")
            return intMapT(InvalidT)
        }
        if et != InvalidT and typeKind(et) == TyXRec {
            emitDiag(typeExprLine(te), typeExprCol(te), "extern records cannot be container elements")
            return intMapT(InvalidT)
        }
        return intMapT(et)
    }
    case TxArray {
        et = resolveType(arrayTypeElem(te))
        if et != InvalidT and typeKind(et) == TyPtr {
            emitDiag(typeExprLine(te), typeExprCol(te), "ptr cannot be a container element")
            return arrT(InvalidT, arrayTypeN(te))
        }
        if et != InvalidT and typeKind(et) == TyOverlay {
            emitDiag(typeExprLine(te), typeExprCol(te), "overlay records cannot be container elements")
            return arrT(InvalidT, arrayTypeN(te))
        }
        if et != InvalidT and typeKind(et) == TyXRec {
            emitDiag(typeExprLine(te), typeExprCol(te), "extern records cannot be container elements")
            return arrT(InvalidT, arrayTypeN(te))
        }
        return arrT(et, arrayTypeN(te))
    }
    }
    return InvalidT
}

// ================================================================
// Top-level declaration checking (check.go)
// ================================================================

// checkRecordDecl builds a record's field layout (Ch3: Records and
// Defaults): field types are resolved first, then defaults are
// type-checked against them (an enum-typed field's bare-identifier
// default resolves against that field's own enum, via the expected-type
// parameter).
func checkRecordDecl(d: int) {
    var nameIdx: int
    var f: int
    var ft: int
    var fiHead: int
    var fiTail: int
    var fi: int
    var dt: int
    var t: int
    var sym: Symbol
    var isOverlay: bool
    var isXRec: bool
    var xr: XRecFieldCheck
    var totalSize: int
    var xrecKey: string
    var xrecMergeCandidate: int

    nameIdx = recordDeclName(d)
    isOverlay = recordDeclIsOverlay(d)
    isXRec = recordDeclIsXRec(d)
    fiHead = -1
    fiTail = -1
    totalSize = 0
    xrecKey = ""
    xrecMergeCandidate = -1
    if isXRec {
        // Task 4 dedup (mirrors Task 3's extern-func merge, per the spec's
        // "same rule covers duplicate extern record declarations" --
        // field-for-field: names, types, order, UNLIKE extern func's
        // param-name exemption): looked up now, but not acted on until the
        // field walk below has fully resolved/validated THIS decl's own
        // fields (same "resolve d's own signature regardless" order Task
        // 3's checkFuncSig/checkExternFunc split uses).
        xrecKey = numToStr(progGen) + "|" + poolGet(nameIdx)
        xrecMergeCandidate = xrecFirstDeclByName.get(xrecKey, -1)
    }
    f = recordDeclFieldsHead(d)
    while f != -1 {
        if isXRec {
            // Task 4 (toolbox-integration Feature B): field types + the
            // running packed-size total both come from checkXRecFieldType,
            // never resolveType -- byte/word/pad/str[N] are not ordinary
            // checked types, and pad fields (fieldName(f) == -1, see
            // parseXRecFieldDecl) contribute to the size total but get no
            // FieldInfo entry (unnamed, never selectable via `ev.field`).
            xr = checkXRecFieldType(fieldType(f))
            if not xr.ok {
                if xr.badStrLen {
                    emitDiag(declLine(f), declCol(f), "str field length must be 1..255")
                } else if xr.badPadLen {
                    emitDiag(declLine(f), declCol(f), "pad length must be at least 1")
                } else {
                    emitDiag(declLine(f), declCol(f), "extern record field type must be bool, byte, word, int, ptr, str[N], pad[N], or an extern record")
                }
            } else {
                // Classic MPW 68k packing: a 2-aligned field needs one pad
                // byte first if the running offset is currently odd (a
                // 1-aligned field never does) -- see ir.cla's
                // irXRecFieldOffset/irXRecSize for the identical algorithm
                // and its worked EventRecord/SFReply sanity check.
                if xr.align == 2 and totalSize mod 2 != 0 {
                    totalSize = totalSize + 1
                }
                totalSize = totalSize + xr.size
                if fieldName(f) != -1 {
                    fi = newFieldInfo(fieldName(f), xr.readType)
                    if fiHead == -1 {
                        fiHead = fi
                    }
                    fiTail = fieldInfoAppend(fiTail, fi)
                }
            }
        } else {
            ft = resolveType(fieldType(f))
            if isOverlay {
                if ft != InvalidT and typeKind(ft) != TyInt and typeKind(ft) != TyBool and typeKind(ft) != TyChar and typeKind(ft) != TyFixed and typeKind(ft) != TyPtr {
                    emitDiag(declLine(f), declCol(f), "overlay fields must be int, bool, char, fixed, or ptr")
                    ft = InvalidT
                }
            } else if ft != InvalidT and typeKind(ft) == TyOverlay {
                emitDiag(declLine(f), declCol(f), "overlay records cannot be record fields")
                ft = InvalidT
            } else if ft != InvalidT and typeKind(ft) == TyXRec {
                emitDiag(declLine(f), declCol(f), "extern records cannot be record fields")
                ft = InvalidT
            }
            fi = newFieldInfo(fieldName(f), ft)
            if fiHead == -1 {
                fiHead = fi
            }
            fiTail = fieldInfoAppend(fiTail, fi)
        }
        f = declNext(f)
    }

    if isXRec and xrecMergeCandidate != -1 {
        // A second-plus `extern record NAME`: the FIRST decl's
        // setRecordFields/xrecSizeByName/scope symbol stay authoritative
        // (this decl gets no scope entry of its own, same "first
        // registration wins" shape Task 3's checkFuncSig uses) -- the only
        // remaining question is whether d's own (already fully validated,
        // above) field list matches the first decl's field-for-field.
        if not xrecFieldsMatch(xrecMergeCandidate, d) {
            emitConflictingExtern(xrecMergeCandidate, d)
        }
        return
    }

    setRecordFields(nameIdx, fiHead)

    if not isXRec {
        f = recordDeclFieldsHead(d)
        fi = fiHead
        while f != -1 {
            if fieldDefault(f) != -1 {
                if isOverlay {
                    emitDiag(declLine(f), declCol(f), "overlay fields cannot have defaults")
                } else {
                    dt = checkExpr(fieldDefault(f), fieldInfos[fi].typeIdx)
                    if dt != InvalidT and not compatible(dt, fieldInfos[fi].typeIdx) {
                        emitDiag(declLine(f), declCol(f), "cannot assign " + typeName(dt) + " to field " + poolGet(fieldName(f)) + " of type " + typeName(fieldInfos[fi].typeIdx))
                    }
                }
            }
            f = declNext(f)
            fi = fieldInfos[fi].next
        }
    }

    if isOverlay {
        t = overlayT(nameIdx)
    } else if isXRec {
        t = xrecT(nameIdx)
        // Ch13's packing table: total record size rounds up to even.
        if totalSize mod 2 != 0 {
            totalSize = totalSize + 1
        }
        xrecSizeByName[poolGet(nameIdx)] = totalSize
        xrecFirstDeclByName[xrecKey] = d
    } else {
        t = recT(nameIdx)
    }
    sym.nameIdx = nameIdx
    sym.typeIdx = t
    sym.isFunc = false
    sym.sigIdx = -1
    sym.isType = true
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    if not scopeDeclare(curScope, sym) {
        emitDiag(declLine(d), declCol(d), "redeclaration of " + poolGet(nameIdx))
    }
}

// checkEnumDecl builds an enum's member layout (Ch3: Enums): members
// auto-number from 0 or the previous value + 1; explicit values must fit
// 0-65535 and be unique within the enum; member names must be unique
// (checked via a throwaway scope, reusing scopeDeclare's own
// "redeclaration of X" wording).
func checkEnumDecl(d: int) {
    var nameIdx: int
    var namesScope: int
    var m: int
    var val: int
    var next: int
    var head: int
    var count: int
    var label: int
    var t: int
    var sym: Symbol
    var msym: Symbol
    var seen: map of int

    nameIdx = enumDeclName(d)
    namesScope = scopeNew(-1)
    head = enumMembers.count
    next = 0
    count = 0
    m = enumDeclMembersHead(d)
    while m != -1 {
        if enumMemberHasValue(m) {
            val = enumMemberValue(m)
            if val < 0 or val > 65535 {
                emitDiag(declLine(m), declCol(m), "enum value out of range: " + numToStr(val))
            }
        } else {
            val = next
        }
        if seen.has(numToStr(val)) {
            emitDiag(declLine(m), declCol(m), "duplicate enum value " + numToStr(val))
        }
        seen[numToStr(val)] = 1

        msym.nameIdx = enumMemberName(m)
        msym.typeIdx = -1
        msym.isFunc = false
        msym.sigIdx = -1
        msym.isType = false
        msym.isConst = false
        msym.constIsStr = false
        msym.constInt = 0
        msym.constStrIdx = -1
        msym.isMenu = false
        if not scopeDeclare(namesScope, msym) {
            emitDiag(declLine(m), declCol(m), "redeclaration of " + poolGet(enumMemberName(m)))
        }

        label = enumMemberLabel(m)
        if label == -1 {
            label = enumMemberName(m)
        }
        addEnumMember(poolGet(enumMemberName(m)), val, poolGet(label))
        count = count + 1
        next = val + 1
        m = declNext(m)
    }

    t = enumT(nameIdx, head, count)
    sym.nameIdx = nameIdx
    sym.typeIdx = t
    sym.isFunc = false
    sym.sigIdx = -1
    sym.isType = true
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    if not scopeDeclare(curScope, sym) {
        emitDiag(declLine(d), declCol(d), "redeclaration of " + poolGet(nameIdx))
    }
}

// checkVarDecl checks a `var` declaration -- global or local; both shapes
// (a top-level decl, and a Block's own vars) are the same DkVar node, and
// both declare into whatever curScope currently is.
func checkVarDecl(d: int) {
    var t: int
    var it: int
    var sym: Symbol

    t = resolveType(varDeclType(d))
    if varDeclInit(d) != -1 {
        it = checkExpr(varDeclInit(d), t)
        // Task 4 (toolbox-integration Feature B): a `var` declaration's
        // initializer is a store too -- same whole-record ban and same
        // both-directions rule as checkAssignStmt's own (an xrec-typed
        // declared type OR an xrec-typed init expression).
        if it != InvalidT and (typeKind(t) == TyXRec or typeKind(it) == TyXRec) {
            emitDiag(declLine(d), declCol(d), "extern records cannot be assigned")
        } else if it != InvalidT and not compatible(it, t) {
            emitDiag(declLine(d), declCol(d), "cannot assign " + typeName(it) + " to " + typeName(t))
        }
    }
    sym.nameIdx = varDeclName(d)
    sym.typeIdx = t
    sym.isFunc = false
    sym.sigIdx = -1
    sym.isType = false
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    if not scopeDeclare(curScope, sym) {
        emitDiag(declLine(d), declCol(d), "redeclaration of " + poolGet(sym.nameIdx))
    }
}

// literalConstVal extracts a CVal from one of the five literal ExprKinds a
// ConstDecl's value can be (the parser only ever hands it a literal or an
// Ident -- see constValue).
func literalConstVal(e: int): CVal {
    switch exprKind(e) {
    case ExIntLit {
        return cvInt(intLitVal(e))
    }
    case ExFixedLit {
        return cvInt(fixedLitRaw(e))
    }
    case ExCharLit {
        return cvInt(charLitVal(e))
    }
    case ExStringLit {
        return cvStr(poolGet(stringLitIdx(e)))
    }
    case ExBoolLit {
        if boolLitVal(e) {
            return cvInt(1)
        }
        return cvZero()
    }
    }
    return cvZero()
}

// constValue type-checks a const initializer against its declared type t
// and returns its compile-time value -- a byte-exact port of check.go's
// constValue.
func constValue(val: int, t: int): CVal {
    var vt: int
    var symIdx: int
    var cv: CVal

    vt = checkExpr(val, t)
    if vt == InvalidT {
        return cvZero()
    }
    if exprKind(val) == ExIdent {
        symIdx = scopeLookup(curScope, identName(val))
        if symIdx != -1 {
            if not symbols[symIdx].isConst {
                emitDiag(exprLine(val), exprCol(val), "constant initializer must be a literal, enum member, or constant")
                return cvZero()
            }
            if not compatible(symbols[symIdx].typeIdx, t) {
                emitDiag(exprLine(val), exprCol(val), "cannot assign " + typeName(symbols[symIdx].typeIdx) + " to " + typeName(t))
            }
            cv.isStr = symbols[symIdx].constIsStr
            cv.intVal = symbols[symIdx].constInt
            cv.strIdx = symbols[symIdx].constStrIdx
            return cv
        }
        return cvInt(enumConstGet(val))
    }
    if not compatible(vt, t) {
        emitDiag(exprLine(val), exprCol(val), "cannot assign " + typeName(vt) + " to " + typeName(t))
    }
    return literalConstVal(val)
}

// checkConstDecl checks a `const` declaration (Ch3: Constants): the type
// is restricted to those representable at compile time, and the
// initializer must be a literal, an enum member, or a previously declared
// constant.
func checkConstDecl(d: int) {
    var t: int
    var k: TypeKind
    var cv: CVal
    var sym: Symbol

    t = resolveType(constDeclType(d))
    k = typeKind(t)
    if k != TyInt and k != TyFixed and k != TyChar and k != TyBool and k != TyEnum and k != TyStr {
        emitDiag(declLine(d), declCol(d), "const type must be int, fixed, char, bool, enum, or string")
        return
    }
    cv = constValue(constDeclValue(d), t)
    sym.nameIdx = constDeclName(d)
    sym.typeIdx = t
    sym.isFunc = false
    sym.sigIdx = -1
    sym.isType = false
    sym.isConst = true
    sym.constIsStr = cv.isStr
    sym.constInt = cv.intVal
    sym.constStrIdx = cv.strIdx
    sym.isMenu = false
    if not scopeDeclare(curScope, sym) {
        emitDiag(declLine(d), declCol(d), "redeclaration of " + poolGet(sym.nameIdx))
    }
}

// checkFuncSig resolves and declares a function's signature (name +
// param/return types, against the scope built so far -- a signature
// naming a type declared later still errors, since only function BODIES
// get forward visibility, not signatures) and stashes its param scope
// (chained under curScope) and resolved return type into
// funcScopeByDecl/funcRetByDecl, keyed by d's own decl index, for
// checkFuncBody to consume in phase 2.
func checkFuncSig(d: int) {
    var params: list of int
    var p: int
    var pt: int
    var ret: int
    var sigIdx: int
    var sym: Symbol
    var fnScope: int
    var psym: Symbol
    var key: int
    var i: int
    var externKey: string

    p = funcDeclParamsHead(d)
    while p != -1 {
        pt = resolveType(paramType(p))
        // Task 4 (toolbox-integration Feature B): "extern records cannot
        // be function parameters or results" -- ordinary funcs only.
        // checkExternFunc (below, always called right after this for a
        // DkExternFunc decl) already rejects an xrec param/return with its
        // own generic "external parameters/functions may only use ..."
        // message; gating on declKind here avoids double-diagnosing the
        // same extern decl with two different messages.
        if declKind(d) == DkFunc and pt != InvalidT and typeKind(pt) == TyXRec {
            emitDiag(declLine(p), declCol(p), "extern records cannot be function parameters or results")
        }
        params.add(pt)
        p = declNext(p)
    }
    if funcDeclRetType(d) != -1 {
        ret = resolveType(funcDeclRetType(d))
        if declKind(d) == DkFunc and ret != InvalidT and typeKind(ret) == TyXRec {
            emitDiag(declLine(d), declCol(d), "extern records cannot be function parameters or results")
        }
    } else {
        ret = -1
    }
    sigIdx = newFuncSig(params, ret)
    key = d
    funcSigByDecl[key] = sigIdx
    sym.nameIdx = funcDeclName(d)
    sym.typeIdx = -1
    sym.isFunc = true
    sym.sigIdx = sigIdx
    sym.isType = false
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    // Task 4 (toolbox-integration Feature B): checkArgsCall's xrec
    // decay/coercion rules read this back to tell an extern call site from
    // an ordinary one.
    sym.isExtern = declKind(d) == DkExternFunc
    // Task 7 (toolbox-integration Feature C): checkIdent reads this back
    // to tell a `callback func` name from an ordinary function name.
    sym.isCallback = declKind(d) == DkCallbackFunc
    if declKind(d) == DkExternFunc {
        // Task 3 (Ch13 dedup): a second `external func` sharing a name
        // already registered by an EARLIER extern decl THIS checkProgram
        // call doesn't get its own scope entry at all -- call sites keep
        // resolving through the first decl's symbol ("first registration
        // wins", Task 1's re-review forward note). Whether that's actually
        // legal (identical clause) or a real conflict is decided in
        // checkExternFunc, once ITS OWN trap/conv/reg-bind resolution
        // (which runs after this call returns) has completed -- see
        // externMergeCandidate's own comment above.
        externKey = poolGet(sym.nameIdx)
        externMergeCandidate = externFirstDeclByName.get(externKey, -1)
        if externMergeCandidate == -1 {
            externFirstDeclByName[externKey] = d
            if not scopeDeclare(curScope, sym) {
                emitDiag(declLine(d), declCol(d), "redeclaration of " + poolGet(sym.nameIdx))
            }
        }
    } else {
        if not scopeDeclare(curScope, sym) {
            emitDiag(declLine(d), declCol(d), "redeclaration of " + poolGet(sym.nameIdx))
        }
    }

    fnScope = scopeNew(curScope)
    p = funcDeclParamsHead(d)
    i = 0
    while p != -1 {
        psym.nameIdx = paramName(p)
        psym.typeIdx = params[i]
        psym.isFunc = false
        psym.sigIdx = -1
        psym.isType = false
        psym.isConst = false
        psym.constIsStr = false
        psym.constInt = 0
        psym.constStrIdx = -1
        psym.isMenu = false
        if not scopeDeclare(fnScope, psym) {
            emitDiag(declLine(p), declCol(p), "redeclaration of " + poolGet(psym.nameIdx))
        }
        p = declNext(p)
        i = i + 1
    }

    funcScopeByDecl[key] = fnScope
    funcRetByDecl[key] = ret
}

// checkExternFunc checks a DkExternFunc decl (Task 3, Ch13: `external
// func`): checkFuncSig works unchanged (same a/b slot layout as DkFunc) and
// resolves param/return types once, into the FuncSig it stashes on the
// symbol it declares -- checkExternFunc reads types back from that FuncSig
// (funcSigParam/funcSigRet) rather than re-resolving each TypeExpr, so an
// already-undefined type isn't diagnosed a second time here. Every return
// type is restricted to int, ptr, bool, or char -- the waist types peek/
// poke and the host runtime can pass across the C ABI (Chapter 13). Params
// additionally allow str and text (Plan 5b Task 3: str marshals to a
// `const uint8_t *` argument, text to a borrowed `rt_text *`) -- split into
// its own diagnostic since the allowed set now differs from the return's.
// An absent return type (a procedure) is fine; nothing checks a body,
// since an external has none (phase 2 filters on DkFunc).
//
// Task 2 (native-5d) adds the optional trap/inline clause's own checks,
// gated on externFuncConv(d) (parse.cla's convFlag): a trap word (pascal
// or reg, conv 1/2) must land in the real Toolbox A-line trap range
// 0xA000..0xAFFF; a reg trap (conv 2) additionally restricts params to at
// most two ptr (A0/A1) and at most two int/bool/char (D0/D1) -- reusing
// the ptrCount/scalarCount/regBad tally the param loop below already
// builds, so str/text (neither of which has a register slot) trips regBad
// the same way a 3rd ptr or scalar trips the count. inline deref (conv 3)
// requires the signature to be exactly one ptr param returning ptr;
// inline nop (conv 4) requires no return type; inline a5 (conv 5, Task 12,
// native-5e: `MOVE.L A5,D0`, the running program's own A5 world base)
// requires zero params and a ptr return; reg memerr (conv 6, Task 14,
// native-5e: a `void`-Pascal-signature Toolbox routine like SetHandleSize,
// whose real result comes back via the MemErr low-memory global rather
// than D0 -- cgCallExtRegMemErr's own doc comment, cg68k.cla) shares the
// same reg-convention arg restrictions conv 2 does. Every trap/inline
// check runs after, and independently of, the ordinary param/return type
// checks above -- a param already flagged for its type is not re-flagged
// here.
func checkExternFunc(d: int) {
    var sigIdx: int
    var p: int
    var i: int
    var k: TypeKind
    var ret: int
    var conv: int
    var trapVal: int
    var ptrCount: int
    var scalarCount: int
    var regBad: bool
    var namedBindsBad: bool
    var regUsed: list of bool
    var bindCount: int
    var j: int
    var bindCode: int
    var bindNameIdx: int
    var foundP: int
    var unboundReported: bool
    var retRegCode: int
    var mergeCandidate: int

    checkFuncSig(d)
    // Task 3 (Ch13 dedup): mergeCandidate captures checkFuncSig's verdict
    // right away (see externMergeCandidate's own comment, above
    // checkFuncSig) -- -1 for an ordinary first-seen extern, or the
    // earlier same-name decl's index for a possible merge. sigIdx comes
    // from funcSigByDecl, THIS decl's own resolved signature, rather than
    // scopeLookup -- a merge candidate's scopeDeclare was skipped, so
    // scopeLookup(curScope, funcDeclName(d)) would find the EARLIER
    // decl's symbol instead of d's own, and every check below (param
    // type legality, reg-trap counts, ...) needs to validate what d
    // itself actually declared.
    mergeCandidate = externMergeCandidate
    sigIdx = funcSigByDecl.get(d, -1)
    if sigIdx == -1 {
        return
    }
    p = funcDeclParamsHead(d)
    i = 0
    ptrCount = 0
    scalarCount = 0
    regBad = false
    while p != -1 {
        k = typeKind(funcSigParam(sigIdx, i))
        if k != TyInt and k != TyPtr and k != TyBool and k != TyChar and k != TyStr and k != TyText {
            emitDiag(declLine(p), declCol(p), "external parameters may only use int, ptr, bool, char, str, or text")
        }
        if k == TyPtr {
            ptrCount = ptrCount + 1
        } else if k == TyInt or k == TyBool or k == TyChar {
            scalarCount = scalarCount + 1
        } else {
            regBad = true
        }
        p = declNext(p)
        i = i + 1
    }
    ret = funcSigRet(sigIdx)
    if ret != -1 {
        k = typeKind(ret)
        if k != TyInt and k != TyPtr and k != TyBool and k != TyChar {
            emitDiag(declLine(d), declCol(d), "external functions may only use int, ptr, bool, or char")
        }
    }

    conv = externFuncConv(d)
    trapVal = externFuncTrap(d)
    if conv == 1 or conv == 2 or conv == 6 or conv == 7 or conv == 8 or conv == 9 {
        if trapVal < 0xA000 or trapVal > 0xAFFF {
            emitDiag(declLine(d), declCol(d), "trap word must be in 0xA000..0xAFFF")
        }
    }
    if (conv == 2 or conv == 6) and (regBad or ptrCount > 2 or scalarCount > 2) {
        emitDiag(declLine(d), declCol(d), "reg traps allow at most 2 ptr and 2 int/bool/char parameters")
    } else if (conv == 7 or conv == 8) and regBad {
        // Task 1 (toolbox-integration Feature A): a named reg(...) clause
        // has NO count limit (unlike positional reg's 2+2 above), but the
        // PARAM TYPE restriction is identical -- str/text still have no
        // register slot -- so this reuses positional reg's own diagnostic
        // wording rather than inventing a second message for the same
        // underlying rule.
        emitDiag(declLine(d), declCol(d), "reg traps allow at most 2 ptr and 2 int/bool/char parameters")
    }
    if conv == 3 and (i != 1 or ptrCount != 1 or ret == -1 or typeKind(ret) != TyPtr) {
        emitDiag(declLine(d), declCol(d), "inline deref requires signature (ptr): ptr")
    }
    if conv == 4 and ret != -1 {
        emitDiag(declLine(d), declCol(d), "inline nop requires a void return")
    }
    if conv == 5 and (i != 0 or ret == -1 or typeKind(ret) != TyPtr) {
        emitDiag(declLine(d), declCol(d), "inline a5 requires signature (): ptr")
    }

    // Task 1 (toolbox-integration Feature A): a named reg(...) clause's
    // bind list -- resolve each raw (register code, raw param-name pool
    // idx) pair (ast.cla's astExternRegBindRaw*, parsed but not resolved
    // by parse.cla, see its own doc comment) against d's OWN declared
    // params, tracking register reuse; on success write the resolved code
    // onto that param (setParamRegBind), the paramRegBind/astExternRegBind
    // story Task 2's codegen reads. Stops re-diagnosing (namedBindsBad)
    // after the first bad bind so a single malformed clause produces
    // exactly one diagnostic, matching every other rule in this function.
    if conv == 7 or conv == 8 {
        j = 0
        while j < 10 {
            regUsed.add(false)
            j = j + 1
        }
        // Reset every param's paramRegBind before resolving: main.cla's
        // emit pipeline runs checkProgram TWICE over the same decls (once
        // pre-runtime-splice, once post-splice, before lowering), so
        // checkExternFunc runs twice per extern -- without this reset the
        // second pass finds its own first pass's setParamRegBind side
        // effect still in place and misreports "bound twice" on a
        // perfectly valid clause. check_test.cla's runCase only ever
        // calls checkProgram once, so this never surfaced there.
        p = funcDeclParamsHead(d)
        while p != -1 {
            setParamRegBind(p, -1)
            p = declNext(p)
        }
        namedBindsBad = false
        bindCount = astExternRegBindRawCount(d)
        j = 0
        while j < bindCount {
            if not namedBindsBad {
                bindCode = astExternRegBindRawCode(d, j)
                bindNameIdx = astExternRegBindRawName(d, j)
                p = funcDeclParamsHead(d)
                foundP = -1
                while p != -1 {
                    if paramName(p) == bindNameIdx {
                        foundP = p
                    }
                    p = declNext(p)
                }
                if foundP == -1 {
                    emitDiag(declLine(d), declCol(d), "reg binding names unknown parameter '" + poolGet(bindNameIdx) + "'")
                    namedBindsBad = true
                } else if bindCode < 0 or bindCode >= 10 {
                    // Defensive only: parseRegName rejects any register
                    // spelling outside the closed set at parse time, so a
                    // successfully-parsed program never reaches here with
                    // an out-of-range code. Guards main.cla's pipeline,
                    // which runs checkProgram even after a parse error
                    // (unlike check_test.cla's runCase) -- against
                    // indexing regUsed with garbage left behind by an
                    // aborted parseRegBind.
                    namedBindsBad = true
                } else if paramRegBind(foundP) != -1 {
                    // Task review fix: the SAME parameter named twice
                    // (possibly with two DIFFERENT registers, which
                    // regUsed alone wouldn't catch -- reg(d0: a, d1: a)
                    // was silently landing a's binding on whichever bind
                    // parsed last). "Every declared parameter is bound
                    // exactly once" per the spec.
                    emitDiag(declLine(d), declCol(d), "parameter '" + poolGet(bindNameIdx) + "' bound twice")
                    namedBindsBad = true
                } else if regUsed[bindCode] {
                    emitDiag(declLine(d), declCol(d), "register " + regNameForCode(bindCode) + " bound twice")
                    namedBindsBad = true
                } else {
                    regUsed[bindCode] = true
                    setParamRegBind(foundP, bindCode)
                }
            }
            j = j + 1
        }
        if not namedBindsBad {
            p = funcDeclParamsHead(d)
            unboundReported = false
            while p != -1 {
                if paramRegBind(p) == -1 and not unboundReported {
                    emitDiag(declLine(p), declCol(p), "parameter '" + poolGet(paramName(p)) + "' has no register binding")
                    unboundReported = true
                }
                p = declNext(p)
            }
        }
    }

    // Task 1: the `ret REG` clause's rules apply to EITHER form of reg
    // (bare or named) alike, per the regClause grammar -- independent of
    // the conv-7/8-only block above.
    retRegCode = astExternRetReg(d)
    // Task review fix: a void extern with BOTH `memerr` and `ret` used to
    // trip this rule AND the mutual-exclusion one below -- two
    // diagnostics for one malformed clause, unlike every other rule in
    // this function. Gate this one on the memerr+ret conflict NOT also
    // applying; the mutual-exclusion message below already covers that
    // combination on its own.
    if retRegCode != -1 and ret == -1 and not (conv == 6 or conv == 8) {
        emitDiag(declLine(d), declCol(d), "ret clause requires a return type")
    }
    if (conv == 6 or conv == 8) and retRegCode != -1 {
        emitDiag(declLine(d), declCol(d), "memerr and ret are mutually exclusive")
    }

    // Task 3 (Ch13 dedup) tail: d's own clause is now fully resolved
    // (trap/conv/sel above, every param's paramRegBind and d's own `ret`
    // register just above) -- if checkFuncSig flagged d as sharing a name
    // with an earlier extern THIS program, decide merge vs. conflict now,
    // the one point where both decls' full clauses are available.
    if mergeCandidate != -1 {
        if not externClauseMatches(mergeCandidate, d) {
            emitConflictingExtern(mergeCandidate, d)
        }
    }
}

// checkCallbackFunc checks a DkCallbackFunc decl (Task 7, toolbox-
// integration Feature C: `callback func`). checkFuncSig works unchanged
// (same a/b/c slot layout as DkFunc -- including a real body, checked in
// phase 2 by checkFuncBody like any DkFunc, since checkProgram's own
// phase-2 dispatch treats the two kinds alike); this function adds the
// ONE extra rule DkFunc doesn't need: every parameter and the return type
// is restricted to bool/char/word/int/ptr -- what the compiler's
// generated pascal glue (cprint.cla's clar_cb_<name> wrapper) can marshal
// across the Toolbox boundary (Ch13's callback-func section, the same
// high-byte marshaling paragraph `external func` already documents).
// `word` folds to plain int in the checked type system exactly like an
// extern func's `word` does (TxWord's own doc comment, types.cla) -- the
// checker cannot and need not tell a `word` param from a plain `int` one,
// so the `k != TyInt` check below already covers word for free. No
// dedup/merge logic is needed here (unlike checkExternFunc) -- checkFuncSig's
// own dispatch already routes anything that isn't DkExternFunc through the
// ordinary scopeDeclare-or-redeclaration-error path, and a callback (which
// HAS a body) is never eligible for the identical-signature merge Task 3's
// dedup rule reserves for signature-only externs -- so two `callback func`
// decls sharing a name, or a callback colliding with an existing extern
// func's name (or vice versa), always redeclaration-errors for free.
func checkCallbackFunc(d: int) {
    var sigIdx: int
    var p: int
    var i: int
    var k: TypeKind
    var ret: int

    checkFuncSig(d)
    sigIdx = funcSigByDecl.get(d, -1)
    if sigIdx == -1 {
        return
    }
    p = funcDeclParamsHead(d)
    i = 0
    while p != -1 {
        k = typeKind(funcSigParam(sigIdx, i))
        if k != TyInt and k != TyPtr and k != TyBool and k != TyChar {
            emitDiag(declLine(p), declCol(p), "callback parameter and return types must be bool, char, word, int, or ptr")
        }
        p = declNext(p)
        i = i + 1
    }
    ret = funcSigRet(sigIdx)
    if ret != -1 {
        k = typeKind(ret)
        if k != TyInt and k != TyPtr and k != TyBool and k != TyChar {
            emitDiag(declLine(d), declCol(d), "callback parameter and return types must be bool, char, word, int, or ptr")
        }
    }
}

// externClauseMatches reports whether extern decls a and b (Task 3, Ch13
// dedup) declare byte-for-byte identical signatures: param types in
// order (names exempt), return type, and the entire trap/inline clause --
// conv, trap word, sel, every param's register binding, and the ret
// register. Both decls must already be fully checked (checkFuncSig +
// checkExternFunc's own clause resolution complete for each) before this
// runs -- checkExternFunc's own tail is the only caller, once b's (the
// later decl's) own resolution has just finished.
//
// Param comparison uses typesEqual, not raw arena-index ==: strT(n)
// (types.cla) allocates a fresh arena entry per resolveType call, so two
// byte-identical `str` params would spuriously conflict under == despite
// being the same type (typesEqual's own doc comment names this exact
// case). Return-type comparison stays raw == on purpose -- checkExternFunc
// restricts extern returns to int/ptr/bool/char (never str/text, the only
// kind with per-call fresh arena entries), and those four are
// module-level singletons (IntT/PtrT/BoolT/CharT), so == is exact there;
// typesEqual would also need to special-case funcSigRet's -1 (void)
// sentinel, which is not a valid type-arena index.
func externClauseMatches(a: int, b: int): bool {
    var sigA: int
    var sigB: int
    var pa: int
    var pb: int
    var i: int
    var n: int

    sigA = funcSigByDecl.get(a, -1)
    sigB = funcSigByDecl.get(b, -1)
    if sigA == -1 or sigB == -1 {
        return false
    }
    n = funcSigParamCount(sigA)
    if n != funcSigParamCount(sigB) {
        return false
    }
    if funcSigRet(sigA) != funcSigRet(sigB) {
        return false
    }
    if externFuncConv(a) != externFuncConv(b) {
        return false
    }
    if externFuncTrap(a) != externFuncTrap(b) {
        return false
    }
    if externFuncSel(a) != externFuncSel(b) {
        return false
    }
    if astExternRetReg(a) != astExternRetReg(b) {
        return false
    }
    pa = funcDeclParamsHead(a)
    pb = funcDeclParamsHead(b)
    i = 0
    while i < n {
        if not typesEqual(funcSigParam(sigA, i), funcSigParam(sigB, i)) {
            return false
        }
        if paramRegBind(pa) != paramRegBind(pb) {
            return false
        }
        pa = declNext(pa)
        pb = declNext(pb)
        i = i + 1
    }
    return true
}

// emitConflictingExtern (Task 3, Ch13 dedup) diagnoses two extern decls
// sharing a name whose clauses do NOT match: one diagnostic at each
// site, each citing the OTHER's line:col -- lib.cla's Diag carries a
// single position, so "both source positions" (the brief's own wording)
// means two diagnostics here, not one.
func emitConflictingExtern(a: int, b: int) {
    var nameStr: string

    nameStr = poolGet(funcDeclName(a))
    emitDiag(declLine(a), declCol(a), "conflicting extern declaration for '" + nameStr + "' (also declared at " + numToStr(declLine(b)) + ":" + numToStr(declCol(b)) + ")")
    emitDiag(declLine(b), declCol(b), "conflicting extern declaration for '" + nameStr + "' (also declared at " + numToStr(declLine(a)) + ":" + numToStr(declCol(a)) + ")")
}

// checkFuncBody checks a function's body against the fnScope/ret
// checkFuncSig stashed for it -- split from checkFuncSig so checkProgram
// can resolve every top-level signature (phase 1) before checking any
// body (phase 2), making forward/mutual calls resolve (Ch6: Recursion).
func checkFuncBody(d: int) {
    var savedScope: int
    var savedRet: int
    var key: int

    key = d
    savedScope = curScope
    savedRet = curFuncRet
    curScope = funcScopeByDecl.get(key, -1)
    curFuncRet = funcRetByDecl.get(key, -1)
    checkBlock(funcDeclBody(d))
    curScope = savedScope
    curFuncRet = savedRet
}

// ================================================================
// Window/widget/menu declaration checking (ui.go)
// ================================================================

// formForFieldIsByValue reports whether t is safe as a form-bound record
// field: Ch10's `form for T` requires every field of T be a by-value type
// (docs/clarus-language-reference.md ~line 1008, same restriction as
// file.save/file.load) -- the form buffer an `edit` statement copies
// into/out of is a flat byte copy, so a handle-backed field (text/list/
// map, or a nested record/array containing one) would alias instead of
// copy. Recurses into TyArr (element) and TyRec (fields, via
// recordFieldsHead) to catch a nested handle anywhere in the type;
// everything else (int/bool/fixed/char/enum/str) is by-value.
func formForFieldIsByValue(t: int): bool {
    var fh: int

    if typeKind(t) == TyText or typeKind(t) == TyList or typeKind(t) == TyMap or typeKind(t) == TySortedMap or typeKind(t) == TyIntMap {
        return false
    }
    if typeKind(t) == TyArr {
        return formForFieldIsByValue(typeElem(t))
    }
    if typeKind(t) == TyRec {
        fh = recordFieldsHead(typeNameIdx(t))
        while fh != -1 {
            if not formForFieldIsByValue(fieldInfos[fh].typeIdx) {
                return false
            }
            fh = fieldInfos[fh].next
        }
        return true
    }
    return true
}

// checkWindowDecl builds a window's side-table layout (form-ness, form
// record, per-instance vars, widgets -- Ch8/Ch10) and declares the window's
// name as a WindowRef-typed symbol. Runs in phase 1 (source order), so
// forward references from later decls resolve, exactly as Go's single-pass
// checkDecl does for a window.
func checkWindowDecl(d: int) {
    var winNameIdx: int
    var winName: string
    var isForm: bool
    var formRecType: int
    var item: int
    var recNameIdx: int
    var symIdx: int
    var declared: map of int
    var k: DeclKind
    var vname: string
    var wname: string
    var fi: int
    var varsHead: int
    var varsTail: int
    var wi: int
    var widgetsHead: int
    var widgetsTail: int
    var sym: Symbol

    winNameIdx = windowDeclName(d)
    winName = poolGet(winNameIdx)
    isForm = false
    formRecType = -1

    // First pass: resolve `form for` before widgets, since binds validation
    // needs the form record regardless of where in the body it appears.
    item = windowDeclItemsHead(d)
    while item != -1 {
        if declKind(item) == DkFormFor {
            recNameIdx = formForRecord(item)
            symIdx = scopeLookup(curScope, recNameIdx)
            if symIdx == -1 or not symbols[symIdx].isType or typeKind(symbols[symIdx].typeIdx) != TyRec {
                emitDiag(declLine(item), declCol(item), "form for names an undefined record: " + poolGet(recNameIdx))
            } else {
                isForm = true
                formRecType = symbols[symIdx].typeIdx
                fi = recordFieldsHead(recNameIdx)
                while fi != -1 {
                    if not formForFieldIsByValue(fieldInfos[fi].typeIdx) {
                        emitDiag(declLine(item), declCol(item), "form for " + poolGet(recNameIdx) + ": field " + poolGet(fieldInfos[fi].nameIdx) + " must be a by-value type")
                    }
                    fi = fieldInfos[fi].next
                }
            }
        }
        item = declNext(item)
    }
    windowIsForm[winName] = boolToInt(isForm)
    windowFormRecType[winName] = formRecType

    declared["title"] = 1
    varsHead = -1
    varsTail = -1
    widgetsHead = -1
    widgetsTail = -1

    item = windowDeclItemsHead(d)
    while item != -1 {
        k = declKind(item)
        if k == DkProperty {
            if not windowTopProps.has(poolGet(propertyName(item))) {
                emitDiag(declLine(item), declCol(item), "unknown property " + poolGet(propertyName(item)) + " for window")
            }
        } else if k == DkColumn {
            emitDiag(declLine(item), declCol(item), "unknown property column for window")
        } else if k == DkVar {
            vname = poolGet(varDeclName(item))
            if declared.has(vname) {
                emitDiag(declLine(item), declCol(item), "redeclaration of " + vname)
            } else {
                declared[vname] = 1
            }
            fi = checkWindowVar(item)
            if varsHead == -1 {
                varsHead = fi
            }
            varsTail = fieldInfoAppend(varsTail, fi)
        } else if k == DkWidget {
            wname = poolGet(widgetName(item))
            if declared.has(wname) {
                emitDiag(declLine(item), declCol(item), "redeclaration of " + wname)
            } else {
                declared[wname] = 1
            }
            wi = checkWidget(item, formRecType)
            if widgetsHead == -1 {
                widgetsHead = wi
            }
            widgetsTail = widgetInfoAppend(widgetsTail, wi)
        }
        item = declNext(item)
    }
    windowVarsHead[winNameIdx] = varsHead
    windowWidgetsHead[winNameIdx] = widgetsHead

    sym.nameIdx = winNameIdx
    sym.typeIdx = windowRefT(winNameIdx)
    sym.isFunc = false
    sym.sigIdx = -1
    sym.isType = true
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    if not scopeDeclare(curScope, sym) {
        emitDiag(declLine(d), declCol(d), "redeclaration of " + poolGet(winNameIdx))
    }
}

// checkAppDecl checks the (at most one) `app` section -- a flat property
// list, so it shares unknown-property/redeclaration checking with
// checkWindowDecl's item loop but skips that function's items-list handling
// entirely (an app body is nothing but properties). Every declared property
// must be a bare string literal, EXCEPT `stack` (native-gaps-cleanup Task
// 4), the one int-literal carve-out -- checked first, before the
// string-literal rule, so every other property keeps that rule unchanged.
// `id`, `icon`, `doctype`, and `stack` get extra validation.
func checkAppDecl(d: int) {
    var item: int
    var pname: string
    var vh: int
    var declared: map of int
    var iconLine: int
    var iconCol: int
    var hasIcon: bool
    var hasId: bool
    var idVal: string
    var k: DeclKind

    if appDeclSeen {
        emitDiag(declLine(d), declCol(d), "duplicate app section")
        return
    }
    appDeclSeen = true
    hasIcon = false
    hasId = false
    item = appDeclPropsHead(d)
    while item != -1 {
        k = declKind(item)
        if k == DkColumn {
            emitDiag(declLine(item), declCol(item), "unknown property column for app")
        } else {
            pname = poolGet(propertyName(item))
            if not appProps.has(pname) {
                emitDiag(declLine(item), declCol(item), "unknown property " + pname + " for app")
            } else if declared.has(pname) {
                emitDiag(declLine(item), declCol(item), "redeclaration of " + pname)
            } else {
                declared[pname] = 1
                vh = propertyValuesHead(item)
                if pname == "stack" {
                    if vh == -1 or exprNext(vh) != -1 or exprKind(vh) != ExIntLit {
                        emitDiag(declLine(item), declCol(item), "app property stack requires an int literal")
                    } else {
                        checkAppStack(intLitVal(vh), declLine(item), declCol(item))
                    }
                } else if vh == -1 or exprNext(vh) != -1 or exprKind(vh) != ExStringLit {
                    emitDiag(declLine(item), declCol(item), "app property " + pname + " requires a string literal")
                } else {
                    if pname == "id" {
                        hasId = true
                        idVal = poolGet(stringLitIdx(vh))
                        checkAppId(idVal, declLine(item), declCol(item))
                    }
                    if pname == "icon" {
                        hasIcon = true
                        iconLine = declLine(item)
                        iconCol = declCol(item)
                    }
                    if pname == "doctype" {
                        checkAppDoctype(poolGet(stringLitIdx(vh)), declLine(item), declCol(item))
                    }
                }
            }
        }
        item = declNext(item)
    }
    if hasIcon and not hasId {
        emitDiag(iconLine, iconCol, "app icon requires an id property")
    }
}

// checkAppId validates an `id: "XXXX"` value: exactly 4 printable
// characters, not all lowercase (all-lowercase four-char codes are
// reserved by Apple for system use, Ch7 of the reference), and no quote
// characters (build-mac.sh interpolates the id raw into Rez and CMake
// source, so a quote-bearing id would pass this check and then break with
// a confusing syntax error at those later stages).
func checkAppId(v: string, line: int, col: int) {
    var i: int
    var allLower: bool

    if v.length != 4 {
        emitDiag(line, col, "app id must be exactly 4 printable characters")
        return
    }
    allLower = true
    i = 0
    while i < 4 {
        if v[i] < ' ' or v[i] > '~' {
            emitDiag(line, col, "app id must be exactly 4 printable characters")
            return
        }
        if v[i] == '"' or v[i] == '\'' {
            emitDiag(line, col, "app id must not contain quote characters")
            return
        }
        if v[i] < 'a' or v[i] > 'z' { allLower = false }
        i = i + 1
    }
    if allLower {
        emitDiag(line, col, "app id must not be all lowercase")
    }
}

// checkAppDoctype validates a `doctype: "XXXX"` value: 1 to 4 printable
// characters, and no quote characters (same build-mac.sh Rez/CMake
// interpolation hazard checkAppId's own comment describes). Deliberately
// has NO all-lowercase restriction -- unlike `id`, an all-lowercase
// four-char code reserved by Apple only applies to creator/application
// codes, not document types (native-gaps-cleanup Task 1 controller
// decision; do not copy checkAppId's allLower check here).
func checkAppDoctype(v: string, line: int, col: int) {
    var i: int

    if v.length < 1 or v.length > 4 {
        emitDiag(line, col, "app doctype must be 1 to 4 printable characters")
        return
    }
    i = 0
    while i < v.length {
        if v[i] < ' ' or v[i] > '~' {
            emitDiag(line, col, "app doctype must be 1 to 4 printable characters")
            return
        }
        if v[i] == '"' or v[i] == '\'' {
            emitDiag(line, col, "app doctype must not contain quote characters")
            return
        }
        i = i + 1
    }
}

// checkAppStack validates a `stack: N` value: 4096..1048576 bytes, the
// native (cg68k) startup's own SetApplLimit reserve (see cg68k.cla's
// cgStackHeuristic doc comment) -- native-lane semantics only, checked
// clean everywhere (the host/Mac cprint lanes never read irAppStack).
func checkAppStack(v: int, line: int, col: int) {
    if v < 4096 or v > 1048576 {
        emitDiag(line, col, "app stack must be between 4096 and 1048576")
    }
}

// checkWindowVar checks one per-instance `var` in a window body -- same
// shape as a top-level var, but recorded into the window's FieldInfo chain
// rather than the global scope. Returns its fieldInfos index.
func checkWindowVar(v: int): int {
    var t: int
    var it: int

    t = resolveType(varDeclType(v))
    if varDeclInit(v) != -1 {
        it = checkExpr(varDeclInit(v), t)
        // Task 4 review fix (Critical 1): same whole-assign ban
        // checkVarDecl's own top-level/local `var` path applies -- a
        // window's per-instance `var` is a separate DeclNode path
        // (checkWindowVar, not checkVarDecl), so it needed its own copy
        // of this guard; without it, `var ev: EventRecord = otherEv`
        // inside a window body silently passed compatible()'s new
        // same-name-xrec case.
        if it != InvalidT and (typeKind(t) == TyXRec or typeKind(it) == TyXRec) {
            emitDiag(declLine(v), declCol(v), "extern records cannot be assigned")
        } else if it != InvalidT and not compatible(it, t) {
            emitDiag(declLine(v), declCol(v), "cannot assign " + typeName(it) + " to " + typeName(t))
        }
    }
    return newFieldInfo(varDeclName(v), t)
}

// checkWidget validates one widget's properties against Ch8's per-kind
// property table and, for a table, its columns against Ch10's rules. Returns
// its widgetInfos index.
func checkWidget(w: int, formRecType: int): int {
    var kind: string
    var rowRecType: int
    var p: int
    var pname: string
    var binds: int

    kind = poolGet(widgetKindName(w))
    rowRecType = -1
    if kind == "table" {
        p = widgetPropsHead(w)
        while p != -1 {
            if declKind(p) == DkProperty and poolGet(propertyName(p)) == "rows" {
                rowRecType = checkRowsProperty(p)
            }
            p = declNext(p)
        }
    }

    binds = -1
    p = widgetPropsHead(w)
    while p != -1 {
        if declKind(p) == DkProperty {
            pname = poolGet(propertyName(p))
            if not widgetDeclProps.has(kind + "." + pname) {
                emitDiag(declLine(p), declCol(p), "unknown property " + pname + " for " + kind)
            } else if pname == "binds" {
                binds = checkBindsProperty(p, kind, formRecType)
            }
        } else if declKind(p) == DkColumn {
            if kind != "table" {
                emitDiag(declLine(p), declCol(p), "unknown property column for " + kind)
            } else {
                checkColumn(p, rowRecType)
            }
        }
        p = declNext(p)
    }
    return newWidgetInfo(widgetName(w), widgetKindName(w), binds)
}

// checkRowsProperty checks a table's `rows: expr` (Ch10) -- expr must be a
// `list of` record, whose record becomes the row type for `column ... shows`.
// Returns that record's type index, or -1.
func checkRowsProperty(p: int): int {
    var vh: int
    var t: int

    vh = propertyValuesHead(p)
    if exprListCount(vh) != 1 {
        emitDiag(declLine(p), declCol(p), "rows: takes one list expression")
        return -1
    }
    t = checkExpr(vh, -1)
    if t == InvalidT {
        return -1
    }
    if typeKind(t) != TyList or typeKind(typeElem(t)) != TyRec {
        emitDiag(declLine(p), declCol(p), "rows: must be a list of record")
        return -1
    }
    return typeElem(t)
}

// checkColumn checks `column "Header" shows field` (Ch10) -- field must be a
// field of the row record. rowRecType is -1 when `rows:` was missing or
// misdiagnosed; skip silently to avoid a cascading second error.
func checkColumn(col: int, rowRecType: int) {
    var want: int
    var fh: int

    if rowRecType == -1 {
        return
    }
    want = columnShows(col)
    fh = recordFieldsHead(typeNameIdx(rowRecType))
    while fh != -1 {
        if fieldInfos[fh].nameIdx == want {
            return
        }
        fh = fieldInfos[fh].next
    }
    emitDiag(declLine(col), declCol(col), "no field " + poolGet(want) + " on " + poolGet(typeNameIdx(rowRecType)))
}

// checkBindsProperty checks `binds: name` on a field/check/popup widget
// (Ch10) -- the value is a bare Ident naming a field of the window's form
// record, and that field's type must be widget-compatible. Returns the
// interned bound field name, or -1.
func checkBindsProperty(p: int, kind: string, formRecType: int): int {
    var vh: int
    var idName: string
    var want: int
    var recName: string
    var fieldType: int
    var found: bool
    var fh: int
    var fk: TypeKind
    var compat: bool

    vh = propertyValuesHead(p)
    if exprListCount(vh) != 1 {
        emitDiag(declLine(p), declCol(p), "binds: takes one field name")
        return -1
    }
    if exprKind(vh) != ExIdent {
        emitDiag(declLine(p), declCol(p), "binds: expects a bare field name")
        return -1
    }
    want = identName(vh)
    idName = poolGet(want)
    if formRecType == -1 {
        emitDiag(declLine(p), declCol(p), "binds: requires the window to declare form for")
        return -1
    }
    recName = poolGet(typeNameIdx(formRecType))
    fieldType = -1
    found = false
    fh = recordFieldsHead(typeNameIdx(formRecType))
    while fh != -1 {
        if fieldInfos[fh].nameIdx == want {
            fieldType = fieldInfos[fh].typeIdx
            found = true
            fh = -1
        } else {
            fh = fieldInfos[fh].next
        }
    }
    if not found {
        emitDiag(declLine(p), declCol(p), "no field " + idName + " on " + recName)
        return -1
    }
    fk = typeKind(fieldType)
    compat = false
    if kind == "field" {
        compat = fk == TyStr or fk == TyInt or fk == TyFixed
    } else if kind == "check" {
        compat = fk == TyBool
    } else if kind == "popup" {
        compat = fk == TyEnum
    }
    if not compat {
        emitDiag(declLine(p), declCol(p), "field " + idName + " (" + typeName(fieldType) + ") is not compatible with " + kind)
    }
    return identName(vh)
}

// checkMenuDecl builds a menu's item set (Ch9) and declares its name as a
// menu symbol -- entry shape is already validated by the parser; only
// duplicate item names are a checker concern.
func checkMenuDecl(d: int) {
    var nameIdx: int
    var menuName: string
    var e: int
    var iname: string
    var seen: map of int
    var sym: Symbol

    nameIdx = menuDeclName(d)
    menuName = poolGet(nameIdx)
    e = menuDeclEntriesHead(d)
    while e != -1 {
        if menuEntryIsItem(e) {
            iname = poolGet(menuEntryName(e))
            if seen.has(iname) {
                emitDiag(declLine(e), declCol(e), "duplicate menu item " + iname)
            } else {
                seen[iname] = 1
            }
            menuItems[menuKey(menuName, iname)] = 1
        }
        e = declNext(e)
    }

    sym.nameIdx = nameIdx
    sym.typeIdx = -1
    sym.isFunc = false
    sym.sigIdx = -1
    sym.isType = false
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = true
    if not scopeDeclare(curScope, sym) {
        emitDiag(declLine(d), declCol(d), "redeclaration of " + poolGet(nameIdx))
    }
}

// checkMenuItemName checks `MenuName.ItemName` -- the base of the
// `MenuName.ItemName.enabled` runtime property (Ch9). Returns a MenuItem
// pseudo-type.
func checkMenuItemName(e: int, menuName: string): int {
    var itemName: string

    itemName = poolGet(selectName(e))
    if not menuItems.has(menuKey(menuName, itemName)) {
        emitDiag(exprLine(e), exprCol(e), "undefined: " + itemName)
        return InvalidT
    }
    return menuItemT()
}

// checkWindowRefSelect checks a WindowRef VALUE's Select (Ch8: Window
// Instances): its `title`, per-instance vars, and widgets (yielding a widget
// pseudo-type).
func checkWindowRefSelect(e: int, xt: int): int {
    var winNameIdx: int
    var name: string
    var want: int
    var fh: int
    var wi: int

    winNameIdx = typeNameIdx(xt)
    want = selectName(e)
    name = poolGet(want)
    if name == "title" {
        return strT(255)
    }
    fh = windowVarsHead.get(winNameIdx, -1)
    while fh != -1 {
        if fieldInfos[fh].nameIdx == want {
            return fieldInfos[fh].typeIdx
        }
        fh = fieldInfos[fh].next
    }
    wi = windowWidgetsHead.get(winNameIdx, -1)
    while wi != -1 {
        if widgetInfos[wi].nameIdx == want {
            return widgetT(widgetInfos[wi].kindIdx)
        }
        wi = widgetInfos[wi].next
    }
    emitDiag(exprLine(e), exprCol(e), "undefined: " + name)
    return InvalidT
}

// checkWidgetSelect checks a widget pseudo-value's Select -- Ch8's runtime
// properties column, keyed by widget kind (widgetRuntimeProps). A single
// get(key, InvalidT) probe suffices (rather than has()-then-get(), Task
// 6 layer1-compiler-perf): InvalidT is never a stored value (every
// widgetRuntimeProps entry above is a real prop type -- strT(255)/
// BoolT/TextT/IntT), so a miss and a genuine InvalidT-typed hit (which
// can't happen) are indistinguishable only in the impossible case.
func checkWidgetSelect(e: int, xt: int): int {
    var key: string
    var t: int

    key = poolGet(typeNameIdx(xt)) + "." + poolGet(selectName(e))
    t = widgetRuntimeProps.get(key, InvalidT)
    if t != InvalidT {
        return t
    }
    emitDiag(exprLine(e), exprCol(e), "undefined: " + poolGet(selectName(e)))
    return InvalidT
}

// findWidgetKind returns the kind ("button"/"canvas"/...) of the widget
// named widgetName in window winNameIdx (the window type's own interned
// name index), or "" if there's no such widget. Task 6 (layer1-compiler-
// perf): took winName: string until the coordinator approved expanding
// this task's scope to clarusc/lower.cla, whose findWidgetKind/
// uiWidgetIndex/widgetBindsIdx callers all had (or could cheaply get) the
// interned index already -- see each converted call site's own note.
func findWidgetKind(winNameIdx: int, wgName: string): string {
    var wi: int

    wi = windowWidgetsHead.get(winNameIdx, -1)
    while wi != -1 {
        if poolGet(widgetInfos[wi].nameIdx) == wgName {
            return poolGet(widgetInfos[wi].kindIdx)
        }
        wi = widgetInfos[wi].next
    }
    return ""
}

// ================================================================
// Handlers, extend blocks, and timers (events.go)
// ================================================================

// windowScope builds the scope a window-scoped handler body sees beneath its
// own params: the instance's `title`, its per-instance vars, and its widgets
// (as widget pseudo-values) -- Ch8: bare names resolve first against the
// firing instance's properties, fields, and widgets.
func windowScope(parent: int, winType: int): int {
    var s: int
    var winNameIdx: int
    var fh: int
    var wi: int

    s = scopeNew(parent)
    winNameIdx = typeNameIdx(winType)
    declScopeVar(s, intern("title"), strT(255))
    fh = windowVarsHead.get(winNameIdx, -1)
    while fh != -1 {
        declScopeVar(s, fieldInfos[fh].nameIdx, fieldInfos[fh].typeIdx)
        fh = fieldInfos[fh].next
    }
    wi = windowWidgetsHead.get(winNameIdx, -1)
    while wi != -1 {
        declScopeVar(s, widgetInfos[wi].nameIdx, widgetT(widgetInfos[wi].kindIdx))
        wi = widgetInfos[wi].next
    }
    return s
}

func declScopeVar(scope: int, nameIdx: int, t: int) {
    var sym: Symbol

    sym.nameIdx = nameIdx
    sym.typeIdx = t
    sym.isFunc = false
    sym.sigIdx = -1
    sym.isType = false
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    scopeDeclare(scope, sym)
}

// checkHandlerBody checks one handler's declared params against spec
// (reporting a "handler NAME takes (...)" mismatch), then checks its body in
// a scope holding those params and, for a window-scoped handler (winType !=
// -1), the instance's widgets/vars/title beneath them. isCloseRequest gates
// `cancel`.
func checkHandlerBody(displayName: string, paramsHead: int, specIdx: int, body: int, winType: int, isCloseRequest: bool, line: int, col: int) {
    var paramTypes: list of int
    var pcount: int
    var wantCount: int
    var mismatch: bool
    var p: int
    var i: int
    var ep: int
    var base: int
    var fnScope: int
    var mark: int
    var psym: Symbol
    var savedScope: int
    var savedRet: int
    var savedWin: int
    var savedCR: bool

    p = paramsHead
    while p != -1 {
        paramTypes.add(resolveType(paramType(p)))
        p = declNext(p)
    }
    pcount = paramTypes.count
    wantCount = eventSpecs[specIdx].paramCount

    mismatch = pcount != wantCount
    if not mismatch {
        i = 0
        ep = eventSpecs[specIdx].paramsHead
        while i < pcount {
            if paramTypes[i] != InvalidT and not typesEqual(paramTypes[i], eventParams[ep].typeIdx) {
                mismatch = true
            }
            ep = eventParams[ep].next
            i = i + 1
        }
    }
    if mismatch {
        emitDiag(line, col, "handler " + displayName + " takes (" + formatEventParams(specIdx) + ")")
    }

    mark = scopes.count
    base = curScope
    if winType != -1 {
        base = windowScope(base, winType)
    }
    fnScope = scopeNew(base)
    p = paramsHead
    i = 0
    while p != -1 {
        psym.nameIdx = paramName(p)
        psym.typeIdx = paramTypes[i]
        psym.isFunc = false
        psym.sigIdx = -1
        psym.isType = false
        psym.isConst = false
        psym.constIsStr = false
        psym.constInt = 0
        psym.constStrIdx = -1
        psym.isMenu = false
        if not scopeDeclare(fnScope, psym) {
            emitDiag(declLine(p), declCol(p), "redeclaration of " + poolGet(paramName(p)))
        }
        p = declNext(p)
        i = i + 1
    }

    savedScope = curScope
    savedRet = curFuncRet
    savedWin = curWindow
    savedCR = inCloseRequest
    curScope = fnScope
    curFuncRet = -1
    curWindow = winType
    inCloseRequest = isCloseRequest
    checkBlock(body)
    curScope = savedScope
    curFuncRet = savedRet
    curWindow = savedWin
    inCloseRequest = savedCR
    scopesTruncate(mark)
}

// checkTopHandlerDecl checks a top-level `on App.event` or `on
// resourceVar.event` handler (Ch7, Ch12) -- the two shapes the grammar's
// top-level handler means, since only App and resource variables fire events
// outside a window/menu `extend`.
func checkTopHandlerDecl(d: int) {
    var path: string
    var parts: list of string
    var root: string
    var event: string
    var ctx: string
    var symIdx: int
    var k: TypeKind
    var specIdx: int

    path = poolGet(handlerDeclPath(d))
    parts = splitDots(path)
    if parts.count != 2 {
        emitDiag(declLine(d), declCol(d), "unknown event")
        return
    }
    root = parts[0]
    event = parts[1]

    ctx = ""
    if root == "App" {
        ctx = "app"
    } else {
        symIdx = scopeLookup(curScope, intern(root))
        if symIdx == -1 or symbols[symIdx].typeIdx == -1 {
            emitDiag(declLine(d), declCol(d), "undefined: " + root)
            return
        }
        k = typeKind(symbols[symIdx].typeIdx)
        if k == TyConnection {
            ctx = "connection"
        } else if k == TyListener {
            ctx = "listener"
        } else if k == TyServiceBrowser {
            ctx = "serviceBrowser"
        } else {
            emitDiag(declLine(d), declCol(d), "undefined: " + root)
            return
        }
    }

    if not eventTable.has(ctx + "." + event) {
        emitDiag(declLine(d), declCol(d), "unknown event")
        return
    }
    specIdx = eventTable.get(ctx + "." + event, -1)
    checkHandlerBody(path, handlerDeclParamsHead(d), specIdx, handlerDeclBody(d), -1, false, declLine(d), declCol(d))
}

// checkExtendDecl checks a top-level `extend` block (Ch8, Ch9) -- Target
// names either a window type or a menu.
func checkExtendDecl(d: int) {
    var tgtNameIdx: int
    var symIdx: int

    tgtNameIdx = extendDeclTarget(d)
    symIdx = scopeLookup(curScope, tgtNameIdx)
    if symIdx == -1 {
        emitDiag(declLine(d), declCol(d), "undefined: " + poolGet(tgtNameIdx))
        return
    }
    if symbols[symIdx].isType and typeKind(symbols[symIdx].typeIdx) == TyWindowRef {
        checkWindowExtend(symbols[symIdx].typeIdx, d)
    } else if symbols[symIdx].isMenu {
        checkMenuExtend(poolGet(tgtNameIdx), d, -1)
    } else {
        emitDiag(declLine(d), declCol(d), "cannot extend " + poolGet(tgtNameIdx))
    }
}

// checkWindowExtend checks `extend W { ... }`'s handlers (bare window events,
// or Widget.event) and nested `extend Menu { ... }` blocks scoped to W
// (Ch9: Window-Scoped Commands).
func checkWindowExtend(winType: int, d: int) {
    var c: int
    var tgtNameIdx: int
    var symIdx: int

    c = extendDeclChildrenHead(d)
    while c != -1 {
        if declKind(c) == DkHandler {
            checkWindowHandler(winType, c)
        } else if declKind(c) == DkExtend {
            tgtNameIdx = extendDeclTarget(c)
            symIdx = scopeLookup(curScope, tgtNameIdx)
            if symIdx == -1 or not symbols[symIdx].isMenu {
                emitDiag(declLine(c), declCol(c), "undefined: " + poolGet(tgtNameIdx))
            } else {
                checkMenuExtend(poolGet(tgtNameIdx), c, winType)
            }
        }
        c = declNext(c)
    }
}

// checkWindowHandler checks one handler inside `extend W`: a bare window
// event (Ch8), a bare form event when W is a form window (Ch10 --
// `accepted`'s param is W's own record), or `Widget.event` dispatched by
// that widget's kind.
func checkWindowHandler(winType: int, h: int) {
    var winName: string
    var displayName: string
    var parts: list of string
    var event: string
    var wgName: string
    var widgetKind: string
    var formRecType: int
    var specIdx: int
    var line: int
    var col: int

    winName = poolGet(typeNameIdx(winType))
    displayName = poolGet(handlerDeclPath(h))
    parts = splitDots(displayName)
    line = declLine(h)
    col = declCol(h)

    if parts.count == 1 {
        event = parts[0]
        if eventTable.has("window." + event) {
            specIdx = eventTable.get("window." + event, -1)
            checkHandlerBody(displayName, handlerDeclParamsHead(h), specIdx, handlerDeclBody(h), winType, event == "closeRequest", line, col)
            return
        }
        if windowIsForm.get(winName, 0) == 1 {
            if event == "accepted" {
                formRecType = windowFormRecType.get(winName, -1)
                specIdx = makeSpec1(intern("rec"), formRecType)
                checkHandlerBody(displayName, handlerDeclParamsHead(h), specIdx, handlerDeclBody(h), winType, false, line, col)
                return
            }
            if eventTable.has("formWindow." + event) {
                specIdx = eventTable.get("formWindow." + event, -1)
                checkHandlerBody(displayName, handlerDeclParamsHead(h), specIdx, handlerDeclBody(h), winType, false, line, col)
                return
            }
        }
        emitDiag(line, col, "unknown event")
    } else if parts.count == 2 {
        wgName = parts[0]
        event = parts[1]
        widgetKind = findWidgetKind(typeNameIdx(winType), wgName)
        if widgetKind == "" {
            emitDiag(line, col, "undefined: " + wgName)
            return
        }
        if not eventTable.has(widgetKind + "." + event) {
            emitDiag(line, col, "unknown event")
            return
        }
        specIdx = eventTable.get(widgetKind + "." + event, -1)
        checkHandlerBody(displayName, handlerDeclParamsHead(h), specIdx, handlerDeclBody(h), winType, false, line, col)
    } else {
        emitDiag(line, col, "unknown event")
    }
}

// checkMenuExtend checks `extend MenuName { on Item.select { } }` (Ch9),
// either at the top level (winType == -1: app-level commands) or nested
// inside `extend W` (winType != -1: window-scoped commands, auto-dimmed).
func checkMenuExtend(menuName: string, d: int, winType: int) {
    var c: int
    var path: string
    var parts: list of string
    var item: string
    var event: string
    var specIdx: int

    c = extendDeclChildrenHead(d)
    while c != -1 {
        if declKind(c) == DkHandler {
            path = poolGet(handlerDeclPath(c))
            parts = splitDots(path)
            if parts.count != 2 {
                emitDiag(declLine(c), declCol(c), "unknown event")
            } else {
                item = parts[0]
                event = parts[1]
                if not menuItems.has(menuKey(menuName, item)) {
                    emitDiag(declLine(c), declCol(c), "undefined: " + item)
                } else if not eventTable.has("menuItem." + event) {
                    emitDiag(declLine(c), declCol(c), "unknown event")
                } else {
                    specIdx = eventTable.get("menuItem." + event, -1)
                    checkHandlerBody(path, handlerDeclParamsHead(c), specIdx, handlerDeclBody(c), winType, false, declLine(c), declCol(c))
                }
            }
        } else if declKind(c) == DkExtend {
            emitDiag(declLine(c), declCol(c), "cannot extend inside a menu extend")
        }
        c = declNext(c)
    }
}

// checkEveryDecl checks a top-level `every N ticks { }` timer block (Ch7).
func checkEveryDecl(d: int) {
    if everyDeclTicks(d) < 1 {
        emitDiag(declLine(d), declCol(d), "tick count must be at least 1")
    }
    checkBlock(everyDeclBody(d))
}

// ================================================================
// Statement checking (check.go) -- 9a's expr-adjacent subset only
// ================================================================

// lvalueRootIdent returns the Ident expr index at the root of an lvalue
// chain (an Ident under any run of Select/Index), or -1 if e isn't rooted
// in one -- so checkAssignStmt can reject assigning through a const's
// field/index just as readily as assigning to the const name directly.
func lvalueRootIdent(e: int): int {
    if exprKind(e) == ExIdent {
        return e
    }
    if exprKind(e) == ExSelect {
        return lvalueRootIdent(selectX(e))
    }
    if exprKind(e) == ExIndex {
        return lvalueRootIdent(indexX(e))
    }
    return -1
}

// readOnlyPropName reports the read-only pseudo-property sel names
// (`front`, `count`, `length`, `isNew`, the error type's `code`/`message`),
// or "" if sel isn't one. Widget runtime properties (text/caption/
// checked/selected/enabled/title) aren't pseudo-properties -- they're
// real per-instance state -- so they fall through unrecognized here and
// stay assignable, matching expr.go's own comment; no ui.go dependency.
func readOnlyPropName(sel: int): string {
    var name: string
    var x: int
    var symIdx: int
    var xt: int
    var fh: int

    if selectName(sel) == cnFront {
        x = selectX(sel)
        if exprKind(x) == ExIdent {
            symIdx = scopeLookup(curScope, identName(x))
            if symIdx != -1 and symbols[symIdx].isType and typeKind(symbols[symIdx].typeIdx) == TyWindowRef {
                return "front"
            }
        }
    }
    // The receiver was fully checked moments earlier by checkAssignStmt's
    // checkExpr(lhs, -1) -> checkSelect -> checkExpr(x, -1), so the memo
    // (exprTypeOf, filled by checkExpr) is warm here -- re-checking it
    // would just re-run diagnostics already emitted once. InvalidT means
    // the receiver already failed; a read-only-property complaint on a
    // broken receiver is noise.
    xt = exprTypeGet(selectX(sel))
    if xt == InvalidT {
        return ""
    }
    name = poolGet(selectName(sel))
    switch typeKind(xt) {
    case TyList, TyMap, TySortedMap, TyIntMap {
        if name == "count" {
            return "count"
        }
    }
    case TyStr, TyText {
        if name == "length" {
            return "length"
        }
    }
    case TyRec {
        if name != "isNew" {
            return ""
        }
        fh = recordFieldsHead(typeNameIdx(xt))
        while fh != -1 {
            if fieldInfos[fh].nameIdx == cnIsNew {
                return ""
            }
            fh = fieldInfos[fh].next
        }
        return "isNew"
    }
    case TyErrorType {
        if name == "code" or name == "message" {
            return name
        }
    }
    }
    return ""
}

func checkAssignStmt(s: int) {
    var lhs: int
    var rhs: int
    var lt: int
    var rt: int
    var rootIdent: int
    var symIdx: int
    var propName: string

    lhs = assignLHS(s)
    rhs = assignRHS(s)
    lt = checkExpr(lhs, -1)
    rt = checkExpr(rhs, lt)

    rootIdent = lvalueRootIdent(lhs)
    if rootIdent != -1 {
        symIdx = scopeLookup(curScope, identName(rootIdent))
        if symIdx != -1 and symbols[symIdx].isConst {
            emitDiag(stmtLine(s), stmtCol(s), "cannot assign to constant " + poolGet(identName(rootIdent)))
            return
        }
    }
    if lt == InvalidT or rt == InvalidT {
        return
    }
    // Task 4 (toolbox-integration Feature B): no whole-record extern-record
    // operations -- covers BOTH directions (`ev2 = ev`, an xrec LHS, and
    // an xrec RHS flowing into anything else, e.g. `var p: ptr; p = ev`
    // reaching here as an assignment) with the ONE normative message,
    // ahead of the generic compatible() check below (which would otherwise
    // report a same-kind-mismatch or a generic "cannot assign" instead).
    if typeKind(lt) == TyXRec or typeKind(rt) == TyXRec {
        emitDiag(stmtLine(s), stmtCol(s), "extern records cannot be assigned")
        return
    }
    if exprKind(lhs) == ExSelect {
        propName = readOnlyPropName(lhs)
        if propName != "" {
            emitDiag(stmtLine(s), stmtCol(s), "cannot assign to read-only property " + propName)
            return
        }
    }
    if not compatible(rt, lt) {
        emitDiag(stmtLine(s), stmtCol(s), "cannot assign " + typeName(rt) + " to " + typeName(lt))
    }
}

// checkBlock checks a block's local vars then its statements, in a scope
// nested under whatever curScope currently is.
func checkBlock(b: int) {
    var saved: int
    var mark: int
    var v: int
    var s: int

    saved = curScope
    mark = scopes.count
    curScope = scopeNew(saved)
    v = blockVarsHead(b)
    while v != -1 {
        checkVarDecl(v)
        v = declNext(v)
    }
    s = blockStmtsHead(b)
    while s != -1 {
        checkStmt(s)
        s = stmtNext(s)
    }
    curScope = saved
    scopesTruncate(mark)
}

// checkStmt dispatches one statement. Only StAssign and StExprStmt are
// checked here -- the expr-adjacent surface this task's diagnostic list
// covers (cannot-assign-*, cannot-assign-to-constant, cannot-assign-to-
// read-only-property). The control-flow family -- StIf/StWhile/StFor/
// StSwitch/StBreak/StContinue/StReturn/StQuit/StCancel/StOpen/StClose/
// StEdit -- is stmt.go's job, deferred whole to Task 9b (see
// task-9-report.md); left unhandled here (a no-op, matching Clarus
// switch's own "no match, no else -> does nothing" rule) rather than
// silently half-checked.
func checkStmt(s: int) {
    switch stmtKind(s) {
    case StAssign {
        checkAssignStmt(s)
    }
    case StExprStmt {
        checkExpr(exprStmtX(s), -1)
    }
    case StIf {
        checkIfStmt(s)
    }
    case StWhile {
        checkWhileStmt(s)
    }
    case StFor {
        checkForStmt(s)
    }
    case StReturn {
        checkReturnStmt(s)
    }
    case StQuit {
        checkQuitStmt(s)
    }
    case StCancel {
        checkCancelStmt(s)
    }
    case StBreak {
        checkBreakStmt(s)
    }
    case StContinue {
        checkContinueStmt(s)
    }
    case StSwitch {
        checkSwitchStmt(s)
    }
    case StOpen {
        checkOpenStmt(s)
    }
    case StClose {
        checkCloseStmt(s)
    }
    case StEdit {
        checkEditStmt(s)
    }
    }
}

// ================================================================
// Control-flow statement checking (check.go stmt half + stmt.go)
// ================================================================

func checkCond(cond: int) {
    var ct: int

    ct = checkExpr(cond, BoolT)
    if ct != InvalidT and typeKind(ct) != TyBool {
        emitDiag(exprLine(cond), exprCol(cond), "condition must be bool")
    }
}

func checkIfStmt(s: int) {
    var els: int

    checkCond(ifCond(s))
    checkBlock(ifThen(s))
    els = ifElse(s)
    if els != -1 {
        if stmtKind(els) == StBlock {
            checkBlock(els)
        } else if stmtKind(els) == StIf {
            checkIfStmt(els)
        }
    }
}

// checkLoopBody checks a while/for loop's body with loopDepth incremented --
// the sole place loopDepth changes; switch case bodies use checkBlock
// directly, so a break inside one still binds the enclosing loop, if any.
func checkLoopBody(b: int) {
    loopDepth = loopDepth + 1
    checkBlock(b)
    loopDepth = loopDepth - 1
}

func checkWhileStmt(s: int) {
    checkCond(whileCond(s))
    checkLoopBody(whileBody(s))
}

func declareForVar(nameIdx: int, t: int) {
    var sym: Symbol

    if nameIdx == -1 {
        return
    }
    sym.nameIdx = nameIdx
    sym.typeIdx = t
    sym.isFunc = false
    sym.sigIdx = -1
    sym.isType = false
    sym.isConst = false
    sym.constIsStr = false
    sym.constInt = 0
    sym.constStrIdx = -1
    sym.isMenu = false
    scopeDeclare(curScope, sym)
}

// checkForStmt checks all three forms (Ch5: For): list iteration, map
// iteration (key + value), and an inclusive integer range.
func checkForStmt(s: int) {
    var seq: int
    var toX: int
    var v1: int
    var v2: int
    var body: int
    var seqT: int
    var toT: int
    var saved: int
    var mark: int

    seq = forSeq(s)
    toX = forTo(s)
    v1 = forV1(s)
    v2 = forV2(s)
    body = forBody(s)

    seqT = checkExpr(seq, -1)
    saved = curScope
    mark = scopes.count
    curScope = scopeNew(saved)

    if toX != -1 {
        toT = checkExpr(toX, -1)
        if seqT != InvalidT and typeKind(seqT) != TyInt {
            emitDiag(exprLine(seq), exprCol(seq), "range bounds must be int")
        }
        if toT != InvalidT and typeKind(toT) != TyInt {
            emitDiag(exprLine(toX), exprCol(toX), "range bounds must be int")
        }
        if v2 != -1 {
            emitDiag(stmtLine(s), stmtCol(s), "range for takes one variable")
        }
        declareForVar(v1, IntT)
        checkLoopBody(body)
        curScope = saved
        scopesTruncate(mark)
        return
    }

    if seqT == InvalidT {
        declareForVar(v1, InvalidT)
        if v2 != -1 {
            declareForVar(v2, InvalidT)
        }
    } else if typeKind(seqT) == TyList {
        if v2 != -1 {
            emitDiag(stmtLine(s), stmtCol(s), "list iteration takes one variable")
        }
        declareForVar(v1, typeElem(seqT))
    } else if typeKind(seqT) == TyMap {
        if v2 == -1 {
            emitDiag(stmtLine(s), stmtCol(s), "map iteration requires key and value variables")
        }
        declareForVar(v1, strT(255))
        if v2 != -1 {
            declareForVar(v2, typeElem(seqT))
        }
    } else if typeKind(seqT) == TySortedMap {
        if v2 == -1 {
            emitDiag(stmtLine(s), stmtCol(s), "map iteration requires key and value variables")
        }
        declareForVar(v1, strT(255))
        if v2 != -1 {
            declareForVar(v2, typeElem(seqT))
        }
    } else if typeKind(seqT) == TyIntMap {
        if v2 == -1 {
            emitDiag(stmtLine(s), stmtCol(s), "map iteration requires key and value variables")
        }
        declareForVar(v1, IntT)
        if v2 != -1 {
            declareForVar(v2, typeElem(seqT))
        }
    } else {
        emitDiag(exprLine(seq), exprCol(seq), "cannot iterate over " + typeName(seqT))
    }
    checkLoopBody(body)
    curScope = saved
    scopesTruncate(mark)
}

// checkReturnStmt checks `return` / `return expr` (Ch5: Return). No
// return-path flow analysis -- falling off the end is a runtime concern.
func checkReturnStmt(s: int) {
    var x: int
    var rt: int

    x = returnX(s)
    if x == -1 {
        if curFuncRet != -1 {
            emitDiag(stmtLine(s), stmtCol(s), "missing return value")
        }
        return
    }
    rt = checkExpr(x, curFuncRet)
    if curFuncRet == -1 {
        emitDiag(stmtLine(s), stmtCol(s), "unexpected return value in a procedure")
        return
    }
    if rt != InvalidT and not compatible(rt, curFuncRet) {
        emitDiag(stmtLine(s), stmtCol(s), "cannot return " + typeName(rt) + " as " + typeName(curFuncRet))
    }
}

// checkQuitStmt checks `quit [code]` -- the optional exit code must be int.
func checkQuitStmt(s: int) {
    var code: int
    var t: int

    code = quitCode(s)
    if code == -1 {
        return
    }
    t = checkExpr(code, IntT)
    if t != InvalidT and typeKind(t) != TyInt {
        emitDiag(exprLine(code), exprCol(code), "quit code must be int")
    }
}

func checkBreakStmt(s: int) {
    if loopDepth == 0 {
        emitDiag(stmtLine(s), stmtCol(s), "break is only valid inside a loop")
    }
}

func checkContinueStmt(s: int) {
    if loopDepth == 0 {
        emitDiag(stmtLine(s), stmtCol(s), "continue is only valid inside a loop")
    }
}

func checkCancelStmt(s: int) {
    if not inCloseRequest {
        emitDiag(stmtLine(s), stmtCol(s), "cancel is only valid inside a closeRequest handler")
    }
}

// checkCaseLabel checks one switch case label against the subject's type (or
// -1 when the subject itself already errored): checkExpr handles literal
// typing and the bare-enum-member fallback, so the only rule left is that an
// Ident resolving to a plain (non-const) symbol is not a constant.
func checkCaseLabel(lbl: int, expected: int): int {
    var lt: int
    var symIdx: int

    lt = checkExpr(lbl, expected)
    if lt == InvalidT {
        return InvalidT
    }
    if exprKind(lbl) == ExIdent {
        symIdx = scopeLookup(curScope, identName(lbl))
        if symIdx != -1 and not symbols[symIdx].isConst {
            emitDiag(exprLine(lbl), exprCol(lbl), "case label must be a constant")
            return InvalidT
        }
    }
    return lt
}

// caseLabelKey renders a checked case label's resolved value as a
// duplicate-detection key -- "" for anything with no compile-time value
// (already diagnosed, so unreachable for a clean program). Literals read
// straight off the AST; a bare enum member or const Ident reads the resolved
// value checkExpr/checkIdent recorded per expr index.
func caseLabelKey(lbl: int): string {
    var key: int

    switch exprKind(lbl) {
    case ExIntLit {
        return "i" + numToStr(intLitVal(lbl))
    }
    case ExCharLit {
        return "i" + numToStr(charLitVal(lbl))
    }
    case ExStringLit {
        return "s" + poolGet(stringLitIdx(lbl))
    }
    case ExIdent {
        key = lbl
        if constUseIsStr.has(key) {
            if constUseIsStr.get(key, 0) == 1 {
                return "s" + constUseStr.get(key, "")
            }
            return "i" + numToStr(constUseInt.get(key, 0))
        }
        if enumConstOf.has(key) {
            return "i" + numToStr(enumConstGet(lbl))
        }
    }
    }
    return ""
}

// checkSwitchStmt checks `switch subject { case ... } [else]` (Ch5: Switch).
// The subject must be int/char/enum/string (text excluded); each label is
// checked against it, must be a constant value, and duplicates are rejected.
func checkSwitchStmt(s: int) {
    var subj: int
    var subjT: int
    var validSubject: bool
    var k: TypeKind
    var cs: int
    var lbl: int
    var expected: int
    var lt: int
    var key: string
    var seen: map of int

    subj = switchSubject(s)
    subjT = checkExpr(subj, -1)
    validSubject = subjT != InvalidT
    if validSubject {
        k = typeKind(subjT)
        if k != TyInt and k != TyChar and k != TyEnum and k != TyStr {
            emitDiag(exprLine(subj), exprCol(subj), "switch operand must be int, char, enum, or string")
            validSubject = false
        }
    }

    cs = switchCasesHead(s)
    while cs != -1 {
        lbl = caseLabelsHead(cs)
        while lbl != -1 {
            expected = -1
            if validSubject {
                expected = subjT
            }
            lt = checkCaseLabel(lbl, expected)
            if lt != InvalidT {
                if validSubject and not compatible(lt, subjT) {
                    emitDiag(exprLine(lbl), exprCol(lbl), "cannot use " + typeName(lt) + " where " + typeName(subjT) + " is expected")
                } else {
                    key = caseLabelKey(lbl)
                    if key != "" {
                        if seen.has(key) {
                            emitDiag(exprLine(lbl), exprCol(lbl), "duplicate case label")
                        }
                        seen[key] = 1
                    }
                }
            }
            lbl = exprNext(lbl)
        }
        checkBlock(caseBody(cs))
        cs = stmtNext(cs)
    }
    if switchElse(s) != -1 {
        checkBlock(switchElse(s))
    }
}

// checkOpenStmt checks `open WindowType` -- WindowType must name a window.
func checkOpenStmt(s: int) {
    var nameIdx: int
    var symIdx: int

    nameIdx = openStmtWindowName(s)
    symIdx = scopeLookup(curScope, nameIdx)
    if symIdx == -1 {
        emitDiag(stmtLine(s), stmtCol(s), "undefined: " + poolGet(nameIdx))
        return
    }
    if not symbols[symIdx].isType or typeKind(symbols[symIdx].typeIdx) != TyWindowRef {
        emitDiag(stmtLine(s), stmtCol(s), "cannot open non-window type " + poolGet(nameIdx))
    }
}

// checkCloseStmt checks `close windowRef` -- the operand must be a window ref.
func checkCloseStmt(s: int) {
    var t: int

    t = checkExpr(closeX(s), -1)
    if t != InvalidT and typeKind(t) != TyWindowRef {
        emitDiag(stmtLine(s), stmtCol(s), "cannot close " + typeName(t))
    }
}

// checkEditStmt checks `edit FormWindow, target` (Ch10: The Edit Statement) --
// FormWindow must be a form window, and target (an lvalue, or `new T`) must
// agree with its `form for` record type.
func checkEditStmt(s: int) {
    var formNameIdx: int
    var symIdx: int
    var winName: string
    var formRecType: int
    var recName: string
    var newTypeName: int
    var tsymIdx: int
    var target: int
    var tt: int

    formNameIdx = editForm(s)
    symIdx = scopeLookup(curScope, formNameIdx)
    if symIdx == -1 {
        emitDiag(stmtLine(s), stmtCol(s), "undefined: " + poolGet(formNameIdx))
        return
    }
    if not symbols[symIdx].isType or typeKind(symbols[symIdx].typeIdx) != TyWindowRef {
        emitDiag(stmtLine(s), stmtCol(s), poolGet(formNameIdx) + " is not a window")
        return
    }
    winName = poolGet(formNameIdx)
    if windowIsForm.get(winName, 0) != 1 {
        emitDiag(stmtLine(s), stmtCol(s), poolGet(formNameIdx) + " is not a form window")
        return
    }
    formRecType = windowFormRecType.get(winName, -1)
    recName = poolGet(typeNameIdx(formRecType))

    if editIsNew(s) {
        newTypeName = editNewType(s)
        tsymIdx = scopeLookup(curScope, newTypeName)
        if tsymIdx == -1 or not symbols[tsymIdx].isType or typeKind(symbols[tsymIdx].typeIdx) != TyRec {
            emitDiag(stmtLine(s), stmtCol(s), "undefined: " + poolGet(newTypeName))
            return
        }
        if typeNameIdx(symbols[tsymIdx].typeIdx) != typeNameIdx(formRecType) {
            emitDiag(stmtLine(s), stmtCol(s), "cannot use " + poolGet(newTypeName) + " where " + recName + " is expected")
        }
        return
    }

    target = editTarget(s)
    tt = checkExpr(target, formRecType)
    if tt != InvalidT and not (typeKind(tt) == TyRec and typeNameIdx(tt) == typeNameIdx(formRecType)) {
        emitDiag(exprLine(target), exprCol(target), "cannot use " + typeName(tt) + " where " + recName + " is expected")
    }
}

// ================================================================
// Expression checking (expr.go)
// ================================================================

func checkNil(e: int, expected: int): int {
    if expected != -1 and isResourceKind(typeKind(expected)) {
        return expected
    }
    emitDiag(exprLine(e), exprCol(e), "nil is only valid for window and resource references")
    return InvalidT
}

func checkIdent(e: int, expected: int): int {
    var nameIdx: int
    var name: string
    var symIdx: int
    var i: int
    var mi: int
    var key: int

    nameIdx = identName(e)
    name = poolGet(nameIdx)
    symIdx = scopeLookup(curScope, nameIdx)
    if symIdx != -1 {
        if symbols[symIdx].isFunc {
            if symbols[symIdx].isCallback {
                // Task 7 (toolbox-integration Feature C): a bare `callback
                // func` name is legal ONLY as an extern call's ptr-typed
                // argument (checkArgsCall sets checkInExternPtrArgCtx
                // around exactly that one checkExpr call) -- return the
                // TyCallback pseudo-type there with no diagnostic, so
                // checkArgsCall's own TyCallback branch can confirm the
                // decay and lower.cla's lowCallArgs can build an ECbAddr.
                // Every OTHER position (var init, return, a non-extern
                // call arg, an extern call's non-ptr arg, a container
                // element, ...) reaches this same branch with the context
                // flag false, so it gets the SAME pinned diagnostic
                // regardless of which higher-level construct got here.
                if checkInExternPtrArgCtx {
                    return CallbackT
                }
                emitDiag(exprLine(e), exprCol(e), "callback function name can only be passed to an external function ptr parameter")
                return InvalidT
            }
            emitDiag(exprLine(e), exprCol(e), "cannot use function " + name + " as a value")
            return InvalidT
        }
        if symbols[symIdx].isType {
            emitDiag(exprLine(e), exprCol(e), "cannot use type " + name + " as a value")
            return InvalidT
        }
        if symbols[symIdx].isMenu {
            emitDiag(exprLine(e), exprCol(e), name + " is a menu, not a value")
            return InvalidT
        }
        if symbols[symIdx].isConst {
            key = e
            constUseIsStr[key] = boolToInt(symbols[symIdx].constIsStr)
            constUseInt[key] = symbols[symIdx].constInt
            if symbols[symIdx].constStrIdx != -1 {
                constUseStr[key] = poolGet(symbols[symIdx].constStrIdx)
            }
        }
        return symbols[symIdx].typeIdx
    }
    if expected != -1 and typeKind(expected) == TyEnum {
        mi = typeElem(expected)
        i = 0
        while i < typeN(expected) {
            if enumMembers[mi + i].nameIdx == nameIdx {
                enumConstOf[e] = enumMembers[mi + i].value
                return expected
            }
            i = i + 1
        }
    }
    emitDiag(exprLine(e), exprCol(e), "undefined: " + name)
    return InvalidT
}

func checkUnary(e: int): int {
    var op: int
    var t: int

    op = unaryOp(e)
    if op == OpNeg {
        t = checkExpr(unaryX(e), -1)
        if t == InvalidT {
            return InvalidT
        }
        if typeKind(t) != TyInt and typeKind(t) != TyFixed {
            emitDiag(exprLine(e), exprCol(e), "cannot negate " + typeName(t))
            return InvalidT
        }
        return t
    }
    if op == OpNot {
        t = checkExpr(unaryX(e), BoolT)
        if t == InvalidT {
            return InvalidT
        }
        if typeKind(t) != TyBool {
            emitDiag(exprLine(e), exprCol(e), "condition must be bool")
            return InvalidT
        }
        return BoolT
    }
    if op == OpBNot {
        t = checkExpr(unaryX(e), IntT)
        if t == InvalidT {
            return InvalidT
        }
        if typeKind(t) != TyInt {
            emitDiag(exprLine(e), exprCol(e), "bitwise operator requires int operands")
            return InvalidT
        }
        return IntT
    }
    emitDiag(exprLine(e), exprCol(e), "internal: unhandled unary operator " + unOpSymbol(op))
    return InvalidT
}

// checkArith checks `+ - * / mod` (Ch4: Mixed Numeric Arithmetic, String
// Concatenation and Truncation).
func checkArith(e: int): int {
    var lt: int
    var rt: int
    var op: int

    lt = checkExpr(binLeft(e), -1)
    rt = checkExpr(binRight(e), -1)
    if lt == InvalidT or rt == InvalidT {
        return InvalidT
    }
    op = binOp(e)
    if op == OpAdd {
        if typeKind(lt) == TyStr and typeKind(rt) == TyStr {
            return strT(255)
        }
        if typeKind(lt) == TyStr and typeKind(rt) == TyChar {
            return strT(255)
        }
        if typeKind(lt) == TyText and (typeKind(rt) == TyText or typeKind(rt) == TyStr) {
            return TextT
        }
        if typeKind(lt) == TyChar and typeKind(rt) == TyStr {
            return strT(255)
        }
        if typeKind(lt) == TyStr and typeKind(rt) == TyText {
            return TextT
        }
    }
    if typeKind(lt) == TyInt and typeKind(rt) == TyInt {
        return IntT
    }
    if typeKind(lt) == TyPtr and typeKind(rt) == TyInt and (op == OpAdd or op == OpSub) {
        return PtrT
    }
    if typeKind(lt) == TyFixed and typeKind(rt) == TyFixed {
        if op == OpMod {
            emitDiag(exprLine(e), exprCol(e), "operator mod requires int operands")
            return InvalidT
        }
        return FixedT
    }
    if (typeKind(lt) == TyInt and typeKind(rt) == TyFixed) or (typeKind(lt) == TyFixed and typeKind(rt) == TyInt) {
        emitDiag(exprLine(e), exprCol(e), "mixed int/fixed arithmetic; convert explicitly")
        return InvalidT
    }
    emitDiag(exprLine(e), exprCol(e), "invalid operands to " + binOpSymbol(op) + ": " + typeName(lt) + " and " + typeName(rt))
    return InvalidT
}

// checkBitwise checks `& | ^ << >>` -- int only (Ch4: Bitwise Operators).
func checkBitwise(e: int): int {
    var lt: int
    var rt: int

    lt = checkExpr(binLeft(e), -1)
    rt = checkExpr(binRight(e), -1)
    if lt == InvalidT or rt == InvalidT {
        return InvalidT
    }
    if typeKind(lt) != TyInt or typeKind(rt) != TyInt {
        emitDiag(exprLine(e), exprCol(e), "bitwise operator requires int operands")
        return InvalidT
    }
    return IntT
}

func isNilLit(e: int): bool {
    return exprKind(e) == ExNilLit
}

// isBareIdentCandidate reports whether e is an Ident not resolvable in the
// current scope -- a candidate for enum-member resolution via the other
// operand's type (see checkComparison).
func isBareIdentCandidate(e: int): bool {
    if exprKind(e) != ExIdent {
        return false
    }
    return scopeLookup(curScope, identName(e)) == -1
}

// checkComparison checks `== != < <= > >=`. allowEnum is true for ==/!=;
// enums support only those two, and so does nil.
func checkComparison(e: int, allowEnum: bool): int {
    var lt: int
    var rt: int
    var x: int
    var y: int

    x = binLeft(e)
    y = binRight(e)

    if isNilLit(x) and isNilLit(y) {
        emitDiag(exprLine(e), exprCol(e), "nil is only valid for window and resource references")
        return InvalidT
    }
    if isNilLit(x) {
        rt = checkExpr(y, -1)
        lt = checkExpr(x, rt)
    } else if isNilLit(y) {
        lt = checkExpr(x, -1)
        rt = checkExpr(y, lt)
    } else if isBareIdentCandidate(x) {
        rt = checkExpr(y, -1)
        if rt != InvalidT and typeKind(rt) == TyEnum {
            lt = checkExpr(x, rt)
        } else {
            lt = checkExpr(x, -1)
        }
    } else {
        lt = checkExpr(x, -1)
        if lt != InvalidT and typeKind(lt) == TyEnum {
            rt = checkExpr(y, lt)
        } else {
            rt = checkExpr(y, -1)
        }
    }
    if lt == InvalidT or rt == InvalidT {
        return InvalidT
    }
    if not allowEnum {
        if typeKind(lt) == TyEnum or typeKind(rt) == TyEnum {
            emitDiag(exprLine(e), exprCol(e), "enums are not ordered")
            return InvalidT
        }
        if isNilLit(x) or isNilLit(y) {
            emitDiag(exprLine(e), exprCol(e), "nil is only valid with == or !=")
            return InvalidT
        }
    }
    if isTextish(lt) and isTextish(rt) {
        return BoolT
    }
    if typeKind(lt) == typeKind(rt) {
        if typeKind(lt) == TyRec {
            emitDiag(exprLine(e), exprCol(e), "records cannot be compared")
            return InvalidT
        }
        if typeKind(lt) == TyXRec {
            // Task 4 review fix (Critical 1): no whole-record operations
            // exist for an extern record (Ch13), comparison included --
            // assignable's own TyXRec case (same-name xrecs "assignable")
            // exists only for typesEqual's/exhaustive-switch parity, never
            // meant to let a whole xrec value reach `==`/`<`/etc; this
            // must be checked BEFORE the generic compatible() fallback
            // below, which would otherwise silently pass two same-named
            // xrec operands through as comparable.
            emitDiag(exprLine(e), exprCol(e), "extern records cannot be compared")
            return InvalidT
        }
        if typeKind(lt) == TyList {
            emitDiag(exprLine(e), exprCol(e), "lists cannot be compared")
            return InvalidT
        }
        if typeKind(lt) == TyMap {
            emitDiag(exprLine(e), exprCol(e), "maps cannot be compared")
            return InvalidT
        }
        if typeKind(lt) == TySortedMap {
            emitDiag(exprLine(e), exprCol(e), "maps cannot be compared")
            return InvalidT
        }
        if typeKind(lt) == TyIntMap {
            emitDiag(exprLine(e), exprCol(e), "maps cannot be compared")
            return InvalidT
        }
    }
    if not compatible(lt, rt) and not compatible(rt, lt) {
        emitDiag(exprLine(e), exprCol(e), "type mismatch: " + typeName(lt) + " and " + typeName(rt))
        return InvalidT
    }
    return BoolT
}

// checkBoolOp checks `and`/`or` -- bool operands only.
func checkBoolOp(e: int): int {
    var lt: int
    var rt: int

    lt = checkExpr(binLeft(e), BoolT)
    rt = checkExpr(binRight(e), BoolT)
    if lt == InvalidT or rt == InvalidT {
        return InvalidT
    }
    if typeKind(lt) != TyBool or typeKind(rt) != TyBool {
        emitDiag(exprLine(e), exprCol(e), "condition must be bool")
        return InvalidT
    }
    return BoolT
}

func checkBinary(e: int): int {
    var op: int

    op = binOp(e)
    if op == OpAdd or op == OpSub or op == OpMul or op == OpDiv or op == OpMod {
        return checkArith(e)
    }
    if op == OpBAnd or op == OpBOr or op == OpBXor or op == OpShl or op == OpShr {
        return checkBitwise(e)
    }
    if op == OpEq or op == OpNe {
        return checkComparison(e, true)
    }
    if op == OpLt or op == OpLe or op == OpGt or op == OpGe {
        return checkComparison(e, false)
    }
    if op == OpAnd or op == OpOr {
        return checkBoolOp(e)
    }
    emitDiag(exprLine(e), exprCol(e), "internal: unhandled binary operator " + binOpSymbol(op))
    return InvalidT
}

// checkIndex checks `a[i]` -- string/text -> char, array/list -> elem, map
// -> value.
func checkIndex(e: int): int {
    var xt: int
    var it: int
    var idx: int

    xt = checkExpr(indexX(e), -1)
    if xt == InvalidT {
        return InvalidT
    }
    idx = indexI(e)
    if typeKind(xt) == TyStr or typeKind(xt) == TyText {
        it = checkExpr(idx, IntT)
        if it != InvalidT and typeKind(it) != TyInt {
            emitDiag(exprLine(idx), exprCol(idx), "index must be int")
        }
        return CharT
    }
    if typeKind(xt) == TyArr or typeKind(xt) == TyList {
        it = checkExpr(idx, IntT)
        if it != InvalidT and typeKind(it) != TyInt {
            emitDiag(exprLine(idx), exprCol(idx), "index must be int")
        }
        return typeElem(xt)
    }
    if typeKind(xt) == TyMap or typeKind(xt) == TySortedMap {
        it = checkExpr(idx, strT(255))
        if it != InvalidT and typeKind(it) != TyStr {
            emitDiag(exprLine(idx), exprCol(idx), "map index must be string")
        }
        return typeElem(xt)
    }
    if typeKind(xt) == TyIntMap {
        it = checkExpr(idx, IntT)
        if it != InvalidT and typeKind(it) != TyInt {
            emitDiag(exprLine(idx), exprCol(idx), "intmap index must be int")
        }
        return typeElem(xt)
    }
    emitDiag(exprLine(e), exprCol(e), "cannot index " + typeName(xt))
    return InvalidT
}

// checkSliceExpr checks `x[start, len]`: x must be string or text,
// start/len must be int, and the result is always a string(255) regardless
// of x's own capacity.
func checkSliceExpr(e: int): int {
    var xt: int
    var st: int
    var lt: int
    var xx: int
    var sx: int
    var lx: int

    xx = sliceX(e)
    sx = sliceStart(e)
    lx = sliceLen(e)
    xt = checkExpr(xx, -1)
    st = checkExpr(sx, IntT)
    lt = checkExpr(lx, IntT)
    if xt != InvalidT and typeKind(xt) != TyStr and typeKind(xt) != TyText {
        emitDiag(exprLine(xx), exprCol(xx), "cannot slice " + typeName(xt))
        xt = InvalidT
    }
    if st != InvalidT and typeKind(st) != TyInt {
        emitDiag(exprLine(sx), exprCol(sx), "slice start must be int")
    }
    if lt != InvalidT and typeKind(lt) != TyInt {
        emitDiag(exprLine(lx), exprCol(lx), "slice length must be int")
    }
    if xt == InvalidT {
        return InvalidT
    }
    return strT(255)
}

// checkSelect checks a bare `a.b` (field, or a no-argument property like
// .length/.count) -- method calls go through checkMethodCall since only a
// Call carries argument expressions.
func checkSelect(e: int): int {
    var x: int
    var name: string
    var want: int
    var symIdx: int
    var xt: int
    var fh: int

    x = selectX(e)
    want = selectName(e)
    name = poolGet(want)
    if exprKind(x) == ExIdent {
        if identName(x) == cnFile {
            emitDiag(exprLine(e), exprCol(e), "file." + name + " must be called")
            return InvalidT
        }
        symIdx = scopeLookup(curScope, identName(x))
        if symIdx != -1 {
            // A menu name's only valid select is `.ItemName` (Ch9), en route
            // to `.enabled` -- resolved against the menu's item set.
            if symbols[symIdx].isMenu {
                return checkMenuItemName(e, poolGet(symbols[symIdx].nameIdx))
            }
            if symbols[symIdx].isType and typeKind(symbols[symIdx].typeIdx) == TyWindowRef and name == "front" {
                return symbols[symIdx].typeIdx
            }
        }
    }
    xt = checkExpr(x, -1)
    if xt == InvalidT {
        return InvalidT
    }
    switch typeKind(xt) {
    case TyRec {
        fh = recordFieldsHead(typeNameIdx(xt))
        while fh != -1 {
            if fieldInfos[fh].nameIdx == want {
                return fieldInfos[fh].typeIdx
            }
            fh = fieldInfos[fh].next
        }
        if name == "isNew" {
            return BoolT
        }
    }
    case TyOverlay {
        fh = recordFieldsHead(typeNameIdx(xt))
        while fh != -1 {
            if fieldInfos[fh].nameIdx == want {
                return fieldInfos[fh].typeIdx
            }
            fh = fieldInfos[fh].next
        }
    }
    case TyXRec {
        // Task 4 (toolbox-integration Feature B): a plain field select,
        // same shape as TyOverlay's above -- `ev.what` (a scalar leaf) and
        // `ev.where` (a nested extern record, valid only as a decay
        // argument -- lower.cla's own job to enforce the "address can only
        // be passed to an external function" placement) both resolve here
        // identically; a pad field is never in this list at all (no
        // FieldInfo entry, see checkRecordDecl's isXRec branch), so
        // selecting one falls through to the generic "undefined: X" below,
        // same as any other undeclared field name.
        fh = recordFieldsHead(typeNameIdx(xt))
        while fh != -1 {
            if fieldInfos[fh].nameIdx == want {
                return fieldInfos[fh].typeIdx
            }
            fh = fieldInfos[fh].next
        }
    }
    case TyErrorType {
        if name == "code" {
            return IntT
        }
        if name == "message" {
            return strT(255)
        }
    }
    case TyStr, TyText {
        if name == "length" {
            return IntT
        }
    }
    case TyList, TyMap, TySortedMap, TyIntMap {
        if name == "count" {
            return IntT
        }
    }
    case TyWindowRef {
        return checkWindowRefSelect(e, xt)
    }
    case TyWidget {
        return checkWidgetSelect(e, xt)
    }
    case TyMenuItem {
        if name == "enabled" {
            return BoolT
        }
    }
    }
    emitDiag(exprLine(e), exprCol(e), "undefined: " + name)
    return InvalidT
}

func checkNewExpr(e: int): int {
    var nameIdx: int
    var symIdx: int

    nameIdx = newExprTypeName(e)
    symIdx = scopeLookup(curScope, nameIdx)
    if symIdx == -1 {
        emitDiag(exprLine(e), exprCol(e), "undefined: " + poolGet(nameIdx))
        return InvalidT
    }
    if not symbols[symIdx].isType or typeKind(symbols[symIdx].typeIdx) != TyRec {
        emitDiag(exprLine(e), exprCol(e), "cannot use new with non-record type " + poolGet(nameIdx))
        return InvalidT
    }
    return symbols[symIdx].typeIdx
}

// checkOpenExpr checks `open W` (an expression form: keeps the reference).
func checkOpenExpr(e: int): int {
    var nameIdx: int
    var symIdx: int

    nameIdx = openExprWindowName(e)
    symIdx = scopeLookup(curScope, nameIdx)
    if symIdx == -1 {
        emitDiag(exprLine(e), exprCol(e), "undefined: " + poolGet(nameIdx))
        return InvalidT
    }
    if not symbols[symIdx].isType or typeKind(symbols[symIdx].typeIdx) != TyWindowRef {
        emitDiag(exprLine(e), exprCol(e), "cannot open non-window type " + poolGet(nameIdx))
        return InvalidT
    }
    return symbols[symIdx].typeIdx
}

// checkConversion checks a single-argument conversion call against target:
// int(fixed|char|enum), fixed(int), char(int), EnumName(int).
func checkConversion(e: int, target: int, name: string): int {
    var argsHead: int
    var at: int
    var ok: bool

    argsHead = callArgsHead(e)
    if exprListCount(argsHead) != 1 {
        emitDiag(exprLine(e), exprCol(e), "conversion " + name + " takes exactly one argument")
        return InvalidT
    }
    at = checkExpr(argsHead, -1)
    if at == InvalidT {
        return InvalidT
    }
    ok = false
    if target == IntT {
        ok = typeKind(at) == TyFixed or typeKind(at) == TyChar or typeKind(at) == TyEnum or typeKind(at) == TyPtr
    } else if target == FixedT {
        ok = typeKind(at) == TyInt
    } else if target == CharT {
        ok = typeKind(at) == TyInt
    } else if target == PtrT {
        ok = typeKind(at) == TyInt or typeKind(at) == TyOverlay
    } else if typeKind(target) == TyEnum {
        ok = typeKind(at) == TyInt
    } else if typeKind(target) == TyOverlay {
        ok = typeKind(at) == TyPtr
    }
    if not ok {
        emitDiag(exprLine(e), exprCol(e), "cannot convert " + typeName(at) + " to " + name)
        return InvalidT
    }
    return target
}

// checkArgsCall type-checks a fixed-arity call's arguments against a
// FuncSig (bidirectionally, so bare enum members and nil resolve) and
// returns its return type, or VoidT for a procedure. isExtern (Task 4,
// toolbox-integration Feature B) is the ONE place extern-record decay/
// Point-int coercion is legal -- checked ahead of the generic compatible()
// rule so an xrec-typed argument gets one of the two Ch13-normative
// messages (or a clean pass, on a genuine decay/coercion) instead of a
// same-kind-mismatch complaint compatible() would otherwise produce.
func checkArgsCall(e: int, argsHead: int, sigIdx: int, isExtern: bool): int {
    var wantCount: int
    var haveCount: int
    var a: int
    var i: int
    var pt: int
    var at: int
    var ret: int
    var savedCbCtx: bool

    wantCount = funcSigParamCount(sigIdx)
    haveCount = exprListCount(argsHead)
    if haveCount != wantCount {
        emitDiag(exprLine(e), exprCol(e), "wrong number of arguments")
    } else {
        a = argsHead
        i = 0
        while a != -1 {
            pt = funcSigParam(sigIdx, i)
            // Task 7 (toolbox-integration Feature C): the ONE legal
            // position for a bare `callback func` name is an extern
            // call's ptr-typed argument -- set checkInExternPtrArgCtx
            // around exactly this one checkExpr call so checkIdent can
            // tell it apart from every other position (save/restore, not
            // a bare reset, in case some future expression shape ever
            // nests a call inside this argument).
            savedCbCtx = checkInExternPtrArgCtx
            checkInExternPtrArgCtx = isExtern and typeKind(pt) == TyPtr
            at = checkExpr(a, pt)
            checkInExternPtrArgCtx = savedCbCtx
            if at != InvalidT and typeKind(at) == TyXRec {
                if isExtern and typeKind(pt) == TyPtr {
                    // Ptr decay: the extern-record variable/nested-field's
                    // own address passes cleanly -- no diagnostic.
                } else if isExtern and typeKind(pt) == TyInt {
                    if xrecSize(at) != 4 {
                        emitDiag(exprLine(a), exprCol(a), "only a 4-byte extern record can pass as int")
                    }
                } else if typeKind(pt) == TyPtr {
                    // A ptr-typed param, but NOT an extern call -- decay is
                    // legal only at an `external func` call site.
                    emitDiag(exprLine(a), exprCol(a), "extern record address can only be passed to an external function")
                } else {
                    emitDiag(exprLine(a), exprCol(a), "cannot use " + typeName(at) + " where " + typeName(pt) + " is expected")
                }
            } else if at != InvalidT and typeKind(at) == TyCallback {
                // Task 7: legal decay already verified by
                // checkInExternPtrArgCtx inside checkIdent (isExtern and
                // pt is ptr -- the only context that returns TyCallback
                // without diagnosing) -- nothing further to check here;
                // lower.cla's lowCallArgs detects TyCallback via
                // exprTypeGet and builds an ECbAddr in its place.
            } else if at != InvalidT and not compatible(at, pt) {
                emitDiag(exprLine(a), exprCol(a), "cannot use " + typeName(at) + " where " + typeName(pt) + " is expected")
            }
            a = exprNext(a)
            i = i + 1
        }
    }
    ret = funcSigRet(sigIdx)
    if ret == -1 {
        return VoidT
    }
    return ret
}

// checkIdentCall handles `name(args)` where name is a bare identifier:
// either a numeric/enum conversion or a call to a user-declared function.
func checkIdentCall(e: int, fn: int): int {
    var nameIdx: int
    var symIdx: int

    nameIdx = identName(fn)
    if nameIdx == cnInt {
        return checkConversion(e, IntT, "int")
    }
    if nameIdx == cnFixed {
        return checkConversion(e, FixedT, "fixed")
    }
    if nameIdx == cnChar {
        return checkConversion(e, CharT, "char")
    }
    if nameIdx == cnPtr {
        return checkConversion(e, PtrT, "ptr")
    }
    if nameIdx == cnNow or nameIdx == cnDateTimeStr or nameIdx == cnDurationStr {
        usesDateTime = true
    }

    symIdx = scopeLookup(curScope, nameIdx)
    if symIdx == -1 {
        emitDiag(exprLine(e), exprCol(e), "undefined: " + poolGet(nameIdx))
        return InvalidT
    }
    if symbols[symIdx].isType {
        if typeKind(symbols[symIdx].typeIdx) == TyEnum or typeKind(symbols[symIdx].typeIdx) == TyOverlay {
            return checkConversion(e, symbols[symIdx].typeIdx, poolGet(nameIdx))
        }
        emitDiag(exprLine(e), exprCol(e), "cannot convert to " + poolGet(nameIdx))
        return InvalidT
    }
    if symbols[symIdx].isFunc {
        return checkArgsCall(e, callArgsHead(e), symbols[symIdx].sigIdx, symbols[symIdx].isExtern)
    }
    emitDiag(exprLine(e), exprCol(e), poolGet(nameIdx) + " is not callable")
    return InvalidT
}

func checkCall(e: int, expected: int): int {
    var fn: int

    fn = callFn(e)
    if exprKind(fn) == ExIdent {
        return checkIdentCall(e, fn)
    }
    if exprKind(fn) == ExSelect {
        return checkMethodCall(fn, callArgsHead(e))
    }
    emitDiag(exprLine(e), exprCol(e), "cannot call this expression")
    return InvalidT
}

// checkExpr type-checks e and returns its type-arena index (or InvalidT).
// expected resolves bare enum members and `nil` (a type-arena index, or -1
// for "no hint"); it is a hint, not an obligation -- concrete-typed
// expressions (literals, resolved idents) ignore it. On any error,
// checkExpr reports exactly one diagnostic and returns InvalidT.
//
// checkExpr is a single-tail wrapper around checkExprInner (below, which
// has the real per-ExprKind logic and its many return sites): it records
// the resolved type in exprTypeOf, an intmap keyed directly by e (the
// expr's own arena index) same as enumConstOf, so a later lowering pass
// can read it back via exprTypeGet -- mirroring Go's Info.Types -- before
// returning it.
func checkExpr(e: int, expected: int): int {
    var t: int
    t = checkExprInner(e, expected)
    exprTypeOf[e] = t
    return t
}

// checkExprInner holds checkExpr's actual per-ExprKind checking logic;
// see checkExpr above for why it is split out this way.
func checkExprInner(e: int, expected: int): int {
    switch exprKind(e) {
    case ExIntLit {
        return IntT
    }
    case ExFixedLit {
        return FixedT
    }
    case ExCharLit {
        return CharT
    }
    case ExStringLit {
        return strT(255)
    }
    case ExBoolLit {
        return BoolT
    }
    case ExNilLit {
        return checkNil(e, expected)
    }
    case ExWindowSelf {
        if curWindow != -1 {
            return curWindow
        }
        emitDiag(exprLine(e), exprCol(e), "window is only valid inside a window-scoped handler")
        return InvalidT
    }
    case ExIdent {
        return checkIdent(e, expected)
    }
    case ExUnary {
        return checkUnary(e)
    }
    case ExBinary {
        return checkBinary(e)
    }
    case ExCall {
        return checkCall(e, expected)
    }
    case ExIndex {
        return checkIndex(e)
    }
    case ExSlice {
        return checkSliceExpr(e)
    }
    case ExSelect {
        return checkSelect(e)
    }
    case ExNew {
        return checkNewExpr(e)
    }
    case ExOpen {
        return checkOpenExpr(e)
    }
    case ExAppConst {
        return checkAppConstExpr(e)
    }
    }
    emitDiag(exprLine(e), exprCol(e), "internal: unhandled expression type")
    return InvalidT
}

// checkAppConstExpr validates `app.doctype` / `app.id` (native-gaps-
// cleanup Task 1, Part A): the only two field names the parser's `app`
// `.` IDENT lookahead can produce a legal expression for. Both resolve
// to `string` at compile time regardless of whether the program has an
// `app` section at all -- lowAppConst (lower.cla) supplies the
// "TEXT"/"????" defaults when one is absent, so no appDeclSeen check
// belongs here.
func checkAppConstExpr(e: int): int {
    var name: string

    name = poolGet(appConstField(e))
    if name != "doctype" and name != "id" {
        emitDiag(exprLine(e), exprCol(e), "unknown app constant " + name)
        return InvalidT
    }
    return strT(255)
}

// ================================================================
// checkReset / checkProgram (check.go)
// ================================================================

// checkReset clears all check-global state and rebuilds the universe
// scope + built-in method tables from scratch -- called by checkProgram
// itself (callers never need to remember it), mirroring parseFile's own
// parseReset-on-entry convention. Every non-fixed typeArena index (a
// strT(255) result, say) that any of this state might have cached is
// invalidated the instant typesReset runs, so EVERYTHING derived from the
// type system is rebuilt here every single call -- exactly as Go's Files()
// rebuilds a fresh universe scope on every call, no caching. This mirrors
// Go's own behavior, not an inefficiency unique to this port; paramSpecs/
// methodSigs are explicitly emptied first so they don't grow across
// repeated resets in a long-running process.
// checkReset's own doc comment family (funcScopeByDecl etc., above) argues
// a decl/expr-indexed side table needs no bulk clear because "every key
// used within a checkProgram call is always freshly written in THAT SAME
// call before anything in that call reads it" -- true for a table written
// UNCONDITIONALLY for every node of its own kind (funcScopeByDecl: every
// func decl), false for one written only CONDITIONALLY. enumConstOf/
// constUseIsStr/constUseInt/constUseStr are written only when an Ident
// happens to resolve to a const/enum member (lowIdent, lower.cla) -- an
// ORDINARY local var's Ident node never writes an entry at its own index,
// in ANY compile. Task 11 fix round 2 (mac-resident-clarusc): macgui.cla
// (Task 10) broke the one-program-per-process assumption these four maps
// (and exprTypeOf's own doc comment explicitly names the same assumption)
// were built under -- a second driveCompile call in the same process gets
// fresh AST node indices from astReset() that inevitably collide with a
// FIRST compile's indices, and for these four maps a stale hit at a
// reused index (this time belonging to an ordinary local var, never
// written this compile) reads back as a genuine const/enum reference --
// e.g. lowIdent's `enumConstOf.has(key)` returning true for a plain local
// and handing lowering a bogus EIntConst as an ASSIGNMENT TARGET
// (cg68k.cla's cgStmt then panics: "SAssign dst kind 0 ... unsupported").
// Reset here, fresh per checkProgram call, same idiom as every other
// module-global map reset in this file (a genuinely new empty map, not a
// mutated existing one -- map is a reference type, Ch3).
func checkReset() {
    var freshEnumConstOf: intmap of int
    var freshConstUseIsStr: intmap of int
    var freshConstUseInt: intmap of int
    var freshConstUseStr: intmap of string
    var freshExprTypeOf: intmap of int
    var freshRecFieldsHeadByName: intmap of int
    var freshWindowIsForm: map of int
    var freshWindowFormRecType: map of int
    var freshWindowVarsHead: intmap of int
    var freshWindowWidgetsHead: intmap of int
    var freshFuncScopeByDecl: intmap of int
    var freshFuncRetByDecl: intmap of int
    var freshFuncSigByDecl: intmap of int
    var freshXrecSizeByName: map of int
    var freshXrecFirstDeclByName: map of int
    var freshMenuItems: map of int
    var freshExternFirstDeclByName: map of int

    // cnInit's own guard (cnInited) is a process-lifetime lazy-init idiom
    // (see its own decl comment) -- reset here, right before calling it,
    // so it re-interns cn* fresh against libReset()'s current pool
    // generation every compile, not just the first one in the process.
    cnInited = false
    cnInit()
    typesReset()
    scopesReset()
    enumConstOf = freshEnumConstOf
    constUseIsStr = freshConstUseIsStr
    constUseInt = freshConstUseInt
    constUseStr = freshConstUseStr
    exprTypeOf = freshExprTypeOf
    // recFieldsHeadByName (Task 6, layer1-compiler-perf: re-keyed from a
    // poolGet(nameIdx) string to nameIdx itself) is keyed by an
    // intern-pool index, which now RECYCLES across compiles
    // (memory-leak-fix Task 7's libReset()) -- this reset is no longer
    // just defensive, it's required: a stale entry would alias whatever
    // new string the reset pool assigns that index this generation.
    recFieldsHeadByName = freshRecFieldsHeadByName
    // windowIsForm/windowFormRecType/windowVarsHead/windowWidgetsHead/
    // funcScopeByDecl/funcRetByDecl/funcSigByDecl/xrecSizeByName/
    // xrecFirstDeclByName/menuItems/externFirstDeclByName (memory-leak-fix
    // Task 7): each was already correctness-safe without a reset (see
    // their own decl comments), but this phase's charter is bounded
    // memory, not just correctness -- an unreset map only ever grows
    // across repeated driveCompile calls in one long-running ClarusC.APPL
    // session. Folded in here, fresh-map style matching every sibling
    // reset above. menuItems/externFirstDeclByName also drop their former
    // progGen-namespacing (see their own comments) now that this reset
    // makes it redundant.
    windowIsForm = freshWindowIsForm
    windowFormRecType = freshWindowFormRecType
    windowVarsHead = freshWindowVarsHead
    windowWidgetsHead = freshWindowWidgetsHead
    funcScopeByDecl = freshFuncScopeByDecl
    funcRetByDecl = freshFuncRetByDecl
    funcSigByDecl = freshFuncSigByDecl
    xrecSizeByName = freshXrecSizeByName
    xrecFirstDeclByName = freshXrecFirstDeclByName
    menuItems = freshMenuItems
    externFirstDeclByName = freshExternFirstDeclByName

    connectionT = pushSimple(TyConnection)
    listenerT = pushSimple(TyListener)
    serviceBrowserT = pushSimple(TyServiceBrowser)

    universeScope = scopeNew(-1)
    topScope = scopeNew(universeScope)
    curScope = topScope
    curFuncRet = -1
    curWindow = -1

    loopDepth = 0
    inCloseRequest = false
    appDeclSeen = false
    usesFileSaveLoad = false
    usesSortedMap = false
    usesDateTime = false
    progGen = progGen + 1

    paramSpecs.clear()
    methodSigs.clear()
    fieldInfos.clear()
    widgetInfos.clear()
    eventParams.clear()
    eventSpecs.clear()

    registerUniverse(universeScope)
    buildMethodTables()
    buildUiTables()
    buildEventsTable()
}

// checkTopDeclPhase1 checks/declares one top-level declaration into curScope
// (records/enums/consts/vars fully checked; function signatures resolved and
// declared with body deferred; windows/menus fully built and declared).
// DkExtend/DkHandler/DkEvery attach behavior to an existing name rather than
// declaring one -- their bodies (like function bodies) are deferred to
// phase 2, so they can target any window/menu/function regardless of source
// order (Ch6: Scope).
func checkTopDeclPhase1(d: int) {
    switch declKind(d) {
    case DkRecord {
        checkRecordDecl(d)
    }
    case DkEnum {
        checkEnumDecl(d)
    }
    case DkVar {
        checkVarDecl(d)
    }
    case DkConst {
        checkConstDecl(d)
    }
    case DkFunc {
        checkFuncSig(d)
    }
    case DkWindow {
        checkWindowDecl(d)
    }
    case DkMenu {
        checkMenuDecl(d)
    }
    case DkApp {
        checkAppDecl(d)
    }
    case DkExternFunc {
        checkExternFunc(d)
    }
    case DkCallbackFunc {
        checkCallbackFunc(d)
    }
    }
}

// checkProgram type-checks a whole program (parseFile's returned
// declHead) in two phases -- check.go's Files, restated for a single
// already-assembled decl list rather than a []*ast.File slice (include
// expansion, if any, has already flattened everything into one list by
// the time this is called): phase 1 walks every top-level decl in order,
// declaring each into curScope; phase 2 then checks every DkFunc's body,
// against the now-COMPLETE top-level scope, so a body may call any
// function regardless of declaration order (Ch6: Recursion, Scope).
// setCheckPath switches curPathIdx to the file the top-level decl d was parsed
// from, so every diagnostic emitted while checking it (and its nested body) is
// attributed to that file -- the Go checker's `c.f = files[i]` / `c.f = dd.f`.
// A -1 (unrecorded, e.g. a single-file program checked without expansion)
// leaves curPathIdx unchanged.
func setCheckPath(d: int) {
    var p: int

    p = getDeclFile(d)
    if p != -1 {
        curPathIdx = p
    }
}

func checkProgram(declHead: int) {
    var d: int

    checkReset()

    d = declHead
    while d != -1 {
        setCheckPath(d)
        checkTopDeclPhase1(d)
        d = declNext(d)
    }

    d = declHead
    while d != -1 {
        setCheckPath(d)
        if declKind(d) == DkFunc or declKind(d) == DkCallbackFunc {
            checkFuncBody(d)
        } else if declKind(d) == DkExtend {
            checkExtendDecl(d)
        } else if declKind(d) == DkHandler {
            checkTopHandlerDecl(d)
        } else if declKind(d) == DkEvery {
            checkEveryDecl(d)
        }
        // live-log phase, 3b: liveness pulse for this per-decl walk --
        // a no-op unless want68k (driveProgressTick's own gate).
        driveProgressTick()
        d = declNext(d)
    }
}

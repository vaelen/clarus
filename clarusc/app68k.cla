// app68k.cla: the application image writer -- native-5d Task 10
// (single-segment), generalized to N segments by Task 15. Turns
// cg68k.cla's finished per-segment 68k instruction streams (one
// CODE-resource-worth of bytes each) plus the final JT slot->(offset,
// segment) table (cg68k.cla's cgAssignFinalJtSlots) into a classic Mac
// application file: CODE 0 (the A5-world header + jump table), CODE
// 1..N (one per segment, each wrapped in its own tiny per-segment
// header), SIZE -1 (MultiFinder size info), assembled into a resource
// fork, wrapped in a 128-byte MacBinary II header. The whole thing is
// written with file.writeText -- binary-safe (NUL/CR/255 round-trip
// through it untouched; pinned by testdata/run/lib/binroundtrip.cla), so
// this file never needs to dodge a text-mode byte.
//
// GROUND TRUTH. Every byte offset and field below was cross-checked
// against REAL, WORKING code already in this machine's checkout, not
// against memory of Inside Macintosh:
//   - Resource fork layout (header/data/map/type-list/ref-list, exact
//     offsets and the always-24-then-28-then-... byte math): Retro68's
//     own `ResourceFile::writeFork` (Retro68/ResourceFiles/ResourceFork.cc)
//     -- the SAME code path Retro68 uses to build every .bin this
//     project's own scripts/build-mac.sh has successfully booted in Mini
//     vMac.
//   - CODE 0 / CODE 1 shape (above-A5/below-A5/JT-length/JT-offset longs,
//     the {offset.W,$3F3C,segNum.W,$A9F0} JT entry shape, the CODE 1
//     {firstEntryOffset.W,count.W} header, and -- critically -- that a JT
//     entry's OFFSET FIELD is the routine's raw offset PLUS 4 to skip
//     past CODE 1's own header): Retro68's Elf2Mac
//     (Retro68/Elf2Mac/Object.cc, Object::SingleSegmentApp and
//     Object::MultiSegmentApp, the `if(id==1) offset += 4;` line).
//   - MacBinary II header field offsets and the CRC-16/XMODEM algorithm
//     (poly 0x1021, init 0, MSB-first, computed over bytes 0-123):
//     Retro68/ResourceFiles/ResourceFile.cc's writeMacBinary +
//     Retro68/hfsutils/copyout.c's do_macb (which additionally sets the
//     MacBinary II version bytes 122/123=129 -- writeMacBinary leaves
//     them 0, i.e. MacBinary I-ish; this file follows copyout.c and
//     writes 129/129, the more broadly-compatible, spec-correct choice,
//     and copyin.c's own read-side check `buf[123] > 129 -> unsupported`
//     confirms 129 is a valid, accepted value).
//   - SIZE(-1) flags: this project's own scripts/build-mac.sh /
//     Retro68/libretro/Retro68APPL.r SIZE(-1) resource literal, hand-
//     decoded bit-by-bit against Retro68/InterfacesAndLibraries/
//     Interfaces/RIncludes/Processes.r's `type 'SIZE'` field declaration
//     (16 boolean fields, MSB-first; first name in a `boolean a, b;` pair
//     = 0, second = 1). Only `is32BitCompatible` is set; canBackground
//     and MultiFinder-awareness (`needsActivateOnFGSwitch`, Processes.r's
//     own `notMultiFinderAware` alias) are both off, matching the plain,
//     no-AppleEvents System 6 app this task's own brief calls for.
//     Result: flags = 0x0080.
//
// DETERMINISM. MacBinary mandates a creation/modification date field;
// clarusc has no clock access on this backend (and using one would break
// the double-emit byte-compare determinism test this task requires
// regardless) -- both date longs are the fixed constant 0. A real Finder
// would show this as Jan 1 1904, which is harmless for a compiled test
// binary and not a behavior anything in this codebase depends on.
//
// N SEGMENTS (Task 15). app68Build takes segBytes as a `list of text`:
// segBytes[i] becomes CODE (i+1). The resource map's TYPE list is still
// exactly two types (CODE, SIZE) -- only the CODE type's own resource
// COUNT grows with segBytes.count; app68BuildResourceFork computes every
// map offset (ref-list offsets, name-list offset) from segBytes.count
// rather than the Task-10 hardcoded 2-resource constants.

// app68FreshIntList/app68FreshTextList hand back genuinely empty lists
// (the same trick cg68k.cla's cgFreshIntList/cgFreshTextList use) -- this
// file's own tiny copies, matching the "no cross-depending on a sibling
// module for small shared helpers" policy already established for
// app68PutByte/Word/Long below (Task 15: app68BuildResourceFork/app68Build
// need a fresh scratch list per call, same reasoning).
func app68FreshIntList(): list of int {
    var l: list of int
    return l
}

func app68FreshTextList(): list of text {
    var l: list of text
    return l
}

// app68PutByte/Word/Long append a raw big-endian value to a binary text
// buffer -- the same technique asm68k.cla's a68PutByte/Word/Long use
// (char() keeps only the low byte; `>>` is arithmetic/sign-propagating,
// so this is correct for negative values too, e.g. a -1 ID or a 0xFFFF
// "no name" marker). Kept as this file's own tiny copies rather than
// reaching into asm68k.cla, matching cg68k.cla's own stated policy of not
// cross-depending on a sibling module for small shared helpers.
func app68PutByte(out: text, b: int) {
    out.append(char(b))
}

func app68PutWord(out: text, w: int) {
    out.append(char(w >> 8))
    out.append(char(w))
}

func app68PutLong(out: text, v: int) {
    app68PutWord(out, v >> 16)
    app68PutWord(out, v)
}

// app68PutFixed appends exactly n bytes taken from s: s's own bytes,
// zero-padded (never truncated by silently overrunning n -- extra bytes
// beyond n are simply never read) if s is shorter than n. Used for the
// creator field, which must occupy exactly 4 bytes of the MacBinary
// header even though the caller-supplied string(7) may be shorter.
func app68PutFixed(out: text, s: string, n: int) {
    var i: int

    i = 0
    while i < n {
        if i < s.length {
            out.append(s[i])
        } else {
            out.append(char(0))
        }
        i = i + 1
    }
}

// app68Crc16 computes CRC-16/XMODEM (poly 0x1021, init 0, MSB-first, no
// reflection, no final XOR) over data, table-free (a plain 8-shifts-per-
// byte bitwise loop -- the Go-subset backend has no static table
// initializer story, and this is only ever run over a 124-byte header, so
// there is no performance case for a table). Verified against the
// standard CRC-16/XMODEM test vector ("123456789" -> 0x31C3) during this
// task's own development; internal/cg68k/image_test.go re-verifies with
// an INDEPENDENT Go implementation, not a port of this one.
func app68Crc16(data: text): int {
    var crc: int
    var i: int
    var j: int
    var b: int

    crc = 0
    i = 0
    while i < data.length {
        b = int(data[i])
        crc = crc ^ (b << 8)
        j = 0
        while j < 8 {
            if (crc & 0x8000) != 0 {
                crc = ((crc << 1) ^ 0x1021) & 0xFFFF
            } else {
                crc = (crc << 1) & 0xFFFF
            }
            j = j + 1
        }
        i = i + 1
    }
    return crc
}

// app68BuildHeader builds the 128-byte MacBinary II header. rsrcLen is
// the RAW (unpadded) resource fork byte length -- the outer 128-byte
// padding of the whole file happens after this header + the resource
// fork are both appended (app68Build), never inside this header's own
// "resource fork length" field.
func app68BuildHeader(appName: string(31), creator: string(7), rsrcLen: int): text {
    var h: text
    var crcVal: int

    h = ""
    app68PutByte(h, 0)                    // 0: version/signature byte
    app68PutByte(h, appName.length)       // 1: Pascal name length
    h.append(appName)
    while h.length < 65 {                 // 2-64: name bytes, zero-padded
        h.append(char(0))
    }
    h.append("APPL")                      // 65-68: file type
    app68PutFixed(h, creator, 4)          // 69-72: creator
    while h.length < 83 {                 // 73: Finder flags hi; 74: reserved;
        h.append(char(0))                 // 75-76/77-78/79-80: icon v/h/folder id;
    }                                     // 81: protected; 82: reserved
    app68PutLong(h, 0)                    // 83-86: data fork length (no data fork)
    app68PutLong(h, rsrcLen)              // 87-90: resource fork length
    app68PutLong(h, 0)                    // 91-94: creation date (fixed, no clock)
    app68PutLong(h, 0)                    // 95-98: modification date (fixed, no clock)
    while h.length < 122 {                // 99-100: comment len; 101: Finder flags lo;
        h.append(char(0))                 // 102-115: unused; 116-119: unpacked len;
    }                                     // 120-121: secondary header len
    app68PutByte(h, 129)                  // 122: MacBinary II version that wrote this
    app68PutByte(h, 129)                  // 123: minimum version needed to read this
    crcVal = app68Crc16(h)                // CRC over bytes 0-123 (h.length == 124 here)
    app68PutWord(h, crcVal)               // 124-125: CRC-16/XMODEM
    app68PutWord(h, 0)                    // 126-127: reserved
    return h
}

// app68BuildCode0 builds the CODE 0 resource: the A5-world header (above-
// A5 size, below-A5 size, JT length, JT offset from A5 -- always 32) plus
// one 8-byte "unloaded" jump-table entry per jtEntries element. jtEntries[i]
// is that JT slot's routine offset FROM THE START OF ITS OWN SEGMENT's
// code (i.e. AFTER that segment's own 4-byte per-segment header, which
// _LoadSeg skips itself -- do NOT add 4 here: Elf2Mac writes its own
// classic entry-point entry as literally `0000 3F3C 0001 A9F0`
// (Object.cc:265) for a routine at code offset 0, and adding 4 lands the
// entry one instruction into the routine -- which is exactly what
// blocked native-5d Task 11's first boot (the app entered startup PAST
// its `LEA -292(A5),A0`, so the below-A5 zero loop ran with a garbage
// A0: globals never zeroed AND 292 bytes of wild writes). Elf2Mac's own
// `offset += 4` (Object.cc:284) applies to its 32-BIT jump table entries
// (`id.W, $A9F0, offset.L`), a different entry format resolved by
// Retro68's runtime rather than the ROM's _LoadSeg); jtSegNums[i] is that
// same slot's OWNING segment number (Task 15: real, per-entry -- Task
// 10 hardcoded this to 1, single-segment only).
func app68BuildCode0(jtEntries: list of int, jtSegNums: list of int, belowA5: int): text {
    var out: text
    var jtLen: int
    var i: int

    jtLen = 8 * jtEntries.count
    out = ""
    app68PutLong(out, 32 + jtLen)   // above-A5 size
    app68PutLong(out, belowA5)      // below-A5 size
    app68PutLong(out, jtLen)        // JT length
    app68PutLong(out, 32)           // JT offset from A5 (standard, fixed)
    i = 0
    while i < jtEntries.count {
        app68PutWord(out, jtEntries[i])
        app68PutWord(out, 0x3F3C)
        app68PutWord(out, jtSegNums[i]) // owning segment number (Task 15: real)
        app68PutWord(out, 0xA9F0)
        i = i + 1
    }
    return out
}

// app68BuildCodeN builds one CODE-n resource (n=1..segment count): the
// 4-byte standard-format per-segment header (first JT entry offset in
// bytes -- jtFirstSlot*8, this segment's own CONTIGUOUS slot range start,
// cg68k.cla's cgAssignFinalJtSlots -- then the entry count) followed by
// the segment's own raw code bytes.
func app68BuildCodeN(seg: text, jtFirstSlot: int, jtCount: int): text {
    var out: text

    out = ""
    app68PutWord(out, jtFirstSlot * 8)
    app68PutWord(out, jtCount)
    out.append(seg)
    return out
}

// app68BuildSize builds the 10-byte SIZE(-1) payload: flags word (only
// is32BitCompatible set -- 0x0080; canBackground and MultiFinder-
// awareness both off, see file header comment), then preferred and
// minimum memory size, both 384KB per this task's brief.
func app68BuildSize(): text {
    var out: text

    out = ""
    app68PutWord(out, 0x0080)
    app68PutLong(out, 393216)
    app68PutLong(out, 393216)
    return out
}

// app68BuildResourceFork assembles the full resource fork: 256-byte
// header (16 real bytes + 240 reserved), every resource's data
// (length-prefixed: CODE 0, then CODE 1..codeRes.count, then SIZE -1),
// then the resource map (type list: CODE, SIZE -- always exactly two
// TYPES no matter how many CODE ids there are; ref lists; no name list
// -- every resource here is unnamed). Layout mirrors Retro68's
// ResourceFork.cc::writeFork exactly (see file header comment).
// codeRes[0] is CODE 0 (the A5/JT header); codeRes[1..] are CODE
// 1..codeRes.count-1 (Task 15: one per segment, generalized from Task
// 10's fixed 2-resource/single-segment shape).
func app68BuildResourceFork(codeRes: list of text, sizeRes: text): text {
    var data: text
    var map: text
    var out: text
    var codeOffs: list of int
    var offSize: int
    var i: int
    var numCode: int
    var codeRefListLen: int
    var sizeRefListOff: int
    var nameListOff: int

    numCode = codeRes.count

    data = ""
    codeOffs = app68FreshIntList()
    i = 0
    while i < numCode {
        codeOffs.add(data.length)
        app68PutLong(data, codeRes[i].length)
        data.append(codeRes[i])
        i = i + 1
    }
    offSize = data.length
    app68PutLong(data, sizeRes.length)
    data.append(sizeRes)

    codeRefListLen = numCode * 12
    sizeRefListOff = 18 + codeRefListLen
    nameListOff = 58 + codeRefListLen // = 28(typelist start) + 18(typelist len) + codeRefListLen + 12(size reflist len)

    map = ""
    while map.length < 24 {          // 16-byte header-copy placeholder (zeros,
        map.append(char(0))          // per Retro68's own writeFork -- not a
    }                                 // literal header copy) + 4-byte next-map
                                      // handle + 2-byte file ref + 2-byte attrs
    app68PutWord(map, 28)            // type list offset from map start (fixed:
                                      // 2 header words follow immediately)
    app68PutWord(map, nameListOff)   // name list offset from map start (no
                                      // names, ends right after the ref lists)
    app68PutWord(map, 1)             // type count - 1 (CODE, SIZE)
    map.append("CODE")
    app68PutWord(map, numCode - 1)   // CODE resource count - 1
    app68PutWord(map, 18)            // CODE ref list offset from type-list start
    map.append("SIZE")
    app68PutWord(map, 0)             // SIZE resource count - 1 (id -1)
    app68PutWord(map, sizeRefListOff) // SIZE ref list offset from type-list start
    i = 0
    while i < numCode {
        app68PutWord(map, i)             // CODE id (0, 1, 2, ...)
        app68PutWord(map, 0xFFFF)        // no name
        app68PutLong(map, codeOffs[i])   // attr byte (0) + 3-byte data offset
        app68PutLong(map, 0)             // handle placeholder
        i = i + 1
    }
    app68PutWord(map, -1)            // SIZE id -1
    app68PutWord(map, 0xFFFF)
    app68PutLong(map, offSize)
    app68PutLong(map, 0)

    out = ""
    app68PutLong(out, 256)                     // data offset from fork start
    app68PutLong(out, 256 + data.length)       // map offset from fork start
    app68PutLong(out, data.length)             // data length
    app68PutLong(out, map.length)              // map length
    while out.length < 256 {                   // 240 reserved (system-use) bytes
        out.append(char(0))
    }
    out.append(data)
    out.append(map)
    return out
}

// app68Build is the top-level entry point: builds CODE 0, CODE 1..N (one
// per segment), and SIZE(-1), assembles the resource fork, wraps it in a
// 128-byte MacBinary II header, and pads the whole thing to a multiple
// of 128 bytes. segBytes[s] is segment (s+1)'s raw code bytes;
// jtEntries[i]/jtSegNums[i] is JT slot i's routine offset (within its
// own segment) and owning segment number; segJtFirst[s]/segJtCount[s]
// is segment (s+1)'s own contiguous JT slot range (cg68k.cla's
// cgAssignFinalJtSlots), used for that segment's CODE-(s+1) header.
func app68Build(appName: string(31), creator: string(7), segBytes: list of text, jtEntries: list of int, jtSegNums: list of int, segJtFirst: list of int, segJtCount: list of int, belowA5: int): text {
    var code0: text
    var codeRes: list of text
    var sizeRes: text
    var rsrc: text
    var out: text
    var i: int

    code0 = app68BuildCode0(jtEntries, jtSegNums, belowA5)
    codeRes = app68FreshTextList()
    codeRes.add(code0)
    i = 0
    while i < segBytes.count {
        codeRes.add(app68BuildCodeN(segBytes[i], segJtFirst[i], segJtCount[i]))
        i = i + 1
    }
    sizeRes = app68BuildSize()
    rsrc = app68BuildResourceFork(codeRes, sizeRes)

    out = app68BuildHeader(appName, creator, rsrc.length)
    out.append(rsrc)
    while out.length mod 128 != 0 {
        out.append(char(0))
    }
    return out
}

// app68k.cla: the application image writer -- native-5d Task 10
// (single-segment), generalized to N segments by Task 15. Turns
// cg68k.cla's finished per-segment 68k instruction streams (one
// CODE-resource-worth of bytes each) plus the final JT slot->(offset,
// segment) table (cg68k.cla's cgAssignFinalJtSlots) into a classic Mac
// application file: CODE 0 (the A5-world header + jump table), CODE
// 1..N (one per segment, each wrapped in its own tiny per-segment
// header), SIZE -1 (MultiFinder size info), assembled into a resource
// fork, wrapped in a 128-byte MacBinary II header. The whole thing is
// written with file.writeText -- binary-safe (NUL/CR/255 round-trip
// through it untouched; pinned by testdata/run/lib/binroundtrip.cla), so
// this file never needs to dodge a text-mode byte.
//
// GROUND TRUTH. Every byte offset and field below was cross-checked
// against REAL, WORKING code already in this machine's checkout, not
// against memory of Inside Macintosh:
//   - Resource fork layout (header/data/map/type-list/ref-list, exact
//     offsets and the always-24-then-28-then-... byte math): Retro68's
//     own `ResourceFile::writeFork` (Retro68/ResourceFiles/ResourceFork.cc)
//     -- the SAME code path Retro68 uses to build every .bin this
//     project's own scripts/build-mac.sh has successfully booted in Mini
//     vMac.
//   - CODE 0 / CODE 1 shape (above-A5/below-A5/JT-length/JT-offset longs,
//     the {offset.W,$3F3C,segNum.W,$A9F0} JT entry shape, the CODE 1
//     {firstEntryOffset.W,count.W} header, and -- critically -- that a JT
//     entry's OFFSET FIELD is the routine's raw offset PLUS 4 to skip
//     past CODE 1's own header): Retro68's Elf2Mac
//     (Retro68/Elf2Mac/Object.cc, Object::SingleSegmentApp and
//     Object::MultiSegmentApp, the `if(id==1) offset += 4;` line).
//   - MacBinary II header field offsets and the CRC-16/XMODEM algorithm
//     (poly 0x1021, init 0, MSB-first, computed over bytes 0-123):
//     Retro68/ResourceFiles/ResourceFile.cc's writeMacBinary +
//     Retro68/hfsutils/copyout.c's do_macb (which additionally sets the
//     MacBinary II version bytes 122/123=129 -- writeMacBinary leaves
//     them 0, i.e. MacBinary I-ish; this file follows copyout.c and
//     writes 129/129, the more broadly-compatible, spec-correct choice,
//     and copyin.c's own read-side check `buf[123] > 129 -> unsupported`
//     confirms 129 is a valid, accepted value).
//   - SIZE(-1) flags: this project's own scripts/build-mac.sh /
//     Retro68/libretro/Retro68APPL.r SIZE(-1) resource literal, hand-
//     decoded bit-by-bit against Retro68/InterfacesAndLibraries/
//     Interfaces/RIncludes/Processes.r's `type 'SIZE'` field declaration
//     (16 boolean fields, MSB-first; first name in a `boolean a, b;` pair
//     = 0, second = 1). Only `is32BitCompatible` is set; canBackground
//     and MultiFinder-awareness (`needsActivateOnFGSwitch`, Processes.r's
//     own `notMultiFinderAware` alias) are both off, matching the plain,
//     no-AppleEvents System 6 app this task's own brief calls for.
//     Result: flags = 0x0080.
//
// DETERMINISM. MacBinary mandates a creation/modification date field;
// clarusc has no clock access on this backend (and using one would break
// the double-emit byte-compare determinism test this task requires
// regardless) -- both date longs are the fixed constant 0. A real Finder
// would show this as Jan 1 1904, which is harmless for a compiled test
// binary and not a behavior anything in this codebase depends on.
//
// N SEGMENTS (Task 15). app68Build takes segBytes as a `list of text`:
// segBytes[i] becomes CODE (i+1). The resource map's TYPE list is still
// exactly two types (CODE, SIZE) -- only the CODE type's own resource
// COUNT grows with segBytes.count; app68BuildResourceFork computes every
// map offset (ref-list offsets, name-list offset) from segBytes.count
// rather than the Task-10 hardcoded 2-resource constants.
//
// RESOURCE PARITY (Task 13, native-5e). app68BuildResourceFork is
// generalized further: fully generic (type, id, data) triples (three
// parallel lists -- Clarus has no tuple/record-in-a-list here), grouped
// by type and sorted (types ascending byte-wise, ids ascending within a
// type) to match a REAL Retro68-built resource fork byte-for-byte
// (verified against testdata/mac/resparity's goldens, extracted from
// `scripts/build-mac.sh testdata/ui/{appres,about}.cla`). app68Build's
// own extraTypes/extraIds/extraDatas parameters carry cg68k.cla's
// resource-parity set (ALRT/DITL alerts, About, SIZE(-1), vers, the app
// icon family + BNDL/FREF/signature STR); the specific resource BUILDERS
// (ALRT/DITL bytes, PBM->ICN# decode ported from scripts/pbm2icn.c, etc.)
// live in res68k.cla, kept separate from this file's own image-assembly
// mechanism (policy call, recorded here per the task brief).

// app68FreshIntList/app68FreshTextList hand back genuinely empty lists
// (the same trick cg68k.cla's cgFreshIntList/cgFreshTextList use) -- this
// file's own tiny copies, matching the "no cross-depending on a sibling
// module for small shared helpers" policy already established for
// app68PutByte/Word/Long below (Task 15: app68BuildResourceFork/app68Build
// need a fresh scratch list per call, same reasoning).
func app68FreshIntList(): list of int {
    var l: list of int
    return l
}

func app68FreshTextList(): list of text {
    var l: list of text
    return l
}

func app68FreshStringList(): list of string {
    var l: list of string
    return l
}

// app68PutByte/Word/Long append a raw big-endian value to a binary text
// buffer -- the same technique asm68k.cla's a68PutByte/Word/Long use
// (char() keeps only the low byte; `>>` is arithmetic/sign-propagating,
// so this is correct for negative values too, e.g. a -1 ID or a 0xFFFF
// "no name" marker). Kept as this file's own tiny copies rather than
// reaching into asm68k.cla, matching cg68k.cla's own stated policy of not
// cross-depending on a sibling module for small shared helpers.
func app68PutByte(out: text, b: int) {
    out.append(char(b))
}

func app68PutWord(out: text, w: int) {
    out.append(char(w >> 8))
    out.append(char(w))
}

func app68PutLong(out: text, v: int) {
    app68PutWord(out, v >> 16)
    app68PutWord(out, v)
}

// app68PutFixed appends exactly n bytes taken from s: s's own bytes,
// zero-padded (never truncated by silently overrunning n -- extra bytes
// beyond n are simply never read) if s is shorter than n. Used for the
// creator field, which must occupy exactly 4 bytes of the MacBinary
// header even though the caller-supplied string(7) may be shorter.
func app68PutFixed(out: text, s: string, n: int) {
    var i: int

    i = 0
    while i < n {
        if i < s.length {
            out.append(s[i])
        } else {
            out.append(char(0))
        }
        i = i + 1
    }
}

// app68Crc16 computes CRC-16/XMODEM (poly 0x1021, init 0, MSB-first, no
// reflection, no final XOR) over data, table-free (a plain 8-shifts-per-
// byte bitwise loop -- the Go-subset backend has no static table
// initializer story, and this is only ever run over a 124-byte header, so
// there is no performance case for a table). Verified against the
// standard CRC-16/XMODEM test vector ("123456789" -> 0x31C3) during this
// task's own development; internal/cg68k/image_test.go re-verifies with
// an INDEPENDENT Go implementation, not a port of this one.
func app68Crc16(data: text): int {
    var crc: int
    var i: int
    var j: int
    var b: int

    crc = 0
    i = 0
    while i < data.length {
        b = int(data[i])
        crc = crc ^ (b << 8)
        j = 0
        while j < 8 {
            if (crc & 0x8000) != 0 {
                crc = ((crc << 1) ^ 0x1021) & 0xFFFF
            } else {
                crc = (crc << 1) & 0xFFFF
            }
            j = j + 1
        }
        i = i + 1
    }
    return crc
}

// app68BuildHeader builds the 128-byte MacBinary II header. rsrcLen is
// the RAW (unpadded) resource fork byte length -- the outer 128-byte
// padding of the whole file happens after this header + the resource
// fork are both appended (app68Build), never inside this header's own
// "resource fork length" field.
func app68BuildHeader(appName: string(31), creator: string(7), rsrcLen: int): text {
    var h: text
    var crcVal: int

    h = ""
    app68PutByte(h, 0)                    // 0: version/signature byte
    app68PutByte(h, appName.length)       // 1: Pascal name length
    h.append(appName)
    while h.length < 65 {                 // 2-64: name bytes, zero-padded
        h.append(char(0))
    }
    h.append("APPL")                      // 65-68: file type
    app68PutFixed(h, creator, 4)          // 69-72: creator
    while h.length < 83 {                 // 73: Finder flags hi; 74: reserved;
        h.append(char(0))                 // 75-76/77-78/79-80: icon v/h/folder id;
    }                                     // 81: protected; 82: reserved
    app68PutLong(h, 0)                    // 83-86: data fork length (no data fork)
    app68PutLong(h, rsrcLen)              // 87-90: resource fork length
    app68PutLong(h, 0)                    // 91-94: creation date (fixed, no clock)
    app68PutLong(h, 0)                    // 95-98: modification date (fixed, no clock)
    while h.length < 122 {                // 99-100: comment len; 101: Finder flags lo;
        h.append(char(0))                 // 102-115: unused; 116-119: unpacked len;
    }                                     // 120-121: secondary header len
    app68PutByte(h, 129)                  // 122: MacBinary II version that wrote this
    app68PutByte(h, 129)                  // 123: minimum version needed to read this
    crcVal = app68Crc16(h)                // CRC over bytes 0-123 (h.length == 124 here)
    app68PutWord(h, crcVal)               // 124-125: CRC-16/XMODEM
    app68PutWord(h, 0)                    // 126-127: reserved
    return h
}

// app68BuildCode0 builds the CODE 0 resource: the A5-world header (above-
// A5 size, below-A5 size, JT length, JT offset from A5 -- always 32) plus
// one 8-byte "unloaded" jump-table entry per jtEntries element. jtEntries[i]
// is that JT slot's routine offset FROM THE START OF ITS OWN SEGMENT's
// code (i.e. AFTER that segment's own 4-byte per-segment header, which
// _LoadSeg skips itself -- do NOT add 4 here: Elf2Mac writes its own
// classic entry-point entry as literally `0000 3F3C 0001 A9F0`
// (Object.cc:265) for a routine at code offset 0, and adding 4 lands the
// entry one instruction into the routine -- which is exactly what
// blocked native-5d Task 11's first boot (the app entered startup PAST
// its `LEA -292(A5),A0`, so the below-A5 zero loop ran with a garbage
// A0: globals never zeroed AND 292 bytes of wild writes). Elf2Mac's own
// `offset += 4` (Object.cc:284) applies to its 32-BIT jump table entries
// (`id.W, $A9F0, offset.L`), a different entry format resolved by
// Retro68's runtime rather than the ROM's _LoadSeg); jtSegNums[i] is that
// same slot's OWNING segment number (Task 15: real, per-entry -- Task
// 10 hardcoded this to 1, single-segment only).
func app68BuildCode0(jtEntries: list of int, jtSegNums: list of int, belowA5: int): text {
    var out: text
    var jtLen: int
    var i: int

    jtLen = 8 * jtEntries.count
    out = ""
    app68PutLong(out, 32 + jtLen)   // above-A5 size
    app68PutLong(out, belowA5)      // below-A5 size
    app68PutLong(out, jtLen)        // JT length
    app68PutLong(out, 32)           // JT offset from A5 (standard, fixed)
    i = 0
    while i < jtEntries.count {
        app68PutWord(out, jtEntries[i])
        app68PutWord(out, 0x3F3C)
        app68PutWord(out, jtSegNums[i]) // owning segment number (Task 15: real)
        app68PutWord(out, 0xA9F0)
        i = i + 1
    }
    return out
}

// app68BuildCodeN builds one CODE-n resource (n=1..segment count): the
// 4-byte standard-format per-segment header (first JT entry offset in
// bytes -- jtFirstSlot*8, this segment's own CONTIGUOUS slot range start,
// cg68k.cla's cgAssignFinalJtSlots -- then the entry count) followed by
// the segment's own raw code bytes.
func app68BuildCodeN(seg: text, jtFirstSlot: int, jtCount: int): text {
    var out: text

    out = ""
    app68PutWord(out, jtFirstSlot * 8)
    app68PutWord(out, jtCount)
    out.append(seg)
    return out
}

// app68BuildSize builds the 10-byte SIZE(-1) payload: flags word, then
// preferred and minimum memory size. REVISED, mac-resident-clarusc
// Task 12: both bumped from the original 384KB (native-5d's own brief) to
// 2MB (2097152) -- Task 12's own Snow acceptance boot found a REAL,
// reproducible early hang (frozen desktop, no window ever draws, no
// natInit-created "out" file even appears) on a plain UI program
// (testdata/valid/bounce.cla) at 384KB, root-caused to stack/heap
// headroom: cgEmitFunc's own per-function LINK frame floor is ~8.3KB on
// the CURRENT compiler (cgTmpSlots/cgBigTmpSlots/cgBigTmpSize's fixed
// per-function scratch pools, cg68k.cla's own header comment), and the
// early boot call chain alone (rtUiStartup -> App.launch -> rtUiLaunch ->
// UiLaunchReal -> nat_UiLaunchReal, each its own ~8.3KB+ frame) already
// exhausts a 384KB partition's stack headroom before any Toolbox call
// this task added even runs -- confirmed BOTH ways: reverting every
// mac-resident-clarusc Task 12 source change (clarusc/*.cla AND
// runtime/clarus/ui.cla, byte-for-byte back to this phase's own starting
// commit) still hangs at 384KB once `clarusc/clarusc.c`'s OWN staleness
// (a separate, pre-existing bug this task also found and fixed --
// TestSnapshotFixedPoint was failing at this phase's own starting commit,
// unrelated to and predating this task) is corrected, and bumping the
// partition to 2MB with ZERO other change makes the identical binary boot
// and run cleanly on Snow. 2MB is an empirically-verified, generously
// round choice (not a computed minimum) -- comfortably above the ~8.3KB-
// per-frame floor at any plausible call depth for a program this size,
// same "round, generous, not hand-tuned to the byte" spirit as the
// original 384KB pick. UNCHANGED by hlEventAware (Task 13, native-5e,
// mirrors build-mac.sh's own appres.r *flag word* exactly -- its own
// comment: notHighLevelEventAware -> isHighLevelEventAware is "what makes
// a Clarus build AppleEvent-aware" -- not its memory partition size,
// which is a pure Rez-side tuning choice (1024*1024 there) this native
// writer has no reason to copy byte-for-byte). hlEventAware=false: only
// is32BitCompatible set (0x0080, Task 10's original, still used for a
// non-UI program). hlEventAware=true (Task 13; caller is
// irIsUiProgram() as of mac-resident-clarusc Task 12, was irHasApp before
// -- see cg68ResourceParitySet's own call site comment): is32BitCompatible
// + isHighLevelEventAware (0x0080 | 0x0040 = 0x00C0) -- verified against a
// REAL Retro68 build's own SIZE(-1) bytes for an app-section program
// (testdata/mac/resparity), which is exactly 0x00C0 despite its differing
// size longs, confirming the flag word (and only the flag word) needs to
// match.
func app68BuildSize(hlEventAware: bool): text {
    var out: text
    var flags: int

    flags = 0x0080
    if hlEventAware {
        flags = flags | 0x0040
    }
    out = ""
    app68PutWord(out, flags)
    app68PutLong(out, 2097152)
    app68PutLong(out, 2097152)
    return out
}

// app68TypeIndexOf returns the index of t within types, or -1 -- a tiny
// linear scan (types never holds more than a handful of distinct 4-char
// resource type codes per program), used by app68BuildResourceFork's own
// dedup pass below.
func app68TypeIndexOf(types: list of string, t: string): int {
    var i: int

    i = 0
    while i < types.count {
        if types[i] == t {
            return i
        }
        i = i + 1
    }
    return -1
}

// app68BuildResourceFork assembles the full resource fork: 256-byte
// header (16 real bytes + 240 reserved), every resource's data (length-
// prefixed), then the resource map (type list, ref lists, name list).
// Layout mirrors Retro68's ResourceFork.cc::writeFork exactly (see file
// header comment).
//
// Task 13 (native-5e) generalizes this from Task 10/15's hardcoded
// CODE+SIZE-only shape to a fully generic parallel (type, id, data) list
// -- resTypes[i]/resIds[i]/resDatas[i] describe resource i; Clarus has no
// tuple/record-in-a-list here (app68k.cla's own established convention,
// see codeRes/jtEntries/jtSegNums above), so three parallel lists play
// that role, same as everywhere else in this file.
//
// Task 5 (mac-resident-clarusc) adds a fourth parallel list, resNames:
// resNames[i] == "" means resource i is unnamed (its ref-list entry's
// name-list-offset field is the 0xFFFF sentinel, same as before this
// task); a non-empty resNames[i] gets a Pascal-string entry (length byte
// + bytes) appended to the name list, in the SAME type/id-sorted
// traversal order as the ref lists themselves (Inside Macintosh's own
// resource-map name-list convention), and its ref-list entry's name-list-
// offset field points at that entry's start (offset from name-list
// start, i.e. from map-start + nameListOff). Every EXISTING call site
// passes a same-length all-"" resNames list, so the no-flag output is
// byte-identical to before this task (0xFFFF for every entry, empty name
// list) -- this is a pure generalization, not a behavior change for
// unnamed resources.
//
// ORDERING, verified against a REAL Retro68-built resource fork (Rez +
// Elf2Mac combined, dumped byte-for-byte during this task's own golden
// extraction, testdata/mac/resparity): resources are grouped by TYPE,
// types sorted ascending by their raw 4 bytes (case-sensitive, e.g.
// 'ALRT' < 'BNDL' < 'CODE' < 'DITL' < ... < 'vers' -- uppercase sorts
// before lowercase in ASCII); within a type, resources sort by ID
// ascending. This function computes that grouping/sort itself so callers
// never need to pre-order their resTypes/resIds/resDatas/resNames
// quadruples.
func app68BuildResourceFork(resTypes: list of string, resIds: list of int, resNames: list of string, resDatas: list of text): text {
    var data: text
    var map: text
    var out: text
    var n: int
    var i: int
    var j: int
    var g: int
    var ti: int
    var idx: int
    var tmpS: string
    var tmpI: int
    var uniqTypes: list of string
    var order: list of int      // resTypes-index, grouped by sorted type then id asc
    var typeCount: list of int  // parallel to uniqTypes: how many resources of that type
    var dataOffs: list of int   // parallel to `order`: that resource's data offset
    var group: list of int
    var typeListRegionLen: int
    var refListTotalLen: int
    var running: int
    var nameListOff: int
    var names: text          // name-list bytes, built in ref-list traversal order

    n = resTypes.count

    // 1. distinct types, first-seen order.
    uniqTypes = app68FreshStringList()
    i = 0
    while i < n {
        if app68TypeIndexOf(uniqTypes, resTypes[i]) == -1 {
            uniqTypes.add(resTypes[i])
        }
        i = i + 1
    }

    // 2. sort uniqTypes ascending, byte-wise (insertion sort -- tiny N).
    i = 1
    while i < uniqTypes.count {
        tmpS = uniqTypes[i]
        j = i - 1
        while j >= 0 and uniqTypes[j] > tmpS {
            uniqTypes[j + 1] = uniqTypes[j]
            j = j - 1
        }
        uniqTypes[j + 1] = tmpS
        i = i + 1
    }

    // 3. `order`: for each type in sorted order, the resTypes-indices of
    //    that type, sorted by id ascending (insertion sort per group).
    order = app68FreshIntList()
    typeCount = app68FreshIntList()
    ti = 0
    while ti < uniqTypes.count {
        group = app68FreshIntList()
        i = 0
        while i < n {
            if resTypes[i] == uniqTypes[ti] {
                group.add(i)
            }
            i = i + 1
        }
        g = 1
        while g < group.count {
            tmpI = group[g]
            j = g - 1
            while j >= 0 and resIds[group[j]] > resIds[tmpI] {
                group[j + 1] = group[j]
                j = j - 1
            }
            group[j + 1] = tmpI
            g = g + 1
        }
        typeCount.add(group.count)
        g = 0
        while g < group.count {
            order.add(group[g])
            g = g + 1
        }
        ti = ti + 1
    }

    // data section: length-prefixed resource data, in `order`.
    data = ""
    dataOffs = app68FreshIntList()
    i = 0
    while i < order.count {
        idx = order[i]
        dataOffs.add(data.length)
        app68PutLong(data, resDatas[idx].length)
        data.append(resDatas[idx])
        i = i + 1
    }

    // type list + ref lists. typeListRegionLen is the 2-byte type-count
    // header plus 8 bytes per distinct type (4-byte type + count-1 word +
    // ref-list-offset word); refListTotalLen is every type's own ref list
    // (12 bytes/resource) laid end to end right after that region.
    typeListRegionLen = 2 + uniqTypes.count * 8
    refListTotalLen = order.count * 12
    nameListOff = 28 + typeListRegionLen + refListTotalLen // map-start-relative; name list (possibly empty) starts right after the last ref list

    map = ""
    while map.length < 24 {          // 16-byte header-copy placeholder (zeros,
        map.append(char(0))          // per Retro68's own writeFork -- not a
    }                                 // literal header copy) + 4-byte next-map
                                      // handle + 2-byte file ref + 2-byte attrs
    app68PutWord(map, 28)            // type list offset from map start (fixed:
                                      // 2 header words follow immediately)
    app68PutWord(map, nameListOff)   // name list offset from map start
    app68PutWord(map, uniqTypes.count - 1)

    running = typeListRegionLen
    ti = 0
    while ti < uniqTypes.count {
        map.append(uniqTypes[ti])
        app68PutWord(map, typeCount[ti] - 1)
        app68PutWord(map, running)       // this type's ref list offset from type-list start
        running = running + typeCount[ti] * 12
        ti = ti + 1
    }
    // Ref lists + name list, built together: each entry's name-list-offset
    // field needs to know where (if anywhere) its own name lands, and the
    // name list itself is built in the SAME traversal order (type-sorted
    // then id-sorted) as the ref-list entries that reference it.
    names = ""
    ti = 0
    idx = 0
    while ti < uniqTypes.count {
        i = 0
        while i < typeCount[ti] {
            app68PutWord(map, resIds[order[idx]])
            if resNames[order[idx]] == "" {
                app68PutWord(map, 0xFFFF)    // no name
            } else {
                app68PutWord(map, names.length)
                app68PutByte(names, resNames[order[idx]].length)
                names.append(resNames[order[idx]])
            }
            app68PutLong(map, dataOffs[idx]) // attr byte (0) + 3-byte data offset
            app68PutLong(map, 0)             // handle placeholder
            idx = idx + 1
            i = i + 1
        }
        ti = ti + 1
    }
    map.append(names)

    out = ""
    app68PutLong(out, 256)                     // data offset from fork start
    app68PutLong(out, 256 + data.length)       // map offset from fork start
    app68PutLong(out, data.length)             // data length
    app68PutLong(out, map.length)              // map length
    while out.length < 256 {                   // 240 reserved (system-use) bytes
        out.append(char(0))
    }
    out.append(data)
    out.append(map)
    return out
}

// app68BuildFork is app68Build's own fork-assembly half (mac-resident-
// clarusc Task 9): builds CODE 0, CODE 1..N (one per segment), folds in
// extraTypes/extraIds/extraNames/extraDatas (Task 13: SIZE(-1) always,
// plus whatever resource-parity set cg68WriteImage assembled -- ALRT/DITL/
// vers/icon family/BNDL/FREF/signature STR; Task 5 (mac-resident-clarusc)
// adds extraNames, "" for every Task-13 resource and the baked file's own
// path for any `--bake FILE` CLFS resource), and assembles the raw
// resource fork -- no MacBinary header, no padding. segBytes[s] is segment
// (s+1)'s raw code bytes; jtEntries[i]/jtSegNums[i] is JT slot i's routine
// offset (within its own segment) and owning segment number;
// segJtFirst[s]/segJtCount[s] is segment (s+1)'s own contiguous JT slot
// range (cg68k.cla's cgAssignFinalJtSlots), used for that segment's
// CODE-(s+1) header. Split out of app68Build so a fork-only caller (the
// on-Mac front end, via cg68k.cla's cg68BuildFork/driveEmit68kFork) can
// hand the raw fork straight to `file.writeRes` instead of paying for a
// MacBinary wrap it will immediately strip back off.
func app68BuildFork(segBytes: list of text, jtEntries: list of int, jtSegNums: list of int, segJtFirst: list of int, segJtCount: list of int, belowA5: int, extraTypes: list of string, extraIds: list of int, extraNames: list of string, extraDatas: list of text): text {
    var code0: text
    var codeRes: list of text
    var i: int
    var resTypes: list of string
    var resIds: list of int
    var resNames: list of string
    var resDatas: list of text

    code0 = app68BuildCode0(jtEntries, jtSegNums, belowA5)
    codeRes = app68FreshTextList()
    codeRes.add(code0)
    i = 0
    while i < segBytes.count {
        codeRes.add(app68BuildCodeN(segBytes[i], segJtFirst[i], segJtCount[i]))
        i = i + 1
    }

    resTypes = app68FreshStringList()
    resIds = app68FreshIntList()
    resNames = app68FreshStringList()
    resDatas = app68FreshTextList()
    i = 0
    while i < codeRes.count {
        resTypes.add("CODE")
        resIds.add(i)
        resNames.add("")
        resDatas.add(codeRes[i])
        i = i + 1
    }
    i = 0
    while i < extraTypes.count {
        resTypes.add(extraTypes[i])
        resIds.add(extraIds[i])
        resNames.add(extraNames[i])
        resDatas.add(extraDatas[i])
        i = i + 1
    }

    return app68BuildResourceFork(resTypes, resIds, resNames, resDatas)
}

// app68WrapFork is app68Build's other half: wrap an already-built resource
// fork (app68BuildFork's return, or any equivalent) in a 128-byte
// MacBinary II header and pad the whole thing to a multiple of 128 bytes.
// Split out so both app68Build (below) and cg68k.cla's cg68WriteImageWrap
// (the host `emit68k` tail, after driveEmit68kFork) share one wrap
// implementation instead of two copies drifting apart.
func app68WrapFork(appName: string(31), creator: string(7), fork: text): text {
    var out: text

    out = app68BuildHeader(appName, creator, fork.length)
    out.append(fork)
    while out.length mod 128 != 0 {
        out.append(char(0))
    }
    return out
}

// app68Build is the top-level entry point: app68BuildFork + app68WrapFork
// in sequence -- see each's own doc comment for what it does. Kept as a
// single call for any caller that wants the finished MacBinary image and
// doesn't care about the fork/wrap seam.
func app68Build(appName: string(31), creator: string(7), segBytes: list of text, jtEntries: list of int, jtSegNums: list of int, segJtFirst: list of int, segJtCount: list of int, belowA5: int, extraTypes: list of string, extraIds: list of int, extraNames: list of string, extraDatas: list of text): text {
    return app68WrapFork(appName, creator, app68BuildFork(segBytes, jtEntries, jtSegNums, segJtFirst, segJtCount, belowA5, extraTypes, extraIds, extraNames, extraDatas))
}

include "lib.cla"

// tok.cla: token kinds and the Token record Ñ a port of
// internal/token/token.go. Enum member order matches token.go's Kind
// constants exactly: the operator members (TkAssign..TkTilde) MUST stay
// contiguous and last, because lex.cla's isOperatorKind relies on a single
// int(k) range test over that span (mirroring token.go's
// `k >= token.ASSIGN && k <= token.TILDE`) Ñ Clarus enums only support ==/!=
// directly, so the range test goes through int(k).
enum TokKind {
    TkEOF
    TkNewline
    TkSemi
    TkIdent
    TkInt
    TkFixedLit
    TkCharLit
    TkStringLit

    TkVar
    TkFunc
    TkRecord
    TkEnum
    TkConst
    TkWindow
    TkMenu
    TkExtend
    TkOn
    TkEvery
    TkIf
    TkElse
    TkWhile
    TkFor
    TkIn
    TkTo
    TkReturn
    TkAnd
    TkOr
    TkNot
    TkTrue
    TkFalse
    TkNil
    TkOpen
    TkClose
    TkEdit
    TkNew
    TkQuit
    TkCancel
    TkSwitch
    TkCase
    TkBreak
    TkContinue

    TkLParen
    TkRParen
    TkLBrace
    TkRBrace
    TkLBracket
    TkRBracket
    TkComma
    TkColon
    TkDot

    TkAssign
    TkEq
    TkNe
    TkLt
    TkLe
    TkGt
    TkGe
    TkPlus
    TkMinus
    TkStar
    TkSlash
    TkShl
    TkShr
    TkAmp
    TkPipe
    TkCaret
    TkTilde
}

// Token mirrors token.Token, minus its Text/Pos fields: nameIdx holds the
// interned identifier/string/char text (IDENT, STRINGLIT, CHARLIT); intVal
// holds INT's and CHARLIT's numeric value; fixVal holds FIXEDLIT's raw
// 16.16 value; line/col replace Go's lazily-computed source.Pos (the
// Clarus lexer tracks line/col incrementally as it scans Ñ see lex.cla).
// Fields unused by a given kind are left at zero.
record Token {
    kind: TokKind
    nameIdx: int
    intVal: int
    fixVal: int
    line: int
    col: int
}

// Keyword name indices, pre-interned once and cached in module globals
// so keywordKind is 33 int compares per call instead of 33 intern() calls
// (each a map lookup + string compare). NOT plain global initializers
// (`var kwVar: int = intern("var")`) -- this compiler's C backend does
// not forward-declare arbitrary functions called from global-initializer
// expressions (cprint.cla's cpEmitDefaultInitFnProtos is a small,
// deliberately closed whitelist for cpDefaultInit's own zero-value
// construction, not a general mechanism), so that form fails to compile
// with -Wimplicit-function-declaration: clar_init_globals calls
// clar_fn_intern before its prototype is emitted. Guarding the intern()
// calls behind kwInited and running them from kwInit's ordinary function
// body sidesteps that entirely -- ordinary function bodies are only
// emitted after every function's own forward-declared prototype, so
// intern() is always visible there. Net effect is the same: one-time
// cost, then cheap int compares for the rest of the process lifetime.
var kwInited: bool
var kwVar: int
var kwFunc: int
var kwRecord: int
var kwEnum: int
var kwConst: int
var kwWindow: int
var kwMenu: int
var kwExtend: int
var kwOn: int
var kwEvery: int
var kwIf: int
var kwElse: int
var kwWhile: int
var kwFor: int
var kwIn: int
var kwTo: int
var kwReturn: int
var kwAnd: int
var kwOr: int
var kwNot: int
var kwTrue: int
var kwFalse: int
var kwNil: int
var kwOpen: int
var kwClose: int
var kwEdit: int
var kwNew: int
var kwQuit: int
var kwCancel: int
var kwSwitch: int
var kwCase: int
var kwBreak: int
var kwContinue: int

// kwInit interns all 33 keyword names exactly once, on keywordKind's
// first call. Idempotent (kwInited guards re-entry).
func kwInit() {
    if kwInited { return }
    kwInited = true
    kwVar = intern("var")
    kwFunc = intern("func")
    kwRecord = intern("record")
    kwEnum = intern("enum")
    kwConst = intern("const")
    kwWindow = intern("window")
    kwMenu = intern("menu")
    kwExtend = intern("extend")
    kwOn = intern("on")
    kwEvery = intern("every")
    kwIf = intern("if")
    kwElse = intern("else")
    kwWhile = intern("while")
    kwFor = intern("for")
    kwIn = intern("in")
    kwTo = intern("to")
    kwReturn = intern("return")
    kwAnd = intern("and")
    kwOr = intern("or")
    kwNot = intern("not")
    kwTrue = intern("true")
    kwFalse = intern("false")
    kwNil = intern("nil")
    kwOpen = intern("open")
    kwClose = intern("close")
    kwEdit = intern("edit")
    kwNew = intern("new")
    kwQuit = intern("quit")
    kwCancel = intern("cancel")
    kwSwitch = intern("switch")
    kwCase = intern("case")
    kwBreak = intern("break")
    kwContinue = intern("continue")
}

// keywordKind maps nameIdx (the interned index of an identifier's text) to
// its keyword TokKind, or TkIdent Ñ the sentinel meaning "not a keyword,
// this is an ordinary identifier". Mirrors token.Keywords.
func keywordKind(nameIdx: int): TokKind {
    kwInit()
    if nameIdx == kwVar { return TkVar }
    if nameIdx == kwFunc { return TkFunc }
    if nameIdx == kwRecord { return TkRecord }
    if nameIdx == kwEnum { return TkEnum }
    if nameIdx == kwConst { return TkConst }
    if nameIdx == kwWindow { return TkWindow }
    if nameIdx == kwMenu { return TkMenu }
    if nameIdx == kwExtend { return TkExtend }
    if nameIdx == kwOn { return TkOn }
    if nameIdx == kwEvery { return TkEvery }
    if nameIdx == kwIf { return TkIf }
    if nameIdx == kwElse { return TkElse }
    if nameIdx == kwWhile { return TkWhile }
    if nameIdx == kwFor { return TkFor }
    if nameIdx == kwIn { return TkIn }
    if nameIdx == kwTo { return TkTo }
    if nameIdx == kwReturn { return TkReturn }
    if nameIdx == kwAnd { return TkAnd }
    if nameIdx == kwOr { return TkOr }
    if nameIdx == kwNot { return TkNot }
    if nameIdx == kwTrue { return TkTrue }
    if nameIdx == kwFalse { return TkFalse }
    if nameIdx == kwNil { return TkNil }
    if nameIdx == kwOpen { return TkOpen }
    if nameIdx == kwClose { return TkClose }
    if nameIdx == kwEdit { return TkEdit }
    if nameIdx == kwNew { return TkNew }
    if nameIdx == kwQuit { return TkQuit }
    if nameIdx == kwCancel { return TkCancel }
    if nameIdx == kwSwitch { return TkSwitch }
    if nameIdx == kwCase { return TkCase }
    if nameIdx == kwBreak { return TkBreak }
    if nameIdx == kwContinue { return TkContinue }
    return TkIdent
}

// tokKindName renders a short debug name for k, e.g. for lex_test.cla's
// golden output. This is a display helper for clarusc's own tests, NOT a
// port of Go's Kind.String() Ñ that table's quoted diagnostic forms
// ("'if'", "identifier", "';'", ...) belong to the parser's error messages
// (Task 7) and are deferred to that task.
func tokKindName(k: TokKind): string {
    switch k {
    case TkEOF { return "EOF" }
    case TkNewline { return "NEWLINE" }
    case TkSemi { return "SEMI" }
    case TkIdent { return "IDENT" }
    case TkInt { return "INT" }
    case TkFixedLit { return "FIXEDLIT" }
    case TkCharLit { return "CHARLIT" }
    case TkStringLit { return "STRINGLIT" }
    case TkVar { return "KwVar" }
    case TkFunc { return "KwFunc" }
    case TkRecord { return "KwRecord" }
    case TkEnum { return "KwEnum" }
    case TkConst { return "KwConst" }
    case TkWindow { return "KwWindow" }
    case TkMenu { return "KwMenu" }
    case TkExtend { return "KwExtend" }
    case TkOn { return "KwOn" }
    case TkEvery { return "KwEvery" }
    case TkIf { return "KwIf" }
    case TkElse { return "KwElse" }
    case TkWhile { return "KwWhile" }
    case TkFor { return "KwFor" }
    case TkIn { return "KwIn" }
    case TkTo { return "KwTo" }
    case TkReturn { return "KwReturn" }
    case TkAnd { return "KwAnd" }
    case TkOr { return "KwOr" }
    case TkNot { return "KwNot" }
    case TkTrue { return "KwTrue" }
    case TkFalse { return "KwFalse" }
    case TkNil { return "KwNil" }
    case TkOpen { return "KwOpen" }
    case TkClose { return "KwClose" }
    case TkEdit { return "KwEdit" }
    case TkNew { return "KwNew" }
    case TkQuit { return "KwQuit" }
    case TkCancel { return "KwCancel" }
    case TkSwitch { return "KwSwitch" }
    case TkCase { return "KwCase" }
    case TkBreak { return "KwBreak" }
    case TkContinue { return "KwContinue" }
    case TkLParen { return "LPAREN" }
    case TkRParen { return "RPAREN" }
    case TkLBrace { return "LBRACE" }
    case TkRBrace { return "RBRACE" }
    case TkLBracket { return "LBRACKET" }
    case TkRBracket { return "RBRACKET" }
    case TkComma { return "COMMA" }
    case TkColon { return "COLON" }
    case TkDot { return "DOT" }
    case TkAssign { return "ASSIGN" }
    case TkEq { return "EQ" }
    case TkNe { return "NE" }
    case TkLt { return "LT" }
    case TkLe { return "LE" }
    case TkGt { return "GT" }
    case TkGe { return "GE" }
    case TkPlus { return "PLUS" }
    case TkMinus { return "MINUS" }
    case TkStar { return "STAR" }
    case TkSlash { return "SLASH" }
    case TkShl { return "SHL" }
    case TkShr { return "SHR" }
    case TkAmp { return "AMP" }
    case TkPipe { return "PIPE" }
    case TkCaret { return "CARET" }
    case TkTilde { return "TILDE" }
    }
    return "?"
}

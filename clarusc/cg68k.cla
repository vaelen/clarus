// cgIntrMapGetDv mirrors fpIntrCall's IMapGetDv/IMapGetDvBirth arms
// (cprint.cla:2201-2306): dv pre-fills the result slot; rtMapGetDv leaves
// it untouched on a miss (its own bool return is ignored here, same as
// the C reference -- absence/presence is read back by COMPARING the
// result slot against dv's own stashed value, not from the call's return).
// Non-birth (isBirth=false, IMapGetDv): dv is NOT independently owned (some
// OTHER slot already owns it), so the result ALWAYS gets its own +1,
// unconditionally, and dv itself is never released. Birth (isBirth=true,
// IMapGetDvBirth): dv IS independently owned (a fresh construction with no
// other owner) -- absent (result slot still equals dv) means dv's own +1
// simply became the result's, no extra retain; present means the result
// aliases the map's OWN value (needs its own +1) AND dv's original box is
// now orphaned (must be released here, or it leaks) -- ARC Task 8's fix
// for both directions of that exact bug, mirrored exactly.
// map-hashtable phase Task 2: `sorted` selects which runtime family's
// GetDv this calls -- parameterized rather than duplicated (see
// cgMapReleaseGuard's own doc comment). Findings 1.4 (Task 13): bool +
// pre-interned rn* globals, same as cgIntrMapSet above.
func cgIntrMapGetDv(e: int, isBirth: bool, sorted: bool): int {
    var a0e: int
    var a1e: int
    var a2e: int
    var elemT: int
    var mOff: int
    var dvOff: int
    var off: int
    var k: IRKind
    var skipLbl: int
    var nameIdx: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    a2e = irExprNext(a1e)
    elemT = irExprType(e)
    k = irtKind(elemT)
    mOff = cgAllocTmpOff(irPtrT)
    cgExpr(a0e)
    cgStoreD0At(6, mOff, irPtrT)

    dvOff = cgAllocTmpOff(elemT)
    cgStoreElemAt(dvOff, elemT, a2e)
    if cgLastTrackedOff != -1 {
        // fpHandoff(dv): dv's own temp (if any) is about to alias into
        // the result -- untrack it, this arm's own retain/release logic
        // below is the only ownership bookkeeping dv gets from here on.
        cgHandoff(cgLastTrackedOff)
    }

    if cgIsHandleKind(k) {
        off = cgNewTrackedTmp(elemT)
    } else {
        off = cgAllocTmpOff(elemT)
    }
    cgCopyScratch(dvOff, off, elemT)

    a68Emit(OpMove, 4, AmDisp16, 6, mOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(a1e)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmDisp16, 6, off, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    nameIdx = rnMapGetDv
    if sorted {
        nameIdx = rnSortedMapGetDv
    }
    cgJsrByName(nameIdx)
    cgCleanupStack(12)

    if cgIsHandleKind(k) {
        if isBirth {
            a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
            a68Emit(OpMove, 4, AmDisp16, 6, dvOff, AmDn, 1, 0)
            a68Emit(OpCmp, 4, AmDn, 1, 0, AmDn, 0, 0)
            skipLbl = a68NewLabel()
            a68EmitBr(OpBcc, 7, skipLbl) // BEQ: off==dvOff -> unchanged, skip
            cgRetainAt(6, off, elemT)
            cgReleaseAt(6, dvOff, elemT)
            a68Bind(skipLbl)
        } else {
            cgRetainAt(6, off, elemT)
        }
        cgLastTrackedOff = off
    }
    if cgSizeOf(elemT) <= 4 {
        cgIntrLoadScratch(off, elemT)
    }
    return off
}

// cgIntrMapRemove mirrors fpIntrCall's IMapRemove arm (cprint.cla:
// 2313-2329): releases whatever k currently holds (the SAME

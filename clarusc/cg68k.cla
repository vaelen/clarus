}

// cgIntr4 (native-gaps-cleanup Task 2): cgIntr3's 4-arg sibling --
// file_write_text now carries type/creator (both by-address Str255s)
// after path/text.
func cgIntr4(e: int, nameIdx: int, addr0: bool, addr1: bool, addr2: bool, addr3: bool) {
    var a0e: int
    var a1e: int
    var a2e: int
    var a3e: int
    var args: list of int
    var addrs: list of bool

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    a2e = irExprNext(a1e)
    a3e = irExprNext(a2e)
    args = cgFreshIntList()
    args.add(a0e)
    args.add(a1e)
    args.add(a2e)
    args.add(a3e)
    addrs = cgFreshBoolList()
    addrs.add(addr0)
    addrs.add(addr1)
    addrs.add(addr2)
    addrs.add(addr3)
    if not cgCallRuntime(nameIdx, args, addrs) {
        abort("cg68k: cgIntr4: runtime call failed")
    }
}

// cgFillTightScratchFromPaddedArr/cgDrainTightScratchToPaddedArr (Task 16
// fix, 2026-08-01) originally adapted between a `char[N]` local's own
// cg68k layout -- each element padded to 2 bytes (cgSlotSizeOf) -- and the
// TIGHT (1-byte-per-element) buffer contract runtime/clarus/str.cla's
// rtStrToBytes/rtStrFromBytes/rtTextToBytes/rtTextFromBytes share with
// cprint's C backend, where `char[N]` really IS tight. Calling those
// functions directly against a native char[] local's own PADDED address
// used to silently touch only every OTHER element (found by Task 16's end
// gate: strings.cla's `buf[3] = 'z'` after `packed.toBytes(buf)` produced
// "ABCDEFzH" instead of "ABCzEFGH").
//
// runtime-ir-bake Task 6 fix round 2 (2026-08-13) traced a real-hardware
// string-corruption bug to this same pair: `cgArrElemStride`
// (toolbox-integration Task 6, 2026-08-04) had since made a `char[N]`
// ARRAY's own element spacing tight too (a DIFFERENT fix, for extern-record
// storage needing contiguous bytes), so the scratch-buffer indirection's
// hardcoded stride-2 walk of `arrExpr` was reading every other byte of an
// already-tight source -- reintroducing Task 16's exact bug on the OTHER
// side of the mismatch. That fix round corrected the stride but left the
// scratch buffer itself in place, noting the whole indirection was now a
// tight-to-tight copy with nothing left to bridge.
//
// fallback-trigger-narrowing Task 4 (housekeeping, 2026-08-13) removed
// the indirection for three of the four intrinsics: cgIntrStrFromBytes/
// cgIntrStrToBytes/cgIntrTextToBytes now pass the array argument's own
// address (cgExprAddr) straight to rtStrFromBytes/rtStrToBytes/
// rtTextToBytes as the source or destination buffer, so the runtime call
// reads/writes the array's own storage directly with no scratch copy at
// all -- safe because each of those three runtime functions does its
// BlockMove immediately, with NO allocating call in between the buffer
// address being taken and the copy running (verified against
// runtime/clarus/str.cla's rtStrFromBytes/rtStrToBytes and
// runtime/clarus/text.cla's rtTextToBytes, each read line by line before
// removing its own scratch step). Not exercised by any testdata/cg68k or
// testdata/emitui golden (grepped clean beforehand), so this is invisible
// to the T1 golden gate; functional coverage is testsuite/toolbox/
// cases_resources.cla's `.toBytes()`/`buf[i]` round trip and testsuite/
// core/cases_ser.cla (native T2 lane) plus internal/selfhost's
// testdata/run/lib/strings.cla behavior fixture -- NEITHER native fixture
// exercises a heap-resident (list-element) array, only locals/globals, so
// they don't independently prove the claim below for that case.
//
// cgIntrTextFromBytes keeps the scratch fill (final-review fix wave,
// same day): rtTextFromBytes (runtime/clarus/text.cla:537-556) calls
// rtTextGrow(t, n) -- which can SetHandleSize/allocate, and classic Mac
// OS heap compaction can relocate OTHER unlocked handles during that
// call -- BEFORE TextBlockMoveData(buf, mp, n) reads through `buf`. If
// `a1e` resolves through cgFieldRefAddr/cgIndexRefAddr into a list
// element's own backing Handle (cgForListStmt's own doc comment above,
// ~line 10648, already documents that store as relocatable), a direct
// `buf = cgExprAddr(a1e)` taken before the call can go stale by the time
// TextBlockMoveData uses it -- the exact stale-pointer-across-compaction
// bug class the runtime-ir-bake phase's own T2 blocker found FIVE
// separate live instances of (HISTORY `runtime-ir-bake` entry, "T2
// blocker" subsection); a comment-only fix was rejected as
// under-defending against a repeat. The A6-relative scratch buffer this
// function fills BEFORE the call is not itself relocatable (ordinary
// stack storage), so `mp`'s write target is the only thing that can move,
// and TextBlockMoveData's own `buf` source stays valid throughout.
// cgIntrStrFromBytes does NOT need this: rtStrFromBytes has no allocating
// call of any kind between entry and its own StrBlockMoveData.

// cgFillTightScratchFromPaddedArr unrolls a compile-time-bounded copy (N
// is always a compile-time constant, same cgArrDefaultAt precedent) of
// arrExpr's own N tightly-packed char elements into a scratchOff(A6) byte
// buffer, one element per iteration -- ahead of rtTextFromBytes's own
// allocating rtTextGrow call, so the buffer TextBlockMoveData reads from
// is never a relocatable address (see the block comment above). The ONLY
// remaining caller is cgIntrTextFromBytes; the other three fromBytes/
// toBytes intrinsics pass their array argument's address directly.
func cgFillTightScratchFromPaddedArr(arrExpr: int, scratchOff: int, n: int) {
    var i: int

    cgExprAddr(arrExpr)
    a68Emit(OpMovea, 4, AmAn, 0, 0, AmAn, 1, 0)
    a68Emit(OpLea, 0, AmDisp16, 6, scratchOff, AmAn, 0, 0)
    i = 0
    while i < n {
        a68Emit(OpMove, 1, AmInd, 1, 0, AmPostInc, 0, 0)
        a68Emit(OpAdda, 4, AmImm, 0, 1, AmAn, 1, 0)
        i = i + 1
    }
}

// cgIntrStrFromBytes/cgIntrStrToBytes/cgIntrTextFromBytes/cgIntrTextToBytes
// mirror fpIntrCall's own IStrFromBytes/IStrToBytes/ITextFromBytes/
// ITextToBytes arms: the arr-typed argument's own compile-time capacity
// (irtN(irExprType(...))) becomes a synthetic int-const argument (the SAME
// newIRIntConst-wrapping trick cgEmitStoreStr's own generic str-store tail
// already uses) -- native arrays have no cprint-style `.e` field indirection
// (a KArr VALUE already IS its raw N elements, file header's own "LAYOUT
// AUTHORITY" note), so cgExprAddr(arrExpr) already gives the buffer's own
// address directly.
func cgIntrStrFromBytes(e: int) {
    var a0e: int
    var a1e: int
    var a2e: int
    var n: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    a2e = irExprNext(a1e)
    n = irtN(irExprType(a1e))

    cgExprAddr(a0e)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, irtN(irExprType(a0e)), AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(a1e)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, n, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a2e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnStrFromBytes)
    cgCleanupStack(20)
}

func cgIntrStrToBytes(e: int) {
    var a0e: int
    var a1e: int
    var n: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    n = irtN(irExprType(a1e))

    cgExprAddr(a0e)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(a1e)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, n, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnStrToBytes)
    cgCleanupStack(12)
}

func cgIntrTextFromBytes(e: int) {
    var a0e: int
    var a1e: int
    var a2e: int
    var n: int
    var scratchOff: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    a2e = irExprNext(a1e)
    n = irtN(irExprType(a1e))
    scratchOff = cgAllocBigTmpOff(irStrType(n))
    cgFillTightScratchFromPaddedArr(a1e, scratchOff, n)

    cgExpr(a0e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmDisp16, 6, scratchOff, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, n, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a2e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnTextFromBytes)
    cgCleanupStack(16)
}

func cgIntrTextToBytes(e: int) {
    var a0e: int
    var a1e: int
    var n: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    n = irtN(irExprType(a1e))

    cgExpr(a0e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(a1e)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, n, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnTextToBytes)
    cgCleanupStack(12)
}

// cgIntrTextCmp mirrors fpTextCmp's own 3-way dispatch (cprint.cla:
// 1308-1331) EXACTLY: Text/Text and Text/Str both call rtTextCmp(Str)
// directly; the remaining Str/Text combo (the ONLY other one
// lowComparison ever produces, per fpTextCmp's own doc comment) negates
// rtTextCmpStr(b, a) instead of porting a THIRD comparator.
func cgIntrTextCmp(e: int) {
    var a0e: int
    var a1e: int
    var aKind: IRKind
    var bKind: IRKind
    var args: list of int
    var addrs: list of bool

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    aKind = irtKind(irExprType(a0e))
    bKind = irtKind(irExprType(a1e))
    if aKind == KText and bKind == KText {
        args = cgFreshIntList()
        args.add(a0e)
        args.add(a1e)
        addrs = cgFreshBoolList()
        addrs.add(false)
        addrs.add(false)
        if not cgCallRuntime(rnTextCmp, args, addrs) {
            abort("cg68k: cgIntrTextCmp: rtTextCmp call failed")
        }
        return
    }
    if aKind == KText and bKind == KStr {
        args = cgFreshIntList()
        args.add(a0e)
        args.add(a1e)
        addrs = cgFreshBoolList()
        addrs.add(false)
        addrs.add(true)
        if not cgCallRuntime(rnTextCmpStr, args, addrs) {
            abort("cg68k: cgIntrTextCmp: rtTextCmpStr call failed")
        }
        return
    }
    args = cgFreshIntList()
    args.add(a1e)
    args.add(a0e)
    addrs = cgFreshBoolList()
    addrs.add(false)
    addrs.add(true)
    if not cgCallRuntime(rnTextCmpStr, args, addrs) {
        abort("cg68k: cgIntrTextCmp: rtTextCmpStr call failed")
    }
    a68Emit(OpNegInsn, 4, AmNone, 0, 0, AmDn, 0, 0)
}

// cgIntrTextConcat/cgIntrTextConcatSl/cgIntrTextOfStr all mirror
// fpTextConcat/ITextConcatSL/ITextOfStr's own "birth a fresh rt_text
// handle, then fill it" shape (cprint.cla:1341-1363, :1739-1753,
// :1839-1855): a NEW tracked temp (Text is always the freshly-owned
// result of one of these three) -- cgLastTrackedOff is set as the LAST
// step, so a caller evaluating this as an SAssign/SReturn source can hand
// it off. `dst` is pushed BY VALUE (the already-allocated handle
// POINTER, not its address) at every one of these three call sites --
// rtTextConcat/rtTextConcatSl/rtTextStore all take their own destination
// as a plain `ptr` param, matching how any OTHER text-mutating function
// (rtTextAppendStr et al.) receives its own handle argument.
func cgIntrTextConcat(e: int) {
    var a0e: int
    var a1e: int
    var off: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    off = cgNewTrackedTmp(irTextT)
    cgJsrByName(rnTextNew)
    cgStoreD0At(6, off, irTextT)

    a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a0e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    if irtKind(irExprType(a1e)) == KStr {
        cgExprAddr(a1e)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        a68Emit(OpClr, 4, AmNone, 0, 0, AmPreDec, 7, 0)
    } else {
        a68Emit(OpClr, 4, AmNone, 0, 0, AmPreDec, 7, 0)
        cgExpr(a1e)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    }
    cgJsrByName(rnTextConcat)
    cgCleanupStack(16)
    cgLastTrackedOff = off
    a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
}

func cgIntrTextConcatSl(e: int) {
    var a0e: int
    var a1e: int
    var off: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    off = cgNewTrackedTmp(irTextT)
    cgJsrByName(rnTextNew)
    cgStoreD0At(6, off, irTextT)

    a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(a0e)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a1e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnTextConcatSl)
    cgCleanupStack(12)
    cgLastTrackedOff = off
    a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
}

func cgIntrTextOfStr(e: int) {
    var a0e: int
    var off: int

    a0e = irIntrArgsHead(e)
    off = cgNewTrackedTmp(irTextT)
    cgJsrByName(rnTextNew)
    cgStoreD0At(6, off, irTextT)

    a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(a0e)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnTextStore)
    cgCleanupStack(8)
    cgLastTrackedOff = off
    a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
}

// cgIntrTextTextAt (clir-load-perf Task 3) mirrors cgIntrTextConcat/
// cgIntrTextConcatSl's own dst-allocation dance -- rtTextTextAt(dst: ptr,
// t: ptr, pos: int, n: int) is a VOID function (Task 2's corrected
// signature) that fills a caller-allocated dst in place, the same
// dst-out-param convention rtTextConcat uses, NOT a `: string`-shaped
// hidden-pointer return (that's ITextStringAt's own shape, wired at
// cgEmitStoreStr/cgEmitReturnStr instead). All four args (dst, t, pos, n)
// push BY VALUE, in declaration order -- no addr/KStr branching needed,
// unlike cgIntrTextConcat's Str-vs-Text operand split.
func cgIntrTextTextAt(e: int) {
    var a0e: int
    var a1e: int
    var a2e: int
    var off: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    a2e = irExprNext(a1e)
    off = cgNewTrackedTmp(irTextT)
    cgJsrByName(rnTextNew)
    cgStoreD0At(6, off, irTextT)

    a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a0e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a1e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a2e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnTextTextAt)
    cgCleanupStack(16)
    cgLastTrackedOff = off
    a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
}

// cgIntrLoadScratch loads off(A6)'s value into D0, zero-extending a 1-byte
// bool/char slot exactly like cgLoadVar -- the common tail every List/Map
// value-returning arm below ends with (cgExpr's own "leaves the value in
// D0" postcondition).
func cgIntrLoadScratch(off: int, t: int) {
    if cgSizeOf(t) == 1 {
        a68Emit(OpClr, 4, AmNone, 0, 0, AmDn, 0, 0)
        a68Emit(OpMove, 1, AmDisp16, 6, off, AmDn, 0, 0)
    } else {
        a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
    }
}

// cgCopyScratch copies t's own bytes from one A6-relative slot to another
// (IMapGetDvBirth's own "pre-fill with the default" step, mirroring
// fpIntrCall's `fpEmit(t + " = " + dv + ";")`).
func cgCopyScratch(srcOff: int, dstOff: int, t: int) {
    var sz: int

    sz = cgSizeOf(t)
    if sz == 1 {
        a68Emit(OpMove, 1, AmDisp16, 6, srcOff, AmDn, 0, 0)
        a68Emit(OpMove, 1, AmDn, 0, 0, AmDisp16, 6, dstOff)
    } else if sz <= 4 {
        a68Emit(OpMove, 4, AmDisp16, 6, srcOff, AmDn, 0, 0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmDisp16, 6, dstOff)
    } else {
        // Task 14.7: a KStr/KRec scratch (IMapGetDvBirth's pre-fill,
        // dvOff -> off) needs a real block copy -- the two 4-byte MOVEs
        // above only moved a pointer-sized value. cgBlockCopy's own
        // convention: A0 = source, A1 = dest (cgEmitStoreRec's generic
        // tail establishes it the same way).
        a68Emit(OpLea, 0, AmDisp16, 6, srcOff, AmAn, 0, 0)
        a68Emit(OpLea, 0, AmDisp16, 6, dstOff, AmAn, 1, 0)
        cgBlockCopy(sz)
    }
}

// cgStoreElemAt (Task 14.7) stores e's value into a list/map element
// scratch slot (off(A6)) -- the shared tail every container push/set/
// get-default arm below uses for its VALUE argument. A scalar-kind
// element (everything this file supported through Task 13) evaluates via
// cgExpr+cgStoreD0At exactly as before (unchanged behavior); a KStr/KRec
// element (`list of string`/`map of string`/small record, Task 14.7)
// can't pass through D0 at all, so it routes through cgVarRefAt +
// cgEmitStoreStr/cgEmitStoreRec instead -- the same materialization
// cgMaterializeToTemp uses, just targeting an ALREADY-allocated slot
// (the caller needs scratchOff itself, separately, for the runtime call's
// own out/in-param LEA) rather than allocating its own.
func cgStoreElemAt(off: int, t: int, e: int) {
    var dst: int

    if irtKind(t) == KRec {
        dst = cgVarRefAt(off, t)
        cgEmitStoreRec(dst, e)
    } else if irtKind(t) == KStr {
        dst = cgVarRefAt(off, t)
        cgEmitStoreStr(dst, e)
    } else {
        cgExpr(e)
        cgStoreD0At(6, off, t)
    }
}

// cgCopyScratchToDst (Task 14.7) block-copies a scratch slot's bytes
// (off(A6), already filled by a runtime out-param call -- cgIntrListPopLike
// et al.) into dst's own address -- the shared tail cgEmitStoreStr's
// list/map read-family arms use, mirroring cgEmitStoreRec's own generic
// addressable-source block-copy tail (src's address stashed across dst's
// own address computation, same clobber-avoidance discipline).
func cgCopyScratchToDst(off: int, dst: int, sz: int) {
    a68Emit(OpLea, 0, AmDisp16, 6, off, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(dst)
    a68Emit(OpMovea, 4, AmAn, 0, 0, AmAn, 1, 0)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 0, 0)
    cgBlockCopy(sz)
}

// cgIntrListPushLike mirrors fpIntrCall's IListPush(Retain)/
// IListUnshift(Retain) arm (cprint.cla:1872-1917): the pushed value is
// materialized into its OWN scratch slot BEFORE the call (fpCopyToTemp's
// own realloc-safety reasoning -- push/unshift can grow l's backing
// store, so the source must never be a raw interior pointer INTO that
// same store), retained first when non-birth (the *Retain name), THEN
// pushed. l is evaluated first and stashed across v's own evaluation
// (real-stack push, same ordering fpIntrCall's own `l = fpExpr(a0); v =
// fpCopyToTemp(a1)` establishes) -- SAFE to leave on the stack as the
// call's own first argument: nothing else needs to push/pop in between.
func cgIntrListPushLike(e: int, nm: string) {
    var a0e: int
    var a1e: int
    var elemT: int
    var scratchOff: int
    var nameIdx: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    elemT = irtElem(irExprType(a0e))
    cgExpr(a0e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    scratchOff = cgAllocTmpOff(elemT)
    cgStoreElemAt(scratchOff, elemT, a1e)
    if cgLastTrackedOff != -1 {
        cgHandoff(cgLastTrackedOff)
    }
    if nm == "list_push_retain" or nm == "list_unshift_retain" {
        cgRetainAt(6, scratchOff, elemT)
    }
    a68Emit(OpLea, 0, AmDisp16, 6, scratchOff, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    nameIdx = rnListPush
    if nm == "list_unshift" or nm == "list_unshift_retain" {
        nameIdx = rnListUnshift
    }
    cgJsrByName(nameIdx)
    cgCleanupStack(8)
}

// cgIntrListPopLike mirrors fpIntrCall's IListPop/IListShift arm
// (cprint.cla:1918-1972): pop/shift TRANSFER ownership -- no retain, and
// the result is normally left UNTRACKED (the caller, if any, decides what
// to do with it -- SAssign's own cgLastTrackedOff check never fires for
// pop/shift, matching fpHandoff's unconditional untrack there) EXCEPT the
// one ARC Task 8 review shape: a bare discarded `lst.pop();` statement,
// detected via cgDiscardExprIdx (cgStmt's own SExprStmt case), whose
// result would otherwise leak with nothing left to release it -- that ONE
// case routes through cgNewTrackedTmp instead, so the ordinary
// end-of-statement flush (cgFreeStmtTmps) catches it.
// Returns the scratch offset the result was written to (Task 14.7): a
// scalar-kind elemT also gets the ordinary D0 load (cgIntrLoadScratch,
// this func's own historical void contract, every existing value-context
// call site relies on that D0 side effect and simply discards the return
// -- legal, Ch3's own "a function call... may appear on its own as a
// statement; any return value is discarded"); a KStr/KRec elemT (can't
// fit D0) skips the load -- cgEmitStoreStr's own "list_pop"/"list_shift"
// arm is the only caller that needs the offset for that case.
func cgIntrListPopLike(e: int, nm: string): int {
    var a0e: int
    var elemT: int
    var off: int
    var nameIdx: int

    a0e = irIntrArgsHead(e)
    elemT = irExprType(e)
    cgExpr(a0e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    if e == cgDiscardExprIdx and cgNeedsRelease(elemT) {
        off = cgNewTrackedTmp(elemT)
    } else {
        off = cgAllocTmpOff(elemT)
    }
    a68Emit(OpLea, 0, AmDisp16, 6, off, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    nameIdx = rnListPop
    if nm == "list_shift" {
        nameIdx = rnListShift
    }
    cgJsrByName(nameIdx)
    cgCleanupStack(8)
    if cgSizeOf(elemT) <= 4 {
        cgIntrLoadScratch(off, elemT)
    }
    return off
}

// cgIntrListFirstLast mirrors fpIntrCall's IListFirst/IListLast arm
// (cprint.cla:1973-2031): unlike pop/shift, first/last do NOT remove the
// element -- t and l's own slot alias the SAME object, so a handle-typed
// result is retained IMMEDIATELY (always tracked, regardless of discard
// context -- the ONE difference from pop/shift's own untracked default).
func cgIntrListFirstLast(e: int, nm: string): int {
    var a0e: int
    var elemT: int
    var off: int
    var nameIdx: int
    var k: IRKind

    a0e = irIntrArgsHead(e)
    elemT = irExprType(e)
    k = irtKind(elemT)
    cgExpr(a0e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    if cgIsHandleKind(k) {
        off = cgNewTrackedTmp(elemT)
    } else {
        off = cgAllocTmpOff(elemT)
    }
    a68Emit(OpLea, 0, AmDisp16, 6, off, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    nameIdx = rnListFirst
    if nm == "list_last" {
        nameIdx = rnListLast
    }
    cgJsrByName(nameIdx)
    cgCleanupStack(8)
    if cgIsHandleKind(k) {
        cgRetainAt(6, off, elemT)
        cgLastTrackedOff = off
    }
    if cgSizeOf(elemT) <= 4 {
        cgIntrLoadScratch(off, elemT)
    }
    return off
}

// cgIntrListRemove mirrors fpIntrCall's IListRemove arm (cprint.cla:
// 2032-2060): the removed element's own reference is released BEFORE the
// removal call (the brief's own third ADDRESSING site -- the old-value
// read) -- l/i each evaluated exactly ONCE (stashed in scratch, reused for
// both the read and the removal call), same side-effect-safety reasoning
// as fpIntrCall's own `l`/`s0` text variables.
func cgIntrListRemove(e: int) {
    var a0e: int
    var a1e: int
    var elemT: int
    var lOff: int
    var iOff: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    elemT = irtElem(irExprType(a0e))
    lOff = cgAllocTmpOff(irPtrT)
    iOff = cgAllocTmpOff(irIntT)
    cgExpr(a0e)
    cgStoreD0At(6, lOff, irPtrT)
    cgExpr(a1e)
    cgStoreD0At(6, iOff, irIntT)

    if cgNeedsRelease(elemT) {
        a68Emit(OpMove, 4, AmDisp16, 6, lOff, AmDn, 1, 0)
        a68Emit(OpMove, 4, AmDisp16, 6, iOff, AmDn, 0, 0)
        cgListAddrFromRegs()
        cgReleaseAt(0, 0, elemT)
    }

    a68Emit(OpMove, 4, AmDisp16, 6, lOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, iOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnListRemove)
    cgCleanupStack(8)
}

// cgIntrListSet mirrors fpIntrCall's IListSet/IListSetRetain arm
// (cprint.cla:2061-2096) -- the brief's fourth ADDRESSING site (the
// element ref itself): l/i evaluated once each; the new value materialized
// (fpCopyToTemp) and, for the *Retain form, retained BEFORE the old value
// is released (self-overwrite safety -- `lst[i] = lst[i]`: if new and old
// happen to be the SAME handle, retaining first guarantees the release
// that follows can never drop it to zero). The element address is
// re-derived (cgListAddrFromRegs, a second time) after releasing the old
// value: cgReleaseAt's own JSRs (rtTextRelease et al.) clobber A0 same as
// any other call under this backend's "no callee-saved registers"
// convention, so the address computed BEFORE that release can't be reused
// for the write afterward.
func cgIntrListSet(e: int, retainVariant: bool) {
    var a0e: int
    var a1e: int
    var a2e: int
    var elemT: int
    var lOff: int
    var iOff: int
    var vOff: int
    var oldOff: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    a2e = irExprNext(a1e)
    elemT = irExprType(a2e)
    lOff = cgAllocTmpOff(irPtrT)
    iOff = cgAllocTmpOff(irIntT)
    vOff = cgAllocTmpOff(elemT)
    cgExpr(a0e)
    cgStoreD0At(6, lOff, irPtrT)
    cgExpr(a1e)
    cgStoreD0At(6, iOff, irIntT)
    cgStoreElemAt(vOff, elemT, a2e)
    if cgLastTrackedOff != -1 {
        cgHandoff(cgLastTrackedOff)
    }

    if retainVariant {
        cgRetainAt(6, vOff, elemT)
    }

    a68Emit(OpMove, 4, AmDisp16, 6, lOff, AmDn, 1, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, iOff, AmDn, 0, 0)
    cgListAddrFromRegs()
    if cgNeedsRelease(elemT) {
        oldOff = cgAllocTmpOff(elemT)
        cgCopyElemInto(6, oldOff, elemT)
        cgReleaseAt(6, oldOff, elemT)
        a68Emit(OpMove, 4, AmDisp16, 6, lOff, AmDn, 1, 0)
        a68Emit(OpMove, 4, AmDisp16, 6, iOff, AmDn, 0, 0)
        cgListAddrFromRegs()
    }
    cgCopyElemFrom(6, vOff, elemT)
}

// cgIntrListClone (clir-load-perf) mirrors cgIntrTextTextAt's own
// dst-allocation dance exactly, adapted to List's own two-argument birth
// (rtListNew needs an elemsize, unlike rtTextNew's zero-arg form -- same
// elemsize constant cgDefaultInitAt's own KList arm computes via
// cgSizeOf(irtElem(t)), the backend's single source of truth for a
// container's element storage size, THE layout-consistency rule this
// file's own header note establishes between birth and addressing). e's
// own result type IS the receiver's list type (check.cla's "clone" arm
// returns the receiver's own type unchanged), so no separate result-type
// lookup is needed. Legal with no per-element retain/release here only
// because check.cla's own "clone" arm already restricted this to a flat
// (no text/list/map anywhere) element type.
func cgIntrListClone(e: int) {
    var a0e: int
    var t: int
    var elemSize: int
    var off: int

    a0e = irIntrArgsHead(e)
    t = irExprType(e)
    elemSize = cgSizeOf(irtElem(t))
    off = cgNewTrackedTmp(t)
    a68Emit(OpMove, 4, AmImm, 0, elemSize, AmPreDec, 7, 0)
    cgJsrByName(rnListNew)
    cgCleanupStack(4)
    cgStoreD0At(6, off, t)

    a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a0e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, elemSize, AmPreDec, 7, 0)
    cgJsrByName(rnListClone)
    cgCleanupStack(12)
    cgLastTrackedOff = off
    a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
}

// cgIntrMapSet mirrors fpIntrCall's IMapSet/IMapSetRetain arm
// (cprint.cla:2120-2163): the upsert guard (cgMapReleaseGuard) releases
// whatever k currently holds BEFORE the new value is written; the new
// value is retained (the *Retain form only) BEFORE the set call.
//
// map-hashtable phase Task 2: `sorted` selects which runtime family's Set
// this calls (rtMap vs. rtSortedMap) -- parameterized rather than
// duplicated (see cgMapReleaseGuard's own doc comment). Findings 1.4
// (Task 13): was a `prefix: string` ("rtMap"/"rtSortedMap") concatenated
// with the op suffix and interned fresh at every call (`prefix + "Set"`);
// now a bool picking between two rnInit()-filled globals, same
// pre-interned-name discipline as every other runtime-call site in this
// file.
func cgIntrMapSet(e: int, retainVariant: bool, sorted: bool) {
    var a0e: int
    var a1e: int
    var a2e: int
    var elemT: int
    var mOff: int
    var vOff: int
    var nameIdx: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    a2e = irExprNext(a1e)
    elemT = irExprType(a2e)
    mOff = cgAllocTmpOff(irPtrT)
    cgExpr(a0e)
    cgStoreD0At(6, mOff, irPtrT)

    if cgNeedsRelease(elemT) {
        cgMapReleaseGuard(mOff, a1e, elemT, sorted)
    }

    vOff = cgAllocTmpOff(elemT)
    cgStoreElemAt(vOff, elemT, a2e)
    if cgLastTrackedOff != -1 {
        cgHandoff(cgLastTrackedOff)
    }
    if retainVariant {
        cgRetainAt(6, vOff, elemT)
    }

    a68Emit(OpMove, 4, AmDisp16, 6, mOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(a1e)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmDisp16, 6, vOff, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    nameIdx = rnMapSet
    if sorted {
        nameIdx = rnSortedMapSet
    }
    cgJsrByName(nameIdx)
    cgCleanupStack(12)
}

// cgIntrMapGet mirrors fpIntrCall's IMapGet arm (cprint.cla:2164-2200):

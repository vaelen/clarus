    if cgIsHandleKind(k) {
        cgRetainAt(6, off, elemT)
        cgLastTrackedOff = off
    }
    if cgSizeOf(elemT) <= 4 {
        cgIntrLoadScratch(off, elemT)
    }
    return off
}

// cgIntrIntMapGetDv mirrors cgIntrMapGetDv -- the int-keyed twin (see
// cgIntrIntMapSet's own doc comment).
func cgIntrIntMapGetDv(e: int, isBirth: bool): int {
    var a0e: int
    var a1e: int
    var a2e: int
    var elemT: int
    var mOff: int
    var kOff: int
    var dvOff: int
    var off: int
    var k: IRKind
    var skipLbl: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    a2e = irExprNext(a1e)
    elemT = irExprType(e)
    k = irtKind(elemT)
    mOff = cgAllocTmpOff(irPtrT)
    cgExpr(a0e)
    cgStoreD0At(6, mOff, irPtrT)

    kOff = cgAllocTmpOff(irIntT)
    cgExpr(a1e)
    cgStoreD0At(6, kOff, irIntT)

    dvOff = cgAllocTmpOff(elemT)
    cgStoreElemAt(dvOff, elemT, a2e)
    if cgLastTrackedOff != -1 {
        cgHandoff(cgLastTrackedOff)
    }

    if cgIsHandleKind(k) {
        off = cgNewTrackedTmp(elemT)
    } else {
        off = cgAllocTmpOff(elemT)
    }
    cgCopyScratch(dvOff, off, elemT)

    a68Emit(OpMove, 4, AmDisp16, 6, mOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, kOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmDisp16, 6, off, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnIntMapGetDv)
    cgCleanupStack(12)

    if cgIsHandleKind(k) {
        if isBirth {
            a68Emit(OpMove, 4, AmDisp16, 6, off, AmDn, 0, 0)
            a68Emit(OpMove, 4, AmDisp16, 6, dvOff, AmDn, 1, 0)
            a68Emit(OpCmp, 4, AmDn, 1, 0, AmDn, 0, 0)
            skipLbl = a68NewLabel()
            a68EmitBr(OpBcc, 7, skipLbl) // BEQ: off==dvOff -> unchanged, skip
            cgRetainAt(6, off, elemT)
            cgReleaseAt(6, dvOff, elemT)
            a68Bind(skipLbl)
        } else {
            cgRetainAt(6, off, elemT)
        }
        cgLastTrackedOff = off
    }
    if cgSizeOf(elemT) <= 4 {
        cgIntrLoadScratch(off, elemT)
    }
    return off
}

// cgIntrIntMapRemove mirrors cgIntrMapRemove -- the int-keyed twin (see
// cgIntrIntMapSet's own doc comment).
func cgIntrIntMapRemove(e: int) {
    var a0e: int
    var a1e: int
    var elemT: int
    var mOff: int
    var kOff: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    elemT = irtElem(irExprType(a0e))
    mOff = cgAllocTmpOff(irPtrT)
    cgExpr(a0e)
    cgStoreD0At(6, mOff, irPtrT)

    kOff = cgAllocTmpOff(irIntT)
    cgExpr(a1e)
    cgStoreD0At(6, kOff, irIntT)

    if cgNeedsRelease(elemT) {
        cgIntMapReleaseGuard(mOff, kOff, elemT)
    }

    a68Emit(OpMove, 4, AmDisp16, 6, mOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, kOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnIntMapRemove)
    cgCleanupStack(8)
}

// cgIntrFileSaveLoad implements IFileSave/IFileLoad (Task 14 fix,
// native-5e gate, bookmarks.cla) -- mirrors cprint.cla's own IFileSave/
// IFileLoad arm (fpIntrCall): the data arg's OWN IR type carries the
// record name and container kind (KRec directly, or KList/KMap's elem),
// never extra IR fields, matching that comment's own note precisely.
// fnName's target (ser.cla's rtFileSave/rtFileLoad, `(path: ptr,
// container: int, data: ptr, desc: ptr): int`, already-ported and
// unconditionally rooted -- shakeWalkIntr's IUiEdit-family precedent
// doesn't even apply here, file.save/load's own runtime dependency is
// core, not UI-gated) is a plain 4-arg ordinary call: path BY ADDRESS
// (cgExprAddr, a Str255-shaped ptr, same convention every other str.cla-
// family call already uses), container as a compile-time literal (0 REC/
// 1 LIST/2 MAP), data BY ADDRESS for a KRec (the record itself) or BY
// VALUE for a KList/KMap (already a handle/ptr), desc as the record's own
// cgFindSerdescLabel address (LEA lbl(PC),A0 -- the SAME "value is a
// pool-relative address" shape cgCallExtUiBlobAddr's own two-instruction
// pattern uses, just pushed as a plain arg here instead of left in D0).
// Result (0/1, ser.cla's own SerFileWriteData-derived clean boolean) is
// already in D0 after the call, matching cgIntr's own "value ends in D0"
// contract -- no extra masking needed.
func cgIntrFileSaveLoad(e: int, nameIdx: int) {
    var a0: int
    var a1: int
    var a2: int
    var a3: int
    var dataT: int
    var dataK: IRKind
    var recNameIdx: int
    var container: int
    var descLbl: int
    var isSave: bool

    a0 = irIntrArgsHead(e)
    a1 = irExprNext(a0)
    // native-gaps-cleanup Task 2: file.save gains mandatory trailing
    // type/creator args (rtFileSave's own 2 new trailing ptr params);
    // file.load stays 4-arg (unchanged) -- nameIdx tells the two apart,
    // same convention this function's own doc comment already uses.
    // Findings 1.4 (Task 13): fnName was a `string`, compared against a
    // literal; now an already-interned nameIdx (rnFileSave/rnFileLoad),
    // compared by int equality.
    isSave = nameIdx == rnFileSave
    if isSave {
        a2 = irExprNext(a1)
        a3 = irExprNext(a2)
    }
    dataT = irExprType(a1)
    dataK = irtKind(dataT)
    if dataK == KRec {
        recNameIdx = irtName(dataT)
        container = 0
    } else if dataK == KList {
        recNameIdx = irtName(irtElem(dataT))
        container = 1
    } else {
        recNameIdx = irtName(irtElem(dataT))
        container = 2
    }
    descLbl = cgFindSerdescLabel(recNameIdx)
    if descLbl == -1 {
        abort("cg68k: " + poolGet(nameIdx) + ": no serdesc reserved for record " + poolGet(recNameIdx))
    }

    cgExprAddr(a0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgPushIntLit(container)
    if dataK == KRec {
        cgExprAddr(a1)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    } else {
        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    }
    a68Emit(OpLea, 0, AmPCLabel, 0, descLbl, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    if isSave {
        cgExprAddr(a2)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgExprAddr(a3)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    }
    cgJsrByName(nameIdx)
    if isSave {
        cgCleanupStack(24)
    } else {
        cgCleanupStack(16)
    }
}

// cgIntr dispatches an EIntr node by its interned NAME. UI intrinsics
// ("ui_*") are 5e (native UI) territory -- hard error, matching
// cg68AddRoots'/the brief's own "nat*"-prefix convention for name-based
// dispatch. str_cmp and peek*/poke* (Task 9) are the intrinsics this
// task's fixtures need in VALUE/statement position (str_concat/etc only
// ever appear as an SStoreStr/SReturn source -- see cgEmitStoreStr/
// cgEmitReturnStr); every other intrinsic is a TODO placeholder that
// still leaves D0 in a defined state (Task 13 completes the real
// dispatch).
func cgIntr(e: int) {
    var nm: int
    var a0e: int
    var a1e: int
    var args: list of int
    var addrs: list of bool

    // layer1-compiler-perf phase Task 14 (findings 1.5): nm is now the
    // INTERNED pool index (irIntrName's own return value) rather than a
    // freshly poolGet'd 256-byte string copy -- every arm below compares
    // against a memoized I*() helper's interned int (cprint-style
    // dispatch, ir.cla's own intrinsic-name-constant block), not a string.
    // The old hand-unrolled "ui_"-prefix probe is gone: every non-UI arm
    // is tried first, and falling through all of them now simply calls
    // cgIntrUi(e, nm) unconditionally -- its own final else is the
    // catch-all unknown-intrinsic error path (poolGet(nm) only there, on
    // the cold/error path).
    nm = irIntrName(e)
    if nm == IStrCmp() {
        a0e = irIntrArgsHead(e)
        a1e = irExprNext(a0e)
        args = cgFreshIntList()
        args.add(a0e)
        args.add(a1e)
        addrs = cgFreshBoolList()
        addrs.add(true)
        addrs.add(true)
        if not cgCallRuntime(rnStrCmp, args, addrs) {
            abort("cg68k: cgIntr: rtStrCmp call failed")
        }
        return
    }
    // Task 12: retain/release -- lowCountedStoreRecVal's own ARC store
    // sequence (a handle-bearing record copy site) and lowNullValueAppend's
    // sibling null-out both funnel through these two intrinsics (ir.cla's
    // IRetain()/IRelease(), interned as "retain"/"release"), each carrying
    // exactly one addressable arg (EVarRef or EFieldRef) -- cgRetainExpr/
    // cgReleaseExpr dispatch on the arg's OWN type (KText/KList/KMap ->
    // the ordinary ported family function; KRec -> the generated
    // cg_retain_/cg_release_ walk, a no-op when the record has no handle
    // field at all).
    if nm == IRetain() {
        cgRetainExpr(irIntrArgsHead(e))
        return
    }
    if nm == IRelease() {
        cgReleaseExpr(irIntrArgsHead(e))
        return
    }
    // Task 11: alert/log/quit -- native.cla's natAlert/natLog take their
    // message argument BY ADDRESS (native.cla's own file header explains
    // why: a `ptr` param, str.cla-style, sidesteps native.cla ever
    // needing a source-level address-of a `string`), exactly like
    // str_cmp's own rtStrCmp call just above -- cgCallRuntime with
    // addrs=true. quit additionally JSRs cg_free_globals first (the
    // brief's own "IQuit -> JSR cg_free_globals; push code; JSR natQuit"
    // -- matches cgEmitStartup's own terminal sequence, for a `quit expr`
    // reached anywhere else in a handler body) -- natQuit's own code
    // argument is a plain int, passed BY VALUE (addrs=false).
    if nm == IAlert() {
        // attempt-abort phase Task 4 (A4 scope addition, design doc %3.5;
        // task-1-report P4(d)'s own finding): natAlert is headless (a
        // trace write, no Toolbox trap) on EVERY native build today, in
        // tension with the language reference's documented "shows a
        // standard alert" behavior. A UI program (irIsUiProgram(), same
        // predicate lowQuit's own IUiQuit split already uses) now routes
        // through rtUiAlertMsg (runtime/clarus/uidialogs.cla, A4) instead
        // -- ALWAYS the same natAlert-format trace line, PLUS a real
        // dialog when not scripted. A non-UI program keeps natAlert,
        // unchanged.
        a0e = irIntrArgsHead(e)
        args = cgFreshIntList()
        args.add(a0e)
        addrs = cgFreshBoolList()
        addrs.add(true)
        if irIsUiProgram() {
            if not cgCallRuntime(intern("rtUiAlertMsg"), args, addrs) {
                abort("cg68k: cgIntr: rtUiAlertMsg call failed")
            }
        } else {
            if not cgCallRuntime(rnAlert, args, addrs) {
                abort("cg68k: cgIntr: rtAlert call failed")
            }
        }
        return
    }
    if nm == ILog() {
        a0e = irIntrArgsHead(e)
        args = cgFreshIntList()
        args.add(a0e)
        addrs = cgFreshBoolList()
        addrs.add(true)
        if not cgCallRuntime(rnLog, args, addrs) {
            abort("cg68k: cgIntr: rtLog call failed")
        }
        return
    }
    if nm == IQuit() {
        a0e = irIntrArgsHead(e)
        a68EmitBr(OpBsr, 0, cgFreeGlobalsLbl)
        args = cgFreshIntList()
        args.add(a0e)
        addrs = cgFreshBoolList()
        addrs.add(false)
        if not cgCallRuntime(rnQuit, args, addrs) {
            abort("cg68k: cgIntr: rtQuit call failed")
        }
        return
    }
    if nm == IAbort() {
        cgIntrAbort(e)
        return
    }
    if nm == IPeekB() or nm == IPeekW() or nm == IPeekL() {
        cgIntrPeek(e, nm)
        return
    }
    if nm == IPokeB() or nm == IPokeW() or nm == IPokeL() {
        cgIntrPoke(e, nm)
        return
    }
    if nm == IXRecStrWrite() {
        // Task 6 (toolbox-integration Feature B): `ev.fName = s` -- an
        // extern-record str[N] field WRITE, an ExprStmt (ir.cla's
        // IXRecStrWrite doc comment), reached here via cgStmt's SExprStmt
        // arm. Args (fieldAddr, N, srcStringExpr) map directly onto
        // rtStrStore(dst: ptr, dstcap: int, src: ptr)'s own (dst, dstcap,
        // src) -- fieldAddr is an EXRecAddr (its "address" and "value" are
        // the same LEA, cgXRecAddrReg/Disp), N is already an int-const IR
        // node (lower.cla's own newIRIntConst), srcStringExpr is whatever
        // ordinary str-typed expr the RHS lowered to (cgExprAddr's own
        // materialize fallback covers anything not already addressable,
        // same as cgEmitStoreStr's identical generic tail).
        a0e = irIntrArgsHead(e)
        a1e = irExprNext(a0e)
        args = cgFreshIntList()
        args.add(a0e)
        args.add(a1e)
        args.add(irExprNext(a1e))
        addrs = cgFreshBoolList()
        addrs.add(true)
        addrs.add(false)
        addrs.add(true)
        if not cgCallRuntime(rnStrStore, args, addrs) {
            abort("cg68k: cgIntr: rtStrStore call failed")
        }
        return
    }
    // Task 12.5 (lastError storage-inversion fix): "lasterr_code" is the
    // only lastError-family intrinsic that returns a scalar (int) and so
    // is reachable from THIS (value-context) dispatch -- a zero-arg
    // cgCallRuntime call, same shape as str_cmp's own call just above
    // minus the arg pushes. "lasterr_msg" (str-returning) is wired at
    // cgEmitStoreStr/cgEmitReturnStr instead, mirroring "str_concat"'s own
    // split; "lasterr_value" (the whole Err record) has no record-value
    // intrinsic dispatch point in this backend yet (cgEmitStoreRec/
    // cgEmitReturnRec have no EIntr arm at all) -- it degrades through
    // cgExprAddr's existing generic "TODO cgExprAddr <kind>" placeholder,
    // same as every other not-yet-wired record-valued source; not
    // exercised by any fixture this task adds.
    if nm == ILastErrCode() {
        args = cgFreshIntList()
        addrs = cgFreshBoolList()
        if not cgCallRuntime(rnLastErrCode, args, addrs) {
            abort("cg68k: cgIntr: rtLastErrCode call failed")
        }
        return
    }

    // Task 14.7 (found by hardening cgIntr's catch-all from a silent
    // move.l #0 into a hard error -- fixedmath.cla/emit_arith.cla tripped
    // it immediately): lowBinary lowers `*`/`/` on `fixed` operands to
    // IFixMul()/IFixDiv() (lower.cla:472-474), NEVER a plain EBin -- this
    // arm was simply MISSING, so every native fixed-point multiply/divide
    // silently returned 0 instead of hard-erroring or working. Both
    // operands and the result are plain 4-byte ints (rtFixMul/rtFixDiv,
    // runtime/clarus/core.cla), by VALUE like any other cgIntr2(...,
    // false, false) scalar arm.
    if nm == IFixMul() {
        cgIntr2(e, rnFixMul, false, false)
        return
    }
    if nm == IFixDiv() {
        cgIntr2(e, rnFixDiv, false, false)
        return
    }

    // ---- Task 13: str family (value-returning arms only -- str_concat/
    // str_concat_char/str_prepend_char/str_slice/str_coerce all
    // MATERIALIZE a fresh Str value, same "not scalar-kind, needs its own
    // address" shape as any other KStr result; those stay wired at
    // cgEmitStoreStr/cgEmitReturnStr (already true before this task) and
    // are UNREACHABLE from this value-context dispatch, matching every
    // other KStr-result gap this file already documents). ----
    if nm == IStrLen() {
        cgIntr1(e, rnStrLen, true)
        return
    }
    if nm == IStrIndex() {
        cgIntr2(e, rnStrIndex, true, false)
        return
    }
    if nm == IStrSetIndex() {
        cgIntr3(e, rnStrSetIndex, true, false, false)
        return
    }
    if nm == IStrIndexOfStr() {
        cgIntr2(e, rnStrIndexOfStr, true, true)
        return
    }
    if nm == IStrIndexOfChar() {
        cgIntr2(e, rnStrIndexOfChar, true, false)
        return
    }
    if nm == IStrFromBytes() {
        cgIntrStrFromBytes(e)
        return
    }
    if nm == IStrToBytes() {
        cgIntrStrToBytes(e)
        return
    }

    // ---- Task 13: text family ----
    if nm == ITextStore() {
        cgIntr2(e, rnTextStore, false, true)
        return
    }
    if nm == ITextLen() {
        cgIntr1(e, rnTextLen, false)
        return
    }
    if nm == ITextIndex() {
        cgIntr2(e, rnTextIndex, false, false)
        return
    }
    if nm == ITextSetIndex() {
        cgIntr3(e, rnTextSetIndex, false, false, false)
        return
    }
    if nm == ITextIndexOfStr() {
        cgIntr2(e, rnTextIndexOfStr, false, true)
        return
    }
    if nm == ITextIndexOfChar() {
        cgIntr2(e, rnTextIndexOfChar, false, false)
        return
    }
    if nm == ITextAppendStr() {
        cgIntr2(e, rnTextAppendStr, false, true)
        return
    }
    if nm == ITextAppendChar() {
        cgIntr2(e, rnTextAppendChar, false, false)
        return
    }
    if nm == ITextAppendText() {
        cgIntr2(e, rnTextAppendText, false, false)
        return
    }
    if nm == ITextFromBytes() {
        cgIntrTextFromBytes(e)
        return
    }
    if nm == ITextToBytes() {
        cgIntrTextToBytes(e)
        return
    }
    if nm == ITextCmp() {
        cgIntrTextCmp(e)
        return
    }
    if nm == ITextConcat() {
        cgIntrTextConcat(e)
        return
    }
    if nm == ITextConcatSL() {
        cgIntrTextConcatSl(e)
        return
    }
    if nm == ITextOfStr() {
        cgIntrTextOfStr(e)
        return
    }
    // clir-load-perf Task 3: hashStep/intAt return plain int scalars (no
    // hidden pointer, no tracked temp -- reachable from this value-context
    // dispatch same as ITextIndex above); textAt returns a fresh Text
    // HANDLE (4 bytes, fits in D0 like ITextConcat/ITextConcatSl/
    // ITextOfStr above), so it also belongs here, NOT in the KStr-only
    // cgEmitStoreStr/cgEmitReturnStr family stringAt uses. (intAt renamed
    // post-review from u32At -- one signed int type, so the u32 name
    // misdescribed the return.)
    if nm == ITextHashStep() {
        cgIntr4(e, rnTextHashStep, false, false, false, false)
        return
    }
    if nm == ITextIntAt() {
        cgIntr2(e, rnTextIntAt, false, false)
        return
    }
    if nm == ITextTextAt() {
        cgIntrTextTextAt(e)
        return
    }
    if nm == ITextFreeVar() {
        cgReleaseExpr(irIntrArgsHead(e))
        return
    }

    // ---- Task 13: list family ----
    if nm == IListPush() or nm == IListUnshift() or nm == IListPushRetain() or nm == IListUnshiftRetain() {
        // cgIntrListPushLike is shared with cgEmitStoreRec/cgEmitStoreStr
        // (out of this task's scope), which still poolGet their own nm
        // themselves -- one poolGet here, paid only on this already-
        // matched arm, not on every failed dispatch attempt.
        cgIntrListPushLike(e, poolGet(nm))
        return
    }
    if nm == IListPop() or nm == IListShift() {
        cgIntrListPopLike(e, poolGet(nm))
        return
    }
    if nm == IListFirst() or nm == IListLast() {
        cgIntrListFirstLast(e, poolGet(nm))
        return
    }
    if nm == IListRemove() {
        cgIntrListRemove(e)
        return
    }
    if nm == IListSet() or nm == IListSetRetain() {
        cgIntrListSet(e, nm == IListSetRetain())
        return
    }
    if nm == IListCount() {
        cgIntr1(e, rnListCount, false)
        return
    }
    if nm == IListClear() {
        // layer1-compiler-perf phase Task 8: count -> 0, capacity retained
        // -- void, single-ptr-arg runtime call, same shape as list_count
        // just above (the return value, if any, is simply unused).
        cgIntr1(e, rnListClear, false)
        return
    }
    if nm == IListClearDeep() {
        // memory-leak-fix phase Task 5: cgClearDeepContainer's own doc
        // comment -- release every current element before the same
        // IListClear hard reset, lowering only ever picks this name for a
        // ref-bearing element type.
        a0e = irIntrArgsHead(e)
        cgClearDeepContainer(a0e, irExprType(a0e), rnListClear)
        return
    }
    if nm == IListFreeVar() {
        cgReleaseExpr(irIntrArgsHead(e))
        return
    }
    if nm == IListClone() {
        cgIntrListClone(e)
        return
    }

    // ---- Task 13: map family ----
    if nm == IMapSet() or nm == IMapSetRetain() {
        cgIntrMapSet(e, nm == IMapSetRetain(), false)
        return
    }
    if nm == IMapGet() {
        cgIntrMapGet(e, false)
        return
    }
    if nm == IMapGetDv() {
        cgIntrMapGetDv(e, false, false)
        return
    }
    if nm == IMapGetDvBirth() {
        cgIntrMapGetDv(e, true, false)
        return
    }
    if nm == IMapHas() {
        cgIntr2(e, rnMapHas, false, true)
        return
    }
    if nm == IMapRemove() {
        cgIntrMapRemove(e, false)
        return
    }
    if nm == IMapCount() {
        cgIntr1(e, rnMapCount, false)
        return
    }
    if nm == IMapClear() {
        // layer1-compiler-perf phase Task 8 -- see list_clear's own
        // comment above.
        cgIntr1(e, rnMapClear, false)
        return
    }
    if nm == IMapClearDeep() {
        // memory-leak-fix phase Task 5 -- see list_clear_deep's own
        // comment above. Releases VALUES only; keys are inline pool bytes
        // reclaimed by rtMapClear's own poolused=0 reset.
        a0e = irIntrArgsHead(e)
        cgClearDeepContainer(a0e, irExprType(a0e), rnMapClear)
        return
    }
    if nm == IMapFreeVar() {
        cgReleaseExpr(irIntrArgsHead(e))
        return
    }

    // ---- map-hashtable phase Task 2: sortedmap family -- TyMap's twin
    // above, name for name, dispatching to the SAME cgIntrMap*/cgIntr1/
    // cgIntr2/cgReleaseExpr helpers with the "rtSortedMap" runtime-name
    // prefix instead of "rtMap" ----
    if nm == ISortedMapSet() or nm == ISortedMapSetRetain() {
        cgIntrMapSet(e, nm == ISortedMapSetRetain(), true)
        return
    }
    if nm == ISortedMapGet() {
        cgIntrMapGet(e, true)
        return
    }
    if nm == ISortedMapGetDv() {
        cgIntrMapGetDv(e, false, true)
        return
    }
    if nm == ISortedMapGetDvBirth() {
        cgIntrMapGetDv(e, true, true)
        return
    }
    if nm == ISortedMapHas() {
        cgIntr2(e, rnSortedMapHas, false, true)
        return
    }
    if nm == ISortedMapRemove() {
        cgIntrMapRemove(e, true)
        return
    }
    if nm == ISortedMapCount() {
        cgIntr1(e, rnSortedMapCount, false)
        return
    }
    if nm == ISortedMapClear() {
        // layer1-compiler-perf phase Task 8 -- see list_clear's own
        // comment above.
        cgIntr1(e, rnSortedMapClear, false)
        return
    }
    if nm == ISortedMapClearDeep() {
        // memory-leak-fix phase Task 5 -- see list_clear_deep's own
        // comment above. Values only, same reason as map_clear_deep.
        a0e = irIntrArgsHead(e)
        cgClearDeepContainer(a0e, irExprType(a0e), rnSortedMapClear)
        return
    }
    if nm == ISortedMapFreeVar() {
        cgReleaseExpr(irIntrArgsHead(e))
        return
    }

    // ---- map-hashtable phase Task 7: intmap family -- TyMap's twin
    // above, but int-KEYED: has/count/free_var reuse the SAME generic
    // cgIntr1/cgIntr2/cgReleaseExpr helpers (with addr1=false for the key
    // arg -- rtIntMapHas/rtIntMapCount take an int key/no key by VALUE, not
    // by address), one call each so no double-evaluation risk regardless.
    // set/get/get_dv(_birth)/remove need their OWN dedicated
    // cgIntrIntMap*/cgIntMapReleaseGuard functions (not the parameterized
    // cgIntrMap*/cgMapReleaseGuard family above) because those assume a
    // string key is always addressable (cgExprAddr, re-evaluated safely
    // multiple times per the checker's own addressable-key constraint) --
    // an intmap key is an ARBITRARY int expression with no such
    // restriction, so it must be evaluated exactly ONCE into a scratch slot
    // and reused from there.
    if nm == IIntMapSet() or nm == IIntMapSetRetain() {
        cgIntrIntMapSet(e, nm == IIntMapSetRetain())
        return
    }
    if nm == IIntMapGet() {
        cgIntrIntMapGet(e)
        return
    }
    if nm == IIntMapGetDv() {
        cgIntrIntMapGetDv(e, false)
        return
    }
    if nm == IIntMapGetDvBirth() {
        cgIntrIntMapGetDv(e, true)
        return
    }
    if nm == IIntMapHas() {
        cgIntr2(e, rnIntMapHas, false, false)
        return
    }
    if nm == IIntMapRemove() {
        cgIntrIntMapRemove(e)
        return
    }
    if nm == IIntMapCount() {
        cgIntr1(e, rnIntMapCount, false)
        return
    }
    if nm == IIntMapClear() {
        // layer1-compiler-perf phase Task 8 -- see list_clear's own
        // comment above.
        cgIntr1(e, rnIntMapClear, false)
        return
    }
    if nm == IIntMapClearDeep() {
        // memory-leak-fix phase Task 5 -- see list_clear_deep's own
        // comment above. Values only, same reason as map_clear_deep.
        a0e = irIntrArgsHead(e)
        cgClearDeepContainer(a0e, irExprType(a0e), rnIntMapClear)
        return
    }
    if nm == IIntMapFreeVar() {
        cgReleaseExpr(irIntrArgsHead(e))
        return
    }

    // ---- Task 14: files. IFileReadText/IFileWriteText are bool-
    // returning (fit D0), reachable through this ordinary scalar cgExpr/
    // cgIntr path -- cgIntr2 with addr0=true (path, a Str255-shaped ptr,
    // same convention str.cla's own `ptr` params use), addr1=false (the
    // text arg's own VALUE already IS the rtText box pointer -- same
    // by-value convention "text_store"'s dst arg above uses, NOT an
    // address-of-the-variable). IFileName is str-returning (str255
    // doesn't fit D0) and is NEVER legally reached from this scalar
    // dispatch -- cgEmitStoreStr/cgEmitReturnStr's own "file_name" arms
    // (the only call sites lower.cla's newIRIntr(IFileName(), ...) can
    // ever reach, since every use is either a store target or a return)
    // handle it instead; a genuine reach here (Task 14.7: silent-zero is
    // forbidden -- was a TODO-comment + move.l #0 placeholder) is now a
    // hard error naming the construct, not a silently wrong D0 value. ----
    if nm == IFileReadText() {
        cgIntr2(e, rnFileReadText, true, false)
        return
    }
    if nm == IFileWriteText() {
        // file.writeText(path, text, type, creator) -- native-gaps-cleanup
        // Task 2: type/creator are new trailing args, both by-address
        // Str255s (same convention as path) -- natFileWriteText does the
        // pad/validate/stamp work (rtFourCC).
        cgIntr4(e, rnFileWriteText, true, false, true, true)
        return
    }
    if nm == IFileReadResource() {
        // file.readResource(name, out) -- Task 7 (mac-resident-clarusc);
        // same addr0/addr1 shape as file_read_text above (name is a
        // Str255-shaped ptr, out's own value already IS the rtText box
        // pointer).
        cgIntr2(e, rnReadResource, true, false)
        return
    }
    if nm == IFileWriteRes() {
        // file.writeRes(path, fork, doctype, creator) -- same shape as
        // file_write_text above.
        cgIntr4(e, rnWriteRes, true, false, true, true)
        return
    }
    if nm == IFileName() {
        abort("cg68k: cgIntr: file_name reached in scalar/value context (str-returning, only valid as a store/return target)")
    }
    if nm == IFileSave() {
        cgIntrFileSaveLoad(e, rnFileSave)
        return
    }
    if nm == IFileLoad() {
        cgIntrFileSaveLoad(e, rnFileLoad)
        return
    }

    // Task 14: every non-UI intrinsic name is tried above; whatever falls
    // through (ui_* names, plus any genuinely unsupported name) lands in
    // cgIntrUi, whose own final else is the catch-all unknown-intrinsic
    // error (poolGet(nm) only on that cold path) -- replaces the old
    // hand-unrolled "ui_"-prefix probe at this function's head.
    cgIntrUi(e, nm)
}

// ================================================================
// Task 12 (native-5e): the Ch7-11 UI surface's own intrinsic family
// ("ui_*", ir.cla's IUiXxx() name table) -- the user-program-source
// lowering targets for `open`/`close`/`.title`/canvas draw calls/widget
// property get-set/etc. Distinct from the reverse-waist SYNTHESIZED
// dispatcher externs (UiFireWinEvent & co, resolved by
// cgCallExtUiSynth): these are ordinary EIntr nodes lower.cla emits
// directly from a checked Clarus program's own AST (fpIntrCall's mirror,
// cprint.cla:2559-2741 -- every arm below is a direct port of that
// switch, RTUI_PROP_* constants inlined from rt_ui.h:136-142). Args are
// unpacked the same a0/a1/a2 way cprint's own fpIntrCall does.
//
// Scope (Task 12): every intrinsic bounce.cla's own AST can produce
// (open/front/state/state-defaults/canvas draws/menu-enable/widget
// property get-set/cancel) plus the three reverse-waist-only ones
// (SetCancelFlag/ValueAtPtr/AddrOfGlobal, ir.cla's own explicit ask for
// "a future cg68k UI port (Task 12) adds its own arm"). NOT covered
// (deferred, clean fail-closed -- no golden scenario this task gates on
// reaches any of these): the three str/text-FILLING getters (GetTitle/
// GetFieldText/GetTextviewText -- need the fpNewTmp-style str/text
// materialization machinery cgStrBuilderIntoTemp's SStoreStr/SReturn
// callers already use, not yet wired to a plain value-context intrinsic
// result) and the five StandardFile/dialog-only ones (Edit/AskOpen/
// AskSave/AskSaveChanges/FormIsNew -- Task 10's own dialog machinery,
// paired with the nat_UiSFGetFile/nat_UiSFPutFile stubs above).
func cgPushIntLit(v: int) {
    a68Emit(OpMove, 4, AmImm, 0, v, AmPreDec, 7, 0)
}

const cgRtuiPropCaption: int = 0
const cgRtuiPropText: int = 1
const cgRtuiPropEnabled: int = 2
const cgRtuiPropChecked: int = 3
const cgRtuiPropSelected: int = 4
const cgRtuiPropWidth: int = 5
const cgRtuiPropHeight: int = 6

// cgIntrUiEdit implements IUiEdit (Ch10's `edit F, target` / `edit F, new
// T`) -- mirrors cprint.cla's fpUiEditStmt arm exactly, four kinds decoded
// off the SAME compile-time-constant tag (kindArg, ir.cla's own doc
// comment: "a0 is an IntConst tag"), each constructing rtUiEdit's 9-arg
// call (uidialogs.cla: `rtUiEdit(winIdx, src, isNew, wbKind, addr, lst,
// idx, mp, key255)`, an ALREADY-PORTED plain Clarus function -- every
// param is int/ptr, 4 bytes each, so none of this session's bool-arg
// convention hazards apply here at all) the same way cprint's own C
// construction does per kind. Single-evaluation discipline for kind 2/3's
// own idx/key expr matches fpUiEditStmt's own comment precisely (a
// side-effecting index/key expr must not run twice); the list/map
// CONTAINER itself (opA) is always a bare variable/per-instance-field
// reference (never an arbitrary expression -- fpUiEditStmt's own doc
// comment), so re-evaluating it via a second cgExpr call is safe with no
// temp needed, exactly like cprint prints its own text twice.
//
// Every intermediate value (a freshly-constructed record's address, a
// once-evaluated idx, an rtListAt result, a copied-in key) is stashed in
// its OWN A6-relative scratch slot (cgAllocTmpOff/cgAllocBigTmpOff) and
// RELOADED when needed rather than trusted in a register across an
// intervening JSR -- this backend has no callee-saved registers (the
// file's own established discipline, carried forward from this session's
// own register-across-call hazard fixes).
func cgIntrUiEdit(e: int, a0: int, a1: int, a2: int, winName: string) {
    var kind: int
    var winIdx: int
    var recNameIdx: int
    var recType: int
    var tmpOff: int
    var idxOff: int
    var srcOff: int
    var keyOff: int

    kind = irIntConstV(a0)
    winIdx = cpFindWindowIndex(winName)

    if kind == 0 {
        // `edit F, new T` -- construct a fresh default T into a big-tmp
        // scratch slot, pass its address as `src`; isNew=1, wbKind=0
        // (RT_UI_WB_NONE), every other param 0/null.
        recNameIdx = cpFindWindowFormRecName(winName)
        recType = irRecType(recNameIdx)
        tmpOff = cgAllocBigTmpOff(recType)
        cgRecordCtorAt(6, tmpOff, recNameIdx)

        cgPushIntLit(winIdx)
        a68Emit(OpLea, 0, AmDisp16, 6, tmpOff, AmAn, 0, 0)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgPushIntLit(1) // isNew
        cgPushIntLit(0) // wbKind = RT_UI_WB_NONE
        cgPushIntLit(0) // addr
        cgPushIntLit(0) // lst
        cgPushIntLit(0) // idx
        cgPushIntLit(0) // mp
        cgPushIntLit(0) // key255
        cgJsrByName(rnUiEdit)
        cgCleanupStack(36)
        return
    }
    if kind == 1 {
        // Global or window-scoped per-instance record variable -- src AND
        // addr both point at it (opA re-evaluated: side-effect-free, see
        // this function's own header comment). isNew=0, wbKind=1
        // (RT_UI_WB_ADDR).
        cgPushIntLit(winIdx)
        cgExprAddr(a1)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgPushIntLit(0) // isNew
        cgPushIntLit(1) // wbKind = RT_UI_WB_ADDR
        cgExprAddr(a1)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgPushIntLit(0) // lst
        cgPushIntLit(0) // idx
        cgPushIntLit(0) // mp
        cgPushIntLit(0) // key255
        cgJsrByName(rnUiEdit)
        cgCleanupStack(36)
        return
    }
    if kind == 2 {
        // List element -- idx (opB=a2) evaluated exactly once into a
        // scratch slot; src is rtListAt(lst, idx)'s own ptr result,
        // re-derived here (rtUiEdit copies immediately, so the transient
        // pointer is safe), also stashed since the final call's own arg
        // pushes intervene. wbKind=2 (RT_UI_WB_LIST).
        idxOff = cgAllocTmpOff(irIntT)
        cgExpr(a2)
        cgStoreD0At(6, idxOff, irIntT)

        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        a68Emit(OpMove, 4, AmDisp16, 6, idxOff, AmDn, 0, 0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnListAt)
        cgCleanupStack(8)
        srcOff = cgAllocTmpOff(irPtrT)
        cgStoreD0At(6, srcOff, irPtrT)

        cgPushIntLit(winIdx)
        a68Emit(OpMove, 4, AmDisp16, 6, srcOff, AmDn, 0, 0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgPushIntLit(0) // isNew
        cgPushIntLit(2) // wbKind = RT_UI_WB_LIST
        cgPushIntLit(0) // addr
        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        a68Emit(OpMove, 4, AmDisp16, 6, idxOff, AmDn, 0, 0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgPushIntLit(0) // mp
        cgPushIntLit(0) // key255
        cgJsrByName(rnUiEdit)
        cgCleanupStack(36)
        return
    }
    if kind == 3 {
        // Map element -- the key (opB=a2, any str expr) is copied into a
        // Str255 scratch once (rtStrStore), a fresh default T is
        // constructed into a big-tmp scratch and filled from the map via
        // rtMapGetDv, THEN rtUiEdit runs. wbKind=3 (RT_UI_WB_MAP).
        keyOff = cgAllocBigTmpOff(irStrType(255))
        cgExprAddr(a2)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgPushIntLit(255)
        a68Emit(OpLea, 0, AmDisp16, 6, keyOff, AmAn, 0, 0)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnStrStore)
        cgCleanupStack(12)

        recNameIdx = cpFindWindowFormRecName(winName)
        recType = irRecType(recNameIdx)
        tmpOff = cgAllocBigTmpOff(recType)
        cgRecordCtorAt(6, tmpOff, recNameIdx)

        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        a68Emit(OpLea, 0, AmDisp16, 6, keyOff, AmAn, 0, 0)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        a68Emit(OpLea, 0, AmDisp16, 6, tmpOff, AmAn, 0, 0)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnMapGetDv)
        cgCleanupStack(12)

        cgPushIntLit(winIdx)
        a68Emit(OpLea, 0, AmDisp16, 6, tmpOff, AmAn, 0, 0)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgPushIntLit(0) // isNew
        cgPushIntLit(3) // wbKind = RT_UI_WB_MAP
        cgPushIntLit(0) // addr
        cgPushIntLit(0) // lst
        cgPushIntLit(0) // idx
        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        a68Emit(OpLea, 0, AmDisp16, 6, keyOff, AmAn, 0, 0)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnUiEdit)
        cgCleanupStack(36)
        return
    }
    // Fail-closed (5d's own lesson): any shape outside the checked/lowered
    // 4 kinds stops the build loudly rather than silently mis-marshaling.
    abort("cg68k: ui_edit: unsupported kind " + numToStr(kind) + " (must be 0-3)")
}

// cgIntrAbort (attempt-abort phase Task 4, design doc %3.2 point 1)
// implements `abort(msg)`: evaluate msg's address, clamp-store it into
// clar_abort_msg via the existing rtStrStore machinery (the exact same
// push shape cgDefaultInitStrAt already uses for a fixed A5-relative
// destination -- dst, dstcap, src, in that declaration order), set the
// flag, then branch to the current bail target. An `abort` written
// directly inside an `attempt` body needs no special case: cgAbortTarget
// already resolves to that attempt's own handler entry, exactly as any
// checked call's own check would (design doc %3.2's own "no special
// case" framing).
//
// Always reachable with cgCurFuncHasBail true: checkAttemptStmt/
// checkIdentCall's own cnAbort arm set lowUsesAbort during CHECKING,
// which always fully completes before lowering starts a single function
// (task-2-report's own ordering argument) -- so any function containing
// a real `abort(...)` call is, by construction, a non-runtime-origin
// function in an already abort-enabled program, exactly the condition
// lowFuncBody always builds a real bail chain for.
func cgIntrAbort(e: int) {
    var fi: int
    var a0e: int

    a0e = irIntrArgsHead(e)
    fi = findIRFuncIdxByName(rnStrStore)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: rtStrStore not found/reachable")
    }
    a68Emit(OpLea, 0, AmDisp16, 5, cgAbortMsgOff, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0) // push dst (&clar_abort_msg)
    a68Emit(OpMove, 4, AmImm, 0, 255, AmPreDec, 7, 0) // push dstcap
    cgExprAddr(a0e)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0) // push src (&msg)
    cgCallFunc(fi)
    cgCleanupStack(12)
    a68Emit(OpMove, 1, AmImm, 0, 1, AmDisp16, 5, cgAbortFlagOff) // flag = true
    a68EmitBr(OpBra, 0, cgAbortTarget())
}

func cgIntrUi(e: int, nm: int) {
    var a0: int
    var a1: int
    var a2: int
    var winIdx: int
    var winName: string
    var winNameIdx: int
    var fi: int

    a0 = irIntrArgsHead(e)
    a1 = -1
    a2 = -1
    if a0 != -1 {
        a1 = irExprNext(a0)
    }
    if a1 != -1 {
        a2 = irExprNext(a1)
    }
    // winName is only meaningful for the handful of intrinsics whose own
    // `.ty` is hijacked to carry a window name (IUiOpen/IUiFront/
    // IUiStateDefaults/IUiEdit -- ir.cla's own doc comment on each);
    // every other intrinsic's `.ty` is its ordinary return type, whose
    // irtName is -1 (irSimpleType's "no name" convention) -- poolGet(-1)
    // crashes (the same hazard cgFieldRefAddr's own KErr arm already
    // guards against), so this is computed defensively, never assumed.
    winNameIdx = irtName(irExprType(e))
    winName = ""
    if winNameIdx != -1 {
        winName = poolGet(winNameIdx)
    }

    if nm == IUiOpen() {
        winIdx = cpFindWindowIndex(winName)
        cgPushIntLit(winIdx)
        cgJsrByName(rnUiOpen)
        cgCleanupStack(4)
        return
    }
    if nm == IUiFront() {
        winIdx = cpFindWindowIndex(winName)
        cgPushIntLit(winIdx)
        cgJsrByName(rnUiFront)
        cgCleanupStack(4)
        return
    }
    if nm == IUiClose() {
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnUiClose)
        cgCleanupStack(4)
        return
    }
    if nm == IUiQuit() {
        cgJsrByName(rnUiQuit)
        return
    }
    if nm == IUiState() {
        // Result (D0) is the window's per-instance state-struct address --
        // cgFieldRefAddr's own KUiState arm (its base-address-is-the-
        // value special case, mirroring KOverlay) reads this same value
        // straight back out of D0 when this intrinsic sits as an
        // EFieldRef's base (`g.x`); reached here in bare value context
        // only via that same recursive cgExpr call, so no extra work
        // needed -- rtUiState's own return value already IS the answer.
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnUiState)
        cgCleanupStack(4)
        return
    }
    if nm == IUiStateDefaults() {
        cgIntrUiStateDefaults(e, a0, winName)
        return
    }
    if nm == IUiSetTitle() {
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExprAddr(a1)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnUiSetTitle)
        cgCleanupStack(8)
        return
    }
    if nm == IUiSetCaption() or nm == IUiSetText() {
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        if nm == IUiSetCaption() {
            cgPushIntLit(cgRtuiPropCaption)
        } else {
            cgPushIntLit(cgRtuiPropText)
        }
        cgExprAddr(a2)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnUiWidgetSetStr)
        cgCleanupStack(16)
        return
    }
    if nm == IUiSetTextviewText() {
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExpr(a2)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnUiWidgetSetText)
        cgCleanupStack(12)
        return
    }
    if nm == IUiGetChecked() or nm == IUiGetEnabled() {
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        if nm == IUiGetChecked() {
            cgPushIntLit(cgRtuiPropChecked)
        } else {
            cgPushIntLit(cgRtuiPropEnabled)
        }
        cgJsrByName(rnUiWidgetGetBool)
        cgCleanupStack(12)
        return
    }
    if nm == IUiSetChecked() or nm == IUiSetEnabled() {
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        if nm == IUiSetChecked() {
            cgPushIntLit(cgRtuiPropChecked)
        } else {
            cgPushIntLit(cgRtuiPropEnabled)
        }
        cgExpr(a2)
        // bool arg to an ORDINARY Clarus call (rtUiWidgetSetBool), NOT a
        // pascal trap: cgPushArgs' own byte-push convention applies here
        // (MOVE.B, not MOVE.W -- see that function's header comment). A
        // MOVE.W push instead left the pushed value at the slot's HIGH
        // (later) address while cgLoadVar's param read always looks at the
        // slot's BASE (lower) address, so the callee always saw 0 for a
        // `true` argument (Task 14 native-5e gate: buttons scenario's `T
        // SET Panel.On.checked 1` traced as 0).
        a68Emit(OpMove, 1, AmDn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnUiWidgetSetBool)
        cgCleanupStack(14)
        return
    }
    if nm == IUiGetWidth() or nm == IUiGetHeight() or nm == IUiGetSelected() {
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        if nm == IUiGetWidth() {
            cgPushIntLit(cgRtuiPropWidth)
        } else if nm == IUiGetHeight() {
            cgPushIntLit(cgRtuiPropHeight)
        } else {
            cgPushIntLit(cgRtuiPropSelected)
        }
        cgJsrByName(rnUiWidgetGetInt)
        cgCleanupStack(12)
        return
    }
    if nm == IUiSetSelected() {
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgPushIntLit(cgRtuiPropSelected)
        cgExpr(a2)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnUiWidgetSetInt)
        cgCleanupStack(16)
        return
    }
    if nm == IUiMenuEnable() {
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExpr(a2)
        // Same ordinary-call byte-push fix as ui_set_checked/ui_set_enabled
        // above (rtUiMenuEnable's bool param) -- MOVE.B, not MOVE.W.
        a68Emit(OpMove, 1, AmDn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnUiMenuEnable)
        cgCleanupStack(10)
        return
    }
    if nm == IUiCancel() {
        // `cancel` writes 1 through the dispatcher-owned scratch pointer
        // (cgUiCurCancelOff's own below-A5 cell) IUiSetCancelFlag already
        // pointed at this window's own cancelFlag: MOVEA.L off(A5),A0
        // loads the REMEMBERED ADDRESS, then MOVE.L #1,(A0) writes
        // through it.
        a68Emit(OpMovea, 4, AmDisp16, 5, cgUiCurCancelOff, AmAn, 0, 0)
        a68Emit(OpMove, 4, AmImm, 0, 1, AmInd, 0, 0)
        return
    }
    if nm == IUiCanvasClear() {
        cgIntrUiForward(e, rnUiCanvasClear)
        return
    }
    if nm == IUiCanvasLine() {
        cgIntrUiForward(e, rnUiCanvasLine)
        return
    }
    if nm == IUiCanvasRect() {
        cgIntrUiForward(e, rnUiCanvasRect)
        return
    }
    if nm == IUiCanvasCircle() {
        cgIntrUiForward(e, rnUiCanvasCircle)
        return
    }
    if nm == IUiCanvasFillCircle() {
        cgIntrUiForward(e, rnUiCanvasFillCircle)
        return
    }
    if nm == IUiCanvasPattern() {
        cgIntrUiForward(e, rnUiCanvasPattern)
        return
    }
    if nm == IUiCanvasDrawText() {
        cgIntrUiCanvasDrawText(e)
        return
    }
    if nm == IUiSetCancelFlag() {
        // Void; one ptr arg -- the synthesized clar_ui_fire_winevent's
        // RTUI_EV_CLOSEREQUEST arm points clar_ui_cur_cancel-equivalent
        // storage at the runtime's own cancelFlag before calling into the
        // user's closeRequest handler; `cancel` (ui_cancel, above) writes
        // through that same slot.
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmDisp16, 5, cgUiCurCancelOff)
        return
    }
    if nm == IUiValueAtPtr() {
        // *(T *)(a0) -- read the by-value KRec/KStr result straight out
        // of the address a0 evaluates to; only reached in a str/rec
        // MATERIALIZATION context (cgEmitStoreStr/cgEmitStoreRec's own
        // ECallFn/EIntr source dispatch would need its own arm for this
        // -- deferred, same as GetTitle/GetFieldText/GetTextviewText,
        // above: no golden scenario this task gates on exercises it).
        abort("cg68k: ui_value_at_ptr: str/rec result materialization not wired this task")
    }
    if nm == IUiAddrOfGlobal() {
        // LEA d16(A5),D0 -- a0 is always a bare EVarRef(global) (ir.cla's
        // own doc comment); cgExprAddr already resolves that to the
        // global's own A5-relative address.
        cgExprAddr(a0)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmDn, 0, 0)
        return
    }
    if nm == IUiGetTitle() or nm == IUiGetFieldText() or nm == IUiGetLabelText() {
        // KStr (fixed-capacity, non-scalar) -- never reaches cgExpr's
        // VALUE context by construction (cgEmitStoreStr's own arms handle
        // all three, Task 14/native-gaps-cleanup Task 5); a real reach
        // here would mean some OTHER src context fed a KStr EIntr straight
        // to cgExpr, the exact hazard that function's own header comment
        // fails loud on.
        abort("cg68k: " + poolGet(nm) + ": KStr materialization reached cgExpr value context -- bind/store it instead (cgEmitStoreStr's own arm)")
    }
    if nm == IUiGetTextviewText() {
        // Task 14 (native-5e gate, textwidgets.cla): `textview.text` read
        // -- KText is scalar-sized (a bare ptr, cgIsScalarKind), so unlike
        // ui_get_field_text/ui_get_title's KStr materialize-in-place
        // shape, this one yields its result in D0 like any other cgExpr
        // value: a fresh rtTextNew() box, filled by
        // rtUiWidgetGetText(instV, wIdx, out). The fresh box's own D0
        // result is stashed on the stack (cgCallFunc's own "no callee-
        // saved registers" rule applies here exactly as it does to
        // cgDefaultInitTextAt's near-identical hazard, above) across the
        // instV/wIdx evaluation, then re-read (a plain stack peek, not a
        // register) to push as the 3rd arg, and popped back into D0 as
        // the final result.
        fi = findIRFuncIdxByName(rnTextNew)
        if fi == -1 or not shakeReachable(fi) {
            abort("cg68k: rtTextNew not found/reachable")
        }
        cgCallFunc(fi)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExpr(a0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgExpr(a1)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        a68Emit(OpMove, 4, AmDisp16, 7, 8, AmDn, 0, 0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(rnUiWidgetGetText)
        cgCleanupStack(12)
        a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 0, 0)
        return
    }
    if nm == IUiAskOpen() or nm == IUiAskSave() or nm == IUiAskSaveChanges() or nm == IUiFormIsNew() {
        // Task 14 (native-5e gate, dialogs.cla/texteditor.cla): askOpen/
        // askSave/askSaveChanges/x.isNew are ALREADY-PORTED plain Clarus
        // functions (uidialogs.cla's rtUiAskOpen/rtUiAskSave/
        // rtUiAskSaveChanges/rtUiFormIsNew -- real StandardFile trap
        // marshaling AND the RT_MAC_TEST scripted answer-queue substitute
        // both already live there, in Clarus, gated on rtUiTestMode) --
        // this is a bare forwarding call, the exact cprint.cla arg shape
        // (fpAddrable's own address-of for an out-param, fpStrAddr's own
        // address-of for a read-only str), no pascal/trap marshaling of
        // any kind needed here at all.
        if nm == IUiAskOpen() {
            // askOpen(path, types) -- native-gaps-cleanup Task 2: types
            // (a1) is a new trailing arg, same by-address Str255 shape as
            // path -- forward it exactly like ui_ask_save's own suggested
            // arg just below.
            fi = findIRFuncIdxByName(rnUiAskOpen)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: rtUiAskOpen not found/reachable")
            }
            cgExprAddr(a0)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgExprAddr(a1)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgCallFunc(fi)
            cgCleanupStack(8)
        } else if nm == IUiAskSave() {
            fi = findIRFuncIdxByName(rnUiAskSave)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: rtUiAskSave not found/reachable")
            }
            cgExprAddr(a0)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgExprAddr(a1)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgCallFunc(fi)
            cgCleanupStack(8)
        } else if nm == IUiAskSaveChanges() {
            fi = findIRFuncIdxByName(rnUiAskSaveChanges)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: rtUiAskSaveChanges not found/reachable")
            }
            cgExprAddr(a0)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgCallFunc(fi)
            cgCleanupStack(4)
        } else {
            fi = findIRFuncIdxByName(rnUiFormIsNew)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: rtUiFormIsNew not found/reachable")
            }
            cgCallFunc(fi)
        }
        return
    }
    if nm == IUiEdit() {
        cgIntrUiEdit(e, a0, a1, a2, winName)
        return
    }

    abort("cg68k: cgIntrUi: unsupported UI intrinsic " + poolGet(nm))
}

// cgIntrUiForward is the common shape for every UI canvas-draw intrinsic
// (Clear/Line/Rect/Circle/FillCircle/Pattern): the intrinsic's own args
// map 1:1, IN ORDER, onto fnName's own Clarus params (instV, wIdx, then
// whichever int/bool geometry args) -- an EXACT match with cgPushArgs'
// own per-type push convention (int/ptr .L, bool .W, matching
// cgEmitFunc's own param-offset assignment), so no hand-rolled arg
// marshaling is needed, unlike the PROP-injecting getters/setters above
// or DrawText's trailing str-by-address arg (cgIntrUiCanvasDrawText,
// below) -- both of which diverge from a plain 1:1 forward.
func cgIntrUiForward(e: int, nameIdx: int) {
    var total: int
    var savedReleases: list of int

    // param-abi phase, Task 6: same save/flush bracket as cgCallFnScalar/
    // cgCallFnInto -- fnName is an ordinary Clarus function (rtUi*), so a
    // KStr/KRec arg of its own follows the SAME by-address ABI and can
    // schedule the same pending releases (harmless no-op when it doesn't).
    savedReleases = cgSaveArgReleases()
    total = cgPushArgs(irIntrArgsHead(e))
    cgJsrByName(nameIdx)
    cgCleanupStack(total)
    cgFlushArgReleases(savedReleases)
}

// cgIntrUiCanvasDrawText: rtUiCanvasDrawText(instV, wIdx, x, y, s: ptr) --
// s is pushed BY ADDRESS (cprint's own fpStrAddr(a4)), NOT block-copied
// by value the way cgPushArgs' generic KStr branch would (that branch
// exists for an ORDINARY str-by-value Clarus param, which s: ptr is not)
// -- the one canvas call needing hand-rolled marshaling.
func cgIntrUiCanvasDrawText(e: int) {
    var a0: int
    var a1: int
    var a2: int
    var a3: int
    var a4: int

    a0 = irIntrArgsHead(e)
    a1 = irExprNext(a0)
    a2 = irExprNext(a1)
    a3 = irExprNext(a2)
    a4 = irExprNext(a3)

    cgExpr(a0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a1)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a2)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a3)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(a4)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnUiCanvasDrawText)
    cgCleanupStack(20)
}

// cgIntrUiStateDefaults ports IUiStateDefaults's own per-field construction
// (cprint.cla's arm, cpDefaultInit per ctor-needing field) -- for each of
// winName's state fields that irtNeedsCtor, re-fetch the state base
// address (a fresh rtUiState(inst) call, deliberately NOT hoisted out of
// the loop: cheap, and sidesteps cgWalkStashBase's whole A0/A1-drift
// concern entirely -- a fresh, un-aliased A0 at the start of EVERY
// cgDefaultInitAt call, never carried across one) and construct that one
// field via cgDefaultInitAt, the same primitive cgEmitFunc's own record-
// local prologue and cgRecordCtorAt already use.
func cgIntrUiStateDefaults(e: int, a0: int, winName: string) {
    var winIdx: int
    var f: int
    var off: int
    var t: int

    winIdx = cpFindWindowIndex(winName)
    if winIdx == -1 {
        abort("cg68k: ui_state_defaults: unknown window " + winName)
    }
    f = irWindowDescStateFieldsHead(winIdx)
    off = 0
    while f != -1 {
        t = irFieldSlotType(f)
        off = cgAlignUp(off, cgAlignOf(t))
        if irtNeedsCtor(t) {
            cgExpr(a0)
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
            cgJsrByName(rnUiState)
            cgCleanupStack(4)
            a68Emit(OpMovea, 4, AmDn, 0, 0, AmAn, 0, 0)
            cgDefaultInitAt(0, off, t, 0, -1)
        }
        off = off + cgSlotSizeOf(t)
        f = irFieldSlotNext(f)
    }
}

// cgUiCurCancelOff: the closeRequest scratch pointer's own below-A5
// displacement (cprint's file-scope `static long *clar_ui_cur_cancel;`,
// cpEmitUiDescs) -- a 4-byte cell holding the ADDRESS of whichever
// cancelFlag the currently-firing closeRequest dispatch pointed it at
// (IUiSetCancelFlag), which `cancel` (IUiCancel) then writes 1 through.
// Computed once by cgAssignGlobalOffsets (reserved alongside the
// compiler's ordinary irGlobals block -- see that function's own Task 12
// doc comment), zeroed for free by the startup zero-loop.
var cgUiCurCancelOff: int = 0

// cgAbortFlagOff/cgAbortMsgOff (attempt-abort phase Task 4, design doc
// %3.2/%3.3): the two synthesized below-A5 globals `abort(msg)`/the
// post-call check read and write -- a 1-byte (2-byte-padded, so the
// below-A5 block stays even, cgAssignGlobalOffsets' own even-sum
// invariant) flag and a Str255 (256 bytes) message buffer. Same
// mechanism cgUiCurCancelOff above already establishes (an extra
// below-A5 cell reserved by cgAssignGlobalOffsets, zeroed for free by
// the startup zero-loop) -- gated on `lowUsesAbort` (check.cla) rather
// than unconditional, since a no-feature program must reserve zero extra
// bytes here (design doc %3.4's byte-identity requirement). Mirrors
// cprint.cla's own `clar_aborting`/`clar_abort_msg` file-scope globals
// exactly, one A5 cell each instead of one C static each.
var cgAbortFlagOff: int = 0
var cgAbortMsgOff: int = 0

func cgExpr(e: int) {
    var k: IRExprKind

    k = irExprKind(e)
    if k == EIntConst {
        a68Emit(OpMove, 4, AmImm, 0, irIntConstV(e), AmDn, 0, 0)
    } else if k == EVarRef {
        if cgIsScalarKind(irtKind(irExprType(e))) {
            cgLoadVar(e)
        } else {
            // Task 14.7: silent-zero is forbidden -- a non-scalar (str/
            // rec/arr) EVarRef reaching bare D0-value context is a real
            // compiler gap (this backend has no way to fit a >4-byte
            // value in D0), not a safe degrade. Every legal source of a
            // str/rec/arr VALUE routes through cgExprAddr or the
            // SStoreStr/SAssign/SReturn dispatchers instead; reaching
            // here means some caller fed a non-scalar expr to cgExpr
            // directly -- fail loud so it's found and fixed there.
            abort("cg68k: cgExpr: EVarRef non-scalar (str/rec/arr) reached in value context -- bind/store it instead of reading its value directly")
        }
    } else if k == EFieldRef {
        if cgIsScalarKind(irtKind(irExprType(e))) {
            cgLoadFieldScalar(e)
        } else {
            abort("cg68k: cgExpr: EFieldRef non-scalar (str/rec/arr) reached in value context -- bind/store it instead of reading its value directly")
        }
    } else if k == EIndexRef {
        // Task 13: a bare `arr[i]`/`list[i]` READ is a non-owning BORROW
        // (fpIndexRef's own C output is a raw dereference, never routed
        // through a retaining accessor like first()/last()/get()) -- a
        // heap-typed element read this way needs no retain HERE; if it
        // flows into a named-slot store, lower.cla's own lowCountedStoreVal
        // funnel already injects the IRetain this file's existing "retain"
        // cgIntr arm handles (Task 12), same as any other non-birth
        // aliasing source. cgLoadFieldScalar is generic (any cgExprAddr-
        // resolvable lvalue, not EFieldRef-specific despite its name).
        if cgIsScalarKind(irtKind(irExprType(e))) {
            cgLoadFieldScalar(e)
        } else {
            abort("cg68k: cgExpr: EIndexRef non-scalar (str/rec) element reached in value context -- bind/store it instead of reading its value directly")
        }
    } else if k == EXRecAddr {
        // Task 6 (toolbox-integration Feature B): an EXRecAddr's own VALUE
        // is the address it computes -- the identical LEA cgExprAddr's own
        // EXRecAddr arm emits, just brought across to D0 (this backend's
        // universal "value lives in D0" contract) instead of left in A0.
        // Reached for: peek*/poke*'s own address argument (cgIntrPeek/
        // cgIntrPoke both cgExpr their a0), IXRecStrRead/Write's fieldAddr
        // argument, and whole-record decay at an extern call site
        // (lowCallArgs' own EXRecAddr-as-ptr-arg, marshaled by the SAME
        // generic cgExpr(arg) every other ECallExt ptr argument already
        // goes through).
        a68Emit(OpLea, 0, AmDisp16, cgXRecAddrReg(e), cgXRecAddrDisp(e), AmAn, 0, 0)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmDn, 0, 0)
    } else if k == EBin {
        cgBin(e)
    } else if k == EUn {
        cgUn(e)
    } else if k == EConv {
        cgConv(e)
    } else if k == ECallFn {
        cgCallFnScalar(e)
    } else if k == EIntr {
        cgIntr(e)
    } else if k == ECallExt {
        cgCallExt(e)
    } else if k == ECbAddr {
        // Task 8 (toolbox-integration Feature C): an ECbAddr's own VALUE
        // is its glue's callable JT-slot address -- cgCallExtUiGlueAddr's
        // generic "LEA jtDisp(A5),A0; MOVE.L A0,D0" shape, aimed at
        // "clar_cb_<name>". Only ever reached at a checker-legal decay
        // position (an extern call's ptr-typed argument, a bare callback
        // name -- lower.cla's lowCallArgs) -- a ptr-typed call argument
        // always routes through cgExpr, never cgExprAddr (task-7-report's
        // own probe already confirmed this).
        cgCallExtUiGlueAddr("clar_cb_" + poolGet(irCbAddrName(e)))
    } else {
        // EStrConst (str value in a scalar context), ENewRec (constructed
        // directly into its destination by cgEmitStoreRec/cgEmitReturnRec,
        // never legally reached in bare value context). Task 14.7: no
        // silent-zero degrade -- fail loud naming the kind, matching every
        // other "should never happen" arm in this file.
        abort("cg68k: cgExpr: expr kind " + numToStr(int(k)) + " has no value-context representation (str/rec construct -- bind/store it instead)")
    }
}

// ================================================================
// Task 8: calls -- cgCallFn convention (see the brief): args pushed
// LEFT-TO-RIGHT in declaration order (so the LAST-declared arg lands at
// the lowest stack address, matching the callee's own 8(A6)-upward frame
// -- cgEmitFunc's own worked example); a hidden result pointer (str/
// record return, cgSizeOf > 4) is pushed LAST of all; caller cleans up
// (ADDQ.L <=8, else ADDA.W).
// ================================================================

func cgCleanupStack(n: int) {
    if n == 0 {
        return
    }
    if n <= 8 {
        a68Emit(OpAddq, 4, AmImm, 0, n, AmAn, 7, 0)
    } else {
        a68Emit(OpAdda, 2, AmImm, 0, n, AmAn, 7, 0)
    }
}

// cgBlockCopy copies size bytes from (A0) to (A1), both advancing --
// unrolled MOVE.W for a small (<=16 byte) copy, else a MOVE.W/DBRA loop
// (clobbers D0), plus a single trailing MOVE.B when size is odd. size was
// always even for every caller before Task 6 (cgSizeOf(KStr)/cgSlotSizeOf
// round every type up to an even size) -- a packed char array/extern-record
// (cgArrElemStride, Task 6: a char element's stride is 1, no padding) can
// now be an odd cgSizeOf (e.g. a plain `char[3]` local), so the trailing
// byte can no longer be assumed away.
func cgBlockCopy(size: int) {
    var words: int
    var i: int
    var loopLbl: int

    words = size / 2
    if words <= 8 {
        i = 0
        while i < words {
            a68Emit(OpMove, 2, AmPostInc, 0, 0, AmPostInc, 1, 0)
            i = i + 1
        }
    } else {
        a68Emit(OpMove, 2, AmImm, 0, words - 1, AmDn, 0, 0)
        loopLbl = a68NewLabel()
        a68Bind(loopLbl)
        a68Emit(OpMove, 2, AmPostInc, 0, 0, AmPostInc, 1, 0)
        a68Emit(OpDbra, 2, AmDn, 0, 0, AmPCLabel, 0, loopLbl)
    }
    if size mod 2 == 1 {
        a68Emit(OpMove, 1, AmPostInc, 0, 0, AmPostInc, 1, 0)
    }
}

// cgPendingArgReleases (param-abi phase, Task 6) is a flat list of
// (off, recNameIdx) pairs -- one per handle-bearing KRec call-arg temp
// cgPushArgs materialized THIS call that owns a reference (either a fresh
// birth -- ECallFn/ENewRec, already +1 from the callee's own return-value
// retain / the constructor's own birth -- or an explicit retain this file
// just emitted for an aliasing copy). Each must be released once the
// call it was pushed for returns; Clarus has no out-params, so this is a
// module global, exactly like cgLastTrackedOff/cgDiscardExprIdx above.
//
// Reentrancy: cgPushArgs' own materialize branch can re-enter the call
// path (a nested ECallFn/ENewRec argument, e.g. `f(g(makeRec()))`'s inner
// `g(...)`, materializes via cgMaterializeToTemp -> cgEmitStoreRec ->
// cgCallFnInto, which calls cgPushArgs AGAIN for g's own args) -- an
// inner call's own pending releases must be walked and cleared BEFORE
// control returns to the outer cgPushArgs loop, not merged into or
// deferred past it: the SAME big-pool temp slot can be reallocated to a
// LATER argument within the same statement (cgAllocBigTmpOff's own
// per-statement bump allocator), so a deferred release could fire against
// whatever unrelated value has since been written there. cgSaveArgReleases/
// cgFlushArgReleases below save/reset/restore this list around every
// direct cgPushArgs call site (cgCallFnScalar, cgCallFnInto,
// cgIntrUiForward, cgCallExtNatFallback, cgCallExtUiSynth) -- the same
// "state survives a nested call, uncorrupted, because it was saved first"
// discipline this file's own A1-stash sites already established (see the
// removed cgMaterializeDepth's doc comment, ~1369, for the register-based
// precedent this module-var version follows).
var cgPendingArgReleases: list of int

// cgSaveArgReleases stashes the CURRENT (possibly in-progress, from an
// outer call still mid-arg-evaluation) pending-release list and installs a
// fresh empty one for the call about to run its own cgPushArgs -- pair
// with cgFlushArgReleases once that call (and its cleanup) is done.
func cgSaveArgReleases(): list of int {
    var saved: list of int

    saved = cgPendingArgReleases
    cgPendingArgReleases = cgFreshIntList()
    return saved
}

// cgFlushArgReleases releases every (off, recNameIdx) pair THIS call's own
// cgPushArgs scheduled (cgEmitRecWalkCall's own no-op guard means a
// non-handle-bearing entry never reaches this list at all -- nothing to
// gate here), then restores the caller's own (possibly still in-progress)
// list from before cgSaveArgReleases.
//
// D0/D1 hazard (found via native suite-boot verification, not by static
// review): cgCallFnScalar's own return value lands in D0 (cgCallFunc's own
// convention) BEFORE this function runs -- cgEmitRecWalkCall's JSR to
// cg_release_<Rec> is an ordinary function call under this file's own
// "no callee-saved registers" rule, so it's free to clobber D0/D1 like any
// other. Left unprotected, a scalar/handle-return call whose OWN args
// needed a scheduled release (e.g. `readParamDocBody(makeNestedDoc()) !=
// "nested"`) had its just-returned D0 value stomped by the release walk
// before the caller ever read it -- reproduced natively (not on host, C's
// own call stack has no such hazard) as a bogus comparison result, NOT a
// refcount/leak symptom. D0/D1 are saved on the stack across the WHOLE
// walk (a single push/pop pair, not per-entry) and restored before
// returning, protecting every one of this function's 6 call sites
// uniformly rather than requiring each to know about the hazard itself.
func cgFlushArgReleases(saved: list of int) {
    var i: int

    if cgPendingArgReleases.count > 0 {
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        a68Emit(OpMove, 4, AmDn, 1, 0, AmPreDec, 7, 0)
    }
    i = 0
    while i < cgPendingArgReleases.count {
        cgEmitRecWalkCall(false, 6, cgPendingArgReleases[i], cgPendingArgReleases[i + 1])
        i = i + 2
    }
    if cgPendingArgReleases.count > 0 {
        a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 1, 0)
        a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 0, 0)
    }
    cgPendingArgReleases = saved
}

// cgPushArgs pushes e's own argument chain (irCallFnArgsHead-shaped),
// left to right, returning the total bytes pushed. Each arg's OWN type
// (already coerced to the callee's param type by lower.cla's
// lowCallArgs) decides push shape:
//
// A KStr/KRec argument (param-abi phase, Task 6: by-ADDRESS now, always
// exactly cgArgSlotSize==4 bytes, regardless of the value's true size --
// the callee's own frame slot holds a pointer, cgEmitFunc's matching
// change) either BORROWS the source's own address (cgIsAddressableArgShape
// true -- a real lvalue/literal -- AND irArgNeedsCopy(a) false -- Task 3's
// single classification authority, consumed verbatim here, never
// re-derived) or is first MATERIALIZED into a fresh big-pool temp
// (cgMaterializeToTemp) whose address is pushed instead:
//   - Literal-borrow safety (Step 5): a borrowed EStrConst is safe because
//     the ONE primitive this backend ever routes a string CONTENT copy
//     through, rtStrStore (runtime/clarus/str.cla), reads the SOURCE's
//     own length byte (peekb) and copies min(srclen, dstcap) bytes --
//     never more than srclen+1 bytes from the source regardless of the
//     destination's capacity. A pool literal is exactly len+1 bytes
//     (COMPACT literal layout, ~11274-11298), so it can never be read
//     past its own real length -- no materialize-first fallback needed.
//   - cgMaterializeToTemp's existing dispatch (cgEmitStoreRec/
//     cgEmitStoreStr) already handles every source kind reaching the
//     materialize branch CORRECTLY and DIRECTLY -- an ENewRec constructs
//     straight into the temp (cgRecordCtorAt), an ECallFn calls straight
//     into it as the hidden-result pointer (cgCallFnInto), an EIntr
//     (str_concat/list_pop/map_get/etc) builds into it via its own
//     existing builder -- no separate "reserve the arg's own stack slot
//     and construct into THAT" machinery is needed the way the OLD
//     by-value ABI required (cgPushArgMaterialized/cgMaterializeCallResult/
//     cgMaterializeStrCoerce, all removed this task): the arg's own stack
//     slot is now just a 4-byte address, decoupled from where the value
//     actually lives, so there is no ordering constraint left to protect
//     with the old A1-stash-across-nested-cgPushArgs dance.
//   - Ownership (the exact leak Task 5's cprint fix round 1 found and
//     fixed on the host lane -- mirrored here): an ECallFn/ENewRec source
//     is ALREADY a freshly-owned +1 (the callee's own return-value
//     retain, or a constructor's own birth) -- retaining it AGAIN here
//     would double-count, so only an ALIASING copy (EVarRef/EFieldRef/
//     EIndexRef -- reached here only when irArgNeedsCopy is true: a
//     global, or reachable through List/Map/Text/IntMap container storage
//     the callee could re-enter past the call) gets an explicit retain
//     (cgEmitRecWalkCall isRetain=true) before scheduling its release.
//     Either way the temp's own reference must be dropped once the call
//     returns -- scheduled into cgPendingArgReleases, walked by
//     cgFlushArgReleases at each of this function's own call sites.
//     final-review fix wave (UAF fix) widens this to a bare EIntr source
//     too, split by lower.cla's own owning/non-owning classification: a
//     NON-OWNING container read (map/sortedmap/intmap get(_dv[_birth]),
//     list first/last -- lowIntrIsNonOwningContainerRead, now reclassified
//     COPY by lowArgNeedsCopy, so it reaches here via irArgNeedsCopy(a))
//     gets the SAME retain+schedule as the EVarRef/EFieldRef/EIndexRef
//     aliasing case -- its materialized temp shallow-copied a handle field
//     that still aliases the container's own storage. An OWNING read
//     (list_pop/list_shift -- lowIntrIsOwningContainerRead, stays borrow,
//     never irArgNeedsCopy) gets release-only scheduling like ECallFn/
//     ENewRec -- already a freshly-owned +1 with no other owner, no retain
//     needed. Before this fix wave, a bare EIntr source got NEITHER
//     (mirroring cprint's own then-identical gap) -- see this phase's
//     final-review report for the map_get repro this closes.
//
// A bool/char scalar pushes its cgSlotSizeOf-padded 2-byte slot via
// MOVE.B, NOT MOVE.W (Task 12 fix, unchanged by this task -- see git
// history for the full byte-order account); everything else pushes 4
// (MOVE.L).
func cgPushArgs(argsHead: int): int {
    var a: int
    var t: int
    var sz: int
    var total: int
    var ak: IRExprKind
    var tmpRef: int
    var recNameIdx: int

    total = 0
    a = argsHead
    while a != -1 {
        t = irExprType(a)
        if irtKind(t) == KStr or irtKind(t) == KRec {
            sz = cgArgSlotSize(t)
            if cgIsAddressableArgShape(a, irtKind(t)) and not irArgNeedsCopy(a) {
                cgExprAddr(a)
                a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            } else {
                ak = irExprKind(a)
                tmpRef = cgMaterializeToTemp(a)
                if irtKind(t) == KRec {
                    recNameIdx = irtName(t)
                    if irRecHasHandleField(recNameIdx) {
                        if ak == ECallFn or ak == ENewRec {
                            cgPendingArgReleases.add(cgVarOff(tmpRef))
                            cgPendingArgReleases.add(recNameIdx)
                        } else if ak == EVarRef or ak == EFieldRef or ak == EIndexRef {
                            cgEmitRecWalkCall(true, 6, cgVarOff(tmpRef), recNameIdx)
                            cgPendingArgReleases.add(cgVarOff(tmpRef))
                            cgPendingArgReleases.add(recNameIdx)
                        } else if ak == EIntr and irArgNeedsCopy(a) {
                            // final-review fix wave (UAF fix, non-owning half):
                            // a bare map/sortedmap/intmap get(_dv[_birth]) or
                            // list first/last, reclassified COPY by lowering's
                            // lowIntrIsNonOwningContainerRead -- the
                            // materialize above shallow-copied a handle field
                            // that still aliases the container's own storage;
                            // same retain+schedule as the EVarRef/EFieldRef/
                            // EIndexRef aliasing-copy case just above.
                            cgEmitRecWalkCall(true, 6, cgVarOff(tmpRef), recNameIdx)
                            cgPendingArgReleases.add(cgVarOff(tmpRef))
                            cgPendingArgReleases.add(recNameIdx)
                        } else if ak == EIntr and lowIntrIsOwningContainerRead(irIntrName(a)) {
                            // final-review fix wave (UAF fix, owning half):
                            // list_pop/list_shift already transferred the +1
                            // out of the list (no retain needed), but a bare
                            // pop/shift used directly as a call argument still
                            // needs its own release once the call returns --
                            // same tracked-release-only shape as ECallFn/
                            // ENewRec above.
                            cgPendingArgReleases.add(cgVarOff(tmpRef))
                            cgPendingArgReleases.add(recNameIdx)
                        }
                    }
                }
                cgExprAddr(tmpRef)
                a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            }
        } else {
            sz = cgSlotSizeOf(t)
            if sz == 2 {
                cgExpr(a)
                a68Emit(OpMove, 1, AmDn, 0, 0, AmPreDec, 7, 0)
            } else {
                cgExpr(a)
                a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
            }
        }
        total = total + sz
        a = irExprNext(a)
    }
    return total
}

// cgIsAddressableArgShape reports whether a KStr/KRec argument expr `a` is
// an lvalue `cgExprAddr` genuinely resolves to a real address -- EVarRef/
// EFieldRef/EIndexRef (any kind, both str and record), or EStrConst (str
// only -- a literal pool entry has a real address too). Anything else
// (`ECallFn`, `ENewRec`, any other `EIntr`) is a VALUE-PRODUCING shape with
// no existing storage to take the address of -- cgPushArgs' own materialize
// branch (cgMaterializeToTemp) handles those, rather than asking
// `cgExprAddr` for an address it cannot give (task-12-review's Important
// finding: the OLD unconditional `cgExprAddr(a)` call silently read/copied
// from address 0 for exactly these shapes).
func cgIsAddressableArgShape(a: int, tk: IRKind): bool {
    var ak: IRExprKind

    ak = irExprKind(a)
    if ak == EVarRef or ak == EFieldRef or ak == EIndexRef {
        return true
    }
    if ak == EStrConst and tk == KStr {
        return true
    }
    // ui_value_at_ptr (Task 14, native-5e): a raw pointer dereference --
    // already addressable via cgExprAddr's own dedicated arm, same
    // reasoning as that arm's own doc comment.
    return ak == EIntr and irIntrName(a) == IUiValueAtPtr()
}

// cgCallFnScalar calls a user Clarus function whose return fits in D0
// (void or <=4 bytes) -- the common ECallFn shape, used from cgExpr.
// A bare, discarded call statement (`makeStr();`) whose return is a
// handle-kind (cgNeedsRelease) type would otherwise leak: D0 is dropped on
// the floor with nothing left to release it. Mirrors cgIntrListPopLike's
// own discard-detection shape (`:3955`, cgDiscardExprIdx's own doc comment,
// `:479-487`): route that ONE case through cgNewTrackedTmp + cgStoreD0At
// instead, so the ordinary end-of-statement flush (cgFreeStmtTmps) releases
// it. Every other call context (SAssign/SReturn/nested expr) is unaffected
// -- D0 is left as-is, exactly as before (final-review T13).
func cgCallFnScalar(e: int) {
    var fi: int
    var total: int
    var retType: int
    var off: int
    var dst: int
    var savedReleases: list of int

    fi = findIRFuncIdxByName(irCallFnName(e))
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: call to unknown/unreachable function " + poolGet(irCallFnName(e)))
    }
    if cgRetNeedsHidden(irFuncRet(fi)) {
        // Task 14.7 fix (review round 2: cgRetNeedsHidden, the single
        // shared authority -- see its own doc comment).
        //
        // mac-resident-clarusc Task 3: a BARE, discarded call statement to
        // a str/rec-returning function (clarusc's own `expect(TkComma)`
        // idiom in parse.cla -- consume a token, only care about the
        // side effect/diagnostic, drop the returned Token) reaches here
        // too -- cgExpr's ECallFn arm is the only route to this function,
        // and cgStmt's SExprStmt case calls cgExpr unconditionally on the
        // discarded expr, str/rec return or not. Below mirrors this same
        // function's own scalar/handle-kind discard branch (further down,
        // `cgNewTrackedTmp` + release) generalized to the >4-byte case,
        // and mirrors cgMaterializeToTemp's own KRec/KStr dispatch --
        // just TRACKED (cgNewTrackedTmp, not cgMaterializeToTemp's
        // untracked cgAllocTmpOff) so cgFreeStmtTmps releases it at
        // end-of-statement like any other discarded owning value, instead
        // of hard-erroring. A genuine non-discard str/rec value reaching
        // cgExpr in bare-scalar context (the case this error message was
        // written for) still hard-errors below.
        if e == cgDiscardExprIdx {
            retType = irFuncRet(fi)
            off = cgNewTrackedTmp(retType)
            dst = cgVarRefAt(off, retType)
            if irtKind(retType) == KRec {
                cgEmitStoreRec(dst, e)
            } else {
                cgEmitStoreStr(dst, e)
            }
            return
        }
        abort("cg68k: cgCallFnScalar used for str/rec-return function " + poolGet(irCallFnName(e)) + " (need cgCallFnInto)")
    }
    // param-abi phase, Task 6: cgSaveArgReleases/cgFlushArgReleases bracket
    // the push+call+cleanup span -- see cgPendingArgReleases' own doc
    // comment for the reentrancy this protects against.
    savedReleases = cgSaveArgReleases()
    total = cgPushArgs(irCallFnArgsHead(e))
    cgCallFunc(fi)
    cgCleanupStack(total)
    cgAbortCheckAfterCall(fi)
    cgFlushArgReleases(savedReleases)
    retType = irFuncRet(fi)
    if e == cgDiscardExprIdx and cgNeedsRelease(retType) {
        off = cgNewTrackedTmp(retType)
        cgStoreD0At(6, off, retType)
    }
}

// cgCallFnInto calls a user Clarus function whose return needs a hidden
// result pointer (str/record, cgSizeOf > 4), writing the result directly
// into dst (an addressable IRExpr -- cgExprAddr resolves it). Args push
// first, then dst's own address pushes LAST, per the calling convention.
func cgCallFnInto(e: int, dst: int) {
    var fi: int
    var total: int
    var savedReleases: list of int

    fi = findIRFuncIdxByName(irCallFnName(e))
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: call to unknown/unreachable function " + poolGet(irCallFnName(e)))
    }
    // param-abi phase, Task 6: same save/flush bracket as cgCallFnScalar --
    // this is ALSO the reentry point cgPushArgs' own materialize branch
    // uses for a nested ECallFn arg (cgMaterializeToTemp -> cgEmitStoreRec
    // -> cgCallFnInto), so the guard matters here just as much.
    savedReleases = cgSaveArgReleases()
    total = cgPushArgs(irCallFnArgsHead(e))
    cgExprAddr(dst)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    total = total + 4
    cgCallFunc(fi)
    cgCleanupStack(total)
    cgAbortCheckAfterCall(fi)
    cgFlushArgReleases(savedReleases)
}

// cgCallRuntime calls a runtime IRFunc (str.cla/etc, found by interned
// name) whose every argument is either a plain int/bool/ptr VALUE
// (argIsAddr[i]=false, cgExpr'd) or the ADDRESS of an expression
// (argIsAddr[i]=true, cgExprAddr'd) -- str.cla's whole family takes
// `ptr` params, so a str/text argument always passes as its address
// (fpStrAddr's own "&(...)" cast, mirrored here), never a block copy.
// Left-to-right, matching cgPushArgs' own convention. Returns false (having
// already logged) if name isn't a reachable IRFunc. Findings 1.4 (Task 13):
// takes an already-interned nameIdx (an rn* global at every fixed-literal
// call site, rnInit()-filled) rather than a string -- removes the
// re-intern-on-every-call-site cost findIRFuncIdxByName's own intmap fix
// doesn't touch; poolGet(nameIdx) only runs on the (rare) not-found path.
func cgCallRuntime(nameIdx: int, argExprs: list of int, argIsAddr: list of bool): bool {
    var fi: int
    var total: int
    var i: int

    fi = findIRFuncIdxByName(nameIdx)
    if fi == -1 or not shakeReachable(fi) {
        log("cg68k: runtime function " + poolGet(nameIdx) + " not found/reachable")
        return false
    }
    total = 0
    i = 0
    while i < argExprs.count {
        if argIsAddr[i] {
            cgExprAddr(argExprs[i])
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        } else {
            cgExpr(argExprs[i])
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        }
        total = total + 4
        i = i + 1
    }
    cgCallFunc(fi)
    cgCleanupStack(total)
    return true
}

// cgCallRuntime1 (attempt-abort phase Task 4) is cgCallRuntime's own
// single-address-arg specialization for a synthesized global with no IR
// node of its own (cgAbortMsgOff) -- cgCallRuntime's general API takes
// IR expr indices for every arg, which a raw A5-relative offset isn't.
// Pushes &<reg,off>, calls nameIdx by name, cleans up 4 bytes; returns
// false (having already logged, same contract as cgCallRuntime) if
// nameIdx isn't a reachable IRFunc.
func cgCallRuntime1(nameIdx: int, reg: int, off: int): bool {
    var fi: int

    fi = findIRFuncIdxByName(nameIdx)
    if fi == -1 or not shakeReachable(fi) {
        log("cg68k: runtime function " + poolGet(nameIdx) + " not found/reachable")
        return false
    }
    a68Emit(OpLea, 0, AmDisp16, reg, off, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgCallFunc(fi)
    cgCleanupStack(4)
    return true
}

// cgEmitAbortDefaultCheck (attempt-abort phase Task 4, design doc %3.5;
// Ruling: the native UI top-level default is FULL-STRENGTH, not the C
// lane's own disclosed narrowing) prints the shared top-level
// uncaught-abort default as a branch-OVER-skip (always a short, local,
// forward branch -- never a jump to some other function's label, unlike
// cgEmitAbortCheck): `if (flag) { <default>; quit 1 }`.
//
// ui=false: log(msg) then quit 1 -- the SAME observable behavior as
// today's hand-written `log(msg); quit 1` (design doc %3.5's non-UI
// default; this is why the ~150-site clarusc conversion needs no error-
// golden churn).
// ui=true: SysBeep(30) (inline trap 0xA9C8, word operand -- the brief's
// own literal spelling) + rtUiAlertMsg(msg) (A4's new runtime function:
// ALWAYS the natAlert-shaped trace line, PLUS a real dialog when not
// scripted) + quit 1 (design doc %3.5's UI default).
//
// Shared by every site that needs it (cgEmitStartup's own post-launch
// check for a UI program, and cgAbortCheckAfterCall's UI-dispatcher
// fallback below) -- one BSR per call site, not a duplicated block,
// mirroring the C lane's own review-driven cpEmitAbortDefaultCheck
// (task-3 fix round 1, C1+I1).
func cgEmitAbortDefaultCheck(ui: bool) {
    var skipLbl: int
    var fi: int

    skipLbl = a68NewLabel()
    a68Emit(OpTst, 1, AmNone, 0, 0, AmDisp16, 5, cgAbortFlagOff)
    a68EmitBr(OpBcc, 7, skipLbl) // BEQ: not aborting -> skip the default
    if ui {
        a68Emit(OpMove, 2, AmImm, 0, 30, AmPreDec, 7, 0)
        a68EmitTrap(0xA9C8, "_SysBeep")
        if not cgCallRuntime1(intern("rtUiAlertMsg"), 5, cgAbortMsgOff) {
            abort("cg68k: cgEmitAbortDefaultCheck: rtUiAlertMsg call failed")
        }
    } else {
        if not cgCallRuntime1(rnLog, 5, cgAbortMsgOff) {
            abort("cg68k: cgEmitAbortDefaultCheck: rtLog call failed")
        }
    }
    a68EmitBr(OpBsr, 0, cgFreeGlobalsLbl)
    a68Emit(OpMove, 4, AmImm, 0, 1, AmPreDec, 7, 0)
    fi = findIRFuncIdxByName(rnQuit)
    if fi != -1 and shakeReachable(fi) {
        cgCallFunc(fi)
    } else {
        if a68ListingOn {
            a68Comment("natQuit not present -- wired in Task 11")
        } else {
            a68CommentMarker()
        }
    }
    a68Bind(skipLbl)
}

// cgAbortCheckAfterCall (attempt-abort phase Task 4, design doc %3.2/
// %3.3, Ruling A1) is cgCallFnScalar/cgCallFnInto's own shared post-call
// abort-check insertion point, called immediately after their own
// cgCleanupStack -- SP is already at the LINK-baseline level there
// (task-1-report P1), so no stack-pointer math is ever needed here or at
// any bail/handler-entry/default target this can reach. fi is already
// known reachable (both callers guard fi == -1 before this point).
//
// Two shapes, depending on what the CALLING function (the one currently
// being emitted, cg68k's own module state) actually is:
//   - a lowering-synthesized UI event dispatcher (the `clar_ui_fire_*`
//     family, cgCurFuncIsUiDispatcher -- built by lower.cla's
//     lowSynthUiDispatchers via newIRFunc directly, NEVER through
//     lowFuncBody, so irFuncBail is always -1 for these: they can never
//     have a propagating bail chain of their own): the §3.5 UI default
//     fires IN PLACE, UNCONDITIONALLY (never narrowed by fi's own
//     irFuncCanAbort -- design doc %8/Task 6b ruling: a dispatcher calls
//     its user `on` handler dynamically by event, not by a fixed call
//     site an interprocedural analysis can usefully narrow, so it keeps
//     its full-strength check regardless). This is "the check after
//     each handler call in the synthesized UI dispatcher" (P4(b)'s own
//     site), and it comes for free at the call-site level -- these
//     dispatchers call the user's `on` handler through an ordinary
//     ECallFn, the exact same cgCallFnScalar/cgCallFnInto chokepoint
//     every other user call already goes through, so no per-dispatcher
//     special casing is needed HERE. This is a real lane asymmetry, not
//     just a wording nicety: cprint.cla (the C lane) has NO equivalent
//     per-dispatch check at all -- its own UI top-level default
//     (cpEmitAbortDefaultCheck) only fires after App.launch and after
//     the event loop's own return (task-3-report.md's I1), never after
//     an individual handler dispatch, because the C lane's synthesized
//     UI dispatch loop lives in runtime/clarus/ui.cla, outside
//     cprint.cla's own reach. Parked as phase debt on the demoted
//     opt-in diagnostic lane (Task 6b review, reviewer I1) rather than
//     fixed -- the only shipped UI+abort consumer (ClarusC.APPL) builds
//     native, where this full-strength check is real.
//   - an ordinary function with its own bail chain (cgCurFuncHasBail,
//     i.e. irFuncBail(f) != -1): TST.B flag / BNE to cgAbortTarget() --
//     ordinary propagation, design doc %3.2 point 3 -- but ONLY when the
//     Task 6b interprocedural analysis (irFuncCanAbort, lower.cla's
//     lowComputeCanAbort) actually proved fi can abort; a callee that
//     can't needs no check at all, the whole point of Task 6b.
//   - anything else (a runtime-origin caller -- never happens, runtime
//     code never calls user functions; or a non-dispatcher function with
//     no bail chain -- never happens either, since lowFuncBody gives
//     EVERY non-runtime-origin function a real one whenever lowUsesAbort):
//     no check at all, fail-safe rather than fatal, mirroring cprint's
//     own `fi == -1` fail-safe philosophy for speculative plumbing.
func cgAbortCheckAfterCall(fi: int) {
    if not lowUsesAbort or irFuncIsRuntimeOrigin(fi) {
        return
    }
    if cgCurFuncIsUiDispatcher {
        cgEmitAbortDefaultCheck(true)
    } else if cgCurFuncHasBail and irFuncCanAbort(fi) {
        cgEmitAbortCheck()
    }
}

// ================================================================
// Task 9: ECallExt -- native trap-call ABI. Dispatches on the extern's
// OWN registered clause (irExternConv, Task 2's registry: 1=pascal trap,
// 2=reg trap, 3=inline deref, 4=inline nop, 5=inline a5 (Task 12), 6=reg
// memerr (Task 14), 0=no clause) rather than on anything about the call
// site -- mirrors cgIntr's own by-NAME dispatch shape, one level removed
// (by clause instead of by intrinsic name).
// ================================================================

// cgExternIdxByName is irExternCount()'s own linear scan (ir.cla's
// irIsExtern runs the identical scan for its bool-only answer, but this
// file needs the INDEX too, to read back irExternConv/irExternTrap/
// irExternParam/irExternRet -- the Task 9 brief's file list only names
// cg68k.cla as a code file to touch, so the scan is re-run locally here
// rather than widening ir.cla's public surface for one caller).
func cgExternIdxByName(nameIdx: int): int {
    var i: int

    i = 0
    while i < irExternCount() {
        if irExternName(i) == nameIdx {
            return i
        }
        i = i + 1
    }
    return -1
}

// cgCallExtReg implements the locked REG rule (plan doc, 2026-07-30,
// "Design decisions locked during planning") for POSITIONAL `reg` (conv
// 2/6): ptr args -> A0,A1 in declaration order; int/bool/char args ->
// D0,D1 in declaration order. checkExternFunc guarantees at most 2 ptr +
// 2 int/bool/char args and no str/text for a positional `reg` clause, so
// there is never a 3rd slot to assign. Task 2 (toolbox-integration)
// generalizes this to also drive NAMED `reg(...)` (conv 7/8): each arg's
// register comes straight from irExternParamReg(xi, j) instead of the
// positional bucket-and-count scheme -- checkExternFunc already resolved
// and validated every binding, so cg68k just reads it back.
//
// Every arg is evaluated to the STACK first (a plain 4-byte push, left to
// right -- ptr is already 4 bytes and cgExpr's own int/bool/char values
// are always left fully zero-extended in D0, so a uniform .L push is
// correct for every reg-trap arg type), THEN popped into its target
// register in REVERSE (top-of-stack-first) order. This is the "naive but
// clobber-safe" discipline the brief calls for: cgExpr itself freely uses
// D0/D1/A0/A1 as scratch (Task 8's own evaluation-discipline doc), so
// loading arg 1 into its final register and THEN evaluating arg 2 would
// risk arg 2's own cgExpr clobbering arg 1's register before the trap
// ever runs; stack-mediated push-then-pop sidesteps that regardless of
// how many scratch registers any one arg's subexpression needs. Register
// codes follow ast.cla's regCodeForName table (d0..d2 = 0..2, a0 = 8,
// a1 = 9) for both forms -- >= 8 means an address register (An = code -
// 8), MOVEA required for the pop; a positional ptr slot 0/1 is encoded
// the same way (8/9) so both forms share one pop loop.
//
// cgRegPassArgsAndTrap is cgCallExtReg's own arg-marshaling + trap-dispatch
// half, factored out (Task 14, native-5e) so cgCallExtRegMemErr below can
// share it verbatim -- every `reg` form passes args identically and emits
// the identical trap; only what happens to the result AFTER the trap
// differs (cgCallExtReg reads the declared/defaulted result register per
// the callee's declared return type; cgCallExtRegMemErr ignores the
// result register entirely -- its real Toolbox routine is a `void`
// Pascal procedure and leaves nothing meaningful there -- and reads the
// MemErr low-memory global instead).
func cgRegPassArgsAndTrap(e: int, xi: int) {
    var a: int
    var regs: list of int
    var conv: int
    var ptrSlot: int
    var scalarSlot: int
    var rc: int
    var n: int
    var i: int
    var j: int

    conv = irExternConv(xi)
    regs = cgFreshIntList()
    ptrSlot = 0
    scalarSlot = 0
    n = 0
    j = 0
    a = irCallExtArgsHead(e)
    while a != -1 {
        cgExpr(a)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        if conv == 7 or conv == 8 {
            rc = irExternParamReg(xi, j)
        } else if irtKind(irExprType(a)) == KPtr {
            rc = 8 + ptrSlot
            ptrSlot = ptrSlot + 1
        } else {
            rc = scalarSlot
            scalarSlot = scalarSlot + 1
        }
        regs.add(rc)
        n = n + 1
        a = irExprNext(a)
        j = j + 1
    }
    i = n - 1
    while i >= 0 {
        if regs[i] >= 8 {
            a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, regs[i] - 8, 0)
        } else {
            a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, regs[i], 0)
        }
        i = i - 1
    }
    a68EmitTrap(irExternTrap(xi), poolGet(irCallExtName(e)))
}

// cgCallExtReg reads the trap's result (positional conv 2 or named conv
// 7) per the design spec's unified result-width rule: int/ptr = the full
// 32 bits of the result register; word = low 16 bits, sign-extended
// (Toolbox INTEGER/OSErr); bool/char = low byte, zero-extended. The
// result REGISTER is irExternRetReg(xi) for the named form (-1 means
// "use the default", same as positional) or always -1/default for
// positional -- default is today's rule, A0 for a ptr result, D0
// otherwise. Any non-D0 result register is first moved into D0 (MOVE.L,
// MOVEA-sourced when it's an address register) to satisfy cgExpr's own
// "value always ends in D0" postcondition; D0 itself needs no move.
func cgCallExtReg(e: int, xi: int) {
    var retTy: int
    var retReg: int

    cgRegPassArgsAndTrap(e, xi)
    retTy = irExternRet(xi)
    retReg = -1
    if irExternConv(xi) == 7 or irExternConv(xi) == 8 {
        retReg = irExternRetReg(xi)
    }
    if retReg == -1 {
        if irtKind(retTy) == KPtr {
            retReg = 8
        } else {
            retReg = 0
        }
    }
    if retReg >= 8 {
        a68Emit(OpMove, 4, AmAn, retReg - 8, 0, AmDn, 0, 0)
    } else if retReg != 0 {
        a68Emit(OpMove, 4, AmDn, retReg, 0, AmDn, 0, 0)
    }
    if irtKind(retTy) == KWord {
        // Task 12 (native-5e) fix, found bisecting the Gestalt hang: a
        // REAL Toolbox register-convention routine's own glue promises
        // its result in its result register, but (per Apple's own
        // OSErr/INTEGER convention, mirrored by classic-68k callers
        // universally reading only the low WORD) makes no promise about
        // the upper word -- EXT.L unconditionally re-derives the full
        // signed 32-bit value from D0's own low word (now that the raw
        // result has been brought across to D0 above), discarding
        // whatever was there before, matching cgCallExtPascal's own
        // retIsSigned arm exactly (same "Toolbox INTEGER is signed"
        // rule). Task 2 (toolbox-integration) unifies this across BOTH
        // `reg` forms -- previously only UiGestalt's own dedicated
        // by-name special case did this for the named form.
        a68Emit(OpExt, 4, AmNone, 0, 0, AmDn, 0, 0)
    } else if irtKind(retTy) == KBool or irtKind(retTy) == KChar {
        // NOT the same shift cgCallExtPascal's retIsShortSlot arm needs
        // (that arm's LSR.L #8): the LSR there undoes the Pascal
        // calling convention's own stack-word padding -- a Pascal trap's
        // Bool/Char result is popped as a WORD with the real byte in the
        // HIGH half (mirroring the argument-side word-padding rule), so
        // D0's low 16 bits need shifting down before the byte is usable.
        // A `reg`-convention trap has no such stack round-trip: the
        // result lands directly in D0 with the real byte already in D0's
        // OWN low byte, so a plain AND.L #255 mask is already correct --
        // shifting here would mask the WRONG byte.
        a68Emit(OpAndInsn, 4, AmImm, 0, 255, AmDn, 0, 0)
    }
    // else: KVoid (nothing to bring back) or plain int/ptr -- already in
    // D0 after the move above, the REG rule's own "other results from
    // D0" clause.
}

// cgCallExtRegMemErr implements `= trap TRAPWORD reg memerr` (Task 14,
// native-5e): the SAME reg-convention arg passing + trap dispatch as plain
// `reg` (cgRegPassArgsAndTrap), for a real Toolbox routine whose Pascal
// signature is `void` -- SetHandleSize/SetPtrSize/etc, Inside Macintosh's
// Memory Manager: these are PROCEDURES, not FUNCTIONS, and leave NOTHING
// meaningful in D0 after the trap. The actual result lives in the
// well-known low-memory global `MemErr` (absolute address $0220, a signed
// word: the OSErr from the most recent such call) -- exactly what a real
// `MemError()` trap call would read (Retro68's own MacMemory.h glues
// MemError() as a raw two-word read of this same global, not a real A-line
// trap dispatch at all).
//
// Root cause (Task 14's own native gate, winvar.cla): text.cla's
// TextSetHandleSize was declared plain `reg`, so cgCallExtReg's own "plain
// int result, already in D0" fallthrough left `err` holding WHATEVER
// stale value the trap happened to leave in D0 -- not an error code at
// all. That register is UNDEFINED after a void-Pascal-procedure trap, so
// rtTextGrow's `if err != 0 { rtPanic("out of memory") }` fired
// nondeterministically (in practice, reliably, once real window/control
// allocation upstream left D0 nonzero) on the very FIRST text append of a
// window-scoped `var log: text` with no initializer -- even though the
// actual growth (a freshly TextNewHandle(0)'d 0-byte handle growing to a
// few bytes) had nothing wrong with it at all. list.cla/map.cla's own
// ListSetHandleSize/MapSetHandleSize share the identical bug shape and are
// fixed the same way.
func cgCallExtRegMemErr(e: int, xi: int) {
    cgRegPassArgsAndTrap(e, xi)
    // MOVE.W $0220.W,D0 ; EXT.L D0 -- read the low-memory MemErr global
    // (a signed 16-bit OSErr) and sign-extend it into the full register,
    // matching cgCallExtReg's own KWord (retIsSigned-equivalent) arm exactly (same
    // "Toolbox INTEGER is signed" rule -- MemErr is that same shape).
    a68Emit(OpMove, 2, AmAbsW, 0, 0x0220, AmDn, 0, 0)
    a68Emit(OpExt, 4, AmNone, 0, 0, AmDn, 0, 0)
}

// cgCallExtPascal implements the locked PASCAL rule: reserve a result
// slot first when the extern returns a value (CLR.L for int/ptr, CLR.W
// for bool/char/word -- Toolbox convention: a byte- or word-sized Pascal
// parameter or result still occupies a full stack WORD), push args
// left-to-right (str/text by ADDRESS via cgExprAddr, matching fpCallExt's
// own C-seam marshaling of a KStr argument through fpStrAddr; int/ptr as
// .L, word as .W; bool/char ALSO as .W but see below), the trap word,
// then pop the result.
//
// REVISED (Task 12 continuation, native-5e): the earlier claim right
// above -- that a Bool/Char value lands in the padded word's LOW byte,
// "no shift needed" -- was WRONG and has been empirically REFUTED. The
// real ROM trap dispatcher reads a Bool/Char pascal parameter back as a
// single byte at the padded word's OWN (lowest) address, which in 68k
// big-endian layout is that word's HIGH-order byte. Root-caused via A/B
// `log()` instrumentation (WindowRecord.goAwayFlag, offset verified
// against Retro68's own MacWindows.h) comparing this native lane against
// the ported/gcc lane (same shared `ui.cla` source, correct there): a
// `true` argument to `UiNewWindow`'s `goAwayFlag` came back `false` here
// with the old low-byte push, matching every other symptom this task's
// own gate first surfaced (missing window close box; native widgets never
// receiving clicks, from `NewControl`'s `initiallyVisible`). Fixed below:
// Bool/Char args are shifted into the high byte (`LSL.W #8`) before the
// word push; `word`-typed args (a genuine 16-bit Toolbox INTEGER, not a
// byte value padded to a word) are unaffected and still pushed as a plain
// `.W`. See this session's task-12-report.md continuation-session section
// for the full A/B trace.
//
// The bool-RETURN pop below (the `retIsShortSlot`-but-not-`retIsSigned` arm)
// FIXED in Task 14 (native-5e): confirmed the mirror-image of the
// argument-side bug -- winvar.cla's snap showed a window frame with NO
// controls/text ever painted despite a fully correct trace, root-caused
// to UiGetNextEvent's Boolean result being read from the popped word's
// LOW byte (via `AND.L #255`) while the ROM places it in the HIGH byte,
// so rtUiPumpPassive's event-drain loop never believed a pending updateEvt
// existed. Now LSR.L #8 instead of AND.L #255 (see the arm's own doc
// comment for the exact byte math).
//
// The trap dispatcher's OWN glue pops the pushed ARGS itself as part of
// executing a Pascal-convention trap (Apple's Trap Manager docs: "the
// calling routine's parameters are also popped off the stack" by the
// callee) -- this code never emits a post-trap ADDA/ADDQ for the arg
// bytes, only the final MOVE(.W/.L) (A7)+,D0 that retrieves the result
// slot the trap dispatcher left behind.
//
// `word` (Task 4, native-5e, Ch13) is the one shape here that depends on
// the EXTERN'S OWN DECLARED type, not the argument/result's own checked
// type: the checker resolves a word param/return to plain int (check.cla's
// resolveType), so an argument expression's own irExprType is always
// int/bool/char/etc, never KWord -- only irExternParam(xi, j)/irExternRet
// (the registry lower.cla's lowResolveType populated straight off the
// AST) still knows a given slot was written `word`. That is why the arg
// loop below tracks its own param index j and branches on
// irExternParam(xi, j) instead of irExprType(a): the marshaling choice is
// the CALLEE's, not the caller expression's own type. A word RESULT is
// SIGN-extended (EXT.L, not the bool/char AND-mask zero-extend) --
// Toolbox INTEGER is a signed 16-bit quantity (e.g. LAddRow's row
// number), unlike a byte-sized Pascal boolean/char result.
func cgCallExtPascal(e: int, xi: int) {
    var a: int
    var t: int
    var retTy: int
    // Task 4/15 (native-5e) naming: retIsShortSlot means "this result
    // occupies a padded WORD stack slot, not a plain .L" (bool/char/word
    // all qualify); retIsSigned narrows that to "and the value read back
    // is sign-extended, not zero-extended" (word only -- Toolbox INTEGER
    // is signed, unlike a byte-sized Pascal bool/char result). Renamed
    // from retIsWord/retIsWordType, which read as if only a `word`-typed
    // extern qualified -- misleading, since bool/char share the slot-width
    // arm too.
    var retIsShortSlot: bool
    var retIsSigned: bool
    var j: int

    retTy = irExternRet(xi)
    retIsSigned = irtKind(retTy) == KWord
    retIsShortSlot = irtKind(retTy) == KBool or irtKind(retTy) == KChar or retIsSigned
    if irtKind(retTy) != KVoid {
        if retIsShortSlot {
            a68Emit(OpClr, 2, AmNone, 0, 0, AmPreDec, 7, 0)
        } else {
            a68Emit(OpClr, 4, AmNone, 0, 0, AmPreDec, 7, 0)
        }
    }
    a = irCallExtArgsHead(e)
    j = 0
    while a != -1 {
        t = irExprType(a)
        if irtKind(t) == KStr or irtKind(t) == KText {
            cgExprAddr(a)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        } else if irtKind(t) == KBool or irtKind(t) == KChar {
            // Boolean/Char pascal params are padded to a full word on the
            // stack, but the callee (a ROM trap, e.g. NewWindow's
            // goAwayFlag) reads only ONE byte back, at the WORD'S OWN
            // (lowest) address -- which in 68k big-endian layout is the
            // word's HIGH-order byte. `MOVE.W D0,-(A7)` puts a 0/1 value
            // in the LOW-order byte instead (the high byte stays 0), so
            // the trap always sees 0 (false) regardless of the true
            // value -- empirically the exact bug behind Task 12's own
            // "goAwayFlag pushed true, WindowRecord reads false" gate
            // failure (native-5e task-12 report). Shifting the value into
            // the high byte before the word push (LSL.W #8) puts it where
            // the trap actually reads it; the vacated low byte is
            // "don't care" padding, matching every other already-working
            // pascal call's own word-padding convention.
            cgExpr(a)
            a68Emit(OpLsl, 2, AmImm, 0, 8, AmDn, 0, 0)
            a68Emit(OpMove, 2, AmDn, 0, 0, AmPreDec, 7, 0)
        } else if irtKind(irExternParam(xi, j)) == KWord {
            cgExpr(a)
            a68Emit(OpMove, 2, AmDn, 0, 0, AmPreDec, 7, 0)
        } else {
            cgExpr(a)
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        }
        a = irExprNext(a)
        j = j + 1
    }
    // Task 14 (native-5e gate, popuptable.cla): a "Package 7"-style
    // selector-dispatch trap (irExternSel != -1 -- e.g. UiLNew's real
    // 0xA9E7, the List Manager's ONE shared trap) pushes the selector
    // WORD as one more `.W` immediate, AFTER every declared arg (closest
    // to the trap itself) -- mirrors Retro68's own THREEWORDINLINE(0x3F3C,
    // selector, 0xA9E7) call-site shape exactly (0x3F3C is literally
    // MOVE.W #selector,-(SP)). No separate cleanup needed: the trap
    // dispatcher pops it along with every other arg, same "no post-trap
    // ADDA/ADDQ" discipline this function's own header comment already
    // documents. Root cause this fixes: EVERY List Manager extern in
    // uitable.cla was declared plain `trap 0xA9E7` with no selector at
    // all, so the real trap always read whatever garbage happened to be
    // on the stack as its selector -- "illegal instruction" before any
    // window ever drew (popuptable.cla's table widget is built during
    // App.launch, before ShowWindow).
    // mac-resident-clarusc Task 12: conv 9 (`seld0`) is the AppleEvent
    // Manager's own selector-dispatch shape -- the selector PRELOADS D0
    // instead of being pushed (see parseExternFuncDecl's own `seld0` doc
    // comment for the two Retro68 THREEWORDINLINE encodings this
    // distinguishes, 0x303C vs `sel`'s 0x3F3C). Emitted in place of (never
    // in addition to) the ordinary `sel` push below, after every declared
    // arg is already on the stack and before the trap word -- D0 is safe
    // to clobber here: every arg push above that used D0 as scratch has
    // already moved its value onto the stack by this point.
    if irExternSel(xi) != -1 {
        if irExternConv(xi) == 9 {
            a68Emit(OpMove, 2, AmImm, 0, irExternSel(xi), AmDn, 0, 0)
        } else {
            a68Emit(OpMove, 2, AmImm, 0, irExternSel(xi), AmPreDec, 7, 0)
        }
    }
    a68EmitTrap(irExternTrap(xi), poolGet(irCallExtName(e)))
    if irtKind(retTy) != KVoid {
        if retIsSigned {
            // Sign-extend: MOVE.W (A7)+,D0 loads the popped result word
            // into D0's low 16 bits, then EXT.L D0 propagates its sign
            // bit across the full register -- Toolbox INTEGER is signed.
            a68Emit(OpMove, 2, AmPostInc, 7, 0, AmDn, 0, 0)
            a68Emit(OpExt, 4, AmNone, 0, 0, AmDn, 0, 0)
        } else if retIsShortSlot {
            // Task 14 fix (native-5e gate, winvar.cla): CONFIRMED, not
            // just suspected -- the mirror-image bug this function's own
            // header comment flagged as open. winvar.cla's snap (S1)
            // rendered the window frame correctly but with NO controls/
            // text painted at all, despite the trace showing both clicks
            // dispatched correctly -- root-caused to UiGetNextEvent
            // (called by rtUiPumpPassive after every scripted action)
            // always reporting "no event" even when a real pending
            // updateEvt existed, because its own Boolean RESULT was read
            // from the popped word's LOW byte while the ROM (per this
            // function's own already-fixed ARGUMENT side) places a
            // Bool/Char result in the word's HIGH byte -- so
            // rtUiPumpPassive's `while gotEvent` loop never ran even
            // once, and DrawControls/TEUpdate (rtUiHandleUpdate) never
            // fired. Fix: CLR.L, pop the word into D0's low 16 bits (same
            // as before), then LSR.L #8 -- shifts the high byte (bits
            // 8-15) down into the low byte (bits 0-7) and shifts the
            // low byte out entirely, the exact mirror of the argument
            // side's LSL.W #8 (which moves a 0/1 value UP into the high
            // byte before the word push); AND.L #255 kept the WRONG byte.
            a68Emit(OpClr, 4, AmNone, 0, 0, AmDn, 0, 0)
            a68Emit(OpMove, 2, AmPostInc, 7, 0, AmDn, 0, 0)
            a68Emit(OpLsr, 4, AmImm, 0, 8, AmDn, 0, 0)
        } else {
            a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 0, 0)
        }
    }
}

// cgCallExtDeref implements `= inline deref`: MOVEA.L arg,A0; MOVE.L
// (A0),D0. checkExternFunc guarantees the signature is exactly (ptr):
// ptr, so there is exactly one arg and no result-shape branching needed.
func cgCallExtDeref(e: int) {
    var a0e: int

    a0e = irCallExtArgsHead(e)
    cgExpr(a0e)
    a68Emit(OpMovea, 4, AmDn, 0, 0, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmInd, 0, 0, AmDn, 0, 0)
}

// cgCallExtA5 implements `= inline a5` (Task 12, native-5e): the running
// program's own A5 world base, MOVE.L A5,D0 -- checkExternFunc guarantees
// zero params and a ptr return, so there is nothing to evaluate or clean
// up. Used by UiCurrentA5 (qd-globals access, e.g. the snap verb's
// screenBits walk) -- A5 is this backend's own fixed world-pointer
// register for the whole program's lifetime (cgEmitStartup/cgAssignGlobal
// Offsets), so simply reading it back out needs no trap, no call, nothing
// but the one move.
func cgCallExtA5(e: int) {
    a68Emit(OpMove, 4, AmAn, 5, 0, AmDn, 0, 0)
}

// cgCallExtNop implements `= inline nop`: evaluate every arg left to
// right, for side effects only, and emit nothing else -- checkExternFunc
// guarantees a void return, so there is no result to produce. Each arg is
// simply cgExpr'd and its D0 result discarded (never pushed) -- nothing
// downstream needs the value, so there is no stack bookkeeping to keep
// balanced.
func cgCallExtNop(e: int) {
    var a: int

    a = irCallExtArgsHead(e)
    while a != -1 {
        cgExpr(a)
        a = irExprNext(a)
    }
}

// cgCallExtNatFallback resolves a clause-less extern (irExternConv(xi) ==
// 0) to a Clarus function named nat_<ExternName> (the plan's own
// "extern-to-native fallback" design decision) -- structurally
// cgCallFnScalar with a different name mangling and error message.
// nat_<Name> is an ORDINARY Clarus function (the plan's own native.cla
// inventory: `func nat_CorePanic(msg: str 255)`), so a str/rec arg of its
// own now marshals BY ADDRESS through the SAME cgPushArgs KStr/KRec branch
// every other user-function call goes through (param-abi phase, Task 6 --
// this WAS a deliberate by-value/by-address divergence from fpCallExt's
// C-seam, noted here pre-Task-6; cgEmitFunc's own by-ref param flip applies
// uniformly to every IRFunc it compiles, nat_ included, so no
// special-casing is needed here either, before or after this task).
func cgCallExtNatFallback(e: int) {
    var natName: int
    var fi: int
    var total: int
    var savedReleases: list of int

    natName = intern("nat_" + poolGet(irCallExtName(e)))
    fi = findIRFuncIdxByName(natName)
    if fi == -1 {
        abort("extern " + poolGet(irCallExtName(e)) + " has no trap clause and no nat_ fallback")
    }
    savedReleases = cgSaveArgReleases()
    total = cgPushArgs(irCallExtArgsHead(e))
    cgCallFunc(fi)
    cgCleanupStack(total)
    cgFlushArgReleases(savedReleases)
}

// cgCallExt dispatches an ECallExt node. Task 12 (native-5e) inserts a
// NAME-based pre-dispatch, ahead of the clause-based switch below, for the
// UI reverse-waist's own externs -- mirrors cprint.cla's fpCallExt (Task
// 6/7's "skip = lowUiSynthExternName(...) != -1 or name == UiProgDesc")
// one level down, at the native backend:
//   - the 10 program-synthesized dispatchers (lowUiSynthExternName) call
//     their own synthesized IRFunc directly -- cgCallExtUiSynth.
//   - UiProgDesc/UiTestScript resolve to a POOL LABEL address (the blob/
//     events-script bytes cg68k itself poured into the constant pool,
//     cgEmitPoolsBody) -- cgCallExtUiBlobAddr.
// Every other extern (UiCurrentA5/UiTestEmit/UiRtQuit/UiLaunchReal/
// UiGestaltErr/UiGestaltValue/UiCbAddr/... and every non-UI extern in the
// program) falls
// through to the ordinary clause dispatch, unchanged -- Task 9
// (toolbox-integration Feature C) removed the LDEF/scrollbar-action
// by-name pair this block used to carry (two zero-arg externs, each
// resolving to a hand-written glue stub's own JT-slot address via
// cgCallExtUiGlueAddr): rtUiLdefDraw/rtUiScrollbarAction are `callback
// func` now, reached through the ECbAddr arm (cgExpr, above) instead,
// and UiCbAddr (uitable.cla's own decay-only identity extern) is clause-
// less, falling all the way through to cgCallExtNatFallback like any
// other. cgCallExtUiGlueAddr itself survives -- the ECbAddr arm still
// calls it directly (not through this by-name block) to materialize a
// callback glue's own JT-slot address.
func cgCallExt(e: int) {
    var xi: int
    var conv: int
    var nm: int
    var synthName: int

    nm = irCallExtName(e)
    synthName = lowUiSynthExternName(nm)
    if synthName != -1 {
        cgCallExtUiSynth(e, synthName)
        return
    }
    if poolGet(nm) == "UiProgDesc" {
        cgRecordUiBlob()
        cgCallExtUiBlobAddr(cgUiBlobLabel)
        return
    }
    if poolGet(nm) == "UiTestScript" {
        cgRecordUiEvents()
        cgCallExtUiBlobAddr(cgUiEventsLabel)
        return
    }
    if poolGet(nm) == "UiStrAddr" {
        cgCallExtUiStrAddr(e)
        return
    }

    xi = cgExternIdxByName(nm)
    if xi == -1 {
        abort("cg68k: call to unregistered extern " + poolGet(nm))
    }
    conv = irExternConv(xi)
    if conv == 2 or conv == 7 {
        cgCallExtReg(e, xi)
    } else if conv == 1 or conv == 9 {
        cgCallExtPascal(e, xi)
    } else if conv == 3 {
        cgCallExtDeref(e)
    } else if conv == 4 {
        cgCallExtNop(e)
    } else if conv == 5 {
        cgCallExtA5(e)
    } else if conv == 6 or conv == 8 {
        cgCallExtRegMemErr(e, xi)
    } else {
        cgCallExtNatFallback(e)
    }
}

// cgCallExtUiSynth calls the reverse-waist dispatcher's own synthesized
// IRFunc (lower.cla's lowSynthUiDispatchers) directly, by name -- both
// backends compile these as ordinary functions (the plan's own "reverse
// waist" contract), so this is structurally identical to
// cgCallExtNatFallback, just resolving through synthName (already the
// synthesized function's own interned name) instead of a "nat_" prefix.
func cgCallExtUiSynth(e: int, synthName: int) {
    var fi: int
    var total: int
    var savedReleases: list of int

    fi = findIRFuncIdxByName(synthName)
    if fi == -1 or not shakeReachable(fi) {
        // object-code-linker Task 2: the eight reverse-waist UI
        // dispatchers are DELIBERATELY never part of the baked IR
        // (bkInstallArenas' own doc comment) -- a runtime-only capture
        // universe can therefore reach a CALLER of one via an ordinary
        // transitive call edge (shakeProgram's own BFS) even when that
        // caller itself was never explicitly rooted for exactly this
        // reason (cgObjHasUiDispatchCall's own doc comment explains why
        // "don't root it" alone cannot prevent this). Taint instead of
        // crashing: the containing function's whole capture gets
        // discarded (cgObjDumpSegment leaves cgObjValid false for it),
        // so the missing call site's bytes never matter -- a future
        // compile (Task 3) just runs cgEmitFunc for it fresh, same as
        // any other never-baked function.
        if cgBakeCapture {
            cgObjCaptureTainted = true
            return
        }
        abort("cg68k: UI dispatcher " + poolGet(synthName) + " not found/reachable")
    }
    savedReleases = cgSaveArgReleases()
    total = cgPushArgs(irCallExtArgsHead(e))
    cgCallFunc(fi)
    cgCleanupStack(total)
    cgFlushArgReleases(savedReleases)
}

// cgCallExtUiBlobAddr resolves UiProgDesc/UiTestScript to a PC-relative
// LEA of the pool label cgEmitPoolsBody bound the blob's bytes to --
// LEA lbl(PC),A0; MOVE.L A0,D0 (LEA can only target an address register
// on real 68k hardware, so the PC-relative address is computed into A0
// first, then moved to D0 to match every other value-producing call's
// "result lands in D0" convention -- cgCallExtUiGlueAddr's own identical
// two-instruction shape just below). lbl is -1 (never bound -- the label was reserved but this
// program never turned out to be a UI program that emitted a blob at
// that label) only if this is ever mis-called; that can't happen because
// cgCallExt only reaches here from an ECallExt to UiProgDesc/UiTestScript,
// both of which only exist in a UI program's own linked runtime modules.
func cgCallExtUiBlobAddr(lbl: int) {
    a68Emit(OpLea, 0, AmPCLabel, 0, lbl, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmDn, 0, 0)
}

// cgCallExtUiGlueAddr resolves a named glue stub (glueFnName -- Task 9:
// today only ECbAddr's cgExpr arm calls this, aiming it at a `callback
// func`'s own "clar_cb_<name>" glue) to that glue's callable JT-slot
// address: LEA <jtDisp(slot)>(A5),A0; MOVE.L A0,D0 -- the SAME
// "jump-table entry is a segment-safe callable address" contract
// cgJtDisp's own header comment establishes for an ordinary cross-segment
// BSR, just materialized as a VALUE (handed to the Toolbox as a
// UPP/ListDefProcPtr) instead of jumped to directly.
func cgCallExtUiGlueAddr(glueFnName: string) {
    var fi: int

    fi = findIRFuncIdxByName(intern(glueFnName))
    if fi == -1 or not shakeReachable(fi) {
        // object-code-linker Task 2: defensive twin of
        // cgCallExtUiSynth's own taint guard, above -- cgObjCaptureRuntime
        // always runs cg68SynthCbGlue before capture, so this should not
        // actually fire, but a genuinely unresolvable target here must
        // still never crash the bake.
        if cgBakeCapture {
            cgObjCaptureTainted = true
            return
        }
        abort("cg68k: UI glue stub " + glueFnName + " not found/reachable")
    }
    a68Emit(OpLea, 0, AmDisp16, 5, cgJtDisp(cgJtSlot(fi)), AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmDn, 0, 0)
}

// cgCallExtUiStrAddr implements UiStrAddr(s: string): ptr NATIVELY as a
// trivial identity: the address of the caller's OWN str argument --
// exactly matching the cprint lane's own characterization of
// rt_ext_UiStrAddr as "a trivial C-level identity function that just
// returns the address the marshaling already produced" (uiscript.cla's
// own doc comment on UiStrAddr). This is NOT a call at all (no trap, no
// JSR): cgExprAddr(argExpr) already leaves that exact address in A0 for
// ANY of its supported lvalue shapes (EVarRef, EFieldRef, EIndexRef, and
// -- the one that matters most here -- EStrConst, since every call site
// in this port passes a string LITERAL, `UiStrAddr("T ")` etc.), so this
// is simply "compute the address, bring it to D0" -- one MOVE.L past
// whatever cgExprAddr itself emits.
func cgCallExtUiStrAddr(e: int) {
    var a: int

    a = irCallExtArgsHead(e)
    cgExprAddr(a)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmDn, 0, 0)
}

// ================================================================
// Task 8: SStoreStr / str-returning SReturn.
//
// Both write a str VALUE into an already-known destination address --
// dst's own address for SStoreStr, the hidden result pointer (the LONG
// value sitting at 8(A6), pushed by value, not LEA'd -- it's already a
// pointer) for SReturn. The two share the same source-kind dispatch:
//   - ECallFn: the callee already writes straight into our dst/hidden
//     pointer via cgCallFnInto -- no intermediate copy (a deliberate
//     simplification vs. cprint's anonymous-temp-then-copy: safe as long
//     as the call's own args don't read from dst, true for every fixture
//     this task uses -- see the Task 8 report).
//   - EIntr "str_concat": likewise writes directly into dst via
//     rtStrConcat, skipping cprint's anonymous clar_str_255 temp --
//     KNOWN LIMITATION, only safe when dst's own capacity is already
//     >=256 (rtStrConcat always assumes a 256-byte-capable out buffer,
//     same fixed shape cprint's own clar_str_255 temp has); a smaller
//     dst degrades to a TODO comment (see the report).
//   - anything else (EStrConst, EVarRef, ...): a clamped copy via
//     rtStrStore(dst, dst's own declared capacity, src) -- mirrors
//     cprint's fpStoreStr exactly.
// ================================================================

// cgStrBuilderIntoTemp (task-8-review round 1 fix, Critical 1; generalized
// Task 14.7) reserves a 256-byte stack temp and calls fnName(temp,
// argExprs...) into it -- ALWAYS, unconditionally, mirroring cprint's
// fpIntrCall IStrConcat/IStrConcatChar/IStrPrependChar/IStrSlice/
// ITextSlice arms (every one of them: `t = fpNewTmp("clar_str_255")`,
// never materialized directly into the final destination). This is not
// optional: str.cla's own doc comments on this whole family say "out must
// not alias" any input -- writing straight into `dst` (the original Task
// 8 shortcut, str_concat only) corrupted `s = t + s` (dst aliases the 2nd
// operand) to "worldworld" instead of "worldhello" (task-8-review's
// empirical trace). An independent temp sidesteps the aliasing question
// outright: no operand can ever alias `out` when `out` is never `dst`.
// argIsAddr[i] mirrors cgCallRuntime's own convention (true = cgExprAddr'd,
// false = cgExpr'd by value -- a KText/int/char arg passes by value, same
// as any other `ptr`-typed runtime param taking a handle directly).
//
// Leaves the temp UN-freed and A7 pointing at its start (the JSR+cleanup
// above is self-balanced, so A7 returns to exactly where it was right
// after the ADDA.L reservation) -- the caller must immediately capture
// that address (`MOVEA.L A7,A1`, fresh, never carried across a further
// JSR: this backend has no callee-saved register convention, so nothing
// survives a call except A7 itself, which the calling convention DOES
// guarantee), copy out of it into the real destination, and free it
// (cgFlushA1TempToDst/cgFlushA1TempToRetPtr do both, `ADDA.W #256,A7`
// included).
func cgStrBuilderIntoTemp(nameIdx: int, argExprs: list of int, argIsAddr: list of bool) {
    var fi: int
    var i: int

    fi = findIRFuncIdxByName(nameIdx)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: " + poolGet(nameIdx) + " not found/reachable")
    }
    a68Emit(OpAdda, 4, AmImm, 0, 0 - 256, AmAn, 7, 0)
    a68Emit(OpMovea, 4, AmAn, 7, 0, AmAn, 1, 0)
    a68Emit(OpMove, 4, AmAn, 1, 0, AmPreDec, 7, 0)
    i = 0
    while i < argExprs.count {
        if argIsAddr[i] {
            cgExprAddr(argExprs[i])
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        } else {
            cgExpr(argExprs[i])
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        }
        i = i + 1
    }
    cgCallFunc(fi)
    cgCleanupStack(4 + argExprs.count * 4)
}

// cgFlushA1TempToDst clamp-copies cgStrBuilderIntoTemp's 256-byte scratch
// into dst (rtStrStore(dst, dst's own capacity, scratch)) and frees the
// scratch -- the shared tail cgEmitStoreStr's str_concat/str_concat_char/
// str_prepend_char/str_slice/text_slice arms all use. The scratch address
// is recaptured FRESH from A7 here (never carried in A1 across the
// builder's own JSR -- this backend has no callee-saved registers;
// TestNativeStrContainers caught exactly this on real hardware when the
// recapture was briefly dropped in refactoring), and recaptured AFTER
// cgExprAddr(dst) (whose own EIndexRef arm JSRs rtListAt, clobbering A1
// the same way). A7 sits exactly at the temp's start both times -- the
// builder's own balanced-JSR contract, and cgExprAddr's own balanced
// push/cleanup sequences preserve it.
func cgFlushA1TempToDst(dst: int) {
    var cap: int
    var fi: int

    cap = irtN(irExprType(dst))
    fi = findIRFuncIdxByName(rnStrStore)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: rtStrStore not found/reachable")
    }
    cgExprAddr(dst)
    a68Emit(OpMovea, 4, AmAn, 7, 0, AmAn, 1, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, cap, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmAn, 1, 0, AmPreDec, 7, 0)
    cgCallFunc(fi)
    cgCleanupStack(12)
    a68Emit(OpAdda, 4, AmImm, 0, 256, AmAn, 7, 0)
}

// cgFlushA1TempToRetPtr mirrors cgFlushA1TempToDst for `return <str
// expr>` -- the destination is the hidden pointer's VALUE at 8(A6),
// pushed directly (not LEA'd), same convention cgEmitReturnStr's own
// generic tail already uses. Same fresh-A7 recapture as its sibling.
func cgFlushA1TempToRetPtr() {
    var cap: int
    var fi: int

    cap = irtN(cgCurRetType)
    fi = findIRFuncIdxByName(rnStrStore)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: rtStrStore not found/reachable")
    }
    a68Emit(OpMovea, 4, AmAn, 7, 0, AmAn, 1, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, 8, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, cap, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmAn, 1, 0, AmPreDec, 7, 0)
    cgCallFunc(fi)
    cgCleanupStack(12)
    a68Emit(OpAdda, 4, AmImm, 0, 256, AmAn, 7, 0)
}

func cgEmitStoreStr(dst: int, src: int) {
    var sk: IRExprKind
    var nm: string
    var fi: int
    var a0e: int
    var a1e: int
    var a2e: int
    var cap: int
    var args: list of int
    var addrs: list of bool
    var src2: int
    src2 = src

    sk = irExprKind(src2)
    if sk == ECallFn {
        cgCallFnInto(src2, dst)
        return
    }
    if sk == EIntr {
        nm = poolGet(irIntrName(src2))
        if nm == "str_concat" {
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            args = cgFreshIntList()
            args.add(a0e)
            args.add(a1e)
            addrs = cgFreshBoolList()
            addrs.add(true)
            addrs.add(true)
            cgStrBuilderIntoTemp(rnStrConcat, args, addrs)
            cgFlushA1TempToDst(dst)
            return
        }
        if nm == "str_concat_char" {
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            args = cgFreshIntList()
            args.add(a0e)
            args.add(a1e)
            addrs = cgFreshBoolList()
            addrs.add(true)
            addrs.add(false)
            cgStrBuilderIntoTemp(rnStrConcatChar, args, addrs)
            cgFlushA1TempToDst(dst)
            return
        }
        if nm == "str_prepend_char" {
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            args = cgFreshIntList()
            args.add(a0e)
            args.add(a1e)
            addrs = cgFreshBoolList()
            addrs.add(false)
            addrs.add(true)
            cgStrBuilderIntoTemp(rnStrPrependChar, args, addrs)
            cgFlushA1TempToDst(dst)
            return
        }
        if nm == "str_slice" {
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            a2e = irExprNext(a1e)
            args = cgFreshIntList()
            args.add(a0e)
            args.add(a1e)
            args.add(a2e)
            addrs = cgFreshBoolList()
            addrs.add(true)
            addrs.add(false)
            addrs.add(false)
            cgStrBuilderIntoTemp(rnStrSlice, args, addrs)
            cgFlushA1TempToDst(dst)
            return
        }
        if nm == "text_slice" {
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            a2e = irExprNext(a1e)
            args = cgFreshIntList()
            args.add(a0e)
            args.add(a1e)
            args.add(a2e)
            addrs = cgFreshBoolList()
            addrs.add(false)
            addrs.add(false)
            addrs.add(false)
            cgStrBuilderIntoTemp(rnTextSlice, args, addrs)
            cgFlushA1TempToDst(dst)
            return
        }
        if nm == "text_string_at" {
            // clir-load-perf Task 3: rtTextStringAt(t: ptr, pos: int):
            // string is a TRUE `: string`-returning ordinary Clarus
            // function (Task 2's corrected doc comment, text.cla), NOT an
            // rtStrSlice/rtTextSlice-shaped void/explicit-out-param
            // primitive -- so it does NOT fit cgStrBuilderIntoTemp's
            // "out pushed first" convention. It uses the SAME hidden-
            // result-pointer ABI cgEmitFunc gives every KStr-returning
            // function (cgRetNeedsHidden, cgCallFnInto's own generic
            // ECallFn path) -- declared args (t, pos) push BY VALUE in
            // declaration order, hidden ptr (dst's own address) pushes
            // LAST, mirroring this function's own "lasterr_msg" arm
            // below (a zero-arg instance of the exact same convention)
            // with two real args prepended. Not reachable via the
            // generic ECallFn/cgCallFnInto path because stringAt lowers
            // through newIRIntr (EIntr), not a plain call.
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            fi = findIRFuncIdxByName(rnTextStringAt)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: rtTextStringAt not found/reachable")
            }
            cgExpr(a0e)
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
            cgExpr(a1e)
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
            cgExprAddr(dst)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgCallFunc(fi)
            cgCleanupStack(12)
            return
        }
        if nm == "xrec_str_read" {
            // Task 6 (toolbox-integration Feature B): `s = ev.fName` -- an
            // extern-record str[N] field READ (`IXRecStrRead`, a KStr-
            // producing EIntr, reached here exactly like str_concat/etc
            // above). Args (fieldAddr, N): fills dst IN PLACE via a clamped
            // rtStrStore(dst, dst's own declared capacity, fieldAddr) --
            // the SAME generic dst/cap/src2 shape this function's own tail
            // (below) already uses for a plain EVarRef/EStrConst source,
            // just with src2 replaced by the field's raw address.
            a0e = irIntrArgsHead(src2)
            args = cgFreshIntList()
            args.add(dst)
            args.add(newIRIntConst(irtN(irExprType(dst)), irIntT))
            args.add(a0e)
            addrs = cgFreshBoolList()
            addrs.add(true)
            addrs.add(false)
            addrs.add(true)
            if not cgCallRuntime(rnStrStore, args, addrs) {
                abort("cg68k: cgEmitStoreStr: rtStrStore call failed (xrec_str_read)")
            }
            return
        }
        if nm == "lasterr_msg" {
            // Task 12.5: natLastErrMsg() -> dst, a zero-arg hidden-result-
            // pointer call -- the same shape cgCallFnInto uses for a
            // zero-arg user function, hand-emitted here since src2 is an
            // EIntr node, not the ECallFn shape cgCallFnInto expects.
            fi = findIRFuncIdxByName(rnLastErrMsg)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: natLastErrMsg not found/reachable")
            }
            cgExprAddr(dst)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgCallFunc(fi)
            cgCleanupStack(4)
            return
        }
        if nm == "file_name" {
            // Task 14: natFileName(dst: ptr, path: ptr) fills dst
            // in-place (Str255 bytes) -- a void, fill-in-place shape, NOT
            // the hidden-result-pointer str-return shape "lasterr_msg"
            // above uses (natLastErrMsg takes no real args; natFileName
            // takes one, and native.cla has no address-of operator to
            // build a fresh str-typed local to `return` -- see its own
            // file header). Pushed in DECLARATION order (dst, then path)
            // -- cgEmitFunc's own reverse-offset rule then lands path
            // (pushed last) at 8(A6) and dst at 12(A6), matching
            // `func natFileName(dst: ptr, path: ptr)` exactly.
            a0e = irIntrArgsHead(src2)
            fi = findIRFuncIdxByName(rnFileName)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: natFileName not found/reachable")
            }
            cgExprAddr(dst)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgExprAddr(a0e)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgCallFunc(fi)
            cgCleanupStack(8)
            return
        }
        if nm == "list_pop" or nm == "list_shift" {
            cgCopyScratchToDst(cgIntrListPopLike(src2, nm), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "list_first" or nm == "list_last" {
            cgCopyScratchToDst(cgIntrListFirstLast(src2, nm), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "map_get" {
            cgCopyScratchToDst(cgIntrMapGet(src2, false), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "map_get_dv" or nm == "map_get_dv_birth" {
            cgCopyScratchToDst(cgIntrMapGetDv(src2, nm == "map_get_dv_birth", false), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "sortedmap_get" {
            cgCopyScratchToDst(cgIntrMapGet(src2, true), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "sortedmap_get_dv" or nm == "sortedmap_get_dv_birth" {
            cgCopyScratchToDst(cgIntrMapGetDv(src2, nm == "sortedmap_get_dv_birth", true), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "intmap_get" {
            cgCopyScratchToDst(cgIntrIntMapGet(src2), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "intmap_get_dv" or nm == "intmap_get_dv_birth" {
            cgCopyScratchToDst(cgIntrIntMapGetDv(src2, nm == "intmap_get_dv_birth"), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "str_coerce" {
            // Task 14.7 (was a silent no-op TODO): a Str value binding
            // into a differently-capacitied Str slot (lowCoerceStr,
            // lower.cla) -- unwrap to the inner expr and fall through to
            // this function's own generic clamped-copy tail below, which
            // already computes cap from DST's own capacity (== target,
            // by lowCoerceStr's own construction) and cgExprAddr's the
            // inner expr (now itself materializes via cgExprAddr's own
            // Task 14.7 fallback if the inner expr isn't addressable).
            src2 = irIntrArgsHead(src2)
        } else if nm == "ui_get_field_text" or nm == "ui_get_label_text" {
            // Task 14 (native-5e gate, textwidgets.cla): `field.text` read
            // -- fills dst IN PLACE via rtUiWidgetGetStr(instV, wIdx,
            // RTUI_PROP_TEXT, dstAddr), same fill-in-place shape as
            // "file_name" above, just 4 args (2 value, 1 literal prop
            // const, 1 address) instead of 2. Pushed in DECLARATION order
            // (instV, wIdx, prop, dst255), matching
            // `func rtUiWidgetGetStr(instV: ptr, wIdx: int, prop: int,
            // dst255: ptr)` (uiwidgets.cla) exactly. `label.text` read
            // (native-gaps-cleanup Task 5) reuses this identical call
            // shape -- rtUiWidgetGetStr's own RTUI_LABEL arm reads the
            // labels[] slot rtUiWidgetSetStr's RTUI_LABEL arm writes.
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            fi = findIRFuncIdxByName(rnUiWidgetGetStr)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: rtUiWidgetGetStr not found/reachable")
            }
            cgExpr(a0e)
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
            cgExpr(a1e)
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
            a68Emit(OpMove, 4, AmImm, 0, cgRtuiPropText, AmPreDec, 7, 0)
            cgExprAddr(dst)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgCallFunc(fi)
            cgCleanupStack(16)
            return
        } else if nm == "ui_get_title" {
            // Task 14 (native-5e gate): bare `title` / `w.title` read --
            // fills dst in place via rtUiGetTitle(instV, dst255), the
            // window-scoped (no wIdx/prop) sibling of ui_get_field_text
            // just above.
            a0e = irIntrArgsHead(src2)
            fi = findIRFuncIdxByName(rnUiGetTitle)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: rtUiGetTitle not found/reachable")
            }
            cgExpr(a0e)
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
            cgExprAddr(dst)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgCallFunc(fi)
            cgCleanupStack(8)
            return
        } else {
            abort("cg68k: cgEmitStoreStr: intrinsic " + nm + " unsupported in store context")
        }
    }

    // EStrConst/EVarRef (and any other addressable source): a clamped
    // copy via rtStrStore(dst, dst's own capacity, src2) -- routed through
    // cgCallRuntime (task-8-review round 1 fix, Important 2: this was the
    // hand-rolled duplicate cgCallRuntime's own doc comment complained
    // was never actually used) since every argument here is genuinely
    // IRExpr-backed, including the capacity (wrapped in a synthetic
    // EIntConst via newIRIntConst -- ir.cla's own constructor, same one
    // lower.cla uses for every literal it manufactures).
    cap = irtN(irExprType(dst))
    args = cgFreshIntList()
    args.add(dst)
    args.add(newIRIntConst(cap, irIntT))
    args.add(src2)
    addrs = cgFreshBoolList()
    addrs.add(true)
    addrs.add(false)
    addrs.add(true)
    if not cgCallRuntime(rnStrStore, args, addrs) {
        abort("cg68k: cgEmitStoreStr: rtStrStore call failed")
    }
}

// cgEmitReturnStr mirrors cgEmitStoreStr for `return <str expr>` inside a
// function whose own return needs a hidden pointer -- the destination is
// the POINTER VALUE already sitting at 8(A6) (pushed by value, not
// LEA'd, and NOT an IRExpr -- so neither branch here can route through
// cgCallRuntime the way cgEmitStoreStr's default path now does).
// ECallFn (returning a call result directly, e.g. `return f()` where f
// also returns string) falls through to the generic tail below exactly
// like every other not-specially-handled src kind -- cgExprAddr(src)'s
// own general fallback (Task 14.7) already materializes any ECallFn into
// a fresh scratch temp via cgEmitStoreStr, then this function's generic
// tail block-copies from that temp into the hidden pointer via
// rtStrStore. Same fix, same reasoning, as cgEmitReturnRec's own ECallFn
// handling (its doc comment) -- mac-resident-clarusc Task 3 found this
// one still hard-erroring (clarusc's own self-emit hits `return
// numToStr(...)`-shaped code), its sibling's own comment already having
// been updated for the analogous KRec case.
func cgEmitReturnStr(src: int) {
    var sk: IRExprKind
    var nm: string
    var fi: int
    var a0e: int
    var a1e: int
    var a2e: int
    var cap: int
    var args: list of int
    var addrs: list of bool
    var src2: int
    src2 = src

    sk = irExprKind(src2)
    if sk == EIntr {
        nm = poolGet(irIntrName(src2))
        if nm == "str_concat" {
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            args = cgFreshIntList()
            args.add(a0e)
            args.add(a1e)
            addrs = cgFreshBoolList()
            addrs.add(true)
            addrs.add(true)
            cgStrBuilderIntoTemp(rnStrConcat, args, addrs)
            cgFlushA1TempToRetPtr()
            return
        }
        if nm == "str_concat_char" {
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            args = cgFreshIntList()
            args.add(a0e)
            args.add(a1e)
            addrs = cgFreshBoolList()
            addrs.add(true)
            addrs.add(false)
            cgStrBuilderIntoTemp(rnStrConcatChar, args, addrs)
            cgFlushA1TempToRetPtr()
            return
        }
        if nm == "str_prepend_char" {
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            args = cgFreshIntList()
            args.add(a0e)
            args.add(a1e)
            addrs = cgFreshBoolList()
            addrs.add(false)
            addrs.add(true)
            cgStrBuilderIntoTemp(rnStrPrependChar, args, addrs)
            cgFlushA1TempToRetPtr()
            return
        }
        if nm == "str_slice" {
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            a2e = irExprNext(a1e)
            args = cgFreshIntList()
            args.add(a0e)
            args.add(a1e)
            args.add(a2e)
            addrs = cgFreshBoolList()
            addrs.add(true)
            addrs.add(false)
            addrs.add(false)
            cgStrBuilderIntoTemp(rnStrSlice, args, addrs)
            cgFlushA1TempToRetPtr()
            return
        }
        if nm == "text_slice" {
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            a2e = irExprNext(a1e)
            args = cgFreshIntList()
            args.add(a0e)
            args.add(a1e)
            args.add(a2e)
            addrs = cgFreshBoolList()
            addrs.add(false)
            addrs.add(false)
            addrs.add(false)
            cgStrBuilderIntoTemp(rnTextSlice, args, addrs)
            cgFlushA1TempToRetPtr()
            return
        }
        if nm == "text_string_at" {
            // Mirrors cgEmitStoreStr's own "text_string_at" arm -- the
            // destination is the hidden pointer's VALUE at 8(A6) (pushed
            // directly, not LEA'd, same convention this function's own
            // "lasterr_msg" arm below uses), pushed LAST after the two
            // real args (t, pos), matching cgRetNeedsHidden's fixed
            // offset-8 convention exactly.
            a0e = irIntrArgsHead(src2)
            a1e = irExprNext(a0e)
            fi = findIRFuncIdxByName(rnTextStringAt)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: rtTextStringAt not found/reachable")
            }
            cgExpr(a0e)
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
            cgExpr(a1e)
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
            a68Emit(OpMove, 4, AmDisp16, 6, 8, AmPreDec, 7, 0)
            cgCallFunc(fi)
            cgCleanupStack(12)
            return
        }
        if nm == "lasterr_msg" {
            // Task 12.5: mirrors cgEmitStoreStr's own "lasterr_msg" arm --
            // the destination is the hidden pointer's VALUE at 8(A6),
            // pushed directly (not LEA'd), same convention this
            // function's own generic tail below already uses.
            fi = findIRFuncIdxByName(rnLastErrMsg)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: natLastErrMsg not found/reachable")
            }
            a68Emit(OpMove, 4, AmDisp16, 6, 8, AmPreDec, 7, 0)
            cgCallFunc(fi)
            cgCleanupStack(4)
            return
        }
        if nm == "file_name" {
            // Mirrors cgEmitStoreStr's own "file_name" arm -- the
            // destination is the hidden pointer's VALUE at 8(A6) (pushed
            // directly, not LEA'd, same convention this function's own
            // "lasterr_msg" arm and generic tail already use), pushed
            // FIRST (dst), then path's address SECOND -- same declaration
            // order (dst, path) as cgEmitStoreStr's arm.
            a0e = irIntrArgsHead(src2)
            fi = findIRFuncIdxByName(rnFileName)
            if fi == -1 or not shakeReachable(fi) {
                abort("cg68k: natFileName not found/reachable")
            }
            a68Emit(OpMove, 4, AmDisp16, 6, 8, AmPreDec, 7, 0)
            cgExprAddr(a0e)
            a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
            cgCallFunc(fi)
            cgCleanupStack(8)
            return
        }
        if nm == "str_coerce" {
            // Task 14.7 (was a silent no-op TODO -- e.g. emit_func.cla's
            // `func f(s: string): string(3) { return s }`, a real corpus
            // shape): mirrors cgEmitStoreStr's own str_coerce arm --
            // unwrap and fall through to the generic clamped-copy tail
            // below, which already computes cap from cgCurRetType (==
            // target, by lowCoerceStr's own construction).
            src2 = irIntrArgsHead(src2)
        } else {
            abort("cg68k: cgEmitReturnStr: intrinsic " + nm + " unsupported in return context")
        }
    }

    cap = irtN(cgCurRetType)
    fi = findIRFuncIdxByName(rnStrStore)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: rtStrStore not found/reachable")
    }
    a68Emit(OpMove, 4, AmDisp16, 6, 8, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, cap, AmPreDec, 7, 0)
    cgExprAddr(src2)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgCallFunc(fi)
    cgCleanupStack(12)
}

// ================================================================
// Task 8: cgStmt / cgStmts -- all 11 IRStmtKinds. SForList/SForMap
// (containers, Task 13) are a TODO comment + skipped body, per the brief.
// ================================================================

func cgStmts(head: int) {
    var s: int

    s = head
    while s != -1 {
        cgStmt(s)
        s = irStmtNext(s)
    }
}

func cgIfStmt(s: int) {
    var elseLbl: int
    var endLbl: int

    cgExpr(irIfCond(s))
    a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 0, 0)
    if irIfElse(s) == -1 {
        endLbl = a68NewLabel()
        a68EmitBr(OpBcc, 7, endLbl)  // BEQ: cond false -> skip then
        cgStmts(irIfThen(s))
        a68Bind(endLbl)
    } else {
        elseLbl = a68NewLabel()
        endLbl = a68NewLabel()
        a68EmitBr(OpBcc, 7, elseLbl)
        cgStmts(irIfThen(s))
        a68EmitBr(OpBra, 0, endLbl)
        a68Bind(elseLbl)
        cgStmts(irIfElse(s))
        a68Bind(endLbl)
    }
}

// cgWhileStmt: Task 13 adds the per-iteration condition-temp flush
// (mirrors fpWhileStmt + its ARC Task 8 break-path fix, cprint.cla:
// 2885-2913, in ONE sequence instead of two textual copies): a tracked
// temp the CONDITION creates (a text concat compared against something,
// say) is rebuilt fresh every iteration, so it must be released every
// iteration -- and on the exit path too. Emitted only when the condition
// actually tracked something (the common all-scalar condition compiles
// byte-identically to before): D0 (the condition's own value) is spilled
// to the stack across the release calls, then reloaded before the branch
// -- ONE flush covering both the continue and exit paths, where cprint
// needs two printed copies on its mutually exclusive C paths.
func cgWhileStmt(s: int) {
    var topLbl: int
    var endLbl: int

    topLbl = a68NewLabel()
    endLbl = a68NewLabel()
    a68Bind(topLbl)
    cgExpr(irWhileCond(s))
    if cgStmtTmpOffs.count > 0 {
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        cgFreeStmtTmps()
        a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 0, 0)
    }
    a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 0, 0)
    a68EmitBr(OpBcc, 7, endLbl)  // BEQ: cond false -> exit
    cgLoopBreakLabels.add(endLbl)
    cgLoopContinueLabels.add(topLbl)
    cgStmts(irWhileBody(s))
    cgLoopBreakLabels.pop()
    cgLoopContinueLabels.pop()
    a68EmitBr(OpBra, 0, topLbl)
    a68Bind(endLbl)
}

// cgForRangeStmt: ascending, INCLUSIVE [from, to] (fpForRangeStmt,
// cprint.cla:2998, mirrored exactly -- `for cv = from; cv <= to; cv++`).
// `to` is evaluated once and stashed on the real machine stack for the
// loop's duration (MOVE.L D0,-(A7) at entry, peeked via (A7) each
// iteration, ADDQ.L #4,A7 at exit) rather than a named frame temp -- this
// backend has no anonymous-temp frame slots yet, and the stack slot is
// self-cleaning: UNLK on any `return` inside the loop resets A7 to A6
// regardless of what's still pushed, and `break`'s own target (endLbl)
// sits BEFORE the ADDQ so it's covered too; only the natural
// fall-through and break paths need the explicit ADDQ, both landing on
// the same endLbl.
func cgForRangeStmt(s: int) {
    var vName: string
    var reg: int
    var off: int
    var condLbl: int
    var incrLbl: int
    var endLbl: int

    vName = poolGet(irForRangeV(s))
    reg = 6
    off = cgFindFrameOffset(irForRangeV(s))
    if off == cgUnresolved {
        abort("cg68k: unresolved for-range variable " + vName)
    }

    cgExpr(irForRangeFrom(s))
    a68Emit(OpMove, 4, AmDn, 0, 0, AmDisp16, reg, off)
    cgExpr(irForRangeTo(s))
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)

    condLbl = a68NewLabel()
    incrLbl = a68NewLabel()
    endLbl = a68NewLabel()

    a68Bind(condLbl)
    a68Emit(OpMove, 4, AmDisp16, reg, off, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmInd, 7, 0, AmDn, 1, 0)
    a68Emit(OpCmp, 4, AmDn, 1, 0, AmDn, 0, 0)
    a68EmitBr(OpBcc, 14, endLbl)  // BGT: cv>to -> exit

    cgLoopBreakLabels.add(endLbl)
    cgLoopContinueLabels.add(incrLbl)
    cgStmts(irForRangeBody(s))
    cgLoopBreakLabels.pop()
    cgLoopContinueLabels.pop()

    a68Bind(incrLbl)
    a68Emit(OpMove, 4, AmDisp16, reg, off, AmDn, 0, 0)
    a68Emit(OpAddq, 4, AmImm, 0, 1, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmDisp16, reg, off)
    a68EmitBr(OpBra, 0, condLbl)

    a68Bind(endLbl)
    a68Emit(OpAddq, 4, AmImm, 0, 4, AmAn, 7, 0)
}

// cgJsrByName JSRs a reachable runtime IRFunc by name with NO argument
// marshaling of its own -- the caller has already arranged D0/D1/the stack
// exactly as the callee expects (cgForListStmt/cgForMapStmt's own
// hand-sequenced arg pushes below, where the SAME source values are read
// into registers multiple times across several calls, making cgCallRuntime's
// generic one-shot push-then-JSR shape a worse fit than composing the
// pushes inline). Findings 1.4 (Task 13): takes an already-interned
// nameIdx, same rationale as cgCallRuntime's own signature change above.
func cgJsrByName(nameIdx: int) {
    var fi: int

    fi = findIRFuncIdxByName(nameIdx)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: " + poolGet(nameIdx) + " not found/reachable")
    }
    cgCallFunc(fi)
}

// cgMapReleaseGuard mirrors fpMapReleaseGuard (cprint.cla:1393-1422)
// exactly: `if (rtMapHas(m, k)) { old = rtMapGet(m, k); release(old) }` --
// the upsert/remove guard IMapSet(Retain)/IMapRemove share, releasing
// whatever a key CURRENTLY holds before it's overwritten/evicted. mOff is
// the map's OWN pointer value, already stashed by the caller (evaluated
// exactly once, same "computed once, reused" discipline as fpMapReleaseGuard's
// own m/k text parameters); kExpr is re-evaluated via cgExprAddr each time
// it's needed here (safe: an ADDRESS computation over an addressable
// lvalue has no side effects, unlike a VALUE computation, so this does NOT
// re-run whatever produced the key -- only a bare EVarRef/EFieldRef/
// EStrConst ever reaches a map-key position, per the checker's own
// addressable-key constraint, str.cla's fpStrAddr precedent).
// map-hashtable phase Task 2: `sorted` selects the has/get family this
// guard calls (rtMap vs. rtSortedMap) -- parameterized rather than
// duplicated for a second sortedmap twin (mirrors cprint.cla's own
// fpMapReleaseGuard `sorted` parameterization). Findings 1.4 (Task 13):
// was a `prefix: string` concatenated with "Has"/"Get" and interned
// fresh at every call; now a bool picking between pre-interned rn*
// globals, same as cgIntrMapSet/Get/GetDv/Remove above.
func cgMapReleaseGuard(mOff: int, kExpr: int, elemT: int, sorted: bool) {
    var afterLbl: int
    var oldOff: int
    var hasIdx: int
    var getIdx: int

    hasIdx = rnMapHas
    getIdx = rnMapGet
    if sorted {
        hasIdx = rnSortedMapHas
        getIdx = rnSortedMapGet
    }

    a68Emit(OpMove, 4, AmDisp16, 6, mOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(kExpr)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(hasIdx)
    cgCleanupStack(8)
    a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 0, 0)
    afterLbl = a68NewLabel()
    a68EmitBr(OpBcc, 7, afterLbl) // BEQ: has==false -> skip

    oldOff = cgAllocTmpOff(elemT)
    a68Emit(OpMove, 4, AmDisp16, 6, mOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(kExpr)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmDisp16, 6, oldOff, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(getIdx)
    cgCleanupStack(12)
    cgReleaseAt(6, oldOff, elemT)

    a68Bind(afterLbl)
}

// cgIntMapReleaseGuard is cgMapReleaseGuard's int-keyed twin (map-hashtable
// phase Task 7): same `if (rtIntMapHas(m, k)) { old = rtIntMapGet(m, k);
// release(old) }` shape, but kOff is a FRAME SLOT holding the key's
// already-evaluated VALUE (stashed by the caller, cgIntrIntMapSet/
// cgIntrIntMapRemove's own kOff), reloaded fresh at each JSR site below --
// NOT re-evaluated via cgExpr(kExpr) a second/third time the way
// cgMapReleaseGuard's own cgExprAddr(kExpr) safely can (that's only safe
// because a string map key is restricted to an addressable lvalue with no
// side effects; an intmap key is an arbitrary int expression, so it must be
// computed exactly once and reused from a slot, same discipline
// fpMapReleaseGuard's own `im` branch uses in cprint.cla).
func cgIntMapReleaseGuard(mOff: int, kOff: int, elemT: int) {
    var afterLbl: int
    var oldOff: int

    a68Emit(OpMove, 4, AmDisp16, 6, mOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, kOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnIntMapHas)
    cgCleanupStack(8)
    a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 0, 0)
    afterLbl = a68NewLabel()
    a68EmitBr(OpBcc, 7, afterLbl) // BEQ: has==false -> skip

    oldOff = cgAllocTmpOff(elemT)
    a68Emit(OpMove, 4, AmDisp16, 6, mOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, kOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmDisp16, 6, oldOff, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnIntMapGet)
    cgCleanupStack(12)
    cgReleaseAt(6, oldOff, elemT)

    a68Bind(afterLbl)
}

// cgCopyElemInto copies ONE list element's bytes from (A0) (rtListAt's own
// returned address) into dstOff(dstReg) -- a plain byte copy, no retain
// (the language's own borrow semantics: a for-list loop variable is a
// re-assigned-each-iteration ALIAS, never an owned reference -- mirrors
// fpForListStmt's own bare `cv_vName = *(elemC*)rt_list_at(...)`, no
// retain call, cprint.cla:2833). cgBlockCopy's own "size always even"
// precondition holds for every kind except a 1-byte bool/char element
// (cgSizeOf==1, the ONE kind whose runtime elemsize -- cgSizeOf-derived,
// this file's own element-size-consistency rule -- is genuinely odd);
// that one case gets a single MOVE.B instead.
func cgCopyElemInto(dstReg: int, dstOff: int, elemT: int) {
    var sz: int

    sz = cgSizeOf(elemT)
    if sz == 1 {
        a68Emit(OpMove, 1, AmInd, 0, 0, AmDisp16, dstReg, dstOff)
    } else {
        a68Emit(OpLea, 0, AmDisp16, dstReg, dstOff, AmAn, 1, 0)
        cgBlockCopy(sz)
    }
}

// cgCopyElemFrom is cgCopyElemInto's mirror image: copies elemT's own
// bytes FROM srcOff(srcReg) INTO (A0) (a list slot's own address, already
// resolved by the caller -- IListSet(Retain)'s own "write new value in"
// step, cgIntr's own dispatch below).
func cgCopyElemFrom(srcReg: int, srcOff: int, elemT: int) {
    var sz: int

    sz = cgSizeOf(elemT)
    if sz == 1 {
        a68Emit(OpMove, 1, AmDisp16, srcReg, srcOff, AmInd, 0, 0)
    } else {
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        a68Emit(OpLea, 0, AmDisp16, srcReg, srcOff, AmAn, 0, 0)
        a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 1, 0)
        cgBlockCopy(sz)
    }
}

// cgForListStmt mirrors fpForListStmt (cprint.cla:2809-2837): the list
// handle and its count are each snapshotted ONCE, at loop entry -- a
// mutation mid-iteration is undefined per Ch5, a fixed count is the
// simplest defensible choice, matching the C reference exactly -- but
// EVERY iteration re-derives the element's address via a fresh rtListAt
// call (never caches one across iterations), since the backing store CAN
// relocate (list.cla's own relocation discipline) even though the loop
// itself never grows/shrinks the list.
//
// The three loop-scope values (list ptr, count, index) live on the REAL
// machine stack (three `-(A7)` pushes at entry, addressed by FIXED
// small offsets from the CURRENT A7 for the loop's whole duration -- same
// precedent cgForRangeStmt's own single `to` value already establishes,
// widened to three slots), NOT this file's own statement-temp pool: that
// pool's bump allocator resets to 0 at the START OF EVERY STATEMENT
// (cgStmt's own save/fresh/restore wrapper), including each of THIS loop's
// own body statements -- reusing it here would let the body's first nested
// statement's own temp allocation silently alias the SAME physical slot
// this loop is using for its own persistent index/count, corrupting the
// loop the moment its body needs even one temp of its own. The real stack
// has no such per-statement reset: every value pushed here survives the
// body's own arbitrarily many balanced push/JSR/cleanup sequences (the
// SAME invariant cgForRangeStmt's own doc comment already established),
// exactly as long as this loop's own 12 bytes stay reserved.
func cgForListStmt(s: int) {
    var elemT: int
    var vOff: int
    var condLbl: int
    var incrLbl: int
    var endLbl: int

    vOff = cgFindFrameOffset(irForListV(s))
    if vOff == cgUnresolved {
        abort("cg68k: unresolved for-list variable " + poolGet(irForListV(s)))
    }
    elemT = irtElem(irExprType(irForListListV(s)))

    cgExpr(irForListListV(s))
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0) // push list
    a68Emit(OpMove, 4, AmInd, 7, 0, AmDn, 0, 0)    // D0 = list (peek)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0) // push list (rtListCount's own arg)
    cgJsrByName(rnListCount)
    cgCleanupStack(4)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0) // push count -> list@4(A7), count@0(A7)
    a68Emit(OpClr, 4, AmNone, 0, 0, AmPreDec, 7, 0) // push index=0 -> index@0, count@4, list@8

    condLbl = a68NewLabel()
    incrLbl = a68NewLabel()
    endLbl = a68NewLabel()

    a68Bind(condLbl)
    a68Emit(OpMove, 4, AmInd, 7, 0, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDisp16, 7, 4, AmDn, 1, 0)
    a68Emit(OpCmp, 4, AmDn, 1, 0, AmDn, 0, 0)
    a68EmitBr(OpBcc, 12, endLbl) // GE: index>=count -> end

    a68Emit(OpMove, 4, AmDisp16, 7, 8, AmDn, 0, 0) // D0 = list
    a68Emit(OpMove, 4, AmInd, 7, 0, AmDn, 1, 0)    // D1 = index
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 1, 0, AmPreDec, 7, 0)
    cgJsrByName(rnListAt)
    cgCleanupStack(8)
    a68Emit(OpMovea, 4, AmDn, 0, 0, AmAn, 0, 0)
    cgCopyElemInto(6, vOff, elemT)

    cgLoopBreakLabels.add(endLbl)
    cgLoopContinueLabels.add(incrLbl)
    cgStmts(irForListBody(s))
    cgLoopBreakLabels.pop()
    cgLoopContinueLabels.pop()

    a68Bind(incrLbl)
    a68Emit(OpAddq, 4, AmImm, 0, 1, AmInd, 7, 0)
    a68EmitBr(OpBra, 0, condLbl)

    a68Bind(endLbl)
    cgCleanupStack(12)
}

// cgForMapStmt mirrors fpForMapStmt (cprint.cla:2846-2882): an index loop
// over rtMapCount/rtMapKeyAt/rtMapValAt -- same three-value real-stack
// scratch shape as cgForListStmt above, same reasoning. Iteration order is
// insertion-order/unspecified for `map`/`intmap` (both hashtable-backed)
// and ascending key order ONLY for `sortedmap` (map-hashtable phase: the
// CARRIED DEFERRED FINDING from Task 5 -- this comment previously claimed
// ascending order for the plain hashtable too, true only back when rt_map
// was sorted-array-backed). Map's own key/val accessors are OUT-PARAM style
// (unlike List's address-returning rtListAt), so the loop variable's
// address is simply LEA'd and passed directly -- no separate copy step
// (IntMap's own KeyAt is the one exception, see below). The value fetch
// only runs when the loop declared one (irForMapV(s) != -1, parseForStmt's
// own "no second IDENT" signal for `for k in m` without a value variable).
//
// map-hashtable phase Task 2: SForMap is REUSED for a SortedMap receiver
// too (no new IR stmt kind) -- `prefix` (the iterated map expr's own IR
// kind) selects the rtSortedMap*/rtMap* family this loop calls.
//
// map-hashtable phase Task 7: SForMap is reused a THIRD time for an IntMap
// receiver -- `intM` (derived the same way as `prefix`) selects a
// DIFFERENT KeyAt shape: rtIntMapKeyAt(m, i) RETURNS the key in D0 (an
// int), unlike rtMapKeyAt/rtSortedMapKeyAt's own out-param
// `(m, i, &kOff)` triple -- Count/ValAt keep the SAME out-param shape
// (values are fixed-size regardless of key type), so only the KeyAt call
// site branches.
func cgForMapStmt(s: int) {
    var kOff: int
    var vOff: int
    var condLbl: int
    var incrLbl: int
    var endLbl: int
    var countIdx: int
    var keyAtIdx: int
    var valAtIdx: int
    var intM: bool

    kOff = cgFindFrameOffset(irForMapK(s))
    if kOff == cgUnresolved {
        abort("cg68k: unresolved for-map key variable " + poolGet(irForMapK(s)))
    }
    vOff = cgUnresolved
    if irForMapV(s) != -1 {
        vOff = cgFindFrameOffset(irForMapV(s))
        if vOff == cgUnresolved {
            abort("cg68k: unresolved for-map value variable " + poolGet(irForMapV(s)))
        }
    }

    // Findings 1.4 (Task 13): was a `prefix: string` ("rtMap"/
    // "rtSortedMap"/"rtIntMap") concatenated with "Count"/"KeyAt"/"ValAt"
    // and interned fresh at every JSR below; now a 3-way pick among
    // pre-interned rn* globals, same discipline as cgIntrMapSet/Get/
    // GetDv/Remove/cgMapReleaseGuard above.
    countIdx = rnMapCount
    keyAtIdx = rnMapKeyAt
    valAtIdx = rnMapValAt
    intM = false
    if irtKind(irExprType(irForMapMapV(s))) == KSortedMap {
        countIdx = rnSortedMapCount
        keyAtIdx = rnSortedMapKeyAt
        valAtIdx = rnSortedMapValAt
    } else if irtKind(irExprType(irForMapMapV(s))) == KIntMap {
        countIdx = rnIntMapCount
        valAtIdx = rnIntMapValAt
        intM = true
    }

    cgExpr(irForMapMapV(s))
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmInd, 7, 0, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(countIdx)
    cgCleanupStack(4)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0) // count@0, map@4
    a68Emit(OpClr, 4, AmNone, 0, 0, AmPreDec, 7, 0) // index@0, count@4, map@8

    condLbl = a68NewLabel()
    incrLbl = a68NewLabel()
    endLbl = a68NewLabel()

    a68Bind(condLbl)
    a68Emit(OpMove, 4, AmInd, 7, 0, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDisp16, 7, 4, AmDn, 1, 0)
    a68Emit(OpCmp, 4, AmDn, 1, 0, AmDn, 0, 0)
    a68EmitBr(OpBcc, 12, endLbl)

    a68Emit(OpMove, 4, AmDisp16, 7, 8, AmDn, 0, 0) // D0 = map
    a68Emit(OpMove, 4, AmInd, 7, 0, AmDn, 1, 0)    // D1 = index
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 1, 0, AmPreDec, 7, 0)
    if intM {
        // rtIntMapKeyAt(m, i) RETURNS the key in D0 -- no out-param arg,
        // store D0 straight into the key's own frame slot after the call.
        cgJsrByName(rnIntMapKeyAt)
        cgCleanupStack(8)
        cgStoreD0At(6, kOff, irIntT)
    } else {
        a68Emit(OpLea, 0, AmDisp16, 6, kOff, AmAn, 0, 0)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(keyAtIdx)
        cgCleanupStack(12)
    }

    if vOff != cgUnresolved {
        a68Emit(OpMove, 4, AmDisp16, 7, 8, AmDn, 0, 0)
        a68Emit(OpMove, 4, AmInd, 7, 0, AmDn, 1, 0)
        a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
        a68Emit(OpMove, 4, AmDn, 1, 0, AmPreDec, 7, 0)
        a68Emit(OpLea, 0, AmDisp16, 6, vOff, AmAn, 0, 0)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgJsrByName(valAtIdx)
        cgCleanupStack(12)
    }

    cgLoopBreakLabels.add(endLbl)
    cgLoopContinueLabels.add(incrLbl)
    cgStmts(irForMapBody(s))
    cgLoopBreakLabels.pop()
    cgLoopContinueLabels.pop()

    a68Bind(incrLbl)
    a68Emit(OpAddq, 4, AmImm, 0, 1, AmInd, 7, 0)
    a68EmitBr(OpBra, 0, condLbl)

    a68Bind(endLbl)
    cgCleanupStack(12)
}

// cgReturnStmt mirrors fpStmt's own SReturn arm (cprint.cla:2767-2781): the
// tracked-temp flush happens BEFORE the branch to the epilogue (unreachable
// code after an unconditional jump is pointless here same as it is in C),
// and a handle-typed (Text/List/Map) return value that IS a freshly
// tracked temp (cgLastTrackedOff, set by cgIntr's own first/last/get/
// getDv/getDvBirth arms) is handed off first -- it escapes to the caller,
// same as fpHandoff(e) for `return e;`.
func cgReturnStmt(s: int) {
    var x: int
    var rk: IRKind

    x = irReturnX(s)
    if x == -1 {
        cgFreeStmtTmps()
        a68EmitBr(OpBra, 0, cgCurEpilogueLabel)
        return
    }
    if cgCurHiddenOffset != -1 {
        if irtKind(cgCurRetType) == KRec {
            cgEmitReturnRec(x)
        } else {
            cgEmitReturnStr(x)
        }
    } else {
        cgExpr(x)
        rk = irtKind(irExprType(x))
        if (rk == KText or rk == KList or rk == KMap or rk == KSortedMap or rk == KIntMap) and cgLastTrackedOff != -1 {
            cgHandoff(cgLastTrackedOff)
        }
    }
    cgFreeStmtTmps()
    a68EmitBr(OpBra, 0, cgCurEpilogueLabel)
}

func cgBreakStmt() {
    if cgLoopBreakLabels.count == 0 {
        abort("cg68k: break outside loop")
    }
    cgFreeStmtTmps()
    a68EmitBr(OpBra, 0, cgLoopBreakLabels[cgLoopBreakLabels.count - 1])
}

func cgContinueStmt() {
    if cgLoopContinueLabels.count == 0 {
        abort("cg68k: continue outside loop")
    }
    cgFreeStmtTmps()
    a68EmitBr(OpBra, 0, cgLoopContinueLabels[cgLoopContinueLabels.count - 1])
}

// cgIsHandleKind reports whether k is a heap-owning, ARC-tracked kind
// (Text/List/Map) -- cgStmt's own SAssign arm consults this to decide
// whether a freshly evaluated src needs the cgLastTrackedOff handoff
// check.
func cgIsHandleKind(k: IRKind): bool {
    return k == KText or k == KList or k == KMap or k == KSortedMap or k == KIntMap
}

// cgStmt mirrors fpStmt's own per-statement shape (cprint.cla:2688-2803):
// saves/resets/restores the tracked-temp pool around EVERY statement (a
// nested statement -- an if/while/for body -- gets its OWN independent
// temp-tracking scope, same reentrant swap fpStmt's own saved/fresh lists
// already establish) and, for a bare SExprStmt, marks cgDiscardExprIdx
// (consulted by cgIntr's own IListPop/IListShift arm AND cgCallFnScalar's
// discard-detection, mirroring fpDiscardExprIdx exactly -- see its own doc
// comment) for the one cgExpr call this statement makes.
// SReturn/SBreak/SContinue already call cgFreeStmtTmps() themselves (their
// own tracked temps must release BEFORE the branch out, not after --
// unreachable code after an unconditional jump is pointless); every other
// statement kind gets the flush here, at the tail.
func cgStmt(s: int) {
    var k: IRStmtKind
    var dst: int
    var dstK: IRExprKind
    var dstKind: IRKind
    var savedOffs: list of int
    var savedType: list of int
    var savedNext: int
    var savedBigNext: int

    savedOffs = cgStmtTmpOffs
    savedType = cgStmtTmpType
    savedNext = cgStmtTmpNext
    savedBigNext = cgStmtBigTmpNext
    cgStmtTmpOffs = cgFreshIntList()
    cgStmtTmpType = cgFreshIntList()
    cgStmtTmpNext = 0
    cgStmtBigTmpNext = 0
    // cgLastTrackedOff resets fresh per statement -- see its own doc
    // comment (module-state block): every consuming check reads it
    // IMMEDIATELY after the one cgExpr call it cares about, so a plain
    // per-statement reset (no save/restore needed -- no compound
    // statement kind below ever reads it itself) prevents a stale value
    // from a PRIOR statement being misread as "this statement's src just
    // produced a tracked temp."
    cgLastTrackedOff = -1

    k = irStmtKind(s)
    if k == SExprStmt {
        cgDiscardExprIdx = irExprStmtX(s)
        cgExpr(irExprStmtX(s))
        cgDiscardExprIdx = -1
    } else if k == SAssign {
        dst = irAssignDst(s)
        dstK = irExprKind(dst)
        dstKind = irtKind(irExprType(dst))
        if (dstK == EVarRef or dstK == EFieldRef or dstK == EIndexRef) and cgIsScalarKind(dstKind) {
            cgEmitStoreScalarAny(dst, irAssignSrc(s))
            if cgIsHandleKind(dstKind) and cgLastTrackedOff != -1 {
                cgHandoff(cgLastTrackedOff)
            }
        } else if (dstK == EVarRef or dstK == EFieldRef or dstK == EIndexRef) and dstKind == KRec {
            // Task 16 fix: EIndexRef (a fixed-array element, e.g.
            // `h.items[0] = makeArrItem(...)`) added to this gate --
            // cgEmitStoreRec is already dst-kind-agnostic internally (every
            // arm routes through cgExprAddr(dst), which already handles
            // EIndexRef via cgIndexRefAddr), the restriction to
            // EVarRef/EFieldRef was never a real requirement, just the
            // scope Task 12 built it for. Found by Task 16's end gate:
            // arc_fixwave_arrays.cla's holder-store/standalone-store
            // checks (an Item[3]/Holder.items[3] array element store) fell
            // through to the silent "TODO SAssign" no-op below, leaving
            // the element at its default-init zero value.
            cgEmitStoreRec(dst, irAssignSrc(s))
        } else if (dstK == EVarRef or dstK == EFieldRef) and dstKind == KErr {
            cgEmitStoreErr(dst, irAssignSrc(s))
        } else if (dstK == EVarRef or dstK == EFieldRef or dstK == EIndexRef) and dstKind == KArr {
            // 5e (final-review C1): whole-fixed-array assignment (`b = a`
            // / `r.field = arr` for `arr N of T`) -- Ch3 documents fixed
            // arrays as copy-by-value; cgEmitStoreArr does the same
            // address+block-copy the KRec/KErr catch-alls above already
            // use. Was a fail-closed log+quit until this task; see git
            // history for the prior placeholder's reasoning.
            //
            // Fix-round-1 (review): a raw block copy is only sound for
            // scalar (or scalar-only-record) elements -- an element type
            // that itself cgNeedsRelease (text[n]/list of/map of, or a
            // handle-bearing record element) would have its handle
            // duplicated by the copy with NO retain, and the dst's OLD
            // handle (if any) never released: a silent double-release/
            // use-after-free, strictly worse than the build error this
            // task is replacing. cgNeedsRelease(dstKind's own KArr type)
            // already recurses into the element type (cg68k.cla:1978-1980),
            // so this one call covers nested arrays and handle-bearing
            // record elements alike. Fail closed here exactly like the
            // pre-task placeholder did for the whole KArr case; the
            // upgrade path is a retain/release walk over the block copy
            // (mirroring cgRetainAt/cgReleaseAt's own KArr loop) -- a
            // future task, not this one.
            if cgNeedsRelease(irExprType(dst)) {
                abort("cg68k: cgStmt: SAssign: whole-array assignment of handle-bearing elements unsupported natively -- assign element-wise")
            }
            cgEmitStoreArr(dst, irAssignSrc(s))
        } else {
            // Fail-closed rule (5d): any OTHER dst shape this backend
            // doesn't yet have codegen for stops the build loudly rather
            // than silently dropping the store (Task 14.7's own lesson --
            // a plausible-looking wrong value is strictly worse than a
            // build error).
            abort("cg68k: cgStmt: SAssign dst kind " + numToStr(int(dstK)) + " kind " + numToStr(int(dstKind)) + " unsupported natively")
        }
    } else if k == SStoreStr {
        cgEmitStoreStr(irStoreStrDst(s), irStoreStrSrc(s))
    } else if k == SIf {
        cgIfStmt(s)
    } else if k == SWhile {
        cgWhileStmt(s)
    } else if k == SForRange {
        cgForRangeStmt(s)
    } else if k == SForList {
        cgForListStmt(s)
    } else if k == SForMap {
        cgForMapStmt(s)
    } else if k == SReturn {
        cgReturnStmt(s)
    } else if k == SBreak {
        cgBreakStmt()
    } else if k == SContinue {
        cgContinueStmt()
    } else if k == SAttempt {
        cgAttemptStmt(s)
    } else {
        // Task 4 review fix (Important 3): every CURRENT IRStmtKind is
        // covered above (this arm is unreachable today, verified against
        // the full fixture corpora) -- same fail-closed rule (Task 14.7's
        // own lesson, cited throughout this file) applied to the one
        // dispatcher in cg68k.cla that didn't already have a hard-fail
        // fallback of its own.
        abort("cg68k: cgStmt: stmt kind " + numToStr(int(k)) + " unsupported")
    }

    if k != SReturn and k != SBreak and k != SContinue {
        cgFreeStmtTmps()
    }
    cgStmtTmpOffs = savedOffs
    cgStmtTmpType = savedType
    cgStmtTmpNext = savedNext
    cgStmtBigTmpNext = savedBigNext
}

// cgAttemptStmt (attempt-abort phase Task 4, design doc %3.1-%3.3) emits
// `attempt { body } aborted msg { handler }`, mirroring cprint.cla's own
// fpAttemptStmt shape exactly, with a68 label ids standing in for C goto
// labels:
//
//     <body -- each checked call's own BNE targets hLabel>
//     BRA aLabel
//     hLabel:
//     flag = 0
//     binder = clar_abort_msg   (256-byte block copy, Str255 == Str255)
//     <handler>
//     aLabel:
//
// cgBailTargets is pushed with hLabel ONLY around the body (design doc
// %3.2 point 3's "statically enclosing" resolution) -- the handler
// itself prints with the OUTER target already back in effect (popped
// before cgStmts(irAttemptHandler(s)) runs), so a re-abort from inside
// the handler propagates to the next enclosing attempt (or this
// function's own bail label), never back into this same attempt --
// falls out of the push/pop scoping alone, no special-case code needed
// (matches the brief's "re-abort from handler caught by outer"
// scenario). The `BRA aLabel` unconditionally skips the handler on the
// normal (non-aborting) path, always emitted regardless of whether body
// contains any checked call at all.
//
// Per Ruling A1/task-1-report P1: SP is already at the LINK-baseline
// level at every check site (immediately after cgCleanupStack), so
// entering hLabel needs NO stack-pointer restoration -- no LEA-SP-restore
// appears anywhere in this function, matching cgEmitFunc's own bail
// label (below).
func cgAttemptStmt(s: int) {
    var hLabel: int
    var aLabel: int
    var binderOff: int

    if cgBailDepth >= 32 {
        // cgBailTargets' own doc comment explains why this is a fixed
        // array (32 deep), not a heap `list` -- a real program nesting
        // `attempt` 32 levels deep is not a case worth spending
        // clarusc's own near-zero native-68k self-emit segment headroom
        // on; fail loudly rather than silently corrupt an out-of-range
        // slot.
        abort("cg68k: attempt nesting exceeds cgBailTargets' fixed depth (32)")
    }
    hLabel = a68NewLabel()
    aLabel = a68NewLabel()
    cgBailTargets[cgBailDepth] = hLabel
    cgBailDepth = cgBailDepth + 1
    cgStmts(irAttemptBody(s))
    cgBailDepth = cgBailDepth - 1

    a68EmitBr(OpBra, 0, aLabel)
    a68Bind(hLabel)
    a68Emit(OpMove, 1, AmImm, 0, 0, AmDisp16, 5, cgAbortFlagOff) // flag = false
    binderOff = cgFindFrameOffset(irAttemptBinder(s))
    a68Emit(OpLea, 0, AmDisp16, 6, binderOff, AmAn, 1, 0) // A1 = &binder (dst)
    a68Emit(OpLea, 0, AmDisp16, 5, cgAbortMsgOff, AmAn, 0, 0) // A0 = &clar_abort_msg (src)
    cgBlockCopy(256)
    cgStmts(irAttemptHandler(s))
    a68Bind(aLabel)
}

// ================================================================
// Task 8: cg_mul32/cg_div32/cg_mod32 -- hand-emitted 32-bit multiply/
// divide/modulo helper routines, emitted once (each only if used --
// cgMul32Used/etc, set by cgMul32Label/etc above) into the segment right
// after the last function. Calling convention: operands in D1(left)/
// D0(right) (exactly the register state cgArith's own push/pop sequence
// leaves them in -- no setup needed at the call site beyond the JSR),
// result in D0, no frame (no LINK/UNLK -- these are leaf helpers, not
// Clarus functions with a JT slot), callee-saves every register beyond
// D0/D1 that it clobbers (D2-D7 as needed, via individual MOVE.L
// Dn,-(A7)/(A7)+,Dn pairs -- asm68k.cla has no MOVEM).
// ================================================================

// cgEmitMul32: 32x32->32 unsigned partial-product multiply (MULU.W only
// ever multiplies two 16-bit halves into a 32-bit product -- there's no
// direct 32x32 MUL on the 68000). Splitting A (D1) and B (D0) into
// 16-bit halves: A*B mod 2^32 = lowA*lowB + ((highA*lowB + lowA*highB)
// << 16) mod 2^32 -- the highA*highB term only ever contributes to bits
// >=32, so it's never computed at all. This is a plain bit-pattern
// operation (no sign handling needed): 2's-complement multiplication's
// low 32 bits are identical whether the operands are interpreted as
// signed or unsigned, so the very same routine serves both.
func cgEmitMul32(lbl: int) {
    a68Bind(lbl)
    if a68ListingOn {
        a68Comment("cg_mul32: D1=left * D0=right -> D0 (32x32->32, MULU partial products)")
    } else {
        a68CommentMarker()
    }
    a68Emit(OpMove, 4, AmDn, 2, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 3, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 4, 0, AmPreDec, 7, 0)

    a68Emit(OpMove, 4, AmDn, 1, 0, AmDn, 2, 0)   // D2 = A
    a68Emit(OpMove, 4, AmDn, 0, 0, AmDn, 3, 0)   // D3 = B
    a68Emit(OpMulu, 2, AmDn, 3, 0, AmNone, 2, 0) // D2 = lowA*lowB

    a68Emit(OpMove, 4, AmDn, 1, 0, AmDn, 4, 0)   // D4 = A
    a68Emit(OpSwap, 0, AmNone, 0, 0, AmDn, 4, 0) // D4.low = highA
    a68Emit(OpMulu, 2, AmDn, 3, 0, AmNone, 4, 0) // D4 = highA*lowB
    a68Emit(OpSwap, 0, AmNone, 0, 0, AmDn, 4, 0)
    a68Emit(OpClr, 2, AmNone, 0, 0, AmDn, 4, 0) // D4 <<= 16 (mod 2^32): clear low word after SWAP
    a68Emit(OpAddInsn, 4, AmDn, 4, 0, AmDn, 2, 0)

    a68Emit(OpMove, 4, AmDn, 3, 0, AmDn, 4, 0)   // D4 = B
    a68Emit(OpSwap, 0, AmNone, 0, 0, AmDn, 4, 0) // D4.low = highB
    a68Emit(OpMulu, 2, AmDn, 1, 0, AmNone, 4, 0) // D4 = highB*lowA
    a68Emit(OpSwap, 0, AmNone, 0, 0, AmDn, 4, 0)
    a68Emit(OpClr, 2, AmNone, 0, 0, AmDn, 4, 0) // D4 <<= 16 (mod 2^32): clear low word after SWAP
    a68Emit(OpAddInsn, 4, AmDn, 4, 0, AmDn, 2, 0)

    a68Emit(OpMove, 4, AmDn, 2, 0, AmDn, 0, 0)

    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 4, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 3, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 2, 0)
    a68Emit(OpRts, 0, AmNone, 0, 0, AmNone, 0, 0)
}

// cgEmitDivModCore emits the shared unsigned-division core both
// cg_div32/cg_mod32 use: takes the sign off D1(A)/D0(B) into D4/D5
// (0=positive,1=negative), leaves |A| in D2 and |B| in D3, then runs a
// 32-iteration binary long division (shift-compare-subtract, MSB
// first -- classic restoring division) producing the UNSIGNED quotient
// in D2 and the UNSIGNED remainder in D6. asm68k.cla has no ADDX/ROXL,
// so the usual "shift a 64-bit dividend:remainder pair with carry into
// the remainder" trick isn't available -- instead, each iteration
// captures the dividend's outgoing top bit via Scc (SMI) BEFORE shifting
// it out, then ORs that single bit into the remainder after shifting the
// remainder left, which needs no carry flag at all. D0 doubles as the
// per-iteration bit scratch (safe: A/B's original values are already
// copied into D2/D3 by the time the loop runs). Caller (cg_div32/
// cg_mod32) is responsible for saving/restoring D2-D7 and applying the
// sign to whichever of D2 (quotient)/D6 (remainder) it wants.
func cgEmitDivModCore() {
    var lloop: int
    var lskip: int
    var la: int
    var lb: int

    a68Emit(OpMove, 4, AmDn, 1, 0, AmDn, 2, 0)  // D2 = A
    a68Emit(OpMove, 4, AmDn, 0, 0, AmDn, 3, 0)  // D3 = B
    a68Emit(OpClr, 4, AmNone, 0, 0, AmDn, 4, 0) // D4 = signA = 0
    a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 2, 0)
    la = a68NewLabel()
    a68EmitBr(OpBcc, 10, la) // BPL
    a68Emit(OpNegInsn, 4, AmNone, 0, 0, AmDn, 2, 0)
    a68Emit(OpMove, 4, AmImm, 0, 1, AmDn, 4, 0)
    a68Bind(la)
    a68Emit(OpClr, 4, AmNone, 0, 0, AmDn, 5, 0) // D5 = signB = 0
    a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 3, 0)
    lb = a68NewLabel()
    a68EmitBr(OpBcc, 10, lb) // BPL
    a68Emit(OpNegInsn, 4, AmNone, 0, 0, AmDn, 3, 0)
    a68Emit(OpMove, 4, AmImm, 0, 1, AmDn, 5, 0)
    a68Bind(lb)

    a68Emit(OpClr, 4, AmNone, 0, 0, AmDn, 6, 0)   // D6 = remainder = 0
    a68Emit(OpMove, 2, AmImm, 0, 31, AmDn, 7, 0)  // D7 = 32 iterations

    lloop = a68NewLabel()
    lskip = a68NewLabel()
    a68Bind(lloop)
    a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 2, 0)
    a68Emit(OpScc, 1, AmNone, 0, 0, AmDn, 0, 11) // SMI D0 (MI)
    a68Emit(OpAsl, 4, AmImm, 0, 1, AmDn, 2, 0)
    a68Emit(OpAsl, 4, AmImm, 0, 1, AmDn, 6, 0)
    a68Emit(OpAndInsn, 4, AmImm, 0, 1, AmDn, 0, 0)
    a68Emit(OpOrInsn, 4, AmDn, 0, 0, AmDn, 6, 0)
    a68Emit(OpCmp, 4, AmDn, 3, 0, AmDn, 6, 0)
    a68EmitBr(OpBcc, 5, lskip) // BCS: remainder < divisor -> skip
    a68Emit(OpSubInsn, 4, AmDn, 3, 0, AmDn, 6, 0)
    a68Emit(OpAddq, 4, AmImm, 0, 1, AmDn, 2, 0)
    a68Bind(lskip)
    a68Emit(OpDbra, 2, AmDn, 7, 0, AmPCLabel, 0, lloop)
}

// cg_div32: truncate-toward-zero signed division (C99) -- quotient sign
// is signA XOR signB, magnitude is the unsigned core's D2.
func cgEmitDiv32(lbl: int) {
    var lpos: int

    a68Bind(lbl)
    if a68ListingOn {
        a68Comment("cg_div32: D1=left / D0=right -> D0 (truncate toward zero, C99)")
    } else {
        a68CommentMarker()
    }
    a68Emit(OpMove, 4, AmDn, 2, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 3, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 4, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 5, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 6, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 7, 0, AmPreDec, 7, 0)

    cgEmitDivModCore()

    a68Emit(OpEor, 4, AmDn, 5, 0, AmDn, 4, 0) // D4 = signA XOR signB
    a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 4, 0)
    lpos = a68NewLabel()
    a68EmitBr(OpBcc, 7, lpos) // BEQ
    a68Emit(OpNegInsn, 4, AmNone, 0, 0, AmDn, 2, 0)
    a68Bind(lpos)
    a68Emit(OpMove, 4, AmDn, 2, 0, AmDn, 0, 0)

    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 7, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 6, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 5, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 4, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 3, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 2, 0)
    a68Emit(OpRts, 0, AmNone, 0, 0, AmNone, 0, 0)
}

// cg_mod32: remainder's sign follows the DIVIDEND only (C99 `%`) --
// unlike the quotient, this never depends on signB, just signA (D4,
// untouched by the unsigned core, which only ever touches D2/D3/D6/D7).
func cgEmitMod32(lbl: int) {
    var lpos: int

    a68Bind(lbl)
    if a68ListingOn {
        a68Comment("cg_mod32: D1=left mod D0=right -> D0 (sign follows dividend, C99)")
    } else {
        a68CommentMarker()
    }
    a68Emit(OpMove, 4, AmDn, 2, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 3, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 4, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 5, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 6, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDn, 7, 0, AmPreDec, 7, 0)

    cgEmitDivModCore()

    a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 4, 0)
    lpos = a68NewLabel()
    a68EmitBr(OpBcc, 7, lpos) // BEQ
    a68Emit(OpNegInsn, 4, AmNone, 0, 0, AmDn, 6, 0)
    a68Bind(lpos)
    a68Emit(OpMove, 4, AmDn, 6, 0, AmDn, 0, 0)

    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 7, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 6, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 5, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 4, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 3, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 2, 0)
    a68Emit(OpRts, 0, AmNone, 0, 0, AmNone, 0, 0)
}

// ================================================================
// Constant pool
// ================================================================

// cgPoolStrRef returns the a68 label id bound to litIdx's pool entry
// (cgReserveStrLitLabels must have already run this cg68Program() call).
func cgPoolStrRef(litIdx: int): int {
    cgRecordStrLit(litIdx)
    return cgStrLitLabels[litIdx]
}

// cgReserveStrLitLabels allocates (but does not yet bind) one a68 label
// per irStrLits entry -- called up front, before any function body is
// emitted, mirroring cgAssignJtSlots' own "reserve the label before
// anything can reference it" discipline. Task 8's cgExprAddr(EStrConst)
// calls cgPoolStrRef WHILE walking function bodies (a string literal
// used as an rtStrStore/rtPanic/etc argument), which is well before the
// constant pool itself is actually laid out (cgEmitPoolsBody, after
// every function) -- an unbound label used as a PC-relative operand is
// fine (a68's own two-pass model resolves it at a68Finish time, same as
// startup JSR-ing a handler emitted later in the stream), but the label
// ID itself must already exist in cgStrLitLabels by then, or
// cgPoolStrRef indexes past an empty/undersized list.
// Task 13: only reserves (allocates a68NewLabel for) entries the CURRENT
// pass's cgCurPoolStrLits filter actually names -- everything else gets
// the -1 sentinel (never bound, per cgRecRetainLbls' own established
// "don't allocate what won't bind" rule; a68Finish demands every
// allocated label be bound). The measure pass's own cgCurPoolStrLits is
// "every index" (set by cg68Measure before calling this), so it behaves
// exactly like the old unconditional-reserve-everything version; each
// real per-segment pass's cgCurPoolStrLits is that segment's own deduped
// need-set (cgPackProgram's output), so only labels that segment's own
// code will actually reference get allocated.
// Task 15 (findings 1.8): the membership test reads cgCurPoolStrLitBits
// (O(1)), cgCurPoolStrLits' own parallel bitmap, instead of scanning
// cgCurPoolStrLits itself.
func cgReserveStrLitLabels() {
    var i: int
    var labels: list of int

    labels = cgFreshIntList()
    i = 0
    while i < irStrLits.count {
        if cgCurPoolStrLitBits[i] {
            labels.add(a68NewLabel())
        } else {
            labels.add(-1)
        }
        i = i + 1
    }
    cgStrLitLabels = labels
}

// cgEmitPoolsBody lays out every per-segment constant pool AT THE
// CURRENT STREAM POSITION: one DC.B len + bytes + align entry per
// irStrLits slot, bound to the label cgReserveStrLitLabels already
// allocated for it, then the enum value tables and serdesc tables
// (cgEmitEnumTables/cgEmitSerdescTables).
// Task 13: iterates cgCurPoolStrLits (NOT 0..irStrLits.count) -- the
// measure pass sets that to "every index" (so this still emits/measures
// the whole pool once); each real per-segment pass sets it to that
// segment's own deduped need-set, so only the entries that segment's own
// code actually references get bound (cgReserveStrLitLabels already only
// allocated labels for exactly the same set, so every index reached here
// has a real, non--1 label). cgMeasuringPoolSizes (true only during the
// measure pass's own call) records each entry's standalone byte size
// into cgStrLitSize/cgEnumTableSize/cgSerdescSize/cgUiBlobSize/
// cgUiEventsSize -- cgPackProgram's own incremental per-segment cost
// accounting needs those.
func cgEmitPoolsBody() {
    var i: int
    var idx: int
    var s: string
    var before: int

    if a68ListingOn {
        a68Comment("constant pool: string literals")
    } else {
        a68CommentMarker()
    }
    i = 0
    while i < cgCurPoolStrLits.count {
        idx = cgCurPoolStrLits[i]
        s = poolGet(irStrLitPoolIdx(idx))
        before = a68SizeSoFar()
        a68Bind(cgStrLitLabels[idx])
        a68DcB(s.length)
        a68DcBytes(cg68ToText(s))
        a68Align()
        if cgMeasuringPoolSizes {
            cgStrLitSize[idx] = a68SizeSoFar() - before
        }
        i = i + 1
    }

    cgEmitEnumTables()
    cgEmitSerdescTables()

    // Task 12 (native-5e)/Task 13: the UI descriptor blob + `--events`
    // script bytes -- this is the reserved third-family constant-pool
    // slot the comment just above marks. cgUiBlobLabel/cgUiEventsLabel
    // are -1 (cgReserveUiPoolLabels) whenever this pass's own
    // cgCurPoolUsesUiBlob/cgCurPoolUsesUiEvents is false -- a non-UI
    // program (matching every other UI-only emission's "byte-for-byte
    // unchanged for a UI-free program" contract) or, now, a UI program's
    // own segment whose code never references UiProgDesc/UiTestScript.
    // The two are gated independently (a segment can need one without
    // the other).
    if cgUiBlobLabel != -1 {
        before = a68SizeSoFar()
        cgEmitUiBlobPool()
        if cgMeasuringPoolSizes {
            cgUiBlobSize = a68SizeSoFar() - before
        }
    }
    if cgUiEventsLabel != -1 {
        before = a68SizeSoFar()
        cgEmitUiEventsPool()
        if cgMeasuringPoolSizes {
            cgUiEventsSize = a68SizeSoFar() - before
        }
    }
}

// cgEmitUiBlobPool pours uiblob.cla's uibBuild() bytes -- the SAME flat,
// pointer-free UI descriptor blob cprint.cla's cpEmitUiBlob prints as a C
// array -- into the constant pool at cgUiBlobLabel, byte for byte
// (uibNativeLane, set for the duration of this one call, routes
// uibEmitLayout's own record-layout choice to cg68k's own cgRecordSize/
// cgFieldOffset authority instead of cprint's C-ABI cpCRecordSize/
// cpCFieldOffset -- see uiblob.cla's own Task 12 doc comment on
// uibEmitLayout for why the two lanes' bool/char field sizes genuinely
// differ and must not share one Layout section).
func cgEmitUiBlobPool() {
    var bytes: list of int
    var i: int

    uibNativeLane = true
    bytes = uibBuild()
    uibNativeLane = false
    if a68ListingOn {
        a68Comment("constant pool: UI descriptor blob (" + numToStr(bytes.count) + " bytes)")
    } else {
        a68CommentMarker()
    }
    a68Bind(cgUiBlobLabel)
    i = 0
    while i < bytes.count {
        a68DcB(bytes[i])
        i = i + 1
    }
    a68Align()
}

// cgEmitUiEventsPool pours the `--events FILE` bytes (main.cla read them
// verbatim into cgEventsBytes; empty text for a build with no --events
// flag) into the pool at cgUiEventsLabel, NUL-terminated -- UiTestScript()
// resolves here (cgCallExtUiBlobAddr), and rtUiLaunch/rtUiRun's own
// `peekb(UiTestScript()) != 0` gate (ui.cla/uiscript.cla) is exactly "is
// the first byte non-NUL", so an absent --events flag (cgEventsBytes
// empty) correctly degrades to a single 0 byte -- "not a scripted build".
func cgEmitUiEventsPool() {
    if a68ListingOn {
        a68Comment("constant pool: --events script bytes (" + numToStr(cgEventsBytes.length) + " bytes + NUL)")
    } else {
        a68CommentMarker()
    }
    a68Bind(cgUiEventsLabel)
    a68DcBytes(cgEventsBytes)
    a68DcB(0)
    a68Align()
}

// cgReserveUiPoolLabels allocates (but does not yet bind) the UI blob/
// events pool labels -- same "reserve early" discipline as
// cgReserveStrLitLabels, called alongside it (both cg68Measure's throwaway
// pass and cg68Program's real per-segment pass), so UiProgDesc/
// UiTestScript call sites reached while walking an earlier function body
// already have a valid (if not yet bound) label to reference. Task 13:
// each is gated independently by this pass's own cgCurPoolUsesUiBlob/
// cgCurPoolUsesUiEvents (the measure pass sets both to irIsUiProgram(),
// matching the old unconditional behavior; each real per-segment pass
// sets them to that segment's own need, cgPackProgram's output) -- a
// segment whose code never references one of the two leaves that
// label at -1, never bound, per a68Finish's own "every allocated label
// must be bound" contract.
//
// runtime-ir-bake Task 2: dropped the extra `irIsUiProgram() and` conjunct
// that used to gate both branches -- under the superset splice, ui*.cla
// (including uidesc.cla/uitable.cla's UiProgDesc-reading helpers and the
// `callback func rtUiLdefDraw`/rtUiScrollbarAction LDEF/control glue) is
// spliced into EVERY program, and cg68SynthCbGlue's own callback rooting
// is a deliberate over-approximation (shake.cla: "over-approximation is
// always safe here" -- every callback name an ECbAddr decay was EVER
// built for anywhere in the combined program gets both its glue and body
// unconditionally rooted, dead code included). So a non-UI program can
// now have a REAL, reachable call chain into UiProgDesc() (observed:
// arith.cla's rtUiLdefDraw -> ...table drawing... -> uidStrPtr ->
// UiProgDesc()) even though irIsUiProgram() is false -- exactly the same
// "synthesized/rooted regardless of program shape, but the backing data
// was only allocated for a UI-shaped program" mismatch Step 0 already
// fixed for the reverse-waist dispatchers. cgCurPoolUsesUiBlob/
// cgCurPoolUsesUiEvents ALONE is already the precise, correct signal here
// (cgFuncUsesUiBlob-derived per-segment real need, cgPackProgram's own
// output on the real per-segment pass; == irIsUiProgram() on the measure
// pass, per this function's own header comment -- so this change is a
// no-op for measure and for every UI-program segment whose need was
// already accurately tracked; it only changes the previously-broken
// non-UI-program-with-a-real-reference case).
func cgReserveUiPoolLabels() {
    if cgCurPoolUsesUiBlob {
        cgUiBlobLabel = a68NewLabel()
    } else {
        cgUiBlobLabel = -1
    }
    if cgCurPoolUsesUiEvents {
        cgUiEventsLabel = a68NewLabel()
    } else {
        cgUiEventsLabel = -1
    }
}

// ================================================================
// Top level
// ================================================================

// cgParseDecimal parses a plain non-negative decimal literal (main.cla's
// `--seglimit N` test-only flag and `--partition N` flag are this
// function's two callers) -- no sign, no whitespace, no error reporting
// beyond silently ignoring any non-digit byte. Fine for --seglimit
// (a value only ever supplied by a test harness in full control of its
// own argv); --partition's own call site (main.cla) validates its raw
// string BEFORE calling this, since that flag is now reachable from a
// real build script (scripts/build-clarusc-mac.sh) where a typo must
// fail loudly rather than silently degrade to 0.
func cgParseDecimal(s: string): int {
    var n: int
    var i: int

    n = 0
    i = 0
    while i < s.length {
        if s[i] >= '0' and s[i] <= '9' {
            n = n * 10 + (int(s[i]) - int('0'))
        }
        i = i + 1
    }
    return n
}

// cgSegBase strips outPath's trailing ".ext" ("out.bin" -> "out") -- the
// segment file names are <base>.segN.s / <base>.segN.dat. Falls back to
// outPath verbatim if it has no '.' at all.
func cgSegBase(outPath: string): string {
    var i: int
    var last: int

    last = -1
    i = 0
    while i < outPath.length {
        if outPath[i] == '.' {
            last = i
        }
        i = i + 1
    }
    if last == -1 {
        return outPath
    }
    return outPath[0, last]
}

// cgAppName derives the MacBinary application name from outPath: strip
// the directory (everything up to and including the last '/') the same
// way cgSegBase strips the extension, then clamp to the app68Build
// appName param's own string(31) capacity (the store below does this
// automatically -- string(n) assignment clamps rather than overruns, per
// the language reference -- spelled out here because it's easy to miss).
func cgAppName(outPath: string): string(31) {
    var base: string
    var lastSlash: int
    var i: int
    var name: string(31)

    base = cgSegBase(outPath)
    lastSlash = -1
    i = 0
    while i < base.length {
        if base[i] == '/' {
            lastSlash = i
        }
        i = i + 1
    }
    if lastSlash == -1 {
        name = base
    } else {
        name = base[lastSlash + 1, base.length - lastSlash - 1]
    }
    return name
}

// cg68ResourceParitySet (Task 13, native-5e) assembles the extraTypes/
// extraIds/extraDatas triples app68Build folds in beside CODE/SIZE --
// same rules as scripts/build-mac.sh:81-232's Rez-driven appres.r
// generation, mirrored here for the native (no Rez, no Retro68) lane:
//   - a UI program (irIsUiProgram()) unconditionally gets the base alert
//     ALRT/DITL 128 + 130 (runtime/mac/alert.r's own resources -- askOpen
//     error / askSaveChanges, reachable from ui.cla/uidialogs.cla
//     regardless of whether the program declares an `app` section).
//   - an app-declared program (irHasApp) additionally gets the About
//     ALRT/DITL 129 (icon item present iff the program also declares an
//     app icon), a `vers` resource when a version is declared, and --
//     only when an app icon is declared (cgAppIconPath != "") -- the
//     signature STR + FREF 128/129 + BNDL 128 + app ICN#/ICON 128
//     (decoded from the declared PBM) + the static doc icon ICN#/ICON
//     129. SIZE(-1) is always present, for every program, with
//     isHighLevelEventAware set iff irIsUiProgram() (app68BuildSize's own
//     doc comment) -- REVISED, mac-resident-clarusc Task 12: originally
//     iff irHasApp, but that left every UI program with no `app` section
//     (testdata/valid/bounce.cla is exactly this shape) unable to receive
//     the required-suite Quit AppleEvent this task adds native handling
//     for, wedging Finder shutdown (the first System 7.1 boot's own
//     finding) -- the AE handlers this task installs (ui.cla's
//     nat_UiLaunchReal) are unconditional for every UI program, `app`
//     section or not, so the SIZE flag that makes the Process Manager
//     WILLING to send them AppleEvents in the first place must match.
// A declared icon path that can't be read, or isn't a well-formed 32x32
// PBM, no longer fails the compile (attempt-abort Task 7, spec %6 --
// deliberately excluded from Task 6's abort()-conversion sweep of this
// module's other fatal sites, since this pair gets a warning + fallback
// instead): it logs a warning on both channels (log() and
// driveProgress()) and proceeds with hasIcon = false, exactly the path
// every icon-less app already takes -- byte-identical fork to compiling
// the same source with no `icon:` property at all. check.cla/main.cla
// never validates the file itself (build-time-only per ir.cla's header
// comment), so this is still the first point anything actually opens it
// for a native build; it just no longer treats that failure as fatal.
func cg68ResourceParitySet(extraTypes: list of string, extraIds: list of int, extraDatas: list of text) {
    var hasIcon: bool
    var pbmRaw: text
    var iconBytes: text
    var icnBytes: text
    var docIcon: text
    var docIcn: text
    var idStr: string
    var verStr: string

    if irIsUiProgram() {
        extraTypes.add("ALRT")
        extraIds.add(128)
        extraDatas.add(app68BuildAlrt(40, 40, 190, 460, 128))
        extraTypes.add("DITL")
        extraIds.add(128)
        extraDatas.add(app68BuildDitl128())
        extraTypes.add("ALRT")
        extraIds.add(130)
        extraDatas.add(app68BuildAlrt(40, 40, 156, 420, 130))
        extraTypes.add("DITL")
        extraIds.add(130)
        extraDatas.add(app68BuildDitl130())
    }

    // Both warning sites below use a BARE log(), no driveProgress twin
    // (onlog phase): they used to write both, so a GUI front end saw the
    // line on screen as well as on the persistent channel. Since
    // `on App.log` exists, log() reaches both by itself -- macgui.cla's
    // handler routes it into the Log window -- and driveProgress is
    // itself just feProgress, i.e. log() again, so keeping the twin
    // duplicated the line on BOTH channels. Same double-append class
    // gcCompile's own bakeMsg fix removed. On the host CLI both calls
    // already landed on stderr, so dropping one only removes a
    // pre-existing duplicate there too; resparity_test.go's
    // Contains-based assertion is satisfied by the surviving line.
    hasIcon = cgAppIconPath != ""
    iconBytes = ""
    if hasIcon {
        pbmRaw = ""
        if not file.readText(cgAppIconPath, pbmRaw) {
            log("warning: cannot read app icon " + cgAppIconPath + ": " + lastError.message + "; using default icon")
            hasIcon = false
        } else {
            icnBytes = ""
            if not app68BuildIcnFamily(pbmRaw, iconBytes, icnBytes) {
                log("warning: app icon " + cgAppIconPath + " is not a well-formed 32x32 P1/P4 PBM; using default icon")
                hasIcon = false
                iconBytes = ""
            }
        }
    }

    if irHasApp {
        extraTypes.add("ALRT")
        extraIds.add(129)
        extraDatas.add(app68BuildAlrt(40, 40, 220, 460, 129))
        extraTypes.add("DITL")
        extraIds.add(129)
        extraDatas.add(app68BuildDitl129(hasIcon, 128))

        if irAppVersion != -1 {
            verStr = poolGet(irAppVersion)
            extraTypes.add("vers")
            extraIds.add(1)
            extraDatas.add(app68BuildVers(verStr, cgAppRawName + " " + verStr))
        }

        if hasIcon {
            verStr = ""
            if irAppVersion != -1 {
                verStr = poolGet(irAppVersion)
            }
            idStr = cgAppRawName + " " + verStr

            extraTypes.add(poolGet(irAppId))
            extraIds.add(0)
            extraDatas.add(app68BuildStr255(idStr))

            extraTypes.add("FREF")
            extraIds.add(128)
            extraDatas.add(app68BuildFref("APPL", 0))
            extraTypes.add("FREF")
            extraIds.add(129)
            extraDatas.add(app68BuildFref("TEXT", 1))

            extraTypes.add("BNDL")
            extraIds.add(128)
            extraDatas.add(app68BuildBndl(poolGet(irAppId)))

            extraTypes.add("ICN#")
            extraIds.add(128)
            extraDatas.add(icnBytes)
            extraTypes.add("ICON")
            extraIds.add(128)
            extraDatas.add(iconBytes)

            docIcon = ""
            app68DocIconBitmapAppend(docIcon)
            docIcn = ""
            docIcn.append(docIcon)
            app68DocIconMaskAppend(docIcn)
            extraTypes.add("ICN#")
            extraIds.add(129)
            extraDatas.add(docIcn)
            extraTypes.add("ICON")
            extraIds.add(129)
            extraDatas.add(docIcon)
        }
    }

    extraTypes.add("SIZE")
    extraIds.add(-1)
    extraDatas.add(app68BuildSize(irIsUiProgram(), cgSizePartitionBytes))
}

// cg68BuildFork (Task 9, mac-resident-clarusc -- split out of what used to
// be cg68WriteImage's own body) assembles the raw resource-fork image
// (app68k.cla's app68BuildFork -- CODE 0, CODE 1..N, plus every extra
// resource: Task 13's resource-parity set, Task 5's `--bake` CLFS
// resources) and the creator code it resolves from the program's app
// section, storing both into cgLastFork/cgLastCreator. jtEntries/jtSegNums
// are indexed by FINAL JT slot number (cgAssignFinalJtSlots), already
// fully populated by cg68ProgramFork's own per-segment loop; segBytes[s-1]
// is segment s's raw code bytes (cgSegJtFirst[s-1]/cgSegJtCount[s-1] give
// that segment's own JT range for its CODE-N header). creator (Task 13,
// native-5e) is the program's own declared app id (irAppId) when it
// declared one, else "????" (the unregistered-developer creator code,
// this repo's own existing default, scripts/build-mac.sh's
// `${APPID:-????}`) -- matches the MacBinary header's own creator field.
// No outPath here: unlike the old cg68WriteImage, building the fork needs
// no output path at all -- naming is either the wrap step's own concern
// (cg68WriteImageWrap, still outPath-derived, for the host MacBinary
// file) or the app section's own declared name (cgAppRawName, already
// resolved by drive.cla's driveManifestSplice), for a front end with no
// outPath to derive from. Always succeeds today (kept `bool` to match
// driveEmit68kFork's own shape and leave room for a future failure path).
func cg68BuildFork(jtEntries: list of int, jtSegNums: list of int, segBytes: list of text): bool {
    var extraTypes: list of string
    var extraIds: list of int
    var extraNames: list of string
    var extraDatas: list of text
    var bi: int

    if irHasApp and irAppId != -1 {
        cgLastCreator = poolGet(irAppId)
    } else {
        cgLastCreator = "????"
    }

    extraTypes = cgFreshStringList()
    extraIds = cgFreshIntList()
    extraDatas = cgFreshTextList()
    cg68ResourceParitySet(extraTypes, extraIds, extraDatas)

    // cg68ResourceParitySet's own resources are never named -- pad
    // extraNames with "" to match, one per entry it just added.
    extraNames = cgFreshStringList()
    bi = 0
    while bi < extraTypes.count {
        extraNames.add("")
        bi = bi + 1
    }

    // Task 5 (mac-resident-clarusc), generalized to typed blobs by
    // runtime-ir-bake Task 6: one resource per cgBakeNames entry (see its
    // own doc comment above -- ordinary `--bake FILE` CLFS sources, then
    // the CLIR artifact + stamp sidecar if `--bake-ir` was also given),
    // id 128+i in entry order, named cgBakeNames[i], typed
    // cgBakeTypes[i], bytes cgBakeDatas[i] verbatim. All three lists stay
    // empty for every ordinary build (no --bake/--bake-ir flag), so this
    // loop is a no-op and the resource set -- and the resulting image --
    // stays byte-identical to before either task.
    bi = 0
    while bi < cgBakeNames.count {
        extraTypes.add(cgBakeTypes[bi])
        extraIds.add(128 + bi)
        extraNames.add(cgBakeNames[bi])
        extraDatas.add(cgBakeDatas[bi])
        bi = bi + 1
    }

    cgLastFork = app68BuildFork(segBytes, jtEntries, jtSegNums, cgSegJtFirst, cgSegJtCount, cgGlobalsBelowA5Size, extraTypes, extraIds, extraNames, extraDatas)
    return true
}

// cg68WriteImageWrap (Task 9, mac-resident-clarusc) is cg68WriteImage's
// other half: wrap cg68BuildFork's last output (cgLastFork/cgLastCreator)
// in a MacBinary header named from outPath (app68k.cla's app68WrapFork)
// and write it. Together with cg68BuildFork, byte-identical to the old
// single-function cg68WriteImage for every existing (host) caller --
// drive.cla's driveEmit68k calls cg68ProgramFork (which calls
// cg68BuildFork) then this, in sequence.
func cg68WriteImageWrap(outPath: string): bool {
    var img: text

    img = app68WrapFork(cgAppName(outPath), cgLastCreator, cgLastFork)
    // native-gaps-cleanup Task 2: file.writeText's own mandatory type/
    // creator args -- fileTypeApplication ('APPL') describes this output
    // (a native 68k application image) exactly; creator is the SAME value
    // cg68BuildFork already resolved (the app's own declared id, else
    // '????').
    if not file.writeText(outPath, img, fileTypeApplication, cgLastCreator) {
        log("cg68WriteImageWrap: cannot write " + outPath + ": " + lastError.message)
        return false
    }
    return true
}

// cg68Measure runs the WHOLE program (startup + cg_init_globals, every
// reachable function, the duplicated-glue bundle, the constant pool)
// through the real emitter EXACTLY ONCE, into one throwaway a68 stream,
// recording each function's own standalone byte size (cgFuncSize) plus
// the three fixed byte costs cgPackProgram needs (cgSeg1ExtraSize/
// cgGlueBundleSize/cgPoolSize) -- see this file's Task 15 header comment
// for why re-running the real emitter (rather than a parallel size
// formula) is both correct and cheap here. Also freezes cgMul32Used/
// cgDiv32Used/cgMod32Used: every function's own body runs here, so by
// the time this returns, whether the program uses `*`/`/`/`mod` ANYWHERE
// is fully and finally known -- cg68Program's own per-segment pass never
// touches those three flags again.
func cg68Measure(): bool {
    var i: int
    var before: int
    var startupLbl: int
    var initGlobalsLbl: int
    var freeGlobalsLbl: int
    var segPlaceholder: list of int
    var allStrLits: list of int
    var allEnumTables: list of int
    var allSerdescs: list of int

    a68Reset()
    cgResetCodegenState()
    cgAssignGlobalOffsets()
    cgReservePanicMsgs()

    // Task 15 (findings 1.8): size the epoch-stamp membership lists once,
    // to the dense IR-arena universe -- see cgSeenEpoch's own doc
    // comment. cgSeenEpoch itself starts at its int default 0 and is
    // always bumped before first use (below), so this all-zero fill
    // never collides with a real epoch.
    cgStrLitSeen = cgFreshIntListSized(irStrLits.count)
    cgEnumSeen = cgFreshIntListSized(irEnums.count)
    cgSerdescSeen = cgFreshIntListSized(irRecords.count)

    // Task 13: this pass measures the WHOLE pool (every entry gets a
    // label and gets emitted, exactly like the pre-Task-13 unconditional
    // behavior) -- cgPackProgram is what later decides each real
    // segment's own subset, using the per-entry usage/size data this
    // pass records below. Built directly from irLayoutNeeded/counts
    // (not by reading back cgSerdescLabels etc., which don't exist yet).
    allStrLits = cgFreshIntList()
    i = 0
    while i < irStrLits.count {
        allStrLits.add(i)
        i = i + 1
    }
    allEnumTables = cgFreshIntList()
    i = 0
    while i < irEnums.count {
        allEnumTables.add(i)
        i = i + 1
    }
    allSerdescs = cgFreshIntList()
    i = 0
    while i < irRecords.count {
        if irLayoutNeeded(irRecordLayoutName(i)) {
            allSerdescs.add(i)
        }
        i = i + 1
    }
    cgCurPoolStrLits = allStrLits
    cgCurPoolEnumTables = allEnumTables
    cgCurPoolSerdescs = allSerdescs
    cgCurPoolUsesUiBlob = irIsUiProgram()
    cgCurPoolUsesUiEvents = irIsUiProgram()
    cgAllStrLits = allStrLits
    cgAllEnumTables = allEnumTables
    cgAllSerdescs = allSerdescs

    // Task 15 (findings 1.8): cgCurPool*Bits is built every time
    // cgCurPool* is assigned -- see cgCurPoolStrLitBits' own doc comment.
    cgCurPoolStrLitBits = cgBoolBitmapFromList(cgCurPoolStrLits, irStrLits.count)
    cgCurPoolEnumBits = cgBoolBitmapFromList(cgCurPoolEnumTables, irEnums.count)
    cgCurPoolSerdescBits = cgBoolBitmapFromList(cgCurPoolSerdescs, irRecords.count)

    cgReserveStrLitLabels()
    cgReserveUiPoolLabels()
    cgAssignRcWalkLabels()
    cgReserveEnumTableLabels()
    cgReserveSerdescLabels()
    cgAssignMeasureFuncLabels()

    // Task 13: per-function/bucket constant-pool usage, parallel to
    // cgFuncSize/cgFuncFrameSizes below -- filled in as the function
    // loop, cgEmitStartup+cgEmitInitGlobalsStub, and the glue bundle run
    // further down (cgRecMode toggled around each).
    cgFuncStrLits = cgFreshIntListList()
    cgFuncEnumTables = cgFreshIntListList()
    cgFuncSerdescs = cgFreshIntListList()
    cgFuncUsesUiBlob = cgFreshBoolList()
    cgFuncUsesUiEvents = cgFreshBoolList()
    i = 0
    while i < irFuncs.count {
        cgFuncStrLits.add(cgFreshIntList())
        cgFuncEnumTables.add(cgFreshIntList())
        cgFuncSerdescs.add(cgFreshIntList())
        cgFuncUsesUiBlob.add(false)
        cgFuncUsesUiEvents.add(false)
        i = i + 1
    }
    cgSeg1StrLits = cgFreshIntList()
    cgSeg1EnumTables = cgFreshIntList()
    cgSeg1Serdescs = cgFreshIntList()
    cgSeg1UsesUiBlob = false
    cgSeg1UsesUiEvents = false
    cgGlueStrLits = cgFreshIntList()
    cgGlueEnumTables = cgFreshIntList()
    cgGlueSerdescs = cgFreshIntList()
    cgGlueUsesUiBlob = false
    cgGlueUsesUiEvents = false

    // Placeholders only -- cgCallFunc's same-segment/cross-segment
    // compare always reads "equal" here (every entry 0, cgCurFuncSegment
    // 0), which always picks the BSR.W arm; per this section's own
    // FIXED-SIZE INVARIANT that's exactly as correctly-sized as the real
    // cross-segment JSR form would be, and a68Finish() never runs against
    // this throwaway stream so nothing ever dereferences these labels.
    segPlaceholder = cgFreshIntList()
    i = 0
    while i < irFuncs.count {
        segPlaceholder.add(0)
        i = i + 1
    }
    cgFuncSegment = segPlaceholder
    cgCurFuncSegment = 0
    cgJtSlots = cgFreshIntList()
    i = 0
    while i < irFuncs.count {
        cgJtSlots.add(0)
        i = i + 1
    }

    // cgFuncFrameSizes (Task 4) is pre-sized to all zeros BEFORE
    // cgEmitStartup's own call below -- cgEmitStartup calls
    // cgStackHeuristic, which reads this list; during THIS throwaway
    // measure pass it's still empty of real data (cgEmitFunc hasn't run
    // yet), so the heuristic falls back to its 32768 floor here, which is
    // fine: only the ADDA instruction's fixed 6-byte SIZE matters for
    // measurement, never the immediate's actual value (a real value is
    // only needed, and available, on the SECOND cgEmitStartup call in
    // cg68Program's real per-segment pass, which runs after this whole
    // measure pass -- including the cgEmitFunc loop below -- completes).
    cgFuncFrameSizes = cgFreshIntList()
    i = 0
    while i < irFuncs.count {
        cgFuncFrameSizes.add(0)
        i = i + 1
    }

    startupLbl = a68NewLabel()
    initGlobalsLbl = a68NewLabel()
    freeGlobalsLbl = a68NewLabel()
    cgFreeGlobalsLbl = freeGlobalsLbl

    before = a68SizeSoFar()
    // Task 15 (findings 1.8): bump the epoch before this recording
    // context (cgRecMode 2's own single stream) begins.
    cgSeenEpoch = cgSeenEpoch + 1
    cgRecMode = 2
    cgEmitStartup(startupLbl, initGlobalsLbl, freeGlobalsLbl)
    cgEmitInitGlobalsStub(initGlobalsLbl)
    cgRecMode = 0
    cgSeg1ExtraSize = a68SizeSoFar() - before

    cgFuncSize = cgFreshIntList()
    i = 0
    while i < irFuncs.count {
        if shakeReachable(i) {
            // object-code-linker Task 3: a baked+valid function's own
            // size/frame/pool-usage came out of a REAL Measure pass at
            // bake time (Amendment A5 -- cg68Measure never calls
            // a68Finish, so there was never any BYTE production to
            // suppress here either way); install that recorded data
            // straight into the same per-function tables cgEmitFunc's
            // own recording would have filled, instead of re-running it.
            // See this file's own cgObjPasteEligible doc comment for why
            // cgSeg1ExtraSize/cgGlueBundleSize/cgPoolSize and the pool
            // size tables, just below this loop, are NOT given the same
            // treatment.
            if cgObjPasteEligible(i) {
                cgFuncSize.add(bkLdObjFuncSize[i])
                cgFuncFrameSizes[i] = bkLdObjFuncFrameSize[i]
                cgFuncStrLits[i] = cgObjBuildFuncStrLits(i)
                cgFuncEnumTables[i] = cgObjFlatSlice(bkLdObjFuncEnumTableFlat, bkLdObjFuncEnumTableFirst[i], bkLdObjFuncEnumTableCount[i])
                cgFuncSerdescs[i] = cgObjFlatSlice(bkLdObjFuncSerdescFlat, bkLdObjFuncSerdescFirst[i], bkLdObjFuncSerdescCount[i])
                cgFuncUsesUiBlob[i] = bkLdObjFuncUsesUiBlob[i]
                cgFuncUsesUiEvents[i] = bkLdObjFuncUsesUiEvents[i]
                cgObjApplyGlueUsage(i)
            } else {
                before = a68SizeSoFar()
                // Task 15 (findings 1.8): bump the epoch per cgRecFuncIdx
                // change -- each function gets its own recording context.
                cgSeenEpoch = cgSeenEpoch + 1
                cgRecMode = 1
                cgRecFuncIdx = i
                cgEmitFunc(i)
                cgRecMode = 0
                cgFuncSize.add(a68SizeSoFar() - before)
            }
        } else {
            cgFuncSize.add(0)
        }
        driveProgressTick()
        i = i + 1
    }

    before = a68SizeSoFar()
    // Task 15 (findings 1.8): bump the epoch before this recording
    // context (cgRecMode 3's own single stream) begins.
    cgSeenEpoch = cgSeenEpoch + 1
    cgRecMode = 3
    if cgMul32Used {
        cgEmitMul32(cgMul32Lbl)
    }
    if cgDiv32Used {
        cgEmitDiv32(cgDiv32Lbl)
    }
    if cgMod32Used {
        cgEmitMod32(cgMod32Lbl)
    }
    cgEmitFreeGlobalsStub(freeGlobalsLbl)
    cgEmitRcWalks()
    cgRecMode = 0
    cgGlueBundleSize = a68SizeSoFar() - before

    // Task 13: capture every pool entry's own standalone byte size --
    // cgCurPool* is still "everything" from the setup above, so this
    // final whole-pool emission is unchanged in scope from the pre-
    // Task-13 version; cgMeasuringPoolSizes routes cgEmitPoolsBody's
    // (and cgEmitEnumTables'/cgEmitSerdescTables') own per-entry
    // before/after deltas into cgStrLitSize/cgEnumTableSize/
    // cgSerdescSize/cgUiBlobSize/cgUiEventsSize, which cgPackProgram's
    // incremental per-segment cost accounting needs.
    cgStrLitSize = cgFreshIntList()
    i = 0
    while i < irStrLits.count {
        cgStrLitSize.add(0)
        i = i + 1
    }
    cgEnumTableSize = cgFreshIntList()
    i = 0
    while i < irEnums.count {
        cgEnumTableSize.add(0)
        i = i + 1
    }
    cgSerdescSize = cgFreshIntList()
    i = 0
    while i < irRecords.count {
        cgSerdescSize.add(0)
        i = i + 1
    }
    cgUiBlobSize = 0
    cgUiEventsSize = 0

    cgMeasuringPoolSizes = true
    before = a68SizeSoFar()
    cgEmitPoolsBody()
    cgPoolSize = a68SizeSoFar() - before
    cgMeasuringPoolSizes = false

    return true
}

// cgPackProgram runs first-fit bin packing, in declaration order, over
// every reachable irFuncs entry's own measured size (cgFuncSize) --
// segment 1 is opened up front (startup/cg_init_globals must live
// somewhere even if the program packs zero functions into it) with a
// budget reduced by its own extra fixed cost; every later segment opens
// on demand with the plain fixed cost (duplicated-glue bundle, no
// startup/cg_init_globals). A function that can't fit even a BRAND NEW,
// otherwise-empty non-segment-1 segment (the most generous possible
// budget) can never be packed at all -- a named compile error, not a
// crash, per the plan's own spec requirement.
//
// Task 13: the fixed per-segment budget no longer folds in cgPoolSize
// (the WHOLE program's pool -- the old design's own scaling limit, see
// this file's own Task 13 header note above). Instead each segment
// tracks its own accumulating pool need-set (segStrSets[s]/
// segEnumSets[s]/segSerdescSets[s]/segUiBlob[s]/segUiEvents[s]) and is
// charged only the MARGINAL bytes a candidate function/bucket's own pool
// needs actually add to that set (cgPoolDeltaPeek to probe a fit,
// cgPoolDeltaAndUnion to commit once placed) -- a constant referenced
// from N segments is charged, and appears, in exactly those N segments'
// own pools, matching the interface this task's brief specifies. Every
// segment (including a fresh one) is seeded with the every-segment glue
// bucket (cgGlue*, the duplicated-glue bundle's own pool needs); segment
// 1 additionally seeds with the seg1-only bucket (cgSeg1*, startup+
// cg_init_globals' own pool needs) -- mirroring cgSeg1ExtraSize/
// cgGlueBundleSize's existing code-side split exactly, just for pool
// bytes instead of code bytes.
func cgPackProgram(): bool {
    var i: int
    var sz: int
    var s: int
    var placed: bool
    var segUsed: list of int
    var segAvail: list of int
    var segStrSets: list of list of int
    var segEnumSets: list of list of int
    var segSerdescSets: list of list of int
    var segStrBits: list of list of bool
    var segEnumBits: list of list of bool
    var segSerdescBits: list of list of bool
    var segUiBlob: list of bool
    var segUiEvents: list of bool
    var freshAvail: int
    var fixedBase: int
    var candDelta: int
    var totalDelta: int
    var newStrSet: list of int
    var newEnumSet: list of int
    var newSerdescSet: list of int
    var newStrBits: list of bool
    var newEnumBits: list of bool
    var newSerdescBits: list of bool
    var newUiBlob: bool
    var newUiEvents: bool
    var newUsed: int

    fixedBase = cgSegHeaderSize + cgGlueBundleSize
    freshAvail = cgSegLimit - fixedBase

    cgFuncSegment = cgFreshIntList()
    i = 0
    while i < irFuncs.count {
        cgFuncSegment.add(-1)
        i = i + 1
    }

    segUsed = cgFreshIntList()
    segAvail = cgFreshIntList()
    segStrSets = cgFreshIntListList()
    segEnumSets = cgFreshIntListList()
    segSerdescSets = cgFreshIntListList()
    segStrBits = cgFreshBoolListList()
    segEnumBits = cgFreshBoolListList()
    segSerdescBits = cgFreshBoolListList()
    segUiBlob = cgFreshBoolList()
    segUiEvents = cgFreshBoolList()

    // Open segment 1: seed with the every-segment glue bucket, then the
    // seg1-only bucket. Task 15 (findings 1.8): segStrBits[s]/
    // segEnumBits[s]/segSerdescBits[s] are segStrSets[s]/etc's own
    // O(1)-membership bitmaps, length irStrLits.count/irEnums.count/
    // irRecords.count, all-false for a fresh segment -- every site that
    // appends to or replaces a segSet below keeps its segBits in
    // lockstep (cgPoolDeltaAndUnion sets bits as it appends; the
    // single-segment wholesale REPLACE near the end of this function
    // rebuilds its bitmap from the replacement list's own contents).
    segStrSets.add(cgFreshIntList())
    segEnumSets.add(cgFreshIntList())
    segSerdescSets.add(cgFreshIntList())
    segStrBits.add(cgFreshBoolListSized(irStrLits.count))
    segEnumBits.add(cgFreshBoolListSized(irEnums.count))
    segSerdescBits.add(cgFreshBoolListSized(irRecords.count))
    segUiBlob.add(false)
    segUiEvents.add(false)
    newUsed = 0
    newUsed = newUsed + cgPoolDeltaAndUnion(cgGlueStrLits, cgStrLitSize, segStrSets[0], segStrBits[0])
    newUsed = newUsed + cgPoolDeltaAndUnion(cgGlueEnumTables, cgEnumTableSize, segEnumSets[0], segEnumBits[0])
    newUsed = newUsed + cgPoolDeltaAndUnion(cgGlueSerdescs, cgSerdescSize, segSerdescSets[0], segSerdescBits[0])
    if cgGlueUsesUiBlob {
        newUsed = newUsed + cgUiBlobSize
        segUiBlob[0] = true
    }
    if cgGlueUsesUiEvents {
        newUsed = newUsed + cgUiEventsSize
        segUiEvents[0] = true
    }
    newUsed = newUsed + cgPoolDeltaAndUnion(cgSeg1StrLits, cgStrLitSize, segStrSets[0], segStrBits[0])
    newUsed = newUsed + cgPoolDeltaAndUnion(cgSeg1EnumTables, cgEnumTableSize, segEnumSets[0], segEnumBits[0])
    newUsed = newUsed + cgPoolDeltaAndUnion(cgSeg1Serdescs, cgSerdescSize, segSerdescSets[0], segSerdescBits[0])
    if cgSeg1UsesUiBlob and not segUiBlob[0] {
        newUsed = newUsed + cgUiBlobSize
        segUiBlob[0] = true
    }
    if cgSeg1UsesUiEvents and not segUiEvents[0] {
        newUsed = newUsed + cgUiEventsSize
        segUiEvents[0] = true
    }
    segUsed.add(newUsed)
    segAvail.add(cgSegLimit - fixedBase - cgSeg1ExtraSize)

    i = 0
    while i < irFuncs.count {
        if shakeReachable(i) {
            sz = cgFuncSize[i]
            placed = false
            s = 0
            while s < segUsed.count {
                candDelta = cgPoolDeltaPeek(cgFuncStrLits[i], cgStrLitSize, segStrSets[s], segStrBits[s])
                candDelta = candDelta + cgPoolDeltaPeek(cgFuncEnumTables[i], cgEnumTableSize, segEnumSets[s], segEnumBits[s])
                candDelta = candDelta + cgPoolDeltaPeek(cgFuncSerdescs[i], cgSerdescSize, segSerdescSets[s], segSerdescBits[s])
                if cgFuncUsesUiBlob[i] and not segUiBlob[s] {
                    candDelta = candDelta + cgUiBlobSize
                }
                if cgFuncUsesUiEvents[i] and not segUiEvents[s] {
                    candDelta = candDelta + cgUiEventsSize
                }
                totalDelta = sz + candDelta
                if segUsed[s] + totalDelta <= segAvail[s] {
                    segUsed[s] = segUsed[s] + totalDelta
                    cgPoolDeltaAndUnion(cgFuncStrLits[i], cgStrLitSize, segStrSets[s], segStrBits[s])
                    cgPoolDeltaAndUnion(cgFuncEnumTables[i], cgEnumTableSize, segEnumSets[s], segEnumBits[s])
                    cgPoolDeltaAndUnion(cgFuncSerdescs[i], cgSerdescSize, segSerdescSets[s], segSerdescBits[s])
                    if cgFuncUsesUiBlob[i] {
                        segUiBlob[s] = true
                    }
                    if cgFuncUsesUiEvents[i] {
                        segUiEvents[s] = true
                    }
                    cgFuncSegment[i] = s + 1
                    placed = true
                    break
                }
                s = s + 1
            }
            if not placed {
                // Fresh segment: seed with the every-segment glue bucket
                // only (never the seg1-only bucket -- a fresh segment is
                // never segment 1).
                newStrSet = cgFreshIntList()
                newEnumSet = cgFreshIntList()
                newSerdescSet = cgFreshIntList()
                newStrBits = cgFreshBoolListSized(irStrLits.count)
                newEnumBits = cgFreshBoolListSized(irEnums.count)
                newSerdescBits = cgFreshBoolListSized(irRecords.count)
                newUiBlob = false
                newUiEvents = false
                newUsed = 0
                newUsed = newUsed + cgPoolDeltaAndUnion(cgGlueStrLits, cgStrLitSize, newStrSet, newStrBits)
                newUsed = newUsed + cgPoolDeltaAndUnion(cgGlueEnumTables, cgEnumTableSize, newEnumSet, newEnumBits)
                newUsed = newUsed + cgPoolDeltaAndUnion(cgGlueSerdescs, cgSerdescSize, newSerdescSet, newSerdescBits)
                if cgGlueUsesUiBlob {
                    newUsed = newUsed + cgUiBlobSize
                    newUiBlob = true
                }
                if cgGlueUsesUiEvents {
                    newUsed = newUsed + cgUiEventsSize
                    newUiEvents = true
                }

                candDelta = cgPoolDeltaPeek(cgFuncStrLits[i], cgStrLitSize, newStrSet, newStrBits)
                candDelta = candDelta + cgPoolDeltaPeek(cgFuncEnumTables[i], cgEnumTableSize, newEnumSet, newEnumBits)
                candDelta = candDelta + cgPoolDeltaPeek(cgFuncSerdescs[i], cgSerdescSize, newSerdescSet, newSerdescBits)
                if cgFuncUsesUiBlob[i] and not newUiBlob {
                    candDelta = candDelta + cgUiBlobSize
                }
                if cgFuncUsesUiEvents[i] and not newUiEvents {
                    candDelta = candDelta + cgUiEventsSize
                }
                totalDelta = sz + candDelta

                if newUsed + totalDelta > freshAvail {
                    log("function " + poolGet(irFuncName(i)) + " exceeds the 32KB segment limit")
                    return false
                }

                cgPoolDeltaAndUnion(cgFuncStrLits[i], cgStrLitSize, newStrSet, newStrBits)
                cgPoolDeltaAndUnion(cgFuncEnumTables[i], cgEnumTableSize, newEnumSet, newEnumBits)
                cgPoolDeltaAndUnion(cgFuncSerdescs[i], cgSerdescSize, newSerdescSet, newSerdescBits)
                if cgFuncUsesUiBlob[i] {
                    newUiBlob = true
                }
                if cgFuncUsesUiEvents[i] {
                    newUiEvents = true
                }

                segUsed.add(newUsed + totalDelta)
                segAvail.add(freshAvail)
                segStrSets.add(newStrSet)
                segEnumSets.add(newEnumSet)
                segSerdescSets.add(newSerdescSet)
                segStrBits.add(newStrBits)
                segEnumBits.add(newEnumBits)
                segSerdescBits.add(newSerdescBits)
                segUiBlob.add(newUiBlob)
                segUiEvents.add(newUiEvents)
                cgFuncSegment[i] = segUsed.count
            }
        }
        i = i + 1
    }

    // Single-segment golden compatibility: a program that packs into
    // exactly one segment has no cross-segment duplication concern at
    // all (there's only one copy of anything, ever) -- restore that
    // segment's pool to the WHOLE program's pool (cgAllStrLits/
    // cgAllEnumTables/cgAllSerdescs, every irIsUiProgram() program's
    // blob+events), matching the pre-Task-13 unconditional behavior
    // byte-for-byte, PROVIDED it still fits this segment's own budget
    // (segAvail[0] -- computed with cgSeg1ExtraSize already deducted,
    // same as every other check in this function). A single-segment
    // program is comfortably under 32KB for every fixture this repo
    // currently has; the fallback below (skip the restore if it
    // wouldn't fit) keeps this purely a compatibility nicety, never a
    // correctness risk, for the rare single-segment program whose pool
    // is large enough that the difference would matter.
    if segUsed.count == 1 {
        candDelta = cgPoolDeltaPeek(cgAllStrLits, cgStrLitSize, segStrSets[0], segStrBits[0])
        candDelta = candDelta + cgPoolDeltaPeek(cgAllEnumTables, cgEnumTableSize, segEnumSets[0], segEnumBits[0])
        candDelta = candDelta + cgPoolDeltaPeek(cgAllSerdescs, cgSerdescSize, segSerdescSets[0], segSerdescBits[0])
        if irIsUiProgram() and not segUiBlob[0] {
            candDelta = candDelta + cgUiBlobSize
        }
        if irIsUiProgram() and not segUiEvents[0] {
            candDelta = candDelta + cgUiEventsSize
        }
        if segUsed[0] + candDelta <= segAvail[0] {
            // Whole-list REPLACE, not a union merge: cgAllStrLits/etc
            // are already in ascending declaration order (0..count-1,
            // cg68Measure's own construction), matching the pre-Task-13
            // emission order exactly; a union merge would instead
            // append the restored entries in "encounter order" at the
            // tail of segStrSets[0]'s own partial accumulation,
            // producing the same SET but a different byte ORDER.
            // Task 15 (findings 1.8): the wholesale replace REBUILDS
            // segStrBits[0]/segEnumBits[0]/segSerdescBits[0] from the
            // replacement lists' own contents -- these bitmaps must stay
            // in lockstep with the ordered lists they mirror.
            segStrSets[0] = cgAllStrLits
            segEnumSets[0] = cgAllEnumTables
            segSerdescSets[0] = cgAllSerdescs
            segStrBits[0] = cgBoolBitmapFromList(cgAllStrLits, irStrLits.count)
            segEnumBits[0] = cgBoolBitmapFromList(cgAllEnumTables, irEnums.count)
            segSerdescBits[0] = cgBoolBitmapFromList(cgAllSerdescs, irRecords.count)
            if irIsUiProgram() {
                segUiBlob[0] = true
                segUiEvents[0] = true
            }
        }
    }

    cgSegCount = segUsed.count
    cgSegStrLitSets = segStrSets
    cgSegEnumTableSets = segEnumSets
    cgSegSerdescSets = segSerdescSets
    cgSegUsesUiBlob = segUiBlob
    cgSegUsesUiEvents = segUiEvents
    return true
}

// ================================================================
// object-code-linker Task 2: bake-time object capture.
//
// cgBakeCapture gates a small set of hooks inside cg68ProgramFork below
// (function-loop item-range recording, a per-segment post-a68Finish
// run/hole dump, and skipping the real cg68BuildFork write) -- set only
// by cgObjCaptureRuntime, this section's own top-level entry point,
// which bake.cla's bakeWriteFile calls once, for the 68k lane only,
// AFTER the runtime-only chain has been checked+lowered (never by an
// ordinary compile).
//
// WHY THIS WORKS WITHOUT TOUCHING asm68k.cla (Task 1's own probe
// finding): a68 binds every label's ADDRESS immediately (a68Bind) and
// defers only ENCODING to a68Finish, and every item's addr/len is fixed
// at push time (a68PushInstr) -- so by the time a segment's own
// a68Finish succeeds, every captured item's byte range is already known;
// only the ENCODED BYTES (a68Bytes()) needed Finish to run. Walking
// a68Items[start..end) per function, post-Finish, is therefore both
// necessary and sufficient.
//
// CAPTURE REPRESENTATION (Task 1's chosen shape): per function, an
// alternating sequence run[0],hole[0],run[1],...,hole[n-1],run[n] --
// each run a raw post-peephole byte blob, each hole the a68 item shape
// (op/size/sm/sr/sv/dm/dr/dv) MINUS the hole-side operand's own value
// (overwritten at paste/link time from kind+sym, never meaningfully
// captured -- stored 0) plus a kind/class/symbol triple:
//
//   kind (cgHoleCall/cgHoleJtAddr/cgHoleLabel): what the link pass DOES
//   with the hole -- cgHoleCall re-emits via cgCallFunc(sym) verbatim
//   (Amendment A1: the opcode word, BSR.W vs JSR d16(A5), is universe-
//   dependent, so a call is captured as ONE hole regardless of which
//   form bake time happened to pick, never a displacement patch);
//   cgHoleJtAddr re-emits the SAME captured op/size/modes but
//   recomputes the JT-slot address (cgJtDisp(cgJtSlot(sym))) for a
//   callback UPP's `LEA d16(A5),An`; cgHoleLabel re-emits the captured
//   op/size/modes with a resolved label id substituted into whichever
//   operand slot was the hole.
//
//   cls (cgRelCls*, meaningful only for cgHoleLabel): which of Amendment
//   A3's families `sym` indexes into -- five pool families
//   (str/enum/serdesc/uiBlob/uiEvents), the four glue labels (folded
//   into ONE class, symbolized 1..4), the two per-record RC-walk label
//   families, and Amendment A2's synthesized panic-message literal
//   (cgRelClsPanicMsg -- resolved from the live cgListOobMsgIdx global
//   at link time, never a numeric strlit index baked in at capture
//   time, since that index differs bake-vs-compile). cgRelClsFuncLabel/
//   cgRelClsJt are two DEFENSIVE class values that never actually
//   survive into a stored hole (cgObjRecordHole promotes both to
//   cgHoleCall, or cgHoleJtAddr for the JT/Lea case) -- kept as real
//   class ids anyway, not folded away, so a hole in either shape a
//   future emitter change might produce still round-trips instead of
//   silently misclassifying.
// ================================================================

// cgBakeCapture: see this section's own header comment.
var cgBakeCapture: bool

const cgHoleCall: int = 1
const cgHoleJtAddr: int = 2
const cgHoleLabel: int = 3
// cgHoleCbGlueAddr (discovered running this section's own capture over a
// forced-fully-reachable runtime-only universe, beyond anything Task 1's
// probe corpus exercised -- see cgObjRecordHole's own doc comment): an
// LEA d16(A5),An materializing a `callback func` Pascal-glue trampoline's
// address (cgCallExtUiGlueAddr, e.g. ui.cla's nat_UiLaunchReal handing
// AEInstallEventHandler the `aeQuitHandler` UPP) is shaped exactly like
// cgHoleJtAddr, but its TARGET is not a stable baked function: the
// trampoline is synthesized fresh by cg68SynthCbGlue on EVERY compile
// (never baked, --rtbake included -- Task 3's own Measure-skip only ever
// applies to indices below bkRuntimeFuncBoundary), so its numeric index
// varies compile to compile the same way Amendment A2's panic-message
// strlit index does. sym is therefore NOT a target func index here -- it
// is an index into irCbGlueNames (ir.cla, already a stable, truncation-
// symmetric baked section), resolved at link time as
// cgCbGlueFuncIdx[sym] AFTER a fresh cg68SynthCbGlue() call.
const cgHoleCbGlueAddr: int = 4

const cgRelClsPoolStr: int = 1
const cgRelClsPoolEnum: int = 2
const cgRelClsPoolSer: int = 3
const cgRelClsPoolUiBlob: int = 4
const cgRelClsPoolUiEvt: int = 5
const cgRelClsFuncLabel: int = 6
const cgRelClsGlue: int = 7
const cgRelClsRcRetain: int = 8
const cgRelClsRcRelease: int = 9
const cgRelClsPanicMsg: int = 10
const cgRelClsJt: int = 11

// cgRelClsUnknown (fix round 1, review finding I1): cgObjHoleOf's own
// signal for "this IS a position-dependent site (an out-of-function
// AmPCLabel), but none of cgObjBuildLabelMaps' own label->class tables
// know it" -- distinct from cgHoleClsNone (0, "not a hole at all", the
// ordinary/common case: no PC-relative operand, or an intra-function
// branch). Conflating the two would silently bake the position-
// dependent bytes verbatim into a run instead of a hole. Never a real
// wire value; cgObjDumpSegment fails the bake loudly the moment it sees
// this, per Amendment A3's own "fails the bake loudly" clause.
const cgRelClsUnknown: int = -1

// CgObjHole is one captured hole record -- the a68 item shape a paste
// (Task 3) re-emits from, minus the hole-side operand's own value. See
// this section's own header comment for the kind/cls/sym contract.
record CgObjHole {
    kind: int
    cls: int
    sym: int
    op: int
    size: int
    sm: int
    sr: int
    sv: int
    dm: int
    dr: int
    dv: int
    srcSlot: bool
}

// cgObjValid[i]/cgObjRunFirst[i]/cgObjHoleFirst[i]/cgObjNHoles[i]:
// irFuncs index i's own captured object (sized to irFuncs.count by
// cg68ProgramFork right before its segment loop, when cgBakeCapture).
// RunFirst/HoleFirst index into the two FLAT, whole-capture-run arrays
// below; NHoles run/hole pairs alternate run[0],hole[0],...,hole[n-1],
// run[n] -- n+1 runs total for n holes, matching bake.cla's own
// bkWriteObjCode framing exactly (see that function's own doc comment).
var cgObjValid: list of bool
var cgObjRunFirst: list of int
var cgObjHoleFirst: list of int
var cgObjNHoles: list of int

// cgObjRuns: flat, one entry per captured byte run across the WHOLE
// capture (every segment cg68ProgramFork packs this call), in the order
// cgObjDumpSegment appends them.
var cgObjRuns: list of text

// cgObjHoles: flat, one entry per captured hole, same ordering
// convention as cgObjRuns.
var cgObjHoles: list of CgObjHole

// cgObjHoleSymOut: cgObjHoleOf's own out-parameter (Clarus functions
// return one value) -- the classified symbol for whatever hole class it
// just returned, or -1 when the return was cgHoleClsNone (not a hole).
var cgObjHoleSymOut: int
const cgHoleClsNone: int = 0

// cgObjDumpSegment's own segFuncIdx/segItemStart/segItemEnd/segTainted
// PARAMETERS (not globals -- deliberately: self-compiling clarusc came
// within a few hundred bytes of tipping an unrelated, already-near-the-
// 32KB-ceiling cprint.cla function over its own single-function segment
// limit, and every program-level `var` this section adds is one more
// release call cg_free_globals must carry, duplicated into EVERY
// segment's own glue bundle; these four are pure per-segment scratch
// with exactly one producer (cg68ProgramFork's own function loop) and
// one consumer (cgObjDumpSegment, called right after), so they cost
// nothing as locals) hold which function occupies which [start,end)
// a68Items.count range in the CURRENT segment's own item stream
// (segFuncIdx/segItemStart/segItemEnd), and whether that function's own
// emission hit an unresolvable-at-bake-time reference (segTainted[k] --
// cgCallExtUiSynth/cgCallExtUiGlueAddr's own cgObjCaptureTainted set,
// checked and reset around each cgEmitFunc call) -- cgObjDumpSegment
// leaves cgObjValid false for a tainted function instead of recording
// its incomplete/wrong bytes.

// cgObjCaptureTainted: see cgCallExtUiSynth's own doc comment.
var cgObjCaptureTainted: bool

// cgObjSetLbl records label l's own (class, symbol) into lblCls/lblSym
// (cgObjBuildLabelMaps' own locals, threaded through as params -- see
// that function's own doc comment for why), guarded the same "-1
// sentinel, don't index what was never allocated" way cgRecRetainLbls'
// own doc comment establishes (a record with no handle field, an unused
// glue routine, ...).
func cgObjSetLbl(lblCls: list of int, lblSym: list of int, l: int, cls: int, sym: int) {
    if l < 0 {
        return
    }
    if l >= lblCls.count {
        return
    }
    lblCls[l] = cls
    lblSym[l] = sym
}

// cgObjBuildLabelMaps fills lblCls[l]/lblSym[l] -- label id l's own
// (class, symbol) -- for the CURRENT segment's own a68 label-id space.
// Params, not globals (cgObjDumpSegment's own doc comment explains the
// tradeoff): rebuilt every segment regardless (a68 label ids are only
// valid within the segment that allocated them, a68Reset wipes
// a68LabelAddr per segment), so there is nothing to preserve across
// calls that a fresh local wouldn't already provide. Mirrors
// cg68ProgramFork's own per-segment label-reservation calls
// (cgReserveStrLitLabels and friends) reverse-mapped: those calls hand
// out label ids forward (pool entry -> label), this walks the SAME
// arrays backward (label -> pool entry).
func cgObjBuildLabelMaps(lblCls: list of int, lblSym: list of int) {
    var i: int

    i = 0
    while i < lblCls.count {
        lblCls[i] = cgHoleClsNone
        lblSym[i] = -1
        i = i + 1
    }
    i = 0
    while i < cgStrLitLabels.count {
        cgObjSetLbl(lblCls, lblSym, cgStrLitLabels[i], cgRelClsPoolStr, i)
        i = i + 1
    }
    i = 0
    while i < cgEnumTableLabels.count {
        cgObjSetLbl(lblCls, lblSym, cgEnumTableLabels[i], cgRelClsPoolEnum, i)
        i = i + 1
    }
    i = 0
    while i < cgSerdescLabels.count {
        cgObjSetLbl(lblCls, lblSym, cgSerdescLabels[i], cgRelClsPoolSer, i)
        i = i + 1
    }
    cgObjSetLbl(lblCls, lblSym, cgUiBlobLabel, cgRelClsPoolUiBlob, 0)
    cgObjSetLbl(lblCls, lblSym, cgUiEventsLabel, cgRelClsPoolUiEvt, 0)
    i = 0
    while i < cgRecRetainLbls.count {
        cgObjSetLbl(lblCls, lblSym, cgRecRetainLbls[i], cgRelClsRcRetain, i)
        i = i + 1
    }
    i = 0
    while i < cgRecReleaseLbls.count {
        cgObjSetLbl(lblCls, lblSym, cgRecReleaseLbls[i], cgRelClsRcRelease, i)
        i = i + 1
    }
    if cgMul32Used {
        cgObjSetLbl(lblCls, lblSym, cgMul32Lbl, cgRelClsGlue, 1)
    }
    if cgDiv32Used {
        cgObjSetLbl(lblCls, lblSym, cgDiv32Lbl, cgRelClsGlue, 2)
    }
    if cgMod32Used {
        cgObjSetLbl(lblCls, lblSym, cgMod32Lbl, cgRelClsGlue, 3)
    }
    cgObjSetLbl(lblCls, lblSym, cgFreeGlobalsLbl, cgRelClsGlue, 4)
    i = 0
    while i < cgFuncLabels.count {
        cgObjSetLbl(lblCls, lblSym, cgFuncLabels[i], cgRelClsFuncLabel, i)
        i = i + 1
    }
}

// cgObjFuncForJtSlot answers which irFuncs index owns JT slot `slot`, or
// -1 -- a plain linear scan rather than a precomputed inverse map
// (cgObjHoleOf's only caller): kept off the global list deliberately
// (self-compiling clarusc came within a few hundred bytes of tipping an
// unrelated, already-near-the-32KB-ceiling cprint.cla function over its
// own single-function segment limit -- see cgObjDumpSegment's own param
// doc comment for the same tradeoff made for its four scratch lists).
// Bake-time-only cost (never runs in a compiled Clarus program), and
// cgTotalJtSlots/irFuncs.count are small enough (low thousands) that a
// scan per hole is not remotely a bottleneck.
func cgObjFuncForJtSlot(slot: int): int {
    var i: int

    i = 0
    while i < irFuncs.count {
        if shakeReachable(i) and cgJtSlots[i] == slot {
            return i
        }
        i = i + 1
    }
    return -1
}

// cgObjHoleOf classifies a68 item idx (belonging to the function
// occupying byte range [a0, a1)) as a hole -- position-dependent content
// the artifact cannot bake verbatim -- or cgHoleClsNone if it is
// ordinary self-contained code. Mirrors Task 1's own empirically-proven
// rule: a KindInstr item is a hole iff it carries a POSITIVE d16(A5)
// displacement (a JT slot -- globals are always negative,
// cgAssignGlobalOffsets being a downward prefix-sum) or an AmPCLabel
// operand whose bound label address falls OUTSIDE [a0, a1) (an
// intra-function branch stays a plain byte, correctly). Sets
// cgObjHoleSymOut as this function's own out-parameter. lblCls/lblSym
// are cgObjBuildLabelMaps' own output for the CURRENT segment (passed
// through, not read off a global -- see that function's own doc
// comment).
func cgObjHoleOf(idx: int, a0: int, a1: int, lblCls: list of int, lblSym: list of int): int {
    var lbl: int
    var slot: int

    cgObjHoleSymOut = -1
    if a68Items[idx].kind != KindInstr {
        return cgHoleClsNone
    }
    if a68Items[idx].dm == AmDisp16 and a68Items[idx].dr == 5 and a68Items[idx].dv >= 32 {
        slot = (a68Items[idx].dv - 34) / 8
        cgObjHoleSymOut = cgObjFuncForJtSlot(slot)
        return cgRelClsJt
    }
    if a68Items[idx].sm == AmDisp16 and a68Items[idx].sr == 5 and a68Items[idx].sv >= 32 {
        slot = (a68Items[idx].sv - 34) / 8
        cgObjHoleSymOut = cgObjFuncForJtSlot(slot)
        return cgRelClsJt
    }
    lbl = -1
    if a68Items[idx].sm == AmPCLabel {
        lbl = a68Items[idx].sv
    }
    if a68Items[idx].dm == AmPCLabel {
        lbl = a68Items[idx].dv
    }
    if lbl < 0 {
        return cgHoleClsNone
    }
    if a68LabelAddr[lbl] >= a0 and a68LabelAddr[lbl] < a1 {
        return cgHoleClsNone
    }
    cgObjHoleSymOut = lblSym[lbl]
    if lblCls[lbl] == cgHoleClsNone {
        // fix round 1 (I1): an out-of-function AmPCLabel that
        // cgObjBuildLabelMaps never classified -- structurally a hole,
        // but this file doesn't know which kind. Signalled distinctly
        // from "not a hole" so the caller fails loudly instead of
        // baking the position-dependent bytes verbatim.
        return cgRelClsUnknown
    }
    return lblCls[lbl]
}

// cgObjRecordHole appends one hole record for a68 item idx, classified
// cls with symbol sym (cgObjHoleOf's own output) -- Amendment A1 (a
// JT-slot or same-segment-Bsr function reference collapses to
// cgHoleCall, an LEA-shaped JT reference to cgHoleJtAddr, everything
// else stays cgHoleLabel), Amendment A2 (a cgRelClsPoolStr hole whose
// symbol equals the live cgListOobMsgIdx becomes cgRelClsPanicMsg
// instead of a numeric strlit index), and the cgHoleCbGlueAddr case (an
// LEA-shaped JT reference whose target is a cg68SynthCbGlue-synthesized
// trampoline, not a stable baked function -- cgCbGlueSlotIdx's own
// non -1 result redirects sym from a transient func index to a stable
// irCbGlueNames position) are all applied here, once, so every other
// caller (cgObjDumpSegment) stays a plain classify-then-record loop.
func cgObjRecordHole(idx: int, cls: int, sym: int) {
    var h: CgObjHole
    var c: int
    var s: int
    var cbSlot: int

    c = cls
    s = sym
    if c == cgRelClsPoolStr and s == cgListOobMsgIdx {
        c = cgRelClsPanicMsg
    }
    h.kind = cgHoleLabel
    if c == cgRelClsJt or (c == cgRelClsFuncLabel and a68Items[idx].op == OpBsr) {
        h.kind = cgHoleCall
    }
    if c == cgRelClsJt and a68Items[idx].op == OpLea {
        h.kind = cgHoleJtAddr
        cbSlot = cgCbGlueSlotIdx(s)
        if cbSlot >= 0 {
            h.kind = cgHoleCbGlueAddr
            s = cbSlot
        }
    }
    // fix round 1 (review finding I3): cls is wire-meaningful ONLY for
    // kind==cgHoleLabel (cgHoleCall/JtAddr/CbGlueAddr all resolve
    // entirely from kind+sym, per their own table in this section's
    // header doc comment) -- zeroed here for every other kind so the
    // shipped bytes actually match that documented contract, rather
    // than leaking c's own pre-collapse classification (cgRelClsJt/
    // cgRelClsFuncLabel) onto the wire unused.
    h.cls = c
    if h.kind != cgHoleLabel {
        h.cls = 0
    }
    h.sym = s
    h.op = int(a68Items[idx].op)
    h.size = a68Items[idx].size
    h.sm = int(a68Items[idx].sm)
    h.sr = a68Items[idx].sr
    h.dm = int(a68Items[idx].dm)
    h.dr = a68Items[idx].dr
    if a68Items[idx].sm == AmPCLabel or (a68Items[idx].sm == AmDisp16 and a68Items[idx].sr == 5) {
        h.srcSlot = true
        h.sv = 0
        h.dv = a68Items[idx].dv
    } else {
        h.srcSlot = false
        h.sv = a68Items[idx].sv
        h.dv = 0
    }
    cgObjHoles.add(h)
}

// cgObjSlice returns b[start, start+n) as its own copy -- text has no
// slice operator, so this is a plain byte-by-byte append, mirroring
// every other per-byte text-building loop in this file.
func cgObjSlice(b: text, start: int, n: int): text {
    var t: text
    var i: int

    t = ""
    i = 0
    while i < n {
        t.append(b[start + i])
        i = i + 1
    }
    return t
}

// cgObjDumpSegment (called once per segment, right after that segment's
// own a68Finish succeeds) walks every function captured this segment
// (segFuncIdx/segItemStart/segItemEnd -- cg68ProgramFork's own local
// scratch, populated by its function loop and passed straight through,
// see that block's own doc comment for why these are params, not
// globals) and appends its byte runs + hole records into the flat,
// whole-capture cgObjRuns/cgObjHoles arrays.
//
// Fix round 1 (review finding I1, Amendment A3's own "fails the bake
// loudly" clause): returns false, after logging a specific reason, on
// any of the four invariant violations a silently-wrong bake could
// otherwise produce -- (a) cgObjHoleOf returning cgRelClsUnknown (an
// out-of-function position-dependent reference this file's own label
// maps don't classify -- without this check it would fall through as
// "not a hole" and get baked into a run verbatim, wrong the moment
// layout ever differs from bake time); (b) a hole's own symbol
// resolving negative (cgObjFuncForJtSlot found no owning function for a
// JT slot -- without this check a -1 "target func index" would
// serialize and only surface as a confusing loader-side refusal, far
// from its actual cause); (c) a hole site whose own byte width isn't
// exactly 4 (Task 1's own proven invariant for every hole shape this
// format supports -- asm68k.cla's own len field, no re-measurement
// needed); (d) the subsuming per-function assertion
// sum(len(runs)) + 4*holes == cgFuncSize[f], the cheapest whole-function
// proof that (a)-(c) didn't miss a case together.
func cgObjDumpSegment(segFuncIdx: list of int, segItemStart: list of int, segItemEnd: list of int, segTainted: list of bool): bool {
    var k: int
    var i: int
    var st: int
    var en: int
    var a0: int
    var a1: int
    var cls: int
    var b: text
    var f: int
    var nh: int
    var runStart: int
    var lblCls: list of int
    var lblSym: list of int
    var sumLen: int
    var p: int

    lblCls = cgFreshIntListSized(a68LabelAddr.count)
    lblSym = cgFreshIntListSized(a68LabelAddr.count)
    cgObjBuildLabelMaps(lblCls, lblSym)
    b = a68Bytes()
    k = 0
    while k < segFuncIdx.count {
        // object-code-linker Task 2: a tainted function's own emission
        // hit an unresolvable-at-bake-time reference (cgCallExtUiSynth's
        // own doc comment) -- its bytes are incomplete/wrong by
        // construction; leave cgObjValid false for it (its irFuncs
        // index's own default) rather than recording anything.
        if not segTainted[k] {
            f = segFuncIdx[k]
            st = segItemStart[k]
            en = segItemEnd[k]
            a0 = a68Items[st].addr
            if en < a68Items.count {
                a1 = a68Items[en].addr
            } else {
                a1 = a68Pc
            }

            cgObjValid[f] = true
            cgObjRunFirst[f] = cgObjRuns.count
            cgObjHoleFirst[f] = cgObjHoles.count
            nh = 0
            runStart = 0
            i = st
            while i < en {
                cls = cgObjHoleOf(i, a0, a1, lblCls, lblSym)
                if cls == cgRelClsUnknown {
                    log("cg68k: bake capture: unresolvable position-dependent reference in " + poolGet(irFuncName(f)))
                    return false
                }
                if cls != cgHoleClsNone {
                    if cgObjHoleSymOut < 0 {
                        log("cg68k: bake capture: hole with no resolved symbol in " + poolGet(irFuncName(f)))
                        return false
                    }
                    if a68Items[i].len != 4 {
                        log("cg68k: bake capture: hole width != 4 bytes in " + poolGet(irFuncName(f)))
                        return false
                    }
                    nh = nh + 1
                    cgObjRuns.add(cgObjSlice(b, a0 + runStart, (a68Items[i].addr - a0) - runStart))
                    cgObjRecordHole(i, cls, cgObjHoleSymOut)
                    runStart = (a68Items[i].addr - a0) + a68Items[i].len
                }
                i = i + 1
            }
            cgObjRuns.add(cgObjSlice(b, a0 + runStart, (a1 - a0) - runStart))
            cgObjNHoles[f] = nh

            // Amendment A3's subsuming per-function assertion: the
            // captured runs, plus 4 bytes per hole, must exactly
            // reproduce the function's own measured size.
            sumLen = 0
            p = cgObjRunFirst[f]
            while p <= cgObjRunFirst[f] + nh {
                sumLen = sumLen + cgObjRuns[p].length
                p = p + 1
            }
            if sumLen + 4 * nh != cgFuncSize[f] {
                log("cg68k: bake capture: byte-count mismatch in " + poolGet(irFuncName(f)))
                return false
            }
        }
        k = k + 1
    }
    return true
}

// cgObjCaptureRuntime is bake.cla's own entry point (called once, from
// bakeWriteFile, for the 68k lane only, after every OTHER section has
// already been serialized -- see that call site's own doc comment for
// why): synthesize callback-glue trampolines (cg68SynthCbGlue -- an
// ordinary compile always calls this before shaking, and skipping it
// here crashes cg68Measure itself the first time it reaches a runtime
// function that materializes one's address, e.g. ui.cla's
// nat_UiLaunchReal handing AEInstallEventHandler the `aeQuitHandler`
// UPP: cgCallExtUiGlueAddr's own "not found/reachable" `abort(...)` fires
// with no glue synthesized yet -- found running this exact capture over
// a runtime-only universe, which Task 1's own probe corpus never did),
// force EVERY irFuncs entry reachable (the runtime-only universe has no
// real App entry point for shakeProgram's ordinary BFS to root from --
// Amendment A6, capture the whole baked set unconditionally, truncate to
// the testapi boundary later, at install time, alongside the IR), then
// run the real per-segment emission pipeline once (cg68ProgramFork,
// cgBakeCapture set) to populate cgObjRuns/cgObjHoles/cgFuncSize-family
// via its own capture hooks.
//
// cg68SynthCbGlue's own irFuncs growth (newIRFunc, one per
// irCbGlueNames entry) is undone before returning: a glue trampoline is
// re-synthesized fresh on EVERY real compile (never baked -- Task 3's
// own Measure-skip only ever applies below bkRuntimeFuncBoundary), so
// leaving it in irFuncs would grow bkSecIrFuncs with entries a real
// compile re-creates anyway. Any HOLE that referenced one of these
// (cgObjRecordHole's own cgHoleCbGlueAddr redirect, above) already
// captured it symbolically -- an irCbGlueNames position, not the
// transient index being dropped here -- so the truncation is safe by
// construction, not just convenient. irFuncIdxByName is rebuilt from
// the truncated irFuncs rather than restored by assignment (matching
// bkInstallArenas' own `filteredIdx` rebuild, not a snapshot/restore, to
// stay independent of whatever value-vs-reference semantics `intmap`
// assignment turns out to have).
//
// A function whose OWN body references one of the eight reverse-waist
// UI dispatchers (lower.cla's lowUiSynthExternName -- deliberately
// absent from the baked IR at all, bkInstallArenas' own doc comment) is
// rooted here just like everything else: excluding it up front cannot
// actually prevent it from becoming reachable (an ordinary rooted
// caller elsewhere may reach it transitively via a plain function-call
// edge regardless), so the SAFE fix lives one layer down instead --
// cgCallExtUiSynth/cgCallExtUiGlueAddr TAINT (cgObjCaptureTainted)
// rather than crash when cgBakeCapture is set, and cgObjDumpSegment
// leaves cgObjValid false for a tainted function's own capture attempt.
//
// Deliberately does NOT call cg68AddRoots (native-only console-shim
// roots, irrelevant once every irFuncs entry is already rooted below).
func cgObjCaptureRuntime(): bool {
    var i: int
    var ok: bool
    var preSynthCount: int
    var truncFuncs: list of IRFunc
    var freshIdx: intmap of int
    var nm: int

    preSynthCount = irFuncs.count
    cg68SynthCbGlue()

    i = 0
    while i < irFuncs.count {
        shakeAddRoot(irFuncName(i))
        i = i + 1
    }
    shakeProgram()

    cgBakeCapture = true
    peepDisabled = false
    a68ListingOn = false
    ok = cg68ProgramFork("<bake-object-capture>", false, 0)
    cgBakeCapture = false

    i = 0
    while i < preSynthCount {
        truncFuncs.add(irFuncs[i])
        i = i + 1
    }
    irFuncs = truncFuncs
    i = 0
    while i < irFuncs.count {
        nm = irFuncs[i].name
        if not freshIdx.has(nm) {
            freshIdx[nm] = i
        }
        i = i + 1
    }
    irFuncIdxByName = freshIdx

    return ok
}

// ================================================================
// object-code-linker Task 3: Measure-skip + paste-with-fixups link
// pass -- consumes the bkLdObj*/cgObjRuns/cgObjHoles staging Task 2's
// loader populated on a --rtbake compile. Two hook points: cg68Measure's
// own per-function loop (above) substitutes a baked function's own
// measured size/frame/pool-usage data for a real cgEmitFunc call;
// cg68ProgramFork's own per-segment function loop (below) substitutes a
// PASTE (cgObjPasteFunc) for a real cgEmitFunc call. A function is
// eligible for either substitution iff cgObjPasteEligible(i) -- loaded,
// in-bounds, and not tainted at capture time (Amendment A6's
// taint-and-discard path, cgObjDumpSegment's own doc comment). Every
// OTHER function (user code always; a taint-discarded runtime function;
// any compile with no baked objects installed at all) takes the
// ordinary cgEmitFunc path, unchanged.
//
// Deliberately NOT skipped: cgSeg1ExtraSize/cgGlueBundleSize/cgPoolSize
// and the per-pool-entry size tables (cgStrLitSize/cgEnumTableSize/
// cgSerdescSize/cgUiBlobSize/cgUiEventsSize) stay REAL-measured every
// compile, never substituted from the artifact, even though Task 2's
// wire format carries baked copies of all of them (bkLdObjSeg1ExtraSize
// etc.). Those routines (cgEmitInitGlobalsStub/cgEmitFreeGlobalsStub:
// `while i < irGlobals.count`; cgEmitRcWalks: `while i < irRecords.count`;
// cgEmitPoolsBody: the whole live pool) iterate the CURRENT PROGRAM's
// full irGlobals/irRecords/irStrLits/irEnums arrays -- the runtime-baked
// PREFIX plus this program's own appended user globals/records/
// literals -- never just the runtime baseline the artifact captured
// (cgObjCaptureRuntime runs over a bare runtime-only universe with no
// user code at all). Substituting the baked scalar would silently
// UNDER-measure cgPackProgram's own per-segment budget for any program
// with even one user `var`/`record`/literal -- i.e. nearly every real
// program -- risking a segment-packing decision that diverges from what
// a from-source compile would have chosen (the REAL per-segment loop,
// below, always re-emits these routines for real, unconditionally,
// regardless of baking, so the BYTES themselves stay correct; only
// which functions got packed into which segment could silently drift,
// breaking the byte-identity gate on segment LAYOUT rather than on any
// one function's own bytes). The per-function skip above is where the
// real payoff lives anyway -- cgEmitFunc, not this one-time overhead,
// is what scales with the ~500-function runtime.
// ================================================================

// cgObjPasteEligible: is irFuncs index i a valid, loaded, in-bounds
// baked object this compile can paste instead of re-generating? False
// on every non-bake compile (bkLdObjValid stays at its empty default,
// only ever written by bkReadObjCode, which only a --rtbake parse
// reaches) and false for any index past THIS compile's own runtime
// function boundary or that Amendment A6's taint-and-discard left
// invalid.
//
// clir-load-perf Task 7 (design B) added the bkRuntimeFuncBoundary test
// and, with it, deleted bkInstallObjCode: the boundary used to be
// enforced by truncating bkLdObjValid & friends IN PLACE at install
// time, which destroyed pending state the memoized parse must replay
// from (audit findings F1/F2). Testing the boundary here instead keeps
// the pending arrays pristine and full-length, and is what makes a
// session that mixes a non-testapi compile with a --testapi one correct:
// bkInstallArenas recomputes bkRuntimeFuncBoundary from THAT compile's
// own testapi split, and driveReset() zeroes it for a from-source
// compile that installs nothing (without which a stale boundary would
// paste baked bytes over a from-source compile's own, differently
// numbered, irFuncs).
func cgObjPasteEligible(i: int): bool {
    if bkLdObjValid.count == 0 {
        return false
    }
    if i < 0 or i >= bkRuntimeFuncBoundary or i >= bkLdObjValid.count {
        return false
    }
    return bkLdObjValid[i]
}

// cgObjFlatSlice copies flat[first, first+count) into a fresh list --
// bkLdObjFuncEnumTableFlat/SerdescFlat's own per-function First/Count
// pair (Task 2's flat-not-nested staging shape, chosen to keep
// cg_free_globals cheap -- see bkLdObjValid's own doc comment)
// unflattened back into the per-function `list of int` cgFuncEnumTables/
// cgFuncSerdescs already want.
func cgObjFlatSlice(flat: list of int, first: int, count: int): list of int {
    var l: list of int
    var i: int

    l = cgFreshIntList()
    i = 0
    while i < count {
        l.add(flat[first + i])
        i = i + 1
    }
    return l
}

// cgObjBuildFuncStrLits reconstructs baked function f's own strlit pool-
// ref set for cgFuncStrLits[f] -- built ENTIRELY from f's own hole list,
// not from bkLdObjFuncStrLitFlat's wire array, and deliberately so: a
// real Measure's cgRecordStrLit records a strlit index into
// cgFuncStrLits[i] on its FIRST reference only (cgStrLitSeen's own
// per-function epoch guard dedups repeats), in the exact chronological
// order cgStmts walks the function body -- and every strlit reference
// this backend ever emits takes the SAME position-dependent
// `LEA d16(PC),An` shape (Task 1's own hole-completeness proof), so a
// hole-list scan in stored order reproduces that same first-occurrence
// order exactly, panic-message hole included at whatever position it
// actually falls (not tacked on at the end). The wire array can't do
// this: Amendment A2 filters cgListOobMsgIdx OUT of it at write time
// (its bake-time numeric index isn't valid at compile time), which
// destroys the panic entry's own relative position among the surviving
// entries -- re-appending it at the end, this function's own first
// version, passed the COUNT check but failed the full-corpus byte-
// identity gate on arc.cla: nat_UiSFGetFile's own four `codes[N]`
// list-index bounds checks all hole the SAME dedup'd panic entry, and
// real Measure records it interleaved (between two ordinary strlit
// refs, mid-function), not trailing -- cgPackProgram's own segment pool
// SET accumulates in cgFuncStrLits' iteration order (cgPoolDeltaAndUnion),
// so a wrong relative order here can reorder the shared string pool's
// own on-disk bytes for whichever segment first discovers an entry via
// this function, well past merely getting the SIZE right (which the
// hole-count-vs-dedup fix, immediately below in git history, already
// covers on its own).
func cgObjBuildFuncStrLits(f: int): list of int {
    var l: list of int
    var hf: int
    var nh: int
    var k: int
    var j: int
    var h: CgObjHole
    var sym: int
    var found: bool

    l = cgFreshIntList()
    hf = bkLdObjHoleFirst[f]
    nh = bkLdObjNHoles[f]
    k = 0
    while k < nh {
        h = cgObjHoles[hf + k]
        if h.kind == cgHoleLabel and (h.cls == cgRelClsPoolStr or h.cls == cgRelClsPanicMsg) {
            if h.cls == cgRelClsPanicMsg {
                sym = cgListOobMsgIdx
            } else {
                sym = h.sym
            }
            found = false
            j = 0
            while j < l.count {
                if l[j] == sym {
                    found = true
                }
                j = j + 1
            }
            if not found {
                l.add(sym)
            }
        }
        k = k + 1
    }
    return l
}

// cgObjApplyGlueUsage replays baked function f's own mul32/div32/mod32
// glue USAGE side effect that skipping its cgEmitFunc call also skips:
// cgMul32Label/cgDiv32Label/cgMod32Label are lazy getters expression
// codegen calls inline (cgExpr, a 32-bit multiply/divide/modulo needing
// the shared glue routine) -- each sets its own cgXUsed flag TRUE (once,
// idempotently) as a SIDE EFFECT of being called at all, and
// cg68Measure's own glue-bundle-size step right after the whole
// function loop (`if cgMul32Used { cgEmitMul32(cgMul32Lbl) }`, mirrored
// again in cg68ProgramFork's real per-segment emission) reads that flag
// -- never cleared per baked function, only ever set. A baked function
// that skips cgEmitFunc entirely never calls these getters, so a
// program whose ONLY mul32/div32/mod32 user is a BAKED runtime function
// would leave cgXUsed false, silently dropping the glue routine's own
// bytes from the real fork even though a pasted CALL hole into it still
// exists (an unbound label at a68Finish, or worse if some other segment
// happens to bind the same label id by coincidence). Scans f's own
// hole list for a cgRelClsGlue reference (sym 1/2/3 -- sym 4 is
// free-globals, unconditionally emitted every segment regardless of any
// flag, see cg68ProgramFork's own doc comment) and calls the matching
// getter, discarding its label result: Measure's own throwaway stream
// only needs the FLAG side effect and a valid (if throwaway) label for
// its own glue-bundle-size accounting, both of which the getter already
// provides idempotently.
func cgObjApplyGlueUsage(f: int) {
    var hf: int
    var nh: int
    var k: int
    var h: CgObjHole
    var junk: int

    hf = bkLdObjHoleFirst[f]
    nh = bkLdObjNHoles[f]
    k = 0
    while k < nh {
        h = cgObjHoles[hf + k]
        if h.kind == cgHoleLabel and h.cls == cgRelClsGlue {
            if h.sym == 1 {
                junk = cgMul32Label()
            } else if h.sym == 2 {
                junk = cgDiv32Label()
            } else if h.sym == 3 {
                junk = cgMod32Label()
            }
        }
        k = k + 1
    }
}

// cgObjResolveLabel resolves a cgHoleLabel hole's own (cls, sym) into a
// live a68 label id -- mirrors cgObjBuildLabelMaps' own forward
// direction (pool entry -> label) rather than reading back a captured
// label id, since label ids are only valid within the segment that
// allocated them (a68Reset wipes a68LabelAddr every segment) and this
// compile's own segment layout is not guaranteed to match the bake-time
// layout at all -- that IS the byte-identity gate: relocation, not
// replay. cgRelClsFuncLabel/cgRelClsJt never appear on the wire
// (cgObjRecordHole always promotes them to cgHoleCall/cgHoleJtAddr) --
// kept here anyway, defensively, same reasoning as cgObjRecordHole's own
// doc comment for keeping the class ids alive.
func cgObjResolveLabel(cls: int, sym: int): int {
    if cls == cgRelClsPanicMsg {
        return cgStrLitLabels[cgListOobMsgIdx]
    }
    if cls == cgRelClsPoolStr {
        return cgStrLitLabels[sym]
    }
    if cls == cgRelClsPoolEnum {
        return cgEnumTableLabels[sym]
    }
    if cls == cgRelClsPoolSer {
        return cgSerdescLabels[sym]
    }
    if cls == cgRelClsPoolUiBlob {
        return cgUiBlobLabel
    }
    if cls == cgRelClsPoolUiEvt {
        return cgUiEventsLabel
    }
    if cls == cgRelClsRcRetain {
        return cgRecRetainLbls[sym]
    }
    if cls == cgRelClsRcRelease {
        return cgRecReleaseLbls[sym]
    }
    if cls == cgRelClsFuncLabel {
        return cgFuncLabels[sym]
    }
    if cls == cgRelClsGlue {
        if sym == 1 {
            return cgMul32Lbl
        }
        if sym == 2 {
            return cgDiv32Lbl
        }
        if sym == 3 {
            return cgMod32Lbl
        }
        return cgFreeGlobalsLbl
    }
    abort("cg68k: paste: unresolvable hole class " + numToStr(cls))
    return -1
}

// cgObjPasteHole re-emits one captured hole via the SAME a68Emit shape
// Task 1's probe proved (this file's own object-code-linker Task 2
// header comment): a call hole hands off to cgCallFunc(sym) verbatim
// (Amendment A1 -- it alone decides BSR.W vs JSR d16(A5) from THIS
// compile's own live segment assignment); a JT-address hole and a
// cbGlue-address hole both re-emit the captured op/size/modes with a
// freshly computed JT displacement substituted into whichever operand
// slot srcSlot names (cbGlue's own target func index is resolved via
// cgCbGlueFuncIdx[sym] -- sym is an irCbGlueNames position, not a
// stable irFuncs index, per cgHoleCbGlueAddr's own doc comment; safe
// here because drive.cla's driveEmit68kFork already calls
// cg68SynthCbGlue() before cg68ProgramFork on every real compile); every
// other (label) hole resolves via cgObjResolveLabel.
func cgObjPasteHole(h: CgObjHole) {
    var sv: int
    var dv: int
    var v: int
    var fi: int

    if h.kind == cgHoleCall {
        cgCallFunc(h.sym)
        return
    }
    sv = h.sv
    dv = h.dv
    if h.kind == cgHoleJtAddr {
        v = cgJtDisp(cgJtSlot(h.sym))
    } else if h.kind == cgHoleCbGlueAddr {
        fi = cgCbGlueFuncIdx[h.sym]
        v = cgJtDisp(cgJtSlot(fi))
    } else {
        v = cgObjResolveLabel(h.cls, h.sym)
    }
    if h.srcSlot {
        sv = v
    } else {
        dv = v
    }
    a68Emit(A68Op(h.op), h.size, A68Mode(h.sm), h.sr, sv, A68Mode(h.dm), h.dr, dv)
}

// cgObjPasteFunc re-materializes baked function f from its captured
// runs+holes instead of running cgEmitFunc -- Task 1's own proven paste
// mechanic: a68CommentMarker()+a68Bind(cgFuncLabels[f]) shapes the item
// stream exactly like cgEmitFunc's own non-listing entry (both zero-
// length, so the bind lands at the same address either way), then every
// run streams in verbatim via a68DcBytes (length-exact, so a68Pc tracks
// cgEmitFunc's own layout identically) with each hole re-emitted in
// between by cgObjPasteHole. peepFunc deliberately does not run over
// pasted items -- the captured bytes are already post-peephole (Task
// 1's own finding: peephole's own safety rules already make calls/
// KindData/KindBind barriers, so no cross-function peephole window is
// lost by skipping it here).
func cgObjPasteFunc(f: int) {
    var rf: int
    var hf: int
    var nh: int
    var k: int

    rf = bkLdObjRunFirst[f]
    hf = bkLdObjHoleFirst[f]
    nh = bkLdObjNHoles[f]
    a68CommentMarker()
    a68Bind(cgFuncLabels[f])
    k = 0
    while k <= nh {
        a68DcBytes(cgObjRuns[rf + k])
        if k < nh {
            cgObjPasteHole(cgObjHoles[hf + k])
        }
        k = k + 1
    }
}

// cg68ProgramFork (Task 9, mac-resident-clarusc -- renamed from the old
// cg68Program, which this function now sits under) is the top-level
// emit68k driver up through building the raw resource fork: measure the
// whole program standalone (cg68Measure), pack every reachable function
// into segments (cgPackProgram), assign final JT slots from that packing
// (cgAssignFinalJtSlots), then really emit each segment in turn --
// startup + cg_init_globals in segment 1 only, that segment's own packed
// functions, the duplicated-glue bundle, and the full constant pool,
// every segment -- finishing and collecting each segment's own jump-
// table entries before moving to the next, then cg68BuildFork to
// assemble the fork itself (cgLastFork/cgLastCreator). Returns false
// (after logging why) on any diagnostic-worthy failure: an oversized
// function (cgPackProgram) or an unresolved label (a real codegen bug --
// this backend's own scaffolding never leaves one dangling). Does NOT
// write anything -- no MacBinary wrap, no file -- see cg68WriteImageWrap
// (the wrap+write step) and drive.cla's driveEmit68kFork/driveEmit68k
// (which call this, then wrap only for the host path). drive.cla calls
// this AFTER cg68AddRoots()+shakeProgram() -- see cg68AddRoots's own doc
// comment. segLimit<=0 selects the real classic-Mac budget (32760); a
// positive value is a TEST-ONLY override (main.cla's undocumented
// `--seglimit` flag) to force a small program into several segments
// deterministically.
func cg68ProgramFork(outPath: string, listing: bool, segLimit: int): bool {
    var i: int
    var s: int
    var ok: bool
    var base: string
    var startupLbl: int
    var initGlobalsLbl: int
    var freeGlobalsLblLocal: int
    var jtEntries: list of int
    var jtSegNums: list of int
    var segBytes: list of text
    var segNumStr: string
    var progressLine: string
    var stageLine: string
    var objSegFuncIdx: list of int
    var objSegItemStart: list of int
    var objSegItemEnd: list of int
    var objSegTainted: list of bool

    // Findings 1.4 (Task 13): fill every rn* pre-interned runtime-call
    // name BEFORE cg68Measure's own first cgEmitFunc call can need one --
    // 68k-only (cprint's host lane has no rn* consumers, findIRFuncIdxByName's
    // own intmap fix is backend-agnostic and needs no equivalent call).
    rnInit()

    if segLimit > 0 {
        cgSegLimit = segLimit
    } else {
        cgSegLimit = 32760
    }

    driveProgressStage("Measuring")
    if not cg68Measure() {
        return false
    }
    driveProgressPhase("Measured")
    driveProgressStage("Packing")
    if not cgPackProgram() {
        return false
    }
    progressLine = "Packed " + numToStr(cgSegCount)
    progressLine = progressLine + " segments"
    driveProgressPhase(progressLine)
    drvStepsAddSegments(cgSegCount)
    cgAssignFinalJtSlots()

    jtEntries = cgFreshIntList()
    jtSegNums = cgFreshIntList()
    i = 0
    while i < cgTotalJtSlots {
        jtEntries.add(0)
        jtSegNums.add(0)
        i = i + 1
    }
    segBytes = cgFreshTextList()
    base = cgSegBase(outPath)

    // object-code-linker Task 2: reset the whole-capture accumulators
    // once per cg68ProgramFork call, not per segment -- cgObjRuns/
    // cgObjHoles are FLAT across every segment this call packs, indexed
    // per-function via cgObjRunFirst/cgObjHoleFirst/cgObjNHoles (see
    // this file's own capture-globals doc comment, above).
    if cgBakeCapture {
        cgObjValid = cgFreshBoolListSized(irFuncs.count)
        cgObjRunFirst = cgFreshIntListSized(irFuncs.count)
        cgObjHoleFirst = cgFreshIntListSized(irFuncs.count)
        cgObjNHoles = cgFreshIntListSized(irFuncs.count)
        cgObjRuns.clear()
        cgObjHoles.clear()
    }

    s = 1
    while s <= cgSegCount {
        stageLine = "Writing Segment " + numToStr(s)
        driveProgressStage(stageLine)
        a68Reset()
        cgAssignSegFuncLabels(s)

        // Task 13: this segment's own deduped pool need-set
        // (cgPackProgram's output) -- must be set BEFORE the four
        // cgReserve*Labels calls just below, since each of those now
        // only allocates a label for an entry cgCurPool* actually names
        // (a68Finish demands every allocated label be bound, and
        // cgEmitPoolsBody -- called later, once this segment's own
        // functions/glue have run -- only binds entries in this same
        // cgCurPool* set).
        cgCurPoolStrLits = cgSegStrLitSets[s - 1]
        cgCurPoolEnumTables = cgSegEnumTableSets[s - 1]
        cgCurPoolSerdescs = cgSegSerdescSets[s - 1]
        cgCurPoolUsesUiBlob = cgSegUsesUiBlob[s - 1]
        cgCurPoolUsesUiEvents = cgSegUsesUiEvents[s - 1]

        // Task 15 (findings 1.8): rebuild cgCurPool*Bits every time
        // cgCurPool* is assigned -- see cgCurPoolStrLitBits' own doc
        // comment.
        cgCurPoolStrLitBits = cgBoolBitmapFromList(cgCurPoolStrLits, irStrLits.count)
        cgCurPoolEnumBits = cgBoolBitmapFromList(cgCurPoolEnumTables, irEnums.count)
        cgCurPoolSerdescBits = cgBoolBitmapFromList(cgCurPoolSerdescs, irRecords.count)

        cgReserveStrLitLabels()
        cgReserveUiPoolLabels()
        cgReserveEnumTableLabels()
        cgReserveSerdescLabels()
        cgAssignRcWalkLabels()
        if cgMul32Used {
            cgMul32Lbl = a68NewLabel()
        }
        if cgDiv32Used {
            cgDiv32Lbl = a68NewLabel()
        }
        if cgMod32Used {
            cgMod32Lbl = a68NewLabel()
        }
        freeGlobalsLblLocal = a68NewLabel()
        cgFreeGlobalsLbl = freeGlobalsLblLocal
        cgCurFuncSegment = s

        if s == 1 {
            startupLbl = a68NewLabel()
            initGlobalsLbl = a68NewLabel()
            cgEmitStartup(startupLbl, initGlobalsLbl, freeGlobalsLblLocal)
            cgEmitInitGlobalsStub(initGlobalsLbl)
        }

        // object-code-linker Task 2: per-segment capture scratch (which
        // function occupies which a68Items.count range THIS segment) --
        // cgObjDumpSegment consumes it right after this segment's own
        // a68Finish, below. Plain locals, fresh each segment (see the
        // param declaration's own doc comment for why these aren't
        // globals).
        if cgBakeCapture {
            objSegFuncIdx = cgFreshIntList()
            objSegItemStart = cgFreshIntList()
            objSegItemEnd = cgFreshIntList()
            objSegTainted = cgFreshBoolList()
        }
        i = 0
        while i < irFuncs.count {
            if shakeReachable(i) and cgFuncSegment[i] == s {
                if cgBakeCapture {
                    cgObjCaptureTainted = false
                    objSegFuncIdx.add(i)
                    objSegItemStart.add(a68Items.count)
                    cgEmitFunc(i)
                    objSegItemEnd.add(a68Items.count)
                    objSegTainted.add(cgObjCaptureTainted)
                } else {
                    // object-code-linker Task 3: paste a baked+valid
                    // function's captured bytes instead of re-running
                    // cgEmitFunc -- see cgObjPasteEligible/cgObjPasteFunc's
                    // own doc comments, above this function.
                    if cgObjPasteEligible(i) {
                        cgObjPasteFunc(i)
                    } else {
                        cgEmitFunc(i)
                    }
                }
            }
            driveProgressTick()
            i = i + 1
        }

        if cgMul32Used {
            cgEmitMul32(cgMul32Lbl)
        }
        if cgDiv32Used {
            cgEmitDiv32(cgDiv32Lbl)
        }
        if cgMod32Used {
            cgEmitMod32(cgMod32Lbl)
        }
        cgEmitFreeGlobalsStub(freeGlobalsLblLocal)
        cgEmitRcWalks()

        cgEmitPoolsBody()

        ok = a68Finish()
        if not ok {
            log("cg68ProgramFork: unresolved label " + numToStr(a68UnresolvedLabel()) + " (segment " + numToStr(s) + ")")
            return false
        }

        // object-code-linker Task 2: this segment's own bytes are final
        // now (a68Finish just succeeded) -- dump every function this
        // segment captured into the flat cgObjRuns/cgObjHoles arrays.
        if cgBakeCapture {
            if not cgObjDumpSegment(objSegFuncIdx, objSegItemStart, objSegItemEnd, objSegTainted) {
                return false
            }
        }

        if s == 1 {
            jtEntries[0] = a68LabelAddr[startupLbl]
            jtSegNums[0] = 1
        }
        i = 0
        while i < irFuncs.count {
            if shakeReachable(i) and cgFuncSegment[i] == s {
                jtEntries[cgJtSlots[i]] = a68LabelAddr[cgFuncLabels[i]]
                jtSegNums[cgJtSlots[i]] = s
            }
            i = i + 1
        }

        // Storing a68Bytes()'s handle directly is correct: the next
        // segment's a68Reset() rebinds a68BytesOut to a FRESH text (Ch3:
        // a String assigned into a Text "always creates a fresh text"), so
        // this list's own reference keeps pointing at this segment's bytes.
        // Task 15 carried a `+ ""` copy here to work around the reference
        // Go compiler lowering `a68BytesOut = ""` to an in-place
        // rt_text_store that emptied every already-pushed entry; that was a
        // frozen-compiler bug (internal/lower/stmt.go storeStmt), fixed in
        // Task 15.5 and pinned by testdata/run/arc_text_realias.cla.
        segBytes.add(a68Bytes())

        if listing {
            // native-gaps-cleanup Task 2: these are plain debug artifacts
            // (assembly listing text / raw segment bytes), not app
            // documents -- fileTypeText/"????" (the same TEXT/???? default
            // app.doctype/app.id would resolve to here anyway, since this
            // program has no `app` section) is a clearer literal spelling
            // for a debug dump than the app-constant idiom.
            segNumStr = numToStr(s)
            if not file.writeText(base + ".seg" + segNumStr + ".s", a68ListingText(), fileTypeText, "????") {
                log("cg68ProgramFork: cannot write " + base + ".seg" + segNumStr + ".s: " + lastError.message)
                return false
            }
            if not file.writeText(base + ".seg" + segNumStr + ".dat", a68Bytes(), fileTypeText, "????") {
                log("cg68ProgramFork: cannot write " + base + ".seg" + segNumStr + ".dat: " + lastError.message)
                return false
            }
        }

        progressLine = "Emitted segment " + numToStr(s)
        driveProgressPhase(progressLine)
        s = s + 1
    }

    if cgBakeCapture {
        // object-code-linker Task 2: bake-time capture needs no real
        // fork built -- every byte/hole this call was for is already in
        // cgObjRuns/cgObjHoles (cgObjDumpSegment, above); skip building
        // and writing an unused fork (also avoids needing a meaningful
        // outPath -- cgObjCaptureRuntime passes a placeholder).
        return true
    }
    driveProgressStage("Building Fork")
    if not cg68BuildFork(jtEntries, jtSegNums, segBytes) {
        return false
    }
    driveProgressPhase("Built fork")
    return true
}

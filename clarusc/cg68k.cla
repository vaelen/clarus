    rnIntMapHas = intern("rtIntMapHas")
    rnIntMapKeyAt = intern("rtIntMapKeyAt")
    rnIntMapLastref = intern("rtIntMapLastref")
    rnIntMapNew = intern("rtIntMapNew")
    rnIntMapRelease = intern("rtIntMapRelease")
    rnIntMapRemove = intern("rtIntMapRemove")
    rnIntMapRetain = intern("rtIntMapRetain")
    rnIntMapSet = intern("rtIntMapSet")
    rnIntMapValAt = intern("rtIntMapValAt")
    rnListAt = intern("rtListAt")
    rnListClear = intern("rtListClear")
    rnListClone = intern("rtListClone")
    rnListCount = intern("rtListCount")
    rnListFirst = intern("rtListFirst")
    rnListLast = intern("rtListLast")
    rnListLastref = intern("rtListLastref")
    rnListNew = intern("rtListNew")
    rnListPop = intern("rtListPop")
    rnListPush = intern("rtListPush")
    rnListRelease = intern("rtListRelease")
    rnListRemove = intern("rtListRemove")
    rnListRetain = intern("rtListRetain")
    rnListShift = intern("rtListShift")
    rnListUnshift = intern("rtListUnshift")
    rnMapClear = intern("rtMapClear")
    rnMapCount = intern("rtMapCount")
    rnMapGet = intern("rtMapGet")
    rnMapGetDv = intern("rtMapGetDv")
    rnMapKeyAt = intern("rtMapKeyAt")
    rnMapHas = intern("rtMapHas")
    rnMapLastref = intern("rtMapLastref")
    rnMapNew = intern("rtMapNew")

func rnInit() {
    if rnInited { return }
    rnInited = true
    rnAlert = intern("natAlert")
    rnFileName = intern("natFileName")
    rnFileReadText = intern("natFileReadText")
    rnFileWriteText = intern("natFileWriteText")
    rnLastErrCode = intern("natLastErrCode")
    rnLastErrMsg = intern("natLastErrMsg")

// cgGlobalsBelowA5Size is the total (positive) byte extent of the whole
// below-A5 globals block -- the startup zero-loop's bound.
var cgGlobalsBelowA5Size: int

// cgStrLitLabels[i] is irStrLits index i's pool-entry label id.
var cgStrLitLabels: list of int

// cgUiBlobLabel/cgUiEventsLabel (Task 12, native-5e): pool-entry label ids
// for the UI descriptor blob (uiblob.cla's uibBuild(), cg68k's own record-
// layout authority) and the `--events` script bytes -- reserved up front
// (cgReserveUiPoolLabels, same "reserve before any body can reference it"
// discipline as cgReserveStrLitLabels) so UiProgDesc/UiTestScript call
// sites, walked long before cgEmitPoolsBody itself runs, can already emit
// a PC-relative reference to them. -1 for a non-UI program (never bound,
// never referenced -- see cgCallExtUiBlobAddr's own doc comment).
var cgUiBlobLabel: int
var cgUiEventsLabel: int

// cgEventsBytes holds the raw bytes of the file `emit68k --events FILE`
// named (main.cla sets this global before calling cg68Program) -- empty
// (never set) for a build with no `--events` flag, which is every non-
// scripted native UI build; UiTestScript()'s own NUL-first-byte contract
// (rtUiLaunch/rtUiRun) needs only a single 0 byte for that case, which
// cgEmitUiEventsBlob supplies unconditionally as the pool bytes' own
// trailing NUL either way.
var cgEventsBytes: text

// cgAppRawName/cgAppIconPath (Task 13, native-5e resource parity) --
// main.cla sets both before calling cg68Program, resolved the same way
// `clarusc appinfo`'s own name/icon fallback logic already does (name
// property > app label > entry file's basename; icon joined against the
// app section's OWN declaring file's directory, appDeclPathIdx) -- neither
// reaches IR (irAppName is -1 unless a `name:` property was declared
// explicitly, and icon is deliberately build-time-only per ir.cla's own
// header comment), so cg68WriteImage's resource builders need these
// threaded in from main.cla's AST-level walk rather than reading IR.
// cgAppRawName is "" for a non-app-declared program (cg68WriteImage never
// reads it in that case); cgAppIconPath is "" whenever the program has no
// declared app icon (the common case -- most app-declared programs have
// no icon).
var cgAppRawName: string
var cgAppIconPath: string

// cgLastFork/cgLastCreator (Task 9, mac-resident-clarusc) hold
// cg68BuildFork's own last output: the raw resource-fork image (no
// MacBinary header, no padding) and the creator code it resolved from the
// program's app section. cg68WriteImageWrap (the host `emit68k` tail)
// reads both to finish the MacBinary wrap; drive.cla's
// driveLastFork/driveLastCreator expose them (plus cgAppRawName above,
// already the app-section name) to a resource-writing front end that
// skips the wrap entirely.
//
// Validity window: only meaningful after a driveEmit68kFork/cg68ProgramFork
// call that returned true, and only until the next such call overwrites
// them. A FAILED call does NOT reset either global -- cg68BuildFork (the
// only place that writes them) only ever runs after cg68Measure/
// cgPackProgram/the per-segment emission loop already succeeded, so on
// failure they still hold a prior successful build's values, if any.
// Callers must check the emit call's own return before reading.
var cgLastFork: text
var cgLastCreator: string(7)

// cgBakeNames/cgBakeTypes/cgBakeDatas (Task 5, mac-resident-clarusc; Task
// generalized to typed blobs by runtime-ir-bake Task 6) hold one entry
// per resource main.cla wants folded into the emitted .bin's resource
// fork -- one entry per `emit68k --bake FILE` flag (cliResolveBake, main.
// cla; always type "CLFS") IN FLAG ORDER, then (Task 6) one more pair of
// entries for `emit68k --bake-ir FILE` (cliResolveBakeIr: the CLIR
// artifact + its stamp sidecar, both ALSO type "CLFS" today -- see
// bake.cla's bkClirResourceName doc comment for why this task didn't
// need a second Mac resource TYPE to make the loader typed-blob-aware).
// main.cla sets all three before calling cg68Program, same hand-off
// pattern as cgEventsBytes above: cgBakeNames[i] is the resource's own
// name (a --bake FILE's own path, verbatim, or one of bake.cla's two
// reserved constants), cgBakeTypes[i] is its Mac resource type,
// cgBakeDatas[i] is its raw bytes. Empty (all three zero-length lists)
// for a build with no `--bake`/`--bake-ir` flag at all, which is every
// build except the Mac-resident compiler's own self-baking build --
// cg68BuildFork below folds these into one resource per entry, id
// 128+i, typed per cgBakeTypes[i] instead of a hardcoded literal.
var cgBakeNames: list of string
var cgBakeTypes: list of string
var cgBakeDatas: list of text

// cgSizePartitionBytes (Task 10, mac-resident-clarusc) overrides the
// SIZE(-1) resource's preferred/minimum partition (app68k.cla's
// app68BuildSize, called from cg68ResourceParitySet below) -- main.cla
// sets this from `emit68k --partition N`, same "front end sets a global
// before calling driveEmit68k(Fork)" hand-off as cgEventsBytes/
// cgAppRawName above. Zero (never set) for every build without the flag,
// which app68BuildSize treats as "keep the original 2097152 (2MB)
// default" -- ClarusC.APPL's own build (scripts/build-clarusc-mac.sh) is
// the only caller that passes it today, needing more than 2MB for its
// own compile working set.
//
// scripts/build-clarusc-mac.sh passes 50331648 (48MB, Task 11), per the
// design spec's section 7 estimate (14-22MB working set + headroom). Task 10
// originally landed on 4MB instead: the then-current snow/Clarus.snoww
// acceptance workspace booted with pmmu_enabled=false (no 32-bit
// addressing), which capped Process-Manager-allocatable RAM at ~6.8MB
// regardless of its 128MB physical ram_size -- empirically found booting
// a 64MB request: "There is not enough memory to open ClarusC (65,536K
// needed, 6,968K available)". As of 2026-08-09 the Snow machine runs a
// 32-bit-clean ROM (snow/rominator.rom) with 32-bit addressing enabled
// (Largest Unused Block 129,868K verified), removing that ceiling.
var cgSizePartitionBytes: int

// cgFreshIntList hands back a genuinely empty list (same trick
// shakeFreshIntList/shakeFreshBoolList use, shake.cla).
func cgFreshIntList(): list of int {
    var l: list of int
    return l
}

// cgFreshIntListSized (Task 15, findings 1.8) hands back a length-n list
// of int, every slot 0 -- the shape the epoch-stamp membership lists
// (cgStrLitSeen/cgEnumSeen/cgSerdescSeen) need.
func cgFreshIntListSized(n: int): list of int {
    var l: list of int
    var i: int

    l = cgFreshIntList()
    i = 0
    while i < n {
        l.add(0)
        i = i + 1
    }
    return l
}

func cgFreshStringList(): list of string {
    var l: list of string
    return l
}

func cgFreshBoolList(): list of bool {
    var l: list of bool
    return l
}

// cgFreshBoolListSized (Task 15, findings 1.8) hands back an all-false
// list of bool of length n -- the shape cgPackProgram's per-segment
// bitmaps and cgCurPool*Bits need (parallel to a list of int need-set,
// one slot per dense IR-arena index).
func cgFreshBoolListSized(n: int): list of bool {
    var l: list of bool
    var i: int

    l = cgFreshBoolList()
    i = 0
    while i < n {
        l.add(false)
        i = i + 1
    }
    return l
}

// cgBoolBitmapFromList (Task 15, findings 1.8) builds a length-n
// all-false bitmap and sets lst's own entries true -- the shared
// "rebuild a bitmap from its list's current contents" helper used
// wherever a pool need-set list is wholesale-replaced or freshly
// assigned rather than incrementally unioned into (cgPackProgram's
// single-segment restore, cgCurPool* assignment sites).
func cgBoolBitmapFromList(lst: list of int, n: int): list of bool {
    var bits: list of bool
    var i: int

    bits = cgFreshBoolListSized(n)
    i = 0
    while i < lst.count {
        bits[lst[i]] = true
        i = i + 1
    }
    return bits
}

func cgFreshTextList(): list of text {
    var l: list of text
    return l
}

func cgFreshIntListList(): list of list of int {
    var l: list of list of int
    return l
}

func cgFreshBoolListList(): list of list of bool {
    var l: list of list of bool
    return l
}

// cgIntListHas is a plain linear membership scan. Its "not a hot path"
// claim (findings 1.8) did not hold up: every one of its former callers
// -- cgRecordStrLit/cgRecordEnumTable/cgRecordSerdesc's per-reference
// membership test during the measure pass, cgPoolDeltaPeek/
// cgPoolDeltaAndUnion's per-candidate probe in cgPackProgram's first-fit
// segment packing, and cgReserveStrLitLabels/cgReserveEnumTableLabels/
// cgReserveSerdescLabels' per-arena-entry reserve-pass probe -- has been
// converted to O(1) membership (epoch stamps for the recording paths,
// bitmaps for the pack loop and reserve paths; Task 15). cgIntListHas
// itself has no remaining callers in this file as of that task, but
// stays as a plain, reusable helper for any future cold caller that
// wants a simple membership check without the bookkeeping a stamp/
// bitmap scheme demands.
func cgIntListHas(lst: list of int, v: int): bool {
    var i: int
    i = 0
    while i < lst.count {
        if lst[i] == v {
            return true
        }
        i = i + 1
    }
    return false
}

// cgRecordStrLit/cgRecordEnumTable/cgRecordSerdesc/cgRecordUiBlob/
// cgRecordUiEvents append into whichever bucket cgRecMode currently
// selects (see that var's own doc comment) -- cg68Measure's real
// emitter pass is the only place cgRecMode is ever non-zero, so these
// are no-ops during cg68Program's real per-segment pass (mode always 0
// there; the SAME reference call sites fire again on that pass, since
// the same function bodies are emitted twice, but usage was already
// captured once during measurement -- see cgRecMode's own header note
// for why re-recording would be redundant).
// Task 15 (findings 1.8): membership is `cgXSeen[idx] == cgSeenEpoch`
// instead of a cgIntListHas scan of the current bucket -- see
// cgSeenEpoch's own doc comment for why one epoch counter safely covers
// all three recording modes (a fresh epoch precedes every distinct
// recording context: each function's own cgRecFuncIdx assignment, and
// once each for the cgRecMode 2/3 streams).
func cgRecordStrLit(litIdx: int) {
    if cgRecMode == 0 {
        return
    }
    if cgStrLitSeen[litIdx] == cgSeenEpoch {
        return
    }
    cgStrLitSeen[litIdx] = cgSeenEpoch
    if cgRecMode == 1 {
        cgFuncStrLits[cgRecFuncIdx].add(litIdx)
    } else if cgRecMode == 2 {
        cgSeg1StrLits.add(litIdx)
    } else if cgRecMode == 3 {
        cgGlueStrLits.add(litIdx)
    }
}

func cgRecordEnumTable(ei: int) {
    if cgRecMode == 0 {
        return
    }
    if cgEnumSeen[ei] == cgSeenEpoch {
        return
    }
    cgEnumSeen[ei] = cgSeenEpoch
    if cgRecMode == 1 {
        cgFuncEnumTables[cgRecFuncIdx].add(ei)
    } else if cgRecMode == 2 {
        cgSeg1EnumTables.add(ei)
    } else if cgRecMode == 3 {
        cgGlueEnumTables.add(ei)
    }
}

func cgRecordSerdesc(ri: int) {
    if cgRecMode == 0 {
        return
    }
    if cgSerdescSeen[ri] == cgSeenEpoch {
        return
    }
    cgSerdescSeen[ri] = cgSeenEpoch
    if cgRecMode == 1 {
        cgFuncSerdescs[cgRecFuncIdx].add(ri)
    } else if cgRecMode == 2 {
        cgSeg1Serdescs.add(ri)
    } else if cgRecMode == 3 {
        cgGlueSerdescs.add(ri)
    }
}

func cgRecordUiBlob() {
    if cgRecMode == 1 {
        cgFuncUsesUiBlob[cgRecFuncIdx] = true
    } else if cgRecMode == 2 {
        cgSeg1UsesUiBlob = true
    } else if cgRecMode == 3 {
        cgGlueUsesUiBlob = true
    }
}

func cgRecordUiEvents() {
    if cgRecMode == 1 {
        cgFuncUsesUiEvents[cgRecFuncIdx] = true
    } else if cgRecMode == 2 {
        cgSeg1UsesUiEvents = true
    } else if cgRecMode == 3 {
        cgGlueUsesUiEvents = true
    }
}

// cgPoolDeltaPeek is the read-only probe cgPackProgram's first-fit
// "would function/bucket X fit in THIS segment" check uses: the total
// byte cost of whichever of cand's own entries aren't already in segSet,
// WITHOUT mutating segSet or segBits (first-fit tries segments in
// declaration order and discards rejected ones -- committing early would
// corrupt an abandoned segment's own accounting). Task 15 (findings
// 1.8): membership is `segBits[idx]`, O(1), instead of a cgIntListHas
// scan of segSet -- segBits is segSet's own parallel bitmap (same
// length as the universe segSet's entries are drawn from), kept in
// lockstep by every caller that mutates segSet; segSet itself stays the
// authority for emission ORDER (see cgPackProgram's own "Whole-list
// REPLACE, not a union merge" comment).
func cgPoolDeltaPeek(cand: list of int, sizes: list of int, segSet: list of int, segBits: list of bool): int {
    var i: int
    var idx: int
    var delta: int

    delta = 0
    i = 0
    while i < cand.count {
        idx = cand[i]
        if not segBits[idx] {
            delta = delta + sizes[idx]
        }
        i = i + 1
    }
    return delta
}

// cgPoolDeltaAndUnion is cgPoolDeltaPeek's committing sibling: adds every
// cand entry not already in segSet into segSet AND sets its segBits bit
// (list of int/list of bool are Clarus's reference-counted handle type --
// see cprint.cla's fpIsHandleType KList arm -- so both mutations are
// visible through every other reference to the SAME segSet/segBits,
// no explicit write-back needed), returning the same marginal byte cost
// cgPoolDeltaPeek would have reported.
func cgPoolDeltaAndUnion(cand: list of int, sizes: list of int, segSet: list of int, segBits: list of bool): int {
    var i: int
    var idx: int
    var delta: int

    delta = 0
    i = 0
    while i < cand.count {
        idx = cand[i]
        if not segBits[idx] {
            segSet.add(idx)
            segBits[idx] = true
            delta = delta + sizes[idx]
        }
        i = i + 1
    }
    return delta
}

// ================================================================
// Task 8: expression/statement codegen state.
//
// EVALUATION DISCIPLINE (documented once, here, per the brief). cgExpr(e)
// always leaves e's value in D0 (sign/zero-extended over the full 32 bits
// for a 1-byte bool/char, per cgLoadVar/cgCcFor below). A binary op
// evaluates its LEFT operand first (result in D0), pushes it
// (MOVE.L D0,-(A7)), evaluates its RIGHT operand (result in D0), then pops
// the stashed left value into D1 (MOVE.L (A7)+,D1) -- so at the point the
// operator itself runs, D1=left, D0=right, and evaluation order is
// preserved left-to-right even though a later expression's side effects
// (e.g. a nested call) run after the left operand's temp is already on
// the stack. For a COMMUTATIVE op (+, &, |, ^) the operator runs
// dest=D0,src=D1 directly, so the result lands in D0 with no extra move.
// For a NON-commutative op (-, <<, >>) the 68000 <ea>,Dn instruction
// forms this module's asm68k.cla exposes only ever WRITE into the
// register named by the instruction's own "Dn" field -- there is no
// "ea,Dn but store into ea" form -- so the only way to compute
// `left - right` (not `right - left`) is to run the op with Dn=D1
// (dest=D1=left, source=D0=right, giving D1=left-right) and then
// MOVE.L D1,D0 to satisfy this module's own "result always ends in D0"
// postcondition. Comparisons (CMP) and the mul/div/mod helper calls
// reuse this exact D1=left/D0=right register convention -- see cgCompare
// and cg_mul32/cg_div32/cg_mod32's own doc comments below.
// ================================================================

// cgCurFrameNames[i]/cgCurFrameOffsets[i] are the CURRENT function's
// combined param+local (name -> A6 offset) table, rebuilt by cgEmitFunc
// right after it computes paramOffsets/local offsets (both already
// walked there for the frame-layout comments) -- the listing comments
// (a68Comment "param"/"local" lines) read cgCurFrameNames directly.
// cgCurFrameNameIdxs[i] is the SAME table keyed by interned nameIdx
// instead of string (findings 1.4, Task 13): cgFindFrameOffset scans
// this one with int compares -- cheaper than the string compares the
// old cgCurFrameNames scan did on every EVarRef/EXRecAddr lookup. Built
// in parallel at the exact same append sites, threading through the
// already-interned indices (irLocalName(params[i])/irLocalName(loc))
// rather than re-interning poolGet's own string result.
var cgCurFrameNames: list of string
var cgCurFrameOffsets: list of int
var cgCurFrameNameIdxs: list of int

// cgCurFrameIsRef[i] (param-abi phase, Task 6) parallels the three tables
// above: true when this frame slot is a KStr/KRec PARAM (holds an ADDRESS,
// the callee's own by-ref copy of the caller's argument -- Ch13/the plan's
// own by-address ABI), false for every local (always holds its value
// directly) and every scalar/handle-kind param. cgExprAddr's EVarRef arm is
// the sole consumer: MOVEA.L off(A6),A0 (dereference the stored pointer)
// when true, LEA off(A6),A0 (address of the slot itself) when false --
// every str/record read, field ref, retain walk, and store already routes
// through cgExprAddr, so this one bit at this one arm is the whole
// callee-side deref path.
var cgCurFrameIsRef: list of bool

// cgCurEpilogueLabel is bound immediately before the current function's
// UNLK/RTS; every SReturn branches here rather than emitting its own
// UNLK/RTS inline -- one shared epilogue per function, naive but uniform.
var cgCurEpilogueLabel: int

// ================================================================
// attempt-abort phase Task 4 (design doc %3.2/%3.3): per-function bail
// tracking, mirroring cprint.cla's fpBailTargets/fpBailDepth/fpBailUsed/
// fpCurFuncHasBail family exactly (see that file's own doc comments for
// the full design rationale) -- the two backends deliberately carry the
// SAME state shape, just with a68 label ids (int) standing in for
// cprint's C label text.
//
// cgBailTargets/cgBailDepth: a FIXED array + manual depth counter (not
// `list of int`), same reasoning as cprint's own fpBailTargets doc
// comment -- a NEW heap-typed GLOBAL in clarusc's own source costs every
// one of clarusc's native-68k self-emit segments a slice of fixed
// overhead (cgEmitFreeGlobalsStub's glue bundle, Task 3's own
// segment-budget regression writeup), regardless of which function
// "owns" it. 32 levels of `attempt` nesting is far beyond any real
// program; cgAttemptStmt fails loudly (abort() -- attempt-abort phase
// Task 6 converted this from `log(msg); quit 1`, non-UI-default
// observable behavior unchanged, design doc %3.5) past that rather than
// silently corrupt an out-of-range slot.
var cgBailTargets: int[32]
var cgBailDepth: int

// cgBailUsed/cgBailLbl (attempt-abort phase Task 4): the function's own
// bail label, allocated LAZILY on first actual use (cgFuncBailLabel,
// below) -- mirrors this file's own cgMul32Label/cgDiv32Label idiom, and
// is REQUIRED here (not just an optimization): a68Finish fails the whole
// assembly if ANY a68NewLabel() id is never a68Bind()'d (asm68k.cla's own
// doc comment at cg68k.cla:1213), so a per-function bail label can only
// ever be allocated when cgEmitFunc is also going to bind it -- eager
// unconditional allocation (mirroring cgCurEpilogueLabel) is not an
// option the way it is for cprint's own C source (an unreferenced C
// label is harmless; an unbound a68 label is a hard assembly failure).
// Reset to false/-1 at the top of every cgEmitFunc, exactly where
// cgCurEpilogueLabel itself is (re-)established.
var cgBailUsed: bool
var cgBailLbl: int

// cgCurFuncHasBail (attempt-abort phase Task 4) is true only while
// emitting a function whose own irFuncBail(f) != -1 -- mirrors cprint's
// fpCurFuncHasBail exactly. The post-call check (cgCallFnScalar/
// cgCallFnInto) consults this before ever calling cgAbortTarget(),
// which is what makes cgFuncBailLabel's lazy allocation safe: it is only
// ever invoked from a context that already knows a real bail chain
// (irFuncBail(f)) exists for THIS function to fall through into.
var cgCurFuncHasBail: bool

// cgCurFuncIsUiDispatcher (attempt-abort phase Task 4; serial-connection
// phase Task 6 folds the `clar_conn_fire_*` family in too) is true only
// while emitting one of the lowering-synthesized reverse-waist event
// dispatchers -- UI (`clar_ui_fire_*`) or connection (`clar_conn_fire_*`)
// -- (cgSeveredFamily's own existing family-1 classification, reused
// rather than re-derived) -- see cgAbortCheckAfterCall's own doc comment
// for why these need the §3.5 in-place default instead of an ordinary
// bail-target branch: they are built via newIRFunc directly
// (lowSynthUiDispatchers/lowSynthConnDispatchers), never through
// lowFuncBody, so they never get a real bail chain of their own
// (irFuncBail is always -1 for them) even in an abort-enabled program.
var cgCurFuncIsUiDispatcher: bool
// ================================================================

// cgCurHiddenOffset is 8 (the hidden result pointer's fixed param offset
// -- see the file header's "FRAME MODEL, WORKED EXAMPLE") when the
// current function's own return type needs one (cgSizeOf > 4), else -1.
// cgCurRetType is irFuncRet(f) for the SReturn str path's capacity.
var cgCurHiddenOffset: int
var cgCurRetType: int

// cgLoopBreakLabels/cgLoopContinueLabels are parallel label-id stacks,
// one entry pushed per enclosing SWhile/SForRange (popped on exit) --
// SBreak/SContinue branch to whichever sits on top (innermost loop; both
// statements are unlabeled per the language reference).
var cgLoopBreakLabels: list of int
var cgLoopContinueLabels: list of int

// cgMul32Used/cgDiv32Used/cgMod32Used gate whether cg68Program emits the
// corresponding hand-written helper routine (cg_mul32/cg_div32/
// cg_mod32) at all -- and whether its label is even ALLOCATED: an
// a68NewLabel() that's never a68Bind-ed would trip a68Finish's "every
// label must be bound" check for a program that happens never to use
// "*"/"/"/"mod", so the label itself is only created lazily, the first
// time cgMul32Label/cgDiv32Label/cgMod32Label is actually called.
var cgMul32Used: bool
var cgMul32Lbl: int
var cgDiv32Used: bool
var cgDiv32Lbl: int
var cgMod32Used: bool
var cgMod32Lbl: int

// cgFreeGlobalsLbl is cg68Program's own freeGlobalsLbl, stashed here so
// cgIntr's "quit" arm (Task 11 -- a `quit expr` statement anywhere in a
// handler body, not just the implicit one cgEmitStartup's own terminal
// sequence already emits) can JSR it too: the brief's IQuit arm is
// "JSR cg_free_globals; push code; JSR natQuit", same cleanup-before-exit
// order the startup sequence uses. Set once, before cgEmitFunc's own
// function-emission loop runs (cg68Program), read here. Task 15: this is
// now a PER-SEGMENT label (cg_free_globals is duplicated into every
// segment -- see the Task 15 header comment below), reassigned fresh at
// the top of each segment's own real-emission pass.
var cgFreeGlobalsLbl: int

// ================================================================
// Task 15: segmentation -- measure -> pack -> emit.
//
// THE FIXED-SIZE INVARIANT (why a two-pass measure/emit split is even
// possible here). Every call-site instruction this backend ever emits
// (BSR.W, JSR d16(A5), and the pre-Task-15 JSR d16(PC) form) is a
// SINGLE-EA instruction whose one operand is a MODE-7 PC-relative-or-
// A5-relative-displacement form -- a68InstrExtWords' own table
// (asm68k.cla) charges every one of AmPCLabel/AmDisp16 exactly ONE
// extension word, REGARDLESS of the actual displacement value (this
// backend never emits a .B short branch -- "branches are .W everywhere,
// shrinking is peephole's job later", the design spec's own words). So
// BSR.W, JSR d16(A5), and JSR d16(PC) are ALL exactly 4 bytes (2-byte
// opcode word + 1 extension word), unconditionally. This is what makes
// measuring a function's SIZE possible before its final segment (and
// therefore its final call-instruction FORM) is known: the measure pass
// can pick ANY form at any call site -- this file always just reuses the
// real cgCallFunc/a68EmitBr(OpBsr,...) call machinery unmodified -- and
// the byte count it produces is IDENTICAL to whatever form the real emit
// pass eventually chooses. The other half of the same invariant: a68's
// own two-pass model (asm68k.cla's file header, "TWO-PASS ENCODING,
// MERGED") only ever DEREFERENCES a label's bound address inside
// a68Finish's encoding walk -- a68PushInstr (which every a68Emit/
// a68EmitBr call goes through) never touches a68LabelAddr, it only
// computes a length from op/size/mode. The measure pass below NEVER
// calls a68Finish() (it only reads a68SizeSoFar() deltas, then discards
// the whole stream via a68Reset()), so referencing an unbound, stale, or
// even a different-generation label id at a measure-time call site is
// completely safe -- there is nothing to dereference yet.
//
// GLUE IS DUPLICATED, NOT JT-CROSS-CALLED. cg_mul32/cg_div32/cg_mod32,
// every record's cg_retain_<Rec>/cg_release_<Rec> walk pair, and
// cg_free_globals are all backend-SYNTHESIZED (not irFuncs entries) --
// rather than giving them their own jump-table slots and routing calls
// to them through the Segment Loader (the mechanism reachable irFuncs
// entries use, below), this backend just re-emits an identical copy of
// all of them into EVERY segment that might need one, so a call from
// ANY segment's own code to "the" mul32 helper (or free_globals, or a
// given record's walk pair) is always an intra-segment BSR.W to THAT
// segment's own local copy. This is a deliberate simplification (this
// file's own report elaborates): these routines are small, fixed-size,
// self-contained (mul32/div32/mod32 never call anything else at all;
// the RC walkers and free_globals only ever call OTHER duplicated glue
// or ordinary irFuncs runtime functions, cgCallFunc's normal case),
// so their total footprint never grows with program size the way user
// functions do -- duplicating a few hundred bytes of glue into each of
// N segments is a bounded, one-time cost, and it means this file never
// needs a second (glue-flavored) jump-table/cross-segment mechanism at
// all. startup and cg_init_globals are the two exceptions: both run
// EXACTLY once, always from within segment 1 itself, so they stay
// segment-1-only, undupped, matching the plan's own "Startup function
// stays JT slot 0 in CODE 1" requirement.
//
// POOL DUPLICATION POLICY. Rather than tracking, per function, exactly
// which string-literal/enum-table pool entries it references (and
// which segment already carries a given entry), this backend just
// re-emits the WHOLE constant pool (cgEmitPoolsBody, unchanged) into
// EVERY segment. Simpler and still correct (a segment's own LEA
// d16(PC) pool reference always resolves within its own stream), at
// the cost of some duplicated bytes when a program's pool is large
// AND it needs several segments -- an exact per-function subset would
// shrink that; not implemented here (see this task's own report for
// the tradeoff spelled out in full).
//
// JT SLOTS ARE ASSIGNED **AFTER** PACKING, NOT BEFORE. Segment loader
// CODE-N headers ({first JT entry offset, count}) require every segment's
// OWN jump-table entries to be a CONTIGUOUS range -- declaration order
// alone (the pre-Task-15 cgAssignJtSlots scheme) can't guarantee that
// once first-fit packing is free to scatter functions across segments in
// any order. So slot numbers are only finalized by cgAssignFinalJtSlots,
// AFTER cgPackProgram has decided cgFuncSegment -- slot 0 is always
// startup, then segment 1's own packed functions (declaration order),
// then segment 2's, and so on, so every segment's own slots are exactly
// one contiguous run.
// ================================================================

const cgSegHeaderSize: int = 4

// cgSegLimit is the per-segment payload budget in bytes (CODE-N header +
// code + that segment's own duplicated pool/glue, all counted) -- set by
// cg68Program from its segLimit parameter (<=0 selects the real classic-
// Mac budget, 32760, leaving 8 bytes of a 32768-byte resource under the
// hard 32KB CODE-resource ceiling as this backend's own safety margin).
// A test-only override (main.cla's undocumented `--seglimit N` flag)
// lets a test FORCE a small program into several segments deterministically,
// to prove cross-segment calls + LoadSeg actually work on real hardware
// without needing a suite-sized fixture for every such test.
var cgSegLimit: int

// cgFuncSize[i] is irFuncs index i's own measured standalone code size in
// bytes (cgMeasureFunc), valid only when shakeReachable(i).
var cgFuncSize: list of int

// cgFuncSegment[i] is irFuncs index i's 1-based assigned segment number
// (cgPackProgram's own output), valid only when shakeReachable(i).
var cgFuncSegment: list of int

// cgFuncFrameSizes[i] is irFuncs index i's own LINK frame size in bytes
// (native-gaps-cleanup Task 4) -- cgEmitFunc's own `frameSize` local,
// index-assigned there (NOT appended: cgEmitFunc runs twice per function,
// once during cg68Measure's throwaway pass and once for real, always
// computing the identical value from the same IR, so a plain index write
// is idempotent). Pre-sized to irFuncs.count zeros by cg68Measure before
// either pass runs. 0 for an unreachable function, or a callback-glue
// function (cgEmitFunc's cgCbGlueBodyFor early-return skips the frameSize
// computation entirely -- a callback's own dispatch depth is untraceable
// from the static call graph anyway, see cgStackHeuristic's own doc
// comment). cgStackHeuristic's only reader.
var cgFuncFrameSizes: list of int

// cgCurFuncSegment is the segment number of whatever code unit is
// CURRENTLY being emitted (a packed function, or 1 while emitting
// startup/cg_init_globals/any duplicated-glue routine) -- cgCallFunc's
// own same-segment/cross-segment decision.
var cgCurFuncSegment: int

// cgSegCount is the total number of segments cgPackProgram produced.
var cgSegCount: int

// cgSeg1ExtraSize/cgGlueBundleSize/cgPoolSize are the three fixed,
// non-function byte costs cgPackProgram charges against segment budgets:
// startup+cg_init_globals (segment 1 only), the duplicated-glue bundle
// (every segment), and the full constant pool (every segment) -- all
// three measured once by cg68Measure, by literally emitting them into a
// throwaway stream and reading the byte delta (same technique as
// cgFuncSize, same fixed-size invariant, never re-derived by a parallel
// formula that could drift out of sync with the real emitter).
var cgSeg1ExtraSize: int
var cgGlueBundleSize: int
var cgPoolSize: int

// ================================================================
// Task 13 (native-5f, constant-pool segmentation): per-segment pool
// dedup. The old design charged EVERY segment the full cgPoolSize
// (clarusc's own pool alone is 32.8KB, bigger than the whole 32KB
// segment budget -- see this file's own Task 13 header note above
// cgPackProgram). The new design tracks WHICH constant-pool entries each
// function (and each of the two always-duplicated glue buckets) actually
// references, so cgPackProgram can charge each segment only the pool
// bytes its own packed functions need, and cg68Program's real per-
// segment pass can bind only those labels (a68Finish demands every
// a68NewLabel'd label be bound -- see cgRecRetainLbls' own doc comment
// for the established "-1 sentinel, don't allocate what won't bind"
// precedent this mirrors).
//
// Usage is recorded ONCE, during cg68Measure's single real-emitter pass
// (function bodies are deterministic -- the real per-segment pass emits
// byte-identical code from the same IR, so re-recording there would be
// redundant): cgRecMode selects which bucket cgRecordStrLit/
// cgRecordEnumTable/cgRecordSerdesc/cgRecordUiBlob/cgRecordUiEvents
// append into while cg68Measure runs -- 0 (default, real per-segment
// pass) records nothing, 1 is "the function at cgRecFuncIdx", 2 is the
// seg1-only startup+cg_init_globals bucket, 3 is the every-segment
// duplicated-glue bucket (mul32/div32/mod32 + cg_free_globals + the RC
// walks).
var cgRecMode: int
var cgRecFuncIdx: int

// Task 15 (findings 1.8): epoch-stamp membership for cgRecordStrLit/
// cgRecordEnumTable/cgRecordSerdesc, replacing a per-call cgIntListHas
// linear scan of the CURRENT bucket. cgStrLitSeen[i]/cgEnumSeen[i]/
// cgSerdescSeen[i] hold the cgSeenEpoch value as of the last time arena
// entry i was recorded; "already in the current bucket" is just
// `cgXSeen[i] == cgSeenEpoch`, O(1) and self-clearing -- no per-function
// reset needed, since cgSeenEpoch is bumped every time the recording
// context changes (each function's own cgRecFuncIdx assignment in
// cg68Measure's function loop, and once each before the cgRecMode=2 and
// cgRecMode=3 blocks), making every prior epoch value stale by
// definition. Both are sized once, to the dense IR-arena universe
// (irStrLits.count/irEnums.count/irRecords.count -- fixed after
// lowering), at cg68Measure entry; cgSeenEpoch starts at its int default
// 0 and is always bumped (never read) before first use, so epoch 0 never
// legitimately matches and needs no separate sentinel.
var cgSeenEpoch: int
var cgStrLitSeen: list of int
var cgEnumSeen: list of int
var cgSerdescSeen: list of int

// cgFuncStrLits[i]/cgFuncEnumTables[i]/cgFuncSerdescs[i]/
// cgFuncUsesUiBlob[i]/cgFuncUsesUiEvents[i] are irFuncs index i's own
// constant-pool needs (str-lit / enum-table / serdesc indices, deduped;
// empty/false for an unreachable function, same convention as
// cgFuncSize). cgSeg1*/cgGlue* are the matching buckets for the two
// fixed-cost glue regions (see cgRecMode's own comment just above).
var cgFuncStrLits: list of list of int
var cgFuncEnumTables: list of list of int
var cgFuncSerdescs: list of list of int
var cgFuncUsesUiBlob: list of bool
var cgFuncUsesUiEvents: list of bool

var cgSeg1StrLits: list of int
var cgSeg1EnumTables: list of int
var cgSeg1Serdescs: list of int
var cgSeg1UsesUiBlob: bool
var cgSeg1UsesUiEvents: bool

var cgGlueStrLits: list of int
var cgGlueEnumTables: list of int
var cgGlueSerdescs: list of int
var cgGlueUsesUiBlob: bool
var cgGlueUsesUiEvents: bool

// cgStrLitSize[i]/cgEnumTableSize[i]/cgSerdescSize[i]/cgUiBlobSize/
// cgUiEventsSize are each pool entry's own standalone byte size --
// measured once, by cg68Measure's final throwaway whole-pool emission
// (cgMeasuringPoolSizes routes cgEmitPoolsBody's per-entry before/after
// deltas here), the same before/after-delta technique cgFuncSize already
// uses for function code. cgPackProgram's own incremental per-segment
// cost accounting (cgPoolDeltaPeek/cgPoolDeltaAndUnion) is these lists'
// only reader.
var cgStrLitSize: list of int
var cgEnumTableSize: list of int
var cgSerdescSize: list of int
var cgUiBlobSize: int
var cgUiEventsSize: int
var cgMeasuringPoolSizes: bool

// cgCurPoolStrLits/cgCurPoolEnumTables/cgCurPoolSerdescs/
// cgCurPoolUsesUiBlob/cgCurPoolUsesUiEvents select WHICH pool entries the
// CURRENT pass (cg68Measure's one throwaway pass, or one of
// cg68Program's real per-segment passes) reserves labels for
// (cgReserveStrLitLabels/cgReserveEnumTableLabels/cgReserveSerdescLabels/
// cgReserveUiPoolLabels) and actually emits (cgEmitPoolsBody) -- the
// measure pass sets these to "every entry" (it must measure everything,
// packing hasn't run yet); each real per-segment pass sets these to that
// segment's own need-set, cgPackProgram's own output
// (cgSegStrLitSets[s-1] etc., below).
var cgCurPoolStrLits: list of int
var cgCurPoolEnumTables: list of int
var cgCurPoolSerdescs: list of int
var cgCurPoolUsesUiBlob: bool
var cgCurPoolUsesUiEvents: bool

// cgCurPoolStrLitBits/cgCurPoolEnumBits/cgCurPoolSerdescBits (Task 15,
// findings 1.8) are cgCurPoolStrLits/cgCurPoolEnumTables/cgCurPoolSerdescs'
// own O(1)-membership bitmaps -- length irStrLits.count/irEnums.count/
// irRecords.count, rebuilt (via cgBoolBitmapFromList) every time the
// matching cgCurPool* list is assigned, both sites: cg68Measure's own
// "every entry" setup and cg68ProgramFork's per-segment loop. Read by
// cgReserveStrLitLabels/cgReserveEnumTableLabels/cgReserveSerdescLabels
// in place of a cgIntListHas scan of the list itself.
var cgCurPoolStrLitBits: list of bool
var cgCurPoolEnumBits: list of bool
var cgCurPoolSerdescBits: list of bool

// cgAllStrLits/cgAllEnumTables/cgAllSerdescs are cg68Measure's own
// "every entry" filter sets, kept around (not just used transiently) so
// cgPackProgram's single-segment special case (see its own doc comment)
// can restore them for a program that only ever produces ONE segment --
// byte-identical to the pre-Task-13 "always the whole pool" behavior,
// preserving every existing single-segment `internal/cg68k` golden.
var cgAllStrLits: list of int
var cgAllEnumTables: list of int
var cgAllSerdescs: list of int

// cgSegStrLitSets[s-1]/cgSegEnumTableSets[s-1]/cgSegSerdescSets[s-1]/
// cgSegUsesUiBlob[s-1]/cgSegUsesUiEvents[s-1] are cgPackProgram's own
// output: segment s's final deduped pool need-set, consumed by
// cg68Program's real per-segment pass (assigned into cgCurPool* above
// before that segment's cgReserve*Labels/cgEmitPoolsBody calls).
var cgSegStrLitSets: list of list of int
var cgSegEnumTableSets: list of list of int
var cgSegSerdescSets: list of list of int
var cgSegUsesUiBlob: list of bool
var cgSegUsesUiEvents: list of bool
// ================================================================

// cgTotalJtSlots is the final jump-table entry count (cgAssignFinalJtSlots'
// own output, 1 [startup] + one per reachable irFuncs entry).
var cgTotalJtSlots: int

// ================================================================
// Task 12: records/enums per-cg68Program()-run module state.
//
// cgRecRetainLbls[i]/cgRecReleaseLbls[i] are irRecords index i's
// cg_retain_<Rec>/cg_release_<Rec> a68 label ids, or -1 when
// irRecHasHandleField(irRecordLayoutName(i)) is false -- exactly THE gate
// the brief names (ir.cla:720, "must be the same test on define and call
// side"): a scalar-only record gets no walk pair at all (nothing to
// retain/release), so its two label slots stay -1 and are never bound
// (a68Finish would flag an allocated-but-unbound label as unresolved, so
// this file never allocates one it isn't going to bind). Reserved by
// cgAssignRcWalkLabels, up front (same "reserve before any body can
// reference it" discipline cgAssignJtSlots/cgReserveStrLitLabels already
// follow), read by cgRetainAt/cgReleaseAt's own KRec branch and bound by
// cgEmitRcWalks.
var cgRecRetainLbls: list of int
var cgRecReleaseLbls: list of int

// cgEnumTableLabels[i] is irEnums index i's constant-pool value-table
// label id (a plain DC.L list of that enum's member values, declaration
// order -- cgEmitEnumTables's own body). Reserved by
// cgReserveEnumTableLabels, same up-front-reservation discipline as
// cgStrLitLabels: a CvIntToEnum conversion site (cgEmitEnumConv) can
// reference the label as a forward PC-relative operand while walking a
// function body, well before the pool itself is laid out.
var cgEnumTableLabels: list of int

// cgSerdescLabels[i] is irRecords index i's constant-pool serdesc-table
// label id (-1 if that record doesn't need one, irLayoutNeeded's own
// gate), reserved by cgReserveSerdescLabels with the same up-front-
// reservation discipline as cgEnumTableLabels -- a file.save/file.load
// call site (cgIntrFileSaveLoad) can reference the label as a forward
// PC-relative operand while walking a function body, well before the pool
// itself is laid out (cgEmitSerdescTables). Task 14 fix (native-5e gate,
// bookmarks.cla): the native constant-pool analog of cprint.cla's
// `clar_serdesc_<REC>` flat int32 arrays (cpEmitSerDescs) -- SAME field
// layout (cgBuildSerdescInts' own doc comment), but offsets/sizes come
// from cg68k's own cgFieldOffset/cgRecordSize record-ABI authority (Task
// 14's own bool/char-in-record fix), never cpCFieldOffset/cpCRecordSize.
var cgSerdescLabels: list of int

// ================================================================
// Task 13: containers + the ARC statement-temp layer.
//
// NATIVE HAS NO C-STYLE STATEMENT-TEMP MACHINERY (cgAndOr's own doc
// comment, Task 8) -- cprint's fpNewTmp/fpNewTrackedTmp declare a fresh
// NAMED C variable per intermediate value; this backend instead reserves a
// FIXED POOL of anonymous A6-relative frame slots per function (below the
// function's own named locals, cgEmitFunc), addressed the SAME way a named
// local is (reg=6, off) -- cgNewTrackedTmp/cgAllocTmpOff hand out the next
// free slot, cgStmt resets the pool's high-water mark to 0 at the START of
// every statement (mirroring fpStmt's own fresh-list swap: a slot only
// needs to stay live for ONE statement, same as a C temp's declared-once-
// per-statement lifetime), so a function never runs out of slots as long
// as no SINGLE statement needs more than cgTmpSlots concurrently live
// temps (cgNewTrackedTmp hard-errors, loud, if it does -- bump the const).
// A6-relative (not A7-relative/stack-scratch) specifically because it stays
// valid across every nested call's own argument push/cleanup sequence
// (cgForRangeStmt's `to`-on-the-stack precedent works ONLY because nothing
// between its one push and its one read can itself push -- not true here,
// where a tracked temp's value can flow through an arbitrary nested call).
//
// cgStmtTmpOffs[i]/cgStmtTmpType[i] mirror fpStmtTmps/fpStmtTmpType (no
// fpStmtTmpRel/fpStmtTmpIsRec sibling: cgFreeStmtTmps re-derives the right
// release call from the type directly via cgReleaseAt, and KRec temps
// aren't built by this task -- cgNewTrackedTmp hard-errors on any
// cgSizeOf(t)>4 result, same "not exercised by this task's fixtures"
// scope note the rest of this file already uses for KRec/KStr/KArr
// container elements). mac-resident-clarusc Task 3: bumped from 8 to 14
// (self-hosting clarusc through emit68k hit the "too many tracked temps"
// error -- a single statement in clarusc's own source, a call whose
// arguments are 14 chained `list.pop()`s, needs 14 concurrently-tracked
// small temps). Set to the exact observed need, not padded -- see the
// regression pin, testdata/run/smalltmp_ceiling.cla, which exercises
// exactly 14 so an accidental future shrink fails there, loudly, instead
// of only being caught by self-hosting clarusc again.
const cgTmpSlots: int = 14

// cgBigTmpSlots/cgBigTmpSize (Task 14.7 gap-closure; bumped Task 14,
// native-5e): a SEPARATE, smaller pool sized for a KStr/KRec temp
// (cgTmpBaseOffs' own slots are a fixed 4 bytes, too small for anything
// past a str(3)/tiny record) -- same per-statement bump-allocated
// lifetime as the small pool (cgStmtBigTmpNext mirrors cgStmtTmpNext
// exactly), just reserved and indexed separately since the two never
// share a slot. Originally 256 bytes/2 slots (Task 14.7's own corpus
// never needed more than a bare Str255); bumped to 512/4 when a REAL UI
// record (popuptable.cla/formedit.cla/bookmarks.cla's own `record
// Bookmark { name: string(63); url: string(255); ... }`, ~330 bytes)
// first exceeded 256, and a texteditor.cla statement first needed more
// than 2 concurrently-live big temps. Both are literally the upgrade
// path their own error messages name ("bump cgBigTmpSlots"/the size
// check) -- not a new mechanism, just headroom for real (not synthetic)
// UI record shapes. mac-resident-clarusc Task 3: bumped 4 -> 16 --
// self-hosting clarusc through emit68k hit the ceiling again, this time
// from clarusc's OWN source (a single call statement with 16 str_concat
// arguments, each needing the arg-materialization generic fallback --
// cgPushArgMaterialized at the time, folded into cgPushArgs' own
// cgMaterializeToTemp branch by the param-abi phase, Task 6, but drawing
// from this SAME pool either way).
// Set to the exact observed need, not padded -- see the regression pin,
// testdata/run/bigtmp_ceiling.cla, which exercises exactly 16 so an
// accidental future shrink fails there, loudly, instead of only being
// caught by self-hosting clarusc again.
//
// Cost/review note (Task 3 fix round): both pools are reserved
// UNCONDITIONALLY in every function's frame (this file's own "cheap if
// unused" framing above), so this bump's real per-function cost is
// +6144B (cgBigTmpSlots 4->16, x512B/slot) + 24B (cgTmpSlots 8->14,
// x4B/slot) = +6168B/function, paid by EVERY reachable function whether
// or not it ever touches either pool. Quantified before accepting the
// flat design over per-function sizing (task-3-report.md's own
// "Fix round: frame-cost quantification" has the full numbers; summary
// here since a future reader of just this const deserves the headline):
// this is a STACK reservation, not a CODE-size or heap cost -- it changes
// only the immediate operand of each function's own `LINK A6,#-N`
// (same instruction bytes either way; confirmed zero effect on the
// per-segment 32KB CODE budget) and the deepest-call-chain SetApplLimit
// reserve cgStackHeuristic below computes automatically. That reserve,
// re-measured after this bump: tickprobe 199,676B, coregui 224,588B,
// toolboxgui 245,248B, clarusc's own self-emit composition (measured
// directly since packing still fails on an unrelated pool-segmentation
// gap) 2,220,906B (~2.17MB) -- all a small fraction of both the phase's
// 128MB Snow acceptance machine and the ~48-64MB SIZE-resource compile
// partition the plan already budgets (Task 10). A corpus scan (clarusc's
// own 1611-function self-emit reachable set) found 69% of functions use
// ZERO big-temp slots and 93% use <=2 of the 16 reserved -- real waste,
// but bounded by call-chain DEPTH (which stays small above), not by
// total function count, so it doesn't compound the way it might look at
// first glance. Recommendation on record: keep the flat reservation
// (simpler, no correctness risk found at this target); revisit only if
// a future phase re-targets a memory-constrained machine (the pre-Snow-
// pivot 4MB Mac Plus scope Task 1 originally assumed).
const cgBigTmpSlots: int = 16
const cgBigTmpSize: int = 512

var cgTmpBaseOffs: list of int
var cgBigTmpBaseOffs: list of int
var cgStmtTmpOffs: list of int
var cgStmtTmpType: list of int
var cgStmtTmpNext: int
var cgStmtBigTmpNext: int
var cgSyntheticVarSeq: int

// cgLastTrackedOff mirrors cprint's own string-identity handoff check
// (fpHandoff(v): "v IS exactly that temp's own C name") in register-machine
// terms: -1, or the frame offset cgExpr's OWN top-level EIntr arm JUST
// tracked for its return value (set as the LAST action before returning,
// by exactly the handful of cgIntr arms that produce one -- pop/shift's
// discard-tracked path, first/last/get/getDv/getDvBirth -- every other arm,
// and cgExpr's own non-EIntr branches, leaves it at -1). Consulted
// immediately after a cgExpr(src) call in a handle-typed SAssign/SReturn
// context (cgStmt/cgReturnStmt) to hand the freshly tracked temp off to its
// new durable owner -- correct even though a NESTED cgExpr call (e.g. an
// intrinsic's own m/k argument evaluation) can transiently stomp this
// module var mid-flight: every producing arm re-sets it as its OWN last
// step, after any such nested recursion, so by the time cgExpr(e) returns
// to ITS caller the value always reflects e's own top-level verdict, never
// a stale nested one (Text/List/Map values, per the language, are only
// ever produced by EVarRef/EFieldRef/ECallFn/EIntr directly -- never
// wrapped in an EBin/EUn/EConv -- so no other node kind can smuggle a stale
// value past a caller that only ever checks this right after evaluating a
// KNOWN handle-typed expression).
var cgLastTrackedOff: int

// cgDiscardExprIdx mirrors fpDiscardExprIdx exactly (cprint.cla): the exact
// IR expr index of the CURRENT bare, discarded SExprStmt's own top-level
// expression, or -1 -- set immediately before, cleared immediately after,
// cgStmt's own SExprStmt cgExpr call. Consulted by two sites: cgIntr's
// IListPop/IListShift arm (pop/shift transfer ownership WITHOUT retaining --
// a plain materialize-and-untrack, like cprint's fpNewTmp+fpHandoff -- so a
// bare `lst.pop();` statement, the popped value used nowhere, would
// otherwise leak) and cgCallFnScalar (a bare, discarded call statement
// returning a fresh handle -- `makeStr();` -- drops D0 with nothing left to
// release it). Both route that ONE discarded shape through cgNewTrackedTmp
// instead of the ordinary untracked path, so the end-of-statement flush
// (cgFreeStmtTmps) releases it (final-review T13).
var cgDiscardExprIdx: int

// cgMaterializeDepth/cgMaterializeMaxDepth (final-review I1 guard,
// generalized by mac-resident-clarusc Task 3; REMOVED, param-abi phase
// Task 6): used to bound nested-materialization depth for
// cgPushArgMaterialized/cgMaterializeCallResult's own A1-stash-across-
// nested-cgPushArgs dance -- that whole mechanism existed because the OLD
// by-value ABI reserved a KStr/KRec argument's FINAL stack slot up front
// (a >4-byte block) and had to protect its address (A1) across evaluating
// any of ITS OWN nested args. Task 6's by-address ABI removed the need
// entirely: a materialized KStr/KRec argument's temp is now an ordinary
// A6-relative scratch slot (cgMaterializeToTemp), addressable at ANY time
// via a single LEA, with no ordering constraint against the arg-push
// sequence to protect -- cgPushArgs' own materialize branch just calls
// cgMaterializeToTemp directly (which recurses through the SAME
// cgEmitStoreRec/cgCallFnInto dispatch every other str/rec store already
// used, no depth bound needed) and pushes the temp's address once done.
// See cgPendingArgReleases' own doc comment (near cgPushArgs) for the ONE
// reentrancy hazard the new design still has (a module-global release
// list, not a register) and how it's guarded -- the direct successor to
// this note.

// cgDeepLevels bounds container release-walk nesting (a List/Map element
// that is itself a List/Map recurses -- cpEmitRelease's own ARC Task 8
// nested-container arm, cprint.cla:3281-3320/3381-3398). Each level gets
// its OWN {ptr,count,index} scratch triple (cgDeepPtrOffs[level]/
// cgDeepCountOffs[level]/cgDeepIndexOffs[level], all A6-relative, reserved
// alongside the statement-temp pool -- cgReserveDeepScratch) so a
// recursive call never collides with its own caller's live scratch; 3
// levels covers any nesting this task's fixtures reach (the brief's own
// "nested list-of-map" miniature is 2) with headroom to spare --
// cgDeepReleaseContainer hard-errors, loud, past that (not silently wraps
// and corrupts a shallower level's scratch).
const cgDeepLevels: int = 3

var cgDeepPtrOffs: list of int
var cgDeepCountOffs: list of int
var cgDeepIndexOffs: list of int
var cgDeepValueOffs: list of int

// cgListOobMsgIdx is the irStrLits index of "list index out of range" --
// registered once, up front (cg68Program, before cgReserveStrLitLabels
// runs so the label exists before any addressing site can reference it),
// for cgEmitPanic's own List bounds-check panic call (the brief's four
// ADDRESSING sites: fpIndexRef's List arm, SForList's per-iteration deref,
// IListSet/IListSetRetain's element ref, IListRemove's old-value read --
// same message rtListAt itself panics with, list.cla:290, kept in exact
// parity even though these four sites inline their OWN bounds check rather
// than JSR-ing rtListAt, mirroring cprint's own "stay bare, don't redirect
// through the ARC-walk-internal ported wrapper" convention for these same
// four sites, list.cla's own module header comment).
var cgListOobMsgIdx: int

// cgResetCodegenState clears every Task 8 module-global above -- called
// once per cg68Program() run, mirroring cgAssignJtSlots/
// cgAssignGlobalOffsets's own fresh-per-run discipline. Also invalidates
// cgFindRecordByName's cgRecIdxByName map and clears cgSizeOf's
// cgSizeMemo (findings 1.4): both caches are sound for the rest of one
// compile -- cg68Measure's throwaway pass and cg68Program's real
// per-segment passes all share the SAME compile's irRecords/irTypes
// arenas -- but must not survive into a LATER, different compile in the
// same process (irReset rebuilds irRecords/irTypes fresh per compile; a
// stale entry keyed by a nameIdx or a type index from a prior compile
// could otherwise misalign against this compile's different arenas).
// Called from TWO places, deliberately: driveCompile (drive.cla, findings
// 1.4 fix round 1) is the backend-agnostic call -- the C-print backend
// (cprint.cla/uiblob.cla) calls cgFindRecordByName directly and never
// runs cg68Measure/cg68ProgramFork at all, so that call is the only one
// that ever protects it; the call here, inside cg68Measure (cg68Program-
// Fork's own first real step), is redundant with driveCompile's for the
// 68k lane specifically but kept anyway -- harmless (nothing populates
// either cache between the two calls) and keeps this function's own
// "once per cg68Program() run" contract honest on its own, without
// relying on every future 68k-lane caller to also route through
// driveCompile.
func cgResetCodegenState() {
    cgMul32Used = false
    cgDiv32Used = false
    cgMod32Used = false
    cgLoopBreakLabels = cgFreshIntList()
    cgLoopContinueLabels = cgFreshIntList()
    cgLastTrackedOff = -1
    cgDiscardExprIdx = -1
    cgPendingArgReleases = cgFreshIntList()
    cgRecIdxByName.clear()
    cgRecIdxByNameValid = false
    cgSizeMemo.clear()
}

// cgReservePanicMsgs mints every panic-message string literal this
// backend's own inline addressing/ARC codegen needs (cgListOobMsgIdx,
// above) -- called once per cg68Program() run, BEFORE cgReserveStrLitLabels
// (same "the arena entry must exist before its label is reserved"
// ordering cgReserveStrLitLabels' own doc comment already establishes for
// every other irStrLits producer).
func cgReservePanicMsgs() {
    cgListOobMsgIdx = irAddStrLit(intern("list index out of range"))
}

func cgMul32Label(): int {
    if not cgMul32Used {
        cgMul32Used = true
        cgMul32Lbl = a68NewLabel()
    }
    return cgMul32Lbl
}

func cgDiv32Label(): int {
    if not cgDiv32Used {
        cgDiv32Used = true
        cgDiv32Lbl = a68NewLabel()
    }
    return cgDiv32Lbl
}

func cgMod32Label(): int {
    if not cgMod32Used {
        cgMod32Used = true
        cgMod32Lbl = a68NewLabel()
    }
    return cgMod32Lbl
}

// ================================================================
// Shake-root registration (main.cla's emit68k arm calls this BEFORE
// shakeProgram()).
// ================================================================

// cg68AddRoots roots every `nat*`-named function (the native console/entry
// shim, native.cla -- Task 11) and rtEnumCheck: cprint.cla's own walk
// never calls either directly (shake.cla's file header), so without this
// call shakeProgram would drop them from a native build even though
// cg68Program needs them reachable. A no-op today (native.cla doesn't
// exist until Task 11 -- shakeAddRoot/shakeMarkAndEnqueue silently ignore
// a name with no matching irFuncs entry), but registering it now means
// Task 11 needs no change here at all.
func cg68AddRoots() {
    var i: int
    var nm: string

    i = 0
    while i < irFuncs.count {
        nm = poolGet(irFuncName(i))
        if nm.length >= 3 and nm[0] == 'n' and nm[1] == 'a' and nm[2] == 't' {
            shakeAddRoot(irFuncName(i))
        }
        i = i + 1
    }
    shakeAddRoot(intern("rtEnumCheck"))
    // attempt-abort phase Task 4 (A4): rtUiAlertMsg (runtime/clarus/
    // uidialogs.cla) is reached ONLY by name from cg68k.cla -- both the
    // IAlert intrinsic arm (every `alert(...)` call in a UI program, not
    // gated on lowUsesAbort at all) and cgEmitAbortDefaultCheck's own
    // UI default (gated on lowUsesAbort) -- same "reached only by name"
    // shape as the nat* family above, so it needs the same explicit
    // root. Gated on irIsUiProgram() alone: a non-UI program never
    // reaches EITHER call site (natAlert covers non-UI alert() calls
    // unchanged, and cgEmitAbortDefaultCheck's non-UI branch never
    // passes ui=true), so it pays nothing extra either way -- and
    // rooting must NOT additionally require lowUsesAbort, or a
    // no-feature UI program's own ordinary `alert(...)` calls (routed
    // through the IAlert arm regardless of the abort feature) would hit
    // an unreachable-callee hard failure at cgCallRuntime.
    if irIsUiProgram() {
        shakeAddRoot(intern("rtUiAlertMsg"))
    }
}

// cg68SynthCbGlue (Task 8, toolbox-integration Feature C: `callback
// func`) synthesizes one "clar_cb_<name>" glue IRFunc (EMPTY-bodied
// placeholder -- cgEmitFunc's by-name/by-table dispatch below recognizes
// it via cgCbGlueBodyFor and emits cgEmitCallbackGlue's hand-built
// pascal-frame body instead of LINK+cgStmts+UNLK) per callback name in
// irCbGlueNames (ir.cla: every `callback func` an ECbAddr decay was EVER
// built for, anywhere in the program, dead code included -- lowering
// doesn't do dead-code elimination). Called from main.cla, after
// lowerProgram but before shakeProgram -- shakeAddRoot's own doc comment
// (shake.cla): a pending root is only consumed by the NEXT shakeProgram
// call, and this compile only ever calls shakeProgram once, so there is
// no later point at which a root could still be registered.
//
// Reachability is deliberately COARSER than cprint.cla's own fine-grained
// gate (cpEmitCallbackGlueProtos/Bodies: irCbGlueNames membership AND
// shakeReachable(bodyFi), so a decay embedded in dead code gets neither
// glue nor body on the C lane) -- this single-pass native backend cannot
// replicate that: by the time shakeProgram has run far enough to prove a
// given body's true reachability, it is too late to still register a
// root for its glue (see the shakeAddRoot doc comment above). Every name
// here gets BOTH its glue and its body unconditionally rooted -- shake.cla's
// own header comment blesses this direction explicitly:
// "Over-approximation is always safe here (a few extra functions
// emitted); under-approximation is a C link error." The ONE case this
// task's own listing golden actually tests -- a callback NEVER decayed
// anywhere, so irCbGlueNames has no entry for it at all -- still gets
// zero trace either way: it never reaches this loop.
func cg68SynthCbGlue() {
    var i: int
    var nameIdx: int
    var bodyFi: int
    var glueName: int
    var glueFi: int

    cgCbGlueFuncIdx = cgFreshIntList()
    cgCbGlueBodyFuncIdx = cgFreshIntList()
    i = 0
    while i < irCbGlueNeededCount() {
        nameIdx = irCbGlueNeededName(i)
        bodyFi = findIRFuncIdxByName(nameIdx)
        if bodyFi == -1 {
            abort("cg68k: callback " + poolGet(nameIdx) + " has no matching irFuncs entry")
        }
        glueName = intern("clar_cb_" + poolGet(nameIdx))
        glueFi = newIRFunc(glueName, -1, irVoidT, -1, -1)
        shakeAddRoot(glueName)
        shakeAddRoot(nameIdx)
        cgCbGlueFuncIdx.add(glueFi)
        cgCbGlueBodyFuncIdx.add(bodyFi)
        i = i + 1
    }
}

// cgCbGlueBodyFor returns the `callback func` body's own irFuncs index
// for f (a glue func's irFuncs index, cg68SynthCbGlue's own
// cgCbGlueFuncIdx entry), or -1 if f is not a synthesized callback glue.
func cgCbGlueBodyFor(f: int): int {
    var i: int

    i = 0
    while i < cgCbGlueFuncIdx.count {
        if cgCbGlueFuncIdx[i] == f {
            return cgCbGlueBodyFuncIdx[i]
        }
        i = i + 1
    }
    return -1
}

// cgCbGlueSlotIdx (object-code-linker Task 2) is cgCbGlueBodyFor's own
// twin: given f, a synthesized GLUE func's own irFuncs index, returns
// its position within cgCbGlueFuncIdx/irCbGlueNames (built in lockstep
// by cg68SynthCbGlue, one entry per name), or -1 if f is not one. See
// cgHoleCbGlueAddr's own doc comment for why this position -- stable
// across bake/compile universes -- is what a captured hole stores
// instead of f itself.
func cgCbGlueSlotIdx(f: int): int {
    var i: int

    i = 0
    while i < cgCbGlueFuncIdx.count {
        if cgCbGlueFuncIdx[i] == f {
            return i
        }
        i = i + 1
    }
    return -1
}

// ================================================================
// Small local copies of cprint.cla helpers this file also needs -- kept
// local rather than depending on cprint.cla (see the file header: the two
// backends are siblings, not layered).
// ================================================================

func cg68ToText(s: string): text {
    var t: text = ""
    t.append(s)
    return t
}

// cg68TypeEqual is a structural IRType comparison -- arena indices are
// NEVER compared directly (ir.cla's own warning); mirrors cprint.cla's
// cpTypeEqual exactly.
func cg68TypeEqual(a: int, b: int): bool {
    if irtKind(a) != irtKind(b) or irtN(a) != irtN(b) or irtName(a) != irtName(b) {
        return false
    }
    if (irtElem(a) == -1) != (irtElem(b) == -1) {
        return false
    }
    if irtElem(a) != -1 {
        return cg68TypeEqual(irtElem(a), irtElem(b))
    }
    return true
}

// ================================================================
// Layout model -- THE native type-size/alignment/field-offset authority.
// See the file header's "LAYOUT AUTHORITY" note for the governing rule.
// ================================================================

// cgSizeMemo[t] caches cgSizeOfUncached(t), parallel to irTypes, -1 =
// unknown (findings 1.4: cgSizeOf is recursive and had 66 direct call
// sites plus cgAlignOf/cgSlotSizeOf/cgRecFieldSizeOf/cgArrElemStride
// fan-in, so a nested record re-scanned the record registry once per
// level per call). Sound because irTypes is append-only and each index is
// immutable once created (Global Constraints) -- cleared, alongside
// cgRecIdxByNameValid below, by cgResetCodegenState, called once per
// compile from both driveCompile and cg68Measure (see
// cgResetCodegenState's own doc comment), so a stale entry from a PRIOR
// compile in the same process can never misalign against this compile's
// different irTypes arena.
var cgSizeMemo: list of int

func cgSizeOf(t: int): int {
    var sz: int

    while cgSizeMemo.count < irTypes.count {
        cgSizeMemo.add(-1)
    }
    if cgSizeMemo[t] != -1 {
        return cgSizeMemo[t]
    }
    sz = cgSizeOfUncached(t)
    cgSizeMemo[t] = sz
    return sz
}

// cgSizeOfUncached is cgSizeOf's real body (the memo above wraps it) --
// unchanged from the pre-memo cgSizeOf.
func cgSizeOfUncached(t: int): int {
    var k: IRKind

    k = irtKind(t)
    switch k {
    case KVoid {
        return 0
    }
    case KInt, KFixed, KPtr, KEnum, KText, KList, KMap, KSortedMap, KIntMap, KWinRef, KUiState, KOverlay {
        return 4
    }
    case KBool, KChar {
        return 1
    }
    case KWord {
        // Task 4 (native-5e) originally documented this as dead/
        // defensive ("KWord never appears as a real variable/field/local's
        // type" -- IRKind's own doc comment) -- Task 8 (toolbox-
        // integration Feature C) makes it real: a `callback func`'s own
        // `word`-typed param/return keeps genuine KWord in its irFuncs/
        // IRLocal entry (lower.cla's DkCallbackFunc arm calls lowFuncBody,
        // whose param loop is `newIRLocal(paramName(p),
        // lowResolveType(paramType(p)))` -- lowResolveType, NOT the
        // checker's own word-folds-to-int resolveType). BUT every ordinary
        // EXPRESSION referencing that same param (lowIdent's `ty =
        // lowMustType(e)`, the CHECKER's own resolved type) is
        // indistinguishable from a plain `int` one, exactly as
        // checkCallbackFunc's own doc comment says ("the checker cannot
        // and need not tell a `word` param from a plain `int` one") --
        // cgLoadVar/cgStoreScalarVar/cgPushArgs all key off an
        // EXPRESSION's irExprType, so EVERY read/write/re-push of a word
        // param already assumes a full 4-byte slot, regardless of what
        // this function returns. Returning 2 here (the pascal WIRE width,
        // not the Clarus frame width) left cgEmitFunc's own param-offset
        // loop (cgSlotSizeOf(irLocalType(params[i]))) reserving only 2
        // bytes for that slot while every expression-level access read/
        // wrote 4 -- a real adjacent-slot-corruption bug, caught by this
        // task's own callback.cla golden (`n: word` at 8(A6) size 2
        // reading via a bare 4-byte MOVE.L, bleeding into the next
        // param's own 2-byte slot). Returning 4 makes the frame
        // RESERVATION match what every consumer already assumes -- the
        // pascal glue's own wire-width table (cgCbPascalWidth, cg68k.cla)
        // is intentionally independent of cgSizeOf/cgSlotSizeOf and keeps
        // the true 2-byte wire width for the marshaling boundary itself.
        return 4
    }
    case KStr {
        return cgAlignUp(irtN(t) + 1, 2)
    }
    case KArr {
        return irtN(t) * cgArrElemStride(irtElem(t))
    }
    case KRec {
        return cgRecordSize(irtName(t))
    }
    case KErr {
        // Task 14.7: `error` is a builtin fixed-layout struct, NOT a
        // 4-byte scalar/handle -- cprint.cla's own C typedef
        // (`typedef struct { int32_t code; clar_str_255 message; }
        // clar_rec_Err;`, cprint.cla:5630) is the layout authority: code
        // (int32, 4 bytes) at offset 0, message (str255, 256 bytes) at
        // offset 4, no padding between them (4 is already even). Lumping
        // KErr into the plain-4-bytes case above (pre-Task-14.7) silently
        // under-reserved every `var e: error` local/field to 4 bytes,
        // corrupting whatever sat past it the moment `.message` was
        // written -- see cgErrMsgOff's own doc comment for the matching
        // cgFieldRefAddr fix.
        return cgErrMsgOff() + cgAlignUp(255 + 1, 2)
    }
    }
    return 4
}

// cgErrMsgOff is the `error` (KErr) struct's `message` field offset (its
// only non-zero one -- `code` sits at offset 0) -- a single authority
// cgSizeOf(KErr)/cgFieldRefAddr/cgDefaultInitAt's KErr arm all read,
// instead of repeating the literal `4` three times.
func cgErrMsgOff(): int {
    return 4
}

// cgAlignOf follows directly from cgSizeOf: anything that occupies 2+
// bytes needs to start on an even address; a bare 1-byte scalar (before
// cgSlotSizeOf's padding) needs none.
func cgAlignOf(t: int): int {
    if cgSizeOf(t) >= 2 {
        return 2
    }
    return 1
}

// cgSlotSizeOf is the padded size a type occupies as a frame local, frame
// param, GLOBAL, or window-state slot (cgUiStateFieldOffset/
// cgIntrUiStateDefaults's own walk -- a window's per-instance vars are
// never an irRecords entry, so they are NOT record fields; see
// cgRecFieldSizeOf below for the actual record-field authority) --
// identical to cgSizeOf except ANY odd size rounds up to even (task-6-
// review Critical 2 fix: was only a bare 1-byte bool/char special case,
// "occupying 2 in any aggregate or stack slot" -- too narrow once
// cgArrElemStride made a packed char array's own cgSizeOf odd-capable,
// e.g. char[3]/an odd-sized extern-record storage array). This is
// ALLOCATION granularity ONLY -- cgAssignFrameOffsets (~2991) and
// cgAssignGlobalOffsets (~1188) both build their running offset as a SUM
// of cgSlotSizeOf contributions, so rounding every contribution to even
// keeps every later slot's own base even too (frame LINK size and
// cgGlobalsBelowA5Size, both sums of the same contributions, stay even
// for free -- cgEmitStartup's word-oriented CLR.W zero loop, ~1294-1300,
// needs exactly that). cgSizeOf/cgArrElemStride themselves stay packed
// (byte-exact, no rounding) -- EXRecAddr's own literal field offsets,
// array indexing, zero-init byte counts, and cprint's byte-for-byte
// `clar_arr_char_N` parity all still want the TRUE unpadded size; only
// the outer RESERVATION width needs the even floor a 68000 address bus
// requires (an odd-based word/long access is a real address error on
// real hardware, masked -- not fixed -- by an emulator or by whatever
// happened to sit at the next byte on the host lane).
func cgSlotSizeOf(t: int): int {
    var sz: int

    sz = cgSizeOf(t)
    if sz mod 2 == 1 {
        return sz + 1
    }
    return sz
}

// cgArrElemStride (Task 6, toolbox-integration Feature B; joined by KBool
// in the small-scalar-width phase, 2026-08-05) is a KArr's own per-element
// byte spacing -- identical to cgSlotSizeOf EXCEPT for a char or bool
// element, which packs at exactly 1 byte, no padding, so cgSizeOf(KArr)/
// cgArrElemAddr/cgArrDefaultAt (the array's total size, per-element
// indexing, and zero-init stride, respectively) never drift out of sync.
//
// The bug Task 6 fixed (char only, at the time): before that task, all
// three read cgSlotSizeOf(elem) -- 2 bytes for a char element, the same
// padding a scalar local/param char gets. For an ordinary `char[N]` array
// that's merely wasteful (N*2 bytes reserved, only the N even-offset bytes
// ever touched by c[i] indexing, which used the SAME padded stride
// consistently). For extern-record storage it was actively WRONG: lower.
// cla's TyXRec case builds a record's whole storage as exactly
// `irArrType(irCharT, N)` (Task 4), and EXRecAddr's own literal field
// offsets (irXRecFieldOffset, the packing-table authority the spec's
// field-offset table anchors against) are computed assuming N TRULY
// CONTIGUOUS bytes -- matching cprint's C-lane `clar_arr_char_N`
// (`uint8_t e[N]`, no padding) byte-for-byte. Against the OLD padded
// scheme, a 16-byte EventRecord would have reserved 32 bytes, and the
// zero-init loop (stride 2) would have zeroed only the 16 EVEN-offset
// bytes of that 32-byte span -- every ODD real-record offset (the low byte
// of `what`, the low bytes of `message`/`when`, `where.h`'s low byte, ...)
// stayed uninitialized stack/BSS garbage, while EXRecAddr still addressed
// the record as if it were the true packed 16 bytes. bool joined the
// packed branch later (small-scalar-width phase) for the same reason,
// generalized: every aggregate -- record field OR array element -- now
// packs bool/char at 1 byte. cgSlotSizeOf itself is untouched by element
// spacing -- a bool/char SCALAR local/param still gets its own 2-byte
// slot; cgSlotSizeOf's own general odd-rounding (task-6-review Critical 2)
// separately keeps every ALLOCATION (frame/global slot width) even
// regardless of element kind, orthogonal to this function's job of keeping
// array-internal spacing packed.
func cgArrElemStride(elemT: int): int {
    var k: IRKind

    k = irtKind(elemT)
    if k == KChar or k == KBool {
        return 1
    }
    return cgSlotSizeOf(elemT)
}

// cgRecFieldSizeOf/cgRecFieldAlignOf: the record-field-ONLY layout
// authority for bool/char. As of the small-scalar-width phase
// (2026-08-05) a bool/char RECORD FIELD packs at exactly 1 byte/1-byte
// align -- no wider than cgArrElemStride's own array-element packing, and
// no longer diverging from it. A plain local/global/param/array-element
// bool/char is untouched by this pair and keeps cgSlotSizeOf/cgAlignOf's
// ordinary 2-byte-padded slot.
//
// Historical note: an earlier rule (Task 14 fix-round, native-5e) gave a
// bool/char record field a full 4-byte slot instead, to match a since-
// fixed C runtime bug -- rt_ui.c's RT_FT_BOOL descriptor arm did a raw
// `*(int32_t *)(rec + off)` read over what cg68k's OWN pre-fix layout only
// reserved 2 bytes for, so the read overran into the next field's bytes
// (the popuptable `favorite: bool` table-column regression). That runtime
// arm now reads/writes exactly 1 byte (rt_ui.c/rt_ser.inc, both lanes),
// so the widened-field workaround is gone; see
// `docs/superpowers/specs/2026-08-05-small-scalar-width-design.md` for
// the full rationale.
//
// ONLY cgFieldOffset/cgRecordSize (and every walk that must stay in lock-
// step with them: cgRecordCtorAt, cgEmitOneRcWalk) call these -- a plain
// local/global/param/array-element bool/char keeps cgSlotSizeOf/cgAlignOf
// unchanged.
func cgRecFieldSizeOf(t: int): int {
    var k: IRKind

    k = irtKind(t)
    if k == KBool or k == KChar {
        return 1
    }
    return cgSlotSizeOf(t)
}

func cgRecFieldAlignOf(t: int): int {
    var k: IRKind

    k = irtKind(t)
    if k == KBool or k == KChar {
        return 1
    }
    return cgAlignOf(t)
}

// cgAlignUp rounds n up to the next multiple of align (align is always 1
// or 2 here -- a plain even-check suffices).
func cgAlignUp(n: int, align: int): int {
    if align <= 1 {
        return n
    }
    if n mod 2 != 0 {
        return n + 1
    }
    return n
}

// cgRecIdxByName maps irRecordLayoutName(i) -> i, keyed by interned nameIdx
// directly (findings 1.4: index equality already implies string equality
// under the intern-pool invariant -- Global Constraints; shake.cla:99-105's
// shakeFuncIdxByName already relies on the same invariant). Built lazily
// (cgFindRecordByName's first call each run) rather than eagerly, and
// invalidated -- via cgRecIdxByNameValid, not left to go stale -- by
// cgResetCodegenState, called once per compile from BOTH driveCompile
// (backend-agnostic -- see cgResetCodegenState's own doc comment) and
// cg68Measure, so a name from a PRIOR compile in the same process can
// never misalign against this compile's different irRecords arena.
// First-wins on duplicate names, to match the scan it replaces.
var cgRecIdxByName: intmap of int
var cgRecIdxByNameValid: bool

// cgFindRecordByName answers by cgRecIdxByName (built on first call each
// run) -- serves both plain records and overlay records (isOverlay
// doesn't change which arena a layout lives in).
func cgFindRecordByName(nameIdx: int): int {
    var i: int
    var nm: int

    if not cgRecIdxByNameValid {
        i = 0
        while i < irRecords.count {
            nm = irRecordLayoutName(i)
            if cgRecIdxByName.get(nm, -1) == -1 {
                cgRecIdxByName[nm] = i
            }
            i = i + 1
        }
        cgRecIdxByNameValid = true
    }
    return cgRecIdxByName.get(nameIdx, -1)
}

// cgFieldOffset walks recName's field chain in declaration order, each
// field starting at its own cgRecFieldAlignOf-rounded offset and occupying
// cgRecFieldSizeOf bytes (the record-field authority -- bool/char pack at
// 1 byte here, same as an array element, unlike a bare local/param's
// cgSlotSizeOf-padded 2 bytes; see cgRecFieldSizeOf's own doc comment),
// returning fieldName's offset (or -1 if either name is unknown). Works
// identically for a plain record or an overlay record -- see the file
// header.
func cgFieldOffset(recName: int, fieldName: int): int {
    var ri: int
    var f: int
    var cur: int

    ri = cgFindRecordByName(recName)
    if ri == -1 {
        return -1
    }
    cur = 0
    f = irRecordLayoutFieldsHead(ri)
    while f != -1 {
        cur = cgAlignUp(cur, cgRecFieldAlignOf(irFieldSlotType(f)))
        if irFieldSlotName(f) == fieldName {
            return cur
        }
        cur = cur + cgRecFieldSizeOf(irFieldSlotType(f))
        f = irFieldSlotNext(f)
    }
    return -1
}

// cgRecordSize is cgFieldOffset's own layout walk, run to the end and
// rounded up to an even total -- cgSizeOf(KRec)'s implementation.
func cgRecordSize(nameIdx: int): int {
    var ri: int
    var f: int
    var cur: int

    ri = cgFindRecordByName(nameIdx)
    if ri == -1 {
        return 0
    }
    cur = 0
    f = irRecordLayoutFieldsHead(ri)
    while f != -1 {
        cur = cgAlignUp(cur, cgRecFieldAlignOf(irFieldSlotType(f)))
        cur = cur + cgRecFieldSizeOf(irFieldSlotType(f))
        f = irFieldSlotNext(f)
    }
    return cgAlignUp(cur, 2)
}

// cgKindName renders an IRKind as a short lowercase word, for readable
// frame/globals listing comments only (never consulted by layout math).
func cgKindName(k: IRKind): string {
    switch k {
    case KVoid { return "void" }
    case KInt { return "int" }
    case KBool { return "bool" }
    case KFixed { return "fixed" }
    case KChar { return "char" }
    case KStr { return "str" }
    case KText { return "text" }
    case KList { return "list" }
    case KMap { return "map" }
    case KSortedMap { return "sortedmap" }
    case KIntMap { return "intmap" }
    case KRec { return "rec" }
    case KEnum { return "enum" }
    case KArr { return "arr" }
    case KErr { return "err" }
    case KWinRef { return "winref" }
    case KUiState { return "uistate" }
    case KPtr { return "ptr" }
    case KOverlay { return "overlay" }
    case KWord { return "word" }
    }
    return "?"
}

// ================================================================
// JT slot assignment
// ================================================================

// cgJtSlot answers f's (irFuncs index) JT slot -- -1 if f was never
// reachable. Only meaningful AFTER cgAssignFinalJtSlots has run (post-
// packing); cgEmitFunc's own frame-comment call during the MEASURE pass
// reads whatever placeholder cg68Measure seeded cgJtSlots with (see that
// function's own doc comment -- the printed number is discarded along
// with the rest of the measure-pass stream, never written to a listing).
func cgJtSlot(f: int): int {
    return cgJtSlots[f]
}

// cgAssignMeasureFuncLabels gives every shakeReachable irFuncs entry a
// FRESH a68 label -- used only by cg68Measure's own throwaway stream
// (cgFuncLabels is rebuilt again, per real segment, by
// cgAssignSegFuncLabels below). Declaration order, matching every other
// "reserve before any body can reference it" pass in this file.
func cgAssignMeasureFuncLabels() {
    var i: int
    var labels: list of int

    labels = cgFreshIntList()
    i = 0
    while i < irFuncs.count {
        if shakeReachable(i) {
            labels.add(a68NewLabel())
        } else {
            labels.add(-1)
        }
        i = i + 1
    }
    cgFuncLabels = labels
}

// cgAssignSegFuncLabels rebuilds cgFuncLabels for segment s's own real
// emission pass: a fresh label for every reachable irFuncs entry ASSIGNED
// to segment s (cgFuncSegment, cgPackProgram's output), -1 for every
// other reachable entry (never dereferenced -- a call to a function in a
// DIFFERENT segment goes through cgJtSlots/the jump table, never through
// cgFuncLabels, so a -1 placeholder for an out-of-segment function is
// never read).
func cgAssignSegFuncLabels(s: int) {
    var i: int
    var labels: list of int

    labels = cgFreshIntList()
    i = 0
    while i < irFuncs.count {
        if shakeReachable(i) and cgFuncSegment[i] == s {
            labels.add(a68NewLabel())
        } else {
            labels.add(-1)
        }
        i = i + 1
    }
    cgFuncLabels = labels
}

// cgAssignFinalJtSlots numbers every reachable irFuncs entry's JT slot
// AFTER packing (cgFuncSegment must already be set) -- slot 0 is
// startup's; then segment 1's own packed functions (declaration order),
// then segment 2's, and so on, so each segment's own slot range is
// CONTIGUOUS (the CODE-N {firstEntryOffset, count} header's own
// requirement -- see this section's header comment). cgSegJtFirst[s-1]/
// cgSegJtCount[s-1] record each segment's own contiguous range for that
// header; cgTotalJtSlots is the grand total (1 + every reachable
// function).
var cgSegJtFirst: list of int
var cgSegJtCount: list of int

func cgAssignFinalJtSlots() {
    var slots: list of int
    var next: int
    var s: int
    var i: int
    var firstThis: int
    var countThis: int
    var segFirst: list of int
    var segCount: list of int

    slots = cgFreshIntList()
    i = 0
    while i < irFuncs.count {
        slots.add(-1)
        i = i + 1
    }

    segFirst = cgFreshIntList()
    segCount = cgFreshIntList()
    next = 0
    s = 1
    while s <= cgSegCount {
        firstThis = next
        countThis = 0
        if s == 1 {
            next = next + 1
            countThis = countThis + 1
        }
        i = 0
        while i < irFuncs.count {
            if shakeReachable(i) and cgFuncSegment[i] == s {
                slots[i] = next
                next = next + 1
                countThis = countThis + 1
            }
            i = i + 1
        }
        segFirst.add(firstThis)
        segCount.add(countThis)
        s = s + 1
    }

    cgJtSlots = slots
    cgSegJtFirst = segFirst
    cgSegJtCount = segCount
    cgTotalJtSlots = next
}

// cgJtDisp is the byte displacement from A5 of jump-table slot's own
// ENTRY POINT (the JT itself starts 32 bytes above A5, per app68k.cla's
// own CODE 0 layout; each entry is 8 bytes) -- a cross-segment call
// target.
//
// The +2 is load-bearing, and getting it wrong is what blocked Task 15's
// first attempt. BOTH forms of a classic 8-byte JT entry keep their FIRST
// WORD as data and their CODE at entry+2:
//
//   unloaded: offset.W | $3F3C ($3F3C = MOVE.W #segnum,-(SP)) | segnum.W | $A9F0 (_LoadSeg)
//   loaded:   segnum.W | $4EF9 ($4EF9 = JMP xxx.L)            | routine address.L
//
// _LoadSeg rewrites the entry in place from the first form to the second,
// and both are entered at +2 -- that is exactly why the segment number
// and the routine offset can share slot +0 across the two forms. So a
// cross-segment `JSR d16(A5)` must aim at 32 + 8*slot + 2; aiming at the
// entry start executes the offset/segnum WORD as an opcode. That is not a
// silent wrong answer, it is a bomb whose flavour depends on the numeric
// value of that word: an offset of $Fxxx raises F-line ("coprocessor not
// installed"), $Axxx raises A-line, most others "illegal instruction" --
// which is precisely the family of crashes Task 15's first attempt saw,
// and why they looked maddeningly unrelated to what the callee did.
func cgJtDisp(slot: int): int {
    return 32 + slot * 8 + 2
}

// cgCallFunc emits a call to reachable irFuncs index fi: a direct BSR.W
// (4 bytes, PC-relative -- valid because caller and callee code live in
// the SAME CODE resource, so their relative distance never changes no
// matter where the Segment Loader ends up placing that resource in
// memory) when fi's own assigned segment (cgFuncSegment, cgPackProgram's
// output) is the SAME as the segment currently being emitted
// (cgCurFuncSegment); a JSR through the jump table (JSR d16(A5) to fi's
// own JT slot, cgJtSlots/cgAssignFinalJtSlots) otherwise -- two
// independently `_LoadSeg`-loaded segments have no fixed relative
// offset to each other, so only the A5-relative jump table (fixed for
// the whole app's lifetime) can resolve a cross-segment call. See this
// section's own "FIXED-SIZE INVARIANT" header comment for why the
// MEASURE pass can call this exact function, unmodified, and get a
// correctly-sized (if not yet semantically final) result even though
// cgFuncSegment/cgCurFuncSegment haven't been assigned real values yet.
func cgCallFunc(fi: int) {
    if cgFuncSegment[fi] == cgCurFuncSegment {
        a68EmitBr(OpBsr, 0, cgFuncLabels[fi])
    } else {
        a68Emit(OpJsr, 0, AmNone, 0, 0, AmDisp16, 5, cgJtDisp(cgJtSlots[fi]))
    }
}

// cgFuncBailLabel (attempt-abort phase Task 4) lazily mints the CURRENT
// function's own bail label -- same idiom as this file's own
// cgMul32Label/cgDiv32Label ("allocate on first real use, remember
// after"), and REQUIRED here rather than merely convenient: see
// cgBailUsed's own doc comment for why an a68 label can never be
// allocated unless it is also going to be bound.
func cgFuncBailLabel(): int {
    if not cgBailUsed {
        cgBailUsed = true
        cgBailLbl = a68NewLabel()
    }
    return cgBailLbl
}

// cgAbortTarget (attempt-abort phase Task 4, design doc %3.2 point 3)
// resolves "the current bail target": the innermost enclosing
// `attempt`'s own handler-entry label when cgBailDepth > 0 (pushed/
// popped by cgAttemptStmt around the body only, never the handler --
// exactly cprint's own fpAbortTarget/fpBailTargets discipline, restated
// with a68 label ids), else this function's own (lazily minted) bail
// label. Only ever called from a context that already knows
// cgCurFuncHasBail is true (cgCallFnScalar/cgCallFnInto/cgIntrAbort/
// cgAttemptStmt's own gates) -- the function-bail fallback always has a
// real chain to fall into.
func cgAbortTarget(): int {
    if cgBailDepth > 0 {
        return cgBailTargets[cgBailDepth - 1]
    }
    return cgFuncBailLabel()
}

// cgEmitAbortCheck (attempt-abort phase Task 4, design doc %3.3: "~6-10
// bytes per checked call site") prints the one check every checked call
// site shares: `TST.B <flag>` + `BNE <target>`. Reads cgAbortFlagOff
// directly (not an EVarRef -- the flag has no IR node, same as
// cprint.cla's `clar_aborting`) via A5-relative addressing, same as any
// ordinary global.
//
// attempt-abort phase Task 5 fix (task-1-report P5 probe (b), mirrors
// cprint.cla's fpEmitAbortCheck fix): a pending statement-scoped tracked
// temp (cgStmtTmpOffs/cgStmtTmpType -- cgNewTrackedTmp's own scratch-pool
// slots, born earlier in the SAME statement, e.g. `x = makeText() + f()`'s
// `makeText()` result, still un-consumed when `f()` aborts) is invisible
// to the callee's bail block (named scope-exit locals only) AND never
// reaches the ordinary end-of-statement cgFreeStmtTmps() flush (the
// BNE/BRA abandons the rest of the statement outright). When
// cgStmtTmpOffs is non-empty at the check point, widen the plain
// TST/BNE into TST/BEQ-skip + release-each-slot + BRA target + skip:, so
// every pending slot is released (via cgReleaseAt, cgFreeStmtTmps' own
// per-slot call) before jumping away -- non-destructively: the tracking
// lists are NOT cleared, so the real cgFreeStmtTmps() still runs, once,
// on the non-aborting fallthrough. A just-tracked call result that is
// itself the abort source is naturally a null/zero handle (the callee's
// own bail returns 0 -- cgReleaseAt on a null handle is the same
// proven-safe no-op the C lane relies on), so no exclusion is needed. The
// common case (no pending temps -- one call per statement, the vast
// majority) is byte-identical to before: still the bare TST.B/BNE pair.
func cgEmitAbortCheck() {
    var target: int
    var skipLbl: int
    var i: int

    target = cgAbortTarget()
    a68Emit(OpTst, 1, AmNone, 0, 0, AmDisp16, 5, cgAbortFlagOff)
    if cgStmtTmpOffs.count == 0 {
        a68EmitBr(OpBcc, 6, target) // BNE: aborting -> bail/handler target
        return
    }
    skipLbl = a68NewLabel()
    a68EmitBr(OpBcc, 7, skipLbl) // BEQ: not aborting -> skip release+branch
    i = 0
    while i < cgStmtTmpOffs.count {
        cgReleaseAt(6, cgStmtTmpOffs[i], cgStmtTmpType[i])
        i = i + 1
    }
    a68EmitBr(OpBra, 0, target)
    a68Bind(skipLbl)
}

// ================================================================
// Globals / A5
// ================================================================

func cgAssignGlobalOffsets() {
    var i: int
    var offs: list of int
    var running: int

    offs = cgFreshIntList()
    cgGlobalOffByName.clear()
    running = 0
    i = 0
    while i < irGlobals.count {
        running = running - cgSlotSizeOf(irGlobalType(i))
        offs.add(running)
        cgGlobalOffByName[irGlobalName(i)] = running
        i = i + 1
    }
    cgGlobalOffsets = offs

    // Task 12 (native-5e): one extra below-A5 cell for the closeRequest
    // scratch pointer (cgUiCurCancelOff -- cprint's own file-scope
    // `static long *clar_ui_cur_cancel;`) -- reserved unconditionally for
    // any UI program (cheap; a program with no closeRequest handler at
    // all just never reads or writes it), zeroed for free by the
    // startup zero-loop's own below-A5 sweep (cgEmitStartup) exactly like
    // every ordinary irGlobals cell.
    if irIsUiProgram() {
        running = running - 4
        cgUiCurCancelOff = running
    } else {
        cgUiCurCancelOff = 0
    }

    // attempt-abort phase Task 4 (design doc %3.2/%3.4): the abort flag
    // + message globals, reserved ONLY when this program actually uses
    // the feature -- a no-feature program reserves zero extra below-A5
    // bytes here, keeping its output byte-identical to today's. 2 bytes
    // for the flag (padded, same cgSlotSizeOf-style even-rounding every
    // other contribution here already follows) + 256 for the Str255
    // message (already even).
    if lowUsesAbort {
        running = running - 2
        cgAbortFlagOff = running
        running = running - 256
        cgAbortMsgOff = running
    } else {
        cgAbortFlagOff = 0
        cgAbortMsgOff = 0
    }
    cgGlobalsBelowA5Size = 0 - running
}

// cgEmitGlobalsComment prints the A5 assignment scheme into the listing
// (documentation only -- the golden pins it, nothing reads it back).
func cgEmitGlobalsComment() {
    var i: int
    var t: int

    if irGlobals.count == 0 {
        if a68ListingOn {
            a68Comment("globals: none")
        } else {
            a68CommentMarker()
        }
        return
    }
    if a68ListingOn {
        a68Comment("globals (below A5, " + numToStr(cgGlobalsBelowA5Size) + " bytes total):")
    } else {
        a68CommentMarker()
    }
    i = 0
    while i < irGlobals.count {
        t = irGlobalType(i)
        if a68ListingOn {
            a68Comment("  " + poolGet(irGlobalName(i)) + " : " + numToStr(cgGlobalOffsets[i]) + "(A5)  size " + numToStr(cgSizeOf(t)) + "  type " + cgKindName(irtKind(t)))
        } else {
            a68CommentMarker()
        }
        i = i + 1
    }
}

// ================================================================
// Startup
// ================================================================

// cgEmitStartupCallIfPresent JSRs name's JT-slot label if has is set AND
// the program actually defines (and reached) a function by that name --
// otherwise it leaves a comment explaining the gap rather than JSRing to
// nothing. Mirrors the same "by-name via JT, comment if absent" contract
// the brief specifies for the natQuit call below.
func cgEmitStartupCallIfPresent(name: string, has: bool) {
    var fi: int

    if not has {
        return
    }
    fi = findIRFuncIdxByName(intern(name))
    if fi == -1 or not shakeReachable(fi) {
        if a68ListingOn {
            a68Comment(name + " not found -- startup handler wiring incomplete")
        } else {
            a68CommentMarker()
        }
        return
    }
    cgCallFunc(fi)
}

// cgToolboxHeadroom (native-gaps-cleanup Task 4) is the fixed extra
// reserve cgStackHeuristic adds on top of the deepest TRACED Clarus call
// chain -- covering what the static call graph cannot trace at all:
// Toolbox trap dispatch inside the ROM itself, and any callback/
// function-value indirect call (a `callback func`'s own glue is reached
// via shake.cla's ECbAddr arm, which roots the callback's body but does
// NOT record a caller->callee edge INTO it the way an ordinary ECallFn
// does -- see shakeEdgesFrom/shakeEdgesTo's own doc comment -- so a
// callback's own callee chain is invisible to cgHeurLongest below).
const cgToolboxHeadroom: int = 8192

// cgHeurCallOverhead is the fixed per-call frame cost cgStackHeuristic
// adds on top of each function's own cgFuncFrameSizes weight: 4 bytes
// return address (the caller's JSR/BSR push) + 4 bytes saved A6 (the
// callee's own LINK) -- frameSize itself already counts everything
// BELOW A6 (locals + the fixed cgTmpSlots/cgBigTmpSlots/cgDeepLevels
// pools), so this is the only per-call cost frameSize doesn't already
// include.
const cgHeurCallOverhead: int = 8

// cgHeurState[i]/cgHeurMemo[i] -- memoized-DFS scratch for
// cgHeurLongest's longest-path walk over the shake-recorded call graph.
// 0 unvisited, 1 in progress (ON the current DFS stack -- a gray marker,
// so a back edge closing a cycle is DETECTED rather than recursed into
// forever), 2 done (cgHeurMemo holds the final answer). Freshly rebuilt
// by every cgStackHeuristic call.
var cgHeurState: list of int
var cgHeurMemo: list of int

// cgHeurLongest(i) returns the longest byte cost of any call chain
// STARTING at irFuncs index i: i's own weight (cgFuncFrameSizes[i] +
// cgHeurCallOverhead) plus the best of its callees' own longest chains.
// Cycle handling (spec: recursion "falls back toward the floor rather
// than inventing a bound"): a callee still gray (i reaches it via a back
// edge -- i.e. i is itself on that callee's own in-progress call chain)
// is skipped rather than recursed into, so a cycle contributes each
// participant's own frame AT MOST ONCE per path instead of looping
// forever; the edge is simply not followed, not specially bounded.
func cgHeurLongest(i: int): int {
    var best: int
    var edgeIdx: int
    var callee: int
    var v: int

    if cgHeurState[i] == 2 {
        return cgHeurMemo[i]
    }
    cgHeurState[i] = 1
    best = 0
    edgeIdx = cgAdjHead[i]
    while edgeIdx != -1 {
        callee = cgAdjTo[edgeIdx]
        if cgHeurState[callee] != 1 {
            v = cgHeurLongest(callee)
            if v > best { best = v }
        }
        edgeIdx = cgAdjNext[edgeIdx]
    }
    cgHeurState[i] = 2
    cgHeurMemo[i] = cgFuncFrameSizes[i] + cgHeurCallOverhead + best
    return cgHeurMemo[i]
}

// Adjacency index over shake's per-call-site edge lists (findings 1.3),
// built once per cgStackHeuristic call (cgBuildAdjacency) and consulted
// by cgHeurLongest above and cgBuildOnCycleTab below instead of either
// one rescanning shakeEdgeFrom/shakeEdgeTo O(E) per node:
// cgAdjHead[f] is f's first out-edge (an index into cgAdjTo/cgAdjNext)
// or -1; cgAdjNext[j] chains to the next edge sharing source j's caller,
// or -1 at the end of that chain; cgAdjTo[j] is edge j's callee.
// cgSelfEdge[f] is set alongside whenever a recorded call site is f -> f
// directly -- cgBuildOnCycleTab's SCC test alone can't see a size-1
// self-loop (a node trivially "reaches" its own SCC), so that pass
// consults this instead.
//
// Built by APPENDING each source's edges in ascending shake-edge-index
// order (cgAdjTail[f] tracks the current last link so a new edge can be
// spliced on the end in O(1)), not the more usual prepend-a-linked-list
// construction: cgHeurLongest's cycle handling ("a callee still gray is
// skipped rather than recursed into", see its own doc comment) is
// deliberately visitation-order-sensitive on a cyclic subgraph -- which
// back edge gets treated as "closing the cycle" and skipped depends on
// which callee is visited first -- so preserving the ORIGINAL scan order
// (shakeEdgeFrom(0..n-1), the same order the old O(V*(V+E)) rescan used)
// is required for byte-identical output, not just cosmetic. Confirmed by
// direct A/B: a prepend-ordered (reversed) build reproduces the exact
// same cgOnCycleTab set (SCC membership is order-invariant) but changes
// cgHeurLongest's chosen skip on at least one real cycle in
// clarusc/macgui.cla, which changed the final SetApplLimit immediate and
// broke the frozen-source byte-identity gate.
var cgAdjHead: list of int
var cgAdjNext: list of int
var cgAdjTo: list of int
var cgAdjTail: list of int
var cgSelfEdge: list of bool

func cgBuildAdjacency() {
    var i: int
    var n: int
    var from: int
    var e: int

    cgAdjHead = cgFreshIntList()
    cgAdjNext = cgFreshIntList()
    cgAdjTo = cgFreshIntList()
    cgAdjTail = cgFreshIntList()
    cgSelfEdge = cgFreshBoolList()
    i = 0
    while i < irFuncs.count {
        cgAdjHead.add(-1)
        cgAdjTail.add(-1)
        cgSelfEdge.add(false)
        i = i + 1
    }
    n = shakeEdgeCount()
    i = 0
    while i < n {
        from = shakeEdgeFrom(i)
        cgAdjTo.add(shakeEdgeTo(i))
        cgAdjNext.add(-1)
        e = cgAdjTo.count - 1
        if cgAdjHead[from] == -1 {
            cgAdjHead[from] = e
        } else {
            cgAdjNext[cgAdjTail[from]] = e
        }
        cgAdjTail[from] = e
        if shakeEdgeTo(i) == from {
            cgSelfEdge[from] = true
        }
        i = i + 1
    }
}

// cgOnCycleTab[f] is true iff irFuncs index f is on a cycle: mutually
// reachable with some other function via cgAdjHead/cgAdjNext/cgAdjTo
// (its SCC has size > 1), or it calls itself directly (cgSelfEdge[f], an
// SCC of size 1 with a self-loop). Filled once per cgStackHeuristic call
// by cgBuildOnCycleTab, replacing the old cgHeurOnCycle's O(V) whole-
// edge-list BFS PER NODE (O(V*(V+E)) overall) with one O(V+E) pass.
var cgOnCycleTab: list of bool

// cgBuildOnCycleTab fills cgOnCycleTab with one iterative Tarjan SCC
// pass over the adjacency index. Iterative -- explicit list-of-int
// stacks, NOT recursion -- because this backend also runs natively on a
// real 68k Mac (>=8KB frames) compiling itself, where the call graph can
// run ~1,600 deep; a recursive walk at that depth would blow the stack.
//
// callNode[k]/callEdge[k] (parallel lists) together are one explicit
// call frame: callNode[k] is the function being explored, callEdge[k]
// is the NEXT out-edge (a cgAdjTo/cgAdjNext index, -1 when exhausted)
// still to visit for it. Recursing into a callee is pushing a new frame
// on top; "returning" is popping it. callEdge[k] is advanced in place
// (list-index assignment doubles as the saved resume point) every time
// an edge is consumed, so popping back to a parent frame always resumes
// exactly where that parent left off -- the same "explicit stack stands
// in for the return address" trick any iterative DFS uses. idx/low are
// Tarjan's usual discovery-index/lowlink tables; sccStack is Tarjan's
// own "still might join a later SCC" stack (distinct from the
// callNode/callEdge exploration stack).
func cgBuildOnCycleTab() {
    var n: int
    var v: int
    var idx: list of int
    var low: list of int
    var onStack: list of bool
    var sccStack: list of int
    var callNode: list of int
    var callEdge: list of int
    var nextIndex: int
    var node: int
    var edgeIdx: int
    var w: int
    var recursed: bool
    var parent: int
    var comp: list of int
    var top: int
    var k: int
    var junk: int

    n = irFuncs.count
    idx = cgFreshIntList()
    low = cgFreshIntList()
    onStack = cgFreshBoolList()
    cgOnCycleTab = cgFreshBoolList()
    v = 0
    while v < n {
        idx.add(-1)
        low.add(0)
        onStack.add(false)
        cgOnCycleTab.add(false)
        v = v + 1
    }

    sccStack = cgFreshIntList()
    callNode = cgFreshIntList()
    callEdge = cgFreshIntList()
    nextIndex = 0

    v = 0
    while v < n {
        if idx[v] == -1 {
            idx[v] = nextIndex
            low[v] = nextIndex
            nextIndex = nextIndex + 1
            sccStack.add(v)
            onStack[v] = true
            callNode.add(v)
            callEdge.add(cgAdjHead[v])

            while callNode.count > 0 {
                node = callNode[callNode.count - 1]
                edgeIdx = callEdge[callEdge.count - 1]
                recursed = false
                while edgeIdx != -1 {
                    w = cgAdjTo[edgeIdx]
                    if idx[w] == -1 {
                        callEdge[callEdge.count - 1] = cgAdjNext[edgeIdx]
                        idx[w] = nextIndex
                        low[w] = nextIndex
                        nextIndex = nextIndex + 1
                        sccStack.add(w)
                        onStack[w] = true
                        callNode.add(w)
                        callEdge.add(cgAdjHead[w])
                        recursed = true
                        edgeIdx = -1
                    } else {
                        if onStack[w] and idx[w] < low[node] {
                            low[node] = idx[w]
                        }
                        edgeIdx = cgAdjNext[edgeIdx]
                        callEdge[callEdge.count - 1] = edgeIdx
                    }
                }
                if not recursed {
                    junk = callNode.pop()
                    junk = callEdge.pop()
                    if callNode.count > 0 {
                        parent = callNode[callNode.count - 1]
                        if low[node] < low[parent] {
                            low[parent] = low[node]
                        }
                    }
                    if low[node] == idx[node] {
                        comp = cgFreshIntList()
                        top = sccStack.pop()
                        onStack[top] = false
                        comp.add(top)
                        while top != node {
                            top = sccStack.pop()
                            onStack[top] = false
                            comp.add(top)
                        }
                        if comp.count > 1 {
                            k = 0
                            while k < comp.count {
                                cgOnCycleTab[comp[k]] = true
                                k = k + 1
                            }
                        } else if cgSelfEdge[node] {
                            cgOnCycleTab[node] = true
                        }
                    }
                }
            }
        }
        v = v + 1
    }
}

// cgNameHasPrefix is a plain per-character prefix test -- the language has
// no substring/startsWith primitive, and cgSeveredFamily below needs two
// different prefixes (the existing hand-unrolled `nat` test in
// cg68AddRoots predates this helper and is left alone).
func cgNameHasPrefix(nm: string, pre: string): bool {
    var i: int

    if nm.length < pre.length {
        return false
    }
    i = 0
    while i < pre.length {
        if nm[i] != pre[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// cgSeveredFamily classifies irFuncs name `nm` as the TARGET of a call
// the shake call graph cannot see -- an ECallExt-mediated call: 1 for the
// reverse-waist dispatcher family (UI + connection), 2 for the `nat*`
// native-helper family, 0 for anything else. shake.cla's own ECallExt arm
// walks the argument list and stops ("`external func` -- resolves
// straight to rt_ext_NAME, never an irFuncs entry"), which is true on the
// C lane but NOT on this one: cgCallExt resolves both of these families
// back to a real, called Clarus IRFunc, and neither produces a
// shakeEdgesFrom/To entry --
//   - family 1, the reverse-waist dispatchers (cgCallExtUiSynth /
//     lower.cla's lowUiSynthExternName): every `clar_ui_fire_*` function,
//     the ONLY route from the runtime's own event loop into a user `on`
//     handler (and from there into `open`/`edit`, i.e. straight back down
//     into the runtime again) -- PLUS, as of serial-connection phase Task
//     6, every `clar_conn_fire_*` function, conn.cla's rtConnPump's own
//     identically-shaped route into a user `on <var>.<event>` handler
//     (lower.cla's lowSynthConnDispatchers, Task 5). Both sub-families are
//     built via newIRFunc directly (never lowFuncBody), so both need the
//     SAME two downstream treatments this classification feeds: the
//     %3.5 in-place abort default (cgCurFuncIsUiDispatcher, below) and
//     the stack-depth heuristic's severed-family term (cgHeurLongest's
//     sevExtra, ~cgSeveredFamily's own callers) -- an abort raised inside
//     a connection handler needs the identical in-place default a UI
//     handler's own abort already gets.
//   - family 2, the `nat*` native helpers (cgCallExtNatFallback), which
//     every file/console/Toolbox-adjacent extern lands on.
// Both families are kept REACHABLE by cg68AddRoots' name-based roots (the
// `nat*` family) or their own self-registered shakeAddRoot call (every
// `clar_ui_fire_*`/`clar_conn_fire_*` dispatcher roots itself the moment
// lower.cla synthesizes it -- see lowSynthConnDispatchers' own doc
// comment), so they are emitted correctly -- but a root is not an edge,
// so cgHeurLongest sees them as the starts of their own disconnected
// fragments instead of as the continuation of whatever chain called them.
// Same name-prefix conventions cg68AddRoots and lowUiSynthExternName
// already establish; matching by prefix rather than re-deriving the
// extern->target mapping keeps this a read-only audit of irFuncs, with no
// second copy of cgCallExt's dispatch to drift out of sync. The `nat`
// test is a bare 3-character prefix, so a USER function named e.g.
// `natter` is classified as family 2 as well -- harmless: the only effect
// is a slightly larger stack reserve, the safe direction.
func cgSeveredFamily(nm: string): int {
    if cgNameHasPrefix(nm, "clar_ui_fire_") {
        return 1
    }
    if cgNameHasPrefix(nm, "clar_conn_fire_") {
        return 1
    }
    if cgNameHasPrefix(nm, "nat") {
        return 2
    }
    return 0
}

// cgStackHeuristic (native-gaps-cleanup Task 4) computes the native
// startup's SetApplLimit stack-reserve immediate. An explicit `stack: N`
// app field (checker/lower already validated 4096..1048576) wins
// outright -- no max() against the heuristic. Otherwise: four terms
// summed, then floored at 32768 and even-rounded:
//
//   1. `best` -- the post-shake call graph's deepest acyclic-collapsed
//      chain of summed frame sizes (cgHeurLongest, over every reachable
//      function as a possible chain start).
//   2. `cycleExtra` -- a one-time top-up (cgOnCycleTab, computed by
//      cgBuildOnCycleTab) for any function that can reach itself again:
//      cgHeurLongest's own cycle handling
//      (stopping at a back edge rather than looping forever) prices only
//      ONE pass through a cyclic region, undercounting a program that
//      genuinely re-enters it before the first pass unwinds. Pricing
//      every cycle participant's frame one extra flat time (not
//      per-path) is the cheapest bounded fix. 0 whenever the graph has no
//      cycle at all -- the toolbox suite composition below has none, so
//      this term measured 0 there; kept for the next program that does.
//      cgHeurLongest's own memo (cgHeurState/cgHeurMemo) is SHARED and
//      ORDER-DEPENDENT across the whole `best` loop below: once a node is
//      memoized (state 2), every later caller reuses that one cached
//      value regardless of which OTHER nodes happened to be gray (mid-DFS)
//      at the time it was computed -- on a multi-member cycle this can
//      genuinely make `best` undercount the true longest simple path
//      through the cycle (testdata/cg68k/mutrec.cla's own hand-computed
//      walk, task-4-report.md's fix-round appendix, demonstrates this on
//      a real 2-node cycle). `cycleExtra` is what makes that harmless
//      rather than a second heuristic bug: it unconditionally re-adds
//      EVERY on-cycle node's own weight once, and the memo's worst-case
//      shortfall on any single DFS path can itself be at most the sum of
//      the on-cycle nodes it under-credited -- a subset of that same sum.
//      So `best + cycleExtra` cannot undershoot the true longest simple
//      path even when the shared memo undercounts `best` alone; it can
//      only over-reserve (cycleExtra re-adds weight the memo actually did
//      capture correctly on that particular path too).
//   3. `cbExtra` -- the deepest reachable `callback func` body's own
//      cgHeurLongest, taken as a single MAX across all callback bodies,
//      not summed across them -- this models at most ONE Toolbox-invoked
//      callback being live at a time. A callback body (cg68SynthCbGlue's
//      cgCbGlueBodyFuncIdx) is rooted via shakeAddRoot, not reached by any
//      shake EDGE FROM shakeAddRoot's own registration (the Toolbox/ROM
//      invokes it directly -- LDEF redraw, scrollbar action -- while some
//      ENTIRELY DIFFERENT Clarus chain is already live on the stack), so
//      `best` alone never adds a callback's own downstream depth on top
//      of whatever chain was running when the trap fired UNLESS that same
//      callback body also happens to be called directly by name elsewhere
//      (an ordinary ECallFn edge into it) -- in that case `best` may
//      already include its subtree, and cbExtra re-adds it anyway
//      (over-reserving; the safe direction, not a second undercount).
//      Known gap: a callback whose OWN body triggers a second, DISTINCT
//      callback (genuinely nested Toolbox dispatch, not just this one
//      body's own downstream) would still be undercounted -- cbExtra has
//      no way to detect or sum across simultaneously-live callbacks; no
//      such nesting exists anywhere in this repo's runtime/test corpus
//      today (only rtUiScrollbarAction/rtUiLdefDraw exist as
//      cg68SynthCbGlue targets, and only one fires at a time in
//      practice). Diagnosed on Task 4's own Step 3 gate (the toolbox
//      suite composition): `best` alone (a 53546-byte deepest traced
//      chain) + cgToolboxHeadroom undershot the real native boot's need
//      (hung -- see task-4-report.md for the bisection: passed at
//      stack:65000, still hung at the heuristic's pre-fix 61738);
//      rtUiLdefDraw's own reachable chain (10806 bytes) was the missing
//      piece. cgToolboxHeadroom itself stays a flat constant for what's
//      IRREDUCIBLY untraceable (ROM-internal trap dispatch overhead);
//      cbExtra covers the traceable-but-disconnected part properly
//      instead of folding it into a bigger guessed headroom constant.
//   4. `sevExtra` -- the SAME treatment for the OTHER disconnected-entry
//      families, added by mac-resident-clarusc Task 15: the deepest
//      cgHeurLongest over every reachable ECallExt-reached target
//      (cgSeveredFamily above), taken as a MAX WITHIN each family and
//      SUMMED ACROSS the two. The cross-family sum is not caution, it is
//      required: the two families genuinely COMPOSE on one stack, and
//      examples/texteditor.cla does it on every Save/Open --
//      clar_ui_fire_menu/clar_ui_fire_launchdoc -> the user's own handler
//      -> file.writeText/file.readText/askOpen ->
//      nat_SerFileWriteData/nat_SerFileReadTextInto/nat_UiSFGetFile: two
//      severed edges nested on one chain. A MAX across families
//      under-prices exactly that, which is the same failure class this
//      term exists to fix. WITHIN a family the MAX is sound: a `nat*`
//      body reaches other `nat*` bodies through ordinary ECallFn edges
//      cgHeurLongest already follows (nothing is severed there), and
//      dispatcher-inside-dispatcher is plain UI re-entrancy, which is
//      unbounded and is called out as uncovered below rather than
//      pretended away. Without this term the model was silently pricing
//      only ONE SIDE of the reverse waist: on the toolbox-suite
//      composition `best`'s own argmax was `clar_ui_fire_widget` itself
//      (measured: best=195410, cbExtra=41646, cycleExtra=0 -> 245248
//      reserve), i.e. the whole runtime prefix that CALLS the dispatcher
//      (rtUiRun -> event dispatch -> UiFireWidget) was charged at zero,
//      even though at runtime it is unmistakably below the dispatcher on
//      the same stack. That left the model with no margin at all: a real
//      boot needed between 245248 and 247296 bytes (bisected on hardware,
//      see task-15-report.md), i.e. the shipped number was short by under
//      ONE 8.3KB Clarus frame, and the deepest chain in the whole suite
//      -- a modal form's per-keystroke rtUiTeMutated -> rtUiFieldCap ->
//      uidesc.cla accessor walk -- ran off the end of the reserve into
//      the application heap. The visible symptom was NOT a crash but a
//      quiet wrong answer (rtUiFieldCap read a garbage field cap, so
//      typing into a bound form field kept only the first character), and
//      instrumenting that chain with a log() call -- one more frame --
//      turned it into a hang instead. Charging every side of the waist
//      restores real margin.
//      Known limitation, deliberately not modelled: a re-entrant UI
//      (event loop -> handler -> modal loop -> handler -> ...) has no
//      static depth bound at all, so no term here can bound a program
//      that genuinely nests dispatches; two DISTINCT `nat*` chains live
//      at once is the same unbounded case (it needs a re-entering
//      dispatcher between them). `stack: N` stays the escape hatch for a
//      program that outgrows this model.
func cgStackHeuristic(): int {
    var i: int
    var best: int
    var v: int
    var cycleExtra: int
    var cbExtra: int
    var sevExtra: int
    var sevUi: int
    var sevNat: int
    var fam: int
    var result: int

    if irAppStack != -1 {
        return irAppStack
    }

    // cg68Measure's own throwaway pass (cgRecMode == 2 at its
    // cgEmitStartup call, cg68k.cla ~10802) runs with cgFuncFrameSizes
    // still all zero (cgEmitFunc hasn't run yet -- see that call site's
    // own comment) and a fixed-size-only ADDA that never gets peepholed,
    // so the real computation below is provably dead work there: every
    // path is bounded by cgToolboxHeadroom (8192) plus at most ~1,600 *
    // cgHeurCallOverhead (8) of zero-frame call overhead, well under the
    // 32768 floor the full computation would clamp to anyway. Return
    // that exact floor directly and skip building the adjacency index +
    // SCC pass entirely (findings 1.3) -- cgEmitStartup's real,
    // non-measure call (cgRecMode == 0) is the only one whose result
    // reaches a real ADDA immediate.
    if cgRecMode == 2 {
        return 32768
    }

    cgBuildAdjacency()
    cgBuildOnCycleTab()

    cgHeurState = cgFreshIntList()
    cgHeurMemo = cgFreshIntList()
    i = 0
    while i < irFuncs.count {
        cgHeurState.add(0)
        cgHeurMemo.add(0)
        i = i + 1
    }

    best = 0
    i = 0
    while i < irFuncs.count {
        if shakeReachable(i) {
            v = cgHeurLongest(i)
            if v > best { best = v }
        }
        i = i + 1
    }

    cycleExtra = 0
    i = 0
    while i < irFuncs.count {
        if shakeReachable(i) and cgOnCycleTab[i] {
            cycleExtra = cycleExtra + cgFuncFrameSizes[i] + cgHeurCallOverhead
        }
        i = i + 1
    }

    cbExtra = 0
    i = 0
    while i < cgCbGlueBodyFuncIdx.count {
        if shakeReachable(cgCbGlueBodyFuncIdx[i]) {
            v = cgHeurLongest(cgCbGlueBodyFuncIdx[i])
            if v > cbExtra { cbExtra = v }
        }
        i = i + 1
    }

    sevUi = 0
    sevNat = 0
    i = 0
    while i < irFuncs.count {
        if shakeReachable(i) {
            fam = cgSeveredFamily(poolGet(irFuncName(i)))
            if fam != 0 {
                v = cgHeurLongest(i)
                if fam == 1 and v > sevUi {
                    sevUi = v
                }
                if fam == 2 and v > sevNat {
                    sevNat = v
                }
            }
        }
        i = i + 1
    }
    sevExtra = sevUi + sevNat

    result = best + cycleExtra + cbExtra + sevExtra + cgToolboxHeadroom
    if result mod 2 != 0 {
        result = result + 1
    }
    if result < 32768 {
        result = 32768
    }
    return result
}

// cgEmitStartup builds the synthesized startup routine -- JT slot 0, the
// first function in the stream. See the file header for the full shape;
// briefly: zero below-A5, seed _MaxApplZone/_MoreMasters, call the
// generated init-globals stub, JSR natInit, JSR every declared entry
// handler (no real event/arg marshaling yet), call the generated
// free-globals stub, push a 0 result and JSR natQuit by name (or note its
// absence and just RTS -- true only for a build that never links
// native.cla, which cg68Program never is).
//
// cg_init_globals BEFORE natInit (Task 12 fix -- Task 11 originally ran
// natInit first, "before anything else runs (including cg_init_globals)",
// back when cg_init_globals was a no-op stub). Now that cg_init_globals
// has a real body (Task 12), that order is UNSAFE: cg_init_globals
// default-inits EVERY irGlobal unconditionally, including native.cla's
// own bootstrap globals (natPb/natBuf/natDigits/natLogBuf/...) -- if
// natInit ran first and populated them with real allocated pointers,
// cg_init_globals's own zero-sweep would immediately stomp them back to
// NULL, corrupting the capture-file Param Block before the very first
// natAlert/natLog/natQuit call ever touches it (reproduced empirically:
// hello.cla booted to a silent, zero-byte capture with the old order).
// Swapping is safe: cg_init_globals's own body (default-init + Init-expr
// evaluation) never depends on the capture file being open, and
// natAlert/natLog both call natInit() themselves anyway (idempotent,
// natOpened-guarded) before writing anything, so nothing upstream of the
// first real write can be lost either way.
func cgEmitStartup(startupLbl: int, initGlobalsLbl: int, freeGlobalsLbl: int) {
    var zloopLbl: int
    var qi: int

    a68Bind(startupLbl)
    if a68ListingOn {
        a68Comment("startup (JT slot 0)")
    } else {
        a68CommentMarker()
    }
    cgEmitGlobalsComment()

    if cgGlobalsBelowA5Size > 0 {
        a68Emit(OpLea, 0, AmDisp16, 5, 0 - cgGlobalsBelowA5Size, AmAn, 0, 0)
        a68Emit(OpMove, 2, AmImm, 0, cgGlobalsBelowA5Size / 2 - 1, AmDn, 0, 0)
        zloopLbl = a68NewLabel()
        a68Bind(zloopLbl)
        a68Emit(OpClr, 2, AmNone, 0, 0, AmPostInc, 0, 0)
        a68Emit(OpDbra, 2, AmDn, 0, 0, AmPCLabel, 0, zloopLbl)
    } else {
        if a68ListingOn {
            a68Comment("no globals below A5 -- nothing to zero")
        } else {
            a68CommentMarker()
        }
    }

    // Reserve extra stack space BEFORE MaxApplZone (Task 14, native-5e):
    // the classic idiom -- read the current ApplLimit (GetApplLimit, a
    // low-memory global at absolute address $0130, the SAME "inline glue
    // reads a global, not a real trap dispatch" mechanism MemError uses
    // at $0220 -- Retro68's own MacMemory.h glues both this way), lower
    // it by cgStackHeuristic() bytes via a real SetApplLimit trap
    // (0xA02D -- #pragma parameter SetApplLimit(__A0) means the arg goes
    // DIRECTLY in A0, no stack push at all, unlike an ordinary `reg`
    // call), and only THEN grow the heap zone via MaxApplZone -- which,
    // with no preceding SetApplLimit call, grows right up to whatever the
    // stack pointer happens to be at THIS EXACT boot moment, leaving zero
    // headroom for the stack to grow later.
    //
    // Root cause this fixes (Task 14's own native gate): naive cg68k
    // codegen gives every function its own LINK frame sized for its own
    // locals/temps (a single str temp alone is 256 bytes), and a real
    // scripted UI event's own call chain (rtUiMenuDispatch -> UiFireMenu
    // -> the program's own handler -> further widget/text calls) stacks
    // several such frames -- observed on real hardware as a "stack
    // collision with heap" system error (Andrew, watching the emulator)
    // hanging smoke_menudemo/smoke_mandel (bigger, multi-segment real
    // programs; the small single-segment testdata/ui/*.cla fixtures
    // happened to stay shallow enough not to trip it, by luck rather than
    // by any actual margin). Task 14's own fix was a single hardcoded
    // 128KB constant (cgStartupStackReserve, retired by native-gaps-
    // cleanup Task 4); cgStackHeuristic replaces it with a per-program
    // computed value -- an explicit `stack:` app field, else the
    // post-shake call graph's own deepest chain plus fixed Toolbox
    // headroom, floored at 32768 -- see that function's own doc comment.
    a68Emit(OpMovea, 4, AmAbsW, 0, 0x0130, AmAn, 0, 0)
    a68Emit(OpAdda, 4, AmImm, 0, 0 - cgStackHeuristic(), AmAn, 0, 0)
    a68EmitTrap(0xA02D, "_SetApplLimit")

    a68EmitTrap(0xA063, "_MaxApplZone")
    a68EmitTrap(0xA036, "_MoreMasters")

    // Task 12: cg_init_globals runs BEFORE natInit -- see this function's
    // own doc comment above for why the Task 11 order (natInit first) is
    // no longer safe now that cg_init_globals has a real body.
    a68EmitBr(OpBsr, 0, initGlobalsLbl)

    // natInit opens the `out` capture file -- same "by-name via JT,
    // comment if absent" contract as natQuit's own tail call below, so a
    // program built without native.cla linked (never true for emit68k,
    // always true for the C target, which never reaches cg68Program at
    // all) degrades to a comment instead of an unresolved JSR.
    qi = findIRFuncIdxByName(intern("natInit"))
    if qi != -1 and shakeReachable(qi) {
        cgCallFunc(qi)
    } else {
        if a68ListingOn {
            a68Comment("natInit not present -- wired in Task 11")
        } else {
            a68CommentMarker()
        }
    }

    // Task 12 (native-5e): a UI program's startup mirrors cpEmitUiMain's
    // own ported call order exactly (clar_init_globals/rt_args_init are
    // cg_init_globals/natInit's own equivalents, already run above):
    // rtUiStartup, then App.launch if the program declares one (fires
    // BETWEEN startup and launch, same as cpEmitUiMain -- Ch7: startCLI
    // never fires on the Macintosh, so a UI program's own `on
    // App.startCLI` handler, if any, is simply never called, same as the
    // C lane), then rtUiLaunch, then rtUiRun. rtUiRun never returns (the
    // real event loop and the scripted interpreter both loop until
    // rtUiQuit -> UiRtQuit -> nat_UiRtQuit -> natQuit -> ExitToShell,
    // which itself never returns) -- the free-globals/natQuit/RTS tail
    // below is therefore dead code on this path, kept only so the
    // function has one uniform, simple structure rather than an early
    // return the assembler/measure pass would need to special-case.
    if irIsUiProgram() {
        if a68ListingOn {
            a68Comment("UI startup: rtUiStartup / [App.launch] / rtUiLaunch / rtUiRun")
        } else {
            a68CommentMarker()
        }
        cgEmitStartupCallIfPresent("rtUiStartup", true)
        cgEmitStartupCallIfPresent("handler_App_launch", irHasLaunch)
        // attempt-abort phase Task 4 (design doc %3.5; Ruling: native UI
        // top-level default is FULL-STRENGTH). This is the "other
        // synthesized entry that runs user code" the ruling calls out
        // beyond the per-dispatch checks (cgAbortCheckAfterCall) --
        // App.launch runs before rtUiRun's own event loop (which never
        // returns natively, unlike the C lane's own rtUiRun) ever starts,
        // so an uncaught abort here needs its own explicit check, gated
        // on irHasLaunch exactly like the non-UI branch below (nothing to
        // check if there's no App.launch handler at all).
        if lowUsesAbort and irHasLaunch {
            cgEmitAbortDefaultCheck(true)
        }
        cgEmitStartupCallIfPresent("rtUiLaunch", true)
        cgEmitStartupCallIfPresent("rtUiRun", true)
    } else {
        if a68ListingOn {
            a68Comment("entry-handler dispatch stub -- no event/arg marshaling yet (Task 11)")
        } else {
            a68CommentMarker()
        }
        cgEmitStartupCallIfPresent("handler_App_launch", irHasLaunch)
        // attempt-abort phase Task 4 (design doc %3.5): a check after
        // App.launch specifically, mirroring the C lane's own review-
        // driven fix (task-3 fix round 1, C1) -- an uncaught abort in
        // App.launch must not leak into startEmpty/startCLI/
        // openDocument's own dynamic scope.
        if lowUsesAbort and irHasLaunch {
            cgEmitAbortDefaultCheck(false)
        }
        cgEmitStartupCallIfPresent("handler_App_startEmpty", irHasStartEmpty)
        cgEmitStartupCallIfPresent("handler_App_startCLI", irHasStartCLI)
        cgEmitStartupCallIfPresent("handler_App_openDocument", irHasOpenDocument)
        // design doc %3.5's own non-UI default: one more check after the
        // rest of the entry-handler dispatch, before the free-globals/
        // quit tail -- byte-identical (in OBSERVABLE behavior, log+quit
        // 1) to today's hand-written `log(msg); quit 1`.
        if lowUsesAbort {
            cgEmitAbortDefaultCheck(false)
        }
    }

    a68EmitBr(OpBsr, 0, freeGlobalsLbl)
    a68Emit(OpClr, 4, AmNone, 0, 0, AmPreDec, 7, 0)

    qi = findIRFuncIdxByName(rnQuit)
    if qi != -1 and shakeReachable(qi) {
        cgCallFunc(qi)
    } else {
        if a68ListingOn {
            a68Comment("natQuit not present -- wired in Task 11")
        } else {
            a68CommentMarker()
        }
    }
    a68Emit(OpRts, 0, AmNone, 0, 0, AmNone, 0, 0)
}

// ================================================================
// Task 12: records/enums -- shared address-parametrized primitives.
//
// The three primitives below (cgDefaultInitAt/cgRetainAt/cgReleaseAt) all
// take the SAME (reg, off, t) address shape every other addressing helper
// in this file already uses (cgVarReg/cgVarOff's own reg=5/A5 or reg=6/A6
// convention, extended here to reg=0/A0 for a runtime-computed base --
// cgExprAddr's own postcondition already leaves an address in A0, so
// "reg=0, off=<field offset>" is simply "the address cgExprAddr just
// computed, plus a compile-time-constant displacement", no new addressing
// mode needed). This lets ONE recursive KRec/KArr walk implementation
// serve THREE callers that would otherwise each hand-roll the identical
// field-by-field traversal cgFieldOffset/cgRecordSize already establish:
// a record's own constructor (ENewRec, a KRec local's prologue default,
// a KRec global's default), its retain walk, and its release walk --
// mirroring cpDefaultInit/cpEmitRetain/cpEmitRelease's own three-mirrored-
// walks shape (cprint.cla), just parametrized on a machine address instead
// of a C lvalue expression string.
// ================================================================

// cgStoreImmAt writes the constant val into t's slot at off(reg) --
// MOVE.L/MOVE.B #val,off(reg) (byte for a 1-byte bool/char slot padded to
// a 2-byte cgSlotSizeOf home, same size rule cgStoreScalarVar/cgLoadVar
// already use). Used only for a DEFAULT value (always a compile-time
// constant -- IRFieldSlot.default, or 0 for every other default-init
// site); cgStoreD0At (below) is the sibling for a value already computed
// into D0.
func cgStoreImmAt(reg: int, off: int, t: int, val: int) {
    a68Emit(OpMove, 4, AmImm, 0, val, AmDn, 0, 0)
    cgStoreD0At(reg, off, t)
}

// cgStoreD0At writes D0 (already holding the value -- cgExpr's own
// postcondition) into t's slot at off(reg), byte or long per cgSizeOf(t)
// (mirrors cgStoreScalarVar's own size dispatch, generalized to an
// arbitrary reg/off rather than only cgVarReg(dst)/cgVarOff(dst)).
func cgStoreD0At(reg: int, off: int, t: int) {
    if cgSizeOf(t) == 1 {
        a68Emit(OpMove, 1, AmDn, 0, 0, AmDisp16, reg, off)
    } else {
        a68Emit(OpMove, 4, AmDn, 0, 0, AmDisp16, reg, off)
    }
}

// cgZeroBlockAtA0 clears size bytes starting at (A0), advancing -- the
// CLR.W-instead-of-copy sibling of cgBlockCopy (same unrolled-vs-DBRA-loop
// shape, same "size is always even" precondition cgBlockCopy's own doc
// comment establishes for every native size this backend produces).
func cgZeroBlockAtA0(size: int) {
    var words: int
    var i: int
    var loopLbl: int

    words = size / 2
    if words <= 8 {
        i = 0
        while i < words {
            a68Emit(OpClr, 2, AmNone, 0, 0, AmPostInc, 0, 0)
            i = i + 1
        }
    } else {
        a68Emit(OpMove, 2, AmImm, 0, words - 1, AmDn, 0, 0)
        loopLbl = a68NewLabel()
        a68Bind(loopLbl)
        a68Emit(OpClr, 2, AmNone, 0, 0, AmPostInc, 0, 0)
        a68Emit(OpDbra, 2, AmDn, 0, 0, AmPCLabel, 0, loopLbl)
    }
}

// cgZeroInitAt (memory-leak-fix Task 3) writes a plain whole-slot zero at
// off(reg) for an irLocalNoBirth local -- no birth call (rtTextNew/
// rtListNew/rtMapNew/.../cgRecordCtorAt), just cgSizeOf(t) bytes cleared.
// Reuses the exact LEA-then-cgZeroBlockAtA0 idiom cgDefaultInitStrAt's own
// no-default arm already uses just below (cgZeroBlockAtA0's own doc
// comment establishes the "size is always even" precondition this relies
// on -- cgSizeOf's own KRec case always ends in `cgAlignUp(cur, 2)`
// (cgRecordSize), and every other kind irLocalNoBirth is ever set for
// (KText/KList/KMap/KSortedMap/KIntMap is a flat 4-byte pointer slot; a
// rec-bearing KArr -- lowIsRecBearing recurses through KArr down to KRec,
// so a whole-array assignment of handle-bearing record elements CAN mint
// a KArr-typed nobirth temp in principle, cprint.cla:4865-4896's host-lane
// fix-round-1 comment spells out the exact shape -- is likewise always
// even: cgSizeOf's KArr case is N * cgArrElemStride(elem), and
// cgArrElemStride only drops below cgSlotSizeOf's even-rounding for a
// char/bool ELEMENT, never for the KRec (or nested KArr-of-KRec) element a
// rec-bearing array bottoms out at) is even, so the precondition always
// holds here; this kind list is NOT closed by codegen, only by what's
// reachable -- a rec-bearing KArr never actually reaches this function
// today because cgStmt's SAssign fail-closed guard (cg68k.cla:10831)
// aborts handle-bearing whole-array assignment before
// codegen ever mints the temp). Safe for both palettes: a pointer
// slot zeroed this way reads back as a NULL handle (identical bit pattern
// to cgStoreImmAt(reg, off, t, 0), just without the extra MOVE.L #0,D0
// hop), and a KRec slot zeroed this way is the same all-zero struct
// cpEmitFunc's own KRec nobirth arm produces on the host lane
// (cprint.cla:4879-4883, `(Type){0}`) -- correct because a nobirth local's
// own store site always release-then-overwrites (NULL-safe) before any
// read, so no path ever needs a birth-constructed value here.
func cgZeroInitAt(reg: int, off: int, t: int) {
    a68Emit(OpLea, 0, AmDisp16, reg, off, AmAn, 0, 0)
    cgZeroBlockAtA0(cgSizeOf(t))
}

// cgDefaultInitStrAt writes a str field/local/global's default at off(reg):
// a whole-slot zero (LEA off(reg),A0; zero cgSizeOf(t) bytes) when
// strDefaultIdx is -1 (mirrors cpDefaultInit's `(cpCType(t)){0}` -- every
// byte, not just the Pascal length byte, so a stale stack/heap byte can
// never leak into an unused tail), else a clamped rtStrStore copy from the
// literal pool entry (mirrors cpDefaultInit's KStr `rt_str_store` arm).
func cgDefaultInitStrAt(reg: int, off: int, t: int, strDefaultIdx: int) {
    var fi: int

    if strDefaultIdx == -1 {
        a68Emit(OpLea, 0, AmDisp16, reg, off, AmAn, 0, 0)
        cgZeroBlockAtA0(cgSizeOf(t))
        return
    }
    fi = findIRFuncIdxByName(rnStrStore)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: rtStrStore not found/reachable")
    }
    a68Emit(OpMove, 4, AmAn, 1, 0, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmDisp16, reg, off, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, irtN(t), AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmPCLabel, 0, cgPoolStrRef(strDefaultIdx), AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgCallFunc(fi)
    cgCleanupStack(12)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 1, 0)
}

// cgWalkStashBase/cgWalkRestoreBase protect a multi-field/multi-element
// reg=0 (A0-relative) walk against A0 DRIFT: any field/element whose own
// processing overwrites A0 (a str default's zero-loop, whose CLR.W (A0)+
// post-increment leaves A0 pointing PAST that field, not at it; a JSR --
// rtStrStore, a nested cg_retain_/cg_release_ call, any call at all under
// this backend's own "no callee-saved registers" convention) would
// otherwise corrupt every SUBSEQUENT field's own `off(A0)` computation,
// since off(A0) is relative to WHATEVER A0 currently holds, not to a
// fixed record/array base. This is a REAL, silent memory-corruption bug
// found while implementing the task-12-review fix (recs.cla's newly added
// `recsSum(new recsPerson)`: `recsPerson`'s FIRST field, `name: string(31)`
// with no default, has no explicit default so it zero-loops -- draining
// A0 past the field -- and is immediately followed by `age`/`status`/
// `home`, all of whose stores then land 32 bytes too far in, stomping
// into `home.city`'s own zeroed buffer and, for a >4-field or larger
// str-then-more-fields shape, potentially past the record's own end
// entirely). For reg=5/6 (A5/A6) this is a no-op: those two registers are
// NEVER used as scratch anywhere in this file, so nothing to protect.
//
// Fix: every reg=0 walk entry point (cgRecordCtorAt/cgArrDefaultAt/
// cgEmitOneRcWalk's two field loops, cgRetainAt/cgReleaseAt's own KArr
// element loops) stashes the CURRENT A0 into A1 once, at its own start
// (always correct: A0 is freshly set by whichever caller/outer-iteration
// invoked it, right before this call), then restores A0 FROM A1
// immediately before EACH field/element -- undoing whatever the PREVIOUS
// field/element left A0 pointing at. A1 is this file's own established
// "stable stash, never touched by cgExpr/cgExprAddr" register
// (cgConcatIntoTemp's precedent); a walk that recurses into a NESTED
// record (cgDefaultInitAt's KRec branch, cgRetainAt/cgReleaseAt's KRec
// branch) simply re-stashes its own A1 from the just-restored A0 at its
// own entry, so nesting composes correctly with no shared/global state.
//
// SECOND-ORDER BUG, FOUND VERIFYING THE FIRST FIX (re-review round 2):
// A1 itself is JUST a register -- it has no callee-saved protection
// either. Every JSR this backend ever emits while a reg=0 walk is live
// (cgDefaultInitStrAt's rtStrStore call for a str field's explicit
// default; cgEmitPtrRcCall's rtTextRetain/rtListRetain/rtMapRetain/etc.;
// cgEmitRecWalkCall's cg_retain_<Rec>/cg_release_<Rec> for a nested
// handle-bearing record field) can clobber A1 just as freely as A0 --
// proven empirically for cgEmitRecWalkCall specifically: a nested
// record's own cg_retain_/cg_release_ function runs ITS OWN
// cgWalkStashBase unconditionally, overwriting the CALLER's A1 with the
// callee's own base before ever returning. A record with a handle-bearing
// nested-record field that ISN'T its own last field (or a KArr of
// handle-bearing records, n>1 -- cgRetainAt/cgReleaseAt's own KArr loop)
// would then restore A0 from garbage for every field/element after that
// call. INVARIANT, now enforced at all three JSR sites above: A1's OWN
// value (this walk's base -- or garbage, if no reg=0 walk is live, which
// is harmless since nothing then reads it) is saved to the STACK
// (MOVE.L A1,-(A7)) immediately before ANY of those three JSRs and
// restored (MOVEA.L (A7)+,A1) immediately after -- unconditionally, not
// gated on reg==0, since the save/restore is a no-op-cost-aside 8 bytes
// regardless and doesn't need to know whether a walk is currently live.
// A0/D0/D1 are still fully at every callee's disposal, same as always --
// only A1 (THIS backend's one dedicated cross-call stash register) gets
// the stack-save treatment, and only at the exact 3 sites that can be
// reached from inside a reg=0 walk with more work still to do afterward.
func cgWalkStashBase(reg: int) {
    if reg == 0 {
        a68Emit(OpMovea, 4, AmAn, 0, 0, AmAn, 1, 0)
    }
}

func cgWalkRestoreBase(reg: int) {
    if reg == 0 {
        a68Emit(OpMovea, 4, AmAn, 1, 0, AmAn, 0, 0)
    }
}

// cgArrDefaultAt default-inits a KArr slot at off(reg): N copies of the
// element type, each at its own cgArrElemStride-spaced offset -- UNROLLED at
// compile time (N is always a compile-time constant, ir.cla's own KArr.n)
// rather than a runtime loop, so every recursive call below stays within
// this same simple (reg, constant-offset) addressing shape (mirrors
// lowNullValueAppend's own "unrolled at LOWER time" precedent for the
// identical per-index recursion, ARC fix-wave Task 2). An array element
// never carries its own named default (cpDefaultInit's KArr arm always
// recurses with scalarDefault=0/strDefault=-1) -- neither does this. A char
// element's stride is 1 (cgArrElemStride, Task 6), so this loop's N
// single-byte zero writes land at contiguous offsets off+0..off+N-1 -- no
// even-N precondition needed (unlike a word-oriented block zero), which
// matters for extern-record storage: an EXRecAddr field read/write
// addresses this SAME region via literal, unpadded byte offsets
// (irXRecFieldOffset), so every byte in that contiguous range must actually
// be zeroed, not just every other one.
func cgArrDefaultAt(reg: int, off: int, t: int) {
    var et: int
    var n: int
    var esz: int
    var i: int

    et = irtElem(t)
    n = irtN(t)
    esz = cgArrElemStride(et)
    cgWalkStashBase(reg)
    i = 0
    while i < n {
        cgWalkRestoreBase(reg)
        cgDefaultInitAt(reg, off + i * esz, et, 0, -1)
        i = i + 1
    }
}

// cgRecordCtorAt default-inits every field of the record named recNameIdx
// into off(reg), walking irRecordLayoutFieldsHead in declaration order
// exactly like cgFieldOffset/cgRecordSize's own layout walk (a third,
// deliberately independent re-walk -- same precedent those two already
// set for each other, now sharing the SAME cgRecFieldSizeOf/
// cgRecFieldAlignOf record-field authority so the offsets this walk writes
// into never drift from what cgFieldOffset/cgFieldRefAddr later read back
// through) -- each field's OWN default (IRFieldSlot.default/DefaultStr,
// already carrying the enum-first-member/explicit-`=`-default value
// lowRecordDecl computed) drives cgDefaultInitAt, mirroring cpDefaultInit's
// KRec arm (`clar_new_<Name>()`, whose C body is this same per-field
// default walk).
//
// A bool/char field's slot is exactly 1 byte (small-scalar-width phase,
// 2026-08-05) -- cgDefaultInitAt's own write (cgStoreImmAt) covers the
// whole slot, so no separate zeroing pass is needed here the way the old
// 4-byte-slot CLR.L was: there are no other bytes left to keep zero.
func cgRecordCtorAt(reg: int, off: int, recNameIdx: int) {
    var ri: int
    var f: int
    var cur: int
    var ft: int

    ri = cgFindRecordByName(recNameIdx)
    if ri == -1 {
        abort("cg68k: unknown record type " + poolGet(recNameIdx))
    }
    cgWalkStashBase(reg)
    cur = 0
    f = irRecordLayoutFieldsHead(ri)
    while f != -1 {
        ft = irFieldSlotType(f)
        cur = cgAlignUp(cur, cgRecFieldAlignOf(ft))
        cgWalkRestoreBase(reg)
        cgDefaultInitAt(reg, off + cur, ft, irFieldSlotDefault(f), irFieldSlotDefaultStr(f))
        cur = cur + cgRecFieldSizeOf(ft)
        f = irFieldSlotNext(f)
    }
}

// cgDefaultInitAt is cpDefaultInit's native counterpart: writes t's
// default value into off(reg) -- scalarDefault/strDefaultIdx are -1/0 (no
// override) for every local/global default-init call site, or a record
// field's OWN IRFieldSlot.default/DefaultStr when called from
// cgRecordCtorAt. KText/KList/KMap (container birth -- rtTextNew/etc) and
// KErr (the lastError-shaped builtin) are Task 13/Ch12 territory, same
// "leave a safe zero placeholder + comment" degrade this file already uses
// for every other not-yet-built shape (cgExpr's own EFieldRef/ENewRec
// fallback, cgIntr's default arm) -- NOT reached by this task's own
// fixtures (recs.cla/enums.cla/smoke.cla all stay scalar/str/record/enum
// only, per the report's documented scope decision).
func cgDefaultInitAt(reg: int, off: int, t: int, scalarDefault: int, strDefaultIdx: int) {
    var k: IRKind

    k = irtKind(t)
    if k == KInt or k == KBool or k == KFixed or k == KChar or k == KEnum {
        cgStoreImmAt(reg, off, t, scalarDefault)
    } else if k == KPtr or k == KWinRef or k == KOverlay {
        cgStoreImmAt(reg, off, t, 0)
    } else if k == KStr {
        cgDefaultInitStrAt(reg, off, t, strDefaultIdx)
    } else if k == KRec {
        cgRecordCtorAt(reg, off, irtName(t))
    } else if k == KArr {
        cgArrDefaultAt(reg, off, t)
    } else if k == KText {
        cgDefaultInitTextAt(reg, off, strDefaultIdx)
    } else if k == KList {
        cgEmitContainerBirthCall(rnListNew, cgSizeOf(irtElem(t)), reg, off)
    } else if k == KMap {
        cgEmitContainerBirthCall(rnMapNew, cgSizeOf(irtElem(t)), reg, off)
    } else if k == KSortedMap {
        cgEmitContainerBirthCall(rnSortedMapNew, cgSizeOf(irtElem(t)), reg, off)
    } else if k == KIntMap {
        cgEmitContainerBirthCall(rnIntMapNew, cgSizeOf(irtElem(t)), reg, off)
    } else if k == KErr {
        // Task 14.7: mirrors cpDefaultInit's own KErr arm (cprint.cla:
        // 3170-3172, `dst.code = 0; dst.message = (clar_str_255){0};`) --
        // code (int, offset 0) zeroed via cgStoreImmAt, message
        // (str(255), offset cgErrMsgOff()) zero-blocked via
        // cgDefaultInitStrAt's own no-default arm (strDefaultIdx=-1;
        // `error` has no explicit-field-default grammar, so -1 is the
        // only value this arm is ever called with). Pre-fix, KErr fell
        // into the final `else` below, which only zeroed 4 bytes --
        // leaving `message` (offset 4..259) as uninitialized stack
        // garbage.
        cgStoreImmAt(reg, off, irIntT, 0)
        cgDefaultInitStrAt(reg, off + cgErrMsgOff(), irStrType(255), -1)
    } else {
        // KUiState -- TODO, deferred: a safe NULL/zero placeholder,
        // matching every other "not built this task" degrade in this file.
        if a68ListingOn {
            a68Comment("TODO cgDefaultInitAt <kind " + numToStr(int(k)) + ">: unsupported this task")
        } else {
            a68CommentMarker()
        }
        cgStoreImmAt(reg, off, irIntT, 0)
    }
}

// cgDefaultInitTextAt mirrors cpDefaultInit's KText arm: dst = rtTextNew(),
// then (only when strDefaultIdx is a real pool entry -- a Text field/local
// CAN carry an explicit string default, ir.cla's own IRFieldSlot.
// DefaultStr) an rtTextStore clamped copy from the literal, same shape
// cgDefaultInitStrAt's own explicit-default arm already uses for KStr.
//
// Task 14 fix (native-5e gate, winvar.cla): `reg` itself -- not just A1 --
// must survive the rtTextNew() JSR below. This is a SHARPER version of the
// "SECOND-ORDER BUG" class cgWalkStashBase/cgWalkRestoreBase's own doc
// comment warns about (this file's Task-12-review fix, above): that fix's
// remedy (stash the walk's base into A1, save/restore A1 around a risky
// JSR) protects a value the CALLER still needs AFTER this function
// returns, but does nothing for a value THIS function itself needs AFTER
// its OWN internal call -- and `reg` can BE A0 (cgIntrUiStateDefaults' own
// reg=0 state-defaults walk), which rtTextNew's internal work (its own
// TextNewPtr/TextNewHandle reg-trap calls, cgCallExtReg's A0/A1 arg
// marshaling) is free to clobber like any other call under this backend's
// "no callee-saved registers" convention. An earlier draft of this fix
// saved/restored A1 around the call and left `cgStoreD0At(reg, off, ...)`
// unchanged: WRONG -- when reg==0, A1 was never the register that needed
// protecting, so the store still landed through stale A0 exactly as
// before, no observable change (confirmed the hard way: identical
// memWZErr -111 after that first fix). The real fix computes the
// destination ADDRESS once, up front, and carries it across the call ON
// THE STACK (survives any call unconditionally, unlike any register) --
// then stores D0 straight through it. A window-scoped `var log: text`
// with no initializer, constructed only via the fabricated-opened-handler
// state-defaults path, was the first native scenario to exercise this:
// pre-fix, the corrupted store left `log` as uninitialized heap garbage
// (nonzero, but not a real Handle), which the very first `.append()` then
// handed to SetHandleSize as a bogus handle, failing with a real memWZErr
// (-111, "not in this heap zone") -- misread by the ALSO-buggy plain-`reg`
// TextSetHandleSize declaration as if D0 held a 0/success code (see
// text.cla's own TextSetHandleSize doc comment for that SEPARATE, also
// fixed, bug); fixing either alone still panicked, only fixing both
// cleared the scenario.
func cgDefaultInitTextAt(reg: int, off: int, strDefaultIdx: int) {
    var newFi: int
    var storeFi: int

    newFi = findIRFuncIdxByName(rnTextNew)
    if newFi == -1 or not shakeReachable(newFi) {
        abort("cg68k: rtTextNew not found/reachable")
    }
    a68Emit(OpLea, 0, AmDisp16, reg, off, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgCallFunc(newFi)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmInd, 0, 0)
    if strDefaultIdx == -1 {
        return
    }
    storeFi = findIRFuncIdxByName(rnTextStore)
    if storeFi == -1 or not shakeReachable(storeFi) {
        abort("cg68k: rtTextStore not found/reachable")
    }
    // D0 still holds the freshly-birthed ptr (the store just above reads
    // D0 as its SOURCE, never clobbers it) -- reuse it directly as
    // rtTextStore's first arg, no need to re-read (reg)+off at all (which
    // would reopen the exact same hazard this fix removes).
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmPCLabel, 0, cgPoolStrRef(strDefaultIdx), AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgCallFunc(storeFi)
    cgCleanupStack(8)
}

// cgEmitContainerBirthCall mirrors cpDefaultInit's KList/KMap arms:
// dst = fnName(sizeArg) -- rtListNew/rtMapNew, one plain int argument
// (the element/value size THIS backend's own layout authority decided,
// cgSizeOf(irtElem(t)) -- see the file header's own element-size-
// consistency note: birth and addressing MUST agree, and both derive from
// cgSizeOf, never cgSlotSizeOf, for a container element). Destination
// address precomputed and carried across the JSR on the stack, same fix
// (and same reason -- `reg` itself, not just A1, can be clobbered) as
// cgDefaultInitTextAt's own rtTextNew call just above (Task 14, native-5e).
func cgEmitContainerBirthCall(nameIdx: int, sizeArg: int, reg: int, off: int) {
    var fi: int

    fi = findIRFuncIdxByName(nameIdx)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: " + poolGet(nameIdx) + " not found/reachable")
    }
    // Dest address pushed BEFORE the real argument (deeper on the stack,
    // further from the return address JSR pushes next) so the callee's
    // own 8(A6) still resolves to sizeArg, not to this stashed address --
    // cgCleanupStack(4) pops only sizeArg, leaving the address sitting
    // right where the MOVEA below expects it.
    a68Emit(OpLea, 0, AmDisp16, reg, off, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, sizeArg, AmPreDec, 7, 0)
    cgCallFunc(fi)
    cgCleanupStack(4)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmInd, 0, 0)
}

// cgEmitPtrRcCall loads the 4-byte pointer value at off(reg) into D0,
// pushes it, and calls fnName (a real reachable IRFunc taking one `ptr`
// arg, e.g. rtTextRetain/rtTextRelease/rtListRetain/... -- str.cla-family
// signatures already established) -- the KText/KList/KMap leaf of
// cgRetainAt/cgReleaseAt below. Saves/restores A1 around the JSR
// unconditionally (cgWalkStashBase/cgWalkRestoreBase's own doc comment,
// "SECOND-ORDER BUG" -- this is one of the three JSR-crossing sites that
// invariant requires): fnName is an ordinary Clarus function with no
// callee-saved registers, so it's as free to clobber A1 as any other
// scratch register, and A1 may currently hold a reg=0 walk's own base
// that a LATER field/element in the same walk still needs.
func cgEmitPtrRcCall(nameIdx: int, reg: int, off: int) {
    var fi: int

    fi = findIRFuncIdxByName(nameIdx)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: " + poolGet(nameIdx) + " not found/reachable")
    }
    a68Emit(OpMove, 4, AmAn, 1, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDisp16, reg, off, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgCallFunc(fi)
    cgCleanupStack(4)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 1, 0)
}

// cgEmitRecWalkCall LEAs off(reg) (the record's OWN address, not a loaded
// pointer -- a record field/local/global is a by-value struct, never a
// pointer, file header's own "LAYOUT AUTHORITY" note), pushes it, and JSRs
// recNameIdx's cg_retain_/cg_release_ label -- a no-op when
// irRecHasHandleField(recNameIdx) is false (THE gate, ir.cla:720; no walk
// pair exists for a scalar-only record, so there is nothing to call).
// Saves/restores A1 around the JSR unconditionally, same reason and same
// invariant as cgEmitPtrRcCall above -- THE site the re-review's proven
// sequence traced: the called cg_retain_<Rec>/cg_release_<Rec> runs ITS
// OWN cgWalkStashBase (unconditional, no way for it to know a caller's
// walk is still in flight), overwriting the caller's A1 with the callee's
// own base before this JSR ever returns.
func cgEmitRecWalkCall(isRetain: bool, reg: int, off: int, recNameIdx: int) {
    var ri: int
    var lbl: int

    if not irRecHasHandleField(recNameIdx) {
        return
    }
    ri = cgFindRecordByName(recNameIdx)
    if ri == -1 {
        abort("cg68k: unknown record type " + poolGet(recNameIdx))
    }
    if isRetain {
        lbl = cgRecRetainLbls[ri]
    } else {
        lbl = cgRecReleaseLbls[ri]
    }
    a68Emit(OpMove, 4, AmAn, 1, 0, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmDisp16, reg, off, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68EmitBr(OpBsr, 0, lbl)
    cgCleanupStack(4)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 1, 0)
}

// cgRetainAt/cgReleaseAt are cpEmitRetain/cpEmitRelease's native
// counterparts: bump/drop the reference(s) t's value at off(reg) owns.
// KText/KList/KMap call the ordinary Clarus-ported family function
// (cgEmitPtrRcCall); KRec calls the generated cg_retain_/cg_release_ walk
// (cgEmitRecWalkCall, itself a no-op for a scalar-only record); KArr
// recurses per element ONLY when the element type needs it
// (irtNeedsCtor); every other kind is a no-op (a plain scalar owns no
// reference) -- exactly cpEmitRetain/cpEmitRelease's own dispatch shape,
// minus the KList/KMap deep-element-release walk (container element
// ARC is Task 13 territory; the bare container handle's own retain/
// release still works today, matching this task's documented scope).
func cgRetainAt(reg: int, off: int, t: int) {
    var k: IRKind
    var et: int
    var n: int
    var i: int

    k = irtKind(t)
    if k == KText {
        cgEmitPtrRcCall(rnTextRetain, reg, off)
    } else if k == KList {
        cgEmitPtrRcCall(rnListRetain, reg, off)
    } else if k == KMap {
        cgEmitPtrRcCall(rnMapRetain, reg, off)
    } else if k == KSortedMap {
        cgEmitPtrRcCall(rnSortedMapRetain, reg, off)
    } else if k == KIntMap {
        cgEmitPtrRcCall(rnIntMapRetain, reg, off)
    } else if k == KRec {
        cgEmitRecWalkCall(true, reg, off, irtName(t))
    } else if k == KArr {
        et = irtElem(t)
        if irtNeedsCtor(et) {
            n = irtN(t)
            cgWalkStashBase(reg)
            i = 0
            while i < n {
                cgWalkRestoreBase(reg)
                cgRetainAt(reg, off + i * cgArrElemStride(et), et)
                i = i + 1
            }
        }
    }
}

func cgReleaseAt(reg: int, off: int, t: int) {
    var k: IRKind
    var et: int
    var n: int
    var i: int

    k = irtKind(t)
    if k == KText {
        cgEmitPtrRcCall(rnTextRelease, reg, off)
    } else if k == KList {
        // Task 13: the deep, lastref-gated element-release walk
        // (cgDeepReleaseContainer) -- Task 12 left this a bare handle
        // release only (see this function's OWN doc comment, unchanged
        // above); container element ARC is Task 13 territory, and this is
        // it.
        cgDeepReleaseContainer(reg, off, t, 0)
    } else if k == KMap or k == KSortedMap or k == KIntMap {
        cgDeepReleaseContainer(reg, off, t, 0)
    } else if k == KRec {
        cgEmitRecWalkCall(false, reg, off, irtName(t))
    } else if k == KArr {
        et = irtElem(t)
        if irtNeedsCtor(et) {
            n = irtN(t)
            cgWalkStashBase(reg)
            i = 0
            while i < n {
                cgWalkRestoreBase(reg)
                cgReleaseAt(reg, off + i * cgArrElemStride(et), et)
                i = i + 1
            }
        }
    }
}

// cgRetainExpr/cgReleaseExpr wrap cgRetainAt/cgReleaseAt for a general
// addressable IRExpr (EVarRef or EFieldRef -- lowCountedStoreRecVal's own
// IRetain/IRelease intrinsic targets, cgIntr's "retain"/"release" dispatch
// below) rather than a statically-known (reg, off): cgExprAddr(e) always
// leaves e's address in A0 (this file's own established postcondition), so
// "reg=0 (A0), off=0" is simply that just-computed address, letting the
// SAME reg/off-parametrized walk serve a runtime-computed field address
// too.
func cgRetainExpr(e: int) {
    cgExprAddr(e)
    cgRetainAt(0, 0, irExprType(e))
}

func cgReleaseExpr(e: int) {
    cgExprAddr(e)
    cgReleaseAt(0, 0, irExprType(e))
}

// cgAssignRcWalkLabels reserves cg_retain_<Rec>/cg_release_<Rec>'s a68
// label pair for every irRecords entry with a handle-bearing field
// (irRecHasHandleField -- THE gate, ir.cla:720), -1/-1 for a scalar-only
// record (cgEmitRecWalkCall's own no-op guard means these two label slots
// are read only when irRecHasHandleField is already true, so the -1
// sentinel is never actually dereferenced by a68Bind/a68Emit -- it exists
// only so cgRecRetainLbls[ri]/cgRecReleaseLbls[ri] stays a total,
// index-safe array over every irRecords index). Called once per
// cg68Program() run, before ANY function body/globals-init/globals-free
// body is emitted (cgAssignJtSlots' own "reserve up front" discipline) --
// a copy-site's own IRetain/IRelease intrinsic (Task 12's ARC store
// sequence, lowCountedStoreRecVal) can reference a walk pair while a
// FUNCTION body is being compiled, and a global's non-birth Init or
// cg_free_globals's own release loop can reference one before that.
func cgAssignRcWalkLabels() {
    var i: int
    var retains: list of int
    var releases: list of int

    retains = cgFreshIntList()
    releases = cgFreshIntList()
    i = 0
    while i < irRecords.count {
        if irRecHasHandleField(irRecordLayoutName(i)) {
            retains.add(a68NewLabel())
            releases.add(a68NewLabel())
        } else {
            retains.add(-1)
            releases.add(-1)
        }
        i = i + 1
    }
    cgRecRetainLbls = retains
    cgRecReleaseLbls = releases
}

// cgEmitOneRcWalk binds and emits recIdx's cg_retain_<Rec>/cg_release_
// <Rec> pair -- mirrors cpEmitOneRcWalk's r->cv_<field> walk (cprint.cla),
// just addressed by offset instead of by C field name.
//
// Task 13 upgrade: these now LINK a small frame (cgReserveDeepScratch's own
// {ptr,count,index,value} scratch, cgDeepLevels quadruples) instead of
// staying bare leaf routines -- a record field of List/Map type whose
// element/value itself needs ARC (`list of map of text` as a field, say)
// recurses through cgReleaseAt's own KList/KMap arm (Task 13), which now
// needs A6-relative deep-walk scratch to exist; a bare (no-LINK) routine's
// A6 is simply whatever the CALLER's A6 happens to be, so any A6-relative
// access here would silently corrupt the caller's own frame. The one
// pushed arg (the record's own address, cgEmitRecWalkCall's own push)
// shifts from 4(A7) (pre-LINK) to 8(A6) (post-LINK, the standard "one more
// param slot" shift LINK's own saved-A6 push causes) -- cg_retain_ needs no
// scratch at all (retain is shallow, cpEmitRetain's own "deliberately NOT
// symmetric" note) but LINKs the SAME small frame anyway, for symmetry and
// because the cost is a few bytes of stack, not worth a special case.
func cgEmitOneRcWalk(ri: int) {
    var f: int
    var cur: int
    var ft: int
    var frameSize: int

    a68Bind(cgRecRetainLbls[ri])
    if a68ListingOn {
        a68Comment("cg_retain_" + poolGet(irRecordLayoutName(ri)) + "(rec ptr at 8(A6))")
    } else {
        a68CommentMarker()
    }
    frameSize = 0 - cgReserveDeepScratch(0)
    a68Emit(OpLink, 0, AmNone, 0, 0, AmAn, 6, 0 - frameSize)
    a68Emit(OpMovea, 4, AmDisp16, 6, 8, AmAn, 0, 0)
    cgWalkStashBase(0)
    cur = 0
    f = irRecordLayoutFieldsHead(ri)
    while f != -1 {
        ft = irFieldSlotType(f)
        cur = cgAlignUp(cur, cgRecFieldAlignOf(ft))
        if irtNeedsCtor(ft) {
            cgWalkRestoreBase(0)
            cgRetainAt(0, cur, ft)
        }
        cur = cur + cgRecFieldSizeOf(ft)
        f = irFieldSlotNext(f)
    }
    a68Emit(OpUnlk, 0, AmNone, 0, 0, AmAn, 6, 0)
    a68Emit(OpRts, 0, AmNone, 0, 0, AmNone, 0, 0)

    a68Bind(cgRecReleaseLbls[ri])
    if a68ListingOn {
        a68Comment("cg_release_" + poolGet(irRecordLayoutName(ri)) + "(rec ptr at 8(A6))")
    } else {
        a68CommentMarker()
    }
    frameSize = 0 - cgReserveDeepScratch(0)
    a68Emit(OpLink, 0, AmNone, 0, 0, AmAn, 6, 0 - frameSize)
    a68Emit(OpMovea, 4, AmDisp16, 6, 8, AmAn, 0, 0)
    cgWalkStashBase(0)
    cur = 0
    f = irRecordLayoutFieldsHead(ri)
    while f != -1 {
        ft = irFieldSlotType(f)
        cur = cgAlignUp(cur, cgRecFieldAlignOf(ft))
        if irtNeedsCtor(ft) {
            cgWalkRestoreBase(0)
            cgReleaseAt(0, cur, ft)
        }
        cur = cur + cgRecFieldSizeOf(ft)
        f = irFieldSlotNext(f)
    }
    a68Emit(OpUnlk, 0, AmNone, 0, 0, AmAn, 6, 0)
    a68Emit(OpRts, 0, AmNone, 0, 0, AmNone, 0, 0)
}

// cgEmitRcWalks emits every handle-bearing record's walk pair, declaration
// order -- called once per cg68Program() run, after every reachable
// function AND cg_mul32/cg_div32/cg_mod32 (helper-routine landing spot,
// same relative position those three occupy) but before the constant
// pool.
func cgEmitRcWalks() {
    var i: int

    i = 0
    while i < irRecords.count {
        if irRecHasHandleField(irRecordLayoutName(i)) {
            cgEmitOneRcWalk(i)
        }
        i = i + 1
    }
}

// ================================================================
// Task 13: container/ARC shared machinery -- the statement-temp pool, the
// deep container-release walk, and the inline List addressing bounds-check
// panic. Built on top of Task 12's cgRetainAt/cgReleaseAt/cgEmitPtrRcCall/
// cgEmitRecWalkCall/cgWalkStashBase, same layering cprint's own
// fpRetainVal/fpReleaseVal build on cpEmitRetain/cpEmitRelease.
// ================================================================

// cgReserveDeepScratch lays out cgDeepLevels {ptr,count,index,value}
// quadruples (16 bytes each -- `value` is a Map value out-param buffer,
// cgDeepReleaseContainer's own Map-branch scratch, unused by a List walk)
// as contiguous negative offsets starting from startNeg, populating
// cgDeepPtrOffs/cgDeepCountOffs/cgDeepIndexOffs/cgDeepValueOffs, and
// returns the new running negative extent -- shared by cgEmitFunc (appended
// below the function's own named locals + statement-temp pool) and
// cgEmitOneRcWalk (Task 13 upgrade: these leaf routines now LINK a small
// frame too, so a record field of List/Map type can deep-release through
// the exact same mechanism a normal function body uses -- see
// cgEmitOneRcWalk's own updated doc comment).
func cgReserveDeepScratch(startNeg: int): int {
    var running: int
    var ptrs: list of int
    var counts: list of int
    var idxs: list of int
    var vals: list of int
    var i: int

    running = startNeg
    ptrs = cgFreshIntList()
    counts = cgFreshIntList()
    idxs = cgFreshIntList()
    vals = cgFreshIntList()
    i = 0
    while i < cgDeepLevels {
        running = running - 4
        ptrs.add(running)
        running = running - 4
        counts.add(running)
        running = running - 4
        idxs.add(running)
        running = running - 4
        vals.add(running)
        i = i + 1
    }
    cgDeepPtrOffs = ptrs
    cgDeepCountOffs = counts
    cgDeepIndexOffs = idxs
    cgDeepValueOffs = vals
    return running
}

// cgEmitPanic calls rtPanic(msg) with msgLitIdx's own pool literal,
// materialized into ONE scratch str(255) (filled by rtStrStore -- clamped
// copy, same call shape as cgDefaultInitStrAt's own explicit-default arm)
// whose ADDRESS is then pushed as rtPanic's single argument, exactly the
// shape cgPushArgs' own KStr addressable-arg path uses for every other
// Clarus call (`cgExprAddr` then MOVE.L A0,-(SP); cgArgSlotSize(KStr) ==
// 4). rtPanic's `msg: string` param slot HOLDS AN ADDRESS -- the
// param-abi phase's by-address ABI (cgCurFrameIsRef) applies to every
// IRFunc cgEmitFunc compiles, rtPanic included, so this call site must
// pass a pointer, not a 256-byte by-value block. It used to push the
// block (a second scratch slot, block-copied from the first), a stale
// pre-param-abi shape that made every native list-bounds-check panic
// print an EMPTY message: rtPanic read the literal's own first four bytes
// (length byte + first three chars) AS the pointer. rtPanic never returns
// (core.cla's CorePanic aborts) -- no cleanup after the JSR, same trust
// cgDefaultInitStrAt's own callees already place in every OTHER no-return
// runtime call this file emits.
func cgEmitPanic(msgLitIdx: int) {
    var storeFi: int
    var panicFi: int

    storeFi = findIRFuncIdxByName(rnStrStore)
    panicFi = findIRFuncIdxByName(rnPanic)
    if storeFi == -1 or not shakeReachable(storeFi) {
        abort("cg68k: rtStrStore not found/reachable")
    }
    if panicFi == -1 or not shakeReachable(panicFi) {
        abort("cg68k: rtPanic not found/reachable")
    }
    a68Emit(OpAdda, 4, AmImm, 0, 0 - 256, AmAn, 7, 0)
    a68Emit(OpMovea, 4, AmAn, 7, 0, AmAn, 1, 0)
    a68Emit(OpMove, 4, AmAn, 1, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmImm, 0, 255, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmPCLabel, 0, cgPoolStrRef(msgLitIdx), AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgCallFunc(storeFi)
    cgCleanupStack(12)
    a68Emit(OpMovea, 4, AmAn, 7, 0, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgCallFunc(panicFi)
}

// cgAllocTmpOff reserves the next free statement-temp slot (this
// STATEMENT's own high-water mark, cgStmtTmpNext -- cgStmt resets it to 0
// at every statement's start) WITHOUT tracking it for release -- the raw
// bump allocator every out-param-needing container intrinsic arm uses for
// its own scratch (pop/shift/first/last/get/getDv/getDvBirth all need
// SOME address to hand the runtime call as its out-param, tracked or not).
// A t that can't fit a 4-byte slot (KRec/KStr container elements/results,
// e.g. `list of string`) routes to cgAllocBigTmpOff instead (Task 14.7 --
// was a hard error here through Task 13, "not exercised by this task's
// fixtures"; the 5d corpus sweep exercises it directly).
func cgAllocTmpOff(t: int): int {
    var off: int

    if cgSizeOf(t) > 4 {
        return cgAllocBigTmpOff(t)
    }
    if cgStmtTmpNext >= cgTmpSlots {
        abort("cg68k: too many tracked temps in one statement (Task 13 pool exhausted -- bump cgTmpSlots)")
    }
    off = cgTmpBaseOffs[cgStmtTmpNext]
    cgStmtTmpNext = cgStmtTmpNext + 1
    return off
}

// cgAllocBigTmpOff is cgAllocTmpOff's >4-byte sibling (Task 14.7): every
// existing cgAllocTmpOff call site (list/map push/pop/first/last/remove/
// set/get/getDv/getDvBirth's own element scratch) already routes through
// cgAllocTmpOff, so a `list of string`/`map of string`/small-record
// element now Just Works via this one extra branch, no call-site changes
// needed -- the size split is the ONLY thing that changed.
func cgAllocBigTmpOff(t: int): int {
    var off: int

    if cgSizeOf(t) > cgBigTmpSize {
        abort("cg68k: str/rec temp >" + numToStr(cgBigTmpSize) + " bytes not supported by this backend's scratch pool")
    }
    if cgStmtBigTmpNext >= cgBigTmpSlots {
        abort("cg68k: too many str/rec temps needed in one statement -- bump cgBigTmpSlots")
    }
    off = cgBigTmpBaseOffs[cgStmtBigTmpNext]
    cgStmtBigTmpNext = cgStmtBigTmpNext + 1
    return off
}

// cgNewTrackedTmp allocates a slot (cgAllocTmpOff) AND tracks it for
// release at end-of-statement (cgFreeStmtTmps) unless handed off
// (cgHandoff) first -- mirrors fpNewTrackedTmp's own two-in-one contract.
func cgNewTrackedTmp(t: int): int {
    var off: int

    off = cgAllocTmpOff(t)
    cgStmtTmpOffs.add(off)
    cgStmtTmpType.add(t)
    return off
}

// cgHandoff mirrors fpHandoff: removes off from the tracked list if
// present (a no-op otherwise) -- called when the value that slot holds has
// escaped to a durable owner (a named-slot store, a `return`).
func cgHandoff(off: int) {
    var i: int

    i = 0
    while i < cgStmtTmpOffs.count {
        if cgStmtTmpOffs[i] == off {
            cgStmtTmpOffs.remove(i)
            cgStmtTmpType.remove(i)
            return
        }
        i = i + 1
    }
}

// cgFreeStmtTmps mirrors fpFreeStmtTmps: releases every still-tracked slot
// (cgReleaseAt on its own (A6, off) home) and empties the tracking lists.
// Does NOT reset cgStmtTmpNext (the pool's own bump allocator) -- that only
// resets at the NEXT statement's start (cgStmt), matching fpStmtTmps' own
// per-statement (not per-flush) lifetime.
func cgFreeStmtTmps() {
    var i: int

    i = 0
    while i < cgStmtTmpOffs.count {
        cgReleaseAt(6, cgStmtTmpOffs[i], cgStmtTmpType[i])
        i = i + 1
    }
    cgStmtTmpOffs.clear()
    cgStmtTmpType.clear()
}

// cgContainerElemNeedsWalk mirrors cpEmitRelease's own List/Map
// element-walk gate EXACTLY (cprint.cla:3251/3270/3281 for List,
// :3360/3369/3381 for Map): KText, a handle-bearing KRec, a nested
// KList/KMap/KSortedMap/KIntMap, or (fix round 1 review, memory-leak-fix
// phase: a `list of text[3]`/similar is legal -- check.cla only bans
// ptr/overlay/xrec as array ELEMENT types, not KArr as a container
// element/value type -- this was a real silent-leak gap on a reachable
// type, not a merely-hypothetical one) a KArr whose OWN element needs
// construction/release traffic (irtNeedsCtor -- an all-scalar array, e.g.
// `int[3]`, still needs no walk).
func cgContainerElemNeedsWalk(et: int): bool {
    var k: IRKind

    k = irtKind(et)
    if k == KText or k == KList or k == KMap or k == KSortedMap or k == KIntMap {
        return true
    }
    if k == KRec {
        return irRecHasHandleField(irtName(et))
    }
    if k == KArr {
        return irtNeedsCtor(irtElem(et))
    }
    return false
}

// cgNeedsRelease mirrors fpNeedsRelease (cprint.cla:434-445) EXACTLY: does
// a value of IR type t need ANY retain/release traffic at all --
// Text/List/Map, OR a handle-bearing record, OR (recursively) a fixed
// array whose element does. A DIFFERENT question from
// cgContainerElemNeedsWalk (that one answers "does a List/Map/SortedMap/
// IntMap element/value of this type need its OWN walk", the same KArr
// case included since the fix round 1 review) -- this is the general
// predicate cgIntr's own IListPop/IListShift discard-detection and
// IListRemove/IMapSet(Retain)/IMapRemove's own old-value-release guards
// consult, mirroring fpNeedsRelease's identical role at those same cprint
// call sites.
func cgNeedsRelease(t: int): bool {
    var k: IRKind

    k = irtKind(t)
    if k == KRec {
        return irRecHasHandleField(irtName(t))
    }
    if k == KArr {
        return cgNeedsRelease(irtElem(t))
    }
    return k == KText or k == KList or k == KMap or k == KSortedMap or k == KIntMap
}

// cgEmitAtCall JSRs fnName(ptr, idx) -- rtListAt/rtMapValAt's own shape,
// ptr/idx read from their own A6-relative scratch slots (this deep walk's
// OWN, depth-indexed pair -- never re-derived from the ORIGINAL (reg, off)
// container slot, which may be reg=0/A0 and long since clobbered by the
// walk itself) -- leaving the result (an element address for List, or
// writing through an out-param for Map -- see cgContainerElemRelease's own
// two call shapes below) in D0. A1 stash/restore around the JSR, same
// unconditional SECOND-ORDER BUG invariant cgEmitPtrRcCall/
// cgEmitRecWalkCall already follow.
func cgEmitAtCall(nameIdx: int, ptrOff: int, idxOff: int) {
    var fi: int

    fi = findIRFuncIdxByName(nameIdx)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: " + poolGet(nameIdx) + " not found/reachable")
    }
    a68Emit(OpMove, 4, AmAn, 1, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, ptrOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, idxOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgCallFunc(fi)
    cgCleanupStack(8)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 1, 0)
}

// cgContainerElemRelease releases ONE element/value whose address is
// ALREADY in A0 (a List slot's own directly-addressable backing-array
// address, or a Map value out-param buffer's address -- the caller derives
// either shape; this function only ever reads through A0) -- et is the
// element/value's own IR type, depth is the NEXT recursion level a nested
// List/Map element's own walk should use (never the caller's own level:
// cgDeepReleaseContainer already validates depth<cgDeepLevels itself).
// KArr (fix round 1 review, memory-leak-fix phase): reuses cgReleaseAt's
// OWN KArr walk verbatim -- the SAME (reg, off)-parametrized per-slot
// release machinery cgReleaseAt already uses for a fixed-array LOCAL/field
// (its own KArr branch, cgWalkStashBase/RestoreBase-protected against the
// per-slot recursion's JSRs clobbering the base register) -- rather than
// reimplementing an array walk here. (reg=0, off=0) is A0, exactly this
// function's own "address already in A0" precondition.
func cgContainerElemRelease(et: int, depth: int) {
    var k: IRKind

    k = irtKind(et)
    if k == KText {
        cgEmitPtrRcCall(rnTextRelease, 0, 0)
    } else if k == KRec {
        cgEmitRecWalkCall(false, 0, 0, irtName(et))
    } else if k == KList or k == KMap or k == KSortedMap or k == KIntMap {
        cgDeepReleaseContainer(0, 0, et, depth)
    } else if k == KArr {
        cgReleaseAt(0, 0, et)
    }
}

// cgEmitMapValAtCall JSRs fnName(m, i, out) -- rtMapValAt or (map-hashtable
// phase Task 2) rtSortedMapValAt -- out is THIS depth's own value scratch
// slot's ADDRESS (LEA'd, not loaded -- ValAt writes THROUGH it), m/i read
// from ptrOff/idxOff exactly like cgEmitAtCall's own List shape. Leaves
// nothing meaningful in D0 (ValAt is void); the caller reads the result
// back out of valOff itself.
func cgEmitMapValAtCall(nameIdx: int, ptrOff: int, idxOff: int, valOff: int) {
    var fi: int

    fi = findIRFuncIdxByName(nameIdx)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: " + poolGet(nameIdx) + " not found/reachable")
    }
    a68Emit(OpMove, 4, AmAn, 1, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, ptrOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, idxOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmDisp16, 6, valOff, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgCallFunc(fi)
    cgCleanupStack(12)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 1, 0)
}

// cgDeepReleaseContainer is cpEmitRelease's KList/KMap/KSortedMap/KIntMap
// native counterpart (cprint.cla:3226-3406, map-hashtable phase Task 2
// added the KSortedMap arm there, Task 7 the KIntMap one): lastref-gated
// element walk (only the reference that drops the container to zero may
// free what it owns -- ARC Task 6 round 3's shared-container double-free
// guard, mirrored exactly) then the container's own release. (reg, off)
// addresses the SLOT holding the container's pointer VALUE (cgEmitPtrRcCall's
// own convention) -- read into this depth's OWN scratch ONCE, up front, and
// never re-derived from (reg, off) again (reg may be 0/A0, clobbered by the
// walk itself -- see the module header comment). depth selects this call's
// {ptr,count,index} triple; a NESTED List/Map/SortedMap/IntMap element
// recurses at depth+1 via cgContainerElemRelease, so sibling/ancestor levels
// never collide.
//
// map-hashtable phase Task 2: the runtime-name family (which of List/Map/
// SortedMap's own Lastref/Count/At-or-ValAt/Release this calls) is derived
// from t's OWN irtKind rather than a separate bool parameter -- t already
// carries that information, and a caller passing a mismatched bool was a
// latent bug class this removes by construction. Map and SortedMap share
// the SAME "opaque, out-param ValAt" addressing shape (unlike List's
// directly-addressable backing array), only their runtime name prefix
// differs. map-hashtable phase Task 7: IntMap joins the SAME opaque
// out-param-ValAt family -- this walk only ever touches VALUES (fixed-size,
// same shape regardless of key type), so IntMap's int keys never enter into
// it at all.
func cgDeepReleaseContainer(reg: int, off: int, t: int, depth: int) {
    var ptrOff: int
    var lastrefFn: int
    var relFn: int
    var afterLbl: int

    if depth >= cgDeepLevels {
        abort("cg68k: container nesting too deep (Task 13 scope, max " + numToStr(cgDeepLevels) + " levels)")
    }
    ptrOff = cgDeepPtrOffs[depth]
    // Findings 1.4 (Task 13): lastrefFn/relFn were `string` literals,
    // re-interned on every JSR below; now pre-interned rn* globals, picked
    // once per depth-level walk (4-way, same runtime families
    // cgIntrMapSet/Get/GetDv/Remove's own `sorted` bool covers, plus
    // List/IntMap).
    if irtKind(t) == KIntMap {
        // map-hashtable phase Task 7: same opaque, out-param ValAt shape as
        // Map/SortedMap -- only the runtime name prefix differs. (The KEY
        // fetch this walk never needs -- it only walks VALUES.)
        lastrefFn = rnIntMapLastref
        relFn = rnIntMapRelease
    } else if irtKind(t) == KSortedMap {
        lastrefFn = rnSortedMapLastref
        relFn = rnSortedMapRelease
    } else if irtKind(t) == KMap {
        lastrefFn = rnMapLastref
        relFn = rnMapRelease
    } else {
        lastrefFn = rnListLastref
        relFn = rnListRelease
    }

    // t is always KList/KMap/KSortedMap/KIntMap here (a 4-byte pointer-shaped
    // kind) -- stash the container's own pointer VALUE into this depth's
    // scratch, never re-derived from (reg, off) again (see this
    // function's own doc comment: reg may be 0/A0, clobbered by the walk
    // below).
    a68Emit(OpMove, 4, AmDisp16, reg, off, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmDisp16, 6, ptrOff)

    afterLbl = a68NewLabel()
    if cgContainerElemNeedsWalk(irtElem(t)) {
        cgEmitPtrRcCall(lastrefFn, 6, ptrOff)
        a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 0, 0)
        a68EmitBr(OpBcc, 7, afterLbl) // BEQ: not lastref -> skip the walk

        cgReleaseContainerElems(t, depth, afterLbl)
    }
    a68Bind(afterLbl)
    cgEmitPtrRcCall(relFn, 6, ptrOff)
}

// cgReleaseContainerElems (memory-leak-fix phase Task 5) is
// cgDeepReleaseContainer's own element-walk loop, factored out so
// `.clear()`'s Deep arms (cgClearDeepContainer, below) can reuse the exact
// same walk WITHOUT cgDeepReleaseContainer's lastref gate: that gate exists
// because a shared (rc>1) container's TEARDOWN can be reached from two
// independent release call sites, and only the one that actually drops the
// container to zero may free what it owns. `.clear()` has exactly ONE call
// site and the container handle survives it (only its CONTENTS are
// discarded), so the same double-release hazard the gate defends against
// cannot occur here -- gating this walk on the container's own rc would
// instead wrongly SKIP the element release whenever the container happens
// to be aliased, reintroducing the leak class this task fixes (see
// cpEmitElemReleaseWalk's own doc comment, cprint.cla, for the identical
// host-lane reasoning/Task 4 precedent).
//
// Callers own the gate: this function unconditionally emits the walk, and
// assumes (a) the caller has already checked
// cgContainerElemNeedsWalk(irtElem(t)) before calling (an all-scalar
// element type has nothing to walk) and (b) cgDeepPtrOffs[depth] already
// holds the container's pointer VALUE (both callers stash it themselves,
// exactly as cgDeepReleaseContainer always has). exitLbl is an
// already-allocated, NOT-YET-bound label -- the loop branches to it when
// index>=count, but binding it is the CALLER's job (cgDeepReleaseContainer
// reuses the same label as its own lastref-skip target; cgClearDeepContainer
// has no such second use and binds it immediately after this call).
func cgReleaseContainerElems(t: int, depth: int, exitLbl: int) {
    var et: int
    var ptrOff: int
    var countOff: int
    var idxOff: int
    var countFn: int
    var atFn: int
    var opaque: bool
    var loopLbl: int

    et = irtElem(t)
    ptrOff = cgDeepPtrOffs[depth]
    countOff = cgDeepCountOffs[depth]
    idxOff = cgDeepIndexOffs[depth]
    opaque = irtKind(t) == KMap or irtKind(t) == KSortedMap or irtKind(t) == KIntMap
    if irtKind(t) == KIntMap {
        countFn = rnIntMapCount
        atFn = rnIntMapValAt
    } else if irtKind(t) == KSortedMap {
        countFn = rnSortedMapCount
        atFn = rnSortedMapValAt
    } else if irtKind(t) == KMap {
        countFn = rnMapCount
        atFn = rnMapValAt
    } else {
        countFn = rnListCount
        atFn = rnListAt
    }

    cgEmitPtrRcCall(countFn, 6, ptrOff)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmDisp16, 6, countOff)
    a68Emit(OpClr, 4, AmNone, 0, 0, AmDisp16, 6, idxOff)

    loopLbl = a68NewLabel()
    a68Bind(loopLbl)
    a68Emit(OpMove, 4, AmDisp16, 6, idxOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, countOff, AmDn, 1, 0)
    a68Emit(OpCmp, 4, AmDn, 1, 0, AmDn, 0, 0)
    a68EmitBr(OpBcc, 12, exitLbl) // BGE: index>=count -> done

    if opaque {
        // rtMapValAt/rtSortedMapValAt(m, i, out) -- out is THIS depth's
        // own `value` scratch slot (Map/SortedMap storage is opaque,
        // unlike List's directly addressable backing array --
        // cpEmitRelease's own "copied OUT into a local" shape,
        // mirrored exactly).
        cgEmitMapValAtCall(atFn, ptrOff, idxOff, cgDeepValueOffs[depth])
        a68Emit(OpLea, 0, AmDisp16, 6, cgDeepValueOffs[depth], AmAn, 0, 0)
    } else {
        cgEmitAtCall(atFn, ptrOff, idxOff)
        a68Emit(OpMovea, 4, AmDn, 0, 0, AmAn, 0, 0)
    }
    cgContainerElemRelease(et, depth + 1)

    a68Emit(OpAddq, 4, AmImm, 0, 1, AmDisp16, 6, idxOff)
    a68EmitBr(OpBra, 0, loopLbl)
}

// cgClearDeepContainer (memory-leak-fix phase Task 5) is
// cpEmitElemReleaseWalk's native counterpart: the four IListClearDeep/
// IMapClearDeep/ISortedMapClearDeep/IIntMapClearDeep intrinsic arms (below,
// cgIntr) share this one body. a0e is the receiver expr (an ordinary
// scalar-kind value expr -- a container handle IS its own pointer VALUE,
// cgIsScalarKind's own KList/KMap/KSortedMap/KIntMap=true rule, same as
// every other List/Map method arm's addr0=false receiver evaluation, e.g.
// IListClear's cgIntr1(e, rnListClear, false) just above); evaluated ONCE
// via cgExpr into D0, then stashed into depth-0 scratch, exactly mirroring
// cpEmitElemReleaseWalk's own single-capture-and-reuse discipline
// (`l = fpExpr(a0)`, used for both the walk and the final clear call --
// never re-evaluated). Always depth 0: a `.clear()` receiver is always the
// TOP-level container expr, never a nested element mid-walk (nested
// elements only ever go through cgContainerElemRelease's own recursion).
// Releases every CURRENT element (cgReleaseContainerElems, unguarded -- see
// its own doc comment for why no lastref gate belongs here) before the
// SAME O(1) hard-reset JSR (clearFn) the plain, non-Deep arm emits.
func cgClearDeepContainer(a0e: int, t: int, clearFn: int) {
    var ptrOff: int
    var afterLbl: int

    ptrOff = cgDeepPtrOffs[0]
    cgExpr(a0e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmDisp16, 6, ptrOff)

    if cgContainerElemNeedsWalk(irtElem(t)) {
        afterLbl = a68NewLabel()
        cgReleaseContainerElems(t, 0, afterLbl)
        a68Bind(afterLbl)
    }
    cgEmitPtrRcCall(clearFn, 6, ptrOff)
}

func cgFindEnumByName(nameIdx: int): int {
    var i: int
    var nm: string

    nm = poolGet(nameIdx)
    i = 0
    while i < irEnums.count {
        if poolGet(irEnumLayoutName(i)) == nm {
            return i
        }
        i = i + 1
    }
    return -1
}

func cgEnumMemberCount(ei: int): int {
    var m: int
    var n: int

    n = 0
    m = irEnumLayoutMembersHead(ei)
    while m != -1 {
        n = n + 1
        m = irEnumMemberNext(m)
    }
    return n
}

// cgReserveEnumTableLabels allocates (but does not yet bind) one a68 label
// per irEnums entry -- same up-front-reservation discipline as
// cgReserveStrLitLabels, for the identical reason (a CvIntToEnum
// conversion site can reference the table label while walking a function
// body, well before cgEmitEnumTables lays the pool out).
// Task 13: filtered by cgCurPoolEnumTables the same way
// cgReserveStrLitLabels is filtered by cgCurPoolStrLits -- see that
// function's own doc comment. Task 15 (findings 1.8): the membership
// test reads cgCurPoolEnumBits (O(1)), cgCurPoolEnumTables' own parallel
// bitmap, instead of scanning cgCurPoolEnumTables itself.
func cgReserveEnumTableLabels() {
    var i: int
    var labels: list of int

    labels = cgFreshIntList()
    i = 0
    while i < irEnums.count {
        if cgCurPoolEnumBits[i] {
            labels.add(a68NewLabel())
        } else {
            labels.add(-1)
        }
        i = i + 1
    }
    cgEnumTableLabels = labels
}

// cgEmitEnumTables lays out cgCurPoolEnumTables' own enums' value tables
// (Task 13: not unconditionally every irEnums entry -- see
// cgEmitPoolsBody's own doc comment) at the current stream position: one
// DC.L per member, declaration order, bound to cgReserveEnumTableLabels'
// own label -- the pool data cgEmitEnumConv's inline scan walks at
// runtime. Enums are 4-byte native ints (irtKind KEnum, cgSizeOf's own
// KEnum case), so DC.L (not DC.W) matches the scan's own CMP.L stride.
func cgEmitEnumTables() {
    var i: int
    var ei: int
    var m: int
    var before: int

    if a68ListingOn {
        a68Comment("constant pool: enum value tables")
    } else {
        a68CommentMarker()
    }
    i = 0
    while i < cgCurPoolEnumTables.count {
        ei = cgCurPoolEnumTables[i]
        before = a68SizeSoFar()
        a68Bind(cgEnumTableLabels[ei])
        m = irEnumLayoutMembersHead(ei)
        while m != -1 {
            a68DcL(irEnumMemberValue(m))
            m = irEnumMemberNext(m)
        }
        if cgMeasuringPoolSizes {
            cgEnumTableSize[ei] = a68SizeSoFar() - before
        }
        i = i + 1
    }
}

// cgEnumTableRef returns cgEnumTableLabels[ei], recording ei as needed by
// the CURRENT cgRecMode bucket (Task 13) -- cgEmitEnumConv's inline scan
// is this label's sole reference site.
func cgEnumTableRef(ei: int): int {
    cgRecordEnumTable(ei)
    return cgEnumTableLabels[ei]
}

// cgReserveSerdescLabels allocates (but does not yet bind) one a68 label
// per irRecords entry that irLayoutNeeded marks (-1 otherwise) -- same
// up-front-reservation discipline as cgReserveEnumTableLabels, called
// alongside it (both cg68Measure's throwaway pass and cg68Program's real
// per-segment pass).
// Task 13: additionally filtered by cgCurPoolSerdescs (a record can pass
// irLayoutNeeded yet still be absent from THIS pass's own need-set, if
// no function/bucket assigned to this segment ever actually reaches a
// file.save/file.load call for it) -- same discipline as
// cgReserveStrLitLabels. Task 15 (findings 1.8): the membership test
// reads cgCurPoolSerdescBits (O(1)) instead of scanning cgCurPoolSerdescs.
func cgReserveSerdescLabels() {
    var i: int
    var labels: list of int

    labels = cgFreshIntList()
    i = 0
    while i < irRecords.count {
        if irLayoutNeeded(irRecordLayoutName(i)) and cgCurPoolSerdescBits[i] {
            labels.add(a68NewLabel())
        } else {
            labels.add(-1)
        }
        i = i + 1
    }
    cgSerdescLabels = labels
}

// cgFindSerdescLabel returns recNameIdx's reserved serdesc label (-1 if
// that record has none -- cgIntrFileSaveLoad's own caller fails closed on
// that, it should never actually happen since checkFileSave/checkFileLoad
// already restrict file.save/file.load's data arg to a record-ish shape,
// which lower.cla's own irMarkLayoutNeeded call always marks). Int compare
// (findings 1.4: index equality already implies string equality under the
// intern-pool invariant -- Global Constraints; shake.cla:99-105's
// shakeFuncIdxByName already relies on the same invariant, so the prior
// "poolGet indices aren't assumed identical" doc comment here was
// factually wrong).
func cgFindSerdescLabel(recNameIdx: int): int {
    var i: int

    i = 0
    while i < irRecords.count {
        if irRecordLayoutName(i) == recNameIdx {
            if cgSerdescLabels[i] != -1 {
                cgRecordSerdesc(i)
            }
            return cgSerdescLabels[i]
        }
        i = i + 1
    }
    return -1
}

// cgBuildSerdescInts returns recNameIdx's serdesc table as a flat int
// list, MIRRORING cpEmitSerDescs/cpSerFieldRow's exact field layout
// (cprint.cla) byte-for-byte in SHAPE (ser.cla's own reader, shared by
// both lanes, peekl-walks this format regardless of which lane emitted
// it):
//
//   [0] = recSize (cgRecordSize -- the NATIVE record-ABI authority, NOT
//         cpCRecordSize: bool/char fields get cg68k's own 4-byte-in-a-
//         record slot, Task 14's own record-ABI fix)
//   [1] = nFields
//   then nFields field blocks, each "4 + enumCount" ints:
//     ftype (0 INT/1 FIXED/2 BOOL/3 CHAR/4 STR/5 ENUM), strCap (STR only),
//     offset (cgFieldOffset -- same native authority as recSize above),
//     enumCount (ENUM only), then enumCount inline ordinal values (ENUM
//     only) -- cpSerEnumValsInline's own inline-not-referenced shape,
//     mirrored directly rather than through a pointer/offset indirection
//     (this backend has no such indirection to reuse here either).
func cgBuildSerdescInts(recNameIdx: int): list of int {
    var out: list of int
    var ri: int
    var f: int
    var nFields: int
    var t: int
    var k: IRKind
    var ftype: int
    var strCap: int
    var enumCount: int
    var ei: int
    var m: int

    out = cgFreshIntList()
    ri = cgFindRecordByName(recNameIdx)
    if ri == -1 {
        abort("cg68k: serdesc: unknown record " + poolGet(recNameIdx))
    }
    nFields = 0
    f = irRecordLayoutFieldsHead(ri)
    while f != -1 {
        nFields = nFields + 1
        f = irFieldSlotNext(f)
    }
    out.add(cgRecordSize(recNameIdx))
    out.add(nFields)

    f = irRecordLayoutFieldsHead(ri)
    while f != -1 {
        t = irFieldSlotType(f)
        k = irtKind(t)
        strCap = 0
        enumCount = 0
        if k == KInt {
            ftype = 0
        } else if k == KFixed {
            ftype = 1
        } else if k == KBool {
            ftype = 2
        } else if k == KChar {
            ftype = 3
        } else if k == KStr {
            ftype = 4
            strCap = irtN(t)
        } else {
            ftype = 5
            enumCount = cpEnumCount(irtName(t))
        }
        out.add(ftype)
        out.add(strCap)
        out.add(cgFieldOffset(recNameIdx, irFieldSlotName(f)))
        out.add(enumCount)
        if k == KEnum {
            ei = 0
            while ei < irEnums.count {
                if irEnumLayoutName(ei) == irtName(t) {
                    m = irEnumLayoutMembersHead(ei)
                    while m != -1 {
                        out.add(irEnumMemberValue(m))
                        m = irEnumMemberNext(m)
                    }
                    ei = irEnums.count
                } else {
                    ei = ei + 1
                }
            }
        }
        f = irFieldSlotNext(f)
    }
    return out
}

// cgEmitSerdescTables lays out every needed record's serdesc table at the
// current stream position (one DC.L per int, cgBuildSerdescInts' own flat
// list), bound to cgReserveSerdescLabels' own label -- the pool data
// ser.cla's rtFileSave/rtFileLoad peekl-walk at runtime. This is the real
// implementation of the "constant pool: serdesc tables" slot
// cgEmitPoolsBody previously left a stub comment for.
func cgEmitSerdescTables() {
    var i: int
    var ri: int
    var vals: list of int
    var j: int
    var before: int

    if a68ListingOn {
        a68Comment("constant pool: serdesc tables")
    } else {
        a68CommentMarker()
    }
    i = 0
    while i < cgCurPoolSerdescs.count {
        ri = cgCurPoolSerdescs[i]
        before = a68SizeSoFar()
        a68Bind(cgSerdescLabels[ri])
        vals = cgBuildSerdescInts(irRecordLayoutName(ri))
        j = 0
        while j < vals.count {
            a68DcL(vals[j])
            j = j + 1
        }
        if cgMeasuringPoolSizes {
            cgSerdescSize[ri] = a68SizeSoFar() - before
        }
        i = i + 1
    }
}

// cgEmitEnumCheckCall calls rtEnumCheck(v, found=false, name) -- the panic
// path cgEmitEnumConv's scan falls into when v matches no member (core.cla's
// rtEnumCheck, cg68AddRoots' own shake root). v is expected in D1 (the
// scan's own working register, cgEmitEnumConv below). rtEnumCheck's `name`
// param is accepted only "for interface symmetry with a future richer
// diagnostic" (core.cla's own doc comment) and never actually read by its
// body -- the pushed str(255) slot's CONTENT is therefore never
// initialized here (only its 256 bytes of stack space, so the call's own
// arg layout/cleanup stays correctly sized); rtEnumCheck's own body reads
// only `found`, always false on this path, so it always panics via
// rtPanic and never returns.
func cgEmitEnumCheckCall() {
    var fi: int

    fi = findIRFuncIdxByName(rnEnumCheck)
    if fi == -1 or not shakeReachable(fi) {
        abort("cg68k: rtEnumCheck not found/reachable")
    }
    if a68ListingOn {
        a68Comment("enum conversion miss -> rtEnumCheck(v, false, <name arg unused>) panics")
    } else {
        a68CommentMarker()
    }
    a68Emit(OpMove, 4, AmDn, 1, 0, AmPreDec, 7, 0)
    a68Emit(OpClr, 2, AmNone, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpAdda, 4, AmImm, 0, 0 - 256, AmAn, 7, 0)
    cgCallFunc(fi)
    cgCleanupStack(4 + 2 + 256)
}

// cgEmitEnumConv is CvIntToEnum's inline scan (Task 3's shape, per the
// brief): D0 holds v (cgExpr(x)'s own postcondition, already run by
// cgConv before calling this); copy it to D1 (the compare register --
// leaving D0 itself untouched for the whole scan, so D0 already holds the
// right result the instant a match is found, no re-load needed), then
// CMP.L each table entry (A0, post-incrementing) against D1, DBRA looping
// count-1 times; BEQ on a match jumps straight to doneLbl (D0 still = v);
// falling out of the loop with no match calls cgEmitEnumCheckCall (which
// never returns) before falling into doneLbl regardless, so the stream
// stays well-formed even though that fall-through is unreachable at
// runtime.
func cgEmitEnumConv(enumNameIdx: int) {
    var ei: int
    var count: int
    var loopLbl: int
    var doneLbl: int

    ei = cgFindEnumByName(enumNameIdx)
    if ei == -1 {
        abort("cg68k: unknown enum type " + poolGet(enumNameIdx))
    }
    count = cgEnumMemberCount(ei)
    doneLbl = a68NewLabel()

    a68Emit(OpMove, 4, AmDn, 0, 0, AmDn, 1, 0)
    a68Emit(OpLea, 0, AmPCLabel, 0, cgEnumTableRef(ei), AmAn, 0, 0)
    if count > 0 {
        loopLbl = a68NewLabel()
        a68Emit(OpMove, 2, AmImm, 0, count - 1, AmDn, 2, 0)
        a68Bind(loopLbl)
        a68Emit(OpCmp, 4, AmPostInc, 0, 0, AmDn, 1, 0)
        a68EmitBr(OpBcc, 7, doneLbl) // BEQ: match -> done, D0 still = v
        a68Emit(OpDbra, 2, AmDn, 2, 0, AmPCLabel, 0, loopLbl)
    }
    cgEmitEnumCheckCall()
    a68Bind(doneLbl)
}

// ================================================================
// cgEmitInitGlobalsStub/cgEmitFreeGlobalsStub build cg_init_globals/
// cg_free_globals -- cpEmitGlobalsInit's native counterpart (clar_init_
// globals/cl_free_globals). init: for every irGlobal, default-init its
// slot (cgDefaultInitAt, skipped only when Init will unconditionally
// replace a ctor-needing global outright -- fullReplace, mirroring
// cpEmitGlobalsInit's identical optimization/orphan-avoidance comment)
// then, if present, evaluate+store its Init expression -- retaining the
// stored value when it's a non-birth (aliasing) store of a needs-ctor
// type (irGlobalInitBirth, ARC Task 6's fix, mirrored exactly). free:
// release every global's slot, unconditionally (cgReleaseAt no-ops for a
// plain scalar) -- cpEmitGlobalsInit's own "provably unnecessary to gate"
// rationale, ARC Task 6.
// cgEmitGlobalTextFromStr fills a global Text slot (already birthed empty
// by cgEmitInitGlobalsStub's own cgDefaultInitAt call, since a Text<-Str
// init is deliberately excluded from `fullReplace` there) from a Str-typed
// init expression -- mirrors cgIntrTextOfStr's own rtTextStore call shape
// exactly (push the handle, push the source string's address, call
// rtTextStore), but sourced from the ALREADY-birthed handle at off(A5)
// instead of a fresh cgNewTrackedTmp, since the birth already happened.
// Found by Task 16's end gate: a `text` global initialized from a string
// literal (emit_record.cla's `emitRecordGGreeting`) silently stayed empty
// forever -- this arm was a "TODO ... unsupported this task" stub left
// over from Task 12, never exercised by any fixture booted before the
// suite app.
func cgEmitGlobalTextFromStr(off: int, initE: int) {
    a68Emit(OpMove, 4, AmDisp16, 5, off, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(initE)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnTextStore)
    cgCleanupStack(8)
}

func cgEmitGlobalInitExpr(i: int, gt: int, initE: int) {
    var off: int
    var dstRef: int

    off = cgGlobalOffsets[i]
    dstRef = newIRVarRef(irGlobalName(i), true, gt)
    if irtKind(gt) == KStr {
        cgEmitStoreStr(dstRef, initE)
        return
    }
    if irtKind(gt) == KText and irtKind(irExprType(initE)) == KStr {
        cgEmitGlobalTextFromStr(off, initE)
        return
    }
    if irtKind(gt) == KRec {
        cgEmitStoreRec(dstRef, initE)
    } else {
        cgExpr(initE)
        cgStoreD0At(5, off, gt)
    }
    if irtNeedsCtor(gt) and not irGlobalInitBirth(i) {
        cgRetainAt(5, off, gt)
    }
}

// cg_init_globals/cg_free_globals now LINK a small frame (Task 13
// upgrade, same reason and same shape as cgEmitOneRcWalk's own upgrade,
// above): a KList/KMap global's default-birth (cgDefaultInitAt) or release
// (cgReleaseAt, cg_free_globals) can now reach the deep container-walk
// scratch (cgReserveDeepScratch), which is A6-relative -- without a LINK
// here, A6 is whatever the CALLER's frame happens to be, and the walk
// would silently read/write the caller's own locals instead. Neither
// routine takes any argument, so nothing above 4(A6)/8(A6) needs to shift.
func cgEmitInitGlobalsStub(lbl: int) {
    var i: int
    var gt: int
    var initE: int
    var fullReplace: bool
    var frameSize: int

    a68Bind(lbl)
    if a68ListingOn {
        a68Comment("cg_init_globals")
    } else {
        a68CommentMarker()
    }
    frameSize = 0 - cgReserveDeepScratch(0)
    a68Emit(OpLink, 0, AmNone, 0, 0, AmAn, 6, 0 - frameSize)
    i = 0
    while i < irGlobals.count {
        gt = irGlobalType(i)
        initE = irGlobalInit(i)
        fullReplace = initE != -1 and irtNeedsCtor(gt) and not (irtKind(gt) == KText and irtKind(irExprType(initE)) == KStr)
        if not fullReplace {
            cgDefaultInitAt(5, cgGlobalOffsets[i], gt, 0, -1)
        }
        if initE != -1 {
            cgEmitGlobalInitExpr(i, gt, initE)
        }
        i = i + 1
    }
    a68Emit(OpUnlk, 0, AmNone, 0, 0, AmAn, 6, 0)
    a68Emit(OpRts, 0, AmNone, 0, 0, AmNone, 0, 0)
}

func cgEmitFreeGlobalsStub(lbl: int) {
    var i: int
    var frameSize: int

    a68Bind(lbl)
    if a68ListingOn {
        a68Comment("cg_free_globals")
    } else {
        a68CommentMarker()
    }
    frameSize = 0 - cgReserveDeepScratch(0)
    a68Emit(OpLink, 0, AmNone, 0, 0, AmAn, 6, 0 - frameSize)
    i = 0
    while i < irGlobals.count {
        cgReleaseAt(5, cgGlobalOffsets[i], irGlobalType(i))
        i = i + 1
    }
    a68Emit(OpUnlk, 0, AmNone, 0, 0, AmAn, 6, 0)
    a68Emit(OpRts, 0, AmNone, 0, 0, AmNone, 0, 0)
}

// ================================================================
// Per-function frame + prologue/epilogue
// ================================================================

// cgEmitFunc lays out and emits one reachable function's frame (params
// above A6, locals below -- see the file header's worked example) plus a
// LINK/UNLK+RTS bracket around a single TODO-body placeholder comment.
func cgEmitFunc(f: int) {
    var declared: map of int
    var nm: string
    var loc: int
    var runningNeg: int
    var sz: int
    var frameSize: int
    var params: list of int
    var paramOffsets: list of int
    var offset: int
    var needsHidden: bool
    var i: int
    var p: int
    var frameNames: list of string
    var frameOffsets: list of int
    var frameNameIdxs: list of int
    var frameIsRef: list of bool
    var recLocalOffsets: list of int
    var recLocalTypes: list of int
    var recLocalNoBirth: list of bool
    var tmpOffs: list of int
    var bigTmpOffs: list of int
    var startIdx: int

    // Task 9 (toolbox-integration Feature C): the hand-built LDEF/
    // scrollbar-action pascal glue stubs this by-name block used to
    // dispatch to (two empty-bodied synthesized-IRFunc placeholders, one
    // hand-built emitter each) are gone -- rtUiLdefDraw/
    // rtUiScrollbarAction migrated onto `callback func`, so their glue
    // now flows through the signature-driven cgCbGlueBodyFor/
    // cgEmitCallbackGlue path just below, same as every other callback.
    //
    // Task 8 (toolbox-integration Feature C): cg68SynthCbGlue's own
    // "clar_cb_<name>" synthetic glue funcs, recognized by lookup table
    // rather than a name-prefix string check (cgCbGlueBodyFor) since the
    // whole point of this generator is to be signature-driven, not
    // name-driven.
    if cgCbGlueBodyFor(f) != -1 {
        cgEmitCallbackGlue(f, cgCbGlueBodyFor(f))
        return
    }

    // peephole68k: capture where this function's items start; peepFunc
    // rewrites exactly this tail after the body is emitted (glue funcs
    // above are hand-shaped and skipped deliberately).
    startIdx = a68Items.count

    if a68ListingOn {
        a68Comment("func " + poolGet(irFuncName(f)) + "  (JT slot " + numToStr(cgJtSlot(f)) + ")")
    } else {
        a68CommentMarker()
    }
    frameNames = cgFreshStringList()
    frameOffsets = cgFreshIntList()
    frameNameIdxs = cgFreshIntList()
    frameIsRef = cgFreshBoolList()
    recLocalOffsets = cgFreshIntList()
    recLocalTypes = cgFreshIntList()
    recLocalNoBirth = cgFreshBoolList()

    // ---- params: collect in declaration order, then assign offsets in
    // REVERSE (the last-declared param is pushed last, so it lands at the
    // lowest offset, 8(A6) or 12(A6) with a hidden result pointer -- see
    // the file header's worked example) ----
    params = cgFreshIntList()
    p = irFuncParamsHead(f)
    while p != -1 {
        params.add(p)
        p = irLocalNext(p)
    }
    paramOffsets = cgFreshIntList()
    i = 0
    while i < params.count {
        paramOffsets.add(0)
        i = i + 1
    }
    // Task 14.7 fix (review round 2: factored into the single
    // cgRetNeedsHidden authority, below -- was inline here, and again in
    // cgCallFnScalar's own matching guard; see
    // cgRetNeedsHidden's own doc comment for the ABI-mismatch bug this
    // guards against).
    needsHidden = cgRetNeedsHidden(irFuncRet(f))
    if needsHidden {
        offset = 12
    } else {
        offset = 8
    }
    i = params.count - 1
    while i >= 0 {
        // param-abi phase, Task 6: cgArgSlotSize, NOT cgSlotSizeOf -- a
        // KStr/KRec param's own FRAME slot holds an ADDRESS now (4 bytes),
        // regardless of the value's true size (cgArgSlotSize's own kind
        // test, the cgRetNeedsHidden lesson: never size-test an ABI
        // decision).
        sz = cgArgSlotSize(irLocalType(params[i]))
        paramOffsets[i] = offset
        offset = offset + sz
        i = i - 1
    }
    if needsHidden {
        if a68ListingOn {
            a68Comment("  hidden result ptr : 8(A6)  size 4")
        } else {
            a68CommentMarker()
        }
    }
    i = 0
    while i < params.count {
        if a68ListingOn {
            a68Comment("  param " + poolGet(irLocalName(params[i])) + " : " + numToStr(paramOffsets[i]) + "(A6)  size " + numToStr(cgArgSlotSize(irLocalType(params[i]))))
        } else {
            a68CommentMarker()
        }
        frameNames.add(poolGet(irLocalName(params[i])))
        frameOffsets.add(paramOffsets[i])
        frameNameIdxs.add(irLocalName(params[i]))
        // param-abi phase, Task 6: KStr/KRec params pass BY ADDRESS now --
        // this frame slot HOLDS a pointer, not the value itself. cgExprAddr's
        // EVarRef arm consults this bit to MOVEA (deref) instead of LEA.
        frameIsRef.add(irtKind(irLocalType(params[i])) == KStr or irtKind(irLocalType(params[i])) == KRec)
        i = i + 1
    }

    // ---- locals: declaration order, contiguous negative offsets,
    // deduped by (name, same type) exactly like cpEmitFunc's C hoist ----
    runningNeg = 0
    loc = irFuncLocalsHead(f)
    while loc != -1 {
        nm = poolGet(irLocalName(loc))
        if declared.has(nm) {
            if not cg68TypeEqual(declared.get(nm, -1), irLocalType(loc)) {
                abort("cg68k: local " + nm + " redeclared with a different type in func " + poolGet(irFuncName(f)) + " (unsupported: same name, different type, in sibling scopes)")
            }
        } else {
            declared[nm] = irLocalType(loc)
            sz = cgSlotSizeOf(irLocalType(loc))
            runningNeg = runningNeg - sz
            if a68ListingOn {
                a68Comment("  local " + nm + " : " + numToStr(runningNeg) + "(A6)  size " + numToStr(sz))
            } else {
                a68CommentMarker()
            }
            frameNames.add(nm)
            frameOffsets.add(runningNeg)
            frameNameIdxs.add(irLocalName(loc))
            // A local's own slot always holds its VALUE directly, never a
            // param's borrowed address -- LEA, not MOVEA (cgExprAddr).
            frameIsRef.add(false)
            // Task 16 fix: EVERY local gets its own default-init at
            // function entry, unconditionally -- mirrors cpEmitFunc's own
            // unconditional per-local cpDefaultInit call (cprint.cla:3636)
            // exactly, for every IRKind, not just the five container-ish
            // kinds this gate used to cover. History: Task 12 scoped this
            // to KRec only (a record local's field defaults, needed
            // because lowCountedStoreRecVal's ARC scratch temp is
            // release-walked on its very first use -- an unconstructed
            // value there reads stack garbage as a handle pointer); Task 13
            // widened it to KText/KList/KMap for the identical
            // release-walk hazard (reproduced empirically: pre-fix,
            // smoke.cla's container section hung the emulator on its very
            // first l.push, reading garbage as a box pointer); Task 14.7
            // widened it to KErr (`var e: error`'s `.code`/`.message` must
            // read 0/"" before assignment). Every widening was reactive,
            // chasing one more kind that turned out to matter -- language
            // semantics guarantee EVERY local its zero value (Ch3), not
            // just handle-bearing ones, and cgDefaultInitAt already
            // handles every IRKind correctly (KInt/KBool/KFixed/KChar/
            // KEnum/KPtr/KWinRef/KOverlay/KStr/KArr, not just the five
            // above) -- it was simply never called for the rest. Found by
            // Task 16's end gate: emit_array.cla's own "int array
            // zero-init"/"char array zero-init" checks read stack garbage
            // and failed, and a same-shape bare-scalar probe (`var i:
            // int`, unwritten) confirmed scalars were equally unzeroed --
            // almost certainly the root cause of TestSuiteOn68k's 15-minute
            // hang too (same class of bug the Task 13 comment above already
            // reproduced once: stack garbage feeding a container/loop
            // operation hangs the emulator rather than crashing cleanly).
            // memory-leak-fix Task 3: one exception to "every local
            // default-inits" -- a local flagged irLocalNoBirth (lowering's
            // synthetic __store temp: Task 2) skips the birth-call default
            // entirely in favor of a plain zero (see the prologue loop
            // below and cgZeroInitAt), mirroring cpEmitFunc's own
            // irLocalNoBirth arm (cprint.cla:4865) -- see
            // docs/superpowers/plans/2026-08-12-memory-leak-fix.md for the
            // full rationale.
            recLocalOffsets.add(runningNeg)
            recLocalTypes.add(irLocalType(loc))
            recLocalNoBirth.add(irLocalNoBirth(loc))
        }
        loc = irLocalNext(loc)
    }

    // ---- Task 13: the statement-temp pool (cgTmpSlots anonymous 4-byte
    // slots) + the container deep-release-walk scratch (cgDeepLevels
    // {ptr,count,index,value} quadruples) -- reserved below every named
    // local, same contiguous-negative-offset discipline, unconditionally
    // (cheap; ignored cost if this function never uses container ARC at
    // all). See this file's own Task 13 module-state doc comment for why
    // these live on the A6 frame rather than the real machine stack.
    tmpOffs = cgFreshIntList()
    i = 0
    while i < cgTmpSlots {
        runningNeg = runningNeg - 4
        tmpOffs.add(runningNeg)
        i = i + 1
    }
    cgTmpBaseOffs = tmpOffs

    // Task 14.7: the big (str/rec) scratch pool, same contiguous-negative-
    // offset discipline, reserved unconditionally right after the small
    // pool (cheap; ignored cost if this function never materializes a
    // str/rec temp at all -- same "cheap if unused" philosophy this file's
    // own Task 13 doc comment already uses for cgTmpSlots).
    bigTmpOffs = cgFreshIntList()
    i = 0
    while i < cgBigTmpSlots {
        runningNeg = runningNeg - cgBigTmpSize
        bigTmpOffs.add(runningNeg)
        i = i + 1
    }
    cgBigTmpBaseOffs = bigTmpOffs
    cgStmtBigTmpNext = 0

    runningNeg = cgReserveDeepScratch(runningNeg)
    frameSize = 0 - runningNeg
    cgFuncFrameSizes[f] = frameSize
    cgStmtTmpOffs = cgFreshIntList()
    cgStmtTmpType = cgFreshIntList()
    cgStmtTmpNext = 0

    // ---- Task 8: real body -- see cgStmt/cgExpr below for the per-node
    // codegen. cgCurFrameNames/Offsets, cgCurHiddenOffset/RetType, and the
    // loop label stacks are all per-function state, rebuilt/reset here
    // before cgStmts walks the body.
    cgCurFrameNames = frameNames
    cgCurFrameOffsets = frameOffsets
    cgCurFrameNameIdxs = frameNameIdxs
    cgCurFrameIsRef = frameIsRef
    cgCurHiddenOffset = -1
    if needsHidden {
        cgCurHiddenOffset = 8
    }
    cgCurRetType = irFuncRet(f)
    cgLoopBreakLabels = cgFreshIntList()
    cgLoopContinueLabels = cgFreshIntList()
    cgCurEpilogueLabel = a68NewLabel()

    // attempt-abort phase Task 4 (design doc %3.2/%3.3): per-function
    // bail state, reset here alongside cgCurEpilogueLabel -- mirrors
    // cprint.cla's own fpReset (called once per function too).
    // cgCurFuncHasBail mirrors fpCurFuncHasBail exactly: true only when
    // lowering (Task 2) actually built a real bail chain for f. Never
    // true for a runtime-origin function (lowFuncBody only builds one for
    // non-runtime-origin functions) and never true for a lowering-
    // synthesized UI dispatcher either (those are built via newIRFunc
    // directly, never through lowFuncBody -- see cgAbortCheckAfterCall's
    // own doc comment for how that case is handled instead).
    // cgCurFuncIsUiDispatcher reuses cgSeveredFamily's own existing
    // by-name classification (family 1, "the reverse-waist UI dispatcher
    // family") rather than re-deriving a second name-prefix test.
    cgBailDepth = 0
    cgBailUsed = false
    cgCurFuncHasBail = irFuncBail(f) != -1
    cgCurFuncIsUiDispatcher = cgSeveredFamily(poolGet(irFuncName(f))) == 1

    a68Bind(cgFuncLabels[f])
    a68Emit(OpLink, 0, AmNone, 0, 0, AmAn, 6, 0 - frameSize)
    i = 0
    while i < recLocalOffsets.count {
        if recLocalNoBirth[i] {
            cgZeroInitAt(6, recLocalOffsets[i], recLocalTypes[i])
        } else {
            cgDefaultInitAt(6, recLocalOffsets[i], recLocalTypes[i], 0, -1)
        }
        i = i + 1
    }
    cgStmts(irFuncBodyHead(f))
    // attempt-abort phase Task 4 (Ruling): the bail block comes from
    // lowering (irFuncBail(f)) -- emitted here, once, as a label whose
    // body is the block's own releases + default return, immediately
    // before the ordinary epilogue. Bound ONLY when cgBailUsed is true
    // (cgFuncBailLabel's lazy allocation -- see its own doc comment for
    // why an a68 label can never be allocated unless it will also be
    // bound): a function whose OWN body never actually needed to bail
    // (no checked call, no bare abort()) gets zero extra bytes here,
    // even though lowering built the chain unconditionally for every
    // non-runtime-origin function once lowUsesAbort. The chain's own
    // final statement is an ordinary `return <default>`, which
    // cgReturnStmt lowers via the SAME BRA-to-cgCurEpilogueLabel every
    // other return already uses -- no separate "null the result
    // register" step is needed here: a checked call's own BNE always
    // diverts control away before any result register is ever consumed
    // (see cgAbortCheckAfterCall), and this return statement sets
    // whatever default value the function's own return convention
    // expects, exactly like any hand-written return would.
    if cgBailUsed {
        a68Bind(cgBailLbl)
        cgStmts(irFuncBail(f))
    }
    a68Bind(cgCurEpilogueLabel)
    a68Emit(OpUnlk, 0, AmNone, 0, 0, AmAn, 6, 0)
    a68Emit(OpRts, 0, AmNone, 0, 0, AmNone, 0, 0)
    peepFunc(startIdx)
}

// cgCbPascalWidth is the pascal-convention stack-slot width (in bytes) of
// one `callback func` param/return kind -- checkCallbackFunc's own closed
// palette (bool/char/word/int/ptr) is the only input this ever sees.
// bool/char/word all pad to a full stack WORD on the wire (Inside
// Macintosh's own convention, cgCallExtPascal's own header comments);
// int/ptr are a plain LONG. This happens to be numerically IDENTICAL to
// cgSlotSizeOf for this exact palette (see cgEmitCallbackGlue's own doc
// comment for why that coincidence matters), but is kept as its own named
// function: pascal width is a wire-protocol fact, cgSlotSizeOf a
// Clarus-frame-layout fact, and the two are unrelated in general (see
// cgEmitCallbackGlue's own doc comment for the `word` counterexample,
// where a pascal `short` marshals into a 4-byte Clarus slot, not a
// 2-byte one).
func cgCbPascalWidth(t: int): int {
    switch irtKind(t) {
    case KBool, KChar, KWord {
        return 2
    }
    case KInt, KPtr {
        return 4
    }
    }
    abort("cg68k: cgCbPascalWidth: unhandled callback kind " + numToStr(int(irtKind(t))))
    return 0
}

// cgEmitCallbackGlue (Task 8, toolbox-integration Feature C: `callback
// func`) is the signature-driven glue emitter: one glue per
// cg68SynthCbGlue-synthesized "clar_cb_<name>" IRFunc (glueFi), built from
// bodyFi's REAL declared signature (checkCallbackFunc's palette:
// bool/char/word/int/ptr) rather than a hand-copied pascal prototype --
// this is what Task 9 migrated the OLD hand-rolled LDEF/scrollbar-action
// glue emitters (deleted) onto. Per-param/return marshaling table:
//   kind        pascal    Clarus    pascal read (into D0)     Clarus push        result write
//               bytes     bytes
//   bool/char   2         2         CLR.L;MOVE.B (zero-ext,   MOVE.B D0,-(A7)    MOVE.B D0,slot
//                                    high/base byte of the                      (high/base byte)
//                                    padded word)
//   word        2         4         MOVE.W;EXT.L (sign-ext)   MOVE.L D0,-(A7)    MOVE.W D0,slot
//   int/ptr     4         4         MOVE.L                    MOVE.L D0,-(A7)    MOVE.L D0,slot
//
// The pascal/Clarus byte columns are IDENTICAL for bool/char/int/ptr but
// DIVERGE for word (cgCbPascalWidth vs. cgSlotSizeOf) -- this is the one
// non-obvious wrinkle a naive read of the marshaling misses. A `callback
// func`'s own `word`-typed param/return DOES keep real KWord in its own
// irFuncs/IRLocal entry (lower.cla's DkCallbackFunc doc comment:
// lowFuncBody's param loop calls `lowResolveType(paramType(p))` directly
// off the AST, not the checker's own word-folds-to-int `resolveType`) --
// but every ORDINARY EXPRESSION referencing that same param inside the
// body (a bare `n` in `return n`, lowIdent's `ty = lowMustType(e)`) IS the
// checker's folded int type, exactly as checkCallbackFunc's own doc
// comment says ("the checker cannot and need not tell a `word` param
// from a plain `int` one"). Since cgLoadVar/cgStoreScalarVar/cgPushArgs
// all key off an EXPRESSION's irExprType, every read/write/re-push of a
// word param inside ordinary Clarus code already assumes a full 4-byte
// slot -- so cgSizeOf's own KWord case (Task 8) returns 4, not 2, making
// cgEmitFunc's param-offset reservation (cgSlotSizeOf) match what every
// consumer already assumes. This glue's own re-push must match THAT
// 4-byte slot for word (a plain MOVE.L, after the sign-extending EXT.L
// already widened D0), not the pascal wire's 2-byte width --
// cgCbPascalWidth (the wire fact) and cgSlotSizeOf (the Clarus-frame
// fact) are kept as two separate named tables for exactly this reason.
//
// Offsets: params collect in declaration order, then get PASCAL offsets
// assigned in REVERSE (last-declared nearest the frame, 8(A6) -- same
// "pushed last lands lowest" shape cgEmitFunc's own worked example
// establishes), using cgCbPascalWidth. The pascal RESULT slot -- present
// only when bodyFi's return isn't void -- sits ABOVE every arg, at
// 8+pascalTotalBytes: the mirror image of cgCallExtPascal's own
// caller-side "reserve a result slot FIRST, push args after" protocol (a
// PreDec push landing FIRST ends up at the HIGHEST address once every
// later push has also landed), which is exactly the role the Toolbox
// plays calling INTO this glue. clarusTotalBytes (cgSlotSizeOf-summed,
// tracked separately) is what actually gets cleaned up after cgCallFunc
// -- the bytes THIS glue itself pushed to call bodyFi, Clarus convention.
func cgEmitCallbackGlue(glueFi: int, bodyFi: int) {
    var params: list of int
    var pascalWidths: list of int
    var offsets: list of int
    var i: int
    var p: int
    var offset: int
    var pascalTotalBytes: int
    var clarusTotalBytes: int
    var resultOffset: int
    var retTy: int
    var retKind: IRKind
    var pk: IRKind

    if a68ListingOn {
        a68Comment("func " + poolGet(irFuncName(glueFi)) + " (JT slot " + numToStr(cgJtSlot(glueFi)) + ") -- pascal callback glue for " + poolGet(irFuncName(bodyFi)))
    } else {
        a68CommentMarker()
    }
    a68Bind(cgFuncLabels[glueFi])
    a68Emit(OpLink, 0, AmNone, 0, 0, AmAn, 6, 0)

    if not shakeReachable(bodyFi) {
        abort("cg68k: callback body " + poolGet(irFuncName(bodyFi)) + " not reachable (clar_cb_" + poolGet(irFuncName(bodyFi)) + ")")
    }

    params = cgFreshIntList()
    p = irFuncParamsHead(bodyFi)
    while p != -1 {
        params.add(p)
        p = irLocalNext(p)
    }
    pascalWidths = cgFreshIntList()
    offsets = cgFreshIntList()
    i = 0
    while i < params.count {
        pascalWidths.add(cgCbPascalWidth(irLocalType(params[i])))
        offsets.add(0)
        i = i + 1
    }
    offset = 8
    i = params.count - 1
    while i >= 0 {
        offsets[i] = offset
        offset = offset + pascalWidths[i]
        i = i - 1
    }
    pascalTotalBytes = offset - 8
    resultOffset = 8 + pascalTotalBytes

    // ---- read each pascal arg at its fixed A6 offset, re-push Clarus-
    // convention, left to right ----
    clarusTotalBytes = 0
    i = 0
    while i < params.count {
        pk = irtKind(irLocalType(params[i]))
        if a68ListingOn {
            a68Comment("  " + poolGet(irLocalName(params[i])) + " : " + numToStr(offsets[i]) + "(A6)  pascal size " + numToStr(pascalWidths[i]))
        } else {
            a68CommentMarker()
        }
        if pk == KBool or pk == KChar {
            a68Emit(OpClr, 4, AmNone, 0, 0, AmDn, 0, 0)
            a68Emit(OpMove, 1, AmDisp16, 6, offsets[i], AmDn, 0, 0)
            a68Emit(OpMove, 1, AmDn, 0, 0, AmPreDec, 7, 0)
            clarusTotalBytes = clarusTotalBytes + 2
        } else if pk == KWord {
            a68Emit(OpMove, 2, AmDisp16, 6, offsets[i], AmDn, 0, 0)
            a68Emit(OpExt, 4, AmNone, 0, 0, AmDn, 0, 0)
            a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
            clarusTotalBytes = clarusTotalBytes + 4
        } else {
            a68Emit(OpMove, 4, AmDisp16, 6, offsets[i], AmPreDec, 7, 0)
            clarusTotalBytes = clarusTotalBytes + 4
        }
        i = i + 1
    }

    cgCallFunc(bodyFi)
    cgCleanupStack(clarusTotalBytes) // the Clarus-convention args just pushed

    retTy = irFuncRet(bodyFi)
    retKind = irtKind(retTy)
    if retKind != KVoid {
        if retKind == KBool or retKind == KChar {
            a68Emit(OpMove, 1, AmDn, 0, 0, AmDisp16, 6, resultOffset)
        } else if retKind == KWord {
            a68Emit(OpMove, 2, AmDn, 0, 0, AmDisp16, 6, resultOffset)
        } else {
            a68Emit(OpMove, 4, AmDn, 0, 0, AmDisp16, 6, resultOffset)
        }
    }

    a68Emit(OpUnlk, 0, AmNone, 0, 0, AmAn, 6, 0)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmAn, 0, 0)
    cgCleanupStack(pascalTotalBytes) // the pascal caller's own arg bytes
    a68Emit(OpJmp, 0, AmNone, 0, 0, AmInd, 0, 0)
}

// ================================================================
// Task 8: variable resolution
// ================================================================

// cgFindFrameOffset returns nameIdx's A6 offset from the CURRENT
// function's frame table, or cgUnresolved (a sentinel no real offset
// ever equals) if nameIdx isn't a param/local of this function. Findings
// 1.4 (Task 13): scans cgCurFrameNameIdxs with int compares, keyed by
// interned nameIdx directly (index equality already implies string
// equality under the intern-pool invariant -- same one cgRecIdxByName/
// irFuncIdxByName rely on) -- was a per-lookup string scan over
// cgCurFrameNames, on every EVarRef/EXRecAddr codegen'd.
const cgUnresolved: int = 0x7FFFFFFF

func cgFindFrameOffset(nameIdx: int): int {
    var i: int

    i = 0
    while i < cgCurFrameNameIdxs.count {
        if cgCurFrameNameIdxs[i] == nameIdx {
            return cgCurFrameOffsets[i]
        }
        i = i + 1
    }
    return cgUnresolved
}

// cgFindFrameIsRef (param-abi phase, Task 6) is cgFindFrameOffset's own
// by-ref-bit sibling, same linear scan over cgCurFrameNameIdxs (never
// called on a global -- see cgVarIsByRef, its sole caller, below) --
// false for a name not found at all (never actually reached: every
// non-global EVarRef's name IS in the current function's own frame
// tables, checked or not).
func cgFindFrameIsRef(nameIdx: int): bool {
    var i: int

    i = 0
    while i < cgCurFrameNameIdxs.count {
        if cgCurFrameNameIdxs[i] == nameIdx {
            return cgCurFrameIsRef[i]
        }
        i = i + 1
    }
    return false
}

// cgVarIsByRef (param-abi phase, Task 6) reports whether EVarRef e denotes
// a KStr/KRec PARAM slot -- the only frame entries cgEmitFunc ever marks
// true (see cgCurFrameIsRef's own doc comment). A global is never by-ref
// (globals always hold their value directly, Ch13's own by-address ABI is
// param-only) -- checked first, short-circuiting the frame scan.
func cgVarIsByRef(e: int): bool {
    if irVarRefGlobal(e) {
        return false
    }
    return cgFindFrameIsRef(irVarRefName(e))
}

// cgFindGlobalOffset returns nameIdx's A5 offset (cgAssignGlobalOffsets
// must have already run this cg68Program() call), or cgUnresolved.
// Findings 1.4 (Task 13): answers from cgGlobalOffByName (an intmap of
// int keyed by interned nameIdx, built once by cgAssignGlobalOffsets) --
// was a linear scan over ALL irGlobals with a poolGet PER CANDIDATE, on
// every EVarRef/EXRecAddr referencing a global.
func cgFindGlobalOffset(nameIdx: int): int {
    return cgGlobalOffByName.get(nameIdx, cgUnresolved)
}

// cgVarReg/cgVarOff resolve an EVarRef to its base register (5=A5 for a
// global, 6=A6 for a param/local) and displacement -- irVarRefGlobal(e)
// says definitively which table to search, so there's never any ambiguity
// between a same-named global and local (Clarus scoping already resolved
// that at check time; irVarRefGlobal just carries the answer through).
func cgVarReg(e: int): int {
    if irVarRefGlobal(e) {
        return 5
    }
    return 6
}

func cgVarOff(e: int): int {
    var nameIdx: int
    var off: int

    nameIdx = irVarRefName(e)
    if irVarRefGlobal(e) {
        off = cgFindGlobalOffset(nameIdx)
    } else {
        off = cgFindFrameOffset(nameIdx)
    }
    if off == cgUnresolved {
        abort("cg68k: unresolved variable " + poolGet(nameIdx))
    }
    return off
}

// cgXRecAddrReg/cgXRecAddrDisp (Task 6, toolbox-integration Feature B)
// resolve an EXRecAddr node to its base register and displacement -- the
// exact cgVarReg/cgVarOff pair just above, plus EXRecAddr's own extra
// literal byte offset folded straight into the displacement (a single LEA
// then needs no second instruction to add it -- see EXRecAddr's own "flat"
// contract, ir.cla's doc comment: an arbitrarily nested `ev.a.b.c` already
// collapsed to ONE summed offset at lower time, never a chain of
// EXRecAddr/EFieldRef nodes cg68k would otherwise have to walk). Both
// cgExprAddr's and cgExpr's own EXRecAddr arms share this pair, since an
// EXRecAddr's "address" and "value" are the identical computed address --
// there is no separate storage location holding a pointer to dereference,
// unlike a plain ptr-typed EVarRef.
func cgXRecAddrReg(e: int): int {
    if irXRecAddrGlobal(e) {
        return 5
    }
    return 6
}

func cgXRecAddrDisp(e: int): int {
    var nameIdx: int
    var off: int

    nameIdx = irXRecAddrName(e)
    if irXRecAddrGlobal(e) {
        off = cgFindGlobalOffset(nameIdx)
    } else {
        off = cgFindFrameOffset(nameIdx)
    }
    if off == cgUnresolved {
        abort("cg68k: unresolved xrec variable " + poolGet(nameIdx))
    }
    return off + irXRecAddrOffset(e)
}

// cgIsScalarKind reports whether t is a plain <=4-byte value this
// backend moves through D0/a MOVE.<B|L> pair -- everything except the
// three aggregate/deferred kinds (Str's clamped-copy semantics, Rec/Arr's
// by-value block shape -- Task 12/13).
func cgIsScalarKind(k: IRKind): bool {
    // Task 14.7: KErr joins the non-scalar set -- a 260-byte struct
    // (cgSizeOf's own KErr arm), not a 4-byte value a plain MOVE(.B|.L)
    // through D0 can carry (cgIsScalarKind's whole contract). Pre-fix,
    // KErr fell through to `true` here, so `e = lastError`'s SAssign
    // routed into cgEmitStoreScalarAny (a 4-byte move) instead of the
    // dedicated KErr copy cgStmt's SAssign arm now dispatches to.
    if k == KStr or k == KRec or k == KArr or k == KVoid or k == KErr {
        return false
    }
    return true
}

// cgRetNeedsHidden (Task 14.7 review fix) is the SINGLE authority for
// "does a function returning retTy use the hidden-result-pointer calling
// convention" -- a KIND test (KStr/KRec), never a SIZE test. Was three
// independent inline copies (cgEmitFunc's own needsHidden, plus matching
// guards in cgCallFnScalar and cgCallFnInto's own callers); collapsed here
// so a future one-sided edit can't silently reintroduce the caller/
// callee ABI mismatch the kind-vs-size bug was (see cgEmitFunc's own
// needsHidden doc comment for the full account: a `string(3)` return is
// exactly 4 bytes, same size as a scalar int, but every CALLER already
// assumes the hidden-pointer convention for ANY KStr/KRec result
// unconditionally, regardless of size).
func cgRetNeedsHidden(retTy: int): bool {
    return irtKind(retTy) == KStr or irtKind(retTy) == KRec
}

// cgArgSlotSize (param-abi phase, Task 6) is the bytes a call ARGUMENT of
// type t occupies on the stack -- distinct from cgSlotSizeOf (a param's/
// local's/global's own FRAME/storage width): a KStr/KRec argument now
// passes by ADDRESS, always exactly 4 bytes, regardless of the value's
// true size (a KIND test, never a size test -- the same cgRetNeedsHidden
// lesson, and the reason this is its own function rather than folded into
// cgSlotSizeOf, which every OTHER caller still needs to answer "how big is
// the value itself" for -- record-field layout, local/global reservation,
// array-element stride, none of which changed this task).
func cgArgSlotSize(t: int): int {
    if irtKind(t) == KStr or irtKind(t) == KRec {
        return 4
    }
    return cgSlotSizeOf(t)
}

// cgVarRefAt (Task 14.7) wraps a raw A6-relative scratch slot (off(A6) --
// every call site is a per-function temp, never a global, so reg=6 is
// implicit) in a throwaway, uniquely-named synthetic EVarRef: dynamically
// appends (name, off) to the CURRENT function's own frame tables
// (cgCurFrameNames/Offsets -- safe to grow mid-codegen, cgFindFrameOffset
// only ever scans them at a LATER lookup) so cgVarOff/cgVarReg resolve the
// synthetic name exactly like any real local. Lets any dst-taking store
// helper (cgEmitStoreStr/cgEmitStoreRec/cgEmitStoreScalarAny) target a
// scratch slot exactly like a real variable, with no separate reg/off-
// parameterized copy of their dispatch logic needed.
func cgVarRefAt(off: int, t: int): int {
    var nm: string
    var nameIdx: int

    nm = "__cg68scratch" + numToStr(cgSyntheticVarSeq)
    cgSyntheticVarSeq = cgSyntheticVarSeq + 1
    nameIdx = intern(nm)
    cgCurFrameNames.add(nm)
    cgCurFrameOffsets.add(off)
    cgCurFrameNameIdxs.add(nameIdx)
    // A synthetic scratch slot always holds its value directly (a real
    // A6-relative temp, never a borrowed param address) -- never by-ref.
    cgCurFrameIsRef.add(false)
    return newIRVarRef(nameIdx, false, t)
}

// cgMaterializeToTemp (Task 14.7) materializes e's value into a fresh
// scratch temp (cgAllocTmpOff -- the small pool for a scalar-kind result,
// the big pool for KStr/KRec) and returns an addressable EVarRef bound to
// it. This is cgExprAddr's own fallback for any expr kind with no OTHER
// address (ECallFn/EIntr/EBin/etc): every value-producing shape this
// backend can construct at all can construct into SOME destination
// (cgEmitStoreRec/cgEmitStoreStr/cgEmitStoreScalarAny between them cover
// every src kind those three already dispatch on -- ENewRec, ECallFn,
// str_concat/str_coerce/lasterr_msg/file_name/list-map-read-family, and
// any plain scalar expr), so cgExprAddr never needs to fail for a real
// value -- it just recurses once more into the (trivially addressable)
// EVarRef this returns.
func cgMaterializeToTemp(e: int): int {
    var t: int
    var off: int
    var dst: int

    t = irExprType(e)
    off = cgAllocTmpOff(t)
    dst = cgVarRefAt(off, t)
    if irtKind(t) == KRec {
        cgEmitStoreRec(dst, e)
    } else if irtKind(t) == KStr {
        cgEmitStoreStr(dst, e)
    } else {
        cgEmitStoreScalarAny(dst, e)
    }
    return dst
}

// ================================================================
// Task 8: cgExprAddr -- address of e into A0 (str/record/lvalue shapes).
// ================================================================

func cgExprAddr(e: int) {
    var k: IRExprKind

    k = irExprKind(e)
    if k == EVarRef {
        // param-abi phase, Task 6: a KStr/KRec PARAM's own frame slot
        // holds the caller's ADDRESS, not the value -- MOVEA (dereference)
        // instead of LEA (address-of-slot). Every other EVarRef (locals,
        // globals, scalar/handle-kind params) is unchanged: cgVarIsByRef
        // is false for all of them, so this degrades to the original LEA.
        if cgVarIsByRef(e) {
            a68Emit(OpMovea, 4, AmDisp16, cgVarReg(e), cgVarOff(e), AmAn, 0, 0)
        } else {
            a68Emit(OpLea, 0, AmDisp16, cgVarReg(e), cgVarOff(e), AmAn, 0, 0)
        }
    } else if k == EStrConst {
        a68Emit(OpLea, 0, AmPCLabel, 0, cgPoolStrRef(irStrConstIdx(e)), AmAn, 0, 0)
    } else if k == EFieldRef {
        cgFieldRefAddr(e)
    } else if k == EIndexRef {
        cgIndexRefAddr(e)
    } else if k == EXRecAddr {
        // Task 6 (toolbox-integration Feature B): a single LEA, base
        // register + folded displacement (cgXRecAddrReg/cgXRecAddrDisp) --
        // see EXRecAddr's own IRExprKind doc comment (ir.cla) for why this
        // is always exactly one instruction, never a chain.
        a68Emit(OpLea, 0, AmDisp16, cgXRecAddrReg(e), cgXRecAddrDisp(e), AmAn, 0, 0)
    } else if k == EIntr and irIntrName(e) == IUiValueAtPtr() {
        // Task 14 (native-5e gate, opendoc.cla): `*(T *)(a0)` -- unlike
        // every OTHER EIntr (a COMPUTED value with no existing storage,
        // needing the generic materialize-to-temp fallback below), this
        // one's whole point is a raw pointer dereference: the VALUE's
        // address IS simply a0's own value, already a real address
        // (lowSynthLaunchDoc's own synthesized `handler_App_openDocument
        // (ui_value_at_ptr(path))` glue -- `path` is the launch pre-scan's
        // own scratch buffer pointer). No copy/materialization needed at
        // all.
        cgExpr(irIntrArgsHead(e))
        a68Emit(OpMovea, 4, AmDn, 0, 0, AmAn, 0, 0)
    } else {
        // A call/intr/other value-producing result -- task-12-review's
        // Important finding: this USED TO degrade to a deterministic
        // placeholder (LEA $0000.W,A0, address 0) rather than crash the
        // compile, which silently produced GARBAGE (not a diagnostic) for
        // any caller that then read/copied through it -- reproduced by
        // `recsSum(recsMake(555))` in recs.cla, where the inner call was
        // dropped entirely and the outer call received 76 bytes read from
        // absolute address 0. Task 14.7 (gap-closure): rather than
        // requiring every caller to special-case materialization before
        // ever reaching here (cgPushArgs' own KStr/KRec dispatch still
        // does, for its own reserved-arg-slot reasons), cgExprAddr now
        // materializes ANY such expr into a fresh scratch temp itself
        // (cgMaterializeToTemp) and recurses -- covers str_cmp/alert/log
        // arguments, non-addressable map keys, and any other spot this
        // file calls cgExprAddr on a value-producing (not already-stored)
        // expr, in one place, generically.
        cgExprAddr(cgMaterializeToTemp(e))
        return
    }
}

// cgFieldRefAddr resolves an EFieldRef's address into A0: X.Kind decides
// whether X's OWN value already IS the base address (KOverlay -- a real
// pointer, file header's own "unlike KRec's by-value struct" note) or
// needs address-OF (KRec -- a by-value struct, the plain/common case,
// including a record field whose OWN type is KRec, i.e. nested field
// access, which just recurses: cgExprAddr(irFieldRefX(e)) calls back into
// THIS function again when X is itself an EFieldRef). Either way,
// cgFieldOffset(recNameIdx, fieldName) -- the SAME layout-authority walk
// cgSizeOf(KRec)/cgRecordSize/every ctor-walk above already uses -- gives
// the field's displacement, added via a plain LEA off(A0),A0.
func cgFieldRefAddr(e: int) {
    var baseT: int
    var recNameIdx: int
    var off: int
    var fieldName: string
    var winIdx: int

    baseT = irExprType(irFieldRefX(e))
    if irtKind(baseT) == KOverlay or irtKind(baseT) == KUiState {
        // KUiState (Task 12, native-5e): a window instance's per-
        // instance state-struct field (`g.x`) -- X is an IUiState
        // intrinsic call (or, transitively, another KUiState-typed
        // expr), whose OWN result value already IS the base address
        // (rtUiState's return), same "value is the address" shape
        // KOverlay already established -- NOT address-of.
        cgExpr(irFieldRefX(e))
        a68Emit(OpMovea, 4, AmDn, 0, 0, AmAn, 0, 0)
    } else {
        cgExprAddr(irFieldRefX(e))
    }
    if irtKind(baseT) == KUiState {
        // A window's per-instance state fields (window { var ... }) live
        // in irWindowDescStateFieldsHead, never irRecords -- cgFieldOffset/
        // cgFindRecordByName's registry has no entry for a window's own
        // name, so this needs its own walk (cgUiStateFieldOffset, the
        // SAME field-chain layout uiblob.cla's uibStateSize computes for
        // the blob's own stateSize field, cg68k's own LAYOUT AUTHORITY
        // primitives reused verbatim).
        winIdx = cpFindWindowIndex(poolGet(irtName(baseT)))
        if winIdx == -1 {
            abort("cg68k: unknown window " + poolGet(irtName(baseT)))
        }
        off = cgUiStateFieldOffset(winIdx, irFieldRefName(e))
        if off == -1 {
            abort("cg68k: unknown state field " + poolGet(irFieldRefName(e)) + " on " + poolGet(irtName(baseT)))
        }
        a68Emit(OpLea, 0, AmDisp16, 0, off, AmAn, 0, 0)
        return
    }
    if irtKind(baseT) == KErr {
        // Task 14.7: `error` (KErr) is a builtin fixed-layout struct, not
        // a user-declared record -- irtName(baseT) is -1 (irSimpleType's
        // own "no name" convention), so cgFieldOffset's cgFindRecordByName
        // scan would call poolGet(-1) and crash (`runtime error: list
        // index out of range`, reproduced by `var e: error; e.code == 0`
        // on this branch pre-fix). Hardcode the same two offsets
        // cgSizeOf(KErr)/cgErrMsgOff already establish (code=0,
        // message=cgErrMsgOff()) instead of consulting the record
        // registry at all.
        fieldName = poolGet(irFieldRefName(e))
        if fieldName == "code" {
            off = 0
        } else if fieldName == "message" {
            off = cgErrMsgOff()
        } else {
            abort("cg68k: unknown field " + fieldName + " on error")
        }
        a68Emit(OpLea, 0, AmDisp16, 0, off, AmAn, 0, 0)
        return
    }
    recNameIdx = irtName(baseT)
    off = cgFieldOffset(recNameIdx, irFieldRefName(e))
    if off == -1 {
        abort("cg68k: unknown field " + poolGet(irFieldRefName(e)) + " on " + poolGet(recNameIdx))
    }
    a68Emit(OpLea, 0, AmDisp16, 0, off, AmAn, 0, 0)
}

// cgUiStateFieldOffset (Task 12, native-5e) walks window winIdx's own
// state-field chain (irWindowDescStateFieldsHead) computing
// fieldNameIdx's byte offset -- the SAME cgAlignOf/cgSlotSizeOf walk
// uiblob.cla's uibStateSize runs (that function's own doc comment: "this
// is NOT cgRecordSize itself... a window's per-instance vars are never an
// irRecords entry"), just stopping at the matching field instead of
// running to the end. -1 if fieldNameIdx isn't one of winIdx's own state
// fields, matching cgFieldOffset's own not-found contract.
//
// TODO cross-link: this is a SEPARATE copy of uibStateSize's own loop
// (uiblob.cla), not a shared call -- the two must be kept in sync by
// hand; no runtime assert exists on the native lane to catch a future
// divergence (deliberate, low risk -- see uibStateSize's own doc comment
// for the same note from the other side).
func cgUiStateFieldOffset(winIdx: int, fieldNameIdx: int): int {
    var f: int
    var cur: int
    var t: int

    cur = 0
    f = irWindowDescStateFieldsHead(winIdx)
    while f != -1 {
        t = irFieldSlotType(f)
        cur = cgAlignUp(cur, cgAlignOf(t))
        if irFieldSlotName(f) == fieldNameIdx {
            return cur
        }
        cur = cur + cgSlotSizeOf(t)
        f = irFieldSlotNext(f)
    }
    return -1
}

// cgIndexRefAddr implements fpIndexRef's own addressing contract (the
// brief's four ADDRESSING sites: this is site 1) for both an Arr (a
// compile-time-bounded, bounds-checked plain block index) and a List (a
// runtime-bounded, bounds-checked backing-store index) -- ir.cla's own
// IndexRef node serves both, disambiguated by X's own IR type. Leaves the
// element's address in A0.
func cgIndexRefAddr(e: int) {
    var xt: int

    xt = irExprType(irIndexRefX(e))
    if irtKind(xt) == KArr {
        cgArrElemAddr(e, xt)
    } else if irtKind(xt) == KList {
        cgListElemAddr(e)
    } else {
        abort("cg68k: cgIndexRefAddr: EIndexRef on non-Arr/List type")
    }
}

// cgArrElemAddr: X's own address (cgExprAddr, recurses for a nested
// EFieldRef/EIndexRef base), bounds-checked via a real JSR to core.cla's
// rtArrCheck (mirrors fpIndexRef's own cpCorePorted redirect -- Arr, UNLIKE
// List, already calls the ported wrapper even at this addressing site;
// list.cla's own module header comment is explicit that only List's four
// sites stay bare), then scaled by cgArrElemStride(elem) -- an Arr element
// lives at the SAME stride cgArrDefaultAt/cgSizeOf(KArr) already establish
// (the file header's own "LAYOUT AUTHORITY" rule, NOT List's own
// cgSizeOf-only convention -- see cgListElemAddr's own doc comment for why
// List differs).
func cgArrElemAddr(e: int, xt: int) {
    var elemT: int
    var args: list of int
    var addrs: list of bool

    cgExprAddr(irIndexRefX(e))
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    elemT = irtElem(xt)
    args = cgFreshIntList()
    args.add(irIndexRefI(e))
    args.add(newIRIntConst(irtN(xt), irIntT))
    addrs = cgFreshBoolList()
    addrs.add(false)
    addrs.add(false)
    if not cgCallRuntime(rnArrCheck, args, addrs) {
        abort("cg68k: cgArrElemAddr: rtArrCheck call failed")
    }
    a68Emit(OpMove, 4, AmDn, 0, 0, AmDn, 1, 0)
    a68Emit(OpMove, 4, AmImm, 0, cgArrElemStride(elemT), AmDn, 0, 0)
    a68EmitBr(OpBsr, 0, cgMul32Label())
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 1, 0)
    a68Emit(OpAdda, 4, AmDn, 0, 0, AmAn, 1, 0)
    a68Emit(OpMovea, 4, AmAn, 1, 0, AmAn, 0, 0)
}

// cgListElemAddr is rtListAt's own body (list.cla:283-295), inlined --
// list.cla's own module header comment: this is one of the four addressing
// sites that stay bare rather than redirect through the ARC-walk-internal
// ported wrapper, mirrored here as genuinely inline 68k rather than a JSR
// to rtListAt itself (the brief's own explicit "bounds check inline (CMP
// count, BCC/BHI to a panic call), then scaled index" instruction).
//
// x's value (the list's own box pointer, NOT its address -- List is
// cgIsScalarKind, so a bare cgExpr already resolves an EVarRef/EFieldRef
// list operand correctly) is stashed across the index evaluation via the
// real machine stack (cgCompare's own D1=left/D0=right push/pop
// precedent), then the RtList overlay's own field offsets drive the rest
// (list.cla's own overlay record: rc@0, data@4, elemsize@8, count@12,
// cap@16):
//   - bounds check: a SINGLE unsigned compare against count@12(box) --
//     CMP.L 12(A0),D0 (flags = i - count) then BCC/HS (unsigned
//     "higher-or-same"), which catches BOTH i<0 (a negative i's bit
//     pattern is a huge UNSIGNED value, always >= count) and i>=count in
//     one shot -- rtArrCheck's own two-sided `i<0 or i>=n` becomes this
//     one unsigned trick, matching the brief's own "BCC" wording exactly.
//   - element size: elemsize@8(box) -- read from the BOX itself, not
//     recomputed from cgSizeOf(elem) independently, so addressing can
//     NEVER drift from whatever birth (cgEmitContainerBirthCall) actually
//     stored there -- the file header's own element-size-consistency rule,
//     satisfied by construction rather than by trusting two independent
//     computations to agree.
//   - master pointer: data@4(box) is a Handle -- ONE level of indirection
//     (MOVEA (Ax),Ay), matching ListHandleDeref's own `inline deref`
//     extern clause (cgCallExtDeref's identical shape) and Mac OS's own
//     Handle semantics.
// cgListAddrFromRegs is cgListElemAddr's own shared tail, factored out so
// the container-intrinsic arms below (list_remove's old-value read,
// list_set(_retain)'s element ref -- the brief's other two List addressing
// sites) can reuse the SAME inline bounds-check/deref/scale sequence
// against l/i values THEY already evaluated once and stashed themselves
// (never re-evaluating a side-effecting index/list expression a second
// time -- mirrors fpIndexRef's own l/s0 "computed once, reused" discipline
// at those two call sites). Precondition: D1 = list ptr, D0 = index.
// Leaves the element's address in A0.
func cgListAddrFromRegs() {
    var oobLbl: int
    var okLbl: int

    a68Emit(OpMovea, 4, AmDn, 1, 0, AmAn, 0, 0)
    oobLbl = a68NewLabel()
    okLbl = a68NewLabel()
    a68Emit(OpCmp, 4, AmDisp16, 0, 12, AmDn, 0, 0)
    a68EmitBr(OpBcc, 4, oobLbl) // CC/HS: unsigned i>=count -> oob
    a68EmitBr(OpBra, 0, okLbl)
    a68Bind(oobLbl)
    cgEmitPanic(cgListOobMsgIdx)
    a68Bind(okLbl)

    a68Emit(OpMove, 4, AmDn, 0, 0, AmDn, 1, 0)
    a68Emit(OpMove, 4, AmDisp16, 0, 8, AmDn, 0, 0)
    a68EmitBr(OpBsr, 0, cgMul32Label())
    a68Emit(OpMove, 4, AmDn, 0, 0, AmDn, 2, 0)
    a68Emit(OpMovea, 4, AmDisp16, 0, 4, AmAn, 1, 0)
    a68Emit(OpMovea, 4, AmInd, 1, 0, AmAn, 0, 0)
    a68Emit(OpAdda, 4, AmDn, 2, 0, AmAn, 0, 0)
}

func cgListElemAddr(e: int) {
    cgExpr(irIndexRefX(e))
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(irIndexRefI(e))
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 1, 0)
    cgListAddrFromRegs()
}

// ================================================================
// Task 8: cgExpr -- evaluate e into D0 (see the evaluation-discipline
// doc comment at this file's Task 8 module-state block, above).
// ================================================================

func cgLoadVar(e: int) {
    var sz: int
    var reg: int
    var off: int

    sz = cgSizeOf(irExprType(e))
    reg = cgVarReg(e)
    off = cgVarOff(e)
    if sz == 1 {
        // bool/char: zero-extend (both are unsigned 0-255/0-1 values,
        // Ch3) -- CLR.L first so D0's upper 3 bytes can't carry stale
        // garbage from whatever used D0 last, then MOVE.B the one real
        // byte into the low byte.
        a68Emit(OpClr, 4, AmNone, 0, 0, AmDn, 0, 0)
        a68Emit(OpMove, 1, AmDisp16, reg, off, AmDn, 0, 0)
    } else {
        a68Emit(OpMove, 4, AmDisp16, reg, off, AmDn, 0, 0)
    }
}

func cgStoreScalarVar(dst: int) {
    var sz: int
    var reg: int
    var off: int

    sz = cgSizeOf(irExprType(dst))
    reg = cgVarReg(dst)
    off = cgVarOff(dst)
    if sz == 1 {
        a68Emit(OpMove, 1, AmDn, 0, 0, AmDisp16, reg, off)
    } else {
        a68Emit(OpMove, 4, AmDn, 0, 0, AmDisp16, reg, off)
    }
}

// cgLoadFieldScalar loads a scalar-kind EFieldRef's VALUE into D0:
// cgExprAddr(e) resolves the field's address into A0 (cgFieldRefAddr,
// above -- handles arbitrarily nested EFieldRef.X too), then a plain
// MOVE(.B zero-extended via CLR.L first, or .L) reads through it, mirroring
// cgLoadVar's own size dispatch.
func cgLoadFieldScalar(e: int) {
    var sz: int

    sz = cgSizeOf(irExprType(e))
    cgExprAddr(e)
    if sz == 1 {
        a68Emit(OpClr, 4, AmNone, 0, 0, AmDn, 0, 0)
        a68Emit(OpMove, 1, AmInd, 0, 0, AmDn, 0, 0)
    } else {
        a68Emit(OpMove, 4, AmInd, 0, 0, AmDn, 0, 0)
    }
}

// cgEmitStoreScalarAny stores src's value into ANY scalar-kind dst
// (EVarRef or EFieldRef): evaluates src into D0 first, THEN resolves dst's
// address -- never the other way around, since cgExprAddr's own A0/D0/D1
// scratch use (cgFieldRefAddr's base-expr recursion in particular) would
// otherwise clobber an already-computed src sitting in D0. The EVarRef arm
// reuses cgStoreScalarVar UNCHANGED (byte-identical to every existing
// SAssign golden) rather than routing it through the generic
// push/cgExprAddr/pop/store sequence the EFieldRef arm needs.
func cgEmitStoreScalarAny(dst: int, src: int) {
    var sz: int

    cgExpr(src)
    if irExprKind(dst) == EVarRef {
        cgStoreScalarVar(dst)
        return
    }
    sz = cgSizeOf(irExprType(dst))
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(dst)
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 0, 0)
    if sz == 1 {
        a68Emit(OpMove, 1, AmDn, 0, 0, AmInd, 0, 0)
    } else {
        a68Emit(OpMove, 4, AmDn, 0, 0, AmInd, 0, 0)
    }
}

// cgEmitStoreRec stores a KRec-typed src into dst (EVarRef or EFieldRef,
// the by-value record copy sites this task builds: assign, param-default,
// global-init, field-of-record -- record RETURN is cgEmitReturnRec,
// below): an ENewRec src constructs DIRECTLY into dst's own address (no
// intermediate temp+copy -- cgExprAddr(dst) leaves dst's address in A0,
// exactly the (reg=0, off=0) shape cgRecordCtorAt needs); an ECallFn src
// already writes straight into dst via the existing, kind-agnostic
// cgCallFnInto (hidden-result-pointer convention, Task 8); anything else
// addressable (EVarRef/EFieldRef of Rec type) block-copies cgSizeOf(t)
// bytes, src's address first (A0, stashed on the stack across dst's own
// address computation -- same clobber-avoidance discipline
// cgEmitStoreScalarAny's doc comment explains) then dst's (A1).
func cgEmitStoreRec(dst: int, src: int) {
    var sk: IRExprKind
    var nm: string
    var sz: int

    sk = irExprKind(src)
    if sk == ENewRec {
        cgExprAddr(dst)
        cgRecordCtorAt(0, 0, irNewRecName(src))
        return
    }
    if sk == ECallFn {
        cgCallFnInto(src, dst)
        return
    }
    if sk == EIntr {
        // Task 14.7: a KRec list/map element read (`popped = lst.pop()`,
        // `r = m.get(k, dv)`, etc, `lst of RCItem`) -- mirrors
        // cgEmitStoreStr's own list/map read-family arms exactly, just
        // targeting a KRec-sized block copy instead of a clamped str
        // copy. Without this arm, an EIntr src here fell through to the
        // generic block-copy tail below, which cgExprAddr's (with no
        // OTHER address) own fallback would materialize via
        // cgMaterializeToTemp -> cgEmitStoreRec AGAIN with the SAME src
        // -- infinite re-materialization, observed as the big-temp pool
        // exhausting (arc_rec_copy.cla's `popped = lst.pop()`).
        nm = poolGet(irIntrName(src))
        if nm == "list_pop" or nm == "list_shift" {
            cgCopyScratchToDst(cgIntrListPopLike(src, nm), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "list_first" or nm == "list_last" {
            cgCopyScratchToDst(cgIntrListFirstLast(src, nm), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "map_get" {
            cgCopyScratchToDst(cgIntrMapGet(src, false), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "map_get_dv" or nm == "map_get_dv_birth" {
            cgCopyScratchToDst(cgIntrMapGetDv(src, nm == "map_get_dv_birth", false), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "sortedmap_get" {
            cgCopyScratchToDst(cgIntrMapGet(src, true), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "sortedmap_get_dv" or nm == "sortedmap_get_dv_birth" {
            cgCopyScratchToDst(cgIntrMapGetDv(src, nm == "sortedmap_get_dv_birth", true), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "intmap_get" {
            cgCopyScratchToDst(cgIntrIntMapGet(src), dst, cgSizeOf(irExprType(dst)))
            return
        }
        if nm == "intmap_get_dv" or nm == "intmap_get_dv_birth" {
            cgCopyScratchToDst(cgIntrIntMapGetDv(src, nm == "intmap_get_dv_birth"), dst, cgSizeOf(irExprType(dst)))
            return
        }
        abort("cg68k: cgEmitStoreRec: intrinsic " + nm + " unsupported in store context")
    }
    sz = cgSizeOf(irExprType(dst))
    cgExprAddr(src)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(dst)
    a68Emit(OpMovea, 4, AmAn, 0, 0, AmAn, 1, 0)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 0, 0)
    cgBlockCopy(sz)
}

// cgEmitStoreErr (Task 14.7) mirrors cgEmitStoreRec's own shape for a KErr
// dst: the only src this backend's fixtures ever produce is EIntr
// "lasterr_value" (`e = lastError`, ir.cla's ILastErr -- lower.cla's own
// "no VarRef for the bare global lastError" doc comment) -- materialized
// field-by-field via the SAME natLastErrCode/natLastErrMsg calls
// cgIntr's "lasterr_code" arm and cgEmitStoreStr's "lasterr_msg" arm
// already use, rather than one combined runtime call (native.cla has no
// single "give me the whole Err struct" entry point). Any OTHER src
// (error-to-error copy, e.g. `e2 = e1`) falls through to a plain
// cgSizeOf(KErr)-byte block copy, same generic tail cgEmitStoreRec's own
// KRec default uses -- not exercised by any fixture, but layout-safe
// since KErr's byte layout is fixed and copy-compatible.
func cgEmitStoreErr(dst: int, src: int) {
    var sk: IRExprKind
    var codeFi: int
    var msgFi: int
    var sz: int

    sk = irExprKind(src)
    if sk == EIntr and irIntrName(src) == ILastErr() {
        codeFi = findIRFuncIdxByName(rnLastErrCode)
        if codeFi == -1 or not shakeReachable(codeFi) {
            abort("cg68k: natLastErrCode not found/reachable")
        }
        msgFi = findIRFuncIdxByName(rnLastErrMsg)
        if msgFi == -1 or not shakeReachable(msgFi) {
            abort("cg68k: natLastErrMsg not found/reachable")
        }
        cgExprAddr(dst)
        a68Emit(OpMovea, 4, AmAn, 0, 0, AmAn, 1, 0)
        cgCallFunc(codeFi)
        cgStoreD0At(1, 0, irIntT)
        a68Emit(OpLea, 0, AmDisp16, 1, cgErrMsgOff(), AmAn, 0, 0)
        a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
        cgCallFunc(msgFi)
        cgCleanupStack(4)
        return
    }
    sz = cgSizeOf(irExprType(dst))
    cgExprAddr(src)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(dst)
    a68Emit(OpMovea, 4, AmAn, 0, 0, AmAn, 1, 0)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 0, 0)
    cgBlockCopy(sz)
}

// cgEmitStoreArr (5e final-review C1) is whole-fixed-array assignment
// (`b = a`, `r.field = arrVar`, for `arr N of T` -- Ch3's copy-by-value
// rule) via address+block-copy: identical generic tail to
// cgEmitStoreRec/cgEmitStoreErr's own default arm (same A0/A1-across-call
// clobber discipline -- src's address is computed and pushed BEFORE dst's
// address computation touches A0/D-scratch, so no intervening JSR can
// clobber either address once both are live in A0/A1). No ENewRec/ECallFn
// fast-path needed here (unlike cgEmitStoreRec): there is no array
// constructor expr in the IR, and cgExprAddr's own materialize fallback
// already covers any non-addressable src generically. dst is always
// EVarRef/EFieldRef/EIndexRef -- cgStmt's SAssign arm only calls this for
// those three, cgExprAddr handles all three (cgIndexRefAddr included).
// cgSizeOf(KArr) is already the element-padded full array size (the file
// header's own LAYOUT AUTHORITY), so a raw byte copy is correct -- PROVIDED
// the element type doesn't cgNeedsRelease (the caller, cgStmt's SAssign
// arm, fails closed before ever reaching here otherwise; this function
// itself has no ARC awareness and must not be called for a handle-bearing
// element type).
func cgEmitStoreArr(dst: int, src: int) {
    var sz: int

    sz = cgSizeOf(irExprType(dst))
    cgExprAddr(src)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(dst)
    a68Emit(OpMovea, 4, AmAn, 0, 0, AmAn, 1, 0)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 0, 0)
    cgBlockCopy(sz)
}

// cgEmitReturnRec mirrors cgEmitStoreStr/cgEmitReturnRec's own str sibling
// (cgEmitReturnStr) for a `return <rec expr>` inside a function whose
// return needs a hidden pointer: the destination is the POINTER VALUE
// already sitting at 8(A6) (pushed by value, not LEA'd). ENewRec
// constructs directly into it (MOVEA 8(A6),A0 loads the pointer VALUE,
// giving cgRecordCtorAt the same (reg=0,off=0) address shape as
// cgEmitStoreRec's own ENewRec arm); anything else (EVarRef/EFieldRef/
// EIndexRef, or ECallFn/EIntr -- Task 14.7: cgExprAddr's own general
// fallback now materializes either into a fresh temp via cgEmitStoreRec,
// itself EIntr/ECallFn-aware, then this arm block-copies from that temp)
// block-copies, src's address stashed across the 8(A6) read exactly like
// cgEmitStoreRec's own generic arm.
func cgEmitReturnRec(src: int) {
    var sk: IRExprKind
    var sz: int

    sk = irExprKind(src)
    if sk == ENewRec {
        a68Emit(OpMovea, 4, AmDisp16, 6, 8, AmAn, 0, 0)
        cgRecordCtorAt(0, 0, irNewRecName(src))
        return
    }
    sz = cgSizeOf(cgCurRetType)
    cgExprAddr(src)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMovea, 4, AmDisp16, 6, 8, AmAn, 1, 0)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 0, 0)
    cgBlockCopy(sz)
}

// cgCcFor maps a comparison operator's SPELLING (EBin.name -- mirrors
// cOp's spelling->C-op table, cprint.cla:1047) to the 68000 Scc/Bcc
// condition-code nibble (a68CcName's own numbering). Flags are always
// set as left-right (CMP's dm operand is the LEFT value -- see
// cgCompare), so these map the same direction a signed comparison reads.
// layer1-compiler-perf phase Task 14 (findings 1.5): op is the interned
// pool index (irBinOp's own return value), compared against ir.cla's
// memoized IOp*() helpers -- cprint-style, same as cgIntr/cgIntrUi.
func cgCcFor(op: int): int {
    if op == IOpEq() { return 7 }   // EQ
    if op == IOpNe() { return 6 }   // NE
    if op == IOpLt() { return 13 }  // LT
    if op == IOpLe() { return 15 }  // LE
    if op == IOpGt() { return 14 }  // GT
    return 12                        // ">=" -> GE
}

func cgIsCompareOp(op: int): bool {
    return op == IOpEq() or op == IOpNe() or op == IOpLt() or op == IOpLe() or op == IOpGt() or op == IOpGe()
}

// cgCompare: CMP + Scc + AND.L #1,D0 (Scc writes the whole byte
// $00/$FF; the AND masks that down to a clean 0/1 bool). D1=left,
// D0=right after the push/pop (see the evaluation-discipline doc
// comment); CMP's dm operand is always the "compared FROM" register
// (flags = dm - ea), so dm=D1(left), sm/ea=D0(right) gives flags =
// left-right, matching cgCcFor's direction.
func cgCompare(e: int, op: int) {
    cgExpr(irBinX(e))
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(irBinY(e))
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 1, 0)
    a68Emit(OpCmp, 4, AmDn, 0, 0, AmDn, 1, 0)
    a68Emit(OpScc, 1, AmNone, 0, 0, AmDn, 0, cgCcFor(op))
    a68Emit(OpAndInsn, 4, AmImm, 0, 1, AmDn, 0, 0)
}

// cgAndOr: short-circuit and/or, branch-based (lower.cla does NOT
// lower this -- mirrors fpAndOr's semantics, cprint.cla:1132, but with
// branches instead of a captured-statement temp since this backend has
// no C-style statement-temp machinery). `and`: result is the RIGHT
// value when the left is true, else false without evaluating right.
// `or`: result is the right value when left is false, else true without
// evaluating right.
func cgAndOr(e: int, isAnd: bool) {
    var shortLbl: int
    var doneLbl: int

    shortLbl = a68NewLabel()
    doneLbl = a68NewLabel()
    cgExpr(irBinX(e))
    a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 0, 0)
    if isAnd {
        a68EmitBr(OpBcc, 7, shortLbl)  // BEQ: left false -> short-circuit false
    } else {
        a68EmitBr(OpBcc, 6, shortLbl)  // BNE: left true -> short-circuit true
    }
    cgExpr(irBinY(e))
    a68EmitBr(OpBra, 0, doneLbl)
    a68Bind(shortLbl)
    if isAnd {
        a68Emit(OpMove, 4, AmImm, 0, 0, AmDn, 0, 0)
    } else {
        a68Emit(OpMove, 4, AmImm, 0, 1, AmDn, 0, 0)
    }
    a68Bind(doneLbl)
}

// cgArith: +, -, *, /, mod, &, |, ^, <<, >>. See the evaluation-discipline
// doc comment (module-state block, above) for the D1=left/D0=right
// convention and why SUB/shifts need a trailing MOVE.L D1,D0.
func cgArith(e: int, op: int) {
    cgExpr(irBinX(e))
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(irBinY(e))
    a68Emit(OpMove, 4, AmPostInc, 7, 0, AmDn, 1, 0)
    // D1=left, D0=right.
    if op == IOpAdd() {
        a68Emit(OpAddInsn, 4, AmDn, 1, 0, AmDn, 0, 0)
    } else if op == IOpBitAnd() {
        a68Emit(OpAndInsn, 4, AmDn, 1, 0, AmDn, 0, 0)
    } else if op == IOpBitOr() {
        a68Emit(OpOrInsn, 4, AmDn, 1, 0, AmDn, 0, 0)
    } else if op == IOpBitXor() {
        a68Emit(OpEor, 4, AmDn, 1, 0, AmDn, 0, 0)
    } else if op == IOpSub() {
        a68Emit(OpSubInsn, 4, AmDn, 0, 0, AmDn, 1, 0)
        a68Emit(OpMove, 4, AmDn, 1, 0, AmDn, 0, 0)
    } else if op == IOpShl() {
        a68Emit(OpAsl, 4, AmDn, 0, 0, AmDn, 1, 0)
        a68Emit(OpMove, 4, AmDn, 1, 0, AmDn, 0, 0)
    } else if op == IOpShr() {
        // Arithmetic shift (sign-propagating) -- language reference Ch4.
        a68Emit(OpAsr, 4, AmDn, 0, 0, AmDn, 1, 0)
        a68Emit(OpMove, 4, AmDn, 1, 0, AmDn, 0, 0)
    } else if op == IOpMul() {
        a68EmitBr(OpBsr, 0, cgMul32Label())
    } else if op == IOpDiv() {
        a68EmitBr(OpBsr, 0, cgDiv32Label())
    } else if op == IOpMod() {
        a68EmitBr(OpBsr, 0, cgMod32Label())
    } else {
        if a68ListingOn {
            a68Comment("TODO EBin op " + poolGet(op) + ": unsupported this task")
        } else {
            a68CommentMarker()
        }
    }
}

func cgBin(e: int) {
    var op: int

    op = irBinOp(e)
    if op == IOpAnd() {
        cgAndOr(e, true)
    } else if op == IOpOr() {
        cgAndOr(e, false)
    } else if cgIsCompareOp(op) {
        cgCompare(e, op)
    } else {
        cgArith(e, op)
    }
}

func cgUn(e: int) {
    var op: int

    op = irUnOp(e)
    cgExpr(irUnX(e))
    if op == IOpSub() {
        a68Emit(OpNegInsn, 4, AmNone, 0, 0, AmDn, 0, 0)
    } else if op == IOpNot() {
        // bool is always exactly 0/1 (cgLoadVar/cgCompare/cgAndOr all
        // guarantee this) -- XOR with 1 flips it.
        a68Emit(OpEor, 4, AmImm, 0, 1, AmDn, 0, 0)
    } else if op == IOpBitNot() {
        a68Emit(OpNotInsn, 4, AmNone, 0, 0, AmDn, 0, 0)
    }
}

// cgConv: EConv per IRConvOp -- the brief's 9 unchecked conversions
// (CvIntToEnum is Task 12, deferred below). CvIntToFixed shifts by 16,
// which needs the register-count shift form (asm68k's immediate shift
// count is capped at 1-8) -- a fixed #16 into D1, then ASL.L D1,D0.
//
// CvFixedToInt (task-8-review round 1 fix, Critical 2): must truncate
// TOWARD ZERO (language reference Ch3: "int(f) ... truncates toward
// zero"; cprint.cla:1192-1206's fpConv explicitly avoids a raw shift for
// this exact reason). A plain ASR.L #16 is a FLOOR (round toward
// -infinity), which differs from truncation by exactly 1 for any
// negative value with a nonzero low-16-bit fractional part (e.g.
// -1.5 -> ASR gives -2, not -1). Fixed via the standard negate-shift-
// negate trick: shifting a NON-negative magnitude right is already
// truncation (floor == trunc for x>=0), so for a negative input, negate
// first (making it non-negative), shift, then negate the result back.
// Shares the same "INT_MIN can't be negated" edge case cprint's own
// unguarded C division already has -- not a new regression.
func cgConv(e: int) {
    var op: IRConvOp
    var lneg: int
    var ldone: int

    op = irConvOp(e)
    cgExpr(irConvX(e))
    if op == CvIntToFixed {
        a68Emit(OpMove, 4, AmImm, 0, 16, AmDn, 1, 0)
        a68Emit(OpAsl, 4, AmDn, 1, 0, AmDn, 0, 0)
    } else if op == CvFixedToInt {
        lneg = a68NewLabel()
        ldone = a68NewLabel()
        a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 0, 0)
        a68EmitBr(OpBcc, 11, lneg) // BMI: negative -> negate-shift-negate path
        a68Emit(OpMove, 4, AmImm, 0, 16, AmDn, 1, 0)
        a68Emit(OpAsr, 4, AmDn, 1, 0, AmDn, 0, 0)
        a68EmitBr(OpBra, 0, ldone)
        a68Bind(lneg)
        a68Emit(OpNegInsn, 4, AmNone, 0, 0, AmDn, 0, 0)
        a68Emit(OpMove, 4, AmImm, 0, 16, AmDn, 1, 0)
        a68Emit(OpAsr, 4, AmDn, 1, 0, AmDn, 0, 0)
        a68Emit(OpNegInsn, 4, AmNone, 0, 0, AmDn, 0, 0)
        a68Bind(ldone)
    } else if op == CvIntToChar {
        a68Emit(OpAndInsn, 4, AmImm, 0, 0xFF, AmDn, 0, 0)
    } else if op == CvIntToEnum {
        cgEmitEnumConv(irConvEnumName(e))
    } else if op == CvCharToInt or op == CvEnumToInt or op == CvIntToPtr or op == CvPtrToInt or op == CvPtrToOverlay or op == CvOverlayToPtr {
        // CvCharToInt/CvEnumToInt (already zero-extended/already 4-byte int
        // rep in D0) and CvIntToPtr/CvPtrToInt/CvPtrToOverlay/CvOverlayToPtr
        // (identity bit-moves, KPtr/KOverlay both 4-byte pointer-shaped) are
        // all genuine no-ops on top of the cgExpr(x) above -- D0 already
        // holds the right bit pattern.
    } else if op == CvSExt16 {
        // Task 6 (toolbox-integration Feature B), Ch13 Field Palette: a
        // `word` field reads sign-extended, but peekw's own contract
        // (cgIntrPeek) zero-extends its raw 16-bit read into D0 -- D0's low
        // 16 bits already hold the correct bit pattern, so a plain EXT.L
        // re-derives the full signed 32-bit value from them, matching
        // cprint's own `(int32_t)(int16_t)(x)` cast exactly (and the same
        // EXT.L idiom cgCallExtReg/cgCallExtPascal's own KWord result arms
        // already use for the identical "Toolbox INTEGER is signed" rule).
        a68Emit(OpExt, 4, AmNone, 0, 0, AmDn, 0, 0)
    } else if op == CvIntNonZero {
        // Task 6, Ch13 Field Palette: a `bool` field reads as a real
        // Toolbox Boolean byte, not guaranteed exactly 0/1 -- normalize any
        // nonzero byte (peekb's own zero-extend already left a plain D0
        // value) to exactly 1, matching Clarus bool's own 0/1 representation.
        // TST sets the condition codes off D0 itself; Scc NE (cgCcFor's own
        // "!=" code, 6) writes the whole byte $00/$FF; AND.L #1 masks that
        // down to a clean 0/1 -- the identical CMP-less tail cgCompare's own
        // Scc+AND idiom already uses for every "produce a real Clarus bool"
        // result in this file.
        a68Emit(OpTst, 4, AmNone, 0, 0, AmDn, 0, 0)
        a68Emit(OpScc, 1, AmNone, 0, 0, AmDn, 0, 6)
        a68Emit(OpAndInsn, 4, AmImm, 0, 1, AmDn, 0, 0)
    } else {
        // Task 4 review fix (Important 3): every OTHER IRConvOp is covered
        // above -- hard-fail default here, matching Task 14.7's own "no
        // silent-zero degrade" rule elsewhere in this file.
        abort("cg68k: cgConv: conv op " + numToStr(int(op)) + " unsupported")
    }
}

// cgIntrPeekPokeSize maps a peek*/poke* intrinsic name to its access width
// in bytes (Ch13, rt.h's rt_peekb/w/l -- str.cla's own doc comment: every
// byte this runtime touches through the waist goes through peekb/pokeb or
// StrBlockMoveData).
func cgIntrPeekPokeSize(nm: int): int {
    if nm == IPeekB() or nm == IPokeB() {
        return 1
    } else if nm == IPeekW() or nm == IPokeW() {
        return 2
    }
    return 4
}

// cgIntrPeek inlines peekb/peekw/peekl as MOVEA.L addr,A0; MOVE.<sz>
// (A0),D0 -- zero-extending first for B/W widths (mirrors rt.h's
// rt_peekb/rt_peekw, which both `return (int32_t)` an unsigned/uint16_t
// value: peekb/peekw are UNSIGNED reads, never sign-extended; peekl is
// already a full 32-bit value, no extension needed).
func cgIntrPeek(e: int, nm: int) {
    var a0e: int
    var sz: int

    a0e = irIntrArgsHead(e)
    sz = cgIntrPeekPokeSize(nm)
    cgExpr(a0e)
    a68Emit(OpMovea, 4, AmDn, 0, 0, AmAn, 0, 0)
    if sz < 4 {
        a68Emit(OpClr, 4, AmNone, 0, 0, AmDn, 0, 0)
    }
    a68Emit(OpMove, sz, AmInd, 0, 0, AmDn, 0, 0)
}

// cgIntrPoke inlines pokeb/pokew/pokel as <evaluate addr>; MOVE.L D0,-(A7);
// <evaluate value>; MOVEA.L (A7)+,A0; MOVE.<sz> D0,(A0) -- rt.h's
// rt_pokeb/w/l mirror (truncating stores, no extension needed on the write
// side). The address is SPILLED TO THE STACK across the value expression
// rather than parked in A0: A0 is cgExpr's universal address scratch (every
// peek*, every EVarRef address-of, every nested call's arg marshaling
// rewrites it), so `pokeb(dst + n, peekb(src + i))` -- native.cla's natItoa
// digit copy, and the very first fixture to exercise the shape -- otherwise
// stores THROUGH THE SOURCE ADDRESS instead of the destination. Every
// cgExpr path is stack-balanced, so (A7)+ recovers the address whatever the
// value expression does.
func cgIntrPoke(e: int, nm: int) {
    var a0e: int
    var a1e: int
    var sz: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    sz = cgIntrPeekPokeSize(nm)
    cgExpr(a0e)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExpr(a1e)
    a68Emit(OpMovea, 4, AmPostInc, 7, 0, AmAn, 0, 0)
    a68Emit(OpMove, sz, AmDn, 0, 0, AmInd, 0, 0)
}

// ================================================================
// Task 13: EIntr dispatch helpers -- the arm table cgIntr (below) drives.
// cgIntr1/2/3 are the mechanical "call a runtime IRFunc with 1-3 plain
// value-or-address arguments, leave its result in D0" shape (a Clarus-side
// generalization of fpIntrCall's own one-line `return "clar_fn_...(...)"`/
// `fpEmit("clar_fn_...(...)")` arms) -- every str/text arm below that
// doesn't need its OWN tracked temp or ARC traffic routes through one of
// these three.
// ================================================================

func cgIntr1(e: int, nameIdx: int, addr0: bool) {
    var a0e: int
    var args: list of int
    var addrs: list of bool

    a0e = irIntrArgsHead(e)
    args = cgFreshIntList()
    args.add(a0e)
    addrs = cgFreshBoolList()
    addrs.add(addr0)
    if not cgCallRuntime(nameIdx, args, addrs) {
        abort("cg68k: cgIntr1: runtime call failed")
    }
}

func cgIntr2(e: int, nameIdx: int, addr0: bool, addr1: bool) {
    var a0e: int
    var a1e: int
    var args: list of int
    var addrs: list of bool

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    args = cgFreshIntList()
    args.add(a0e)
    args.add(a1e)
    addrs = cgFreshBoolList()
    addrs.add(addr0)
    addrs.add(addr1)
    if not cgCallRuntime(nameIdx, args, addrs) {
        abort("cg68k: cgIntr2: runtime call failed")
    }
}

func cgIntr3(e: int, nameIdx: int, addr0: bool, addr1: bool, addr2: bool) {

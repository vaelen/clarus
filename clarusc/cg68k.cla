    var nameIdx: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    elemT = irtElem(irExprType(a0e))
    mOff = cgAllocTmpOff(irPtrT)
    cgExpr(a0e)
    cgStoreD0At(6, mOff, irPtrT)

    if cgNeedsRelease(elemT) {
        cgMapReleaseGuard(mOff, a1e, elemT, sorted)
    }

    a68Emit(OpMove, 4, AmDisp16, 6, mOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    cgExprAddr(a1e)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    nameIdx = rnMapRemove
    if sorted {
        nameIdx = rnSortedMapRemove
    }
    cgJsrByName(nameIdx)
    cgCleanupStack(8)
}

// cgIntrIntMapSet mirrors cgIntrMapSet (map-hashtable phase Task 7): the
// int-keyed twin, NOT sharing cgIntrMapSet's own `prefix` parameterization
// because the key argument shape differs structurally (int by VALUE, not
// Str255 by ADDRESS) -- see the cgIntr dispatch's own doc comment above for
// why. The key is evaluated into its own scratch slot (kOff) exactly ONCE,
// mirroring mOff's own stash, then reused (loaded from kOff) at every JSR
// site below -- an intmap key is an arbitrary int expression (no
// addressable-lvalue restriction the way a string map key has), so
// re-evaluating it more than once would re-run a side effect
// (`m[f()] = v`) once per call site.
func cgIntrIntMapSet(e: int, retainVariant: bool) {
    var a0e: int
    var a1e: int
    var a2e: int
    var elemT: int
    var mOff: int
    var kOff: int
    var vOff: int

    a0e = irIntrArgsHead(e)
    a1e = irExprNext(a0e)
    a2e = irExprNext(a1e)
    elemT = irExprType(a2e)
    mOff = cgAllocTmpOff(irPtrT)
    cgExpr(a0e)
    cgStoreD0At(6, mOff, irPtrT)

    kOff = cgAllocTmpOff(irIntT)
    cgExpr(a1e)
    cgStoreD0At(6, kOff, irIntT)

    if cgNeedsRelease(elemT) {
        cgIntMapReleaseGuard(mOff, kOff, elemT)
    }

    vOff = cgAllocTmpOff(elemT)
    cgStoreElemAt(vOff, elemT, a2e)
    if cgLastTrackedOff != -1 {
        cgHandoff(cgLastTrackedOff)
    }
    if retainVariant {
        cgRetainAt(6, vOff, elemT)
    }

    a68Emit(OpMove, 4, AmDisp16, 6, mOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpMove, 4, AmDisp16, 6, kOff, AmDn, 0, 0)
    a68Emit(OpMove, 4, AmDn, 0, 0, AmPreDec, 7, 0)
    a68Emit(OpLea, 0, AmDisp16, 6, vOff, AmAn, 0, 0)
    a68Emit(OpMove, 4, AmAn, 0, 0, AmPreDec, 7, 0)
    cgJsrByName(rnIntMapSet)
    cgCleanupStack(12)
}

// cgIntrIntMapGet mirrors cgIntrMapGet -- the int-keyed twin (see
// cgIntrIntMapSet's own doc comment for why this isn't just another
// `prefix` branch of the string-keyed family).
func cgIntrIntMapGet(e: int): int {
    var a0e: int

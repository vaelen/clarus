        nameIdx = rnSortedMapGet
    }
    cgJsrByName(nameIdx)
    cgCleanupStack(12)

    if cgIsHandleKind(k) {
        cgRetainAt(6, off, elemT)
        cgLastTrackedOff = off
    }
    if cgSizeOf(elemT) <= 4 {
        cgIntrLoadScratch(off, elemT)

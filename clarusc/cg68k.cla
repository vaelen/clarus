// map-hashtable phase Task 2: `sorted` selects which runtime family's
// Remove this calls -- parameterized rather than duplicated (see
// cgMapReleaseGuard's own doc comment). Findings 1.4 (Task 13): bool +
// pre-interned rn* globals, same as cgIntrMapSet above.
func cgIntrMapRemove(e: int, sorted: bool) {
    var a0e: int

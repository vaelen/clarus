// main.cla: the clarusc CLI driver -- the check-only compiler front end that
// ties lex.cla + parse.cla + check.cla together and prints diagnostics
// byte-identically to `clarus check`.
//
// Pipeline, in the Go compiler's TWO-PHASE order (internal/driver/driver.go
// + internal/check/check.go), which is load-bearing for multi-file parity:
//   Phase A -- include-expand every entry file, lexing+parsing each in
//     DFS/expansion order and collecting all parse-phase diagnostics as it
//     goes (pre-order per driver.go: a file's own parse diags precede its
//     includes'; the assembled decl lists are post-order so a dependency's
//     declarations precede the includer's).
//   Phase B -- run checkProgram ONCE over the whole assembled decl list,
//     collecting check-phase diagnostics.
// All parse diagnostics therefore print before all check diagnostics, exactly
// as the Go compiler orders them. Diagnostics are printed via alert as
// "path:line:col: message" (source.Diag.String()); quit 1 if any, else 0.

include "lib.cla"
include "tok.cla"
include "lex.cla"
include "ast.cla"
include "parse.cla"
include "types.cla"
include "check.cla"
include "ir.cla"
include "lower.cla"
include "cprint.cla"

// seenPaths keys the include-once set (driver.go's `seen`). Go keys by
// cleaned absolute path so the same file reached two ways dedups; this port
// keys by the resolved path string.
// ponytail: string-keyed, not Abs+Clean-keyed -- exact for the flat testdata
// layouts; upgrade to a real abs/clean if a corpus reaches one file via two
// distinct relative spellings (Task 11 territory).
var seenPaths: map of int

// asmHeads holds each expanded file's decl-list head in POST-ORDER
// (dependencies before includers), matching driver.go's files/trees order.
var asmHeads: list of int

// entryFailed records that an entry path itself could not be read -- Go's
// Expand returns this as a hard error (clarus check: stderr + exit 1).
var entryFailed: bool

// dirOf returns path's directory including the trailing '/', or "" if path
// has no slash (mirrors filepath.Dir + a following Join for our purposes).
func dirOf(path: string): string {
    var i: int
    var last: int

    last = -1
    i = 0
    while i < path.length {
        if path[i] == '/' {
            last = i
        }
        i = i + 1
    }
    if last == -1 {
        return ""
    }
    return path[0, last + 1]
}

// baseNameNoExt returns path's final path segment with a trailing ".cla"
// stripped (if present) -- used by appinfo's filename-fallback rung.
func baseNameNoExt(path: string): string {
    var i: int
    var last: int
    var base: string

    last = -1
    i = 0
    while i < path.length {
        if path[i] == '/' {
            last = i
        }
        i = i + 1
    }
    base = path[last + 1, path.length - (last + 1)]
    if base.length >= 4 and base[base.length - 4, 4] == ".cla" {
        base = base[0, base.length - 4]
    }
    return base
}

// joinPath resolves an include's path relative to dir (filepath.Join): an
// absolute name (leading '/') wins outright, otherwise it hangs off dir.
func joinPath(dir: string, name: string): string {
    if name.length > 0 and name[0] == '/' {
        return name
    }
    return dir + name
}

// findRtDir resolves the default --rtdir when the flag is omitted: it walks
// UP from the current working directory looking for a "runtime/clarus/"
// directory, probed by trying to read probeFile (the first needed module's
// file name) out of each candidate. Tries the cwd itself plus up to 9 parent
// levels (10 total) and returns the first candidate that has probeFile, or
// "" if none of them do -- absence here is not itself an error; the caller
// only reports one once a needed module truly can't be found.
func findRtDir(probeFile: string): string {
    var prefix: string
    var i: int
    var candidate: string
    var probe: text
    var ok: bool

    prefix = ""
    i = 0
    while i < 10 {
        candidate = prefix + "runtime/clarus/"
        probe = ""
        ok = file.readText(candidate + probeFile, probe)
        if ok {
            return candidate
        }
        prefix = prefix + "../"
        i = i + 1
    }
    return ""
}

// lastDecl returns the last node in head's `next` chain (head must be a real
// index, not -1) -- used to splice one file's decl list onto the running
// combined list.
func lastDecl(head: int): int {
    var d: int

    d = head
    while declNext(d) != -1 {
        d = declNext(d)
    }
    return d
}

// expand loads, lexes, and parses path, recursing into its leading includes
// first (post-order decl assembly into asmHeads, pre-order parse
// diagnostics) -- a port of driver.go's inner `expand`. Returns whether path
// itself could not be read (the caller turns a missing non-entry file into a
// "cannot open included file" diagnostic at the include's position).
func expand(path: string, entry: bool): bool {
    var src: text
    var ok: bool
    var head: int
    var dir: string
    var d: int
    var pathIdx: int
    var incName: string
    var incResolved: string
    var missing: bool

    if seenPaths.has(path) {
        return false
    }
    seenPaths[path] = 1

    src = ""
    ok = file.readText(path, src)
    if not ok {
        if entry {
            entryFailed = true
        }
        return true
    }

    // Stamp every lex/parse diagnostic this file produces with its own path
    // (curPathIdx is read by emitDiag). Set it BEFORE lexing/parsing.
    pathIdx = intern(path)
    curPathIdx = pathIdx
    lexAll(src)
    head = parseFile()

    // Record each top-level decl's owning file so the single check pass can
    // attribute a check diagnostic to the file its decl came from (Go's
    // per-decl c.f), not the entry path.
    d = head
    while d != -1 {
        setDeclFile(d, pathIdx)
        d = declNext(d)
    }

    dir = dirOf(path)
    d = head
    while d != -1 {
        if declKind(d) == DkInclude {
            incName = poolGet(includePath(d))
            incResolved = joinPath(dir, incName)
            missing = expand(incResolved, false)
            if missing {
                // Recursion may have moved curPathIdx into a child file;
                // restore this file's path before stamping the diagnostic,
                // which Go attributes to the includer.
                curPathIdx = pathIdx
                emitDiag(declLine(d), declCol(d), "cannot open included file \"" + incName + "\"")
            }
        }
        d = declNext(d)
    }

    asmHeads.add(head)
    return false
}

on App.startCLI(args: list of string) {
    var i: int
    var combined: int
    var tail: int
    var h: int
    var emitMode: bool
    var appinfoMode: bool
    var startArg: int
    var outPath: string
    var haveOutPath: bool
    var fileArgs: list of string
    var cSrc: text
    var wrote: bool
    var d: int
    var appIdx: int
    var resolved: string
    var nameV: string
    var versionV: string
    var idV: string
    var iconV: string
    var item: int
    var pname: string
    var vh: int
    var rtDir: string
    var haveRtDir: bool
    var neededMods: list of string
    var rtHeads: list of int
    var combined2: int
    var rtTail: int
    var rtPath: string
    var rtProbe: text
    var j: int
    var rtReadable: bool
    var beforeCount: int

    // Reset-at-start: one clarusc invocation checks (or emits) one program
    // (each differential-harness case is a fresh exec). These resets clear the
    // module-level state the pipeline reuses, so a program is processed from a
    // clean slate regardless of how the process was entered.
    resetDiags()
    astReset()

    if args.count == 0 {
        log("usage: clarusc [emit -o OUT.c | appinfo] FILE...")
        quit 2
    }

    // Subcommand: `clarusc emit -o OUT.c FILE...` runs the same pipeline as
    // the default check, then -- only if there are zero diagnostics -- lowers
    // to IR, builds the C translation unit, and writes it to OUT.c via
    // file.writeText (byte-faithful, no per-line length cap -- unlike stdout
    // via alert, which is capped at a string's 255 bytes per line). Subcommand
    // `clarusc appinfo FILE...` runs the same check pipeline and, on success,
    // prints the program's app metadata as key=value lines instead of
    // emitting (see the appinfoMode block below). emit and appinfo are
    // mutually exclusive; the default (neither) checks and prints
    // diagnostics exactly as before.
    emitMode = false
    appinfoMode = false
    startArg = 0
    if args[0] == "emit" {
        emitMode = true
        startArg = 1
    }
    if args[0] == "appinfo" {
        appinfoMode = true
        startArg = 1
    }
    if startArg >= args.count {
        log("usage: clarusc [emit -o OUT.c | appinfo] FILE...")
        quit 2
    }

    // Collect input files, diverting emit's "-o PATH" and "--rtdir DIR"
    // (which may appear before or after the input files) out of the file
    // list. --rtdir overrides findRtDir's default upward search for the
    // directory holding the runtime modules the implicit-inclusion manifest
    // (below, emit-mode only) may need.
    outPath = ""
    haveOutPath = false
    rtDir = ""
    haveRtDir = false
    i = startArg
    while i < args.count {
        if emitMode and args[i] == "-o" {
            i = i + 1
            if i >= args.count {
                log("usage: clarusc emit -o OUT.c FILE...")
                quit 2
            }
            outPath = args[i]
            haveOutPath = true
        } else if emitMode and args[i] == "--rtdir" {
            i = i + 1
            if i >= args.count {
                log("usage: clarusc emit -o OUT.c [--rtdir DIR] FILE...")
                quit 2
            }
            rtDir = args[i]
            if rtDir.length > 0 and rtDir[rtDir.length - 1] != '/' {
                rtDir = rtDir + "/"
            }
            haveRtDir = true
        } else {
            fileArgs.add(args[i])
        }
        i = i + 1
    }
    if emitMode and not haveOutPath {
        log("usage: clarusc emit -o OUT.c FILE...")
        quit 2
    }
    if fileArgs.count == 0 {
        log("usage: clarusc [emit -o OUT.c | appinfo] FILE...")
        quit 2
    }

    // Phase A: include-expand + lex + parse every entry file, collecting all
    // parse-phase diagnostics.
    i = 0
    while i < fileArgs.count {
        expand(fileArgs[i], true)
        i = i + 1
    }
    if entryFailed {
        log("cannot open entry file")
        quit 1
    }

    // Assemble the post-order decl lists into one chain for the single
    // checker pass.
    combined = -1
    tail = -1
    i = 0
    while i < asmHeads.count {
        h = asmHeads[i]
        if h != -1 {
            if combined == -1 {
                combined = h
            } else {
                tail = declListAppend(tail, h)
            }
            tail = lastDecl(h)
        }
        i = i + 1
    }

    // Phase B: one checker pass over the whole program, collecting all
    // check-phase diagnostics (they follow every parse diagnostic). The
    // checker switches curPathIdx per top-level decl (setCheckPath) so each
    // check diagnostic is stamped with its decl's file, exactly as the Go
    // checker attributes to files[i] / dd.f rather than the entry path.
    if combined != -1 {
        checkProgram(combined)
    }

    // Print every diagnostic as "path:line:col: message", parse phase before
    // check phase, matching clarus check's stdout exactly.
    i = 0
    while i < diags.count {
        alert(formatDiag(poolGet(diagPaths[i]), diags[i]))
        i = i + 1
    }

    // A program that fails checking is never emitted: print its diagnostics
    // and quit 1, exactly as the default check path does.
    if diags.count > 0 {
        quit 1
    }

    // appinfo path: print the checked program's app metadata as key=value
    // lines, in the fixed order Task 6's shell parser depends on (app=1,
    // name=, version=, id=, icon=, only lines that apply -- name= always).
    // name resolves name-property > app label > first file's basename minus
    // ".cla". icon is joined against the app section's OWN declaring file's
    // directory (appDeclPathIdx), not the entry file's -- an app section
    // reached via include lives in a different directory than the entry.
    if appinfoMode {
        d = combined
        appIdx = -1
        while d != -1 {
            if declKind(d) == DkApp { appIdx = d }
            d = declNext(d)
        }
        resolved = ""
        nameV = ""
        versionV = ""
        idV = ""
        iconV = ""
        if appIdx != -1 {
            alert("app=1")
            item = appDeclPropsHead(appIdx)
            while item != -1 {
                pname = poolGet(propertyName(item))
                vh = propertyValuesHead(item)
                if pname == "name" { nameV = poolGet(stringLitIdx(vh)) }
                if pname == "version" { versionV = poolGet(stringLitIdx(vh)) }
                if pname == "id" { idV = poolGet(stringLitIdx(vh)) }
                if pname == "icon" { iconV = poolGet(stringLitIdx(vh)) }
                item = declNext(item)
            }
            if nameV != "" { resolved = nameV } else { resolved = poolGet(appDeclName(appIdx)) }
        }
        if resolved == "" { resolved = baseNameNoExt(fileArgs[0]) }
        alert("name=" + resolved)
        if versionV != "" { alert("version=" + versionV) }
        if idV != "" { alert("id=" + idV) }
        if iconV != "" { alert("icon=" + joinPath(dirOf(poolGet(appDeclPathIdx(appIdx))), iconV)) }
        quit 0
    }

    // Emit path: the gate above already required the user program to check
    // CLEAN STANDALONE (check-only semantics are untouched by any of this --
    // no runtime module is ever consulted before it). Only now, for emit,
    // do we consult the program's usage flags (set by checkProgram just
    // above) against the hardcoded runtime-module manifest, pull in
    // whatever they need, and re-check the combined program before
    // lowering -- a runtime-module diagnostic is a compiler bug, but it
    // must still surface, attributed to the runtime file via expand's own
    // setDeclFile loop.
    if emitMode {
        // The manifest: Task 4 ships exactly this one usage-flag/file pair
        // plus the machinery; Task 7 repoints "ser.cla" at the real
        // serialization module (now containing rtFileSave/rtFileLoad,
        // replacing the placeholder), and later tasks add unconditional
        // entries. cpSerPorted (cprint.cla) is set directly here, right
        // alongside the manifest decision it mirrors, so it's always
        // correct per-program even when this process compiles many
        // programs in a row (differential/selfhost harnesses).
        cpSerPorted = usesFileSaveLoad
        if usesFileSaveLoad {
            neededMods.add("ser.cla")
        }
        // Task 8: str.cla is the first UNCONDITIONAL entry -- every program
        // uses strings (Ch3's built-in Str255 family), so it's always
        // pulled in and cpStrPorted is always true, not gated by a usage
        // flag the way cpSerPorted/usesFileSaveLoad is.
        cpStrPorted = true
        neededMods.add("str.cla")

        combined2 = combined
        if neededMods.count > 0 {
            if not haveRtDir {
                rtDir = findRtDir(neededMods[0])
            }
            i = 0
            while i < neededMods.count {
                rtPath = joinPath(rtDir, neededMods[i])
                rtProbe = ""
                rtReadable = file.readText(rtPath, rtProbe)
                if not rtReadable {
                    if haveRtDir {
                        log("runtime module " + neededMods[i] + " not found (searched " + rtDir + "); use --rtdir")
                    } else {
                        log("runtime module " + neededMods[i] + " not found (searched runtime/clarus/ from the working directory upward); use --rtdir")
                    }
                    quit 1
                }
                // expand recurses into rtPath's own includes BEFORE
                // appending rtPath's own head (post-order), so a single call
                // can push more than one asmHeads entry -- capture the WHOLE
                // [beforeCount, asmHeads.count) range it added, not just the
                // last one, or a multi-file runtime module would silently
                // lose its included dependencies' declarations (parsed and
                // diagnosed, but never spliced into combined2). A decl-less
                // file (today's placeholder ser.cla) pushes a -1 head -- same
                // "empty file" sentinel the original assembly loop above
                // already skips; skip it here too rather than splice a bogus
                // head.
                beforeCount = asmHeads.count
                expand(rtPath, true)
                j = beforeCount
                while j < asmHeads.count {
                    if asmHeads[j] != -1 {
                        rtHeads.add(asmHeads[j])
                    }
                    j = j + 1
                }
                i = i + 1
            }

            // Rebuild the assembled program with the runtime modules' heads
            // FIRST (declare-before-use), followed by the original
            // (already fully linked) user-program chain.
            combined2 = -1
            rtTail = -1
            i = 0
            while i < rtHeads.count {
                h = rtHeads[i]
                if combined2 == -1 {
                    combined2 = h
                } else {
                    rtTail = declListAppend(rtTail, h)
                }
                rtTail = lastDecl(h)
                i = i + 1
            }
            if combined != -1 {
                if combined2 == -1 {
                    combined2 = combined
                } else {
                    rtTail = declListAppend(rtTail, combined)
                }
            }

            // checkProgram resets and rebuilds all check-global state
            // itself (the same reset+check sequence as the first pass, and
            // as check_test's runCase driver uses repeatedly in-process).
            // diags is empty on entry (the gate above already required
            // that), so every diagnostic printed here is new.
            checkProgram(combined2)
            i = 0
            while i < diags.count {
                alert(formatDiag(poolGet(diagPaths[i]), diags[i]))
                i = i + 1
            }
            if diags.count > 0 {
                quit 1
            }
        }

        irReset()
        lowerProgram(combined2)
        cSrc = emitProgram()
        wrote = file.writeText(outPath, cSrc)
        if not wrote {
            log("clarusc emit: cannot write " + outPath + ": " + lastError.message)
            quit 1
        }
    }
    quit 0
}

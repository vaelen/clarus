// main.cla: the clarusc CLI driver -- the check-only compiler front end that
// ties lex.cla + parse.cla + check.cla together and prints diagnostics
// byte-identically to `clarus check`.
//
// Pipeline, in the Go compiler's TWO-PHASE order (internal/driver/driver.go
// + internal/check/check.go), which is load-bearing for multi-file parity:
//   Phase A -- include-expand every entry file, lexing+parsing each in
//     DFS/expansion order and collecting all parse-phase diagnostics as it
//     goes (pre-order per driver.go: a file's own parse diags precede its
//     includes'; the assembled decl lists are post-order so a dependency's
//     declarations precede the includer's).
//   Phase B -- run checkProgram ONCE over the whole assembled decl list,
//     collecting check-phase diagnostics.
// All parse diagnostics therefore print before all check diagnostics, exactly
// as the Go compiler orders them. Diagnostics are printed via alert as
// "path:line:col: message" (source.Diag.String()); quit 1 if any, else 0.

include "lib.cla"
include "tok.cla"
include "lex.cla"
include "ast.cla"
include "parse.cla"
include "types.cla"
include "check.cla"
include "ir.cla"
include "lower.cla"
include "shake.cla"
include "asm68k.cla"
include "peep68k.cla"
include "app68k.cla"
include "res68k.cla"
include "cprint.cla"
include "cg68k.cla"
include "uiblob.cla"
include "drive.cla"
include "bake.cla"

// feReadSource is main.cla's front end for drive.cla's expand() seam
// (Task 6): the host CLI reads everything straight off disk via
// file.readText, exactly as expand() always has done -- key (a runtime
// module's rtdir-relative name, or "" for a non-runtime file) is ignored
// entirely; this front end has no resource fallback.
func feReadSource(path: string, key: string, out: text): bool {
    return file.readText(path, out)
}

// feHasKey is main.cla's front end for drive.cla's expand() seam (Task 8
// fix round 2): whether a 'CLFS' resource named key could satisfy a read.
// The host CLI has no baked resources at all, so always false -- expand()
// then never treats a disk-loaded file's key as a possible dedup alias,
// which keeps host behavior (hostPaths=true never calls this anyway) and
// any future host-side reasoning about hostPaths=false paths conservative.
// Task 10's macgui implements this for real (a resource-presence check).
func feHasKey(key: string): bool {
    return false
}

// feProgress is main.cla's front end for drive.cla's compile-progress
// seam (datetime-instrumentation phase): log() -> stderr, the CLI's
// diagnostic-stream convention (stdout stays clean for appinfo/
// diagnostics). driveProgress itself gates on want68k, so check-only /
// emit / appinfo invocations remain byte-silent.
func feProgress(line: string) {
    log(line)
}

// feProgressStep/feProgressTick (live-log phase): counted-progress and
// liveness seams -- no-ops on the host CLI; stderr already carries the
// per-stage feProgress lines.
func feProgressStep(cur: int, total: int, label: string) {
}

func feProgressTick() {
}

// feExpectedStamp is main.cla's own implementation of bake.cla's
// front-end seam (see bkCheckRtbakeHeader's own doc comment) -- byte-
// for-byte the SAME computation bkLoadRtbake used to do inline before
// Task 6 factored it out: re-hash clarusc/clarusc.c off disk (the host
// CLI always has the repo checkout available), 0 if unreachable. A pure
// refactor for this front end -- host `--rtbake` behavior is unchanged.
func feExpectedStamp(): int {
    var compilerSrc: text
    compilerSrc = ""
    if bkFindClarusC(compilerSrc) {
        return bkHashText(compilerSrc)
    }
    return 0
}

// cliResolveBake (Task 5, mac-resident-clarusc) validates and reads every
// `emit68k --bake FILE` flag, in flag order, filling cg68k.cla's
// cgBakeNames/cgBakeDatas/cgBakeTypes globals for cg68WriteImage's own
// resource loop -- name = FILE exactly as passed (also the resource's
// own name), data = the file's raw bytes, type = "CLFS" (every --bake
// FILE is a CLFS source resource; cliResolveBakeIr below is the only
// other populator, adding the CLIR artifact resource under its own
// reserved name). Rejects (log + quit 2) a name over 255 bytes (the
// Pascal-string name-list entry's own hard limit) or a name repeated
// across two --bake flags, both checked BEFORE any file is read; a file
// that can't be read is quit 1, same as --events. Split out of
// App.startCLI's own hand-off block, not inlined there, purely to stay
// under App.startCLI's per-function 32KB native segment budget --
// TestSelfEmit68k (internal/cg68k/selfemit_test.go) is this repo's own
// self-hosting headline gate and App.startCLI was already close to that
// ceiling before this task, same reasoning as cprint.cla's fpIntrCall1..7
// split (Task 14).
func cliResolveBake(bakePaths: list of string) {
    var bi: int
    var bj: int
    var bakeBytes: text

    cgBakeNames = cgFreshStringList()
    cgBakeTypes = cgFreshStringList()
    cgBakeDatas = cgFreshTextList()
    bi = 0
    while bi < bakePaths.count {
        if bakePaths[bi].length > 255 {
            log("clarusc emit68k --bake: name too long (" + numToStr(bakePaths[bi].length) + " bytes, max 255): " + bakePaths[bi])
            quit 2
        }
        bj = 0
        while bj < bi {
            if bakePaths[bj] == bakePaths[bi] {
                log("clarusc emit68k --bake: duplicate name: " + bakePaths[bi])
                quit 2
            }
            bj = bj + 1
        }
        bakeBytes = ""
        if not file.readText(bakePaths[bi], bakeBytes) {
            log("clarusc emit68k: cannot read " + bakePaths[bi] + ": " + lastError.message)
            quit 1
        }
        cgBakeNames.add(bakePaths[bi])
        cgBakeTypes.add("CLFS")
        cgBakeDatas.add(bakeBytes)
        bi = bi + 1
    }
}

// cliResolveBakeIr (Task 6, runtime-ir-bake Mac integration) embeds
// `emit68k --bake-ir FILE`'s CLIR artifact (FILE, generated by a prior
// `clarusc --bake-ir` run) as one MORE reserved-name resource,
// appended to cg68k.cla's cgBakeNames/cgBakeTypes/cgBakeDatas alongside
// cliResolveBake's own ordinary CLFS-source entries (called first,
// always -- see App.startCLI's own call order below). Also reads FILE's
// own ".stamp" sidecar (bakeIrMode's own unconditional byproduct, below)
// and embeds it under bkStampResourceName -- REQUIRED, not optional:
// without it, macgui.cla's feExpectedStamp falls back to 0 (bake.cla's
// own doc comment), which can never equal a real bake's stamp, so the
// CLIR resource would ALWAYS be refused -- a silent, hard-to-diagnose
// "bake path never taken" failure mode. Missing on disk is therefore a
// loud quit 1 here, not a quiet skip (same "a typo must fail loudly"
// precedent --partition's own doc comment already sets). Always called
// AFTER cliResolveBake (see App.startCLI's call order), so cgBakeNames
// already holds every manual --bake entry by the time this runs -- the
// reserved-name check below mirrors cliResolveBake's own loud duplicate
// refusal, guarding against a manual --bake FILE whose given name
// collides with bkClirResourceName/bkStampResourceName and would
// otherwise silently produce two same-named resources instead of failing.
func cliResolveBakeIr(clirPath: string) {
    var bytes: text
    var stampPath: string
    var bi: int

    bi = 0
    while bi < cgBakeNames.count {
        if cgBakeNames[bi] == bkClirResourceName or cgBakeNames[bi] == bkStampResourceName {
            log("clarusc emit68k --bake-ir: --bake name collides with reserved name: " + cgBakeNames[bi])
            quit 2
        }
        bi = bi + 1
    }

    bytes = ""
    if not file.readText(clirPath, bytes) {
        log("clarusc emit68k --bake-ir: cannot read " + clirPath + ": " + lastError.message)
        quit 1
    }
    cgBakeNames.add(bkClirResourceName)
    cgBakeTypes.add("CLFS")
    cgBakeDatas.add(bytes)

    stampPath = clirPath + ".stamp"
    bytes = ""
    if not file.readText(stampPath, bytes) {
        log("clarusc emit68k --bake-ir: cannot read " + stampPath + " (the CLIR's own stamp sidecar -- regenerate with --bake-ir): " + lastError.message)
        quit 1
    }
    cgBakeNames.add(bkStampResourceName)
    cgBakeTypes.add("CLFS")
    cgBakeDatas.add(bytes)
}

on App.startCLI(args: list of string) {
    var i: int
    var emitMode: bool
    var emitMode68k: bool
    var listingFlag: bool
    var segLimitFlag: int
    var eventsPath: string
    var haveEvents: bool
    var eventsBytes: text
    var bakePaths: list of string
    var nopeepFlag: bool
    var ok: bool
    var ok68: bool
    var appinfoMode: bool
    var bakeIrMode: bool
    var laneFlag: string
    var haveLaneFlag: bool
    var laneInt: int
    var startArg: int
    var outPath: string
    var haveOutPath: bool
    var fileArgs: list of string
    var cSrc: text
    var wrote: bool
    var d: int
    var appIdx: int
    var resolved: string
    var nameV: string
    var versionV: string
    var idV: string
    var iconV: string
    var item: int
    var pname: string
    var vh: int
    var testApiFlag: bool
    var partitionDigitIdx: int
    var rtbakePath: string
    var haveRtbakeFlag: bool
    var bakeIrEmbedPath: string
    var haveBakeIrEmbed: bool
    var stampBytes: text

    // Reset-at-start: one clarusc invocation checks (or emits) one program
    // (each differential-harness case is a fresh exec). These resets clear the
    // module-level state the pipeline reuses, so a program is processed from a
    // clean slate regardless of how the process was entered.
    resetDiags()
    astReset()
    // hostPaths (drive.cla): this front end is the host CLI -- '/' path
    // semantics.
    hostPaths = true

    if args.count == 0 {
        log("usage: clarusc [emit -o OUT.c | emit68k -o OUT.bin | appinfo] FILE...")
        quit 2
    }

    // Subcommand: `clarusc emit -o OUT.c FILE...` runs the same pipeline as
    // the default check, then -- only if there are zero diagnostics -- lowers
    // to IR, builds the C translation unit, and writes it to OUT.c via
    // file.writeText (byte-faithful, no per-line length cap -- unlike stdout
    // via alert, which is capped at a string's 255 bytes per line).
    // `clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] FILE...` (native-5d
    // Task 7) runs the SAME check + runtime-manifest pipeline as emit, then
    // roots the native-only entry points (cg68AddRoots), shakes, and hands
    // off to driveEmit68k (drive.cla) instead of emitProgram -- see
    // driveEmit68k's own doc comment for what it writes today (a single-
    // segment listing, with --listing; no .bin container until Task 10).
    // Subcommand `clarusc appinfo FILE...` runs the same check pipeline and,
    // on success, prints the program's app metadata as key=value lines
    // instead of emitting (see the appinfoMode block below). emit/emit68k/
    // appinfo are mutually exclusive; the default (none of them) checks and
    // prints diagnostics exactly as before.
    emitMode = false
    emitMode68k = false
    listingFlag = false
    segLimitFlag = 0
    eventsPath = ""
    haveEvents = false
    appinfoMode = false
    bakeIrMode = false
    laneFlag = ""
    haveLaneFlag = false
    startArg = 0
    if args[0] == "emit" {
        emitMode = true
        startArg = 1
    }
    if args[0] == "emit68k" {
        emitMode68k = true
        startArg = 1
    }
    if args[0] == "appinfo" {
        appinfoMode = true
        startArg = 1
    }
    // runtime-ir-bake Task 3: `clarusc --bake-ir --lane 68k|c --rtdir DIR
    // -o FILE` -- generates the CLIR runtime bake (bake.cla) instead of
    // checking/emitting a user program. Parsed as an args[0] subcommand,
    // the same way emit/emit68k/appinfo are, per the brief's own "add
    // bakeIrMode the same way" instruction; --lane/--rtdir/-o are then
    // ordinary flags in the loop below.
    if args[0] == "--bake-ir" {
        bakeIrMode = true
        startArg = 1
    }
    if startArg >= args.count {
        log("usage: clarusc [emit -o OUT.c | emit68k -o OUT.bin | appinfo | --bake-ir --lane 68k|c -o OUT.clir] FILE...")
        quit 2
    }

    // Collect input files, diverting emit's "-o PATH" and "--rtdir DIR"
    // (which may appear before or after the input files) out of the file
    // list. --rtdir overrides findRtDir's default upward search for the
    // directory holding the runtime modules the implicit-inclusion manifest
    // (below, emit-mode only) may need.
    outPath = ""
    haveOutPath = false
    rtDir = ""
    haveRtDir = false
    i = startArg
    while i < args.count {
        if (emitMode or emitMode68k or bakeIrMode) and args[i] == "-o" {
            i = i + 1
            if i >= args.count {
                if emitMode68k {
                    log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] FILE...")
                } else if bakeIrMode {
                    log("usage: clarusc --bake-ir --lane 68k|c -o OUT.clir [--rtdir DIR]")
                } else {
                    log("usage: clarusc emit -o OUT.c FILE...")
                }
                quit 2
            }
            outPath = args[i]
            haveOutPath = true
        } else if (emitMode or emitMode68k or bakeIrMode) and args[i] == "--rtdir" {
            i = i + 1
            if i >= args.count {
                if emitMode68k {
                    log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] FILE...")
                } else if bakeIrMode {
                    log("usage: clarusc --bake-ir --lane 68k|c -o OUT.clir [--rtdir DIR]")
                } else {
                    log("usage: clarusc emit -o OUT.c [--rtdir DIR] [--testapi] FILE...")
                }
                quit 2
            }
            rtDir = args[i]
            if rtDir.length > 0 and rtDir[rtDir.length - 1] != '/' {
                rtDir = rtDir + "/"
            }
            haveRtDir = true
        } else if bakeIrMode and args[i] == "--lane" {
            i = i + 1
            if i >= args.count {
                log("usage: clarusc --bake-ir --lane 68k|c -o OUT.clir [--rtdir DIR]")
                quit 2
            }
            laneFlag = args[i]
            haveLaneFlag = true
        } else if (emitMode or emitMode68k or appinfoMode) and args[i] == "--testapi" {
            // ui-scenario-retirement Task 2: opts a UI program into an
            // early splice of the UI runtime set + uitest.cla (below, "Early
            // --testapi splice"), ahead of the ordinary "must check clean
            // standalone" gate, so `UiTest*` names resolve. A bare flag
            // like --listing -- no following argument. appinfoMode accepts
            // it too (ui-scenario-retirement Task 3 fix round 1, ratified
            // 2026-08-05): `clarusc appinfo` runs the SAME unconditional
            // checkProgram pass every mode does (below), so a --testapi
            // program's own appinfo call needs the identical early splice
            // or it fails the clean-standalone gate before ever reaching
            // the appinfoMode print block -- the early-splice block itself
            // (below) is already mode-agnostic (gated on testApiFlag alone,
            // never on emitMode/emitMode68k), so no other change is needed.
            testApiFlag = true
        } else if (emitMode or emitMode68k) and args[i] == "--rtbake" {
            // runtime-ir-bake Task 4: opts this compile into the baked
            // CLIR image instead of splicing/checking/lowering the
            // runtime chain from source -- drive.cla's driveCompile
            // reads haveRtbake/rtbakeBytes (set below, once the whole
            // flag list is known and the lane -- want68k -- is settled).
            i = i + 1
            if i >= args.count {
                if emitMode68k {
                    log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] [--rtbake FILE] FILE...")
                } else {
                    log("usage: clarusc emit -o OUT.c [--rtdir DIR] [--testapi] [--rtbake FILE] FILE...")
                }
                quit 2
            }
            rtbakePath = args[i]
            haveRtbakeFlag = true
        } else if emitMode68k and args[i] == "--listing" {
            listingFlag = true
        } else if emitMode68k and args[i] == "--nopeep" {
            // peephole68k diagnostic escape hatch (deliberately
            // undocumented, like --seglimit): skip the peephole pass so
            // a native-lane bug can be triangulated as
            // peephole-induced or not in one rebuild.
            nopeepFlag = true
        } else if emitMode68k and args[i] == "--seglimit" {
            // Test-only override of cg68ProgramFork's per-segment payload
            // budget (default 32760) -- deliberately UNDOCUMENTED in the
            // usage strings above: it exists so a test can force a small
            // program into several real segments (proving cross-segment
            // calls + LoadSeg work on real hardware) without needing a
            // suite-sized fixture. See clarusc/cg68k.cla's cg68ProgramFork
            // doc comment.
            i = i + 1
            if i >= args.count {
                log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] [--seglimit N] FILE...")
                quit 2
            }
            segLimitFlag = cgParseDecimal(args[i])
        } else if emitMode68k and args[i] == "--events" {
            // Task 12 (native-5e): a scripted-event source file, byte-for-
            // byte identical in purpose to scripts/build-mac.sh's own
            // `--events FILE` (which round-trips the file through a
            // generated C string literal for the cprint lane) -- here the
            // raw file bytes are poured straight into the native constant
            // pool (cgEventsBytes, read below, consumed by cg68k.cla's
            // cgEmitUiEventsPool), NUL-terminated, with no C-string
            // escaping needed since nothing re-parses it as source.
            i = i + 1
            if i >= args.count {
                log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] [--seglimit N] [--events FILE] FILE...")
                quit 2
            }
            eventsPath = args[i]
            haveEvents = true
        } else if emitMode68k and args[i] == "--bake" {
            // Task 5 (mac-resident-clarusc): repeatable -- one 'CLFS'
            // resource per flag, baked into the emitted .bin's resource
            // fork (cg68WriteImage, cg68k.cla) so a native clarusc binary
            // can carry its own runtime/toolbox catalog sources. Files are
            // actually read at hand-off time below (mirrors --events),
            // once the whole flag list is known (needed for the
            // duplicate-name check).
            i = i + 1
            if i >= args.count {
                log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] [--seglimit N] [--events FILE] [--bake FILE]... FILE...")
                quit 2
            }
            bakePaths.add(args[i])
        } else if emitMode68k and args[i] == "--bake-ir" {
            // Task 6 (runtime-ir-bake, Mac integration): embeds a
            // previously-generated `clarusc --bake-ir` CLIR artifact
            // (FILE) plus its own ".stamp" sidecar (both, see
            // cliResolveBakeIr above) as two MORE reserved-name resources,
            // alongside --bake's ordinary CLFS source resources -- the
            // mechanism scripts/build-clarusc-mac.sh uses by default so
            // ClarusC.APPL consumes the baked runtime by default. Single-
            // valued (unlike --bake, not repeatable): one CLIR artifact
            // per build. Read at hand-off time below, same as --bake.
            i = i + 1
            if i >= args.count {
                log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] [--seglimit N] [--events FILE] [--bake FILE]... [--bake-ir FILE] FILE...")
                quit 2
            }
            bakeIrEmbedPath = args[i]
            haveBakeIrEmbed = true
        } else if emitMode68k and args[i] == "--partition" {
            // SIZE(-1) partition override (Task 10, mac-resident-clarusc):
            // preferred/minimum bytes for the emitted app's Process
            // Manager memory partition (app68k.cla's app68BuildSize, via
            // cg68k.cla's cgSizePartitionBytes) -- deliberately
            // UNDOCUMENTED, like --seglimit: every ordinary build gets
            // the 2MB default; only scripts/build-clarusc-mac.sh (whose
            // ClarusC.APPL needs far more, for its own compile working
            // set) passes this.
            //
            // Validated HERE, not inside cgParseDecimal (which stays a
            // bare best-effort digit-scanner, --seglimit's own long-
            // standing behavior: a garbage --seglimit silently degrades
            // to 0, treated as "no override" -- left alone, since
            // --seglimit is a diagnostic-only flag no build script
            // passes). --partition is different: scripts/build-clarusc-
            // mac.sh (a real, committed build script) now passes it, so a
            // typo there must fail loudly instead of silently building a
            // 2MB ClarusC.APPL that then can't compile anything.
            i = i + 1
            if i >= args.count {
                log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] [--seglimit N] [--events FILE] [--bake FILE]... [--partition N] FILE...")
                quit 2
            }
            partitionDigitIdx = 0
            while partitionDigitIdx < args[i].length {
                if not isDigit(args[i][partitionDigitIdx]) {
                    log("clarusc emit68k --partition: not a positive number: " + args[i])
                    quit 2
                }
                partitionDigitIdx = partitionDigitIdx + 1
            }
            cgSizePartitionBytes = cgParseDecimal(args[i])
            if args[i].length == 0 or cgSizePartitionBytes <= 0 {
                log("clarusc emit68k --partition: not a positive number: " + args[i])
                quit 2
            }
        } else {
            fileArgs.add(args[i])
        }
        i = i + 1
    }
    if emitMode and not haveOutPath {
        log("usage: clarusc emit -o OUT.c FILE...")
        quit 2
    }
    if emitMode68k and not haveOutPath {
        log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] FILE...")
        quit 2
    }
    if bakeIrMode and not haveOutPath {
        log("usage: clarusc --bake-ir --lane 68k|c -o OUT.clir [--rtdir DIR]")
        quit 2
    }
    if bakeIrMode and fileArgs.count > 0 {
        log("clarusc --bake-ir: no FILE arguments accepted (the runtime chain is the program)")
        quit 2
    }
    if fileArgs.count == 0 and not bakeIrMode {
        log("usage: clarusc [emit -o OUT.c | emit68k -o OUT.bin | appinfo | --bake-ir --lane 68k|c -o OUT.clir] FILE...")
        quit 2
    }

    // runtime-ir-bake Task 3: bakeIrMode never touches driveCompile at
    // all (there is no user program -- the runtime chain itself is
    // "the program", per bake.cla's own doc comment) -- resolve --lane,
    // generate, and quit before the ordinary check/emit pipeline below.
    if bakeIrMode {
        if not haveLaneFlag or (laneFlag != "68k" and laneFlag != "c") {
            log("usage: clarusc --bake-ir --lane 68k|c -o OUT.clir [--rtdir DIR]")
            quit 2
        }
        if laneFlag == "68k" {
            laneInt = bkLane68k
        } else {
            laneInt = bkLaneC
        }
        if not bakeWriteFile(laneInt, outPath) {
            if entryFailed {
                log("cannot open entry file")
                quit 1
            }
            i = 0
            while i < diags.count {
                alert(formatDiag(poolGet(diagPaths[i]), diags[i]))
                i = i + 1
            }
            quit 1
        }
        // Task 6 (Mac integration): unconditionally also write a tiny
        // ".stamp" sidecar next to outPath -- 4 raw bytes, the same
        // bkLastStamp value just embedded in outPath's own header, packed
        // the same way (bkPutU32). cliResolveBakeIr's own `emit68k
        // --bake-ir FILE` embed path REQUIRES this file to exist
        // alongside FILE; writing it unconditionally here (not behind a
        // flag) means every `--bake-ir` output is embed-ready with no
        // extra step, and a stale/hand-copied .clir with no sidecar fails
        // loudly at embed time instead of silently refusing at Mac
        // runtime (see cliResolveBakeIr's own doc comment).
        stampBytes = ""
        bkPutU32(stampBytes, bkLastStamp)
        if not file.writeText(outPath + ".stamp", stampBytes, fileTypeData, "????") {
            log("clarusc --bake-ir: cannot write " + outPath + ".stamp: " + lastError.message)
            quit 1
        }
        quit 0
    }

    // runtime-ir-bake Task 5: --rtbake + --testapi is now supported --
    // driveCompile's own bake-path check#1 branch preloads the baked
    // checker symbols instead of re-parsing uitest.cla from source (see
    // its own doc comment, drive.cla). No CLI-level refusal needed here
    // any more (Task 4's own, now removed).
    if haveRtbakeFlag {
        rtbakeBytes = ""
        if not file.readText(rtbakePath, rtbakeBytes) {
            log("clarusc: cannot read --rtbake " + rtbakePath + ": " + lastError.message)
            quit 1
        }
        haveRtbake = true
    }

    // Task 6 (mac-resident-clarusc): the whole pipeline -- Phase A
    // expand/lex/parse, the --testapi early splice, the first checkProgram
    // pass, and (only when wantEmit) the runtime-manifest splice, second
    // checkProgram pass, and lowerProgram -- now lives in drive.cla's
    // driveCompile, shared with the future macgui front end. wantEmit/
    // want68k tell it how far to go, mirroring the original
    // `if emitMode or emitMode68k` / `if emitMode68k` gates now that
    // check-only, appinfo, emit, and emit68k all share this one call.
    wantEmit = emitMode or emitMode68k
    want68k = emitMode68k
    ok = driveCompile(fileArgs, testApiFlag)
    if not ok {
        // entryFailed (an unreadable entry file) is checked BEFORE `diags`
        // -- it is reported the moment Phase A hits it, before any
        // checkProgram pass has run, so diags is still empty in that case
        // and this exactly reproduces the original message/precedence.
        if entryFailed {
            log("cannot open entry file")
            quit 1
        }
        // Print every diagnostic as "path:line:col: message", parse phase
        // before check phase, matching clarus check's stdout exactly.
        i = 0
        while i < diags.count {
            alert(formatDiag(poolGet(diagPaths[i]), diags[i]))
            i = i + 1
        }
        quit 1
    }

    // appinfo path: print the checked program's app metadata as key=value
    // lines, in the fixed order Task 6's shell parser depends on (app=1,
    // name=, version=, id=, icon=, only lines that apply -- name= always).
    // name resolves name-property > app label > first file's basename minus
    // ".cla". icon is joined against the app section's OWN declaring file's
    // directory (appDeclPathIdx), not the entry file's -- an app section
    // reached via include lives in a different directory than the entry.
    // `combined` is drive.cla's own global, the first-pass assembled chain
    // driveCompile just left in place.
    if appinfoMode {
        d = combined
        appIdx = -1
        while d != -1 {
            if declKind(d) == DkApp { appIdx = d }
            d = declNext(d)
        }
        resolved = ""
        nameV = ""
        versionV = ""
        idV = ""
        iconV = ""
        if appIdx != -1 {
            alert("app=1")
            item = appDeclPropsHead(appIdx)
            while item != -1 {
                pname = poolGet(propertyName(item))
                vh = propertyValuesHead(item)
                if pname == "name" { nameV = poolGet(stringLitIdx(vh)) }
                if pname == "version" { versionV = poolGet(stringLitIdx(vh)) }
                if pname == "id" { idV = poolGet(stringLitIdx(vh)) }
                if pname == "icon" { iconV = poolGet(stringLitIdx(vh)) }
                item = declNext(item)
            }
            if nameV != "" { resolved = nameV } else { resolved = poolGet(appDeclName(appIdx)) }
        }
        if resolved == "" { resolved = baseNameNoExt(fileArgs[0]) }
        alert("name=" + resolved)
        if versionV != "" { alert("version=" + versionV) }
        if idV != "" { alert("id=" + idV) }
        if iconV != "" { alert("icon=" + joinPath(dirOf(poolGet(appDeclPathIdx(appIdx))), iconV)) }
        quit 0
    }

    // Emit path: driveCompile already required the user program to check
    // CLEAN STANDALONE, consulted the runtime-module manifest, re-checked,
    // and lowered to IR (wantEmit was set above) -- only the target-
    // specific back end is left here.
    if emitMode {
        shakeProgram()
        cSrc = emitProgram()
        wrote = file.writeText(outPath, cSrc, app.doctype, app.id)
        if not wrote {
            log("clarusc emit: cannot write " + outPath + ": " + lastError.message)
            quit 1
        }
    } else if emitMode68k {
        if haveEvents {
            eventsBytes = ""
            if not file.readText(eventsPath, eventsBytes) {
                log("clarusc emit68k: cannot read " + eventsPath + ": " + lastError.message)
                quit 1
            }
            cgEventsBytes = eventsBytes
        } else {
            cgEventsBytes = ""
        }
        // Task 5 (mac-resident-clarusc): read each --bake FILE now that the
        // whole flag list is known -- cliResolveBake below does the actual
        // validation/read (split out of this handler to stay clear of
        // App.startCLI's own per-function 32KB native segment budget,
        // TestSelfEmit68k's own headline gate).
        cliResolveBake(bakePaths)
        // Task 6: --bake-ir FILE embeds the CLIR artifact (+ its stamp
        // sidecar) as two more resources, appended after --bake's own
        // ordinary CLFS entries (cliResolveBake, just above, already
        // reset+filled cgBakeNames/cgBakeTypes/cgBakeDatas -- this only
        // appends).
        if haveBakeIrEmbed {
            cliResolveBakeIr(bakeIrEmbedPath)
        }
        ok68 = driveEmit68k(outPath, listingFlag, segLimitFlag, nopeepFlag)
        if not ok68 {
            log("clarusc emit68k: driveEmit68k failed")
            quit 1
        }
        driveProgressDone()
    }
    quit 0
}

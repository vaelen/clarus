// main.cla: the clarusc CLI driver -- the check-only compiler front end that
// ties lex.cla + parse.cla + check.cla together and prints diagnostics
// byte-identically to `clarus check`.
//
// Pipeline, in the Go compiler's TWO-PHASE order (internal/driver/driver.go
// + internal/check/check.go), which is load-bearing for multi-file parity:
//   Phase A -- include-expand every entry file, lexing+parsing each in
//     DFS/expansion order and collecting all parse-phase diagnostics as it
//     goes (pre-order per driver.go: a file's own parse diags precede its
//     includes'; the assembled decl lists are post-order so a dependency's
//     declarations precede the includer's).
//   Phase B -- run checkProgram ONCE over the whole assembled decl list,
//     collecting check-phase diagnostics.
// All parse diagnostics therefore print before all check diagnostics, exactly
// as the Go compiler orders them. Diagnostics are printed via alert as
// "path:line:col: message" (source.Diag.String()); quit 1 if any, else 0.

include "lib.cla"
include "tok.cla"
include "lex.cla"
include "ast.cla"
include "parse.cla"
include "types.cla"
include "check.cla"
include "ir.cla"
include "lower.cla"
include "shake.cla"
include "asm68k.cla"
include "peep68k.cla"
include "app68k.cla"
include "res68k.cla"
include "cprint.cla"
include "cg68k.cla"
include "uiblob.cla"

// seenPaths keys the include-once set (driver.go's `seen`), keyed by the
// path after normalizePath's lexical cleanup: "//" and "./" segments
// collapsed and "seg/.." pairs resolved, so "sub/common.cla" and
// "sub/../sub/common.cla" are the same identity. Purely lexical -- an
// absolute and a relative spelling of the same file stay distinct by design.
// The VALUE is the file's asmHeads index PLUS ONE once expand has finished
// parsing it, or 0 while its expansion is still in progress (an include
// cycle re-entering it) -- dedupHits below turns that back into an index.
var seenPaths: map of int

// asmHeads holds each expanded file's decl-list head in POST-ORDER
// (dependencies before includers), matching driver.go's files/trees order.
var asmHeads: list of int

// asmTails is parallel to asmHeads: each file's OWN last decl, recorded at
// parse time before any assembly loop links one file's tail to the next
// file's head. lastDecl() answers the same question only while a head is
// still unlinked, so any assembly that re-orders already-linked segments
// (the hoist path below) must use this instead.
var asmTails: list of int

// dedupHits records, in expansion order, the asmHeads index of every file
// whose expansion was skipped because it had already been expanded (-1 for
// a still-in-progress cycle). The runtime-module splices read the slice of
// this list their own expand() call appended: a runtime module that
// include-dedups against a file the USER already composed positionally
// needs that file's decls HOISTED out of the user chain and into the
// runtime chain, ahead of the module that needs them (extern record TYPE
// references are order-sensitive, unlike function references).
var dedupHits: list of int

// hoistedHead flags the asmHeads indices already hoisted out of the user
// chain (one entry per user-side file, filled at the end of Phase A), and
// hoistCount counts them -- a splice that hoisted nothing rebuilds the
// combined chain exactly as it always did, by appending the user chain
// wholesale.
var hoistedHead: list of bool
var hoistCount: int

// userHeadCount is asmHeads.count after Phase A -- indices below it are the
// user program's own files (hoistable), indices at or above it belong to a
// runtime module already spliced into the runtime chain (never hoisted).
var userHeadCount: int

// entryFailed records that an entry path itself could not be read -- Go's
// Expand returns this as a hard error (clarus check: stderr + exit 1).
var entryFailed: bool

// dirOf returns path's directory including the trailing '/', or "" if path
// has no slash (mirrors filepath.Dir + a following Join for our purposes).
func dirOf(path: string): string {
    var i: int
    var last: int

    last = -1
    i = 0
    while i < path.length {
        if path[i] == '/' {
            last = i
        }
        i = i + 1
    }
    if last == -1 {
        return ""
    }
    return path[0, last + 1]
}

// baseNameNoExt returns path's final path segment with a trailing ".cla"
// stripped (if present) -- used by appinfo's filename-fallback rung.
func baseNameNoExt(path: string): string {
    var i: int
    var last: int
    var base: string

    last = -1
    i = 0
    while i < path.length {
        if path[i] == '/' {
            last = i
        }
        i = i + 1
    }
    base = path[last + 1, path.length - (last + 1)]
    if base.length >= 4 and base[base.length - 4, 4] == ".cla" {
        base = base[0, base.length - 4]
    }
    return base
}

// joinPath resolves an include's path relative to dir (filepath.Join): an
// absolute name (leading '/') wins outright, otherwise it hangs off dir.
func joinPath(dir: string, name: string): string {
    if name.length > 0 and name[0] == '/' {
        return name
    }
    return dir + name
}

// normalizePath lexically cleans a path for the include-once identity
// (seenPaths) and diagnostics: collapses "//" and "./" segments and
// resolves each "seg/.." pair, preserving a leading "/" and any leading
// "../" run. Purely lexical -- no symlink, case, or cwd resolution: an
// absolute and a relative spelling of the same file stay distinct
// (documented in the reference's include section).
func normalizePath(path: string): string {
    var segs: list of string
    var work: string
    var cur: string
    var junk: string
    var out: string
    var i: int
    var abs: bool

    abs = path.length > 0 and path[0] == '/'
    work = path + "/"
    cur = ""
    i = 0
    while i < work.length {
        if work[i] == '/' {
            if cur == ".." {
                if segs.count > 0 and segs[segs.count - 1] != ".." {
                    junk = segs.pop()
                } else if not abs {
                    segs.add("..")
                }
            } else if cur != "" and cur != "." {
                segs.add(cur)
            }
            cur = ""
        } else {
            cur = cur + work[i]
        }
        i = i + 1
    }
    out = ""
    if abs {
        out = "/"
    }
    i = 0
    while i < segs.count {
        if i > 0 {
            out = out + "/"
        }
        out = out + segs[i]
        i = i + 1
    }
    return out
}

// findRtDir resolves the default --rtdir when the flag is omitted: it walks
// UP from the current working directory looking for a "runtime/clarus/"
// directory, probed by trying to read probeFile (the first needed module's
// file name) out of each candidate. Tries the cwd itself plus up to 9 parent
// levels (10 total) and returns the first candidate that has probeFile, or
// "" if none of them do -- absence here is not itself an error; the caller
// only reports one once a needed module truly can't be found.
func findRtDir(probeFile: string): string {
    var prefix: string
    var i: int
    var candidate: string
    var probe: text
    var ok: bool

    prefix = ""
    i = 0
    while i < 10 {
        candidate = prefix + "runtime/clarus/"
        probe = ""
        ok = file.readText(candidate + probeFile, probe)
        if ok {
            return candidate
        }
        prefix = prefix + "../"
        i = i + 1
    }
    return ""
}

// lastDecl returns the last node in head's `next` chain (head must be a real
// index, not -1) -- used to splice one file's decl list onto the running
// combined list.
func lastDecl(head: int): int {
    var d: int

    d = head
    while declNext(d) != -1 {
        d = declNext(d)
    }
    return d
}

// expand loads, lexes, and parses path, recursing into its leading includes
// first (post-order decl assembly into asmHeads, pre-order parse
// diagnostics) -- a port of driver.go's inner `expand`. Returns whether path
// itself could not be read (the caller turns a missing non-entry file into a
// "cannot open included file" diagnostic at the include's position).
func expand(rawPath: string, entry: bool): bool {
    var path: string
    var src: text
    var ok: bool
    var head: int
    var dir: string
    var d: int
    var pathIdx: int
    var incName: string
    var incResolved: string
    var missing: bool

    path = normalizePath(rawPath)
    if seenPaths.has(path) {
        // Record WHICH file this include deduped against (index, or -1 for
        // a file still being expanded further up the recursion), so a
        // runtime-module splice can hoist a user-composed file it needs.
        dedupHits.add(seenPaths[path] - 1)
        return false
    }
    seenPaths[path] = 0

    src = ""
    ok = file.readText(path, src)
    if not ok {
        if entry {
            entryFailed = true
        }
        return true
    }

    // Stamp every lex/parse diagnostic this file produces with its own path
    // (curPathIdx is read by emitDiag). Set it BEFORE lexing/parsing.
    pathIdx = intern(path)
    curPathIdx = pathIdx
    lexAll(src)
    head = parseFile()

    // Record each top-level decl's owning file so the single check pass can
    // attribute a check diagnostic to the file its decl came from (Go's
    // per-decl c.f), not the entry path.
    d = head
    while d != -1 {
        setDeclFile(d, pathIdx)
        d = declNext(d)
    }

    dir = dirOf(path)
    d = head
    while d != -1 {
        if declKind(d) == DkInclude {
            incName = poolGet(includePath(d))
            incResolved = joinPath(dir, incName)
            missing = expand(incResolved, false)
            if missing {
                // Recursion may have moved curPathIdx into a child file;
                // restore this file's path before stamping the diagnostic,
                // which Go attributes to the includer.
                curPathIdx = pathIdx
                emitDiag(declLine(d), declCol(d), "cannot open included file \"" + incName + "\"")
            }
        }
        d = declNext(d)
    }

    asmHeads.add(head)
    if head == -1 {
        asmTails.add(-1)
    } else {
        asmTails.add(lastDecl(head))
    }
    seenPaths[path] = asmHeads.count
    return false
}

// hoistDedups returns the asmHeads INDICES of the USER-side files that the
// dedupHits entries from index fromHit onward (i.e. the ones a single
// runtime-module expand() call just appended) resolved to, marking each
// hoisted so it is skipped when the user chain is rebuilt and never hoisted
// twice. Hits on runtime-side files are ignored: those are already in the
// runtime chain, ahead of the module that deduped against them.
func hoistDedups(fromHit: int): list of int {
    var out: list of int
    var j: int
    var hit: int

    j = fromHit
    while j < dedupHits.count {
        hit = dedupHits[j]
        if hit >= 0 and hit < userHeadCount and not hoistedHead[hit] {
            hoistedHead[hit] = true
            hoistCount = hoistCount + 1
            if asmHeads[hit] != -1 {
                out.add(hit)
            }
        }
        j = j + 1
    }
    return out
}

// cliResolveBake (Task 5, mac-resident-clarusc) validates and reads every
// `emit68k --bake FILE` flag, in flag order, filling cg68k.cla's
// cgBakeNames/cgBakeDatas globals for cg68WriteImage's own CLFS-resource
// loop -- name = FILE exactly as passed (also the resource's own name),
// data = the file's raw bytes. Rejects (log + quit 2) a name over 255
// bytes (the Pascal-string name-list entry's own hard limit) or a name
// repeated across two --bake flags, both checked BEFORE any file is
// read; a file that can't be read is quit 1, same as --events. Split out
// of App.startCLI's own hand-off block, not inlined there, purely to
// stay under App.startCLI's per-function 32KB native segment budget --
// TestSelfEmit68k (internal/cg68k/selfemit_test.go) is this repo's own
// self-hosting headline gate and App.startCLI was already close to that
// ceiling before this task, same reasoning as cprint.cla's fpIntrCall1..7
// split (Task 14).
func cliResolveBake(bakePaths: list of string) {
    var bi: int
    var bj: int
    var bakeBytes: text

    cgBakeNames = cgFreshStringList()
    cgBakeDatas = cgFreshTextList()
    bi = 0
    while bi < bakePaths.count {
        if bakePaths[bi].length > 255 {
            log("clarusc emit68k --bake: name too long (" + numToStr(bakePaths[bi].length) + " bytes, max 255): " + bakePaths[bi])
            quit 2
        }
        bj = 0
        while bj < bi {
            if bakePaths[bj] == bakePaths[bi] {
                log("clarusc emit68k --bake: duplicate name: " + bakePaths[bi])
                quit 2
            }
            bj = bj + 1
        }
        bakeBytes = ""
        if not file.readText(bakePaths[bi], bakeBytes) {
            log("clarusc emit68k: cannot read " + bakePaths[bi] + ": " + lastError.message)
            quit 1
        }
        cgBakeNames.add(bakePaths[bi])
        cgBakeDatas.add(bakeBytes)
        bi = bi + 1
    }
}

on App.startCLI(args: list of string) {
    var i: int
    var combined: int
    var tail: int
    var h: int
    var emitMode: bool
    var emitMode68k: bool
    var listingFlag: bool
    var segLimitFlag: int
    var eventsPath: string
    var haveEvents: bool
    var eventsBytes: text
    var bakePaths: list of string
    var ok68: bool
    var appinfoMode: bool
    var startArg: int
    var outPath: string
    var haveOutPath: bool
    var fileArgs: list of string
    var cSrc: text
    var wrote: bool
    var d: int
    var appIdx: int
    var resolved: string
    var nameV: string
    var versionV: string
    var idV: string
    var iconV: string
    var item: int
    var pname: string
    var vh: int
    var rtDir: string
    var haveRtDir: bool
    var isUiProg: bool
    var testApiFlag: bool
    var earlySpliceDone: bool
    var earlyIsUiProg: bool
    var earlyMods: list of string
    var earlyRtHeads: list of int
    var earlyTail: int
    var neededMods: list of string
    var rtHeads: list of int
    var combined2: int
    var rtTail: int
    var rtPath: string
    var rtProbe: text
    var j: int
    var rtReadable: bool
    var beforeCount: int
    var beforeHits: int
    var hoists: list of int
    var hoistBefore: int

    // Reset-at-start: one clarusc invocation checks (or emits) one program
    // (each differential-harness case is a fresh exec). These resets clear the
    // module-level state the pipeline reuses, so a program is processed from a
    // clean slate regardless of how the process was entered.
    resetDiags()
    astReset()

    if args.count == 0 {
        log("usage: clarusc [emit -o OUT.c | emit68k -o OUT.bin | appinfo] FILE...")
        quit 2
    }

    // Subcommand: `clarusc emit -o OUT.c FILE...` runs the same pipeline as
    // the default check, then -- only if there are zero diagnostics -- lowers
    // to IR, builds the C translation unit, and writes it to OUT.c via
    // file.writeText (byte-faithful, no per-line length cap -- unlike stdout
    // via alert, which is capped at a string's 255 bytes per line).
    // `clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] FILE...` (native-5d
    // Task 7) runs the SAME check + runtime-manifest pipeline as emit, then
    // roots the native-only entry points (cg68AddRoots), shakes, and hands
    // off to cg68Program (cg68k.cla) instead of emitProgram -- see
    // cg68Program's own doc comment for what it writes today (a single-
    // segment listing, with --listing; no .bin container until Task 10).
    // Subcommand `clarusc appinfo FILE...` runs the same check pipeline and,
    // on success, prints the program's app metadata as key=value lines
    // instead of emitting (see the appinfoMode block below). emit/emit68k/
    // appinfo are mutually exclusive; the default (none of them) checks and
    // prints diagnostics exactly as before.
    emitMode = false
    emitMode68k = false
    listingFlag = false
    segLimitFlag = 0
    eventsPath = ""
    haveEvents = false
    appinfoMode = false
    startArg = 0
    if args[0] == "emit" {
        emitMode = true
        startArg = 1
    }
    if args[0] == "emit68k" {
        emitMode68k = true
        startArg = 1
    }
    if args[0] == "appinfo" {
        appinfoMode = true
        startArg = 1
    }
    if startArg >= args.count {
        log("usage: clarusc [emit -o OUT.c | emit68k -o OUT.bin | appinfo] FILE...")
        quit 2
    }

    // Collect input files, diverting emit's "-o PATH" and "--rtdir DIR"
    // (which may appear before or after the input files) out of the file
    // list. --rtdir overrides findRtDir's default upward search for the
    // directory holding the runtime modules the implicit-inclusion manifest
    // (below, emit-mode only) may need.
    outPath = ""
    haveOutPath = false
    rtDir = ""
    haveRtDir = false
    i = startArg
    while i < args.count {
        if (emitMode or emitMode68k) and args[i] == "-o" {
            i = i + 1
            if i >= args.count {
                if emitMode68k {
                    log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] FILE...")
                } else {
                    log("usage: clarusc emit -o OUT.c FILE...")
                }
                quit 2
            }
            outPath = args[i]
            haveOutPath = true
        } else if (emitMode or emitMode68k) and args[i] == "--rtdir" {
            i = i + 1
            if i >= args.count {
                if emitMode68k {
                    log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] FILE...")
                } else {
                    log("usage: clarusc emit -o OUT.c [--rtdir DIR] [--testapi] FILE...")
                }
                quit 2
            }
            rtDir = args[i]
            if rtDir.length > 0 and rtDir[rtDir.length - 1] != '/' {
                rtDir = rtDir + "/"
            }
            haveRtDir = true
        } else if (emitMode or emitMode68k or appinfoMode) and args[i] == "--testapi" {
            // ui-scenario-retirement Task 2: opts a UI program into an
            // early splice of the UI runtime set + uitest.cla (below, "Early
            // --testapi splice"), ahead of the ordinary "must check clean
            // standalone" gate, so `UiTest*` names resolve. A bare flag
            // like --listing -- no following argument. appinfoMode accepts
            // it too (ui-scenario-retirement Task 3 fix round 1, ratified
            // 2026-08-05): `clarusc appinfo` runs the SAME unconditional
            // checkProgram pass every mode does (below), so a --testapi
            // program's own appinfo call needs the identical early splice
            // or it fails the clean-standalone gate before ever reaching
            // the appinfoMode print block -- the early-splice block itself
            // (below) is already mode-agnostic (gated on testApiFlag alone,
            // never on emitMode/emitMode68k), so no other change is needed.
            testApiFlag = true
        } else if emitMode68k and args[i] == "--listing" {
            listingFlag = true
        } else if emitMode68k and args[i] == "--nopeep" {
            // peephole68k diagnostic escape hatch (deliberately
            // undocumented, like --seglimit): skip the peephole pass so
            // a native-lane bug can be triangulated as
            // peephole-induced or not in one rebuild.
            peepDisabled = true
        } else if emitMode68k and args[i] == "--seglimit" {
            // Test-only override of cg68Program's per-segment payload
            // budget (default 32760) -- deliberately UNDOCUMENTED in the
            // usage strings above: it exists so a test can force a small
            // program into several real segments (proving cross-segment
            // calls + LoadSeg work on real hardware) without needing a
            // suite-sized fixture. See clarusc/cg68k.cla's cg68Program doc
            // comment.
            i = i + 1
            if i >= args.count {
                log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] [--seglimit N] FILE...")
                quit 2
            }
            segLimitFlag = cgParseDecimal(args[i])
        } else if emitMode68k and args[i] == "--events" {
            // Task 12 (native-5e): a scripted-event source file, byte-for-
            // byte identical in purpose to scripts/build-mac.sh's own
            // `--events FILE` (which round-trips the file through a
            // generated C string literal for the cprint lane) -- here the
            // raw file bytes are poured straight into the native constant
            // pool (cgEventsBytes, read below, consumed by cg68k.cla's
            // cgEmitUiEventsPool), NUL-terminated, with no C-string
            // escaping needed since nothing re-parses it as source.
            i = i + 1
            if i >= args.count {
                log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] [--seglimit N] [--events FILE] FILE...")
                quit 2
            }
            eventsPath = args[i]
            haveEvents = true
        } else if emitMode68k and args[i] == "--bake" {
            // Task 5 (mac-resident-clarusc): repeatable -- one 'CLFS'
            // resource per flag, baked into the emitted .bin's resource
            // fork (cg68WriteImage, cg68k.cla) so a native clarusc binary
            // can carry its own runtime/toolbox catalog sources. Files are
            // actually read at hand-off time below (mirrors --events),
            // once the whole flag list is known (needed for the
            // duplicate-name check).
            i = i + 1
            if i >= args.count {
                log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] [--seglimit N] [--events FILE] [--bake FILE]... FILE...")
                quit 2
            }
            bakePaths.add(args[i])
        } else {
            fileArgs.add(args[i])
        }
        i = i + 1
    }
    if emitMode and not haveOutPath {
        log("usage: clarusc emit -o OUT.c FILE...")
        quit 2
    }
    if emitMode68k and not haveOutPath {
        log("usage: clarusc emit68k -o OUT.bin [--rtdir DIR] [--testapi] [--listing] FILE...")
        quit 2
    }
    if fileArgs.count == 0 {
        log("usage: clarusc [emit -o OUT.c | emit68k -o OUT.bin | appinfo] FILE...")
        quit 2
    }

    // Phase A: include-expand + lex + parse every entry file, collecting all
    // parse-phase diagnostics.
    i = 0
    while i < fileArgs.count {
        expand(fileArgs[i], true)
        i = i + 1
    }
    if entryFailed {
        log("cannot open entry file")
        quit 1
    }
    // Everything expanded so far is the user program's own; everything a
    // runtime-module splice expands from here on is runtime-side.
    userHeadCount = asmHeads.count
    i = 0
    while i < userHeadCount {
        hoistedHead.add(false)
        i = i + 1
    }

    // Assemble the post-order decl lists into one chain for the single
    // checker pass.
    combined = -1
    tail = -1
    i = 0
    while i < asmHeads.count {
        h = asmHeads[i]
        if h != -1 {
            if combined == -1 {
                combined = h
            } else {
                tail = declListAppend(tail, h)
            }
            tail = lastDecl(h)
        }
        i = i + 1
    }

    // Early --testapi splice (ui-scenario-retirement Task 2, Component 1b):
    // a program calling any `UiTest*` name (uitest.cla) would otherwise
    // fail the ordinary "clean standalone" gate just below outright --
    // UiTestClick and friends are ordinary top-level funcs, declared only
    // in uitest.cla, not built-in language surface, so the checker has
    // nowhere to resolve them without the splice. `--testapi` opts a UI
    // program into splicing the SAME runtime-module set the ordinary
    // post-check manifest below would eventually add (core/str/text/list/
    // map, UNCONDITIONAL, plus uidesc/ui/uiwidgets/uitext/uitable/
    // uiscript/uidialogs, isUiProg-gated) PLUS uitest.cla, in BEFORE this
    // first checkProgram call -- so the ONE call just below both replaces
    // the "clean standalone" gate and resolves every UiTest* name at once,
    // rather than needing a second, separate check pass the way the
    // ordinary post-check manifest splice does. isUiProg is computed here
    // from the PARSED decl list (the exact same parse-level window/menu/
    // every scan the ordinary post-check block repeats below, at its own
    // "isUiProg reports whether..." comment) -- duplicated rather than
    // hoisted into a shared call so the untouched no-flag path is provably
    // unaffected by this addition; available before check since window/
    // menu/every detection needs no type info. A non-UI program is
    // unaffected either way: earlyIsUiProg stays false, nothing is
    // spliced, and the ordinary "clean standalone" check below runs
    // exactly as it always has.
    //
    // ser.cla's own usage-flag splice is deliberately NOT part of this
    // early set and stays untouched, gated on usesFileSaveLoad in the
    // ordinary post-check block below exactly as before: no ui*.cla module
    // calls rtFileSave/rtFileLoad, so ser.cla needs no early presence, and
    // usesFileSaveLoad itself is only known as a side effect of a
    // checkProgram pass over the user's own calls -- unknowable before any
    // check has run. native.cla is likewise never part of this early set:
    // it resolves purely by name at codegen time (cgCallExtNatFallback),
    // never by declare-before-use, so it needs no check-time presence,
    // early or otherwise.
    earlySpliceDone = false
    if testApiFlag and combined != -1 {
        earlyIsUiProg = false
        d = combined
        while d != -1 {
            if declKind(d) == DkWindow or declKind(d) == DkMenu or declKind(d) == DkEvery {
                earlyIsUiProg = true
            }
            d = declNext(d)
        }
        if earlyIsUiProg {
            earlyMods.add("core.cla")
            earlyMods.add("str.cla")
            earlyMods.add("text.cla")
            earlyMods.add("list.cla")
            earlyMods.add("map.cla")
            earlyMods.add("uidesc.cla")
            earlyMods.add("ui.cla")
            earlyMods.add("uiwidgets.cla")
            earlyMods.add("uitext.cla")
            earlyMods.add("uitable.cla")
            earlyMods.add("uiscript.cla")
            earlyMods.add("uidialogs.cla")
            earlyMods.add("uitest.cla")
            // Same "set the flag true directly, right alongside the
            // manifest decision" convention the ordinary post-check block
            // uses for these same eight flags -- true here regardless of
            // whether that block's own (now-guarded, `not earlySpliceDone`)
            // copy of this same assignment would otherwise run.
            cpCorePorted = true
            cpStrPorted = true
            cpTextPorted = true
            cpTextArcPorted = true
            cpListPorted = true
            cpListArcPorted = true
            cpMapPorted = true
            cpMapArcPorted = true

            if not haveRtDir {
                rtDir = findRtDir(earlyMods[0])
            }
            i = 0
            while i < earlyMods.count {
                rtPath = joinPath(rtDir, earlyMods[i])
                rtProbe = ""
                rtReadable = file.readText(rtPath, rtProbe)
                if not rtReadable {
                    if haveRtDir {
                        log("runtime module " + earlyMods[i] + " not found (searched " + rtDir + "); use --rtdir")
                    } else {
                        log("runtime module " + earlyMods[i] + " not found (searched runtime/clarus/ from the working directory upward); use --rtdir")
                    }
                    quit 1
                }
                // Same whole-range capture as the ordinary post-check
                // splice loop below -- a multi-file runtime module (one
                // that itself `include`s another) pushes more than one
                // asmHeads entry per expand call. Files this module's
                // includes deduped against (a file the user already
                // composed positionally) push no asmHeads entry at all, so
                // they are hoisted separately, AHEAD of this module's own
                // heads -- post-order, exactly where a freshly expanded
                // include would have landed.
                beforeCount = asmHeads.count
                beforeHits = dedupHits.count
                expand(rtPath, true)
                hoists = hoistDedups(beforeHits)
                j = 0
                while j < hoists.count {
                    earlyRtHeads.add(hoists[j])
                    j = j + 1
                }
                j = beforeCount
                while j < asmHeads.count {
                    if asmHeads[j] != -1 {
                        earlyRtHeads.add(j)
                    }
                    j = j + 1
                }
                i = i + 1
            }

            // Rebuild `combined` with the early runtime-module heads FIRST
            // (declare-before-use), followed by the original user-program
            // chain -- same rebuild shape the ordinary post-check splice
            // uses for combined2 below, just landing in `combined` itself
            // so the single checkProgram call just below sees the whole
            // thing. earlyRtHeads holds asmHeads INDICES (not heads), so
            // each segment's own end comes from asmTails -- lastDecl would
            // run off the end of a HOISTED segment, whose tail Phase A
            // already linked to the next user file's head.
            earlyTail = -1
            combined2 = -1
            i = 0
            while i < earlyRtHeads.count {
                h = asmHeads[earlyRtHeads[i]]
                if combined2 == -1 {
                    combined2 = h
                } else {
                    earlyTail = declListAppend(earlyTail, h)
                }
                earlyTail = asmTails[earlyRtHeads[i]]
                i = i + 1
            }
            if combined2 == -1 {
                combined2 = combined
            } else if hoistCount == 0 {
                earlyTail = declListAppend(earlyTail, combined)
            } else {
                // Hoisting happened: the user chain has to be re-linked
                // segment by segment, skipping the hoisted files (now in
                // the runtime chain above) and terminating explicitly --
                // the last kept segment's `next` still points at whatever
                // Phase A linked after it, which may be a hoisted file.
                i = 0
                while i < userHeadCount {
                    h = asmHeads[i]
                    if h != -1 and not hoistedHead[i] {
                        earlyTail = declListAppend(earlyTail, h)
                        earlyTail = asmTails[i]
                    }
                    i = i + 1
                }
                earlyTail = declListAppend(earlyTail, -1)
            }
            combined = combined2
            earlySpliceDone = true
        }
    }

    // Phase B: one checker pass over the whole program, collecting all
    // check-phase diagnostics (they follow every parse diagnostic). The
    // checker switches curPathIdx per top-level decl (setCheckPath) so each
    // check diagnostic is stamped with its decl's file, exactly as the Go
    // checker attributes to files[i] / dd.f rather than the entry path.
    if combined != -1 {
        checkProgram(combined)
    }

    // Print every diagnostic as "path:line:col: message", parse phase before
    // check phase, matching clarus check's stdout exactly.
    i = 0
    while i < diags.count {
        alert(formatDiag(poolGet(diagPaths[i]), diags[i]))
        i = i + 1
    }

    // A program that fails checking is never emitted: print its diagnostics
    // and quit 1, exactly as the default check path does.
    if diags.count > 0 {
        quit 1
    }

    // appinfo path: print the checked program's app metadata as key=value
    // lines, in the fixed order Task 6's shell parser depends on (app=1,
    // name=, version=, id=, icon=, only lines that apply -- name= always).
    // name resolves name-property > app label > first file's basename minus
    // ".cla". icon is joined against the app section's OWN declaring file's
    // directory (appDeclPathIdx), not the entry file's -- an app section
    // reached via include lives in a different directory than the entry.
    if appinfoMode {
        d = combined
        appIdx = -1
        while d != -1 {
            if declKind(d) == DkApp { appIdx = d }
            d = declNext(d)
        }
        resolved = ""
        nameV = ""
        versionV = ""
        idV = ""
        iconV = ""
        if appIdx != -1 {
            alert("app=1")
            item = appDeclPropsHead(appIdx)
            while item != -1 {
                pname = poolGet(propertyName(item))
                vh = propertyValuesHead(item)
                if pname == "name" { nameV = poolGet(stringLitIdx(vh)) }
                if pname == "version" { versionV = poolGet(stringLitIdx(vh)) }
                if pname == "id" { idV = poolGet(stringLitIdx(vh)) }
                if pname == "icon" { iconV = poolGet(stringLitIdx(vh)) }
                item = declNext(item)
            }
            if nameV != "" { resolved = nameV } else { resolved = poolGet(appDeclName(appIdx)) }
        }
        if resolved == "" { resolved = baseNameNoExt(fileArgs[0]) }
        alert("name=" + resolved)
        if versionV != "" { alert("version=" + versionV) }
        if idV != "" { alert("id=" + idV) }
        if iconV != "" { alert("icon=" + joinPath(dirOf(poolGet(appDeclPathIdx(appIdx))), iconV)) }
        quit 0
    }

    // Emit path: the gate above already required the user program to check
    // CLEAN STANDALONE (check-only semantics are untouched by any of this --
    // no runtime module is ever consulted before it). Only now, for emit
    // (or emit68k -- native-5d Task 7 reuses this ENTIRE manifest block
    // unchanged, "same manifest as emit plus nothing new yet" per the plan;
    // native.cla joins the manifest in Task 11), do we consult the
    // program's usage flags (set by checkProgram just above) against the
    // hardcoded runtime-module manifest, pull in whatever they need, and
    // re-check the combined program before lowering -- a runtime-module
    // diagnostic is a compiler bug, but it must still surface, attributed
    // to the runtime file via expand's own setDeclFile loop.
    if emitMode or emitMode68k {
        // isUiProg reports whether this program declares any window, menu,
        // or `every` block -- computed from the checked AST decl list
        // (`combined`) so it's available BEFORE lowering: ir.cla's
        // irIsUiProgram() (cprint.cla) reads IR arrays lowerProgram doesn't
        // populate until later, so it can't gate the manifest splice below.
        // Same "usage flag from checkProgram's own decl list" convention as
        // usesFileSaveLoad, just computed here rather than as a check.cla
        // global (window/menu/every detection needs no type info).
        isUiProg = false
        d = combined
        while d != -1 {
            if declKind(d) == DkWindow or declKind(d) == DkMenu or declKind(d) == DkEvery {
                isUiProg = true
            }
            d = declNext(d)
        }

        // Task 13 (native-5e resource parity): resolve the app section's
        // raw name (the same name-property > app-label > file-basename
        // fallback `clarusc appinfo` uses, above) and icon path (joined
        // against the app section's OWN declaring file's directory, same
        // as appinfoMode's own iconV line) into cg68k.cla's cgAppRawName/
        // cgAppIconPath globals -- cg68WriteImage's resource builders need
        // both, and neither reaches IR (irAppName is -1 unless a `name:`
        // property was declared explicitly; icon is deliberately never
        // lowered at all, ir.cla's own header comment). emit68k-only: the
        // C lane's own icon handling is scripts/build-mac.sh + pbm2icn.c,
        // untouched by this task.
        if emitMode68k {
            d = combined
            appIdx = -1
            while d != -1 {
                if declKind(d) == DkApp { appIdx = d }
                d = declNext(d)
            }
            nameV = ""
            iconV = ""
            resolved = ""
            if appIdx != -1 {
                item = appDeclPropsHead(appIdx)
                while item != -1 {
                    pname = poolGet(propertyName(item))
                    vh = propertyValuesHead(item)
                    if pname == "name" { nameV = poolGet(stringLitIdx(vh)) }
                    if pname == "icon" { iconV = poolGet(stringLitIdx(vh)) }
                    item = declNext(item)
                }
                if nameV != "" { resolved = nameV } else { resolved = poolGet(appDeclName(appIdx)) }
            }
            if resolved == "" { resolved = baseNameNoExt(fileArgs[0]) }
            cgAppRawName = resolved
            if appIdx != -1 and iconV != "" {
                cgAppIconPath = joinPath(dirOf(poolGet(appDeclPathIdx(appIdx))), iconV)
            } else {
                cgAppIconPath = ""
            }
        }

        // Plan native-5d Task 3: core.cla is spliced FIRST, ahead of every
        // other manifest entry -- str.cla/text.cla/list.cla/map.cla/
        // ser.cla all call its rtSetLastErr/rtPanic directly now (no more
        // per-module *SetLastErr/*Panic externs), and the flat top-level
        // scope checkFuncSig shares across this whole splice requires
        // declare-before-use. UNCONDITIONAL like str/text/list/map below
        // (every emitted program needs it transitively through those),
        // same "set the flag true directly, right alongside the manifest
        // decision" convention every other unconditional module uses.
        //
        // ui-scenario-retirement Task 2: this whole block -- the core/str/
        // text/list/map UNCONDITIONAL splice through the isUiProg-gated
        // UI-set splice just below -- is guarded by `not earlySpliceDone`
        // (interior left at its original indent, not re-indented under the
        // new guard, to keep this diff a pure wrap): when --testapi's
        // early splice (above, before the first checkProgram call) already
        // spliced this exact module set into `combined`, re-adding it here
        // would double-declare every one of its functions/types and fail
        // the second checkProgram call below. ser.cla's own usage-flag
        // splice and native.cla's own emit68k-only splice (further down)
        // are OUTSIDE this guard -- neither is ever part of the early
        // splice, so both always run exactly as before.
        if not earlySpliceDone {
        cpCorePorted = true
        neededMods.add("core.cla")
        // Task 8: str.cla is the first UNCONDITIONAL entry -- every program
        // uses strings (Ch3's built-in Str255 family), so it's always
        // pulled in and cpStrPorted is always true, not gated by a usage
        // flag the way cpSerPorted/usesFileSaveLoad is.
        cpStrPorted = true
        neededMods.add("str.cla")
        // Task 9: text.cla is the second UNCONDITIONAL entry -- every
        // program uses Text (Ch3's built-in growable string type), so it's
        // always pulled in and cpTextPorted is always true, same convention
        // as str.cla just above. Added AFTER str.cla in neededMods
        // deliberately: the manifest splice order (below) is
        // declare-before-use across runtime modules, and text.cla's own
        // functions are free to call str.cla's (peekb/pokeb-based) helpers.
        cpTextPorted = true
        neededMods.add("text.cla")
        // Plan 5c wave2a Task 2: cpTextArcPorted is a SEPARATE flag from
        // cpTextPorted just above (that one gates Text's data operations,
        // wave1 Task 9; this one gates Text's retain/release/free traffic,
        // now that text.cla grows rtTextRetain/rtTextRelease too) -- same
        // "unconditional, set true directly alongside the decision"
        // convention, since text.cla is always in the manifest regardless.
        cpTextArcPorted = true
        // Task 10: list.cla is the third UNCONDITIONAL entry -- every
        // program uses List (Ch5's built-in growable collection type), so
        // it's always pulled in and cpListPorted is always true, same
        // convention as str.cla/text.cla just above. Added AFTER text.cla
        // in neededMods deliberately: same declare-before-use splice order.
        cpListPorted = true
        neededMods.add("list.cla")
        // Plan 5c wave2a Task 3: cpListArcPorted is a SEPARATE flag from
        // cpListPorted just above (that one gates List's data operations,
        // wave1 Task 10; this one gates List's retain/release/free/lastref
        // traffic, now that list.cla grows rtListRetain/rtListRelease/
        // rtListLastref too) -- same "unconditional, set true directly
        // alongside the decision" convention as cpTextArcPorted, since
        // list.cla is always in the manifest regardless.
        cpListArcPorted = true
        // Task 11: map.cla is the fourth (and last, for this wave)
        // UNCONDITIONAL entry -- every program uses Map (Ch5's built-in
        // sorted-key collection type), so it's always pulled in and
        // cpMapPorted is always true, same convention as str.cla/text.cla/
        // list.cla just above. Added AFTER list.cla in neededMods
        // deliberately: same declare-before-use splice order (map.cla
        // calls str.cla's rtStrCmp directly for key comparisons).
        cpMapPorted = true
        neededMods.add("map.cla")
        // Plan 5c wave2a Task 4: cpMapArcPorted is a SEPARATE flag from
        // cpMapPorted just above (that one gates Map's data operations,
        // wave1 Task 11; this one gates Map's retain/release/free/lastref
        // traffic, now that map.cla grows rtMapRetain/rtMapRelease/
        // rtMapLastref too) -- same "unconditional, set true directly
        // alongside the decision" convention as cpTextArcPorted/
        // cpListArcPorted, since map.cla is always in the manifest
        // regardless. This is the LAST *ArcPorted flag for this wave --
        // every heap-backed family's ARC traffic is now Clarus-owned.
        cpMapArcPorted = true
        // ui.cla/uiwidgets.cla splice in for a UI program (isUiProg,
        // computed above) ONLY -- unlike core/str/text/list/map above, a
        // non-UI program has no use for a Toolbox extern block, so this is
        // gated like ser.cla's own usesFileSaveLoad block just below, not
        // unconditional. Spliced AFTER map.cla (declare-before-use is moot
        // here -- these add pure extern declarations, no bodies calling
        // anything else in the manifest yet) and BEFORE ser.cla, mirroring
        // the ser.cla gated-splice pattern this comment sits next to.
        if isUiProg {
            // Task 7 Step 2: uidesc.cla (blob accessors + RtUiWinst/
            // RtUiCanvasBuf overlay-record TYPES + rtUiAllocLocked) splices
            // BEFORE ui.cla/uiwidgets.cla -- same "foundational types
            // first" convention str->text->list->map already established;
            // ui.cla/uiwidgets.cla's own Step 3+ bodies call uidesc.cla's
            // accessors and use its overlay record types.
            neededMods.add("uidesc.cla")
            neededMods.add("ui.cla")
            neededMods.add("uiwidgets.cla")
            // Task 8: uitext.cla (TextEdit field/textview widgets --
            // extern block + mutation funnel/relayout/focus/scrollbar
            // machinery) -- spliced right after uiwidgets.cla, same
            // "whole-program visibility makes splice order irrelevant to
            // correctness" note the uiscript.cla comment just below
            // already gives; placed here rather than after uiscript.cla
            // purely to keep the widget-surface modules (uidesc/ui/
            // uiwidgets/uitext/uitable) grouped together ahead of the
            // trace/scripted-interpreter module.
            neededMods.add("uitext.cla")
            // Task 9: uitable.cla (List Manager tables, manual popups, the
            // LDEF stub) -- spliced right after uitext.cla, same "whole-
            // program visibility makes splice order irrelevant to
            // correctness" note as uitext.cla's own comment above (its own
            // ser.cla RtFt* constant references resolve fine regardless of
            // ser.cla's own later splice position, below).
            neededMods.add("uitable.cla")
            // Task 7 Step 5: uiscript.cla (trace helpers + scripted
            // interpreter + snap) -- spliced last of the four ui*.cla
            // modules; its own trace helpers are called BY ui.cla/
            // uiwidgets.cla (whole-program visibility makes the splice
            // order itself irrelevant to that -- see docs/clarus-
            // language-reference.md:736), so this position is only
            // "last" by the brief's own stated file-creation order, not
            // a real dependency requirement.
            neededMods.add("uiscript.cla")
            // Task 10: uidialogs.cla (dialogs, StandardFile, modal forms --
            // gModal + the fill/validate/writeback walker) -- spliced last;
            // same "whole-program visibility makes splice order irrelevant
            // to correctness" note as uiscript.cla's own comment above (its
            // own uitable.cla RtFt*/rtUiKindPopup/uiscript.cla answer-queue
            // references resolve fine regardless of splice position).
            neededMods.add("uidialogs.cla")
        }
        } // end `if not earlySpliceDone` (ui-scenario-retirement Task 2)
        // The manifest: Task 4 (Plan 5b) shipped exactly this one usage-
        // flag/file pair (ser.cla) plus the machinery; Task 7 repointed
        // "ser.cla" at the real serialization module (rtFileSave/
        // rtFileLoad, replacing the placeholder). As of Plan native-5d
        // Task 4, ser.cla is spliced LAST, AFTER str/text/list/map above
        // (not right after core.cla, its original position) -- ser.cla's
        // rtFileSave/rtFileLoad now call list.cla's/map.cla's
        // rtList*/rtMap* functions directly for LIST/MAP save/load
        // (replacing the old C-extern SerList*/SerMap* shims), so
        // declare-before-use across this flat top-level splice scope
        // requires list.cla/map.cla ahead of ser.cla. cpSerPorted
        // (cprint.cla) is set directly here, right alongside the manifest
        // decision it mirrors, so it's always correct per-program even
        // when this process compiles many programs in a row (differential/
        // selfhost harnesses).
        cpSerPorted = usesFileSaveLoad
        if usesFileSaveLoad {
            neededMods.add("ser.cla")
        }

        // Task 11: native.cla is the manifest's LAST entry, emit68k-only
        // (never emit's C target -- the C target's own console/quit/
        // panic/args resolution is runtime/mac/rt_mac.c or
        // runtime/host/rt.c, linked at the C build step, not spliced
        // Clarus source). Every earlier module's CorePanic call
        // (core.cla's rtPanic, transitively reachable from every program
        // via rtTextGrow's OOM path) resolves to native.cla's
        // nat_CorePanic purely by name at codegen time
        // (cgCallExtNatFallback) -- not by declare-before-use -- so it is
        // correct for native.cla to be spliced after everything that
        // calls it.
        if emitMode68k {
            neededMods.add("native.cla")
        }

        combined2 = combined
        if neededMods.count > 0 {
            if not haveRtDir {
                rtDir = findRtDir(neededMods[0])
            }
            hoistBefore = hoistCount
            i = 0
            while i < neededMods.count {
                rtPath = joinPath(rtDir, neededMods[i])
                rtProbe = ""
                rtReadable = file.readText(rtPath, rtProbe)
                if not rtReadable {
                    if haveRtDir {
                        log("runtime module " + neededMods[i] + " not found (searched " + rtDir + "); use --rtdir")
                    } else {
                        log("runtime module " + neededMods[i] + " not found (searched runtime/clarus/ from the working directory upward); use --rtdir")
                    }
                    quit 1
                }
                // expand recurses into rtPath's own includes BEFORE
                // appending rtPath's own head (post-order), so a single call
                // can push more than one asmHeads entry -- capture the WHOLE
                // [beforeCount, asmHeads.count) range it added, not just the
                // last one, or a multi-file runtime module would silently
                // lose its included dependencies' declarations (parsed and
                // diagnosed, but never spliced into combined2). A decl-less
                // file (today's placeholder ser.cla) pushes a -1 head -- same
                // "empty file" sentinel the original assembly loop above
                // already skips; skip it here too rather than splice a bogus
                // head. A file this module's includes deduped against --
                // one the USER already composed positionally, which
                // therefore pushes no asmHeads entry here -- is hoisted out
                // of the user chain instead, AHEAD of this module's own
                // heads (post-order, exactly where a freshly expanded
                // include would have landed): uidialogs.cla's
                // ../../toolbox/standardfile.cla declares the SFReply/
                // SFTypeList record TYPES its own externs use, and type
                // references are order-sensitive where function references
                // are not.
                beforeCount = asmHeads.count
                beforeHits = dedupHits.count
                expand(rtPath, true)
                hoists = hoistDedups(beforeHits)
                j = 0
                while j < hoists.count {
                    rtHeads.add(hoists[j])
                    j = j + 1
                }
                j = beforeCount
                while j < asmHeads.count {
                    if asmHeads[j] != -1 {
                        rtHeads.add(j)
                    }
                    j = j + 1
                }
                i = i + 1
            }

            // Rebuild the assembled program with the runtime modules' heads
            // FIRST (declare-before-use), followed by the original
            // (already fully linked) user-program chain. rtHeads holds
            // asmHeads INDICES (not heads), so each segment's own end comes
            // from asmTails -- lastDecl would run off the end of a HOISTED
            // segment, whose tail Phase A already linked to the next user
            // file's head.
            combined2 = -1
            rtTail = -1
            i = 0
            while i < rtHeads.count {
                h = asmHeads[rtHeads[i]]
                if combined2 == -1 {
                    combined2 = h
                } else {
                    rtTail = declListAppend(rtTail, h)
                }
                rtTail = asmTails[rtHeads[i]]
                i = i + 1
            }
            if combined != -1 {
                if combined2 == -1 {
                    combined2 = combined
                } else if hoistCount == hoistBefore {
                    rtTail = declListAppend(rtTail, combined)
                } else {
                    // Hoisting happened: the user chain has to be re-linked
                    // segment by segment, skipping the hoisted files (now
                    // in the runtime chain above) and terminating
                    // explicitly -- the last kept segment's `next` still
                    // points at whatever Phase A linked after it, which may
                    // be a hoisted file. Reachable only when this splice is
                    // the one that hoisted: the ONLY runtime module with
                    // includes at all is uidialogs.cla, which belongs to
                    // the `not earlySpliceDone` set above, so a --testapi
                    // build's leftover manifest here (ser.cla/native.cla,
                    // include-less) can never hoist -- and `combined` is
                    // already the early splice's own rebuilt chain.
                    i = 0
                    while i < userHeadCount {
                        h = asmHeads[i]
                        if h != -1 and not hoistedHead[i] {
                            rtTail = declListAppend(rtTail, h)
                            rtTail = asmTails[i]
                        }
                        i = i + 1
                    }
                    rtTail = declListAppend(rtTail, -1)
                }
            }

            // checkProgram resets and rebuilds all check-global state
            // itself (the same reset+check sequence as the first pass, and
            // as check_test's runCase driver uses repeatedly in-process).
            // diags is empty on entry (the gate above already required
            // that), so every diagnostic printed here is new.
            checkProgram(combined2)
            i = 0
            while i < diags.count {
                alert(formatDiag(poolGet(diagPaths[i]), diags[i]))
                i = i + 1
            }
            if diags.count > 0 {
                quit 1
            }
        }

        irReset()
        lowerProgram(combined2)
        // native-gaps-cleanup Task 2: lowerProgram can itself emitDiag now
        // (lowCheckLiteral4CCArg/lowCheckLiteralFilter, lower.cla) --
        // print+quit exactly like the two checkProgram gates above, so a
        // literal type/creator/filter diagnostic actually surfaces instead
        // of silently falling through to emission.
        i = 0
        while i < diags.count {
            alert(formatDiag(poolGet(diagPaths[i]), diags[i]))
            i = i + 1
        }
        if diags.count > 0 {
            quit 1
        }
        if emitMode {
            shakeProgram()
            cSrc = emitProgram()
            wrote = file.writeText(outPath, cSrc, app.doctype, app.id)
            if not wrote {
                log("clarusc emit: cannot write " + outPath + ": " + lastError.message)
                quit 1
            }
        } else if emitMode68k {
            // native-5d Task 7: root the native-only entry points BEFORE
            // shaking (cg68AddRoots's own doc comment, cg68k.cla), then hand
            // off to cg68Program instead of emitProgram.
            cg68AddRoots()
            // Task 8 (toolbox-integration Feature C): synthesize/root
            // one pascal glue IRFunc per `callback func` an ECbAddr decay
            // was ever built for -- see cg68SynthCbGlue's own doc comment
            // (cg68k.cla) for why this must run at this exact point too.
            cg68SynthCbGlue()
            shakeProgram()
            if haveEvents {
                eventsBytes = ""
                if not file.readText(eventsPath, eventsBytes) {
                    log("clarusc emit68k: cannot read " + eventsPath + ": " + lastError.message)
                    quit 1
                }
                cgEventsBytes = eventsBytes
            } else {
                cgEventsBytes = ""
            }
            // Task 5 (mac-resident-clarusc): read each --bake FILE now
            // that the whole flag list is known -- cliResolveBake below
            // does the actual validation/read (split out of this handler
            // to stay clear of App.startCLI's own per-function 32KB
            // native segment budget, TestSelfEmit68k's own headline gate).
            cliResolveBake(bakePaths)
            ok68 = cg68Program(outPath, listingFlag, segLimitFlag)
            if not ok68 {
                log("clarusc emit68k: cg68Program failed")
                quit 1
            }
        }
    }
    quit 0
}

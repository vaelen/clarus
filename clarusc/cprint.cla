// cprint.cla: arena IR (ir.cla) -> one self-contained C99 translation unit
// that #includes "rt.h". A port of the walking-skeleton subset of
// internal/cprint (cprint.go / funcprint.go / intr.go / types.go).
//
// Output channel: emitProgram returns the whole translation unit as one
// `text` buffer (mirrors the Go internal/cprint.Emit, which returns the unit
// as bytes) -- the caller (main.cla) writes it via file.writeText, which is
// byte-faithful and uncapped. Each section still accumulates its lines into a
// buffer as before (cType may append a clar_str_N typedef to cpTypeBuf at any
// point during body printing, the first time an unseen capacity appears, so
// the buffers are assembled fully before any line is appended to the output);
// emitProgram then appends every buffer's lines, each followed by a single LF
// (char(10)), into the returned text in Emit's fixed assembly order.
//
// ALL C-code text in this file is `text`, not `string`: a `string` is capped
// at 255 bytes, and a single emitted C line (a long `and` chain, a deeply
// nested field/index expression, a big arithmetic expression, or a
// string-literal pool line) can run well past that. A `string` would silently
// clamp such a line mid-token before it ever reached the output stage. So the
// four line buffers below are `list of text`, and every C-fragment-producing
// expression helper (fpExpr and friends) returns `text`.
//
// Bridging `string` -> `text` at the leaves: the Go compiler that builds this
// file implements the Ch3 `string` -> `text` widen only at a plain assignment
// (`t = s`) -- a user function call's argument, a function's `return` value,
// and a `list of text`'s pushed element are separate lowering paths that do
// NOT implement it. A `string` handed to a call argument or a `return` fails
// to compile (a visible C type error); a `string` pushed into a `list of
// text` is silently miscopied (a `void*` runtime call the C compiler can't
// check). So wherever a bare `string` (a literal like `"("`, an interned
// `poolGet` name, a `numToStr`/type-name result) must become or join a `text`
// value at one of those boundaries, we bridge explicitly: either a `+` with a
// `text` operand (which yields `text` by the checker's `string + text` rule),
// or the `toText` helper below for a standalone `string`. Fragment values
// flow through `text` end to end, so most concatenations are already `text`;
// toText is needed only for a pure-`string` line/return with no `text`
// operand anywhere in it.
//
// This is a representation change only: toText copies the same bytes, so every
// emitted-C byte is identical to the old `string`-typed path for any program
// whose lines fit in 255 bytes (all existing goldens). The gain is that lines
// which DON'T fit no longer truncate.
//
// This is the Task 3 skeleton: it emits ONLY what the seed program needs
// (clar_str_255, the string-literal pool, the clar_rec_Err typedef, an empty
// clar_init_globals, one void handler Func with an ExprStmt body, and main).
// Every branch a later task fills in is marked "Task 4+".

include "lib.cla"
include "ir.cla"

// ================================================================
// Whole-program buffers (cprint.go's printer struct), assembled in a fixed
// final order. One emitProgram call per process, so these start empty.
// ================================================================

var cpTypeBuf: list of text   // string-capacity (+ array-wrapper, Task 4+) typedefs
var cpLitBuf: list of text    // string-literal pool
var cpRecBuf: list of text    // record structs (seeded with clar_rec_Err) + UI state structs
var cpUiBuf: list of text     // rt_ui_widget_desc/window_desc/item_desc/menu_desc tables (Task 4)
var cpRestBuf: list of text   // globals init, funcs, main

// toText copies a `string` into a fresh `text` value. Used to bridge a bare
// `string` (a fixed C-boilerplate line, or a pure-`string` fragment/return)
// across a call-argument / return / list-push boundary, where the Go compiler
// building this file does NOT widen `string` -> `text` on its own (see the
// header comment). `var t: text = ""` is the supported Text-from-Str init;
// `t.append(s)` is rt_text_append_str.
func toText(s: string): text {
    var t: text = ""
    t.append(s)
    return t
}

// cpStrCapsEmitted keys the string capacities already emitted into cpTypeBuf
// (keyed by numToStr(n)); each clar_str_N typedef is emitted once.
var cpStrCapsEmitted: map of int

// cpArrEmitted keys the clar_arr_<elem>_<N> wrapper typedefs already
// emitted into cpRecBuf (keyed by the wrapper's own type name), so each
// distinct array shape is emitted once.
var cpArrEmitted: map of int

// cpLoopN counts default-init loop variable names (cpDefaultInit's Arr
// case) -- cprint.go's printer.loopN.
var cpLoopN: int

// ================================================================
// funcPrinter (funcprint.go): one function body's lines, temp counter, and
// indent. Modeled as module state -- one function is printed at a time and
// printing is not reentrant in the skeleton.
// ================================================================

var fpBody: list of text
var fpTmpN: int
var fpIndent: int

// fpStmtTmps names the rt_text* temps fpNewTmp has created since the
// current fpStmt began (memory-audit Task 6) -- fpStmt save/swaps this
// module list around each (re-entrant) statement it prints, the same
// pattern fpCaptureExpr (:404) uses for fpBody, so a nested statement
// (SIf/SWhile/... body, via fpStmts) tracks and frees its OWN temps without
// disturbing the enclosing statement's list. fpCaptureExpr itself does NOT
// swap this list (unlike fpBody): fpAndOr (:428) instead marks fpStmtTmps'
// count before capturing and frees/untracks anything past that mark itself,
// from INSIDE the `if` block it generates, before that block closes -- a
// temp born there is declared inside that same block (fpNewTmp still emits
// via fpEmit, into whatever fpBody currently is), so it must not be
// referenced (by a deferred free) after the block's closing brace.
var fpStmtTmps: list of text

func fpReset(indent: int) {
    while fpBody.count > 0 {
        fpBody.pop()
    }
    while fpStmtTmps.count > 0 {
        fpStmtTmps.pop()
    }
    fpTmpN = 0
    fpIndent = indent
}

// fpEmit appends one indented body line (4 spaces per indent level). `line`
// is `text`: an emitted C line can exceed a `string`'s 255-byte cap. `pad`
// is `text` too, so `pad + line` is `text` and lands in fpBody (list of
// text) without a truncating re-clamp. Callers with a pure-`string` line
// (no `text` operand) bridge it via toText -- else the `string` -> `text`
// call-argument mismatch fails to compile (a deliberate loud guard).
func fpEmit(line: text) {
    var pad: text
    var i: int

    pad = ""
    i = 0
    while i < fpIndent {
        pad = pad + "    "
        i = i + 1
    }
    fpBody.add(pad + line)
}

// fpNewTmp declares a fresh `ctype tN;` at the current position and returns
// its name (funcprint.go's newTmp). The counter is monotonic within a
// function and never reset mid-function -- load-bearing for later bootstrap
// determinism.
//
// A `rt_text *` temp is special-cased (memory-audit Task 6): NULL-initialized
// (rt_text_free is NULL-safe, rt_core.inc -- load-bearing for a temp born
// inside an `and`/`or`'s conditionally-executed captured branch, fpAndOr
// :428, whose construction can be skipped by short-circuiting) and tracked
// in fpStmtTmps for a later free (fpStmt's end-of-statement flush, or
// fpAndOr's own in-block flush for a captured-branch temp).
func fpNewTmp(ctype: string): text {
    var name: text

    fpTmpN = fpTmpN + 1
    name = "t" + numToStr(fpTmpN)
    if ctype == "rt_text *" {
        fpEmit(ctype + " " + name + " = NULL;")
        fpStmtTmps.add(name)
    } else {
        fpEmit(ctype + " " + name + ";")
    }
    return name
}

// fpHandoff marks a tracked text temp as having escaped the current
// statement -- its ownership moved into a variable, a return value, a
// list/map element, or a callee that may retain it -- so fpStmt's
// end-of-statement free must skip it (memory-audit Task 6). A no-op unless
// cexpr is EXACTLY a name currently in fpStmtTmps: a temp's own bare name is
// only ever printed as itself (fpTextConcat et al. return the raw temp
// name), so an exact match can only mean "this IS that temp," never an
// expression that merely mentions it.
func fpHandoff(cexpr: text) {
    var i: int

    i = 0
    while i < fpStmtTmps.count {
        if fpStmtTmps[i] == cexpr {
            fpStmtTmps.remove(i)
            return
        }
        i = i + 1
    }
}

// fpFreeStmtTmps emits `rt_text_free(tN);` for every name still in
// fpStmtTmps and empties the list (memory-audit Task 6). Called at the tail
// of fpStmt (the common case: temps live for the whole statement) and, by
// fpWhileStmt, right after the per-iteration condition check (a text temp a
// while-condition creates is rebuilt fresh every iteration -- see
// fpWhileStmt's own comment -- so it must be freed there, not hoisted out
// past the loop).
func fpFreeStmtTmps() {
    var i: int

    i = 0
    while i < fpStmtTmps.count {
        fpEmit("rt_text_free(" + fpStmtTmps[i] + ");")
        i = i + 1
    }
    while fpStmtTmps.count > 0 {
        fpStmtTmps.pop()
    }
}

// ================================================================
// Type printing (types.go subset)
// ================================================================

// cpCTypeName is the pure C type name for an IR type index (no side effects).
func cpCTypeName(t: int): string {
    switch irtKind(t) {
    case KVoid { return "void" }
    case KInt { return "int32_t" }
    case KBool { return "int32_t" }
    case KFixed { return "int32_t" }
    case KEnum { return "int32_t" }
    case KChar { return "uint8_t" }
    case KStr { return "clar_str_" + numToStr(irtN(t)) }
    case KText { return "rt_text *" }
    case KList { return "rt_list *" }
    case KMap { return "rt_map *" }
    case KRec { return "clar_rec_" + poolGet(irtName(t)) }
    case KErr { return "clar_rec_Err" }
    case KArr { return "clar_arr_" + cpArrKey(t) }
    case KWinRef { return "void *" }
    }
    return "void"
}

// cpArrKey names one Arr type's wrapper typedef, distinct per (element
// shape, length) pair -- a pure function of t, no side effects (types.go's
// arrKey).
func cpArrKey(t: int): string {
    return cpElemKey(irtElem(t)) + "_" + numToStr(irtN(t))
}

// cpElemKey renders t as an identifier fragment, for composing cpArrKey --
// a full port of types.go's elemKey.
func cpElemKey(t: int): string {
    switch irtKind(t) {
    case KInt { return "int" }
    case KBool { return "bool" }
    case KFixed { return "fixed" }
    case KChar { return "char" }
    case KStr { return "str" + numToStr(irtN(t)) }
    case KText { return "text" }
    case KList { return "list" }
    case KMap { return "map" }
    case KRec { return "rec_" + poolGet(irtName(t)) }
    case KEnum { return "enum_" + poolGet(irtName(t)) }
    case KErr { return "err" }
    case KArr { return "arr_" + cpArrKey(t) }
    }
    return "unsupported"
}

// cpEnsureStr emits the clar_str_N capacity typedef into cpTypeBuf once.
func cpEnsureStr(n: int) {
    var key: string

    key = numToStr(n)
    if cpStrCapsEmitted.has(key) {
        return
    }
    cpStrCapsEmitted[key] = 1
    cpTypeBuf.add(toText("typedef struct { uint8_t len; uint8_t b[" + key + "]; } clar_str_" + key + ";"))
}

// cpEnsureType lazily emits whatever typedef(s) t depends on (types.go's
// ensureType). Rec/Enum are emitted in declaration order elsewhere (Task 4+).
func cpEnsureType(t: int) {
    var k: IRKind

    k = irtKind(t)
    if k == KStr {
        cpEnsureStr(irtN(t))
    } else if k == KList {
        cpEnsureType(irtElem(t))
    } else if k == KMap {
        cpEnsureType(irtElem(t))
    } else if k == KArr {
        cpEnsureArr(t)
    }
}

// cpEnsureArr lazily emits t's clar_arr_<elem>_<N> wrapper typedef, first
// ensuring its element type's own typedef (if any) -- types.go's ensureArr.
// Written into cpRecBuf (like Go's recBuf): an array of records (Task 6+)
// needs that record's struct already defined, which only exists in
// cpRecBuf; a scalar/Str element has no such requirement but cpRecBuf works
// fine for it too.
func cpEnsureArr(t: int): string {
    var name: string

    name = cpCTypeName(t)
    if cpArrEmitted.has(name) {
        return name
    }
    cpArrEmitted[name] = 1
    cpEnsureType(irtElem(t))
    cpRecBuf.add(toText("typedef struct { " + cpCTypeName(irtElem(t)) + " e[" + numToStr(irtN(t)) + "]; } " + name + ";"))
    return name
}

// cpCType returns t's C type name, first emitting any typedef it depends on.
func cpCType(t: int): string {
    cpEnsureType(t)
    return cpCTypeName(t)
}

// cpTypeEqual is a pure structural comparison of two IR types (kind,
// capacity/length, record/enum name, and -- recursively -- element type),
// with no side effects -- types.go's typeEqual. Needed because ir.cla's
// arena interns every IRType afresh (two structurally-identical types built
// at different call sites get different indices), unlike Go's ir.Type,
// which is a plain comparable-by-field struct.
func cpTypeEqual(a: int, b: int): bool {
    if irtKind(a) != irtKind(b) or irtN(a) != irtN(b) or irtName(a) != irtName(b) {
        return false
    }
    if (irtElem(a) == -1) != (irtElem(b) == -1) {
        return false
    }
    if irtElem(a) != -1 {
        return cpTypeEqual(irtElem(a), irtElem(b))
    }
    return true
}

// ================================================================
// Expression + statement printing (funcprint.go / intr.go subset)
// ================================================================

func fpExpr(e: int): text {
    switch irExprKind(e) {
    case EIntConst {
        return toText(numToStr(irIntConstV(e)))
    }
    case EStrConst {
        return toText("clar_lit_" + numToStr(irStrConstIdx(e)))
    }
    case EVarRef {
        return toText("cv_" + poolGet(irVarRefName(e)))
    }
    case EBin {
        return fpBin(e)
    }
    case EUn {
        return fpUn(e)
    }
    case EConv {
        return fpConv(e)
    }
    case EIntr {
        return fpIntrCall(e)
    }
    case EIndexRef {
        return fpIndexRef(e)
    }
    case EFieldRef {
        return fpFieldRef(e)
    }
    case ENewRec {
        return toText("clar_new_" + poolGet(irNewRecName(e)) + "()")
    }
    case ECallFn {
        return fpCallFn(e)
    }
    }
    return toText("")
}

// fpIsHandleType reports whether t is a reference-semantics (handle-backed)
// type -- Text, List, or Map (memory-audit Task 6).
func fpIsHandleType(t: int): bool {
    var k: IRKind

    k = irtKind(t)
    return k == KText or k == KList or k == KMap
}

// fpCallFn renders a user function call `clar_fn_NAME(args...)` (funcprint.go's
// callFn). Args were already coerced against the callee's param types at lower
// time (lowCallArgs); each is printed left-to-right so any temp an arg needs
// lands in evaluation order.
//
// An argument whose param type is a handle type (text/list/map) is handed
// off (memory-audit Task 6): the callee may retain the handle (store it in a
// global, a field, ...) past the call's return, and there is no escape
// analysis here to prove otherwise, so freeing the caller's temp afterward
// would risk a use-after-free. Conservative: a callee that does NOT retain
// it leaks that allocation instead -- the safe side of the tradeoff.
//
// The RETURN value (this function's own return text) is deliberately NEVER
// materialized into a tracked temp, even when the call sits in a
// sub-expression that would otherwise get one (e.g. `f(x) == "y"`,
// `g(a) + "z"`): a callee's returned text can just as easily be an alias of
// something still live (`func f(): text { return gKeep }`) as a fresh
// allocation, and nothing here can tell the two apart without whole-program
// interprocedural escape analysis. Same conservative call as
// IListPop/IListFirst/IMapGet above: track-then-immediately-hand-off would
// produce byte-identical leaked-forever behavior to never tracking it at
// all, just with a needless extra local in the emitted C -- so this is a
// deliberate, accepted leak (escaping-until-ARC), not an oversight;
// confirmed via review (memory-audit Task 6 fix pass).
func fpCallFn(e: int): text {
    var args: text
    var a: int
    var first: bool
    var f: int
    var p: int
    var argText: text

    args = ""
    first = true
    a = irCallFnArgsHead(e)
    f = findIRFuncIdxByName(irCallFnName(e))
    if f != -1 {
        p = irFuncParamsHead(f)
    } else {
        p = -1
    }
    while a != -1 {
        if not first {
            args = args + ", "
        }
        first = false
        argText = fpExpr(a)
        if p != -1 and fpIsHandleType(irLocalType(p)) {
            fpHandoff(argText)
        }
        args = args + argText
        a = irExprNext(a)
        if p != -1 {
            p = irLocalNext(p)
        }
    }
    return "clar_fn_" + poolGet(irCallFnName(e)) + "(" + args + ")"
}

// fpFieldRef prints an EFieldRef node (funcprint.go's expr's *ir.FieldRef
// case). An Err-typed receiver's fields are named "code"/"message" directly,
// no cv_ prefix (see emitProgram's clar_rec_Err typedef) -- unlike a user
// record's clar_rec_NAME fields, which always carry the cv_ prefix.
func fpFieldRef(e: int): text {
    if irtKind(irExprType(irFieldRefX(e))) == KErr {
        return "(" + fpExpr(irFieldRefX(e)) + ")." + poolGet(irFieldRefName(e))
    }
    return "(" + fpExpr(irFieldRefX(e)) + ").cv_" + poolGet(irFieldRefName(e))
}

// fpIndexRef implements the ir.IndexRef printer contract for Arr (a
// bounds-checked plain C array access) and List (a bounds-checked
// rt_list_at call, sharing this same node -- see ir.IndexRef's doc comment
// in ir.go) -- a port of funcprint.go's indexRef.
func fpIndexRef(e: int): text {
    var xt: int

    xt = irExprType(irIndexRefX(e))
    if irtKind(xt) == KArr {
        return "(" + fpExpr(irIndexRefX(e)) + ").e[rt_arr_check((int32_t)(" + fpExpr(irIndexRefI(e)) + "), " + numToStr(irtN(xt)) + ")]"
    } else if irtKind(xt) == KList {
        return "(*(" + cpCType(irExprType(e)) + "*)rt_list_at(" + fpExpr(irIndexRefX(e)) + ", (int32_t)(" + fpExpr(irIndexRefI(e)) + ")))"
    }
    return toText("")
}

// cOp maps a Bin/Un op string to its C spelling (funcprint.go's cOp):
// and/or short-circuit as &&/||, mod as %, everything else (+ - * / & | ^
// << >> == != < <= > >=) passes straight through.
func cOp(op: string): string {
    if op == "and" {
        return "&&"
    } else if op == "or" {
        return "||"
    } else if op == "mod" {
        return "%"
    }
    return op
}

// fpBin prints an EBin node: and/or route to fpAndOr (short-circuit); every
// other operator (arithmetic, bitwise, comparison) prints as a plain
// `(x op y)` via cOp -- funcprint.go's expr's *ir.Bin case.
func fpBin(e: int): text {
    var op: string

    op = poolGet(irBinOp(e))
    if op == "and" or op == "or" {
        return fpAndOr(e)
    }
    return "(" + fpExpr(irBinX(e)) + " " + cOp(op) + " " + fpExpr(irBinY(e)) + ")"
}

// FpCapture is fpCaptureExpr's return value: the statements it would have
// emitted (joined in order, each already indented one level deeper -- the
// level fpAndOr's guarded `if` body will land at) and e's own value
// expression -- funcprint.go's captureExpr returns (stmts, value string);
// Clarus has no tuple return, so this record serves the same purpose.
record FpCapture {
    stmts: list of text
    value: text
}

// fpCaptureExpr prints e one indent level deeper than fp's current level
// (matching where it would land if fpAndOr decides to nest it inside a new
// `if`), returning any statements it emitted separately from its value
// expression -- a port of funcprint.go's captureExpr. fpBody is swapped out
// for a fresh (empty) list for the duration of the call so e's statements
// land in the returned capture, not the caller's in-progress body; `list of
// T`'s reference semantics (Ch3: Value and Reference Semantics) make this a
// cheap pointer swap, not a copy.
func fpCaptureExpr(e: int): FpCapture {
    var saved: list of text
    var fresh: list of text
    var cap: FpCapture

    saved = fpBody
    fpBody = fresh
    fpIndent = fpIndent + 1
    cap.value = fpExpr(e)
    fpIndent = fpIndent - 1
    cap.stmts = fpBody
    fpBody = saved
    return cap
}

// fpAndOr prints `and`/`or`, preserving short-circuit evaluation even when
// the right operand needs statement-level temps of its own -- a port of
// funcprint.go's andOr. The left operand always evaluates, printed in place
// like any other operand; the right operand is speculatively captured first
// (fpCaptureExpr): if it produced no statements, the simple case (both
// sides pure) stays a plain C &&/|| -- no churn. If it did produce
// statements, they're moved inside an `if`, guarded by the already-
// evaluated left operand, so they run only when short-circuiting wouldn't
// skip them.
//
// memory-audit Task 6: a text temp the captured right operand creates is
// declared (via fpNewTmp, inside cap.stmts) INSIDE the `if` block below, so
// it must be freed there too, before the block closes -- fpStmt's generic
// end-of-statement free runs after this whole expression (and the `if`
// statement it's a condition of) is long done, which would reference an
// identifier out of scope. markCount notes fpStmtTmps' depth before the
// capture (excluding x's own temps, already at the enclosing scope and safe
// to defer); anything past that mark once the capture returns was created
// during it and is freed here, from innermost/last-created outward, so a
// nested `and`/`or` (recursing into fpAndOr again during the very same
// capture) has already flushed its own deeper temps by the time this level
// checks its own mark.
func fpAndOr(e: int): text {
    var x: text
    var op: string
    var cap: FpCapture
    var t: text
    var cond: text
    var i: int
    var markCount: int

    x = fpExpr(irBinX(e))
    op = poolGet(irBinOp(e))
    markCount = fpStmtTmps.count
    cap = fpCaptureExpr(irBinY(e))
    if cap.stmts.count == 0 {
        return "(" + x + " " + cOp(op) + " " + cap.value + ")"
    }

    t = fpNewTmp(cpCType(irExprType(e)))
    fpEmit(t + " = " + x + ";")
    cond = t
    if op == "or" {
        cond = "!" + t
    }
    fpEmit("if (" + cond + ") {")
    fpIndent = fpIndent + 1
    i = 0
    while i < cap.stmts.count {
        fpBody.add(cap.stmts[i])
        i = i + 1
    }
    fpEmit(t + " = " + cap.value + ";")
    while fpStmtTmps.count > markCount {
        fpEmit("rt_text_free(" + fpStmtTmps[fpStmtTmps.count - 1] + ");")
        fpStmtTmps.pop()
    }
    fpIndent = fpIndent - 1
    fpEmit(toText("}"))
    return t
}

// fpUn prints an EUn node (funcprint.go's un).
func fpUn(e: int): text {
    var x: text
    var op: string

    x = fpExpr(irUnX(e))
    op = poolGet(irUnOp(e))
    if op == "-" {
        return "(-(" + x + "))"
    } else if op == "not" {
        return "(!(" + x + "))"
    } else if op == "~" {
        return "(~(" + x + "))"
    }
    return toText("")
}

// fpConv prints an EConv node (funcprint.go's conv). IntToFixed/FixedToInt
// avoid a raw `<<`/plain arithmetic-shift on a possibly-negative value by
// multiplying/dividing by 65536 instead; C99 integer division truncates
// toward zero, exactly Ch3's "int(f) ... truncates toward zero".
func fpConv(e: int): text {
    var x: text
    var op: IRConvOp
    var n: int

    x = fpExpr(irConvX(e))
    op = irConvOp(e)
    if op == CvIntToFixed {
        return "((int32_t)((int64_t)(" + x + ") * 65536))"
    } else if op == CvFixedToInt {
        return "((int32_t)((" + x + ") / 65536))"
    } else if op == CvIntToChar {
        return "((uint8_t)(" + x + "))"
    } else if op == CvCharToInt or op == CvEnumToInt {
        return "((int32_t)(" + x + "))"
    } else if op == CvIntToEnum {
        n = cpEnumCount(irConvEnumName(e))
        return "rt_enum_from_int(clar_enum_" + poolGet(irConvEnumName(e)) + ", " + numToStr(n) + ", (" + x + "))"
    }
    return toText("")
}

// cpEnumCount returns the member count of the enum named nameIdx (an
// interned pool index), by walking irEnums -- funcprint.go's enumCount.
func cpEnumCount(nameIdx: int): int {
    var i: int
    var m: int
    var count: int

    i = 0
    while i < irEnums.count {
        if irEnumLayoutName(i) == nameIdx {
            count = 0
            m = irEnumLayoutMembersHead(i)
            while m != -1 {
                count = count + 1
                m = irEnumMemberNext(m)
            }
            return count
        }
        i = i + 1
    }
    log("cprint: unknown enum " + poolGet(nameIdx))
    quit 1
    return 0
}

// fpAddrable returns a C expression for e that is safe to take the address
// of (funcprint.go's addrable). VarRef/FieldRef/IndexRef print to C
// lvalues, StrConst to a named static, Intr's value-producing cases already
// materialize into a named temp -- none of these need a further copy;
// anything else (a Bin/Un/Conv/CallFn/NewRec result) is first copied into a
// fresh temp of its own type via fpCopyToTemp.
func fpAddrable(e: int): text {
    var k: IRExprKind

    k = irExprKind(e)
    if k == EVarRef or k == EFieldRef or k == EIndexRef or k == EStrConst or k == EIntr {
        return fpExpr(e)
    }
    return fpCopyToTemp(e)
}

// fpCopyToTemp unconditionally materializes e's value into a fresh
// statement-level temp and returns the temp's name -- never the "already an
// lvalue, print as-is" shortcut fpAddrable takes for a VarRef/FieldRef/
// IndexRef/StrConst/Intr. Used for the *value* argument of every
// list/map-growing intrinsic (Task 6+'s list_push, list_unshift, map_set):
// those can realloc their target's backing store mid-call, so if the value
// argument were instead a raw rt_list_at/rt_map-derived pointer, the
// realloc could free that pointer's block before the call's own memmove
// reads it -- an ASan-confirmed use-after-free (funcprint.go's copyToTemp).
func fpCopyToTemp(e: int): text {
    var v: text
    var t: text

    v = fpExpr(e)
    // If evaluating e itself produced a tracked text temp (e.g. e is a
    // concat), `t = v;` below is a pointer copy, not a fresh allocation
    // (Ch3: text has reference semantics) -- v and t now alias the SAME
    // object. Untrack v here so only t (below) represents that object going
    // forward; the caller decides t's fate (memory-audit Task 6).
    fpHandoff(v)
    t = fpNewTmp(cpCType(irExprType(e)))
    fpEmit(t + " = " + v + ";")
    return t
}

// fpStrAddr renders `(const uint8_t*)&(<addrable e>)` (funcprint.go's strAddr).
func fpStrAddr(e: int): text {
    return "(const uint8_t*)&(" + fpAddrable(e) + ")"
}

// fpTextCmp handles text/text, text/string, and string/text comparisons
// (intr.go's textCmp). rt_text_cmp_str only knows (text, string); a string
// on the left needs the call flipped and its sign negated to preserve
// `a < b` orientation.
func fpTextCmp(a: int, b: int): text {
    var atk: IRKind
    var btk: IRKind

    atk = irtKind(irExprType(a))
    btk = irtKind(irExprType(b))
    if atk == KText and btk == KText {
        return "rt_text_cmp(" + fpExpr(a) + ", " + fpExpr(b) + ")"
    } else if atk == KText and btk == KStr {
        return "rt_text_cmp_str(" + fpExpr(a) + ", " + fpStrAddr(b) + ")"
    }
    // atk == KStr and btk == KText: lowComparison only ever calls ITextCmp
    // when at least one side is Text, so this is the only remaining combo.
    return "(-rt_text_cmp_str(" + fpExpr(b) + ", " + fpStrAddr(a) + "))"
}

// fpTextConcat allocates a fresh rt_text handle for the `text + (text|
// string)` result (text has reference semantics, but `+` always produces a
// new value), then concatenates a and b into it (intr.go's textConcat).
func fpTextConcat(a: int, b: int): text {
    var ae: text
    var t: text

    ae = fpExpr(a)
    t = fpNewTmp("rt_text *")
    fpEmit(t + " = rt_text_new();")
    if irtKind(irExprType(b)) == KStr {
        fpEmit("rt_text_concat(" + t + ", " + ae + ", " + fpStrAddr(b) + ", NULL);")
    } else {
        fpEmit("rt_text_concat(" + t + ", " + ae + ", NULL, " + fpExpr(b) + ");")
    }
    return t
}

// fpArgAt walks n steps down an Intr's argument chain from head (via
// irExprNext) and returns the expr index found there -- for the UI canvas
// intrinsics below, whose fixed positional argument count (inst, widget
// index, then each Ch11 method's own 2-4 geometry args, an optional trailing
// fill flag) runs past the a0/a1/a2 prelude every other fpIntrCall case gets
// by default.
func fpArgAt(head: int, n: int): int {
    var cur: int
    var i: int

    cur = head
    i = 0
    while i < n {
        cur = irExprNext(cur)
        i = i + 1
    }
    return cur
}

// fpIntrCall prints one Intr call (intr.go). Every rt_* function whose
// result comes back through an out-parameter (concat, text concat, ...) is
// materialized into a fresh statement-level temp here and its name
// returned; pure value-returning rt_* calls (len, cmp, index_of, ...) are
// embedded directly with no temp, since C already lets them nest safely.
// Void operations (alert, quit, set_index, append, ...) emit their call as
// a statement and return "" -- see fpStmt's SExprStmt case, the only
// context they appear in.
func fpIntrCall(x: int): text {
    var nm: int
    var a0: int
    var a1: int
    var a2: int
    var t: text
    var s0: text
    var s1: text
    var cap0: int
    var cap1: int
    var l: text
    var v: text
    var fn: string
    var m: text
    var k: text
    var dv: text
    var winName: string
    var inst: text
    var fld: int
    var dataT: int
    var dataKind: IRKind
    var recName: string
    var container: string
    var dataExpr: text
    var freeVarBuf: text

    nm = irIntrName(x)
    a0 = irIntrArgsHead(x)
    if a0 != -1 {
        a1 = irExprNext(a0)
    }
    if a1 != -1 {
        a2 = irExprNext(a1)
    }

    if nm == IAlert() {
        fpEmit("rt_alert(" + fpStrAddr(a0) + ");")
        return toText("")
    } else if nm == ILog() {
        fpEmit("rt_log(" + fpStrAddr(a0) + ");")
        return toText("")
    } else if nm == IQuit() {
        fpEmit("rt_quit((int32_t)(" + fpExpr(a0) + "));")
        return toText("")
    } else if nm == IFixMul() {
        return "rt_fix_mul((int32_t)(" + fpExpr(a0) + "), (int32_t)(" + fpExpr(a1) + "))"
    } else if nm == IFixDiv() {
        return "rt_fix_div((int32_t)(" + fpExpr(a0) + "), (int32_t)(" + fpExpr(a1) + "))"

    // ---- strings ----
    } else if nm == IStrConcat() {
        s0 = fpStrAddr(a0)
        s1 = fpStrAddr(a1)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_str_concat((uint8_t*)&" + t + ", " + s0 + ", " + s1 + ");")
        return t
    } else if nm == IStrConcatChar() {
        s0 = fpStrAddr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_str_concat_char((uint8_t*)&" + t + ", " + s0 + ", (uint8_t)(" + s1 + "));")
        return t
    } else if nm == IStrPrependChar() {
        s0 = fpExpr(a0)
        s1 = fpStrAddr(a1)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_str_prepend_char((uint8_t*)&" + t + ", (uint8_t)(" + s0 + "), " + s1 + ");")
        return t
    } else if nm == IStrCmp() {
        return "rt_str_cmp(" + fpStrAddr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == IStrLen() {
        return "rt_str_len(" + fpStrAddr(a0) + ")"
    } else if nm == IStrIndex() {
        return "rt_str_index(" + fpStrAddr(a0) + ", (int32_t)(" + fpExpr(a1) + "))"
    } else if nm == IStrSetIndex() {
        s0 = fpAddrable(a0)
        s1 = fpExpr(a1)
        fpEmit("rt_str_set_index((uint8_t*)&(" + s0 + "), (int32_t)(" + s1 + "), (uint8_t)(" + fpExpr(a2) + "));")
        return toText("")
    } else if nm == IStrFromBytes() {
        s0 = fpAddrable(a0)
        cap0 = irtN(irExprType(a0))
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        fpEmit("rt_str_from_bytes((uint8_t*)&(" + s0 + "), " + numToStr(cap0) + ", (const uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ", (int32_t)(" + fpExpr(a2) + "));")
        return toText("")
    } else if nm == IStrToBytes() {
        s0 = fpStrAddr(a0)
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        return "rt_str_to_bytes(" + s0 + ", (uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ")"
    } else if nm == IStrCoerce() {
        // Materializes a0 (any Str capacity) into a fresh temp at x.Ty's
        // (different) capacity via the same clamped rt_str_store fpStoreStr
        // uses for a plain lvalue -- see lowCoerceStr's doc comment
        // (lower.cla) for why this can't just be a plain `=`.
        s0 = fpStrAddr(a0)
        t = fpNewTmp(cpCType(irExprType(x)))
        fpEmit("rt_str_store((uint8_t*)&" + t + ", " + numToStr(irtN(irExprType(x))) + ", " + s0 + ");")
        return t
    } else if nm == IStrSlice() {
        s0 = fpStrAddr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_str_slice((uint8_t*)&" + t + ", " + s0 + ", (int32_t)(" + s1 + "), (int32_t)(" + fpExpr(a2) + "));")
        return t
    } else if nm == IStrIndexOfStr() {
        return "rt_str_index_of_str(" + fpStrAddr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == IStrIndexOfChar() {
        return "rt_str_index_of_char(" + fpStrAddr(a0) + ", (uint8_t)(" + fpExpr(a1) + "))"

    // ---- text ----
    } else if nm == ITextCmp() {
        return fpTextCmp(a0, a1)
    } else if nm == ITextConcat() {
        return fpTextConcat(a0, a1)
    } else if nm == ITextConcatSL() {
        s0 = fpStrAddr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("rt_text *")
        fpEmit(t + " = rt_text_new();")
        fpEmit("rt_text_concat_sl(" + t + ", " + s0 + ", " + s1 + ");")
        return t
    } else if nm == ITextStore() {
        fpEmit("rt_text_store(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ");")
        return toText("")
    } else if nm == ITextLen() {
        return "rt_text_len(" + fpExpr(a0) + ")"
    } else if nm == ITextIndex() {
        return "rt_text_index(" + fpExpr(a0) + ", (int32_t)(" + fpExpr(a1) + "))"
    } else if nm == ITextSetIndex() {
        s0 = fpExpr(a0)
        s1 = fpExpr(a1)
        fpEmit("rt_text_set_index(" + s0 + ", (int32_t)(" + s1 + "), (uint8_t)(" + fpExpr(a2) + "));")
        return toText("")
    } else if nm == ITextFromBytes() {
        s0 = fpExpr(a0)
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        fpEmit("rt_text_from_bytes(" + s0 + ", (const uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ", (int32_t)(" + fpExpr(a2) + "));")
        return toText("")
    } else if nm == ITextToBytes() {
        s0 = fpExpr(a0)
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        return "rt_text_to_bytes(" + s0 + ", (uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ")"
    } else if nm == ITextSlice() {
        s0 = fpExpr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_text_slice((uint8_t*)&" + t + ", " + s0 + ", (int32_t)(" + s1 + "), (int32_t)(" + fpExpr(a2) + "));")
        return t
    } else if nm == ITextIndexOfStr() {
        return "rt_text_index_of_str(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == ITextIndexOfChar() {
        return "rt_text_index_of_char(" + fpExpr(a0) + ", (uint8_t)(" + fpExpr(a1) + "))"
    } else if nm == ITextAppendStr() {
        fpEmit("rt_text_append_str(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ");")
        return toText("")
    } else if nm == ITextAppendChar() {
        fpEmit("rt_text_append_char(" + fpExpr(a0) + ", (uint8_t)(" + fpExpr(a1) + "));")
        return toText("")
    } else if nm == ITextAppendText() {
        fpEmit("rt_text_append_text(" + fpExpr(a0) + ", " + fpExpr(a1) + ");")
        return toText("")
    } else if nm == ITextOfStr() {
        // Materializes a0 (a Str value) into a fresh rt_text handle --
        // lowCoerceStr's Text-target/Str-source case (lower.cla). The fresh
        // handle satisfies the language reference's "always a fresh copy"
        // contract: mutating the received text (e.g. .append) never affects
        // the original string, since rt_text_store copies the string's
        // bytes into the new handle's own buffer.
        t = fpNewTmp("rt_text *")
        fpEmit(t + " = rt_text_new();")
        s0 = fpStrAddr(a0)
        fpEmit("rt_text_store(" + t + ", " + s0 + ");")
        return t
    } else if nm == ITextFreeVar() {
        // memory-audit Task 7: a0 is always a bare EVarRef (the escape
        // pre-pass's own qualifying-local set, lower.cla) -- a plain,
        // single-line free, unlike the list/map cases below which may need
        // an element-free loop first.
        fpEmit("rt_text_free(" + fpExpr(a0) + ");")
        return toText("")

    // ---- list ----
    } else if nm == IListPush() or nm == IListUnshift() {
        // v goes through fpCopyToTemp, not fpAddrable: push/unshift can
        // realloc a0's backing store, and if v were instead a raw
        // rt_list_at pointer (fpAddrable's IndexRef shortcut, e.g.
        // `l.push(l[0])`), that realloc could free it before this call's
        // own memmove reads it.
        l = fpExpr(a0)
        v = fpCopyToTemp(a1)
        // v is stored into the list (a text v's handle now lives on, owned
        // by the list) -- untrack it so it isn't freed at end of statement
        // (memory-audit Task 6; a no-op if v isn't text).
        fpHandoff(v)
        fn = "rt_list_push"
        if nm == IListUnshift() {
            fn = "rt_list_unshift"
        }
        fpEmit(fn + "(" + l + ", &(" + v + "));")
        return toText("")
    } else if nm == IListPop() or nm == IListShift() or nm == IListFirst() or nm == IListLast() {
        l = fpExpr(a0)
        t = fpNewTmp(cpCType(irExprType(x)))
        fn = "rt_list_pop"
        if nm == IListShift() {
            fn = "rt_list_shift"
        } else if nm == IListFirst() {
            fn = "rt_list_first"
        } else if nm == IListLast() {
            fn = "rt_list_last"
        }
        fpEmit(fn + "(" + l + ", &" + t + ");")
        // memory-audit Task 6: this copies the ELEMENT'S bytes (a text
        // element's bytes ARE its handle -- Ch3 reference semantics) out of
        // l's backing store into t. first/last don't even remove it from l
        // -- t and l's own slot alias the SAME object. pop/shift do remove
        // l's slot, but l is never the only other reference: the element
        // could have been pushed into ANOTHER container earlier (aliased
        // there too), which this purely statement-local tracking has no way
        // to see. Never auto-free t -- untrack it unconditionally, same as
        // any other "the caller must reason about this" handle.
        fpHandoff(t)
        return t
    } else if nm == IListRemove() {
        fpEmit("rt_list_remove(" + fpExpr(a0) + ", (int32_t)(" + fpExpr(a1) + "));")
        return toText("")
    } else if nm == IListCount() {
        return "rt_list_count(" + fpExpr(a0) + ")"
    } else if nm == IListFreeVar() {
        // memory-audit Task 7: reuse Task 5's cpEmitFree (element-free loop
        // for a KText element type, then rt_list_free) rather than
        // reimplementing it -- cpEmitFree appends into a caller-owned `text`
        // buffer via cpAppendLine (its own fixed one-level indent), so the
        // whole (possibly multi-line) result is emitted as ONE fpBody entry
        // here, the same trick cpEmitGlobalsInit uses for cl_free_globals's
        // body. Indentation is the only thing that can differ from a
        // hand-rolled fpEmit-per-line version (purely cosmetic -- C doesn't
        // care), and correctness (double-free, element ordering) is
        // entirely cpEmitFree's own, already-reviewed logic.
        freeVarBuf = ""
        cpEmitFree(freeVarBuf, "cv_" + poolGet(irVarRefName(a0)), irExprType(a0))
        fpEmit(freeVarBuf)
        return toText("")

    // ---- map ----
    } else if nm == IMapSet() {
        // v goes through fpCopyToTemp, not fpAddrable, for the same reason
        // as list_push/unshift above: map_set grows m's key/value arrays on
        // a new key, so a raw rt_list_at-derived pointer passed as v (e.g.
        // `m.set(k, l[0])`) must be copied out before the call, not handed
        // in live. (m's own values never alias this way: map subscript
        // lowers to the map_get intrinsic, which always materializes into
        // its own temp before it can be used as another call's argument --
        // see IMapGet below.)
        m = fpExpr(a0)
        k = fpStrAddr(a1)
        v = fpCopyToTemp(a2)
        // v is stored into the map -- same handoff reasoning as
        // IListPush/IListUnshift above (memory-audit Task 6).
        fpHandoff(v)
        fpEmit("rt_map_set(" + m + ", " + k + ", &(" + v + "));")
        return toText("")
    } else if nm == IMapGet() {
        m = fpExpr(a0)
        k = fpStrAddr(a1)
        t = fpNewTmp(cpCType(irExprType(x)))
        fpEmit("rt_map_get(" + m + ", " + k + ", &" + t + ");")
        // memory-audit Task 6: aliases m's own stored value (same reasoning
        // as IListFirst/IListLast above) -- never auto-free.
        fpHandoff(t)
        return t
    } else if nm == IMapGetDv() {
        m = fpExpr(a0)
        k = fpStrAddr(a1)
        dv = fpExpr(a2)
        fpHandoff(dv) // dv's own temp (if any) is about to alias into t
        t = fpNewTmp(cpCType(irExprType(x)))
        fpEmit(t + " = " + dv + ";") // pre-fill with the default; get_dv leaves it untouched if absent
        fpEmit("rt_map_get_dv(" + m + ", " + k + ", &" + t + ");")
        // Whether t ends up holding dv (key absent) or m's own stored value
        // (key present), both are aliases outside this statement's
        // ownership -- never auto-free (same as IMapGet above).
        fpHandoff(t)
        return t
    } else if nm == IMapHas() {
        return "rt_map_has(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == IMapRemove() {
        fpEmit("rt_map_remove(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ");")
        return toText("")
    } else if nm == IMapCount() {
        return "rt_map_count(" + fpExpr(a0) + ")"
    } else if nm == IMapFreeVar() {
        // memory-audit Task 7 -- see IListFreeVar's doc comment.
        freeVarBuf = ""
        cpEmitFree(freeVarBuf, "cv_" + poolGet(irVarRefName(a0)), irExprType(a0))
        fpEmit(freeVarBuf)
        return toText("")

    // ---- lastError ----
    } else if nm == ILastErrCode() {
        return toText("rt_lasterr_code")
    } else if nm == ILastErrMsg() {
        // rt_lasterr_msg is a raw uint8_t[256] (rt.h), not a clar_str_255
        // struct -- copy it into a proper temp via rt_str_store rather than
        // exposing the type mismatch to callers.
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_str_store((uint8_t*)&" + t + ", 255, rt_lasterr_msg);")
        return t
    } else if nm == ILastErr() {
        // Materializes a whole Err-record value {code, message} from the
        // runtime's rt_lasterr_* globals -- the printer contract lowIdent
        // relies on for a bare `lastError` rvalue, since there is no
        // cv_lastError global to reference directly.
        t = fpNewTmp("clar_rec_Err")
        fpEmit(t + ".code = rt_lasterr_code;")
        fpEmit("rt_str_store((uint8_t*)&" + t + ".message, 255, rt_lasterr_msg);")
        return t

    // ---- files ----
    } else if nm == IFileReadText() {
        return "rt_file_read_text(" + fpStrAddr(a0) + ", " + fpExpr(a1) + ")"
    } else if nm == IFileWriteText() {
        return "rt_file_write_text(" + fpStrAddr(a0) + ", " + fpExpr(a1) + ")"
    } else if nm == IFileName() {
        s0 = fpStrAddr(a0)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_file_name((uint8_t*)&" + t + ", " + s0 + ");")
        return t
    } else if nm == IFileSave() or nm == IFileLoad() {
        // file.save/file.load (Ch12, Task 2 mac-target-4d). a1 is the
        // lowered data arg -- its OWN IR type carries everything else this
        // call needs: KRec directly names the record (REC container,
        // address passed via fpAddrable); KList/KMap's elem names the
        // record (LIST/MAP container, the list/map HANDLE passed via
        // fpExpr, not its address -- rt_list*/rt_map* is already a
        // pointer). checker's AnyRecordish (builtins.go/check.cla) already
        // guarantees a1 is one of these three shapes.
        dataT = irExprType(a1)
        dataKind = irtKind(dataT)
        if dataKind == KRec {
            recName = poolGet(irtName(dataT))
            container = "RT_SER_REC"
            dataExpr = "(void*)&(" + fpAddrable(a1) + ")"
        } else if dataKind == KList {
            recName = poolGet(irtName(irtElem(dataT)))
            container = "RT_SER_LIST"
            dataExpr = "(void*)(" + fpExpr(a1) + ")"
        } else {
            recName = poolGet(irtName(irtElem(dataT)))
            container = "RT_SER_MAP"
            dataExpr = "(void*)(" + fpExpr(a1) + ")"
        }
        fn = "rt_file_save"
        if nm == IFileLoad() {
            fn = "rt_file_load"
        }
        return fn + "(" + fpStrAddr(a0) + ", " + container + ", " + dataExpr + ", &clar_layout_" + recName + ")"

    // ---- UI (Task 4: Ch7-11 -> runtime/mac/rt_ui.h) ----
    } else if nm == IUiOpen() {
        // `open W` -- x's own ty (set at lowering time) is the KWinRef type
        // carrying W's name; see ir.cla's KWinRef doc comment.
        return "rt_ui_open(&clar_ui_window_" + poolGet(irtName(irExprType(x))) + ")"
    } else if nm == IUiFront() {
        return "rt_ui_front(&clar_ui_window_" + poolGet(irtName(irExprType(x))) + ")"
    } else if nm == IUiClose() {
        fpEmit("rt_ui_close(" + fpExpr(a0) + ");")
        return toText("")
    } else if nm == IUiQuit() {
        // `quit` in a UI program (Ch7 Quit Semantics) -- the closeRequest
        // cascade, runtime/mac/rt_ui.c's rt_ui_quit. No args: see ir.cla's
        // IUiQuit doc comment for why an exit-code expression, if any, is
        // evaluated by a separate statement lowQuit emits before this one,
        // not passed in here.
        fpEmit("rt_ui_quit();")
        return toText("")
    } else if nm == IUiState() {
        // Casts rt_ui_state's void* to the firing window's state struct and
        // dereferences it inline, so the ENCLOSING FieldRef's ordinary
        // "(X).cv_name" printer (fpFieldRef) needs no special case at all --
        // see ir.cla's KUiState doc comment.
        return "(*(clar_uistate_" + poolGet(irtName(irExprType(x))) + " *)rt_ui_state(" + fpExpr(a0) + "))"
    } else if nm == IUiStateDefaults() {
        // Constructs every handle-backed (Text/List/Map/Rec) per-instance
        // var in the firing window's state block -- the FIRST statement of
        // `opened` glue (lower.cla's lowPrependWinVarDefaults/
        // lowSynthesizeMissingOpenedHandlers), before any declared default,
        // since rt_ui_open only zeroes the block (NewHandleClear) and never
        // constructs anything in it (cpEmitUiStateStruct's own header
        // comment). Reuses cpDefaultInit for the actual construction -- no
        // duplicated type switch here, just the irtNeedsCtor (ir.cla) filter
        // so an inline-typed field (already correctly zero) emits nothing.
        winName = poolGet(irtName(irExprType(x)))
        inst = fpExpr(a0)
        fld = cpFindWindowStateFields(winName)
        while fld != -1 {
            if irtNeedsCtor(irFieldSlotType(fld)) {
                cpDefaultInit("((*(clar_uistate_" + winName + " *)rt_ui_state(" + inst + "))).cv_" + poolGet(irFieldSlotName(fld)), irFieldSlotType(fld), 0, -1)
            }
            fld = irFieldSlotNext(fld)
        }
        return toText("")
    } else if nm == IUiSetTitle() {
        fpEmit("rt_ui_set_title(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ");")
        return toText("")
    } else if nm == IUiGetTitle() {
        // `title` read (mac-target-4c Task 4b) -- same fpNewTmp("clar_str_255")
        // + fill-in-place-call pattern as IFileName/IUiGetFieldText above.
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_ui_get_title(" + fpExpr(a0) + ", (uint8_t*)&" + t + ");")
        return t
    } else if nm == IUiSetCaption() {
        fpEmit("rt_ui_widget_set_str(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_CAPTION, " + fpStrAddr(a2) + ");")
        return toText("")
    } else if nm == IUiSetText() {
        fpEmit("rt_ui_widget_set_str(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_TEXT, " + fpStrAddr(a2) + ");")
        return toText("")
    } else if nm == IUiGetFieldText() {
        // field.text read (mac-target-4c Task 2) -- same fpNewTmp("clar_str_255")
        // + fill-in-place-call pattern as IFileName above.
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_ui_widget_get_str(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_TEXT, (uint8_t*)&" + t + ");")
        return t
    } else if nm == IUiGetTextviewText() {
        // textview.text read (mac-target-4c Task 2) -- a fresh rt_text
        // handle (rt_text_new(), same as fpTextConcat/ITextOfStr above),
        // filled in place by rt_ui_widget_get_text.
        t = fpNewTmp("rt_text *")
        fpEmit(t + " = rt_text_new();")
        fpEmit("rt_ui_widget_get_text(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + t + ");")
        return t
    } else if nm == IUiSetTextviewText() {
        // textview.text write (mac-target-4c Task 2) -- lowWidgetSetAssign
        // (lower.cla) coerces the RHS through lowCoerceStr against the
        // property's IR type (TextT for textview.text, widgetRuntimeProps'
        // table via lowMustType(lhs)) before it ever reaches this printer,
        // so a2 is always an rt_text* here BY CONSTRUCTION: a Str-typed
        // literal/expr RHS was already wrapped in ITextOfStr (materializing
        // a fresh rt_text handle) at the funnel, and a Text-typed RHS
        // passes through lowCoerceStr unchanged. No fpStrAddr/temp is
        // needed here, unlike IUiSetText's Str-shaped a2.
        fpEmit("rt_ui_widget_set_text(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(a2) + ");")
        return toText("")
    } else if nm == IUiGetChecked() {
        return "rt_ui_widget_get_bool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_CHECKED)"
    } else if nm == IUiSetChecked() {
        fpEmit("rt_ui_widget_set_bool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_CHECKED, (int32_t)(" + fpExpr(a2) + "));")
        return toText("")
    } else if nm == IUiGetEnabled() {
        return "rt_ui_widget_get_bool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_ENABLED)"
    } else if nm == IUiSetEnabled() {
        fpEmit("rt_ui_widget_set_bool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_ENABLED, (int32_t)(" + fpExpr(a2) + "));")
        return toText("")
    } else if nm == IUiGetWidth() {
        return "rt_ui_widget_get_int(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_WIDTH)"
    } else if nm == IUiGetHeight() {
        return "rt_ui_widget_get_int(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_HEIGHT)"
    } else if nm == IUiGetSelected() {
        // popup/table `selected` read (mac-target-4d Task 5) -- rt_ui.h's
        // rt_ui_widget_get_int returns `short`; the implicit short->int32_t
        // widening on return needs no explicit cast, same as
        // IUiGetWidth/IUiGetHeight just above.
        return "rt_ui_widget_get_int(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_SELECTED)"
    } else if nm == IUiSetSelected() {
        fpEmit("rt_ui_widget_set_int(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_SELECTED, (int32_t)(" + fpExpr(a2) + "));")
        return toText("")
    } else if nm == IUiMenuEnable() {
        fpEmit("rt_ui_menu_enable(" + fpExpr(a0) + ", " + fpExpr(a1) + ", (int32_t)(" + fpExpr(a2) + "));")
        return toText("")
    } else if nm == IUiCancel() {
        // `cancel` (Ch5/Ch8) -- writes through the dispatcher-owned scratch
        // pointer (see ir.cla's IUiCancel doc comment and
        // cpEmitOneWinEventDispatcher's RTUI_EV_CLOSEREQUEST case).
        fpEmit("*clar_ui_cur_cancel = 1;")
        return toText("")
    } else if nm == IUiAskOpen() {
        // `askOpen(p)` -- p is filled IN PLACE by the runtime, so its
        // address is passed non-const (unlike fpStrAddr's const cast, used
        // for every read-only Str255 argument elsewhere in this function),
        // the same "(uint8_t*)&(<addrable lvalue>)" shape IStrSetIndex uses
        // above for its own out-parameter. Embedded directly (no temp): the
        // call's own int (0/1) result IS the Bool value, same as every
        // other int-returning rt_* call in this function (e.g. IStrCmp).
        return "rt_ui_ask_open((uint8_t*)&(" + fpAddrable(a0) + "))"
    } else if nm == IUiAskSave() {
        // `askSave(p, suggested)` -- p filled in place (see IUiAskOpen
        // above); suggested is read-only, so it takes the ordinary
        // fpStrAddr const-cast path.
        return "rt_ui_ask_save((uint8_t*)&(" + fpAddrable(a0) + "), " + fpStrAddr(a1) + ")"
    } else if nm == IUiAskSaveChanges() {
        // `askSaveChanges(name)` -- name is read-only; the result is the
        // raw saveChoice enum word (0/1/2), embedded directly like
        // IUiGetWidth/IUiGetHeight's `short` results just below.
        return "rt_ui_ask_save_changes(" + fpStrAddr(a0) + ")"
    } else if nm == IUiCanvasClear() {
        fpEmit("rt_ui_canvas_clear(" + fpExpr(a0) + ", " + fpExpr(a1) + ");")
        return toText("")
    } else if nm == IUiCanvasLine() {
        fpEmit("rt_ui_canvas_line(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ", " + fpExpr(fpArgAt(a0, 5)) + ");")
        return toText("")
    } else if nm == IUiCanvasRect() {
        fpEmit("rt_ui_canvas_rect(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ", " + fpExpr(fpArgAt(a0, 5)) + ", " + fpExpr(fpArgAt(a0, 6)) + ");")
        return toText("")
    } else if nm == IUiCanvasCircle() {
        fpEmit("rt_ui_canvas_circle(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ");")
        return toText("")
    } else if nm == IUiCanvasFillCircle() {
        fpEmit("rt_ui_canvas_fill_circle(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ");")
        return toText("")
    } else if nm == IUiCanvasPattern() {
        fpEmit("rt_ui_canvas_pattern(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ");")
        return toText("")
    } else if nm == IUiCanvasDrawText() {
        fpEmit("rt_ui_canvas_draw_text(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpStrAddr(fpArgAt(a0, 4)) + ");")
        return toText("")
    } else if nm == IUiEdit() {
        fpUiEditStmt(x, a0, a1, a2)
        return toText("")
    } else if nm == IUiFormIsNew() {
        return "(rt_ui_form_is_new())"
    }
    return toText("")
}

// fpUiEditStmt prints one `edit F, target` / `edit F, new T` call (Ch10;
// ir.cla's IUiEdit doc comment pins the arg shape this decodes: kindArg is
// an IntConst tag, 0=`new T`/RT_UI_WB_NONE, 1=RT_UI_WB_ADDR, 2=RT_UI_WB_LIST,
// 3=RT_UI_WB_MAP). winName comes off the Intr node's OWN hijacked `ty`
// (irWinRefType), same trick IUiOpen/IUiFront use for their own window name.
//
// LIST's index and MAP's key are each evaluated into a fresh temp EXACTLY
// ONCE (fpExpr(opB)/fpStrAddr(opB) called a single time each) even though
// the emitted call site's own src-pointer expression and its own idx/key
// parameter both need that same value -- an index/key expr with a side
// effect (a function call, say) must not run twice for one `edit`
// statement. The list/map CONTAINER itself (opA) is always a plain
// variable/per-instance-field reference (never an arbitrary expression --
// same "always a bare global" shape lowTableRowsGlobalName already pins for
// a table's `rows:`), so referencing its printed text twice is safe with no
// temp needed.
func fpUiEditStmt(x: int, kindArg: int, opA: int, opB: int) {
    var winName: string
    var kind: int
    var recName: string
    var t: text
    var lstText: text
    var mapText: text
    var idxT: text
    var keyT: text
    var addrText: text

    winName = poolGet(irtName(irExprType(x)))
    kind = irIntConstV(kindArg)

    if kind == 0 {
        // `edit F, new T` -- T is F's own form record type.
        recName = poolGet(cpFindWindowFormRecName(winName))
        t = fpNewTmp("clar_rec_" + recName)
        fpEmit(t + " = clar_new_" + recName + "();")
        fpEmit("rt_ui_edit(&clar_ui_window_" + winName + ", (const void *)&" + t + ", 1, RT_UI_WB_NONE, 0, 0, 0, 0, 0);")
    } else if kind == 1 {
        // Global or window-scoped per-instance record variable.
        addrText = fpAddrable(opA)
        fpEmit("rt_ui_edit(&clar_ui_window_" + winName + ", (const void *)&(" + addrText + "), 0, RT_UI_WB_ADDR, (void *)&(" + addrText + "), 0, 0, 0, 0);")
    } else if kind == 2 {
        // List element -- src is rt_list_at, RE-DERIVED right here (rt_ui_edit
        // copies immediately, so the transient pointer is safe).
        lstText = fpExpr(opA)
        idxT = fpNewTmp("int32_t")
        fpEmit(idxT + " = (int32_t)(" + fpExpr(opB) + ");")
        fpEmit("rt_ui_edit(&clar_ui_window_" + winName + ", (const void *)rt_list_at(" + lstText + ", " + idxT + "), 0, RT_UI_WB_LIST, 0, " + lstText + ", (long)(" + idxT + "), 0, 0);")
    } else if kind == 3 {
        // Map element -- rt_map has no pointer-returning lookup (only a
        // copy-out get), so the initial value is fetched into a fresh
        // record temp (defaulted via clar_new_T, then overwritten if the
        // key is already present) before the call; the key itself is
        // copied into its own Str255 temp once, reused for both the lookup
        // and the RT_UI_WB_MAP key255 argument.
        mapText = fpExpr(opA)
        keyT = fpNewTmp("clar_str_255")
        fpEmit("rt_str_store((uint8_t*)&" + keyT + ", 255, " + fpStrAddr(opB) + ");")
        recName = poolGet(cpFindWindowFormRecName(winName))
        t = fpNewTmp("clar_rec_" + recName)
        fpEmit(t + " = clar_new_" + recName + "();")
        fpEmit("rt_map_get_dv(" + mapText + ", (const uint8_t*)&" + keyT + ", &" + t + ");")
        fpEmit("rt_ui_edit(&clar_ui_window_" + winName + ", (const void *)&" + t + ", 0, RT_UI_WB_MAP, 0, 0, 0, " + mapText + ", (const unsigned char*)&" + keyT + ");")
    }
}

// fpStoreStr prints a clamped string store: `rt_str_store(&dst, CAP, &src);`
// -- funcprint.go's storeStr.
func fpStoreStr(dst: int, src: int) {
    fpEmit("rt_str_store((uint8_t*)&(" + fpAddrable(dst) + "), " + numToStr(irtN(irExprType(dst))) + ", " + fpStrAddr(src) + ");")
}

// fpStmt is the per-statement printing funnel (funcprint.go's stmt) --
// re-entrant: SIf/SWhile/SForRange/SForList/SForMap recurse into fpStmts for
// their bodies, which calls back into fpStmt per inner statement.
//
// memory-audit Task 6: fpStmtTmps is save/swapped around the whole call,
// mirroring fpCaptureExpr's fpBody swap (:404) -- a fresh (empty) list
// tracks only the text temps THIS statement's own printing creates, so a
// nested statement's own fpStmt frame tracks and frees its own temps
// independently. Any name still tracked when this statement is done
// (nothing handed it off to a variable/return/container/callee) is freed at
// the tail, after the statement's own C code -- see fpFreeStmtTmps.
func fpStmt(s: int) {
    var e: text
    var d: text
    var v: text
    var saved: list of text
    var fresh: list of text
    var terminal: bool

    saved = fpStmtTmps
    fpStmtTmps = fresh
    terminal = false

    if irStmtKind(s) == SExprStmt {
        e = fpExpr(irExprStmtX(s))
        if e != "" {
            fpEmit(e + ";")
        }
    } else if irStmtKind(s) == SIf {
        fpIfStmt(s)
    } else if irStmtKind(s) == SAssign {
        d = fpExpr(irAssignDst(s))
        v = fpExpr(irAssignSrc(s))
        if irtKind(irExprType(irAssignDst(s))) == KText {
            // A text temp assigned into a variable IS that variable's new
            // value now -- handed off, not freed here.
            fpHandoff(v)
        }
        fpEmit(d + " = " + v + ";")
    } else if irStmtKind(s) == SStoreStr {
        fpStoreStr(irStoreStrDst(s), irStoreStrSrc(s))
    } else if irStmtKind(s) == SWhile {
        fpWhileStmt(s)
    } else if irStmtKind(s) == SForRange {
        fpForRangeStmt(s)
    } else if irStmtKind(s) == SReturn {
        terminal = true
        if irReturnX(s) == -1 {
            fpFreeStmtTmps()
            fpEmit(toText("return;"))
        } else {
            e = fpExpr(irReturnX(s))
            fpHandoff(e) // the returned value escapes to the caller
            // A sub-expression that FED the returned value (e.g. a concat
            // consumed by an outer concat) can still be tracked here and
            // must be freed BEFORE the `return` -- anything emitted after
            // an unconditional jump is unreachable C, never runs.
            fpFreeStmtTmps()
            fpEmit("return " + e + ";")
        }
    } else if irStmtKind(s) == SForList {
        fpForListStmt(s)
    } else if irStmtKind(s) == SForMap {
        fpForMapStmt(s)
    } else if irStmtKind(s) == SBreak {
        terminal = true
        fpFreeStmtTmps()
        fpEmit(toText("break;"))
    } else if irStmtKind(s) == SContinue {
        terminal = true
        fpFreeStmtTmps()
        fpEmit(toText("continue;"))
    }

    if not terminal {
        fpFreeStmtTmps()
    }
    fpStmtTmps = saved
}

// fpForListStmt lowers `for x in l { ... }` to an index loop over a count
// snapshotted once at loop entry (Ch5 doesn't promise behavior for a list
// mutated mid-iteration; a fixed count is the simplest defensible choice)
// -- a port of funcprint.go's forListStmt.
func fpForListStmt(s: int) {
    var lv: text
    var lt: text
    var cnt: text
    var ix: text
    var elemC: string
    var vName: string

    lv = fpExpr(irForListListV(s))
    lt = fpNewTmp("rt_list *")
    fpEmit(lt + " = " + lv + ";")
    cnt = fpNewTmp("int32_t")
    fpEmit(cnt + " = rt_list_count(" + lt + ");")
    ix = fpNewTmp("int32_t")
    elemC = cpCType(irtElem(irExprType(irForListListV(s))))
    vName = poolGet(irForListV(s))
    fpEmit("for (" + ix + " = 0; " + ix + " < " + cnt + "; " + ix + "++) {")
    fpIndent = fpIndent + 1
    fpEmit("cv_" + vName + " = *(" + elemC + "*)rt_list_at(" + lt + ", " + ix + ");")
    fpStmts(irForListBody(s))
    fpIndent = fpIndent - 1
    fpEmit(toText("}"))
}

// fpForMapStmt lowers `for k, v in m { ... }` to an index loop over
// rt_map_count/rt_map_key_at/rt_map_val_at -- ascending key order, per
// rt.c's CONTRACT comment on rt_map -- a port of funcprint.go's
// forMapStmt. The value fetch only emits when the loop declared a V:
// irForMapV(s) is -1 (parseForStmt's own "no second IDENT" signal,
// threaded straight through lowFor) when the loop wrote `for k in m`
// without a value variable.
func fpForMapStmt(s: int) {
    var mv: text
    var mt: text
    var cnt: text
    var ix: text
    var vNameIdx: int

    mv = fpExpr(irForMapMapV(s))
    mt = fpNewTmp("rt_map *")
    fpEmit(mt + " = " + mv + ";")
    cnt = fpNewTmp("int32_t")
    fpEmit(cnt + " = rt_map_count(" + mt + ");")
    ix = fpNewTmp("int32_t")
    fpEmit("for (" + ix + " = 0; " + ix + " < " + cnt + "; " + ix + "++) {")
    fpIndent = fpIndent + 1
    fpEmit("rt_map_key_at(" + mt + ", " + ix + ", (uint8_t*)&cv_" + poolGet(irForMapK(s)) + ");")
    vNameIdx = irForMapV(s)
    if vNameIdx != -1 {
        fpEmit("rt_map_val_at(" + mt + ", " + ix + ", &cv_" + poolGet(vNameIdx) + ");")
    }
    fpStmts(irForMapBody(s))
    fpIndent = fpIndent - 1
    fpEmit(toText("}"))
}

// fpWhileStmt prints `while (1) { <cond's temps, re-run every iteration>;
// if (!(cond)) break; <body> }` rather than a plain C `while (cond)`: cond
// may itself need statement-level temporaries (e.g. a string concat), which
// must be recomputed every iteration, not hoisted out and reused stale --
// funcprint.go's whileStmt.
//
// memory-audit Task 6: cond's own construction lands INSIDE this `while (1)`
// block (not hoisted before it), so a text temp it creates is rebuilt fresh
// every iteration -- freeing it only once, after the loop (fpStmt's usual
// end-of-statement tail), would leak every iteration but the last. Nothing
// hands off a condition value (it's read by a comparison/`!`, never stored),
// so whatever fpExpr(cond) tracked is exactly the temps to free; flush them
// here, right after the break check, once per iteration, before the body
// (which tracks/frees its own temps independently via its own fpStmt calls).
func fpWhileStmt(s: int) {
    var cond: text

    fpEmit(toText("while (1) {"))
    fpIndent = fpIndent + 1
    cond = fpExpr(irWhileCond(s))
    fpEmit("if (!(" + cond + ")) break;")
    fpFreeStmtTmps()
    fpStmts(irWhileBody(s))
    fpIndent = fpIndent - 1
    fpEmit(toText("}"))
}

// fpForRangeStmt evaluates From/To once into temps (never re-embeds their
// expression text into the loop header, which would re-evaluate -- and for
// a From/To that's a function call, re-run -- them every iteration) and
// loops the bound variable, already declared at function top, over
// [from, to] inclusive -- funcprint.go's forRangeStmt.
func fpForRangeStmt(s: int) {
    var from: text
    var ft: text
    var toVal: text
    var tt: text
    var vName: string

    from = fpExpr(irForRangeFrom(s))
    ft = fpNewTmp("int32_t")
    fpEmit(ft + " = " + from + ";")
    toVal = fpExpr(irForRangeTo(s))
    tt = fpNewTmp("int32_t")
    fpEmit(tt + " = " + toVal + ";")
    vName = poolGet(irForRangeV(s))
    fpEmit("for (cv_" + vName + " = " + ft + "; cv_" + vName + " <= " + tt + "; cv_" + vName + "++) {")
    fpIndent = fpIndent + 1
    fpStmts(irForRangeBody(s))
    fpIndent = fpIndent - 1
    fpEmit(toText("}"))
}

// fpStripOuterParens removes one matching outer parenthesis pair from s, if
// present -- a port of funcprint.go's stripOuterParens. fpExpr always wraps
// a Bin/Un result in its own parens (needed when nested inside another
// expression); printed directly as an `if (...)` condition, a top-level
// comparison would come out double-parenthesized (`if ((a == b))`). Used
// only where the condition becomes the entire, sole content of a C
// `if (...)`.
func fpStripOuterParens(s: text): text {
    var depth: int
    var i: int
    var c: char
    var r: text

    if s.length < 2 or s[0] != '(' or s[s.length - 1] != ')' {
        return s
    }
    depth = 0
    i = 0
    while i < s.length {
        c = s[i]
        if c == '(' {
            depth = depth + 1
        } else if c == ')' {
            depth = depth - 1
            if depth == 0 and i != s.length - 1 {
                return s
            }
        }
        i = i + 1
    }
    // Build the inner run s[1 .. length-2] by appending each char: a text
    // slice (s[1, length-2]) would route through rt_text_slice into a
    // clar_str_255, re-imposing the 255-byte cap this whole change removes
    // (and overflowing outright on a long condition). Char-append is
    // uncapped and byte-identical.
    r = ""
    i = 1
    while i < s.length - 1 {
        r.append(s[i])
        i = i + 1
    }
    return r
}

// fpIfStmt prints an SIf node (funcprint.go's ifStmt).
// memory-audit Task 6 (review fix): if the condition itself created a text
// temp (e.g. a concat feeding a comparison), that temp is tracked at the
// SIf statement's level (fpStmt's own fpStmtTmps), meant to be freed by
// fpStmt's generic end-of-statement flush AFTER this whole if/else prints.
// But a `return`/`break`/`continue` inside either branch jumps out of the
// generated C before that flush ever runs -- the same trap fpWhileStmt's
// condition already had to dodge. Fix: when the condition creates a temp,
// materialize its bool value into a flag (same trick fpAndOr uses for its
// own short-circuit result) and free right after, BEFORE printing the
// `if`/branches at all -- the free then always runs exactly once,
// regardless of which branch is taken or whether it exits early. A
// condition with no temps (the overwhelming common case) is untouched:
// still a plain, direct `if (cond) {`.
func fpIfStmt(s: int) {
    var cond: text
    var flag: text
    var markCount: int

    markCount = fpStmtTmps.count
    cond = fpStripOuterParens(fpExpr(irIfCond(s)))
    if fpStmtTmps.count > markCount {
        flag = fpNewTmp("int32_t")
        fpEmit(flag + " = " + cond + ";")
        fpFreeStmtTmps()
        cond = flag
    }
    fpEmit("if (" + cond + ") {")
    fpIndent = fpIndent + 1
    fpStmts(irIfThen(s))
    fpIndent = fpIndent - 1
    if irIfElse(s) != -1 {
        fpEmit(toText("} else {"))
        fpIndent = fpIndent + 1
        fpStmts(irIfElse(s))
        fpIndent = fpIndent - 1
    }
    fpEmit(toText("}"))
}

func fpStmts(head: int) {
    var s: int

    s = head
    while s != -1 {
        fpStmt(s)
        s = irStmtNext(s)
    }
}

// ================================================================
// Function + main printing (cprint.go subset)
// ================================================================

// cpFuncProto renders a function/handler's C prototype (cprint.go's
// funcProto), without the trailing ";" or " {". params/the return value are
// `text`, not `string`: a `string` is a fixed 255-byte buffer, and a
// function with enough params (or record-typed/long-named ones) produces a
// comma-joined param list that can run past that -- the same class of bug
// cpEmitEnums had (fixed above) for an enum's ordinal list.
func cpFuncProto(f: int): text {
    var params: text
    var p: int
    var first: bool

    params = toText("")
    first = true
    p = irFuncParamsHead(f)
    while p != -1 {
        if not first {
            params = params + ", "
        }
        first = false
        params = params + cpCType(irLocalType(p)) + " cv_" + poolGet(irLocalName(p))
        p = irLocalNext(p)
    }
    if first {
        params = toText("void")
    }
    return toText("static " + cpCType(irFuncRet(f)) + " clar_fn_" + poolGet(irFuncName(f)) + "(") + params + toText(")")
}

// cpDefaultInit emits the default-value statement(s) for dst at type t, via
// fpEmit (so it lands wherever the caller's fpBody/fpIndent currently point
// -- a record's clar_new_NAME ctor, clar_init_globals, or a function's local
// declarations all reuse this same one code path, exactly like Go's
// defaultInit being one function called from emitRecords/emitGlobalsAndInit/
// emitFunc alike): `dst = 0;` for a scalar, a clamped rt_str_store for a Str
// default (or `dst = (clar_str_N){0};` with no override), `dst =
// rt_text_new();` (+ a store, if a string default) for Text, a fresh
// list/map handle, `dst = clar_new_NAME();` for a Rec (which itself applies
// that record's OWN per-field defaults -- a nil-Init Rec value gets exactly
// the same defaults as clar_new_NAME because this is that same function),
// `{0, ""}`-equivalent field-by-field zeroing for Err, and an unrolled
// bounds-checked `for` loop recursing into the element type for Arr -- a
// port of defaults.go's defaultInit. scalarDefault/strDefault are 0/-1 (no
// override) for every nil-Init global/local; a record field's OWN default
// (IRFieldSlot.default/defaultStr) is passed through by cpEmitRecords.
func cpDefaultInit(dst: text, t: int, scalarDefault: int, strDefault: int) {
    var k: IRKind
    var ix: text

    k = irtKind(t)
    if k == KInt or k == KBool or k == KFixed or k == KChar or k == KEnum {
        fpEmit(dst + " = " + numToStr(scalarDefault) + ";")
    } else if k == KWinRef {
        // `var w: SomeWindow` declares a nil window reference (Ch8) -- a
        // plain NULL `void *`, same spelling nil itself lowers to (lower.cla's
        // ExNilLit case).
        fpEmit(dst + " = 0;")
    } else if k == KStr {
        if strDefault < 0 {
            fpEmit(dst + " = (" + cpCType(t) + "){0};")
        } else {
            fpEmit("rt_str_store((uint8_t*)&(" + dst + "), " + numToStr(irtN(t)) + ", (const uint8_t*)&clar_lit_" + numToStr(strDefault) + ");")
        }
    } else if k == KText {
        fpEmit(dst + " = rt_text_new();")
        if strDefault >= 0 {
            fpEmit("rt_text_store(" + dst + ", (const uint8_t*)&clar_lit_" + numToStr(strDefault) + ");")
        }
    } else if k == KList {
        fpEmit(dst + " = rt_list_new(sizeof(" + cpCType(irtElem(t)) + "));")
    } else if k == KMap {
        fpEmit(dst + " = rt_map_new(sizeof(" + cpCType(irtElem(t)) + "));")
    } else if k == KRec {
        fpEmit(dst + " = clar_new_" + poolGet(irtName(t)) + "();")
    } else if k == KErr {
        fpEmit(dst + ".code = 0;")
        fpEmit(dst + ".message = (clar_str_255){0};")
    } else if k == KArr {
        cpLoopN = cpLoopN + 1
        ix = "ix" + numToStr(cpLoopN)
        fpEmit("for (int32_t " + ix + " = 0; " + ix + " < " + numToStr(irtN(t)) + "; " + ix + "++) {")
        fpIndent = fpIndent + 1
        cpDefaultInit(dst + ".e[" + ix + "]", irtElem(t), 0, -1)
        fpIndent = fpIndent - 1
        fpEmit(toText("}"))
    }
}

// cpEmitFree appends to dst the free statement(s) that release cexpr's (an
// lvalue C expression) storage per IR type t -- the shallow-plus rule
// (memory-audit spec, Task 5): KText frees its own buffer; KList/KMap free
// their own handle, plus -- only when the element/value type is itself
// KText -- a loop freeing each element's text handle first (an element type
// that is itself KList/KMap is left alone: shallow only, matching Ch3
// reference semantics, until ARC); KArr/KRec recurse into exactly the slots
// cpDefaultInit constructs (mirroring its KArr/KRec branches above, so free
// walks precisely what init built); every other kind emits nothing. A
// reusable helper -- called here for globals, and again by later tasks for
// function-local and record-field disposal.
func cpEmitFree(dst: text, cexpr: string, t: int) {
    var k: IRKind
    var et: int
    var f: int
    var ix: string
    var ri: int

    k = irtKind(t)
    if k == KText {
        cpAppendLine(dst, "    rt_text_free(" + cexpr + ");")
    } else if k == KList {
        et = irtElem(t)
        if irtKind(et) == KText {
            cpAppendLine(dst, "    { int32_t i; for (i = 0; i < rt_list_count(" + cexpr + "); i++) rt_text_free(*(rt_text **)rt_list_at(" + cexpr + ", i)); }")
        }
        cpAppendLine(dst, "    rt_list_free(" + cexpr + ");")
    } else if k == KMap {
        et = irtElem(t)
        if irtKind(et) == KText {
            cpAppendLine(dst, "    { int32_t i; rt_text *v; for (i = 0; i < rt_map_count(" + cexpr + "); i++) { rt_map_val_at(" + cexpr + ", i, &v); rt_text_free(v); } }")
        }
        cpAppendLine(dst, "    rt_map_free(" + cexpr + ");")
    } else if k == KArr {
        et = irtElem(t)
        if irtNeedsCtor(et) {
            cpLoopN = cpLoopN + 1
            ix = "ix" + numToStr(cpLoopN)
            cpAppendLine(dst, "    for (int32_t " + ix + " = 0; " + ix + " < " + numToStr(irtN(t)) + "; " + ix + "++) {")
            cpEmitFree(dst, cexpr + ".e[" + ix + "]", et)
            cpAppendLine(dst, "    }")
        }
    } else if k == KRec {
        ri = 0
        while ri < irRecords.count {
            if irRecordLayoutName(ri) == irtName(t) {
                f = irRecordLayoutFieldsHead(ri)
                while f != -1 {
                    if irtNeedsCtor(irFieldSlotType(f)) {
                        cpEmitFree(dst, cexpr + ".cv_" + poolGet(irFieldSlotName(f)), irFieldSlotType(f))
                    }
                    f = irFieldSlotNext(f)
                }
                ri = irRecords.count
            } else {
                ri = ri + 1
            }
        }
    }
}

// cpZeroLiteral renders a type-correct placeholder value for t, for the
// unreachable trailing return cpEmitFunc appends after a non-void body
// (types.go's zeroLiteral).
func cpZeroLiteral(t: int): string {
    var k: IRKind

    k = irtKind(t)
    if k == KText or k == KList or k == KMap {
        return "NULL"
    } else if k == KRec {
        return "clar_new_" + poolGet(irtName(t)) + "()"
    } else if k == KStr or k == KArr or k == KErr {
        return "(" + cpCType(t) + "){0}"
    }
    return "0"
}

// cpEmitFunc appends one function's full definition to cpRestBuf
// (cprint.go's emitFunc). Skeleton: scalar-only locals default-init, no
// trailing return (handlers are void).
func cpEmitFunc(f: int) {
    var loc: int
    var i: int
    var declared: map of int
    var nm: string

    cpEnsureType(irFuncRet(f))
    fpReset(1)

    // Every local (var-declared, or a for-range loop's bound variable) is
    // hoisted to the top of the C function (Ch5: "var only at the top of a
    // function/handler body"). Two sibling (non-nested, non-overlapping)
    // for-range loops reusing the same bound-variable name is legal Clarus
    // and common style (lowFor appends a fresh IRLocal per loop, same name,
    // same Int type every time): declaring the shared C variable once and
    // reusing it across both loops is semantically identical to two
    // independent loops in C, so a duplicate (name, same-type) entry just
    // skips re-declaration -- cprint.go's emitFunc. A genuine same-name/
    // different-type collision is a real ambiguity in a flat-by-name IR and
    // is reported loudly rather than silently miscompiled.
    loc = irFuncLocalsHead(f)
    while loc != -1 {
        nm = poolGet(irLocalName(loc))
        if declared.has(nm) {
            if not cpTypeEqual(declared.get(nm, -1), irLocalType(loc)) {
                log("cprint: local " + nm + " redeclared with a different type in func " + poolGet(irFuncName(f)) + " (unsupported: same name, different type, in sibling scopes)")
                quit 1
            }
        } else {
            declared[nm] = irLocalType(loc)
            fpEmit(toText(cpCType(irLocalType(loc)) + " cv_" + nm + ";"))
            cpDefaultInit(toText("cv_" + nm), irLocalType(loc), 0, -1)
        }
        loc = irLocalNext(loc)
    }
    fpStmts(irFuncBodyHead(f))
    // Every path through a well-formed Clarus function already returns (or is
    // void), but proving that from C is harder than the checker's own
    // analysis -- an unconditional trailing return sidesteps -Wreturn-type.
    // Dead code when the real body returns on every path (cprint.go's emitFunc).
    if irtKind(irFuncRet(f)) != KVoid {
        fpEmit(toText("return " + cpZeroLiteral(irFuncRet(f)) + ";"))
    }

    cpRestBuf.add(cpFuncProto(f) + " {")
    i = 0
    while i < fpBody.count {
        cpRestBuf.add(fpBody[i])
        i = i + 1
    }
    cpRestBuf.add(toText("}"))
    cpRestBuf.add(toText(""))
    // Harvesting above copies each line's `text` HANDLE into cpRestBuf (Ch3:
    // text is a reference), not its bytes -- fpBody still points at those
    // same handles until the NEXT cpEmitFunc call's fpReset clears it. For
    // every function but the last one that's harmless (the next call's
    // fpReset runs before fpBody is read again); for the LAST function
    // compiled, nothing else ever clears fpBody, so cv_fpBody and
    // cv_cpRestBuf would both still reference those handles at program
    // exit -- cl_free_globals (memory-audit Task 5) would then double-free
    // them. Clearing here (not disposing -- cpRestBuf now owns them) closes
    // that gap unconditionally rather than relying on being non-last.
    fpReset(fpIndent)
}

// cpEmitFuncs prints every prototype up front, then every definition
// (cprint.go's emitFuncs).
func cpEmitFuncs() {
    var i: int

    i = 0
    while i < irFuncs.count {
        cpRestBuf.add(cpFuncProto(i) + ";")
        i = i + 1
    }
    cpRestBuf.add(toText(""))
    i = 0
    while i < irFuncs.count {
        cpEmitFunc(i)
        i = i + 1
    }
}

// cpEmitRecords prints every record struct (and its clar_new_NAME
// constructor) in declaration order, into cpRecBuf -- cprint.go's
// emitRecords. Clarus requires declare-before-use for record-typed fields,
// so any nested record a field refers to was already fully emitted by an
// earlier iteration of this same loop -- cpEnsureType's lazy array-wrapper
// emission (for Arr-typed fields) can safely assume that. clar_new_NAME's
// body is built via the same fpReset/fpEmit/fpBody machinery cpEmitFunc uses
// for a real function body (indent level 1), then harvested into cpRecBuf,
// since cpDefaultInit only knows how to append to "whatever fpBody
// currently is".
func cpEmitRecords() {
    var i: int
    var f: int
    var name: string
    var ctype: string
    var j: int

    i = 0
    while i < irRecords.count {
        f = irRecordLayoutFieldsHead(i)
        while f != -1 {
            cpEnsureType(irFieldSlotType(f))
            f = irFieldSlotNext(f)
        }
        name = poolGet(irRecordLayoutName(i))
        ctype = "clar_rec_" + name

        cpRecBuf.add(toText("typedef struct {"))
        f = irRecordLayoutFieldsHead(i)
        while f != -1 {
            cpRecBuf.add(toText("    " + cpCType(irFieldSlotType(f)) + " cv_" + poolGet(irFieldSlotName(f)) + ";"))
            f = irFieldSlotNext(f)
        }
        cpRecBuf.add(toText("} " + ctype + ";"))

        fpReset(1)
        f = irRecordLayoutFieldsHead(i)
        while f != -1 {
            cpDefaultInit(toText("r.cv_" + poolGet(irFieldSlotName(f))), irFieldSlotType(f), irFieldSlotDefault(f), irFieldSlotDefaultStr(f))
            f = irFieldSlotNext(f)
        }
        cpRecBuf.add(toText("static " + ctype + " clar_new_" + name + "(void) {"))
        cpRecBuf.add(toText("    " + ctype + " r;"))
        j = 0
        while j < fpBody.count {
            cpRecBuf.add(fpBody[j])
            j = j + 1
        }
        cpRecBuf.add(toText("    return r;"))
        cpRecBuf.add(toText("}"))
        cpRecBuf.add(toText(""))
        // See cpEmitFunc's matching comment: harvesting shares fpBody's text
        // handles into cpRecBuf by reference; clear fpBody so a program
        // whose LAST harvest happens to be a record ctor (no functions
        // follow) doesn't leave cv_fpBody aliasing cv_cpRecBuf at exit.
        fpReset(1)
        i = i + 1
    }
}

// cpEnumArraysEmitted dedupes clar_enumvals_NAME/clar_enumlabels_NAME array
// emission (cpEmitEnumArraysOnce below) across every record field that
// references the same enum type -- keyed by name like cpStrCapsEmitted/
// cpArrEmitted above (neither of those is reset in cpResetBuffers either;
// same "one emitProgram call per process" precedent this follows).
var cpEnumArraysEmitted: map of int

// cpEmitEnumArraysOnce emits enumNameIdx's clar_enumvals_NAME/
// clar_enumlabels_NAME arrays into cpRecBuf the first time enumNameIdx is
// seen. Walks irEnums for the matching IREnumLayout (same linear scan as
// cpEnumCount above); labels reuse cpUiCaptionOrNull's Pascal-string
// escaping -- lowEnumDecl (lower.cla) guarantees every member has a label
// (its own, or its name default), so idx == -1 never reaches
// cpUiCaptionOrNull here.
func cpEmitEnumArraysOnce(enumNameIdx: int) {
    var name: string
    var i: int
    var m: int
    var vals: text
    var labels: text
    var first: bool

    name = poolGet(enumNameIdx)
    if cpEnumArraysEmitted.has(name) {
        return
    }
    cpEnumArraysEmitted[name] = 1

    i = 0
    while i < irEnums.count {
        if irEnumLayoutName(i) == enumNameIdx {
            vals = ""
            labels = ""
            first = true
            m = irEnumLayoutMembersHead(i)
            while m != -1 {
                if not first {
                    vals.append(", ")
                    labels.append(", ")
                }
                first = false
                vals.append(numToStr(irEnumMemberValue(m)))
                labels.append(cpUiCaptionOrNull(irEnumMemberLabel(m)))
                m = irEnumMemberNext(m)
            }
            cpRecBuf.add(toText("static const int32_t clar_enumvals_" + name + "[] = {") + vals + toText("};"))
            cpRecBuf.add(toText("static const unsigned char *const clar_enumlabels_" + name + "[] = {") + labels + toText("};"))
            return
        }
        i = i + 1
    }
    log("cprint: unknown enum " + name)
    quit 1
}

// cpFieldDescRow renders one clar_fields_NAME[] entry (an rt_field_desc
// literal, rt.h's Task 1 contract) for field slot f of record recName. Only
// KInt/KFixed/KBool/KChar/KStr/KEnum can appear here -- lower.cla's
// lowCheckSerializableFields already rejected every other field kind before
// a record could reach cpEmitLayouts, so KEnum is the correctness-preserving
// fallthrough (not a silent default).
func cpFieldDescRow(recName: string, f: int): string {
    var t: int
    var k: IRKind
    var ftype: string
    var strCap: int
    var enumCount: int
    var enumVals: string
    var enumLabels: string

    t = irFieldSlotType(f)
    k = irtKind(t)
    strCap = 0
    enumCount = 0
    enumVals = "0"
    enumLabels = "0"
    if k == KInt {
        ftype = "RT_FT_INT"
    } else if k == KFixed {
        ftype = "RT_FT_FIXED"
    } else if k == KBool {
        ftype = "RT_FT_BOOL"
    } else if k == KChar {
        ftype = "RT_FT_CHAR"
    } else if k == KStr {
        ftype = "RT_FT_STR"
        strCap = irtN(t)
    } else {
        ftype = "RT_FT_ENUM"
        enumCount = cpEnumCount(irtName(t))
        enumVals = "clar_enumvals_" + poolGet(irtName(t))
        enumLabels = "clar_enumlabels_" + poolGet(irtName(t))
    }
    return "{ " + ftype + ", " + numToStr(strCap) + ", (long)offsetof(clar_rec_" + recName + ", cv_" + poolGet(irFieldSlotName(f)) + "), " + numToStr(enumCount) + ", " + enumVals + ", " + enumLabels + " }"
}

// cpEmitLayouts (Task 2, mac-target-4d) prints, for every record type
// lower.cla's irLayoutNeeded registry marked (i.e. one that reached
// file.save/load), a static rt_field_desc[] + rt_layout_desc pair into
// cpRecBuf -- cprint.go has no equivalent (this whole feature postdates the
// Go reference compiler's freeze). Appended right after cpEmitRecords'
// clar_rec_NAME structs (same buffer, in the SAME call to emitProgram, so
// every offsetof/sizeof below always follows its target typedef) and so
// always before cpUiBuf's window descs in emitProgram's fixed assembly
// order (cpRecBuf prints first). Enum sub-arrays are emitted once per enum
// type via cpEmitEnumArraysOnce, walked BEFORE this record's own fields
// array so they're always declared above their first use.
func cpEmitLayouts() {
    var i: int
    var f: int
    var name: int
    var recName: string
    var ft: int
    var nFields: int

    i = 0
    while i < irRecords.count {
        name = irRecordLayoutName(i)
        if irLayoutNeeded(name) {
            recName = poolGet(name)
            f = irRecordLayoutFieldsHead(i)
            while f != -1 {
                ft = irFieldSlotType(f)
                if irtKind(ft) == KEnum {
                    cpEmitEnumArraysOnce(irtName(ft))
                }
                f = irFieldSlotNext(f)
            }

            cpRecBuf.add(toText("static const rt_field_desc clar_fields_" + recName + "[] = {"))
            nFields = 0
            f = irRecordLayoutFieldsHead(i)
            while f != -1 {
                cpRecBuf.add(toText("    " + cpFieldDescRow(recName, f) + ","))
                nFields = nFields + 1
                f = irFieldSlotNext(f)
            }
            cpRecBuf.add(toText("};"))
            cpRecBuf.add(toText("static const rt_layout_desc clar_layout_" + recName + " = { (long)sizeof(clar_rec_" + recName + "), " + numToStr(nFields) + ", clar_fields_" + recName + " };"))
            cpRecBuf.add(toText(""))
        }
        i = i + 1
    }
}

// cpEmitEnums prints each enum's value table (for the checked int->enum
// conversion, rt_enum_from_int) plus a matching _count constant, into
// cpRestBuf -- cprint.go's emitEnums. Marked __attribute__((unused)): a
// program that declares an enum but never runs a checked EnumType(i)
// conversion on it would otherwise fail -Wunused-const-variable under
// -Werror.
func cpEmitEnums() {
    var i: int
    var m: int
    // vals is `text`, not `string`: a `string` is a fixed 255-byte buffer,
    // and the comma-joined ordinal list can run past that for an enum with
    // enough members (clarusc's own TokKind has 67) -- it would silently
    // truncate rather than error, emitting invalid C. Self-emission is what
    // exposed this: no testdata corpus enum is large enough to hit it.
    var vals: text
    var first: bool
    var count: int
    var name: string

    i = 0
    while i < irEnums.count {
        vals = toText("")
        first = true
        count = 0
        m = irEnumLayoutMembersHead(i)
        while m != -1 {
            if not first {
                vals = vals + ", "
            }
            first = false
            vals = vals + numToStr(irEnumMemberValue(m))
            count = count + 1
            m = irEnumMemberNext(m)
        }
        name = poolGet(irEnumLayoutName(i))
        cpRestBuf.add(toText("static const int32_t clar_enum_" + name + "[] __attribute__((unused)) = {") + vals + toText("};"))
        cpRestBuf.add(toText("static const int clar_enum_" + name + "_count __attribute__((unused)) = " + numToStr(count) + ";"))
        i = i + 1
    }
    cpRestBuf.add(toText(""))
}

// ================================================================
// UI descriptor printing (Task 4): irWindowDescs/irMenuDescs (ir.cla) ->
// static const rt_ui_widget_desc[]/rt_ui_window_desc/rt_ui_item_desc[]/
// rt_ui_menu_desc tables, matching the shape internal/mactest/uiprobe/
// probe_ui.c hand-authors (rt_ui.h's own living example). Every C
// identifier this section mints uses the "clar_ui_" prefix, alongside this
// file's existing cv_/clar_fn_/clar_rec_/clar_str_/clar_lit_/clar_enum_/
// clar_new_ conventions -- never bare, so a generated name can never
// collide with a user identifier (those are always cv_/clar_fn_-prefixed
// too). Handler-table fields (rt_ui_window_desc.handlers) print a bare `0`
// for a window with no `extend` block at all (NULL still compiles and
// links against rt_ui.h's `const rt_ui_handlers *` field type); Task 5 wires
// a real `&clar_ui_handlers_NAME` for every window that registers at least
// one handler -- see cpEmitWinHandlersFwd/cpEmitUiDispatchers below.
// ================================================================

func cpBoolLit(b: bool): string {
    if b {
        return "1"
    }
    return "0"
}

// cpOctal3 renders v (0-255) as exactly three octal digits, for C string
// escapes: \311 is self-delimiting where \xC9 would swallow a following
// hex digit (C's \x is maximal-munch).
func cpOctal3(v: int): string {
    var d: string
    d = numToStr(v mod 8)
    d = numToStr((v / 8) mod 8) + d
    d = numToStr(v / 64) + d
    return d
}

// cpEscapeCStr escapes s for embedding inside a C double-quoted string
// literal: backslash and doublequote are backslash-escaped, and any byte
// outside printable ASCII (e.g. a \xHH escape decoded from a Clarus source
// literal, such as MacRoman accented text) is emitted as a 3-digit octal
// escape rather than passed through raw.
func cpEscapeCStr(s: string): string {
    var out: string
    var i: int
    var c: char

    out = ""
    i = 0
    while i < s.length {
        c = s[i]
        if c == '"' {
            out = out + "\\\""
        } else if c == '\\' {
            out = out + "\\\\"
        } else if int(c) < 32 or int(c) > 126 {
            out = out + "\\" + cpOctal3(int(c))
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// cpUiCaptionOrNull renders a widget/menu-item caption slot: idx == -1 (no
// caption -- e.g. a canvas widget, or a separator) prints a bare `0`
// (matching probe_ui.c's own NULL-caption widgets/separators exactly);
// otherwise a Retro68 "\pFoo"-escaped Str255 literal cast to `const
// unsigned char *`, the same spelling probe_ui.c hand-authors throughout.
func cpUiCaptionOrNull(idx: int): string {
    if idx == -1 {
        return "0"
    }
    return "(const unsigned char *)\"\\p" + cpEscapeCStr(poolGet(idx)) + "\""
}

// cpUiTitleStr renders a window/menu title slot: unlike a widget caption, a
// title is never semantically absent (NewWindow/NewMenu both want a real,
// possibly-empty Str255, not NULL), so idx == -1 (no `title:` property
// given) prints an empty Pascal string rather than 0.
func cpUiTitleStr(idx: int): string {
    if idx == -1 {
        return "(const unsigned char *)\"\\p\""
    }
    return "(const unsigned char *)\"\\p" + cpEscapeCStr(poolGet(idx)) + "\""
}

// cpMenuKeyChar renders a menu item's key-equivalent slot (`unsigned char
// key`): 0 if the item declared no `key "K"`, else a C char literal.
func cpMenuKeyChar(keyIdx: int): string {
    var s: string

    if keyIdx == -1 {
        return "0"
    }
    s = poolGet(keyIdx)
    if s.length == 0 {
        return "0"
    }
    return "'" + s + "'"
}

// cpWidgetKindMacro is an explicit five-way dispatch over rt_ui's whole
// widget-kind surface (mac-target-4c Task 2) -- lower.cla's lowWidgetDesc
// already rejects every other kind before an IRWidgetDesc can exist, so
// reaching the fallthrough below means an IRWidgetDesc was constructed with
// a kind that guard didn't validate (an internal-invariant break, not a
// user-facing error), reported loudly rather than silently mis-emitted as
// RTUI_LABEL the way the old default fallthrough did.
func cpWidgetKindMacro(kindIdx: int): string {
    var kind: string

    kind = poolGet(kindIdx)
    if kind == "button" {
        return "RTUI_BUTTON"
    }
    if kind == "check" {
        return "RTUI_CHECK"
    }
    if kind == "canvas" {
        return "RTUI_CANVAS"
    }
    if kind == "label" {
        return "RTUI_LABEL"
    }
    if kind == "field" {
        return "RTUI_FIELD"
    }
    if kind == "textview" {
        return "RTUI_TEXTVIEW"
    }
    if kind == "popup" {
        return "RTUI_POPUP"
    }
    if kind == "table" {
        return "RTUI_TABLE"
    }
    log("cprint: unknown widget kind " + kind)
    quit 1
    return ""
}

func cpAtKindMacro(k: int): string {
    if k == 1 {
        return "RTUI_AT_NEXT"
    }
    if k == 2 {
        return "RTUI_AT_RIGHT"
    }
    if k == 3 {
        return "RTUI_AT_AUTO"
    }
    return "RTUI_AT_XY"
}

func cpFillMacro(fillBoth: bool): string {
    if fillBoth {
        return "RTUI_FILL_BOTH"
    }
    return "RTUI_FILL_NONE"
}

func cpWidgetFlagsMacro(isDefault: bool, isCancel: bool, isBuffered: bool, isScrollV: bool, isScrollH: bool): string {
    var s: string

    s = ""
    if isDefault {
        s = "RTUI_DEFAULT"
    }
    if isCancel {
        if s == "" {
            s = "RTUI_CANCEL"
        } else {
            s = s + " | RTUI_CANCEL"
        }
    }
    if isBuffered {
        if s == "" {
            s = "RTUI_BUFFERED"
        } else {
            s = s + " | RTUI_BUFFERED"
        }
    }
    if isScrollV {
        if s == "" {
            s = "RTUI_SCROLL_V"
        } else {
            s = s + " | RTUI_SCROLL_V"
        }
    }
    if isScrollH {
        if s == "" {
            s = "RTUI_SCROLL_H"
        } else {
            s = s + " | RTUI_SCROLL_H"
        }
    }
    if s == "" {
        return "0"
    }
    return s
}

// cpEmitUiStateStruct prints one window's per-instance-var state struct
// (clar_uistate_NAME) into cpRecBuf -- a plain typedef, deliberately NOT
// routed through cpEmitRecords: a UI state block is allocated and zeroed by
// rt_ui itself (rt_ui_state's Handle), never via a clar_new_NAME
// constructor, so there is no per-field default-init body to emit here.
// Two passes over fieldsHead, same shape as cpEmitRecords: an Arr-typed
// field's cpEnsureType lazily appends its clar_arr_ELEM_N wrapper typedef to
// this SAME cpRecBuf, which would otherwise land in the middle of this
// struct's own still-open "typedef struct {" (clarusc-ui-gaps Fix round 1 --
// no window state field was Arr-typed before item 1 widened construction
// into arrays, so this ordering bug was latent until now) -- every
// referenced type must already exist before the struct opens.
func cpEmitUiStateStruct(name: string, fieldsHead: int) {
    var f: int

    f = fieldsHead
    while f != -1 {
        cpEnsureType(irFieldSlotType(f))
        f = irFieldSlotNext(f)
    }
    cpRecBuf.add(toText("typedef struct {"))
    f = fieldsHead
    while f != -1 {
        cpRecBuf.add(toText("    " + cpCType(irFieldSlotType(f)) + " cv_" + poolGet(irFieldSlotName(f)) + ";"))
        f = irFieldSlotNext(f)
    }
    cpRecBuf.add(toText("} clar_uistate_" + name + ";"))
    cpRecBuf.add(toText(""))
}

// cpEmitWidgetDescArray prints one window's rt_ui_widget_desc[] array (Ch8)
// into cpUiBuf, in the SAME order lower.cla's lowWindowDecl chained them --
// the order uiWidgetIndex (lower.cla) and this array's own positions agree
// on. Returns the array's own C name, for the window desc below to
// reference.
func cpEmitWidgetDescArray(winName: string, headIdx: int): string {
    var name: string
    var w: int
    var yStr: string
    var widthStr: string
    var capIdx: int
    var kind: string

    // Pre-pass (mac-target-4d Task 5): any table widget's cols[]/table_desc
    // must already exist before the widget array below takes their address
    // (same "declare before use" reasoning as cpEmitMenuItemsArray's own
    // call-before-reference in cpEmitMenuDescs) -- a window with no table at
    // all makes this loop a no-op, so every pre-Task-5 golden's cpUiBuf text
    // is completely untouched.
    w = headIdx
    while w != -1 {
        if poolGet(irWidgetDescKind(w)) == "table" {
            cpEmitOneTableDesc(winName, w)
        }
        w = irWidgetDescNext(w)
    }

    name = "clar_ui_widgets_" + winName
    cpUiBuf.add(toText("static const rt_ui_widget_desc " + name + "[] = {"))
    w = headIdx
    while w != -1 {
        yStr = "RTUI_BOTTOM"
        if not irWidgetDescYIsBottom(w) {
            yStr = numToStr(irWidgetDescY(w))
        }
        widthStr = "RTUI_FILL"
        if not irWidgetDescWidthIsFill(w) {
            widthStr = numToStr(irWidgetDescWidth(w))
        }
        // Ch8 doc addition (mac-target-4d final-validation Fix wave, FIX 1):
        // a widget with no caption/label/text property at all (captionIdx
        // -1) falls back to its own declared NAME -- the same "member name
        // when unlabeled" rule Chapter 3 already gives an unlabeled enum
        // member (lowEnumDecl, clarusc/lower.cla). Scoped to the five kinds
        // that can even declare a caption-like property at all (checker's
        // widgetDeclProps: button.caption, check.caption, field.label,
        // popup.label, label.text -- the only ones rt_ui.c's `cap = wd->
        // caption ? ... : kEmptyPStr` ever feeds into NewControl's title or
        // a TETextBox lane); table/textview/canvas have no such property in
        // the grammar, so their captionIdx is always -1 for an unrelated
        // reason (there was never anything TO label), and baking a name in
        // there would just be inert noise in the emitted C. One spot, not
        // one per kind.
        capIdx = irWidgetDescCaption(w)
        if capIdx == -1 {
            kind = poolGet(irWidgetDescKind(w))
            if kind == "button" or kind == "check" or kind == "field" or kind == "popup" or kind == "label" {
                capIdx = irWidgetDescName(w)
            }
        }
        cpUiBuf.add(toText("    { " + cpWidgetKindMacro(irWidgetDescKind(w)) + ", \"" + poolGet(irWidgetDescName(w)) + "\", " +
            cpUiCaptionOrNull(capIdx) + ", " +
            cpAtKindMacro(irWidgetDescAtKind(w)) + ", " + numToStr(irWidgetDescX(w)) + ", " + yStr + ", " + widthStr + ", " +
            cpFillMacro(irWidgetDescFillBoth(w)) + ", " +
            cpWidgetFlagsMacro(irWidgetDescIsDefault(w), irWidgetDescIsCancel(w), irWidgetDescIsBuffered(w), irWidgetDescIsScrollV(w), irWidgetDescIsScrollH(w)) +
            cpUiWidgetExtra(winName, w) + " },"))
        w = irWidgetDescNext(w)
    }
    cpUiBuf.add(toText("};"))
    cpUiBuf.add(toText(""))
    return name
}

// cpFindWinHandlers returns winName's irWinHandlers arena index, or -1 if
// the window has no `extend` block at all (lower.cla's lowGetOrCreateWinHandlers
// only ever creates an entry on a window's FIRST registered handler) -- a
// linear scan over irWinHandlers, cheap given a program's handful of window
// types.
func cpFindWinHandlers(winName: string): int {
    var i: int

    i = 0
    while i < irWinHandlers.count {
        if poolGet(irWinHandlersName(i)) == winName {
            return i
        }
        i = i + 1
    }
    return -1
}

// cpFindWindowStateFields (clarusc-ui-gaps Task 2) returns winName's
// per-instance state fields list head (irWindowDescStateFieldsHead), or -1
// if winName names no window -- IUiStateDefaults' cprint case (fpIntrCall)
// walks this to find which fields need construction. Linear scan over
// irWindowDescs, same precedent as cpFindWinHandlers just above.
func cpFindWindowStateFields(winName: string): int {
    var i: int

    i = 0
    while i < irWindowDescs.count {
        if poolGet(irWindowDescName(i)) == winName {
            return irWindowDescStateFieldsHead(i)
        }
        i = i + 1
    }
    return -1
}

// cpFindWindowFormRecName (mac-target-4d Task 7) returns winName's form
// record type name (interned), or -1 if winName isn't a form window --
// fpUiEditStmt's own lookup for the `new T`/map-target temp's `clar_rec_T`
// spelling. Same linear-scan precedent as cpFindWindowStateFields just
// above.
func cpFindWindowFormRecName(winName: string): int {
    var i: int

    i = 0
    while i < irWindowDescs.count {
        if poolGet(irWindowDescName(i)) == winName {
            return irWindowDescFormRecName(i)
        }
        i = i + 1
    }
    return -1
}

// cpFindGlobalRecName (mac-target-4d Task 5) returns the row-record type
// name of the global list variable named globalNameIdx (IRWidgetDesc's own
// rowsGlobalIdx -- lower.cla stores only the global's NAME, not its record
// type, so cprint re-derives clar_layout_<RecName> from irGlobals here, the
// one place that needs it). Linear scan, same precedent as
// cpFindWinHandlers/cpFindWindowStateFields above.
func cpFindGlobalRecName(globalNameIdx: int): int {
    var i: int

    i = 0
    while i < irGlobals.count {
        if irGlobalName(i) == globalNameIdx {
            return irtName(irtElem(irGlobalType(i)))
        }
        i = i + 1
    }
    log("cprint: unknown table rows global " + poolGet(globalNameIdx))
    quit 1
    return -1
}

// cpEmitOneTableDesc (mac-target-4d Task 4) prints, for one table widget,
// its rt_ui_col_desc[] array and rt_ui_table_desc into cpUiBuf -- the same
// cpEmitMenuItemsArray precedent (Task 2), called from cpEmitWidgetDescArray's
// pre-pass BEFORE that window's own rt_ui_widget_desc[] array (whose table
// row takes this table_desc's ADDRESS, so it must already exist). Also
// forward-declares the bound `rows:` global as a bare tentative definition
// (`static rt_list *cv_NAME;`, no initializer) -- legal C even though
// cpEmitGlobalsInit (called later in emitProgram, but printing into
// cpRestBuf, which assembles AFTER cpUiBuf) declares the SAME global again;
// multiple tentative definitions of one static object merge under C's own
// rules, so this is the simplest way to satisfy "declared before used"
// without reordering cpEmitGlobalsInit's own buffer (which every OTHER
// existing golden's byte-identical output depends on staying put).
func cpEmitOneTableDesc(winName: string, w: int): string {
    var wgName: string
    var globalName: string
    var recName: string
    var colsName: string
    var tableName: string
    var c: int
    var nCols: int
    var widthFillStr: string

    wgName = poolGet(irWidgetDescName(w))
    globalName = poolGet(irWidgetDescRowsGlobalIdx(w))
    recName = poolGet(cpFindGlobalRecName(irWidgetDescRowsGlobalIdx(w)))

    cpUiBuf.add(toText("static rt_list *cv_" + globalName + ";"))

    colsName = "clar_ui_cols_" + winName + "_" + wgName
    cpUiBuf.add(toText("static const rt_ui_col_desc " + colsName + "[] = {"))
    c = irWidgetDescColumnsHead(w)
    nCols = 0
    while c != -1 {
        widthFillStr = "0"
        if irColumnDescWidthFill(c) {
            widthFillStr = "1"
        }
        cpUiBuf.add(toText("    { " + cpUiCaptionOrNull(irColumnDescHeader(c)) + ", " + numToStr(irColumnDescWidthPx(c)) + ", " + widthFillStr + ", " + numToStr(irColumnDescFieldIndex(c)) + " },"))
        nCols = nCols + 1
        c = irColumnDescNext(c)
    }
    cpUiBuf.add(toText("};"))

    tableName = "clar_ui_table_" + winName + "_" + wgName
    cpUiBuf.add(toText("static const rt_ui_table_desc " + tableName + " = { &cv_" + globalName + ", &clar_layout_" + recName + ", " + numToStr(nCols) + ", " + colsName + " };"))
    cpUiBuf.add(toText(""))
    return tableName
}

// cpUiWidgetExtra returns the trailing rt_ui_widget_desc `extra` field text
// (", (const void *)&clar_ui_table_<Win>_<W>", comma-prefixed to append onto
// an already-open row literal) for a table widget, or "" for every other
// kind -- the row keeps its old 9-field shape when extra is empty, so every
// pre-Task-5 golden (no table/popup ever reaches here) stays byte-identical
// (mac-target-4d Task 5's own "10th field only when non-NULL" contract).
func cpUiWidgetExtra(winName: string, w: int): string {
    if poolGet(irWidgetDescKind(w)) == "table" {
        return ", (const void *)&clar_ui_table_" + winName + "_" + poolGet(irWidgetDescName(w))
    }
    return ""
}

// cpWidgetKindForIndex returns the widget kind word ("button"/"check"/
// "canvas"/"label"/"field"/"textview") at position widgetIndex in window
// winName's declared widget list -- cpEmitOneWidgetDispatcher needs this to
// pick each widget's calling convention (0 args for button click/check
// change/field enter vs. (x, y) from a/b for canvas click/drag).
func cpWidgetKindForIndex(winName: string, widgetIndex: int): string {
    var i: int
    var w: int
    var n: int

    i = 0
    while i < irWindowDescs.count {
        if poolGet(irWindowDescName(i)) == winName {
            w = irWindowDescWidgetsHead(i)
            n = 0
            while w != -1 {
                if n == widgetIndex {
                    return poolGet(irWidgetDescKind(w))
                }
                n = n + 1
                w = irWidgetDescNext(w)
            }
        }
        i = i + 1
    }
    return "" // unreachable for a checker-clean program
}

// cpWinHandlersHasWinEvent/HasWidget report whether window handlers `whIdx`
// registered at least one bare window event / widget event -- used both to
// decide whether to forward-declare+wire that half of the rt_ui_handlers
// struct (cpEmitWinHandlersFwd) and whether to define its dispatcher body
// at all (cpEmitUiDispatchers).
func cpWinHandlersHasWinEvent(whIdx: int): bool {
    return irWinHandlersOpenedFn(whIdx) != -1 or irWinHandlersCloseRequestFn(whIdx) != -1 or irWinHandlersClosedFn(whIdx) != -1 or irWinHandlersResizedFn(whIdx) != -1 or irWinHandlersKeyFn(whIdx) != -1 or irWinHandlersAcceptedFn(whIdx) != -1 or irWinHandlersCancelledFn(whIdx) != -1
}

func cpWinHandlersHasWidget(whIdx: int): bool {
    return irWinHandlersWidgetHead(whIdx) != -1
}

// cpEmitWinReleaseFn (memory-audit-4e Task 8) emits, for winName's state
// block, a static void clar_ui_release_<Win>(void *inst) freeing every
// irtNeedsCtor per-instance var that QUALIFIES (lowWinVarQualifies --
// lower.cla's whole-program reuse of Task 7's escape walker: a var aliased
// anywhere as an RHS/argument/return/stored value stays leaked-by-design
// instead of risking a use-after-free on whatever it was handed to). Exact
// mirror of fpIntrCall's IUiStateDefaults() case above (the constructor
// this is the destructor for), freeing instead of constructing, via the
// same cpEmitFree helper Task 5's globals and Task 7's locals already use.
// No forward-declare/define split like winFn/widgetFn below needs: this
// body only ever calls cpEmitFree's own rt_*_free runtime calls, never a
// clar_fn_ handler name, so it can be defined here directly. Returns the
// function's own C name, or "0" if winName has no qualifying field at all
// (callers wire a plain 0 into rt_ui_handlers.releaseVars instead of a
// pointer to an empty function).
func cpEmitWinReleaseFn(winName: string): string {
    var fld: int
    var any: bool
    var body: text
    var fname: string

    fld = cpFindWindowStateFields(winName)
    any = false
    body = ""
    while fld != -1 {
        if irtNeedsCtor(irFieldSlotType(fld)) and lowWinVarQualifies(poolGet(irFieldSlotName(fld))) {
            any = true
            cpEmitFree(body, "(*(clar_uistate_" + winName + " *)rt_ui_state(inst)).cv_" + poolGet(irFieldSlotName(fld)), irFieldSlotType(fld))
        }
        fld = irFieldSlotNext(fld)
    }
    if not any {
        return "0"
    }
    fname = "clar_ui_release_" + winName
    cpUiBuf.add(toText("static void " + fname + "(void *inst)"))
    cpUiBuf.add(toText("{"))
    cpUiBuf.add(body)
    cpUiBuf.add(toText("}"))
    cpUiBuf.add(toText(""))
    return fname
}

// cpEmitWinHandlersFwd prints (into cpUiBuf, BEFORE any clar_fn_ handler-body
// prototype exists anywhere in the emitted file -- cpEmitFuncs's own
// "prototypes up front" pass hasn't run yet at this point in emitProgram's
// assembly order) the forward declarations for window `winName`'s dispatcher
// functions (whichever of winEvent/widget actually have >=1 registered
// handler -- matching probe_ui.c's own "0 for the unused half" convention,
// e.g. kBounceHandlers = { bounce_win_event, 0 }) plus the rt_ui_handlers
// struct wiring them together. The dispatcher bodies themselves are defined
// later (cpEmitUiDispatchers, called AFTER cpEmitFuncs -- see that
// function's header comment for why the split is necessary). Returns the
// handlers struct's own C name (for the window desc to reference), or "0"
// if winName has no `extend` block at all.
func cpEmitWinHandlersFwd(winName: string): string {
    var whIdx: int
    var winFn: string
    var widgetFn: string
    var releaseFn: string

    whIdx = cpFindWinHandlers(winName)
    if whIdx == -1 {
        return "0"
    }
    winFn = "0"
    if cpWinHandlersHasWinEvent(whIdx) {
        winFn = "clar_ui_winevent_" + winName
        cpUiBuf.add(toText("static void " + winFn + "(void *inst, short event, long a, long b);"))
    }
    widgetFn = "0"
    if cpWinHandlersHasWidget(whIdx) {
        widgetFn = "clar_ui_widget_" + winName
        cpUiBuf.add(toText("static void " + widgetFn + "(void *inst, short widgetIndex, short event, long a, long b);"))
    }
    releaseFn = cpEmitWinReleaseFn(winName)
    cpUiBuf.add(toText("static const rt_ui_handlers clar_ui_handlers_" + winName + " = { " + winFn + ", " + widgetFn + ", " + releaseFn + " };"))
    cpUiBuf.add(toText(""))
    return "clar_ui_handlers_" + winName
}

// cpEmitOneFormDesc (mac-target-4d Task 7) prints, for one form window, its
// rt_ui_bind_desc[] array (if it has >=1 bound widget; a bare "0" pointer
// otherwise -- an empty-braces array isn't valid C, and rt_ui_form_desc's
// own nBinds=0 already tells the runtime never to read the pointer) and its
// rt_ui_form_desc, into cpUiBuf -- the same cpEmitOneTableDesc precedent
// (Task 4). Returns the form desc's own C name, for the window desc's
// trailing `form` field to reference.
func cpEmitOneFormDesc(winName: string, formRecNameIdx: int, bindsHead: int): string {
    var bindsName: string
    var formName: string
    var b: int
    var nBinds: int
    var bindsRef: string

    bindsName = "clar_ui_binds_" + winName
    nBinds = 0
    b = bindsHead
    while b != -1 {
        nBinds = nBinds + 1
        b = irBindDescNext(b)
    }

    bindsRef = "0"
    if nBinds > 0 {
        cpUiBuf.add(toText("static const rt_ui_bind_desc " + bindsName + "[] = {"))
        b = bindsHead
        while b != -1 {
            cpUiBuf.add(toText("    { " + numToStr(irBindDescWidgetIndex(b)) + ", " + numToStr(irBindDescFieldIndex(b)) + " },"))
            b = irBindDescNext(b)
        }
        cpUiBuf.add(toText("};"))
        bindsRef = bindsName
    }

    formName = "clar_ui_form_" + winName
    cpUiBuf.add(toText("static const rt_ui_form_desc " + formName + " = { &clar_layout_" + poolGet(formRecNameIdx) + ", " + numToStr(nBinds) + ", " + bindsRef + " };"))
    cpUiBuf.add(toText(""))
    return formName
}

// cpEmitWindowDescs prints every window TYPE's widget array + state struct +
// rt_ui_window_desc, in declaration order, into cpUiBuf/cpRecBuf. A form
// window (mac-target-4d Task 7) additionally gets its bind table/form desc
// (cpEmitOneFormDesc) and the window desc's own trailing `form` field,
// appended ONLY when set (irWindowDescFormRecName(i) != -1) -- every
// non-form window's own 11-field literal stays byte-identical to every
// pre-Task-7 golden.
func cpEmitWindowDescs() {
    var i: int
    var name: string
    var widgetsArrName: string
    var nWidgets: int
    var w: int
    var handlersName: string
    var formDescName: string

    i = 0
    while i < irWindowDescs.count {
        name = poolGet(irWindowDescName(i))

        widgetsArrName = "0"
        nWidgets = 0
        w = irWindowDescWidgetsHead(i)
        if w != -1 {
            widgetsArrName = cpEmitWidgetDescArray(name, w)
            while w != -1 {
                nWidgets = nWidgets + 1
                w = irWidgetDescNext(w)
            }
        }

        if irWindowDescStateFieldsHead(i) != -1 {
            cpEmitUiStateStruct(name, irWindowDescStateFieldsHead(i))
        } else {
            // No per-instance vars: a zero-size struct isn't portable C, so
            // a one-byte placeholder stands in -- nothing ever reads it.
            cpRecBuf.add(toText("typedef struct { char clar_ui_unused; } clar_uistate_" + name + ";"))
            cpRecBuf.add(toText(""))
        }

        handlersName = cpEmitWinHandlersFwd(name)
        if handlersName != "0" {
            handlersName = "&" + handlersName
        }

        formDescName = "0"
        if irWindowDescFormRecName(i) != -1 {
            formDescName = "&" + cpEmitOneFormDesc(name, irWindowDescFormRecName(i), irWindowDescFormBindsHead(i))
        }

        cpUiBuf.add(toText("static const rt_ui_window_desc clar_ui_window_" + name + " = {"))
        cpUiBuf.add(toText("    \"" + name + "\", " + cpUiTitleStr(irWindowDescTitle(i)) + ","))
        cpUiBuf.add(toText("    " + numToStr(irWindowDescW(i)) + ", " + numToStr(irWindowDescH(i)) + ", " + cpBoolLit(irWindowDescResizable(i)) + ", " + numToStr(irWindowDescMinW(i)) + ", " + numToStr(irWindowDescMinH(i)) + ","))
        cpUiBuf.add(toText("    " + numToStr(nWidgets) + ", " + widgetsArrName + ","))
        cpUiBuf.add(toText("    (short)sizeof(clar_uistate_" + name + "),"))
        if formDescName == "0" {
            cpUiBuf.add(toText("    " + handlersName))
        } else {
            cpUiBuf.add(toText("    " + handlersName + ","))
            cpUiBuf.add(toText("    " + formDescName))
        }
        cpUiBuf.add(toText("};"))
        cpUiBuf.add(toText(""))
        i = i + 1
    }
}

// cpEmitMenuItemsArray prints one menu's rt_ui_item_desc[] array (Ch9) into
// cpUiBuf, in declaration order (separators occupy a real slot, matching
// lower.cla's uiMenuItemIdx numbering exactly).
func cpEmitMenuItemsArray(menuName: string, headIdx: int): string {
    var name: string
    var it: int

    name = "clar_ui_items_" + menuName
    cpUiBuf.add(toText("static const rt_ui_item_desc " + name + "[] = {"))
    it = headIdx
    while it != -1 {
        if irMenuItemDescIsSeparator(it) {
            cpUiBuf.add(toText("    { 0, 0, 0, 1 },"))
        } else {
            cpUiBuf.add(toText("    { \"" + poolGet(irMenuItemDescName(it)) + "\", " + cpUiCaptionOrNull(irMenuItemDescCaption(it)) + ", " + cpMenuKeyChar(irMenuItemDescKey(it)) + ", 0 },"))
        }
        it = irMenuItemDescNext(it)
    }
    cpUiBuf.add(toText("};"))
    cpUiBuf.add(toText(""))
    return name
}

// cpEmitMenuDescs prints every menu's items array + rt_ui_menu_desc, in
// declaration order, into cpUiBuf. A `standard edit` menu (mac-target-4c
// Task 3) skips the items array entirely -- the runtime builds Undo/Cut/
// Copy/Paste/Clear itself -- and emits the pinned `0, 0, 1` tail instead of
// a real item count/array; every OTHER menu now also gains the trailing
// `standardEdit` field (always 0), since rt_ui_menu_desc (rt_ui.h) gained
// that field for every menu, not just standard-edit ones.
func cpEmitMenuDescs() {
    var i: int
    var name: string
    var itemsName: string
    var nItems: int
    var it: int

    i = 0
    while i < irMenuDescs.count {
        name = poolGet(irMenuDescName(i))
        if irMenuDescIsStandardEdit(i) {
            cpUiBuf.add(toText("static const rt_ui_menu_desc clar_ui_menu_" + name + " = {"))
            cpUiBuf.add(toText("    \"" + name + "\", " + cpUiTitleStr(irMenuDescTitle(i)) + ", 0, 0, 1"))
            cpUiBuf.add(toText("};"))
            cpUiBuf.add(toText(""))
        } else {
            itemsName = cpEmitMenuItemsArray(name, irMenuDescItemsHead(i))
            nItems = 0
            it = irMenuDescItemsHead(i)
            while it != -1 {
                nItems = nItems + 1
                it = irMenuItemDescNext(it)
            }
            cpUiBuf.add(toText("static const rt_ui_menu_desc clar_ui_menu_" + name + " = {"))
            cpUiBuf.add(toText("    \"" + name + "\", " + cpUiTitleStr(irMenuDescTitle(i)) + ", " + numToStr(nItems) + ", " + itemsName + ", 0"))
            cpUiBuf.add(toText("};"))
            cpUiBuf.add(toText(""))
        }
        i = i + 1
    }
}

// cpEmitAppInfo emits the (at most one) `app` section's strong
// rt_ui_app_info definition into cpRestBuf -- NOT cpUiBuf: an `app` section
// is legal (and must still emit) in a non-UI program, unlike everything
// cpEmitUiDescs writes, which is gated on irIsUiProgram(). No-op when the
// program declares no `app` section at all (rt_ui.c's weak default covers
// that case at link time).
func cpEmitAppInfo() {
    var line: text

    if not irHasApp { return }
    // Built as `text` field-by-field, not one `string` concatenation: the
    // four cpUiTitleStr() results plus separators can together exceed 255
    // bytes (an about string alone can run to 255), and `string + string`
    // silently clamps at 255 (rt_str_concat, Ch4) -- exactly the mid-literal
    // C-string truncation this file's `text` convention exists to avoid.
    line = toText("const rt_ui_app_desc rt_ui_app_info = { ")
    line.append(cpUiTitleStr(irAppName))
    line.append(", ")
    line.append(cpUiTitleStr(irAppVersion))
    line.append(", ")
    line.append(cpUiTitleStr(irAppAuthor))
    line.append(", ")
    line.append(cpUiTitleStr(irAppAbout))
    line.append(" };")
    cpRestBuf.add(line)
    if irAppId != -1 {
        // Strong override beside rt_ui_app_info -- overrides Task 1's weak
        // '????' rt_app_creator default (rt.h/rt_mac.c) so saved data files
        // carry this app's own creator. Only emitted when the app section
        // actually declared an id (checkAppDecl requires icon to imply id,
        // but id alone is legal without an icon).
        cpRestBuf.add(toText("const unsigned long rt_app_creator = " + cpAppCreatorHex(irAppId) + "UL; /* '" + poolGet(irAppId) + "' */"))
    }
    cpRestBuf.add(toText(""))
}

// cpAppCreatorHex renders idIdx's 4-character app id (check.cla's
// checkAppId already validated exactly 4 printable ASCII characters) as the
// big-endian hex literal rt_app_creator's strong override needs -- e.g.
// "CBKM" -> "0x43424B4D".
func cpAppCreatorHex(idIdx: int): string {
    var s: string
    var out: string
    var i: int

    s = poolGet(idIdx)
    out = "0x"
    i = 0
    while i < 4 {
        out = out + cpHexByte(int(s[i]))
        i = i + 1
    }
    return out
}

// cpHexByte renders b (0-255) as 2 uppercase hex digits.
func cpHexByte(b: int): string {
    var digits: string
    var out: string

    digits = "0123456789ABCDEF"
    out = ""
    out = out + digits[(b >> 4) & 15]
    out = out + digits[b & 15]
    return out
}

func cpEmitUiDescs() {
    cpEmitWindowDescs()
    cpEmitMenuDescs()
    if irAnyCloseRequestHandler() {
        // Into cpUiBuf, NOT cpEmitUiWiring's cpRestBuf section: a
        // closeRequest handler's own BODY (an ordinary IRFunc, printed by
        // cpEmitFuncs) references this global directly (the lowered
        // `cancel` statement), and cpEmitFuncs's output lands in cpRestBuf
        // strictly AFTER cpUiBuf in the final file -- declaring it any
        // later would be a forward reference the C compiler rejects.
        cpUiBuf.add(toText("static long *clar_ui_cur_cancel;"))
        cpUiBuf.add(toText(""))
    }
}

// irIsUiProgram reports whether this program declares any window, menu, or
// `every` block -- gates every UI-only emission (the #include "rt_ui.h"
// line, cpUiBuf's own blank-line separator, and Task 5's main()/dispatcher
// wiring below), so a UI-free program's output stays byte-for-byte
// unchanged (the differential suite enforces this).
func irIsUiProgram(): bool {
    return irWindowDescs.count > 0 or irMenuDescs.count > 0 or irEveryCount > 0
}

// irAnyCloseRequestHandler reports whether ANY window type registered a
// closeRequest handler -- gates the `clar_ui_cur_cancel` scratch global
// (cpEmitUiWiring): declaring it unconditionally for every UI program would
// be a static file-scope variable no code ever references on a program with
// no closeRequest handler at all, which -Wall's -Wunused-variable flags (a
// NEW warning the gate forbids).
func irAnyCloseRequestHandler(): bool {
    var i: int

    i = 0
    while i < irWinHandlers.count {
        if irWinHandlersCloseRequestFn(i) != -1 {
            return true
        }
        i = i + 1
    }
    return false
}

// cpEmitOneWinEventDispatcher defines (into cpRestBuf) window `winName`'s
// winEvent dispatcher body -- cpEmitWinHandlersFwd already forward-declared
// its prototype into cpUiBuf; this runs AFTER cpEmitFuncs (see
// cpEmitUiWiring) so every clar_fn_ handler-body name it calls is already
// declared. The RTUI_EV_CLOSEREQUEST case sets clar_ui_cur_cancel from `a`
// BEFORE calling in (the ledger's `a = (long)&long cancelFlag` convention);
// RTUI_EV_KEY casts `a` to the handler's own declared `char` param.
func cpEmitOneWinEventDispatcher(winName: string, whIdx: int) {
    if not cpWinHandlersHasWinEvent(whIdx) {
        return
    }
    cpRestBuf.add(toText("static void clar_ui_winevent_" + winName + "(void *inst, short event, long a, long b) {"))
    cpRestBuf.add(toText("    switch (event) {"))
    if irWinHandlersOpenedFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_OPENED: clar_fn_" + poolGet(irWinHandlersOpenedFn(whIdx)) + "(inst); break;"))
    }
    if irWinHandlersCloseRequestFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_CLOSEREQUEST: clar_ui_cur_cancel = (long *)a; clar_fn_" + poolGet(irWinHandlersCloseRequestFn(whIdx)) + "(inst); break;"))
    }
    if irWinHandlersClosedFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_CLOSED: clar_fn_" + poolGet(irWinHandlersClosedFn(whIdx)) + "(inst); break;"))
    }
    if irWinHandlersResizedFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_RESIZED: clar_fn_" + poolGet(irWinHandlersResizedFn(whIdx)) + "(inst); break;"))
    }
    if irWinHandlersKeyFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_KEY: clar_fn_" + poolGet(irWinHandlersKeyFn(whIdx)) + "(inst, (char)a); break;"))
    }
    if irWinHandlersAcceptedFn(whIdx) != -1 {
        // Ch10: `on accepted(b: T)` -- `a` is (long)&<the walker's own
        // validated record>; the handler's own declared param is BY VALUE
        // (cast+deref), never a pointer (rt_ui.h's RTUI_EV_ACCEPTED comment).
        cpRestBuf.add(toText("    case RTUI_EV_ACCEPTED: clar_fn_" + poolGet(irWinHandlersAcceptedFn(whIdx)) + "(inst, *(clar_rec_" + poolGet(irWinHandlersFormRecName(whIdx)) + " *)a); break;"))
    }
    if irWinHandlersCancelledFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_CANCELLED: clar_fn_" + poolGet(irWinHandlersCancelledFn(whIdx)) + "(inst); break;"))
    }
    cpRestBuf.add(toText("    default: break;"))
    cpRestBuf.add(toText("    }"))
    cpRestBuf.add(toText("}"))
    cpRestBuf.add(toText(""))
}

// cpEmitOneWidgetDispatcher defines (into cpRestBuf) window `winName`'s
// widget dispatcher body -- switches on widgetIndex, then on event; each
// widget's calling convention (0 args for button click / check change vs.
// (x, y) cast from a/b for canvas click/drag) is picked by that widget's OWN
// kind (cpWidgetKindForIndex), since RTUI_WEV_CLICK is shared by both
// button.click and canvas.click.
func cpEmitOneWidgetDispatcher(winName: string, whIdx: int) {
    var wEntry: int
    var kind: string
    var idx: int

    if not cpWinHandlersHasWidget(whIdx) {
        return
    }
    cpRestBuf.add(toText("static void clar_ui_widget_" + winName + "(void *inst, short widgetIndex, short event, long a, long b) {"))
    cpRestBuf.add(toText("    switch (widgetIndex) {"))
    wEntry = irWinHandlersWidgetHead(whIdx)
    while wEntry != -1 {
        idx = irWidgetHandlerEntryWidgetIndex(wEntry)
        kind = cpWidgetKindForIndex(winName, idx)
        cpRestBuf.add(toText("    case " + numToStr(idx) + ":"))
        if kind == "canvas" {
            if irWidgetHandlerEntryClickFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_CLICK) clar_fn_" + poolGet(irWidgetHandlerEntryClickFn(wEntry)) + "(inst, (int32_t)a, (int32_t)b);"))
            }
            if irWidgetHandlerEntryDragFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_DRAG) clar_fn_" + poolGet(irWidgetHandlerEntryDragFn(wEntry)) + "(inst, (int32_t)a, (int32_t)b);"))
            }
        } else if kind == "table" {
            // table.select/doubleClick (mac-target-4d Task 5): one-arg
            // handlers, the clicked row index (RTUI_WEV_SELECT/DBLCLICK's
            // `a`) -- same (int32_t)a cast canvas's click/drag already use.
            if irWidgetHandlerEntrySelectFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_SELECT) clar_fn_" + poolGet(irWidgetHandlerEntrySelectFn(wEntry)) + "(inst, (int32_t)a);"))
            }
            if irWidgetHandlerEntryDoubleClickFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_DBLCLICK) clar_fn_" + poolGet(irWidgetHandlerEntryDoubleClickFn(wEntry)) + "(inst, (int32_t)a);"))
            }
        } else {
            // button (click only) / check/field/textview (change only) /
            // field (enter, mac-target-4c Task 2): all zero-param Clarus
            // handlers (Ch8's event table).
            if irWidgetHandlerEntryClickFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_CLICK) clar_fn_" + poolGet(irWidgetHandlerEntryClickFn(wEntry)) + "(inst);"))
            }
            if irWidgetHandlerEntryChangeFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_CHANGE) clar_fn_" + poolGet(irWidgetHandlerEntryChangeFn(wEntry)) + "(inst);"))
            }
            if irWidgetHandlerEntryEnterFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_ENTER) clar_fn_" + poolGet(irWidgetHandlerEntryEnterFn(wEntry)) + "(inst);"))
            }
        }
        cpRestBuf.add(toText("        break;"))
        wEntry = irWidgetHandlerEntryNext(wEntry)
    }
    cpRestBuf.add(toText("    default: break;"))
    cpRestBuf.add(toText("    }"))
    cpRestBuf.add(toText("}"))
    cpRestBuf.add(toText(""))
}

// cpEmitUiDispatchers defines every window type's forward-declared
// dispatcher bodies, in declaration order.
func cpEmitUiDispatchers() {
    var i: int
    var name: string
    var whIdx: int

    i = 0
    while i < irWindowDescs.count {
        name = poolGet(irWindowDescName(i))
        whIdx = cpFindWinHandlers(name)
        if whIdx != -1 {
            cpEmitOneWinEventDispatcher(name, whIdx)
            cpEmitOneWidgetDispatcher(name, whIdx)
        }
        i = i + 1
    }
}

// cpEmitMenuHandlerArray prints the rt_ui_menu_handler[] table (Ch9), in
// declaration order -- referencing clar_fn_ fire functions (already
// declared by cpEmitFuncs, called before this) and window-desc pointers
// (already fully defined earlier in cpUiBuf; a forward-direction reference
// is always fine in C).
func cpEmitMenuHandlerArray() {
    var e: int
    var scopeStr: string

    if irMenuHandlersHead == -1 {
        return
    }
    cpRestBuf.add(toText("static const rt_ui_menu_handler clar_ui_menu_handlers[] = {"))
    e = irMenuHandlersHead
    while e != -1 {
        scopeStr = "0"
        if irMenuHandlerEntryScopeWinType(e) != -1 {
            scopeStr = "&clar_ui_window_" + poolGet(irMenuHandlerEntryScopeWinType(e))
        }
        cpRestBuf.add(toText("    { clar_fn_" + poolGet(irMenuHandlerEntryFuncName(e)) + ", \"" +
            cpEscapeCStr(poolGet(irMenuHandlerEntryMenuName(e))) + "\", \"" +
            cpEscapeCStr(poolGet(irMenuHandlerEntryItemName(e))) + "\", " +
            numToStr(irMenuHandlerEntryMenuIdx(e)) + ", " + numToStr(irMenuHandlerEntryItemIdx(e)) + ", " + scopeStr + " },"))
        e = irMenuHandlerEntryNext(e)
    }
    cpRestBuf.add(toText("};"))
    cpRestBuf.add(toText(""))
}

// cpEmitEveryArray prints the rt_ui_every_desc[] table (Ch7/Ch11), in
// declaration order (the SAME order the `T FIRE every.<n>` trace index
// uses).
func cpEmitEveryArray() {
    var e: int

    if irEveryHead == -1 {
        return
    }
    cpRestBuf.add(toText("static const rt_ui_every_desc clar_ui_every[] = {"))
    e = irEveryHead
    while e != -1 {
        cpRestBuf.add(toText("    { clar_fn_" + poolGet(irEveryEntryFuncName(e)) + ", " + numToStr(irEveryEntryTicks(e)) + " },"))
        e = irEveryEntryNext(e)
    }
    cpRestBuf.add(toText("};"))
    cpRestBuf.add(toText(""))
}

// cpEmitUiWiring emits (into cpRestBuf, called AFTER cpEmitFuncs so every
// clar_fn_ name it references is already declared -- see
// cpEmitOneWinEventDispatcher's header comment): the dispatcher
// definitions, the menu-handler array, and the every array (the
// `clar_ui_cur_cancel` scratch global itself is declared earlier, by
// cpEmitUiDescs -- see that function's header comment for why). A no-op for
// a UI-free program.
func cpEmitUiWiring() {
    if not irIsUiProgram() {
        return
    }
    cpEmitUiDispatchers()
    cpEmitMenuHandlerArray()
    cpEmitEveryArray()
}

// cpEmitGlobalsInit declares every global as a bare (uninitialized-in-C)
// file-scope variable, then defines clar_init_globals, which applies each
// one's default (RecordLayout defaults for a nil-Init Rec; the type's zero/
// empty/fresh-handle value for anything else nil-Init) followed by its
// explicit Init expression, if any, in declaration order -- cprint.go's
// emitGlobalsAndInit. Globals can't be given real C initializers at file
// scope: several of their defaults (clar_new_NAME, rt_list_new, ...) are
// function calls, and C requires file-scope initializers to be constant
// expressions. Right after clar_init_globals, also emits cl_free_globals
// (memory-audit Task 5): the destructor mirror of the init loop above,
// walking the same irGlobals arena and calling cpEmitFree per global --
// EXCEPT a global whose Init expression is a bare reference to another
// global (`var alias: text = g`): Ch3 assigns that global the SAME handle,
// so freeing both would double-free one block; freeing the one it was
// aliased FROM (which every alias ultimately chains back to, since a
// global's own storage is never itself an alias target before it exists)
// already covers it. Literal/constructor/concat inits are always a fresh
// handle, so only this one narrow shape needs the guard.
func cpEmitGlobalsInit() {
    var i: int
    var gt: int
    var initE: int
    var nm: string
    var j: int
    var freeBuf: text
    var aliasOfGlobal: bool
    var fullReplace: bool

    i = 0
    while i < irGlobals.count {
        cpRestBuf.add(toText("static " + cpCType(irGlobalType(i)) + " cv_" + poolGet(irGlobalName(i)) + ";"))
        i = i + 1
    }

    fpReset(1)
    i = 0
    while i < irGlobals.count {
        gt = irGlobalType(i)
        nm = poolGet(irGlobalName(i))
        initE = irGlobalInit(i)
        // A needs-ctor global (Text/List/Map/Rec/Arr) whose Init falls
        // through to the plain `cv_x = fpExpr(initE);` replace below (every
        // case except the KStr and Text<-Str special-cases, which store
        // INTO the default-built handle rather than replacing it) would
        // have cpDefaultInit's fresh handle immediately discarded and
        // orphaned -- a leak cl_free_globals can never reach, since nothing
        // still points to it once overwritten. Skip building it: the bare
        // `static` C global is already zero/NULL, a safe placeholder for
        // the one instant before the real assignment runs right after.
        fullReplace = initE != -1 and irtNeedsCtor(gt) and not (irtKind(gt) == KText and irtKind(irExprType(initE)) == KStr)
        if not fullReplace {
            cpDefaultInit(toText("cv_" + nm), gt, 0, -1)
        }
        if initE != -1 {
            if irtKind(gt) == KStr {
                fpStoreStr(newIRVarRef(irGlobalName(i), true, gt), initE)
            } else if irtKind(gt) == KText and irtKind(irExprType(initE)) == KStr {
                // String -> Text is documented assignability (Ch3); a Text
                // handle and a Str value have no common C representation to
                // plain-assign between, so this goes through rt_text_store
                // like a local var's matching ExprStmt/ITextStore case does
                // (lower.cla's lowStoreStmt) -- globals just never route
                // through that helper.
                fpEmit("rt_text_store(cv_" + nm + ", " + fpStrAddr(initE) + ");")
            } else {
                fpEmit("cv_" + nm + " = " + fpExpr(initE) + ";")
            }
        }
        i = i + 1
    }
    cpRestBuf.add(toText("static void clar_init_globals(void) {"))
    j = 0
    while j < fpBody.count {
        cpRestBuf.add(fpBody[j])
        j = j + 1
    }
    cpRestBuf.add(toText("}"))
    cpRestBuf.add(toText(""))
    // See cpEmitFunc's matching comment: clear fpBody so a program with no
    // functions at all (globals-init is the last fpBody harvest) doesn't
    // leave cv_fpBody aliasing cv_cpRestBuf's just-copied handles at exit.
    fpReset(1)

    freeBuf = ""
    i = 0
    while i < irGlobals.count {
        gt = irGlobalType(i)
        nm = poolGet(irGlobalName(i))
        initE = irGlobalInit(i)
        aliasOfGlobal = false
        if initE != -1 and irExprKind(initE) == EVarRef and irVarRefGlobal(initE) {
            if irtNeedsCtor(gt) {
                aliasOfGlobal = true
            }
        }
        if not aliasOfGlobal {
            cpEmitFree(freeBuf, "cv_" + nm, gt)
        }
        i = i + 1
    }
    cpRestBuf.add(toText("static void cl_free_globals(void) {"))
    cpRestBuf.add(freeBuf)
    cpRestBuf.add(toText("}"))
    cpRestBuf.add(toText(""))
}

// cpEmitStrLits prints the interned string-literal pool as clar_str_255
// constants (cprint.go's emitStrLits). StrConst.Idx indexes this pool.
func cpEmitStrLits() {
    var i: int
    var s: string
    var bytesStr: text
    var j: int

    i = 0
    while i < irStrLits.count {
        s = poolGet(irStrLitPoolIdx(i))
        bytesStr = ""
        j = 0
        while j < s.length {
            if j > 0 {
                bytesStr = bytesStr + ", "
            }
            bytesStr = bytesStr + numToStr(int(s[j]))
            j = j + 1
        }
        cpLitBuf.add("static const clar_str_255 clar_lit_" + numToStr(i) + " = {" + numToStr(s.length) + ", {" + bytesStr + "}};")
        i = i + 1
    }
}

// cpEmitUiMain prints main() for a program declaring any window/menu/every
// (Task 5): rt_args_init/clar_init_globals (same relative order as the
// non-UI path below -- nothing depends on the other), the window-desc and
// menu-desc pointer arrays rt_ui_startup wants, rt_ui_startup itself,
// launch (Ch7: startCLI never fires on the Macintosh, so a UI program's own
// `on App.startCLI` handler, if any, is simply never called here -- dead
// per the reference, not a lowering gap), then rt_ui_launch (mac-target-4c
// Task 5) -- which decides openDocument-vs-startEmpty itself (GetAppFiles/
// AppleEvents on a real build, the scripted `launchdoc` verb under
// RT_MAC_TEST) -- then rt_ui_run (returns on quit).
func cpEmitUiMain() {
    var i: int
    var winsExpr: string
    var winsCount: string
    var menusExpr: string
    var menusCount: string
    var mhExpr: string
    var mhCount: string
    var evExpr: string
    var evCount: string
    var openDocExpr: string
    var startEmptyExpr: string

    winsExpr = "0"
    winsCount = "0"
    if irWindowDescs.count > 0 {
        cpRestBuf.add(toText("static const rt_ui_window_desc *clar_ui_windows[] = {"))
        i = 0
        while i < irWindowDescs.count {
            cpRestBuf.add(toText("    &clar_ui_window_" + poolGet(irWindowDescName(i)) + ","))
            i = i + 1
        }
        cpRestBuf.add(toText("};"))
        cpRestBuf.add(toText(""))
        winsExpr = "clar_ui_windows"
        winsCount = numToStr(irWindowDescs.count)
    }

    menusExpr = "0"
    menusCount = "0"
    if irMenuDescs.count > 0 {
        cpRestBuf.add(toText("static const rt_ui_menu_desc *clar_ui_menus[] = {"))
        i = 0
        while i < irMenuDescs.count {
            cpRestBuf.add(toText("    &clar_ui_menu_" + poolGet(irMenuDescName(i)) + ","))
            i = i + 1
        }
        cpRestBuf.add(toText("};"))
        cpRestBuf.add(toText(""))
        menusExpr = "clar_ui_menus"
        menusCount = numToStr(irMenuDescs.count)
    }

    mhExpr = "0"
    mhCount = "0"
    if irMenuHandlersHead != -1 {
        mhExpr = "clar_ui_menu_handlers"
        mhCount = numToStr(irMenuHandlerCount)
    }

    evExpr = "0"
    evCount = "0"
    if irEveryHead != -1 {
        evExpr = "clar_ui_every"
        evCount = numToStr(irEveryCount)
    }

    // openDocument's handler takes its `path: string` by value (clar_str_255,
    // same convention as every other by-value string param -- see
    // cpFuncProto), but rt_ui_launch's fnptr ABI (rt_ui.h) is pinned to
    // `void (*)(const uint8_t *path255)` so rt_ui.c -- which never sees
    // clar_str_255, a per-program typedef -- can call it without knowing the
    // emitted program's own types. clar_str_255 and a Str255-shaped
    // `path255` buffer are the SAME 256-byte layout (uint8_t len + 255
    // bytes), the same identity every other rt_ui string call site already
    // relies on (e.g. rt_ui_ask_open's `(uint8_t*)&(clar_str_255_var)`), so
    // the wrapper below is a bare reinterpret + by-value call, no copy.
    openDocExpr = "0"
    if irHasOpenDocument {
        cpRestBuf.add(toText("static void clar_ui_opendoc_wrap(const uint8_t *path255) {"))
        cpRestBuf.add(toText("    clar_fn_handler_App_openDocument(*(const clar_str_255 *)path255);"))
        cpRestBuf.add(toText("}"))
        cpRestBuf.add(toText(""))
        openDocExpr = "clar_ui_opendoc_wrap"
    }

    // startEmpty already matches rt_ui_launch's `void (*)(void)` exactly
    // (no params) -- no wrapper needed, the bare function name decays to a
    // pointer like any other C function reference.
    startEmptyExpr = "0"
    if irHasStartEmpty {
        startEmptyExpr = "clar_fn_handler_App_startEmpty"
    }

    cpRestBuf.add(toText("int main(int argc, char **argv) {"))
    cpRestBuf.add(toText("    clar_init_globals();"))
    cpRestBuf.add(toText("    rt_register_cleanup(cl_free_globals);"))
    cpRestBuf.add(toText("    rt_args_init(argc, argv);"))
    cpRestBuf.add(toText("    rt_ui_startup(" + winsExpr + ", " + winsCount + ", " + menusExpr + ", " + menusCount + ", " + mhExpr + ", " + mhCount + ", " + evExpr + ", " + evCount + ");"))
    if irHasLaunch {
        cpRestBuf.add(toText("    clar_fn_handler_App_launch();"))
    }
    cpRestBuf.add(toText("    rt_ui_launch(" + openDocExpr + ", " + startEmptyExpr + ");"))
    cpRestBuf.add(toText("    rt_ui_run();"))
    cpRestBuf.add(toText("    return 0;"))
    cpRestBuf.add(toText("}"))
}

// cpEmitMain prints the fixed entry point (cprint.go's emitMain): init
// globals, stash argv, then launch, then startCLI (else startEmpty) -- for
// a UI program (Task 5), cpEmitUiMain takes over instead, so a UI-free
// program's output stays byte-for-byte unchanged (the differential suite
// enforces this).
func cpEmitMain() {
    if irIsUiProgram() {
        cpEmitUiMain()
        return
    }
    cpRestBuf.add(toText("int main(int argc, char **argv) {"))
    cpRestBuf.add(toText("    clar_init_globals();"))
    cpRestBuf.add(toText("    rt_register_cleanup(cl_free_globals);"))
    cpRestBuf.add(toText("    rt_args_init(argc, argv);"))
    if irHasLaunch {
        cpRestBuf.add(toText("    clar_fn_handler_App_launch();"))
    }
    if irHasStartCLI {
        cpRestBuf.add(toText("    clar_fn_handler_App_startCLI(rt_args_list());"))
    } else if irHasStartEmpty {
        cpRestBuf.add(toText("    clar_fn_handler_App_startEmpty();"))
    }
    cpRestBuf.add(toText("    return 0;"))
    cpRestBuf.add(toText("}"))
}

// ================================================================
// Assembly + output
// ================================================================

func cpResetBuffers() {
    while cpTypeBuf.count > 0 {
        cpTypeBuf.pop()
    }
    while cpLitBuf.count > 0 {
        cpLitBuf.pop()
    }
    while cpRecBuf.count > 0 {
        cpRecBuf.pop()
    }
    while cpUiBuf.count > 0 {
        cpUiBuf.pop()
    }
    while cpRestBuf.count > 0 {
        cpRestBuf.pop()
    }
}

// cpAppendLine appends a `string`-sourced line to out, followed by a single
// LF (byte 10, via char(10) -- never CR/13, and never alert's own newline
// handling). append takes a char directly, unlike `+` concatenation.
func cpAppendLine(out: text, line: string) {
    out.append(line)
    out.append(char(10))
}

// cpAppendTextLine is cpAppendLine for a `text`-sourced line -- one that may
// exceed a `string`'s 255-byte capacity (cpLitBuf's lines). A separate
// function, not an overload: a `text` argument bound to a `string` parameter
// (or vice versa) is either a type error or a lowering gap (see the header
// comment), so each buffer's lines must reach `out.append` through the
// function whose parameter already matches their real type.
func cpAppendTextLine(out: text, line: text) {
    out.append(line)
    out.append(char(10))
}

// cpAppendTextList appends every line of a `list of text` buffer to out
// (cpAppendTextLine per line, in order). Every C-code buffer is `list of
// text` now (see the header comment), so this is the only list appender.
func cpAppendTextList(out: text, buf: list of text) {
    var i: int

    i = 0
    while i < buf.count {
        cpAppendTextLine(out, buf[i])
        i = i + 1
    }
}

// emitProgram renders the whole IR (ir.cla arenas) into one `text` buffer, in
// Emit's fixed assembly order (cprint.go's Emit), and returns it. Same input
// always assembles the same buffers in the same order, so the returned bytes
// are deterministic.
func emitProgram(): text {
    var out: text

    out = ""
    cpResetBuffers()

    cpEnsureStr(255)   // literal pool + every intrinsic string temp use this
    cpRecBuf.add(toText("typedef struct { int32_t code; clar_str_255 message; } clar_rec_Err;"))
    cpRecBuf.add(toText(""))

    cpEmitStrLits()
    cpEmitRecords()
    cpEmitLayouts()
    cpEmitEnums()
    cpEmitUiDescs()
    cpEmitAppInfo()
    cpEmitGlobalsInit()
    cpEmitFuncs()
    cpEmitUiWiring()
    cpEmitMain()

    cpAppendLine(out, "/* Generated by clarus (internal/cprint). Do not edit. */")
    cpAppendLine(out, "#include \"rt.h\"")
    if irIsUiProgram() or irHasApp {
        // Only when the program actually declares a window/menu/every, OR
        // an `app` section -- a UI-free, app-free program's emitted C must
        // stay byte-identical to before this task (the differential suite
        // enforces it). An every-only program (no window/menu at all)
        // still needs rt_ui.h: its main() calls rt_ui_startup/rt_ui_run
        // (Task 5) same as any other UI program. An `app`-only program
        // (Task 2) needs rt_ui.h too, for the rt_ui_app_desc typedef its
        // rt_ui_app_info definition uses -- irIsUiProgram() itself stays
        // untouched: widening THAT would route a CLI program into
        // cpEmitUiMain, the wrong main().
        cpAppendLine(out, "#include \"rt_ui.h\"")
    }
    cpAppendLine(out, "#include <stddef.h> /* NULL, used by rt_text_concat's bstr/btext args */")
    cpAppendLine(out, "")
    cpAppendTextList(out, cpTypeBuf)
    cpAppendLine(out, "")
    cpAppendTextList(out, cpLitBuf)
    cpAppendLine(out, "")
    cpAppendTextList(out, cpRecBuf)
    cpAppendLine(out, "")
    if irIsUiProgram() {
        // Gated exactly like the #include above: a UI-free program's cpUiBuf
        // is always empty, and emitting an unconditional extra blank line
        // here would perturb byte-identical UI-free output.
        cpAppendTextList(out, cpUiBuf)
        cpAppendLine(out, "")
    }
    cpAppendTextList(out, cpRestBuf)

    return out
}

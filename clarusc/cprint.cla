// SPDX-License-Identifier: MIT

// cprint.cla: arena IR (ir.cla) -> one self-contained C99 translation unit
// that #includes "rt.h". A port of the walking-skeleton subset of
// internal/cprint (cprint.go / funcprint.go / intr.go / types.go).
//
// Output channel: emitProgram returns the whole translation unit as one
// `text` buffer (mirrors the Go internal/cprint.Emit, which returns the unit
// as bytes) -- the caller (main.cla) writes it via file.writeText, which is
// byte-faithful and uncapped. Each section still accumulates its lines into a
// buffer as before (cType may append a clar_str_N typedef to cpTypeBuf at any
// point during body printing, the first time an unseen capacity appears, so
// the buffers are assembled fully before any line is appended to the output);
// emitProgram then appends every buffer's lines, each followed by a single LF
// (char(10)), into the returned text in Emit's fixed assembly order.
//
// ALL C-code text in this file is `text`, not `string`: a `string` is capped
// at 255 bytes, and a single emitted C line (a long `and` chain, a deeply
// nested field/index expression, a big arithmetic expression, or a
// string-literal pool line) can run well past that. A `string` would silently
// clamp such a line mid-token before it ever reached the output stage. So the
// four line buffers below are `list of text`, and every C-fragment-producing
// expression helper (fpExpr and friends) returns `text`.
//
// Bridging `string` -> `text` at the leaves: the Go compiler that builds this
// file implements the Ch3 `string` -> `text` widen only at a plain assignment
// (`t = s`) -- a user function call's argument, a function's `return` value,
// and a `list of text`'s pushed element are separate lowering paths that do
// NOT implement it. A `string` handed to a call argument or a `return` fails
// to compile (a visible C type error); a `string` pushed into a `list of
// text` is silently miscopied (a `void*` runtime call the C compiler can't
// check). So wherever a bare `string` (a literal like `"("`, an interned
// `poolGet` name, a `numToStr`/type-name result) must become or join a `text`
// value at one of those boundaries, we bridge explicitly: either a `+` with a
// `text` operand (which yields `text` by the checker's `string + text` rule),
// or the `toText` helper below for a standalone `string`. Fragment values
// flow through `text` end to end, so most concatenations are already `text`;
// toText is needed only for a pure-`string` line/return with no `text`
// operand anywhere in it.
//
// This is a representation change only: toText copies the same bytes, so every
// emitted-C byte is identical to the old `string`-typed path for any program
// whose lines fit in 255 bytes (all existing goldens). The gain is that lines
// which DON'T fit no longer truncate.
//
// This is the Task 3 skeleton: it emits ONLY what the seed program needs
// (clar_str_255, the string-literal pool, the clar_rec_Err typedef, an empty
// clar_init_globals, one void handler Func with an ExprStmt body, and main).
// Every branch a later task fills in is marked "Task 4+".

include "lib.cla"
include "ir.cla"
include "shake.cla"

// ================================================================
// Whole-program buffers (cprint.go's printer struct), assembled in a fixed
// final order. One emitProgram call per process, so these start empty.
// ================================================================

var cpTypeBuf: list of text   // string-capacity (+ array-wrapper, Task 4+) typedefs
var cpLitBuf: list of text    // string-literal pool
var cpRecBuf: list of text    // record structs (seeded with clar_rec_Err) + UI state structs
var cpUiBuf: list of text     // rt_ui_widget_desc/window_desc/item_desc/menu_desc tables (Task 4)
var cpRestBuf: list of text   // globals init, funcs, main

// cpUiPortFlag (Task 5, native-5e) mirrors main.cla's `--uiport` flag
// (set there, right before emitProgram is called) -- gates cpEmitUiBlob's
// `clar_ui_blob[]` + per-window sizeof-assert emission ONLY; every
// pre-existing rt_ui_*_desc table cpEmitUiDescs prints stays unconditional
// (Task 11 is the flip that retires them), so every existing
// testdata/emitui/*.c.golden -- emitted with this flag absent -- stays
// byte-identical regardless of this task's changes.
var cpUiPortFlag: bool

// cpCorePorted (Plan native-5d Task 3) is core.cla's own ported-module
// flag -- UNCONDITIONAL like cpStrPorted/cpTextPorted/cpListPorted/
// cpMapPorted (main.cla sets it true directly, right alongside the
// manifest decision, same convention), since core.cla is now spliced
// FIRST and every other unconditional module (str/text/list/map) calls
// its rtSetLastErr/rtPanic directly. Gates the array-bounds-check
// redirect (fpIndexRef's Arr arm) and the fixed-point redirect
// (IFixMul/IFixDiv). lastError itself (ILastErrCode/ILastErrMsg/ILastErr)
// is UNGATED again as of Task 12.5 -- it always reads the raw C
// rt_lasterr_code/rt_lasterr_msg globals directly, same as before Task 3's
// short-lived Clarus-side redirect (see core.cla's file header for why
// that redirect broke the native UI event loop's own rt_set_lasterr
// writes).
var cpCorePorted: bool

// cpSerPorted (Plan 5b Task 7) is the ported-module flag the file.save/
// file.load redirect keys on: main.cla sets it (directly -- no setter
// function, same convention as check.cla's usesFileSaveLoad global) to
// exactly usesFileSaveLoad's value right where it decides whether to pull
// in runtime/clarus/ser.cla, so it's always correct per-program even
// across the differential/selfhost harness's many-compiles-per-process
// runs. Tasks 8-11 add one analogous bool per ported family (str/text/
// list/map) the same way.
var cpSerPorted: bool

// cpStrPorted (Plan 5b Task 8) is str.cla's own analogous flag -- UNLIKE
// cpSerPorted, main.cla sets this unconditionally true (str.cla is an
// unconditional manifest entry: every emitted program includes it, since
// every program uses strings), still set directly per-program the same
// way, so a stale value can never leak across the differential/selfhost
// harness's many-compiles-per-process runs.
var cpStrPorted: bool

// cpTextPorted (Plan 5b Task 9) is text.cla's own analogous flag -- same
// "unconditional manifest entry, set true directly alongside the decision"
// convention cpStrPorted established: every emitted program includes
// text.cla (Ch3's Text type is built in), so this is always true, never
// gated by a usage flag.
var cpTextPorted: bool

// cpListPorted (Plan 5b Task 10) is list.cla's own analogous flag -- same
// "unconditional manifest entry, set true directly alongside the decision"
// convention cpStrPorted/cpTextPorted established: every emitted program
// includes list.cla (Ch5's List type is built in), so this is always true,
// never gated by a usage flag.
var cpListPorted: bool

// cpMapPorted (Plan 5b Task 11) is map.cla's own analogous flag -- same
// "unconditional manifest entry, set true directly alongside the decision"
// convention cpStrPorted/cpTextPorted/cpListPorted established: every
// emitted program includes map.cla (Ch5's Map type is built in), so this
// is always true, never gated by a usage flag.
var cpMapPorted: bool

// cpTextArcPorted (Plan 5c wave2a Task 2) redirects Text's own retain/
// release/free traffic to the Clarus-ported rtTextRetain/rtTextRelease
// (text.cla), a SEPARATE flag from cpTextPorted above: cpTextPorted (wave1,
// Task 9) redirected Text's DATA operations (concat/store/index/...);
// cpTextArcPorted redirects ARC (retain/release/dispose) once text.cla
// grows those functions too (wave2a). Same "unconditional, set true
// directly alongside the decision" convention as every other *Ported flag
// -- text.cla is always in the manifest, so this is always true, never
// gated by a usage flag. List/Map get their own analogous flags
// (cpListArcPorted/cpMapArcPorted) in this wave's later tasks.
var cpTextArcPorted: bool

// cpListArcPorted (Plan 5c wave2a Task 3) redirects List's own retain/
// release/free/lastref traffic to the Clarus-ported rtListRetain/
// rtListRelease/rtListLastref (list.cla), a SEPARATE flag from cpListPorted
// above: cpListPorted (wave1, Task 10) redirected List's DATA operations
// (push/pop/first/last/remove/count/...); cpListArcPorted redirects ARC
// (retain/release/dispose/lastref) once list.cla grows those functions too
// (wave2a). Same "unconditional, set true directly alongside the decision"
// convention as cpTextArcPorted -- list.cla is always in the manifest, so
// this is always true, never gated by a usage flag. This task ALSO adds a
// new rtListAt (list.cla) for the walk-INTERNAL element-accessor calls
// inside cpEmitRelease/cpEmitRetain's own List ARC element loops -- that
// one is gated by the EXISTING cpListPorted flag instead (it's a plain
// interior-pointer accessor, not itself an ARC operation), while the four
// pure ADDRESSING sites elsewhere in this file (fpIndexRef, fpForListStmt,
// IListSet, IListRemove) keep emitting a bare `rt_list_at` call regardless
// of either flag -- see fpIndexRef's own doc comment. Map gets its own
// analogous flag (cpMapArcPorted) in this wave's next task.
var cpListArcPorted: bool

// cpMapArcPorted (Plan 5c wave2a Task 4) redirects Map's own retain/
// release/free/lastref traffic to the Clarus-ported rtMapRetain/
// rtMapRelease/rtMapLastref (map.cla), a SEPARATE flag from cpMapPorted
// above: cpMapPorted (wave1, Task 11) redirected Map's DATA operations
// (set/get/has/remove/count/...); cpMapArcPorted redirects ARC (retain/
// release/dispose/lastref) once map.cla grows those functions too
// (wave2a). Same "unconditional, set true directly alongside the decision"
// convention as cpTextArcPorted/cpListArcPorted -- map.cla is always in the
// manifest, so this is always true, never gated by a usage flag. Unlike
// List's own Task 3 (which needed a fresh rtListAt for its walk-internal
// element accessor), Map's walk-internal `rt_map_val_at`/`rt_map_count`
// calls (inside cpEmitRelease's own element-release loop) already existed
// from wave1 (fpForMapStmt's own `for k, v in m` loop already used them) --
// this task routes those two through the EXISTING cpMapPorted flag
// instead, leaving cpMapArcPorted scoped purely to retain/release/lastref
// (map.cla's own module header documents the full split).
var cpMapArcPorted: bool

// toText copies a `string` into a fresh `text` value. Used to bridge a bare
// `string` (a fixed C-boilerplate line, or a pure-`string` fragment/return)
// across a call-argument / return / list-push boundary, where the Go compiler
// building this file does NOT widen `string` -> `text` on its own (see the
// header comment). `var t: text = ""` is the supported Text-from-Str init;
// `t.append(s)` is rt_text_append_str.
func toText(s: string): text {
    var t: text = ""
    t.append(s)
    return t
}

// toStr (ARC Task 7) narrows a `text` back down to a `string` -- the
// reverse direction toText bridges, needed because cpEmitRetain/
// cpEmitRelease's cexpr parameter is (deliberately, matching every one of
// their OTHER existing callers, which all naturally produce `string`
// concatenations) `string`-typed, but fpRetainVal/fpReleaseVal's own KArr
// arm (and fpIntrCall's IRetain/IRelease KArr arm) only ever has a `text`
// C-expression string on hand (fpAddrable/fpCopyToTemp both return
// `text`). Str<->Text has no built-in narrowing conversion or assignment
// (verified: `var s: string; s = someTextVar` is a compile error, same as
// passing text where a string param is declared) -- the toBytes/fromBytes
// byte-buffer round trip is this language's only sanctioned Text->Str
// path (the same idiom used throughout this REPO's own corpus fixtures,
// e.g. arc_global_alias.cla), applied here to clarusc's own internal
// C-expression-as-text values rather than to a user program's data. 255
// bytes covers any C lvalue expression this compiler ever builds (a bare
// name, a field-select chain, a loop-index array subscript) with room to
// spare.
func toStr(t: text): string {
    var buf: char[255]
    var n: int
    var s: string

    n = t.toBytes(buf)
    s.fromBytes(buf, n)
    return s
}

// cpStrCapsEmitted keys the string capacities already emitted into cpTypeBuf
// (keyed by numToStr(n)); each clar_str_N typedef is emitted once.
var cpStrCapsEmitted: map of int

// cpArrEmitted keys the clar_arr_<elem>_<N> wrapper typedefs already
// emitted into cpRecBuf (keyed by the wrapper's own type name), so each
// distinct array shape is emitted once.
var cpArrEmitted: map of int

// cpLoopN counts default-init loop variable names (cpDefaultInit's Arr
// case) -- cprint.go's printer.loopN.
var cpLoopN: int

// ================================================================
// funcPrinter (funcprint.go): one function body's lines, temp counter, and
// indent. Modeled as module state -- one function is printed at a time and
// printing is not reentrant in the skeleton.
// ================================================================

var fpBody: list of text
var fpTmpN: int
var fpIndent: int

// fpStmtTmps names the rt_text* temps fpNewTmp has created since the
// current fpStmt began (memory-audit Task 6) -- fpStmt save/swaps this
// module list around each (re-entrant) statement it prints, the same
// pattern fpCaptureExpr (:404) uses for fpBody, so a nested statement
// (SIf/SWhile/... body, via fpStmts) tracks and frees its OWN temps without
// disturbing the enclosing statement's list. fpCaptureExpr itself does NOT
// swap this list (unlike fpBody): fpAndOr (:428) instead marks fpStmtTmps'
// count before capturing and frees/untracks anything past that mark itself,
// from INSIDE the `if` block it generates, before that block closes -- a
// temp born there is declared inside that same block (fpNewTmp still emits
// via fpEmit, into whatever fpBody currently is), so it must not be
// referenced (by a deferred free) after the block's closing brace.
var fpStmtTmps: list of text

// fpStmtTmpRel is fpStmtTmps' parallel list: the release call (bare
// function name, e.g. "rt_text_release") for the entry at the same index
// (ARC Task 3). Text-only in memory-audit Task 6; widened here so the same
// tracker can own List/Map temps too (a call result, or a first/last/
// map-get/map-getDefault alias read) -- every push/remove/pop of
// fpStmtTmps below has a matching push/remove/pop here, kept in lockstep.
var fpStmtTmpRel: list of text

// fpStmtTmpIsRec is fpStmtTmps' second parallel list (ARC Task 7): true
// when the entry at the same index is a KRec temp, whose release call
// needs `&(name)` (fpStmtTmpRel[i] holds "clar_release_NAME" for these,
// vs. a plain rt_*_release stem for everything else) -- fpFreeStmtTmps/
// fpAndOr's flush consult this to pick the right call shape. Kept in
// lockstep with fpStmtTmps/fpStmtTmpRel everywhere those are pushed/
// removed/popped, same discipline ARC Task 3 established when it added
// fpStmtTmpRel itself.
var fpStmtTmpIsRec: list of bool

// fpStmtTmpType is fpStmtTmps' third parallel list (ARC fixwave Critical 1,
// bug 2): the temp's own IR type, at the same index as its name/stem/isRec
// entry. fpEmitTmpRelease consults it to route a List/Map (or Arr) temp's
// release through cpEmitRelease's deep, lastref-gated element walk instead
// of a bare stem call -- the same fix IRetain/IRelease's own printer arm
// above got for bug 1, needed here too since a tracked container temp
// (a discarded call result, or the not-handed-off temp behind `a =
// makeList()`) is a second, independently-reachable site that used to skip
// the element walk. fpStmtTmpRel[i]'s stem is no longer read for a
// List/Map/Arr entry once this lands (cpEmitRelease derives the right
// function names itself from the type); still populated for these same as
// before, to keep the other three lists' population logic untouched. Kept
// in lockstep with fpStmtTmps/fpStmtTmpRel/fpStmtTmpIsRec everywhere those
// are pushed/removed/popped/saved-and-swapped.
var fpStmtTmpType: list of int

// fpDiscardExprIdx (ARC Task 8 review round 2) is the IR arena index of the
// exact expression node fpStmt's own SExprStmt case is about to print as a
// bare, DISCARDED statement (`lst.pop();`, result used nowhere) -- or -1
// when no such statement is in flight. Set immediately before, and cleared
// immediately after, that ONE `fpExpr` call (fpStmt's SExprStmt branch) --
// arena indices are monotonic and never reused (same invariant
// lowRetTempN/lowStoreTempN rely on, lower.cla), so a STALE value could
// never accidentally match a later node even without the explicit clear;
// cleared anyway for hygiene. Consulted by exactly one site so far
// (fpIntrCall's IListPop/IListShift branch): `x == fpDiscardExprIdx`
// is true ONLY when x is that exact top-level node, never a NESTED one
// (e.g. `f(lst.pop())`'s inner pop -- a different arena index than the
// outer ECallFn node fpDiscardExprIdx would hold for that statement), so a
// call-argument/assign-dst/return position is never mistaken for a
// discarded one.
var fpDiscardExprIdx: int

func fpReset(indent: int) {
    while fpBody.count > 0 {
        fpBody.pop()
    }
    while fpStmtTmps.count > 0 {
        fpStmtTmps.pop()
    }
    while fpStmtTmpRel.count > 0 {
        fpStmtTmpRel.pop()
    }
    while fpStmtTmpIsRec.count > 0 {
        fpStmtTmpIsRec.pop()
    }
    while fpStmtTmpType.count > 0 {
        fpStmtTmpType.pop()
    }
    fpTmpN = 0
    fpIndent = indent
    fpDiscardExprIdx = -1
}

// fpEmit appends one indented body line (4 spaces per indent level). `line`
// is `text`: an emitted C line can exceed a `string`'s 255-byte cap. `pad`
// is `text` too, so `pad + line` is `text` and lands in fpBody (list of
// text) without a truncating re-clamp. Callers with a pure-`string` line
// (no `text` operand) bridge it via toText -- else the `string` -> `text`
// call-argument mismatch fails to compile (a deliberate loud guard).
func fpEmit(line: text) {
    var pad: text
    var i: int

    pad = ""
    i = 0
    while i < fpIndent {
        pad = pad + "    "
        i = i + 1
    }
    fpBody.add(pad + line)
}

// fpNewTmp declares a fresh `ctype tN;` at the current position and returns
// its name (funcprint.go's newTmp). The counter is monotonic within a
// function and never reset mid-function -- load-bearing for later bootstrap
// determinism.
//
// A `rt_text *` temp is special-cased (memory-audit Task 6): NULL-initialized
// (rt_text_free is NULL-safe, rt_core.inc -- load-bearing for a temp born
// inside an `and`/`or`'s conditionally-executed captured branch, fpAndOr
// :428, whose construction can be skipped by short-circuiting) and tracked
// in fpStmtTmps for a later free (fpStmt's end-of-statement flush, or
// fpAndOr's own in-block flush for a captured-branch temp).
//
// NOT widened to `rt_list *`/`rt_map *` here (ARC Task 3): those ctypes are
// ALSO used for plain borrowed aliases (fpForListStmt/fpForMapStmt's own
// loop-list handle, never an owned reference), so ctype string alone can't
// tell an owned temp from a borrow. A List/Map temp that IS owned (a call
// result, a first/last/map-get/map-getDefault read) goes through
// fpNewTrackedTmp instead, which tracks explicitly rather than by sniffing
// the ctype string.
func fpNewTmp(ctype: string): text {
    var name: text

    fpTmpN = fpTmpN + 1
    name = "t" + numToStr(fpTmpN)
    if ctype == "rt_text *" {
        fpEmit(ctype + " " + name + " = NULL;")
        fpStmtTmps.add(name)
        // Plan 5c wave2a Task 2: this temp's own end-of-statement release
        // (fpEmitTmpRelease) composes `<this stem>(<name>);` verbatim -- no
        // (void*) cast wrapper here (unlike every fpEmit-composed
        // cpTextArcPorted call site elsewhere), since a bare
        // `rt_text *`-typed name needs none to reach clar_fn_rtTextRelease's
        // `void *` parameter (implicit pointer conversion, no warning,
        // same as passing any object pointer to a void* parameter).
        if cpTextArcPorted {
            fpStmtTmpRel.add(toText("clar_fn_rtTextRelease"))
        } else {
            fpStmtTmpRel.add(toText("rt_text_release"))
        }
        fpStmtTmpIsRec.add(false)
        fpStmtTmpType.add(irTextT)
    } else {
        fpEmit(ctype + " " + name + ";")
    }
    return name
}

// fpIsBareTempName reports whether e is EXACTLY a scratch temp's own C name
// (fpNewTmp's convention above: "t" followed by one or more digits, nothing
// else) -- used by fpStmt's SExprStmt arm (ARC fix-wave Task 3, Part D) to
// tell "this discarded statement's C text is a lone temp name" (which cc
// -Wall flags "expression result unused") apart from "this discarded
// statement's C text is a call expression" (which cc never warns on, and
// which must print unchanged to keep every emitui .c.golden byte-identical).
func fpIsBareTempName(e: text): bool {
    var i: int

    if e.length < 2 or e[0] != 't' {
        return false
    }
    i = 1
    while i < e.length {
        if e[i] < '0' or e[i] > '9' {
            return false
        }
        i = i + 1
    }
    return true
}

// fpHeapFn names the rt_* stem ("rt_text"/"rt_list"/"rt_map") for a heap IR
// kind -- ARC Task 3. Compose with "_retain"/"_release" at the call site
// (mirrors fpIntrCall's own IRetain/IRelease dispatch's KText/KList/KMap
// arm below, but is needed here too: the printer inserts retain calls
// directly at a few intrinsic print sites below, not via the IRetain IR
// node).
func fpHeapFn(k: IRKind): string {
    if k == KList {
        return "rt_list"
    } else if k == KMap {
        return "rt_map"
    }
    return "rt_text"
}

// fpNeedsRelease (ARC Task 7) reports whether a value of IR type t needs
// ANY retain/release traffic at all -- fpIsHandleType (Text/List/Map)
// widened to also cover a handle-backed record (irRecHasHandleField,
// ir.cla's shared gate-asymmetry-proof test) or a fixed array whose
// element does (recursing exactly like lowIsRecBearing, lower.cla's own
// mirror of this same question at lowering time). Used at every
// container-element site whose PRINT-TIME gate previously only ever
// needed to ask "is this Text/List/Map" (IListRemove, IMapRemove/
// fpMapReleaseGuard) -- these have no lower.cla-side birth decision to
// make (a removal/eviction always releases the OLD value, never retains a
// new one), so the ONLY thing that changed for Task 7 is that a
// record-bearing element type must also be recognized here.
func fpNeedsRelease(t: int): bool {
    var k: IRKind

    k = irtKind(t)
    if k == KRec {
        return irRecHasHandleField(irtName(t))
    }
    if k == KArr {
        return fpNeedsRelease(irtElem(t))
    }
    return fpIsHandleType(t)
}

// fpRetainVal / fpReleaseVal (ARC Task 7) retain/release a single,
// already-materialized C value expression v at IR type t -- the shared
// dispatcher every container-element retain/release print site now uses
// instead of hand-rolling `fpHeapFn(...) + "_retain(" + v + ");"` (which
// only ever knew about Text/List/Map: KRec's clar_retain_NAME/
// clar_release_NAME calls need `&(v)`, not a bare `v`, and a bare KRec
// argument to fpHeapFn silently defaulted to the WRONG "rt_text" stem).
// Mirrors fpIntrCall's own IRetain/IRelease KRec/KText/KList/KMap dispatch
// exactly (same marking, same call shape) plus a KArr arm fpIntrCall's own
// dispatch also needs (ARC Task 7 site 7, added there too) -- reusing
// cpEmitRetain/cpEmitRelease's own already-correct recursive per-element
// walk via the same caller-owned-buffer trick cpEmitGlobalsInit's Init-
// retain-fix (ARC Task 6 round 2) established, rather than duplicating
// that recursion here.
func fpRetainVal(v: text, t: int) {
    var k: IRKind
    var recName: string
    var buf: text

    k = irtKind(t)
    if k == KRec {
        if not irRecHasHandleField(irtName(t)) {
            return
        }
        recName = poolGet(irtName(t))
        irMarkRcWalkNeeded(irtName(t))
        fpEmit("clar_retain_" + recName + "(&(" + v + "));")
    } else if k == KArr {
        buf = ""
        cpEmitRetain(buf, toStr(v), t)
        fpEmit(buf)
    } else if k == KText and cpTextArcPorted {
        // Plan 5c wave2a Task 2: redirect the KText case of the plain-bump
        // fallback below to the Clarus-ported rtTextRetain, same (void*)
        // cast convention as every other cpTextArcPorted call site. KList/
        // KMap get their own analogous branches just below (Tasks 3/4).
        fpEmit("clar_fn_rtTextRetain((void*)" + v + ");")
    } else if k == KList and cpListArcPorted {
        // Plan 5c wave2a Task 3: same redirect, for KList.
        fpEmit("clar_fn_rtListRetain((void*)" + v + ");")
    } else if k == KMap and cpMapArcPorted {
        // Plan 5c wave2a Task 4: same redirect, for KMap.
        fpEmit("clar_fn_rtMapRetain((void*)" + v + ");")
    } else {
        fpEmit(fpHeapFn(k) + "_retain(" + v + ");")
    }
}

func fpReleaseVal(v: text, t: int) {
    var k: IRKind
    var recName: string
    var buf: text

    k = irtKind(t)
    if k == KRec {
        if not irRecHasHandleField(irtName(t)) {
            return
        }
        recName = poolGet(irtName(t))
        irMarkRcWalkNeeded(irtName(t))
        fpEmit("clar_release_" + recName + "(&(" + v + "));")
    } else if k == KArr or k == KList or k == KMap {
        // KList/KMap (fix-wave parked finding): a nested container
        // element/value (`map of list of text`, `list of list of text`, ...)
        // needs the SAME lastref-gated deep element walk KArr already gets
        // here -- a bare rt_list_release/rt_map_release only drops the
        // evicted container's own handle, leaking whatever it holds. Every
        // fpReleaseVal caller is an eviction site (fpMapReleaseGuard's
        // map upsert/remove guard, IListRemove, IListSet/IListSetRetain's
        // old-value release) where the container being released is a VALUE
        // already read out of its parent, not itself a live IR expression
        // -- exactly what cpEmitRelease's caller-owned-buffer trick is for.
        // KText has no elements to walk, so it keeps the bare call below.
        buf = ""
        cpEmitRelease(buf, toStr(v), t)
        fpEmit(buf)
    } else if k == KText and cpTextArcPorted {
        // Plan 5c wave2a Task 2: the only kind that still reaches here is
        // KText (KRec/KArr/KList/KMap all handled above) -- redirect to the
        // Clarus-ported rtTextRelease, same (void*) cast convention as
        // every other cpTextArcPorted call site.
        fpEmit("clar_fn_rtTextRelease((void*)" + v + ");")
    } else {
        fpEmit(fpHeapFn(k) + "_release(" + v + ");")
    }
}

// fpNewTrackedTmp declares a fresh temp of IR type t and tracks it in
// fpStmtTmps/fpStmtTmpRel(/fpStmtTmpIsRec) for release at end of statement
// unless handed off -- ARC Task 3's explicit-tracking counterpart to
// fpNewTmp's ctype-string sniffing, safe to use for List/Map (or Text)
// results that are genuinely owned (a call result, a first/last/map-get/
// map-getDefault alias read -- all +1 now, same ownership shape as a text
// concat temp). ARC Task 7 site 3: also safe for a handle-backed KRec
// result (a user function call's +1-transferred return, fpCallFn below) --
// a record is a by-value C STRUCT, not a nullable pointer, so it declares
// with NO initializer (never `= NULL`, which wouldn't compile) instead of
// the pointer kinds' `= NULL`; fpStmtTmpIsRec records which release shape
// (`fn(name)` vs `clar_release_NAME(&(name))`) fpFreeStmtTmps/fpAndOr's
// flush must print for this entry. Every existing caller only ever reads
// the temp back out AFTER first assigning into it (fpCallFn's very next
// line), so leaving a record temp's C declaration uninitialized is safe --
// nothing reads it before that assignment.
func fpNewTrackedTmp(t: int): text {
    var name: text
    var ctype: string
    var isRec: bool

    ctype = cpCType(t)
    fpTmpN = fpTmpN + 1
    name = "t" + numToStr(fpTmpN)
    isRec = irtKind(t) == KRec
    if isRec {
        fpEmit(ctype + " " + name + ";")
        fpStmtTmpRel.add(toText("clar_release_" + poolGet(irtName(t))))
        irMarkRcWalkNeeded(irtName(t))
    } else {
        fpEmit(ctype + " " + name + " = NULL;")
        // Plan 5c wave2a Task 2/3/4: same stem-storage gate as fpNewTmp
        // above -- KText/KList/KMap all redirect to their own Clarus-ported
        // release now that map.cla grows rtMapRelease too.
        if irtKind(t) == KText and cpTextArcPorted {
            fpStmtTmpRel.add(toText("clar_fn_rtTextRelease"))
        } else if irtKind(t) == KList and cpListArcPorted {
            fpStmtTmpRel.add(toText("clar_fn_rtListRelease"))
        } else if irtKind(t) == KMap and cpMapArcPorted {
            fpStmtTmpRel.add(toText("clar_fn_rtMapRelease"))
        } else {
            fpStmtTmpRel.add(toText(fpHeapFn(irtKind(t)) + "_release"))
        }
    }
    fpStmtTmps.add(name)
    fpStmtTmpIsRec.add(isRec)
    fpStmtTmpType.add(t)
    return name
}

// fpHandoff marks a tracked temp as having escaped the current statement --
// its ownership moved into a variable, a return value, or a list/map
// element -- so fpStmt's end-of-statement release must skip it
// (memory-audit Task 6; widened to List/Map temps by ARC Task 3). ARC Task
// 8 removed the ONE other historical category (a user-function CALL
// argument, fpCallFn) -- see that function's own doc comment for why: it
// was the one handoff site that could permanently orphan a birth-classified
// temp (nothing ever claimed ownership going forward), unlike every
// remaining call site here, each of which hands the temp to a
// PROVABLE new owner (a named slot, a return, or a container element that
// the store itself just retained-unless-birth into). A no-op unless cexpr
// is EXACTLY a name currently in fpStmtTmps: a temp's own bare name is only
// ever printed as itself (fpTextConcat et al. return the raw temp name), so
// an exact match can only mean "this IS that temp," never an expression
// that merely mentions it.
func fpHandoff(cexpr: text) {
    var i: int

    i = 0
    while i < fpStmtTmps.count {
        if fpStmtTmps[i] == cexpr {
            fpStmtTmps.remove(i)
            fpStmtTmpRel.remove(i)
            fpStmtTmpIsRec.remove(i)
            fpStmtTmpType.remove(i)
            return
        }
        i = i + 1
    }
}

// fpEmitTmpRelease (ARC Task 7; widened by ARC fixwave Critical 1 bug 2)
// prints tracked-temp i's own release call. A KRec temp's clar_release_NAME
// still needs `&(name)` (it takes a pointer), fpStmtTmpIsRec[i] selects that
// shape unchanged. Otherwise dispatches on the temp's own IR type
// (fpStmtTmpType[i]): a List/Map/Arr temp now routes through
// cpEmitRelease's deep, lastref-gated element walk (same caller-owned-
// buffer trick used elsewhere in this file) instead of a bare stem call --
// a bare `rt_list_release`/`rt_map_release` skipped releasing the
// container's own elements entirely, leaking them whenever a tracked
// container temp (a discarded call result, or the temp behind `a =
// makeList()` before hand-off) was the reference that actually dropped the
// container to zero. A Text temp (or anything else) still prints its bare
// stem's plain `fn(name)` call, unchanged from before this task --
// cpEmitRelease's own KText branch would print byte-identical C anyway, not
// worth the churn. Shared by fpFreeStmtTmps and fpAndOr's own in-block
// flush (below) -- previously each hand-rolled the same
// `fpStmtTmpRel[i] + "(" + fpStmtTmps[i] + ");"` line inline.
func fpEmitTmpRelease(i: int) {
    var k: IRKind
    var buf: text

    if fpStmtTmpIsRec[i] {
        fpEmit(fpStmtTmpRel[i] + "(&(" + fpStmtTmps[i] + "));")
        return
    }
    k = irtKind(fpStmtTmpType[i])
    if k == KList or k == KMap or k == KArr {
        buf = ""
        cpEmitRelease(buf, toStr(fpStmtTmps[i]), fpStmtTmpType[i])
        fpEmit(buf)
    } else {
        fpEmit(fpStmtTmpRel[i] + "(" + fpStmtTmps[i] + ");")
    }
}

// fpFreeStmtTmps emits the release call for every name still in fpStmtTmps
// (memory-audit Task 6's `rt_text_free`, upgraded by ARC Task 3 to each
// entry's own tracked release call -- fpStmtTmpRel -- so List/Map temps
// release correctly too; ARC Task 7 widens it again to KRec via
// fpEmitTmpRelease) and empties all four lists. Called at the tail of
// fpStmt (the common case: temps live for the whole statement) and, by
// fpWhileStmt, right after the per-iteration condition check (a text temp a
// while-condition creates is rebuilt fresh every iteration -- see
// fpWhileStmt's own comment -- so it must be freed there, not hoisted out
// past the loop).
func fpFreeStmtTmps() {
    var i: int

    i = 0
    while i < fpStmtTmps.count {
        fpEmitTmpRelease(i)
        i = i + 1
    }
    while fpStmtTmps.count > 0 {
        fpStmtTmps.pop()
    }
    while fpStmtTmpRel.count > 0 {
        fpStmtTmpRel.pop()
    }
    while fpStmtTmpIsRec.count > 0 {
        fpStmtTmpIsRec.pop()
    }
    while fpStmtTmpType.count > 0 {
        fpStmtTmpType.pop()
    }
}

// ================================================================
// Type printing (types.go subset)
// ================================================================

// cpCTypeName is the pure C type name for an IR type index (no side effects).
func cpCTypeName(t: int): string {
    switch irtKind(t) {
    case KVoid { return "void" }
    case KInt { return "int32_t" }
    case KBool { return "int32_t" }
    case KFixed { return "int32_t" }
    case KEnum { return "int32_t" }
    case KChar { return "uint8_t" }
    case KStr { return "clar_str_" + numToStr(irtN(t)) }
    case KText { return "rt_text *" }
    case KList { return "rt_list *" }
    case KMap { return "rt_map *" }
    case KRec { return "clar_rec_" + poolGet(irtName(t)) }
    case KErr { return "clar_rec_Err" }
    case KArr { return "clar_arr_" + cpArrKey(t) }
    case KWinRef { return "void *" }
    case KPtr { return "void *" }
    case KOverlay { return "clar_rec_" + poolGet(irtName(t)) + " *" }
    case KWord { return "short" }
    }
    return "void"
}

// cpArrKey names one Arr type's wrapper typedef, distinct per (element
// shape, length) pair -- a pure function of t, no side effects (types.go's
// arrKey).
func cpArrKey(t: int): string {
    return cpElemKey(irtElem(t)) + "_" + numToStr(irtN(t))
}

// cpElemKey renders t as an identifier fragment, for composing cpArrKey --
// a full port of types.go's elemKey.
func cpElemKey(t: int): string {
    switch irtKind(t) {
    case KInt { return "int" }
    case KBool { return "bool" }
    case KFixed { return "fixed" }
    case KChar { return "char" }
    case KStr { return "str" + numToStr(irtN(t)) }
    case KText { return "text" }
    case KList { return "list" }
    case KMap { return "map" }
    case KRec { return "rec_" + poolGet(irtName(t)) }
    case KEnum { return "enum_" + poolGet(irtName(t)) }
    case KErr { return "err" }
    case KArr { return "arr_" + cpArrKey(t) }
    }
    return "unsupported"
}

// cpEnsureStr emits the clar_str_N capacity typedef into cpTypeBuf once.
func cpEnsureStr(n: int) {
    var key: string

    key = numToStr(n)
    if cpStrCapsEmitted.has(key) {
        return
    }
    cpStrCapsEmitted[key] = 1
    cpTypeBuf.add(toText("typedef struct { uint8_t len; uint8_t b[" + key + "]; } clar_str_" + key + ";"))
}

// cpEnsureType lazily emits whatever typedef(s) t depends on (types.go's
// ensureType). Rec/Enum are emitted in declaration order elsewhere (Task 4+).
func cpEnsureType(t: int) {
    var k: IRKind

    k = irtKind(t)
    if k == KStr {
        cpEnsureStr(irtN(t))
    } else if k == KList {
        cpEnsureType(irtElem(t))
    } else if k == KMap {
        cpEnsureType(irtElem(t))
    } else if k == KArr {
        cpEnsureArr(t)
    }
}

// cpEnsureArr lazily emits t's clar_arr_<elem>_<N> wrapper typedef, first
// ensuring its element type's own typedef (if any) -- types.go's ensureArr.
// Written into cpRecBuf (like Go's recBuf): an array of records (Task 6+)
// needs that record's struct already defined, which only exists in
// cpRecBuf; a scalar/Str element has no such requirement but cpRecBuf works
// fine for it too.
func cpEnsureArr(t: int): string {
    var name: string

    name = cpCTypeName(t)
    if cpArrEmitted.has(name) {
        return name
    }
    cpArrEmitted[name] = 1
    cpEnsureType(irtElem(t))
    cpRecBuf.add(toText("typedef struct { " + cpCTypeName(irtElem(t)) + " e[" + numToStr(irtN(t)) + "]; } " + name + ";"))
    return name
}

// cpCType returns t's C type name, first emitting any typedef it depends on.
func cpCType(t: int): string {
    cpEnsureType(t)
    return cpCTypeName(t)
}

// cpTypeEqual is a pure structural comparison of two IR types (kind,
// capacity/length, record/enum name, and -- recursively -- element type),
// with no side effects -- types.go's typeEqual. Needed because ir.cla's
// arena interns every IRType afresh (two structurally-identical types built
// at different call sites get different indices), unlike Go's ir.Type,
// which is a plain comparable-by-field struct.
func cpTypeEqual(a: int, b: int): bool {
    if irtKind(a) != irtKind(b) or irtN(a) != irtN(b) or irtName(a) != irtName(b) {
        return false
    }
    if (irtElem(a) == -1) != (irtElem(b) == -1) {
        return false
    }
    if irtElem(a) != -1 {
        return cpTypeEqual(irtElem(a), irtElem(b))
    }
    return true
}

// ================================================================
// Expression + statement printing (funcprint.go / intr.go subset)
// ================================================================

func fpExpr(e: int): text {
    switch irExprKind(e) {
    case EIntConst {
        return toText(numToStr(irIntConstV(e)))
    }
    case EStrConst {
        return toText("clar_lit_" + numToStr(irStrConstIdx(e)))
    }
    case EVarRef {
        return toText("cv_" + poolGet(irVarRefName(e)))
    }
    case EBin {
        return fpBin(e)
    }
    case EUn {
        return fpUn(e)
    }
    case EConv {
        return fpConv(e)
    }
    case EIntr {
        return fpIntrCall(e)
    }
    case EIndexRef {
        return fpIndexRef(e)
    }
    case EFieldRef {
        return fpFieldRef(e)
    }
    case ENewRec {
        return toText("clar_new_" + poolGet(irNewRecName(e)) + "()")
    }
    case ECallFn {
        return fpCallFn(e)
    }
    case ECallExt {
        return fpCallExt(e)
    }
    }
    return toText("")
}

// fpIsHandleType reports whether t is a reference-semantics (handle-backed)
// type -- Text, List, or Map (memory-audit Task 6).
func fpIsHandleType(t: int): bool {
    var k: IRKind

    k = irtKind(t)
    return k == KText or k == KList or k == KMap
}

// fpCallFn renders a user function call `clar_fn_NAME(args...)` (funcprint.go's
// callFn). Args were already coerced against the callee's param types at lower
// time (lowCallArgs); each is printed left-to-right so any temp an arg needs
// lands in evaluation order.
//
// ARC Task 8 (printer tracker simplification): a handle-typed (text/list/
// map) argument is printed via plain fpExpr, same as any other expression --
// NO fpHandoff here anymore. The old memory-audit Task 6 handoff (untrack a
// tracked-temp argument so it's never auto-released, "conservative: a callee
// that does NOT retain it leaks that allocation instead") predates ARC's
// retain-on-store guarantee and is now simply wrong, not just conservative:
// it permanently orphaned any BIRTH-classified argument (a Str->Text
// widening, a nested call/method-call result passed straight through --
// e.g. `f(g())`) that no NAMED slot anywhere ever owns, since a scalar
// handle-typed PARAMETER is a pure borrow in the callee (never added to
// lowFreeNames, never released there either) -- a real, permanent leak
// (reproduced in isolation by widen_text.cla's two call-argument widening
// sites, closed by this change). Removing the handoff is sound precisely
// BECAUSE of the property that makes the rest of this task's deletions
// sound: if the callee stores the argument into any of its own persistent
// slots, that store is itself one of ARC's counted-store funnels and
// retains independently -- so letting fpStmt's ordinary end-of-statement
// flush (fpFreeStmtTmps) release a tracked-temp argument, same as any other
// unclaimed tracked temp, can only ever balance an already-existing +1
// (correct either way: the callee's own store already retained its own
// copy, or it didn't and this was the only reference). A BARE-VARIABLE
// argument (`f(myVar)`) was never affected by the old handoff either way --
// fpExpr for a plain EVarRef returns "cv_myVar" directly, never a name
// fpStmtTmps tracks, so fpHandoff was always a no-op for it; myVar's true
// owner keeps releasing it at ITS OWN scope exit regardless, unchanged.
// (A handle-backed RECORD argument already worked this way before this
// task -- fpIsHandleType never covered KRec, so a record call-result
// argument was never handed off here in the first place; this change just
// makes text/list/map match that already-correct, already-symmetric
// behavior.)
//
// ARC Task 3: the RETURN value is now a +1-transfer (lower.cla's lowReturn
// retains every heap-typed return before handing it back), so the OLD
// "never materialize -- can't tell alias from allocation" carve-out is gone:
// the callee's retain already answered that question for us. A heap-typed
// result is always materialized into a tracked temp (fpNewTrackedTmp), so
// fpStmt's end-of-statement flush releases it -- UNLESS this call sits
// directly as an SAssign dst's RHS or an SReturn's value (those sites' own
// fpHandoff call untracks it: the +1 becomes the slot's ownership / the
// return's own transfer). `pop`/`shift` stay a plain transfer with no
// retain (see IListPop/IListShift below) -- unaffected by this convention.
func fpCallFn(e: int): text {
    var args: text
    var a: int
    var first: bool
    var argText: text
    var call: text
    var t: text

    args = ""
    first = true
    a = irCallFnArgsHead(e)
    while a != -1 {
        if not first {
            args = args + ", "
        }
        first = false
        argText = fpExpr(a)
        args = args + argText
        a = irExprNext(a)
    }
    call = "clar_fn_" + poolGet(irCallFnName(e)) + "(" + args + ")"
    // ARC Task 7 site 3 (caller side): a handle-backed record return is
    // ALSO always materialized into a tracked temp now (lower.cla's
    // lowReturn already made every one of these a genuine +1 transfer),
    // released at end of statement unless handed off -- extends the same
    // Task 3 convention fpIsHandleType's Text/List/Map already get. An
    // all-scalar record return (irRecHasHandleField false) has nothing to
    // retain/release either side of the call, so it stays the OLD
    // untracked-call-expression path, unchanged.
    if fpIsHandleType(irExprType(e)) or (irtKind(irExprType(e)) == KRec and irRecHasHandleField(irtName(irExprType(e)))) {
        t = fpNewTrackedTmp(irExprType(e))
        fpEmit(t + " = " + call + ";")
        return t
    }
    return call
}

// fpCallExt renders a call to an `external func` as `rt_ext_NAME(args...)`
// (Task 3, Ch13: `external func`) -- mirrors fpCallFn exactly, save for the
// symbol prefix; the tracked-temp materialization guard is kept for
// structural parity even though it can never fire here in practice (an
// external's return type is restricted to int/ptr/bool/char at check time
// -- check.cla's checkExternFunc -- never a handle-backed Text/List/Map/Rec).
// A KStr-typed argument marshals through fpStrAddr (Plan 5b Task 3), the
// same "&(<addrable e>)" cast the builtin-call path already uses, since the
// matching extern param prints as `const uint8_t *` (cpEmitExternProtos);
// every other argument -- including KText, which is already a `rt_text *`
// pointer -- passes through as the plain expression, unchanged from before.
func fpCallExt(e: int): text {
    var args: text
    var a: int
    var first: bool
    var argText: text
    var call: text
    var t: text
    var synthName: int

    args = ""
    first = true
    a = irCallExtArgsHead(e)
    while a != -1 {
        if not first {
            args = args + ", "
        }
        first = false
        if irtKind(irExprType(a)) == KStr {
            argText = fpStrAddr(a)
        } else {
            argText = fpExpr(a)
        }
        args = args + argText
        a = irExprNext(a)
    }
    // native-5e Task 6: under --uiport, ui.cla's reverse-waist externs
    // (Task 7+) resolve to lower.cla's synthesized clar_ui_fire_* IRFuncs
    // (called directly, no rt_ext_ shim exists for them) rather than the
    // ordinary host-symbol path below -- lowUiSynthExternName is the ONE
    // place (per the plan's reverse-waist section) that owns the name
    // mapping. The synthesized IRFuncs are ORDINARY functions (the whole
    // point -- no per-backend dispatcher emission), so the call still goes
    // through the SAME "clar_fn_" symbol convention every other function
    // call does (the `nat_<Name>` extern-fallback precedent, cg68k.cla's
    // cgCallExtNatFallback, resolves the exact same way: an ordinary
    // function, called by its ordinary name). UiProgDesc is a special case
    // (not a synthesized FUNCTION at all -- see ir.cla's own doc comment on
    // why): it resolves straight to the blob's own address, never a call.
    if cpUiPortFlag and poolGet(irCallExtName(e)) == "UiProgDesc" {
        call = "(&clar_ui_blob[0])"
    } else {
        synthName = -1
        if cpUiPortFlag {
            synthName = lowUiSynthExternName(irCallExtName(e))
        }
        if synthName != -1 {
            call = "clar_fn_" + poolGet(synthName) + "(" + args + ")"
        } else {
            call = "rt_ext_" + poolGet(irCallExtName(e)) + "(" + args + ")"
        }
    }
    if fpIsHandleType(irExprType(e)) or (irtKind(irExprType(e)) == KRec and irRecHasHandleField(irtName(irExprType(e)))) {
        t = fpNewTrackedTmp(irExprType(e))
        fpEmit(t + " = " + call + ";")
        return t
    }
    return call
}

// fpFieldRef prints an EFieldRef node (funcprint.go's expr's *ir.FieldRef
// case). An Err-typed receiver's fields are named "code"/"message" directly,
// no cv_ prefix (see emitProgram's clar_rec_Err typedef) -- unlike a user
// record's clar_rec_NAME fields, which always carry the cv_ prefix.
func fpFieldRef(e: int): text {
    if irtKind(irExprType(irFieldRefX(e))) == KErr {
        return "(" + fpExpr(irFieldRefX(e)) + ")." + poolGet(irFieldRefName(e))
    }
    if irtKind(irExprType(irFieldRefX(e))) == KOverlay {
        // An overlay value IS a C pointer (cpCTypeName's KOverlay case), so
        // its field access is `->`, not `.` -- unlike KRec, which is a
        // by-value struct.
        return "(" + fpExpr(irFieldRefX(e)) + ")->cv_" + poolGet(irFieldRefName(e))
    }
    return "(" + fpExpr(irFieldRefX(e)) + ").cv_" + poolGet(irFieldRefName(e))
}

// fpIndexRef implements the ir.IndexRef printer contract for Arr (a
// bounds-checked plain C array access) and List (a bounds-checked
// rt_list_at call, sharing this same node -- see ir.IndexRef's doc comment
// in ir.go) -- a port of funcprint.go's indexRef.
//
// Plan 5c wave2a Task 3: this List branch's own bare `rt_list_at` call, plus
// the other three pure ADDRESSING sites in this file -- fpForListStmt's
// per-iteration deref, IListRemove's old-value read, and IListSet's
// interior-pointer ref -- all stay bare C regardless of cpListPorted/
// cpListArcPorted, UNLIKE the walk-INTERNAL `rt_list_at`/`rt_list_count`
// calls inside cpEmitRelease/cpEmitRetain's own List ARC element loops
// (this task's clar_fn_rtListAt/clar_fn_rtListCount redirect, gated by
// cpListPorted there). These four read/write an INTERIOR pointer straight
// into a list's backing store from user-level indexing/iteration/mutation
// code, never through a Clarus-callable wrapper -- flagged here as 5d
// (codegen68k) input: whoever designs that direct-to-68k-object backend
// will need dedicated addressing-mode codegen for exactly these four
// shapes, not a plain function call the way every other redirected site in
// this file becomes.
func fpIndexRef(e: int): text {
    var xt: int

    xt = irExprType(irIndexRefX(e))
    if irtKind(xt) == KArr {
        // Plan native-5d Task 3: cpCorePorted redirects the bounds-check
        // call itself (core.cla's rtArrCheck), same "gate the callee, not
        // the addressing shape" convention as every other cp*Ported
        // redirect in this function.
        if cpCorePorted {
            return "(" + fpExpr(irIndexRefX(e)) + ").e[clar_fn_rtArrCheck((int32_t)(" + fpExpr(irIndexRefI(e)) + "), " + numToStr(irtN(xt)) + ")]"
        }
        return "(" + fpExpr(irIndexRefX(e)) + ").e[rt_arr_check((int32_t)(" + fpExpr(irIndexRefI(e)) + "), " + numToStr(irtN(xt)) + ")]"
    } else if irtKind(xt) == KList {
        return "(*(" + cpCType(irExprType(e)) + "*)rt_list_at(" + fpExpr(irIndexRefX(e)) + ", (int32_t)(" + fpExpr(irIndexRefI(e)) + ")))"
    }
    return toText("")
}

// cOp maps a Bin/Un op string to its C spelling (funcprint.go's cOp):
// and/or short-circuit as &&/||, mod as %, everything else (+ - * / & | ^
// << >> == != < <= > >=) passes straight through.
func cOp(op: string): string {
    if op == "and" {
        return "&&"
    } else if op == "or" {
        return "||"
    } else if op == "mod" {
        return "%"
    }
    return op
}

// fpBin prints an EBin node: and/or route to fpAndOr (short-circuit); ptr +
// int / ptr - int (Task 2, Ch13) casts through `char *` so the C `+`/`-`
// advances by 1-byte units rather than whatever `void *` arithmetic a
// compiler extension might otherwise apply; every other operator
// (arithmetic, bitwise, comparison) prints as a plain `(x op y)` via cOp --
// funcprint.go's expr's *ir.Bin case.
func fpBin(e: int): text {
    var op: string

    op = poolGet(irBinOp(e))
    if op == "and" or op == "or" {
        return fpAndOr(e)
    }
    if irtKind(irExprType(e)) == KPtr and (op == "+" or op == "-") {
        return "(void *)((char *)(" + fpExpr(irBinX(e)) + ") " + op + " (" + fpExpr(irBinY(e)) + "))"
    }
    return "(" + fpExpr(irBinX(e)) + " " + cOp(op) + " " + fpExpr(irBinY(e)) + ")"
}

// FpCapture is fpCaptureExpr's return value: the statements it would have
// emitted (joined in order, each already indented one level deeper -- the
// level fpAndOr's guarded `if` body will land at) and e's own value
// expression -- funcprint.go's captureExpr returns (stmts, value string);
// Clarus has no tuple return, so this record serves the same purpose.
record FpCapture {
    stmts: list of text
    value: text
}

// fpCaptureExpr prints e one indent level deeper than fp's current level
// (matching where it would land if fpAndOr decides to nest it inside a new
// `if`), returning any statements it emitted separately from its value
// expression -- a port of funcprint.go's captureExpr. fpBody is swapped out
// for a fresh (empty) list for the duration of the call so e's statements
// land in the returned capture, not the caller's in-progress body; `list of
// T`'s reference semantics (Ch3: Value and Reference Semantics) make this a
// cheap pointer swap, not a copy.
func fpCaptureExpr(e: int): FpCapture {
    var saved: list of text
    var fresh: list of text
    var cap: FpCapture

    saved = fpBody
    fpBody = fresh
    fpIndent = fpIndent + 1
    cap.value = fpExpr(e)
    fpIndent = fpIndent - 1
    cap.stmts = fpBody
    fpBody = saved
    return cap
}

// fpAndOr prints `and`/`or`, preserving short-circuit evaluation even when
// the right operand needs statement-level temps of its own -- a port of
// funcprint.go's andOr. The left operand always evaluates, printed in place
// like any other operand; the right operand is speculatively captured first
// (fpCaptureExpr): if it produced no statements, the simple case (both
// sides pure) stays a plain C &&/|| -- no churn. If it did produce
// statements, they're moved inside an `if`, guarded by the already-
// evaluated left operand, so they run only when short-circuiting wouldn't
// skip them.
//
// memory-audit Task 6: a text temp the captured right operand creates is
// declared (via fpNewTmp, inside cap.stmts) INSIDE the `if` block below, so
// it must be freed there too, before the block closes -- fpStmt's generic
// end-of-statement free runs after this whole expression (and the `if`
// statement it's a condition of) is long done, which would reference an
// identifier out of scope. markCount notes fpStmtTmps' depth before the
// capture (excluding x's own temps, already at the enclosing scope and safe
// to defer); anything past that mark once the capture returns was created
// during it and is freed here, from innermost/last-created outward, so a
// nested `and`/`or` (recursing into fpAndOr again during the very same
// capture) has already flushed its own deeper temps by the time this level
// checks its own mark.
func fpAndOr(e: int): text {
    var x: text
    var op: string
    var cap: FpCapture
    var t: text
    var cond: text
    var i: int
    var markCount: int

    x = fpExpr(irBinX(e))
    op = poolGet(irBinOp(e))
    markCount = fpStmtTmps.count
    cap = fpCaptureExpr(irBinY(e))
    if cap.stmts.count == 0 {
        return "(" + x + " " + cOp(op) + " " + cap.value + ")"
    }

    t = fpNewTmp(cpCType(irExprType(e)))
    fpEmit(t + " = " + x + ";")
    cond = t
    if op == "or" {
        cond = "!" + t
    }
    fpEmit("if (" + cond + ") {")
    fpIndent = fpIndent + 1
    i = 0
    while i < cap.stmts.count {
        fpBody.add(cap.stmts[i])
        i = i + 1
    }
    fpEmit(t + " = " + cap.value + ";")
    while fpStmtTmps.count > markCount {
        fpEmitTmpRelease(fpStmtTmps.count - 1)
        fpStmtTmps.pop()
        fpStmtTmpRel.pop()
        fpStmtTmpIsRec.pop()
        fpStmtTmpType.pop()
    }
    fpIndent = fpIndent - 1
    fpEmit(toText("}"))
    return t
}

// fpUn prints an EUn node (funcprint.go's un).
func fpUn(e: int): text {
    var x: text
    var op: string

    x = fpExpr(irUnX(e))
    op = poolGet(irUnOp(e))
    if op == "-" {
        return "(-(" + x + "))"
    } else if op == "not" {
        return "(!(" + x + "))"
    } else if op == "~" {
        return "(~(" + x + "))"
    }
    return toText("")
}

// fpConv prints an EConv node (funcprint.go's conv). IntToFixed/FixedToInt
// avoid a raw `<<`/plain arithmetic-shift on a possibly-negative value by
// multiplying/dividing by 65536 instead; C99 integer division truncates
// toward zero, exactly Ch3's "int(f) ... truncates toward zero".
func fpConv(e: int): text {
    var x: text
    var op: IRConvOp
    var n: int

    x = fpExpr(irConvX(e))
    op = irConvOp(e)
    if op == CvIntToFixed {
        return "((int32_t)((int64_t)(" + x + ") * 65536))"
    } else if op == CvFixedToInt {
        return "((int32_t)((" + x + ") / 65536))"
    } else if op == CvIntToChar {
        return "((uint8_t)(" + x + "))"
    } else if op == CvCharToInt or op == CvEnumToInt {
        return "((int32_t)(" + x + "))"
    } else if op == CvIntToEnum {
        n = cpEnumCount(irConvEnumName(e))
        return "rt_enum_from_int(clar_enum_" + poolGet(irConvEnumName(e)) + ", " + numToStr(n) + ", (" + x + "))"
    } else if op == CvIntToPtr {
        return "(void *)(intptr_t)(" + x + ")"
    } else if op == CvPtrToInt {
        return "((int32_t)(intptr_t)(" + x + "))"
    } else if op == CvPtrToOverlay {
        return "((clar_rec_" + poolGet(irtName(irExprType(e))) + " *)(" + x + "))"
    } else if op == CvOverlayToPtr {
        return "((void *)(" + x + "))"
    }
    return toText("")
}

// cpEnumCount returns the member count of the enum named nameIdx (an
// interned pool index), by walking irEnums -- funcprint.go's enumCount.
func cpEnumCount(nameIdx: int): int {
    var i: int
    var m: int
    var count: int

    i = 0
    while i < irEnums.count {
        if irEnumLayoutName(i) == nameIdx {
            count = 0
            m = irEnumLayoutMembersHead(i)
            while m != -1 {
                count = count + 1
                m = irEnumMemberNext(m)
            }
            return count
        }
        i = i + 1
    }
    log("cprint: unknown enum " + poolGet(nameIdx))
    quit 1
    return 0
}

// fpAddrable returns a C expression for e that is safe to take the address
// of (funcprint.go's addrable). VarRef/FieldRef/IndexRef print to C
// lvalues, StrConst to a named static, Intr's value-producing cases already
// materialize into a named temp -- none of these need a further copy;
// anything else (a Bin/Un/Conv/CallFn/NewRec result) is first copied into a
// fresh temp of its own type via fpCopyToTemp.
func fpAddrable(e: int): text {
    var k: IRExprKind

    k = irExprKind(e)
    if k == EVarRef or k == EFieldRef or k == EIndexRef or k == EStrConst or k == EIntr {
        return fpExpr(e)
    }
    return fpCopyToTemp(e)
}

// fpCopyToTemp unconditionally materializes e's value into a fresh
// statement-level temp and returns the temp's name -- never the "already an
// lvalue, print as-is" shortcut fpAddrable takes for a VarRef/FieldRef/
// IndexRef/StrConst/Intr. Used for the *value* argument of every
// list/map-growing intrinsic (Task 6+'s list_push, list_unshift, map_set):
// those can realloc their target's backing store mid-call, so if the value
// argument were instead a raw rt_list_at/rt_map-derived pointer, the
// realloc could free that pointer's block before the call's own memmove
// reads it -- an ASan-confirmed use-after-free (funcprint.go's copyToTemp).
func fpCopyToTemp(e: int): text {
    var v: text
    var t: text

    v = fpExpr(e)
    // If evaluating e itself produced a tracked text temp (e.g. e is a
    // concat), `t = v;` below is a pointer copy, not a fresh allocation
    // (Ch3: text has reference semantics) -- v and t now alias the SAME
    // object. Untrack v here so only t (below) represents that object going
    // forward; the caller decides t's fate (memory-audit Task 6).
    fpHandoff(v)
    t = fpNewTmp(cpCType(irExprType(e)))
    fpEmit(t + " = " + v + ";")
    return t
}

// fpStrAddr renders `(const uint8_t*)&(<addrable e>)` (funcprint.go's strAddr).
func fpStrAddr(e: int): text {
    return "(const uint8_t*)&(" + fpAddrable(e) + ")"
}

// fpTextCmp handles text/text, text/string, and string/text comparisons
// (intr.go's textCmp). rt_text_cmp_str only knows (text, string); a string
// on the left needs the call flipped and its sign negated to preserve
// `a < b` orientation. Plan 5b Task 9: once text.cla is included
// (unconditionally, cpTextPorted mirrors that decision exactly, same
// convention as cpStrPorted), redirects to clar_fn_rtTextCmp/
// clar_fn_rtTextCmpStr -- both take `ptr` params, so every KText/KStr
// argument gets an explicit `(void*)` wrap (same discipline Task 8's
// str.cla redirects established, verified zero-warning at bootstrap).
func fpTextCmp(a: int, b: int): text {
    var atk: IRKind
    var btk: IRKind

    atk = irtKind(irExprType(a))
    btk = irtKind(irExprType(b))
    if atk == KText and btk == KText {
        if cpTextPorted {
            return "clar_fn_rtTextCmp((void*)" + fpExpr(a) + ", (void*)" + fpExpr(b) + ")"
        }
        return "rt_text_cmp(" + fpExpr(a) + ", " + fpExpr(b) + ")"
    } else if atk == KText and btk == KStr {
        if cpTextPorted {
            return "clar_fn_rtTextCmpStr((void*)" + fpExpr(a) + ", (void*)" + fpStrAddr(b) + ")"
        }
        return "rt_text_cmp_str(" + fpExpr(a) + ", " + fpStrAddr(b) + ")"
    }
    // atk == KStr and btk == KText: lowComparison only ever calls ITextCmp
    // when at least one side is Text, so this is the only remaining combo.
    if cpTextPorted {
        return "(-clar_fn_rtTextCmpStr((void*)" + fpExpr(b) + ", (void*)" + fpStrAddr(a) + "))"
    }
    return "(-rt_text_cmp_str(" + fpExpr(b) + ", " + fpStrAddr(a) + "))"
}

// fpTextConcat allocates a fresh rt_text handle for the `text + (text|
// string)` result (text has reference semantics, but `+` always produces a
// new value), then concatenates a and b into it (intr.go's textConcat).
// Plan 5b Task 9: cpTextPorted redirects both the birth call (rtTextNew,
// cast back to `rt_text *` since the ported function returns a bare `ptr`)
// and the concat call (rtTextConcat's bstr/btext params are ptr -- NULL
// becomes the explicit `(void*)0`, matching the brief's "NULL as ptr(0)"
// signature note).
func fpTextConcat(a: int, b: int): text {
    var ae: text
    var t: text

    ae = fpExpr(a)
    t = fpNewTmp("rt_text *")
    if cpTextPorted {
        fpEmit(t + " = (rt_text *)clar_fn_rtTextNew();")
        if irtKind(irExprType(b)) == KStr {
            fpEmit("clar_fn_rtTextConcat((void*)" + t + ", (void*)" + ae + ", (void*)" + fpStrAddr(b) + ", (void*)0);")
        } else {
            fpEmit("clar_fn_rtTextConcat((void*)" + t + ", (void*)" + ae + ", (void*)0, (void*)" + fpExpr(b) + ");")
        }
    } else {
        fpEmit(t + " = rt_text_new();")
        if irtKind(irExprType(b)) == KStr {
            fpEmit("rt_text_concat(" + t + ", " + ae + ", " + fpStrAddr(b) + ", NULL);")
        } else {
            fpEmit("rt_text_concat(" + t + ", " + ae + ", NULL, " + fpExpr(b) + ");")
        }
    }
    return t
}

// fpMapReleaseGuard emits `if (rt_map_has(m, k)) { <ctype> old; rt_map_get(m,
// k, &old); <release old, via fpReleaseVal>; }` -- the ARC Task 5 guard
// (ARC Task 7: release dispatch widened to fpReleaseVal, covering a
// handle-backed record value type too) shared by
// IMapSet(Retain) (an upsert must release whatever value k currently holds
// before overwriting it) and IMapRemove (same, before removing the entry).
// rt_map_get PANICS on an absent key (rt.h: "panics absent: map key not
// found"), so the release only happens when rt_map_has confirms presence --
// a fresh key's upsert (nothing to release) and remove's own documented
// "silently succeeds if absent" (language reference) both fall through the
// guard's false branch as a no-op either way.
//
// m/k are ALREADY-COMPUTED C expression strings (fpExpr(a0)/fpStrAddr(a1)),
// never raw IR nodes -- callers compute them exactly ONCE and pass the
// resulting text here, so a side-effecting key expression (e.g.
// `m[f()] = v`) is never re-evaluated by the has-check, the get, AND the
// caller's own later set/remove call: reusing an already-printed STRING in
// multiple fpEmit lines is safe (no re-execution), unlike calling fpExpr/
// fpStrAddr on the SAME IR node a second time (which WOULD re-run the
// underlying C computation -- see ARC Task 4's Bug 1).
//
// The guard's own read is a raw `rt_map_get`, deliberately NOT the existing
// IMapGet intrinsic (which always retains its result into a tracked temp,
// per ARC Task 3): reusing IMapGet here would retain then immediately
// release the SAME value, netting to a no-op instead of the intended -1 --
// a silent leak (the evicted old value never actually gets released),
// caught only by a `.leaks` count staying nonzero when it should hit zero,
// not by any crash.
func fpMapReleaseGuard(m: text, k: text, elemT: int) {
    var ctype: string
    var old: text

    ctype = cpCType(elemT)
    old = fpNewTmp(ctype)
    fpHandoff(old) // this guard's own explicit release below is old's only release
    // Plan 5b Task 11: cpMapPorted redirects the has/get calls the guard
    // itself emits below (has/get are ported). fpReleaseVal's own release
    // call just below dispatches on elemT's OWN kind (Plan 5c wave2a Tasks
    // 2-4: KText/KList/KMap each redirect to their own Clarus-ported
    // release once cpTextArcPorted/cpListArcPorted/cpMapArcPorted; a
    // KMap-typed value in particular now routes through fpReleaseVal's
    // KArr/KList/KMap branch into cpEmitRelease's own KMap arm, which THIS
    // task ports -- no separate edit needed in this guard itself for that
    // case) -- this guard releases the evicted VALUE, not the map, so which
    // path fires depends entirely on the map's OWN value type, elemT.
    if cpMapPorted {
        fpEmit("if (clar_fn_rtMapHas((void*)" + m + ", (void*)" + k + ")) {")
        fpIndent = fpIndent + 1
        fpEmit("clar_fn_rtMapGet((void*)" + m + ", (void*)" + k + ", (void*)&" + old + ");")
    } else {
        fpEmit("if (rt_map_has(" + m + ", " + k + ")) {")
        fpIndent = fpIndent + 1
        fpEmit("rt_map_get(" + m + ", " + k + ", &" + old + ");")
    }
    fpReleaseVal(old, elemT) // ARC Task 7: elemT may now be a handle-backed record too.
    fpIndent = fpIndent - 1
    fpEmit(toText("}"))
}

// fpArgAt walks n steps down an Intr's argument chain from head (via
// irExprNext) and returns the expr index found there -- for the UI canvas
// intrinsics below, whose fixed positional argument count (inst, widget
// index, then each Ch11 method's own 2-4 geometry args, an optional trailing
// fill flag) runs past the a0/a1/a2 prelude every other fpIntrCall case gets
// by default.
func fpArgAt(head: int, n: int): int {
    var cur: int
    var i: int

    cur = head
    i = 0
    while i < n {
        cur = irExprNext(cur)
        i = i + 1
    }
    return cur
}

// fpIntrCall prints one Intr call (intr.go). Every rt_* function whose
// result comes back through an out-parameter (concat, text concat, ...) is
// materialized into a fresh statement-level temp here and its name
// returned; pure value-returning rt_* calls (len, cmp, index_of, ...) are
// embedded directly with no temp, since C already lets them nest safely.
// Void operations (alert, quit, set_index, append, ...) emit their call as
// a statement and return "" -- see fpStmt's SExprStmt case, the only
// context they appear in.
func fpIntrCall(x: int): text {
    var nm: int
    var a0: int
    var a1: int
    var a2: int
    var t: text
    var s0: text
    var s1: text
    var cap0: int
    var cap1: int
    var l: text
    var v: text
    var fn: string
    var m: text
    var k: text
    var dv: text
    var winName: string
    var inst: text
    var fld: int
    var dataT: int
    var dataKind: IRKind
    var recName: string
    var container: string
    var dataExpr: text
    var freeVarBuf: text
    var argT: int
    var argK: IRKind
    var elemT: int
    var ctype: string
    var old: text
    var ref: text

    nm = irIntrName(x)
    a0 = irIntrArgsHead(x)
    if a0 != -1 {
        a1 = irExprNext(a0)
    }
    if a1 != -1 {
        a2 = irExprNext(a1)
    }

    if nm == IAlert() {
        fpEmit("rt_alert(" + fpStrAddr(a0) + ");")
        return toText("")
    } else if nm == ILog() {
        fpEmit("rt_log(" + fpStrAddr(a0) + ");")
        return toText("")

    // ---- peek/poke (Plan 5a Task 4, Ch13) ----
    } else if nm == IPeekB() {
        return "rt_peekb(" + fpExpr(a0) + ")"
    } else if nm == IPeekW() {
        return "rt_peekw(" + fpExpr(a0) + ")"
    } else if nm == IPeekL() {
        return "rt_peekl(" + fpExpr(a0) + ")"
    } else if nm == IPokeB() {
        fpEmit("rt_pokeb(" + fpExpr(a0) + ", " + fpExpr(a1) + ");")
        return toText("")
    } else if nm == IPokeW() {
        fpEmit("rt_pokew(" + fpExpr(a0) + ", " + fpExpr(a1) + ");")
        return toText("")
    } else if nm == IPokeL() {
        fpEmit("rt_pokel(" + fpExpr(a0) + ", " + fpExpr(a1) + ");")
        return toText("")
    } else if nm == IQuit() {
        fpEmit("rt_quit((int32_t)(" + fpExpr(a0) + "));")
        return toText("")
    } else if nm == IFixMul() {
        // Plan native-5d Task 3: cpCorePorted redirects to core.cla's
        // rtFixMul, a bit-exact port of rt_fix_mul.
        if cpCorePorted {
            return "clar_fn_rtFixMul((int32_t)(" + fpExpr(a0) + "), (int32_t)(" + fpExpr(a1) + "))"
        }
        return "rt_fix_mul((int32_t)(" + fpExpr(a0) + "), (int32_t)(" + fpExpr(a1) + "))"
    } else if nm == IFixDiv() {
        if cpCorePorted {
            return "clar_fn_rtFixDiv((int32_t)(" + fpExpr(a0) + "), (int32_t)(" + fpExpr(a1) + "))"
        }
        return "rt_fix_div((int32_t)(" + fpExpr(a0) + "), (int32_t)(" + fpExpr(a1) + "))"

    // ---- retain/release (ARC Task 2) ----
    } else if nm == IRetain() or nm == IRelease() {
        // a0 is the reference to retain/release, dispatched on ITS OWN IR
        // type (never x's -- both intrinsics are void): a by-value record
        // (KRec) prints as a call to that record type's generated
        // clar_retain_NAME/clar_release_NAME walk helper (cpEmitRcWalks),
        // marking the record type needed the first time it's seen here
        // (only when the record is actually handle-backed --
        // irRecHasHandleField; ARC Task 7's gate-asymmetry fix -- lower.cla
        // never emits IRetain/IRelease over a scalar-only record's value in
        // the first place, but this branch checks too rather than trusting
        // that invariant blindly). A KArr, KList, or KMap argument routes
        // through cpEmitRetain/cpEmitRelease's own already-correct
        // recursive per-element walk directly, inline, via the same
        // caller-owned-buffer trick fpRetainVal/fpReleaseVal use -- for
        // KList/KMap this matters: cpEmitRelease's rt_list_lastref/
        // rt_map_lastref-gated loop releases each element's own reference(s)
        // before releasing the container's own handle, where a bare
        // rt_list_release/rt_map_release call would skip that element walk
        // entirely and leak (ARC fixwave Critical 1, bug 1). Only a plain
        // KText argument still prints as a direct bare rt_text_retain/
        // rt_text_release call -- Text has no elements to walk, so
        // cpEmitRelease's own KText branch would print byte-identical C
        // anyway; kept bare here to avoid touching every KText emission
        // site's exact output. (This arm predates fpRetainVal/fpReleaseVal
        // and keeps its own dispatch for the KRec case, which DOES need the
        // marking side effect fpRetainVal/fpReleaseVal already do too --
        // functionally identical, kept inline here to avoid changing this
        // arm's pre-existing KRec shape.) fpAddrable (not fpExpr) because
        // the KRec/KArr/KList/KMap branches all take cexpr's address -- it
        // must be a real addressable lvalue, never a bare rvalue. lower.cla
        // emits IRetain/IRelease at every heap-typed `return` (ARC Task 3)
        // and now at every record copy site (ARC Task 7).
        s0 = fpAddrable(a0)
        argT = irExprType(a0)
        argK = irtKind(argT)
        if argK == KRec {
            if irRecHasHandleField(irtName(argT)) {
                recName = poolGet(irtName(argT))
                irMarkRcWalkNeeded(irtName(argT))
                if nm == IRetain() {
                    fpEmit("clar_retain_" + recName + "(&(" + s0 + "));")
                } else {
                    fpEmit("clar_release_" + recName + "(&(" + s0 + "));")
                }
            }
        } else if argK == KArr or argK == KList or argK == KMap {
            t = ""
            if nm == IRetain() {
                cpEmitRetain(t, toStr(s0), argT)
            } else {
                cpEmitRelease(t, toStr(s0), argT)
            }
            fpEmit(t)
        } else {
            // KText only now (KArr/KList/KMap routed through
            // cpEmitRetain/cpEmitRelease above). Plan 5c wave2a Task 2:
            // cpTextArcPorted redirects to the Clarus-ported
            // rtTextRetain/rtTextRelease.
            if cpTextArcPorted {
                if nm == IRetain() {
                    fpEmit("clar_fn_rtTextRetain((void*)" + s0 + ");")
                } else {
                    fpEmit("clar_fn_rtTextRelease((void*)" + s0 + ");")
                }
            } else {
                if nm == IRetain() {
                    fpEmit("rt_text_retain(" + s0 + ");")
                } else {
                    fpEmit("rt_text_release(" + s0 + ");")
                }
            }
        }
        return toText("")

    // ---- strings ----
    // Plan 5b Task 8: once runtime/clarus/str.cla is included (always, per
    // main.cla's unconditional manifest entry -- cpStrPorted mirrors that
    // decision exactly, same convention as cpSerPorted/IFileSave), every
    // arm below calls clar_fn_rtStrXxx instead of the C rt_str_* runtime.
    // Casts are otherwise identical to the C-runtime path: a temp/lvalue
    // address (formerly "(uint8_t*)&...") becomes "(void*)&..." (rtStrXxx's
    // own params are all `ptr`); a char/int argument (formerly
    // "(uint8_t)(...)", since the C functions take uint8_t) becomes
    // "(int32_t)(...)" (the Clarus int param carries the same 0-255 value).
    // fpStrAddr's own "(const uint8_t*)&(...)" cast, unlike the C-runtime
    // path (whose params are themselves `const uint8_t *`, an exact type
    // match), does need an explicit outer "(void*)" wrap here -- a
    // `clar_fn_rtStrXxx` parameter is `void *`, and handing it a
    // `const uint8_t *` unwrapped compiles (implicit pointer conversion)
    // but warns ("discards qualifiers") at every one of the ~1500 call
    // sites this redirect fires at self-compile time. Every cpStrPorted
    // branch below wraps each `fpStrAddr(...)` result in `(void*)` for
    // this reason -- verified zero new warnings vs. the pre-Task-8
    // bootstrap one-liner after this fix.
    } else if nm == IStrConcat() {
        s0 = fpStrAddr(a0)
        s1 = fpStrAddr(a1)
        t = fpNewTmp("clar_str_255")
        if cpStrPorted {
            fpEmit("clar_fn_rtStrConcat((void*)&" + t + ", (void*)" + s0 + ", (void*)" + s1 + ");")
        } else {
            fpEmit("rt_str_concat((uint8_t*)&" + t + ", " + s0 + ", " + s1 + ");")
        }
        return t
    } else if nm == IStrConcatChar() {
        s0 = fpStrAddr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("clar_str_255")
        if cpStrPorted {
            fpEmit("clar_fn_rtStrConcatChar((void*)&" + t + ", (void*)" + s0 + ", (int32_t)(" + s1 + "));")
        } else {
            fpEmit("rt_str_concat_char((uint8_t*)&" + t + ", " + s0 + ", (uint8_t)(" + s1 + "));")
        }
        return t
    } else if nm == IStrPrependChar() {
        s0 = fpExpr(a0)
        s1 = fpStrAddr(a1)
        t = fpNewTmp("clar_str_255")
        if cpStrPorted {
            fpEmit("clar_fn_rtStrPrependChar((void*)&" + t + ", (int32_t)(" + s0 + "), (void*)" + s1 + ");")
        } else {
            fpEmit("rt_str_prepend_char((uint8_t*)&" + t + ", (uint8_t)(" + s0 + "), " + s1 + ");")
        }
        return t
    } else if nm == IStrCmp() {
        if cpStrPorted {
            return "clar_fn_rtStrCmp((void*)" + fpStrAddr(a0) + ", (void*)" + fpStrAddr(a1) + ")"
        }
        return "rt_str_cmp(" + fpStrAddr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == IStrLen() {
        if cpStrPorted {
            return "clar_fn_rtStrLen((void*)" + fpStrAddr(a0) + ")"
        }
        return "rt_str_len(" + fpStrAddr(a0) + ")"
    } else if nm == IStrIndex() {
        if cpStrPorted {
            return "clar_fn_rtStrIndex((void*)" + fpStrAddr(a0) + ", (int32_t)(" + fpExpr(a1) + "))"
        }
        return "rt_str_index(" + fpStrAddr(a0) + ", (int32_t)(" + fpExpr(a1) + "))"
    } else if nm == IStrSetIndex() {
        s0 = fpAddrable(a0)
        s1 = fpExpr(a1)
        if cpStrPorted {
            fpEmit("clar_fn_rtStrSetIndex((void*)&(" + s0 + "), (int32_t)(" + s1 + "), (int32_t)(" + fpExpr(a2) + "));")
        } else {
            fpEmit("rt_str_set_index((uint8_t*)&(" + s0 + "), (int32_t)(" + s1 + "), (uint8_t)(" + fpExpr(a2) + "));")
        }
        return toText("")
    } else if nm == IStrFromBytes() {
        s0 = fpAddrable(a0)
        cap0 = irtN(irExprType(a0))
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        if cpStrPorted {
            fpEmit("clar_fn_rtStrFromBytes((void*)&(" + s0 + "), " + numToStr(cap0) + ", (void*)(" + s1 + ").e, " + numToStr(cap1) + ", (int32_t)(" + fpExpr(a2) + "));")
        } else {
            fpEmit("rt_str_from_bytes((uint8_t*)&(" + s0 + "), " + numToStr(cap0) + ", (const uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ", (int32_t)(" + fpExpr(a2) + "));")
        }
        return toText("")
    } else if nm == IStrToBytes() {
        s0 = fpStrAddr(a0)
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        if cpStrPorted {
            return "clar_fn_rtStrToBytes((void*)" + s0 + ", (void*)(" + s1 + ").e, " + numToStr(cap1) + ")"
        }
        return "rt_str_to_bytes(" + s0 + ", (uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ")"
    } else if nm == IStrCoerce() {
        // Materializes a0 (any Str capacity) into a fresh temp at x.Ty's
        // (different) capacity via the same clamped rt_str_store/
        // clar_fn_rtStrStore fpStoreStr uses for a plain lvalue -- see
        // lowCoerceStr's doc comment (lower.cla) for why this can't just
        // be a plain `=`.
        s0 = fpStrAddr(a0)
        t = fpNewTmp(cpCType(irExprType(x)))
        if cpStrPorted {
            fpEmit("clar_fn_rtStrStore((void*)&" + t + ", " + numToStr(irtN(irExprType(x))) + ", (void*)" + s0 + ");")
        } else {
            fpEmit("rt_str_store((uint8_t*)&" + t + ", " + numToStr(irtN(irExprType(x))) + ", " + s0 + ");")
        }
        return t
    } else if nm == IStrSlice() {
        s0 = fpStrAddr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("clar_str_255")
        if cpStrPorted {
            fpEmit("clar_fn_rtStrSlice((void*)&" + t + ", (void*)" + s0 + ", (int32_t)(" + s1 + "), (int32_t)(" + fpExpr(a2) + "));")
        } else {
            fpEmit("rt_str_slice((uint8_t*)&" + t + ", " + s0 + ", (int32_t)(" + s1 + "), (int32_t)(" + fpExpr(a2) + "));")
        }
        return t
    } else if nm == IStrIndexOfStr() {
        if cpStrPorted {
            return "clar_fn_rtStrIndexOfStr((void*)" + fpStrAddr(a0) + ", (void*)" + fpStrAddr(a1) + ")"
        }
        return "rt_str_index_of_str(" + fpStrAddr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == IStrIndexOfChar() {
        if cpStrPorted {
            return "clar_fn_rtStrIndexOfChar((void*)" + fpStrAddr(a0) + ", (int32_t)(" + fpExpr(a1) + "))"
        }
        return "rt_str_index_of_char(" + fpStrAddr(a0) + ", (uint8_t)(" + fpExpr(a1) + "))"

    // ---- text ----
    } else if nm == ITextCmp() {
        return fpTextCmp(a0, a1)
    } else if nm == ITextConcat() {
        return fpTextConcat(a0, a1)
    } else if nm == ITextConcatSL() {
        // string-on-the-left concat (rtTextConcatSl's `a`/`b` params are
        // ptr; ported body ported.cla-side against rt_core.inc's
        // rt_text_concat_sl).
        s0 = fpStrAddr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("rt_text *")
        if cpTextPorted {
            fpEmit(t + " = (rt_text *)clar_fn_rtTextNew();")
            fpEmit("clar_fn_rtTextConcatSl((void*)" + t + ", (void*)" + s0 + ", (void*)" + s1 + ");")
        } else {
            fpEmit(t + " = rt_text_new();")
            fpEmit("rt_text_concat_sl(" + t + ", " + s0 + ", " + s1 + ");")
        }
        return t
    } else if nm == ITextStore() {
        if cpTextPorted {
            fpEmit("clar_fn_rtTextStore((void*)" + fpExpr(a0) + ", (void*)" + fpStrAddr(a1) + ");")
        } else {
            fpEmit("rt_text_store(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ");")
        }
        return toText("")
    } else if nm == ITextLen() {
        if cpTextPorted {
            return "clar_fn_rtTextLen((void*)" + fpExpr(a0) + ")"
        }
        return "rt_text_len(" + fpExpr(a0) + ")"
    } else if nm == ITextIndex() {
        if cpTextPorted {
            return "clar_fn_rtTextIndex((void*)" + fpExpr(a0) + ", (int32_t)(" + fpExpr(a1) + "))"
        }
        return "rt_text_index(" + fpExpr(a0) + ", (int32_t)(" + fpExpr(a1) + "))"
    } else if nm == ITextSetIndex() {
        s0 = fpExpr(a0)
        s1 = fpExpr(a1)
        if cpTextPorted {
            fpEmit("clar_fn_rtTextSetIndex((void*)" + s0 + ", (int32_t)(" + s1 + "), (int32_t)(" + fpExpr(a2) + "));")
        } else {
            fpEmit("rt_text_set_index(" + s0 + ", (int32_t)(" + s1 + "), (uint8_t)(" + fpExpr(a2) + "));")
        }
        return toText("")
    } else if nm == ITextFromBytes() {
        s0 = fpExpr(a0)
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        if cpTextPorted {
            fpEmit("clar_fn_rtTextFromBytes((void*)" + s0 + ", (void*)(" + s1 + ").e, " + numToStr(cap1) + ", (int32_t)(" + fpExpr(a2) + "));")
        } else {
            fpEmit("rt_text_from_bytes(" + s0 + ", (const uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ", (int32_t)(" + fpExpr(a2) + "));")
        }
        return toText("")
    } else if nm == ITextToBytes() {
        s0 = fpExpr(a0)
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        if cpTextPorted {
            return "clar_fn_rtTextToBytes((void*)" + s0 + ", (void*)(" + s1 + ").e, " + numToStr(cap1) + ")"
        }
        return "rt_text_to_bytes(" + s0 + ", (uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ")"
    } else if nm == ITextSlice() {
        s0 = fpExpr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("clar_str_255")
        if cpTextPorted {
            fpEmit("clar_fn_rtTextSlice((void*)&" + t + ", (void*)" + s0 + ", (int32_t)(" + s1 + "), (int32_t)(" + fpExpr(a2) + "));")
        } else {
            fpEmit("rt_text_slice((uint8_t*)&" + t + ", " + s0 + ", (int32_t)(" + s1 + "), (int32_t)(" + fpExpr(a2) + "));")
        }
        return t
    } else if nm == ITextIndexOfStr() {
        if cpTextPorted {
            return "clar_fn_rtTextIndexOfStr((void*)" + fpExpr(a0) + ", (void*)" + fpStrAddr(a1) + ")"
        }
        return "rt_text_index_of_str(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == ITextIndexOfChar() {
        if cpTextPorted {
            return "clar_fn_rtTextIndexOfChar((void*)" + fpExpr(a0) + ", (int32_t)(" + fpExpr(a1) + "))"
        }
        return "rt_text_index_of_char(" + fpExpr(a0) + ", (uint8_t)(" + fpExpr(a1) + "))"
    } else if nm == ITextAppendStr() {
        if cpTextPorted {
            fpEmit("clar_fn_rtTextAppendStr((void*)" + fpExpr(a0) + ", (void*)" + fpStrAddr(a1) + ");")
        } else {
            fpEmit("rt_text_append_str(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ");")
        }
        return toText("")
    } else if nm == ITextAppendChar() {
        if cpTextPorted {
            fpEmit("clar_fn_rtTextAppendChar((void*)" + fpExpr(a0) + ", (int32_t)(" + fpExpr(a1) + "));")
        } else {
            fpEmit("rt_text_append_char(" + fpExpr(a0) + ", (uint8_t)(" + fpExpr(a1) + "));")
        }
        return toText("")
    } else if nm == ITextAppendText() {
        if cpTextPorted {
            fpEmit("clar_fn_rtTextAppendText((void*)" + fpExpr(a0) + ", (void*)" + fpExpr(a1) + ");")
        } else {
            fpEmit("rt_text_append_text(" + fpExpr(a0) + ", " + fpExpr(a1) + ");")
        }
        return toText("")
    } else if nm == ITextOfStr() {
        // Materializes a0 (a Str value) into a fresh rt_text handle --
        // lowCoerceStr's Text-target/Str-source case (lower.cla). The fresh
        // handle satisfies the language reference's "always a fresh copy"
        // contract: mutating the received text (e.g. .append) never affects
        // the original string, since rt_text_store copies the string's
        // bytes into the new handle's own buffer.
        t = fpNewTmp("rt_text *")
        s0 = fpStrAddr(a0)
        if cpTextPorted {
            fpEmit(t + " = (rt_text *)clar_fn_rtTextNew();")
            fpEmit("clar_fn_rtTextStore((void*)" + t + ", (void*)" + s0 + ");")
        } else {
            fpEmit(t + " = rt_text_new();")
            fpEmit("rt_text_store(" + t + ", " + s0 + ");")
        }
        return t
    } else if nm == ITextFreeVar() {
        // memory-audit Task 7: a0 is always a bare EVarRef (the escape
        // pre-pass's own qualifying-local set, lower.cla) -- a plain,
        // single-line free, unlike the list/map cases below which may need
        // an element-free loop first. Plan 5c wave2a Task 2: rt_text_free is
        // exactly rt_text_release (rt_core.inc:817's one-line alias), and
        // text.cla never grew a separate rtTextFree -- cpTextArcPorted
        // redirects straight to the Clarus-ported rtTextRelease.
        if cpTextArcPorted {
            fpEmit("clar_fn_rtTextRelease((void*)" + fpExpr(a0) + ");")
        } else {
            fpEmit("rt_text_free(" + fpExpr(a0) + ");")
        }
        return toText("")

    // ---- list ----
    } else if nm == IListPush() or nm == IListUnshift() or nm == IListPushRetain() or nm == IListUnshiftRetain() {
        // v goes through fpCopyToTemp, not fpAddrable: push/unshift can
        // realloc a0's backing store, and if v were instead a raw
        // rt_list_at pointer (fpAddrable's IndexRef shortcut, e.g.
        // `l.push(l[0])`), that realloc could free it before this call's
        // own memmove reads it.
        l = fpExpr(a0)
        v = fpCopyToTemp(a1)
        // v is stored into the list (a text v's handle now lives on, owned
        // by the list) -- untrack it so it isn't freed at end of statement
        // (memory-audit Task 6; a no-op if v isn't text).
        fpHandoff(v)
        // ARC Task 5: lowListMethod (lower.cla) picks the *Retain name
        // whenever the pushed value is NON-birth (a bare local/global/
        // element read, not a fresh literal/concat/slice/call result) --
        // the container is a counted owner now, so a non-birth push needs
        // its OWN +1, the same retain-unless-birth rule lowCountedStore
        // established for named-slot stores. Retain BEFORE the push call --
        // v is already the fully-materialized, single-evaluated value at
        // this point (fpCopyToTemp above), so ordering here can't
        // re-trigger any side effect, only correctly bump the right box's
        // rc before the list takes its own reference to it.
        if nm == IListPushRetain() or nm == IListUnshiftRetain() {
            // ARC Task 7: fpRetainVal (not a bare fpHeapFn(...) call, which
            // only ever knew Text/List/Map) -- a0's element type may now be
            // a handle-backed record too (lower.cla only ever picks the
            // *Retain name when that's genuinely true).
            fpRetainVal(v, irExprType(a1))
        }
        // Plan 5b Task 10: cpListPorted redirects the push/unshift call
        // itself to clar_fn_rtListPush/rtListUnshift -- the fpRetainVal
        // prefix just above stays a bare C call regardless (RC boundary).
        if cpListPorted {
            fn = "clar_fn_rtListPush"
            if nm == IListUnshift() or nm == IListUnshiftRetain() {
                fn = "clar_fn_rtListUnshift"
            }
            fpEmit(fn + "((void*)" + l + ", (void*)&(" + v + "));")
        } else {
            fn = "rt_list_push"
            if nm == IListUnshift() or nm == IListUnshiftRetain() {
                fn = "rt_list_unshift"
            }
            fpEmit(fn + "(" + l + ", &(" + v + "));")
        }
        return toText("")
    } else if nm == IListPop() or nm == IListShift() {
        l = fpExpr(a0)
        // Plan 5b Task 10: cpListPorted redirects both emission points below
        // (the discard-statement release branch and the ordinary
        // materialize-into-a-temp path) to clar_fn_rtListPop/rtListShift.
        if cpListPorted {
            fn = "clar_fn_rtListPop"
            if nm == IListShift() {
                fn = "clar_fn_rtListShift"
            }
        } else {
            fn = "rt_list_pop"
            if nm == IListShift() {
                fn = "rt_list_shift"
            }
        }
        if x == fpDiscardExprIdx and fpNeedsRelease(irExprType(x)) {
            // ARC Task 8 review round 2 (Important finding): a bare
            // `lst.pop();`/`lst.shift();` STATEMENT -- the popped value
            // used nowhere, not an assign dst/return/call argument -- still
            // transfers ownership out of the list (same no-retain contract
            // as below) but nothing else ever claims it, so it leaks unless
            // released HERE. fpDiscardExprIdx (set by fpStmt's own
            // SExprStmt case, see its doc comment) identifies exactly this
            // shape and no other -- a NESTED pop/shift (a call argument,
            // `f(lst.pop())`) never matches, so that position's behavior is
            // untouched. fpNewTrackedTmp (not fpNewTmp) so the ordinary
            // end-of-statement flush (fpFreeStmtTmps) releases it -- also
            // covers a handle-backed record element, via the SAME
            // release-walk shape (`clar_release_NAME`) fpNewTrackedTmp
            // already gives every other tracked record temp (ARC Task 7).
            t = fpNewTrackedTmp(irExprType(x))
            if cpListPorted {
                fpEmit(fn + "((void*)" + l + ", (void*)&" + t + ");")
            } else {
                fpEmit(fn + "(" + l + ", &" + t + ");")
            }
            return t
        }
        t = fpNewTmp(cpCType(irExprType(x)))
        if cpListPorted {
            fpEmit(fn + "((void*)" + l + ", (void*)&" + t + ");")
        } else {
            fpEmit(fn + "(" + l + ", &" + t + ");")
        }
        // memory-audit Task 6 / ARC Task 3: pop/shift TRANSFER ownership --
        // this copies the ELEMENT'S bytes (a text element's bytes ARE its
        // handle -- Ch3 reference semantics) out of l's backing store into
        // t AND removes l's slot, so the count doesn't change: no retain.
        // Never auto-free/release t -- untrack it unconditionally, same as
        // any other "the caller must reason about this" handle (assign
        // dst/return/call-argument -- the ONE other position, a bare
        // discarded statement, is handled above instead).
        fpHandoff(t)
        return t
    } else if nm == IListFirst() or nm == IListLast() {
        l = fpExpr(a0)
        // Plan 5b Task 10: cpListPorted redirects the list-access call
        // itself to clar_fn_rtListFirst/rtListLast; the `_retain` suffix
        // call below stays a bare C call regardless (RC boundary).
        if cpListPorted {
            fn = "clar_fn_rtListFirst"
            if nm == IListLast() {
                fn = "clar_fn_rtListLast"
            }
        } else {
            fn = "rt_list_first"
            if nm == IListLast() {
                fn = "rt_list_last"
            }
        }
        // ARC Task 3: unlike pop/shift, first/last do NOT remove the
        // element from l -- t and l's own slot alias the SAME object after
        // the copy below. A heap-typed element (text/list/map) is retained
        // immediately, making t a genuine +1 owned reference (same
        // convention as a user call result); tracked, so it releases at end
        // of statement unless handed off. A by-value element (int/bool/
        // fixed/char/enum/Rec) has nothing to retain -- Rec stays 4e's
        // escape-qualified path until Task 7.
        if fpIsHandleType(irExprType(x)) {
            t = fpNewTrackedTmp(irExprType(x))
            if cpListPorted {
                fpEmit(fn + "((void*)" + l + ", (void*)&" + t + ");")
            } else {
                fpEmit(fn + "(" + l + ", &" + t + ");")
            }
            // Plan 5c wave2a Task 2 (review fix): the element's own retain
            // still redirects for KText once cpTextArcPorted -- the list
            // ACCESS call above is a separate, already-ported concern
            // (cpListPorted); a text element read out of a `list of text`
            // must retain through the same Clarus-ported rtTextRetain every
            // other text retain site uses. Plan 5c wave2a Task 3: KList
            // redirects the same way (a `list of list of text`'s outer
            // retain) once cpListArcPorted. Plan 5c wave2a Task 4: KMap
            // redirects the same way (a `list of map of text`'s outer
            // retain) once cpMapArcPorted.
            if irtKind(irExprType(x)) == KText and cpTextArcPorted {
                fpEmit("clar_fn_rtTextRetain((void*)" + t + ");")
            } else if irtKind(irExprType(x)) == KList and cpListArcPorted {
                fpEmit("clar_fn_rtListRetain((void*)" + t + ");")
            } else if irtKind(irExprType(x)) == KMap and cpMapArcPorted {
                fpEmit("clar_fn_rtMapRetain((void*)" + t + ");")
            } else {
                fpEmit(fpHeapFn(irtKind(irExprType(x))) + "_retain(" + t + ");")
            }
        } else {
            t = fpNewTmp(cpCType(irExprType(x)))
            if cpListPorted {
                fpEmit(fn + "((void*)" + l + ", (void*)&" + t + ");")
            } else {
                fpEmit(fn + "(" + l + ", &" + t + ");")
            }
        }
        return t
    } else if nm == IListRemove() {
        // ARC Task 5: release the removed element BEFORE rt_list_remove --
        // once removed, it's unreachable through l, so this is the last
        // chance to release the container's own reference to it. l/a1's own
        // C strings are computed ONCE (l, s0 below) and reused for both the
        // read and the removal call, so an index expression with a side
        // effect (e.g. `items.remove(f())`) is never evaluated twice.
        l = fpExpr(a0)
        s0 = fpExpr(a1)
        elemT = irtElem(irExprType(a0))
        if fpNeedsRelease(elemT) {
            // ARC Task 7: fpNeedsRelease (not fpIsHandleType alone) --
            // widened to also cover a handle-backed record/array element.
            ctype = cpCType(elemT)
            old = fpNewTmp(ctype)
            fpHandoff(old) // never auto-freed -- this branch's own release below is the only one
            fpEmit(old + " = (*(" + ctype + "*)rt_list_at(" + l + ", (int32_t)(" + s0 + ")));")
            fpReleaseVal(old, elemT)
        }
        // Plan 5b Task 10: only the REMOVAL call redirects -- the old-value
        // read just above uses rt_list_at, which STAYS C (RC boundary: an
        // interior-pointer primitive, same reasoning as IListSet's ref
        // below).
        if cpListPorted {
            fpEmit("clar_fn_rtListRemove((void*)" + l + ", (int32_t)(" + s0 + "));")
        } else {
            fpEmit("rt_list_remove(" + l + ", (int32_t)(" + s0 + "));")
        }
        return toText("")
    } else if nm == IListSet() or nm == IListSetRetain() {
        // ARC Task 5: `lst[i] = v` for a heap-typed element (lowIndexAssign,
        // lower.cla) -- replaces the pre-Task-5 plain-Assign/IndexRef-lvalue
        // path for exactly this case (a non-heap element's index-write is
        // still the ordinary Assign path, untouched). l/i are each computed
        // ONCE (l, s0) and reused for BOTH the old-element read+release and
        // the new-element write, so an index expression with a side effect
        // is never evaluated twice -- same reasoning as IListRemove above.
        //
        // Retain-new-BEFORE-release-old (IListSetRetain only) is the
        // self-overwrite safety ordering (`lst[i] = lst[i]`): a list
        // index-READ is an unretained borrow (unlike a map subscript read,
        // which IMapGet always retains -- see fpMapReleaseGuard's own
        // comment for why map-set's guard can safely run release-before-
        // retain instead), so if new and old happen to be the SAME handle,
        // retaining first guarantees the release that follows can never
        // drop its rc to zero. v goes through fpCopyToTemp, not fpAddrable,
        // for the same realloc-safety reason as IListPush/IMapSet above.
        l = fpExpr(a0)
        s0 = fpExpr(a1)
        elemT = irExprType(a2)
        ctype = cpCType(elemT)
        ref = "(*(" + ctype + "*)rt_list_at(" + l + ", (int32_t)(" + s0 + ")))"
        v = fpCopyToTemp(a2)
        fpHandoff(v)
        // ARC Task 7: fpRetainVal/fpReleaseVal (not fpHeapFn directly) --
        // elemT may now be a handle-backed record too.
        if nm == IListSetRetain() {
            fpRetainVal(v, elemT)
        }
        old = fpNewTmp(ctype)
        fpHandoff(old)
        fpEmit(old + " = " + ref + ";")
        fpReleaseVal(old, elemT)
        fpEmit(ref + " = " + v + ";")
        return toText("")
    } else if nm == IListCount() {
        if cpListPorted {
            return "clar_fn_rtListCount((void*)" + fpExpr(a0) + ")"
        }
        return "rt_list_count(" + fpExpr(a0) + ")"
    } else if nm == IListFreeVar() {
        // memory-audit Task 7: reuse Task 5's cpEmitRelease (element-release
        // loop for a KText element type, then rt_list_release) rather than
        // reimplementing it -- cpEmitRelease appends into a caller-owned
        // `text` buffer via cpAppendLine (its own fixed one-level indent),
        // so the whole (possibly multi-line) result is emitted as ONE
        // fpBody entry here, the same trick cpEmitGlobalsInit uses for
        // cl_free_globals's body. Indentation is the only thing that can
        // differ from a hand-rolled fpEmit-per-line version (purely
        // cosmetic -- C doesn't care), and correctness (double-free,
        // element ordering) is entirely cpEmitRelease's own,
        // already-reviewed logic.
        freeVarBuf = ""
        cpEmitRelease(freeVarBuf, "cv_" + poolGet(irVarRefName(a0)), irExprType(a0))
        fpEmit(freeVarBuf)
        return toText("")

    // ---- map ----
    } else if nm == IMapSet() or nm == IMapSetRetain() {
        // v goes through fpCopyToTemp, not fpAddrable, for the same reason
        // as list_push/unshift above: map_set grows m's key/value arrays on
        // a new key, so a raw rt_list_at-derived pointer passed as v (e.g.
        // `m.set(k, l[0])`) must be copied out before the call, not handed
        // in live. (m's own values never alias this way: map subscript
        // lowers to the map_get intrinsic, which always materializes into
        // its own temp before it can be used as another call's argument --
        // see IMapGet below.)
        m = fpExpr(a0)
        k = fpStrAddr(a1)
        // ARC Task 5: `m[k] = v` is an UPSERT -- whatever k currently holds
        // (if anything) is about to be discarded, so it must be released
        // first, guarded by rt_map_has (rt_map_get panics on an absent key,
        // rt.h) -- see fpMapReleaseGuard's own doc comment for the guard's
        // exact shape and why it's a raw, non-retaining get.
        if fpNeedsRelease(irExprType(a2)) {
            // ARC Task 7: fpNeedsRelease -- widened to also cover a
            // handle-backed record value type.
            fpMapReleaseGuard(m, k, irExprType(a2))
        }
        v = fpCopyToTemp(a2)
        // v is stored into the map -- same handoff reasoning as
        // IListPush/IListUnshift above (memory-audit Task 6).
        fpHandoff(v)
        // ARC Task 5: lowIndexAssign picks IMapSetRetain whenever v is
        // NON-birth (same retain-unless-birth rule as IListPush(Retain)
        // above) -- ordering relative to the guard above doesn't matter for
        // correctness (a non-birth source can never alias m's OWN current,
        // unretained slot value: the only way to read that value at all,
        // `m[k]`, always retains via IMapGet, making it birth, never
        // non-birth -- see IMapSetRetain's own ir.cla doc comment), so this
        // matches the brief's own worked example ordering (guard, then
        // retain, then set) directly.
        if nm == IMapSetRetain() {
            fpRetainVal(v, irExprType(a2))
        }
        // Plan 5b Task 11: cpMapPorted redirects the set call itself.
        if cpMapPorted {
            fpEmit("clar_fn_rtMapSet((void*)" + m + ", (void*)" + k + ", (void*)&(" + v + "));")
        } else {
            fpEmit("rt_map_set(" + m + ", " + k + ", &(" + v + "));")
        }
        return toText("")
    } else if nm == IMapGet() {
        m = fpExpr(a0)
        k = fpStrAddr(a1)
        // ARC Task 3: aliases m's own stored value (same reasoning as
        // IListFirst/IListLast above) -- a heap-typed result is retained
        // immediately into a tracked temp, same +1-and-tracked convention.
        // Plan 5b Task 11: cpMapPorted redirects the get call itself.
        // Plan 5c wave2a Task 2 (review fix): KText redirects to the
        // Clarus-ported rtTextRetain, same reasoning as IListFirst/
        // IListLast above. Plan 5c wave2a Task 3: KList redirects the same
        // way once cpListArcPorted. Plan 5c wave2a Task 4: KMap redirects
        // the same way once cpMapArcPorted.
        if fpIsHandleType(irExprType(x)) {
            t = fpNewTrackedTmp(irExprType(x))
            if cpMapPorted {
                fpEmit("clar_fn_rtMapGet((void*)" + m + ", (void*)" + k + ", (void*)&" + t + ");")
            } else {
                fpEmit("rt_map_get(" + m + ", " + k + ", &" + t + ");")
            }
            if irtKind(irExprType(x)) == KText and cpTextArcPorted {
                fpEmit("clar_fn_rtTextRetain((void*)" + t + ");")
            } else if irtKind(irExprType(x)) == KList and cpListArcPorted {
                fpEmit("clar_fn_rtListRetain((void*)" + t + ");")
            } else if irtKind(irExprType(x)) == KMap and cpMapArcPorted {
                fpEmit("clar_fn_rtMapRetain((void*)" + t + ");")
            } else {
                fpEmit(fpHeapFn(irtKind(irExprType(x))) + "_retain(" + t + ");")
            }
        } else {
            t = fpNewTmp(cpCType(irExprType(x)))
            if cpMapPorted {
                fpEmit("clar_fn_rtMapGet((void*)" + m + ", (void*)" + k + ", (void*)&" + t + ");")
            } else {
                fpEmit("rt_map_get(" + m + ", " + k + ", &" + t + ");")
            }
        }
        return t
    } else if nm == IMapGetDv() {
        // dv is NON-birth here (lowMapMethod's own birth check picked
        // IMapGetDvBirth instead when it isn't -- see that intrinsic's own
        // doc comment) -- some other slot already owns dv's reference, so
        // whether t ends up holding dv (key absent) or m's own stored value
        // (key present), t needs its OWN +1 either way (a heap-typed result
        // is retained immediately into a tracked temp, ARC Task 3, same as
        // IMapGet above) and dv's original box is never released here (it
        // was never independently owned to begin with -- its true owner
        // keeps it regardless of whether this call ended up using it).
        m = fpExpr(a0)
        k = fpStrAddr(a1)
        dv = fpExpr(a2)
        fpHandoff(dv) // dv's own temp (if any) is about to alias into t
        // Plan 5b Task 11: cpMapPorted redirects the get_dv call itself.
        // Plan 5c wave2a Task 2 (review fix): KText redirects to
        // the Clarus-ported rtTextRetain, same reasoning as IMapGet above.
        // Plan 5c wave2a Task 3: KList redirects the same way once
        // cpListArcPorted. Plan 5c wave2a Task 4: KMap redirects the same
        // way once cpMapArcPorted.
        if fpIsHandleType(irExprType(x)) {
            t = fpNewTrackedTmp(irExprType(x))
            fpEmit(t + " = " + dv + ";") // pre-fill with the default; get_dv leaves it untouched if absent
            if cpMapPorted {
                fpEmit("clar_fn_rtMapGetDv((void*)" + m + ", (void*)" + k + ", (void*)&" + t + ");")
            } else {
                fpEmit("rt_map_get_dv(" + m + ", " + k + ", &" + t + ");")
            }
            if irtKind(irExprType(x)) == KText and cpTextArcPorted {
                fpEmit("clar_fn_rtTextRetain((void*)" + t + ");")
            } else if irtKind(irExprType(x)) == KList and cpListArcPorted {
                fpEmit("clar_fn_rtListRetain((void*)" + t + ");")
            } else if irtKind(irExprType(x)) == KMap and cpMapArcPorted {
                fpEmit("clar_fn_rtMapRetain((void*)" + t + ");")
            } else {
                fpEmit(fpHeapFn(irtKind(irExprType(x))) + "_retain(" + t + ");")
            }
        } else {
            t = fpNewTmp(cpCType(irExprType(x)))
            fpEmit(t + " = " + dv + ";") // pre-fill with the default; get_dv leaves it untouched if absent
            if cpMapPorted {
                fpEmit("clar_fn_rtMapGetDv((void*)" + m + ", (void*)" + k + ", (void*)&" + t + ");")
            } else {
                fpEmit("rt_map_get_dv(" + m + ", " + k + ", &" + t + ");")
            }
        }
        return t
    } else if nm == IMapGetDvBirth() {
        // ARC Task 8 fix (known open leak bug 2): dv is BIRTH here -- a
        // freshly constructed, independently owned value with no other
        // owner (lowMapMethod's own birth check). Two cases, distinguished
        // at RUNTIME by comparing t (post-call) against dv's own C
        // expression -- rt_map_get_dv only ever writes through &t, never
        // touches dv's own storage, so re-reading dv after the call still
        // reads its ORIGINAL value:
        //   - absent (t == dv): t simply inherited dv's own +1 -- no retain
        //     needed (unlike IMapGetDv's non-birth case, which always needs
        //     one: there, some OTHER slot already owns dv's reference, so t
        //     needs an independent +1 of its own; here, dv had exactly ONE
        //     owner and t just became it).
        //   - present (t != dv): t aliases the map's OWN stored value
        //     (needs its own retain, unconditionally, same as IMapGetDv)
        //     AND dv's original birth box is now orphaned -- nothing else
        //     references it -- so it must be released here, or it leaks
        //     permanently (this was exactly the bug: IMapGetDv's own
        //     unconditional-retain-never-release shape is wrong for a birth
        //     default in BOTH directions -- over-retains when absent,
        //     orphans when present).
        m = fpExpr(a0)
        k = fpStrAddr(a1)
        dv = fpExpr(a2)
        fpHandoff(dv)
        // Plan 5b Task 11: cpMapPorted redirects the get_dv call itself.
        // Plan 5c wave2a Task 2 (review fix): KText
        // redirects both halves to the Clarus-ported rtTextRetain/
        // rtTextRelease, same reasoning as IMapGet/IMapGetDv above. Plan 5c
        // wave2a Task 3: KList redirects both halves the same way once
        // cpListArcPorted. Plan 5c wave2a Task 4: KMap redirects both
        // halves the same way once cpMapArcPorted.
        if fpIsHandleType(irExprType(x)) {
            t = fpNewTrackedTmp(irExprType(x))
            fpEmit(t + " = " + dv + ";")
            if cpMapPorted {
                fpEmit("clar_fn_rtMapGetDv((void*)" + m + ", (void*)" + k + ", (void*)&" + t + ");")
            } else {
                fpEmit("rt_map_get_dv(" + m + ", " + k + ", &" + t + ");")
            }
            if irtKind(irExprType(x)) == KText and cpTextArcPorted {
                fpEmit("if (" + t + " != " + dv + ") { clar_fn_rtTextRetain((void*)" + t + "); clar_fn_rtTextRelease((void*)" + dv + "); }")
            } else if irtKind(irExprType(x)) == KList and cpListArcPorted {
                fpEmit("if (" + t + " != " + dv + ") { clar_fn_rtListRetain((void*)" + t + "); clar_fn_rtListRelease((void*)" + dv + "); }")
            } else if irtKind(irExprType(x)) == KMap and cpMapArcPorted {
                fpEmit("if (" + t + " != " + dv + ") { clar_fn_rtMapRetain((void*)" + t + "); clar_fn_rtMapRelease((void*)" + dv + "); }")
            } else {
                fpEmit("if (" + t + " != " + dv + ") { " + fpHeapFn(irtKind(irExprType(x))) + "_retain(" + t + "); " + fpHeapFn(irtKind(irExprType(x))) + "_release(" + dv + "); }")
            }
        } else {
            t = fpNewTmp(cpCType(irExprType(x)))
            fpEmit(t + " = " + dv + ";")
            if cpMapPorted {
                fpEmit("clar_fn_rtMapGetDv((void*)" + m + ", (void*)" + k + ", (void*)&" + t + ");")
            } else {
                fpEmit("rt_map_get_dv(" + m + ", " + k + ", &" + t + ");")
            }
        }
        return t
    } else if nm == IMapHas() {
        // Plan 5b Task 11: cpMapPorted redirects this entire intrinsic.
        if cpMapPorted {
            return "clar_fn_rtMapHas((void*)" + fpExpr(a0) + ", (void*)" + fpStrAddr(a1) + ")"
        }
        return "rt_map_has(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == IMapRemove() {
        // ARC Task 5: `m.remove(k)` "silently succeeds if absent" (language
        // reference) -- release whatever k currently holds (if anything)
        // via the SAME has-guarded raw read IMapSet(Retain) uses, then
        // remove regardless of whether the guard fired.
        m = fpExpr(a0)
        k = fpStrAddr(a1)
        if fpNeedsRelease(irtElem(irExprType(a0))) {
            fpMapReleaseGuard(m, k, irtElem(irExprType(a0)))
        }
        // Plan 5b Task 11: cpMapPorted redirects the remove call itself.
        if cpMapPorted {
            fpEmit("clar_fn_rtMapRemove((void*)" + m + ", (void*)" + k + ");")
        } else {
            fpEmit("rt_map_remove(" + m + ", " + k + ");")
        }
        return toText("")
    } else if nm == IMapCount() {
        // Plan 5b Task 11: cpMapPorted redirects this entire intrinsic.
        if cpMapPorted {
            return "clar_fn_rtMapCount((void*)" + fpExpr(a0) + ")"
        }
        return "rt_map_count(" + fpExpr(a0) + ")"
    } else if nm == IMapFreeVar() {
        // memory-audit Task 7 -- see IListFreeVar's doc comment.
        freeVarBuf = ""
        cpEmitRelease(freeVarBuf, "cv_" + poolGet(irVarRefName(a0)), irExprType(a0))
        fpEmit(freeVarBuf)
        return toText("")

    // ---- lastError ----
    } else if nm == ILastErrCode() {
        // Plan native-5d Task 12.5 (storage-inversion fix): lastError
        // storage is platform-owned again (core.cla's file header) -- read
        // the raw C globals directly, same as before Task 3's short-lived
        // Clarus-side redirect.
        return toText("rt_lasterr_code")
    } else if nm == ILastErrMsg() {
        // rt_lasterr_msg is a raw uint8_t[256] (rt.h), not a clar_str_255
        // struct -- copy it into a proper temp via rt_str_store rather than
        // exposing the type mismatch to callers.
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_str_store((uint8_t*)&" + t + ", 255, rt_lasterr_msg);")
        return t
    } else if nm == ILastErr() {
        // Materializes a whole Err-record value {code, message} from the
        // runtime's rt_lasterr_* globals -- the printer contract lowIdent
        // relies on for a bare `lastError` rvalue, since there is no
        // cv_lastError global to reference directly.
        t = fpNewTmp("clar_rec_Err")
        fpEmit(t + ".code = rt_lasterr_code;")
        fpEmit("rt_str_store((uint8_t*)&" + t + ".message, 255, rt_lasterr_msg);")
        return t

    // ---- files ----
    } else if nm == IFileReadText() {
        return "rt_file_read_text(" + fpStrAddr(a0) + ", " + fpExpr(a1) + ")"
    } else if nm == IFileWriteText() {
        return "rt_file_write_text(" + fpStrAddr(a0) + ", " + fpExpr(a1) + ")"
    } else if nm == IFileName() {
        s0 = fpStrAddr(a0)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_file_name((uint8_t*)&" + t + ", " + s0 + ");")
        return t
    } else if nm == IFileSave() or nm == IFileLoad() {
        // file.save/file.load (Ch12, Task 2 mac-target-4d). a1 is the
        // lowered data arg -- its OWN IR type carries everything else this
        // call needs: KRec directly names the record (REC container,
        // address passed via fpAddrable); KList/KMap's elem names the
        // record (LIST/MAP container, the list/map HANDLE passed via
        // fpExpr, not its address -- rt_list*/rt_map* is already a
        // pointer). checker's AnyRecordish (builtins.go/check.cla) already
        // guarantees a1 is one of these three shapes.
        dataT = irExprType(a1)
        dataKind = irtKind(dataT)
        if dataKind == KRec {
            recName = poolGet(irtName(dataT))
            container = "RT_SER_REC"
            dataExpr = "(void*)&(" + fpAddrable(a1) + ")"
        } else if dataKind == KList {
            recName = poolGet(irtName(irtElem(dataT)))
            container = "RT_SER_LIST"
            dataExpr = "(void*)(" + fpExpr(a1) + ")"
        } else {
            recName = poolGet(irtName(irtElem(dataT)))
            container = "RT_SER_MAP"
            dataExpr = "(void*)(" + fpExpr(a1) + ")"
        }
        if cpSerPorted {
            // Plan 5b Task 7: once runtime/clarus/ser.cla is included,
            // its rtFileSave/rtFileLoad replace rt_file_save/rt_file_load
            // -- container becomes rtFileSave's own `container: int`
            // literal (0/1/2), not the RT_SER_* C macros, and desc is the
            // flat clar_serdesc_<REC> array (Task 5) rather than the
            // pointer-bearing clar_layout_<REC> (still used by
            // rt_ui_table_desc/rt_ui_form_desc, unrelated to file.save/
            // load). Same dataExpr selection as above either way.
            fn = "clar_fn_rtFileSave"
            if nm == IFileLoad() {
                fn = "clar_fn_rtFileLoad"
            }
            if dataKind == KRec {
                container = "0"
            } else if dataKind == KList {
                container = "1"
            } else {
                container = "2"
            }
            return fn + "(" + fpStrAddr(a0) + ", " + container + ", " + dataExpr + ", (void*)clar_serdesc_" + recName + ")"
        }
        fn = "rt_file_save"
        if nm == IFileLoad() {
            fn = "rt_file_load"
        }
        return fn + "(" + fpStrAddr(a0) + ", " + container + ", " + dataExpr + ", &clar_layout_" + recName + ")"

    // ---- UI (Task 4: Ch7-11 -> runtime/mac/rt_ui.h) ----
    } else if nm == IUiOpen() {
        // `open W` -- x's own ty (set at lowering time) is the KWinRef type
        // carrying W's name; see ir.cla's KWinRef doc comment.
        // Task 7 Step 6 (native-5e): under --uiport, rtUiOpen takes the
        // window's blob winIdx (an int), not a descriptor pointer --
        // report log entry #5's own redesign.
        if cpUiPortFlag {
            return "clar_fn_rtUiOpen(" + numToStr(cpFindWindowIndex(poolGet(irtName(irExprType(x))))) + ")"
        }
        return "rt_ui_open(&clar_ui_window_" + poolGet(irtName(irExprType(x))) + ")"
    } else if nm == IUiFront() {
        if cpUiPortFlag {
            return "clar_fn_rtUiFront(" + numToStr(cpFindWindowIndex(poolGet(irtName(irExprType(x))))) + ")"
        }
        return "rt_ui_front(&clar_ui_window_" + poolGet(irtName(irExprType(x))) + ")"
    } else if nm == IUiClose() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiClose(" + fpExpr(a0) + ");")
        } else {
            fpEmit("rt_ui_close(" + fpExpr(a0) + ");")
        }
        return toText("")
    } else if nm == IUiQuit() {
        // `quit` in a UI program (Ch7 Quit Semantics) -- the closeRequest
        // cascade, runtime/mac/rt_ui.c's rt_ui_quit. No args: see ir.cla's
        // IUiQuit doc comment for why an exit-code expression, if any, is
        // evaluated by a separate statement lowQuit emits before this one,
        // not passed in here.
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiQuit();")
        } else {
            fpEmit("rt_ui_quit();")
        }
        return toText("")
    } else if nm == IUiState() {
        // Casts rt_ui_state's void* to the firing window's state struct and
        // dereferences it inline, so the ENCLOSING FieldRef's ordinary
        // "(X).cv_name" printer (fpFieldRef) needs no special case at all --
        // see ir.cla's KUiState doc comment.
        if cpUiPortFlag {
            return "(*(clar_uistate_" + poolGet(irtName(irExprType(x))) + " *)clar_fn_rtUiState(" + fpExpr(a0) + "))"
        }
        return "(*(clar_uistate_" + poolGet(irtName(irExprType(x))) + " *)rt_ui_state(" + fpExpr(a0) + "))"
    } else if nm == IUiStateDefaults() {
        // Constructs every handle-backed (Text/List/Map/Rec) per-instance
        // var in the firing window's state block -- the FIRST statement of
        // `opened` glue (lower.cla's lowPrependWinVarDefaults/
        // lowSynthesizeMissingOpenedHandlers), before any declared default,
        // since rt_ui_open only zeroes the block (NewHandleClear) and never
        // constructs anything in it (cpEmitUiStateStruct's own header
        // comment). Reuses cpDefaultInit for the actual construction -- no
        // duplicated type switch here, just the irtNeedsCtor (ir.cla) filter
        // so an inline-typed field (already correctly zero) emits nothing.
        winName = poolGet(irtName(irExprType(x)))
        inst = fpExpr(a0)
        fld = cpFindWindowStateFields(winName)
        while fld != -1 {
            if irtNeedsCtor(irFieldSlotType(fld)) {
                cpDefaultInit("((*(clar_uistate_" + winName + " *)rt_ui_state(" + inst + "))).cv_" + poolGet(irFieldSlotName(fld)), irFieldSlotType(fld), 0, -1)
            }
            fld = irFieldSlotNext(fld)
        }
        return toText("")
    } else if nm == IUiSetTitle() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiSetTitle(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ");")
        } else {
            fpEmit("rt_ui_set_title(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ");")
        }
        return toText("")
    } else if nm == IUiGetTitle() {
        // `title` read (mac-target-4c Task 4b) -- same fpNewTmp("clar_str_255")
        // + fill-in-place-call pattern as IFileName/IUiGetFieldText above.
        t = fpNewTmp("clar_str_255")
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiGetTitle(" + fpExpr(a0) + ", (uint8_t*)&" + t + ");")
        } else {
            fpEmit("rt_ui_get_title(" + fpExpr(a0) + ", (uint8_t*)&" + t + ");")
        }
        return t
    } else if nm == IUiSetCaption() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiWidgetSetStr(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_CAPTION, " + fpStrAddr(a2) + ");")
        } else {
            fpEmit("rt_ui_widget_set_str(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_CAPTION, " + fpStrAddr(a2) + ");")
        }
        return toText("")
    } else if nm == IUiSetText() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiWidgetSetStr(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_TEXT, " + fpStrAddr(a2) + ");")
        } else {
            fpEmit("rt_ui_widget_set_str(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_TEXT, " + fpStrAddr(a2) + ");")
        }
        return toText("")
    } else if nm == IUiGetFieldText() {
        // field.text read (mac-target-4c Task 2) -- same fpNewTmp("clar_str_255")
        // + fill-in-place-call pattern as IFileName above.
        t = fpNewTmp("clar_str_255")
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiWidgetGetStr(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_TEXT, (uint8_t*)&" + t + ");")
        } else {
            fpEmit("rt_ui_widget_get_str(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_TEXT, (uint8_t*)&" + t + ");")
        }
        return t
    } else if nm == IUiGetTextviewText() {
        // textview.text read (mac-target-4c Task 2) -- a fresh rt_text
        // handle (rt_text_new(), same as fpTextConcat/ITextOfStr above),
        // filled in place by rt_ui_widget_get_text.
        t = fpNewTmp("rt_text *")
        fpEmit(t + " = rt_text_new();")
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiWidgetGetText(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + t + ");")
        } else {
            fpEmit("rt_ui_widget_get_text(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + t + ");")
        }
        return t
    } else if nm == IUiSetTextviewText() {
        // textview.text write (mac-target-4c Task 2) -- lowWidgetSetAssign
        // (lower.cla) coerces the RHS through lowCoerceStr against the
        // property's IR type (TextT for textview.text, widgetRuntimeProps'
        // table via lowMustType(lhs)) before it ever reaches this printer,
        // so a2 is always an rt_text* here BY CONSTRUCTION: a Str-typed
        // literal/expr RHS was already wrapped in ITextOfStr (materializing
        // a fresh rt_text handle) at the funnel, and a Text-typed RHS
        // passes through lowCoerceStr unchanged. No fpStrAddr/temp is
        // needed here, unlike IUiSetText's Str-shaped a2.
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiWidgetSetText(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(a2) + ");")
        } else {
            fpEmit("rt_ui_widget_set_text(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(a2) + ");")
        }
        return toText("")
    } else if nm == IUiGetChecked() {
        if cpUiPortFlag {
            return "clar_fn_rtUiWidgetGetBool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_CHECKED)"
        }
        return "rt_ui_widget_get_bool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_CHECKED)"
    } else if nm == IUiSetChecked() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiWidgetSetBool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_CHECKED, (int32_t)(" + fpExpr(a2) + "));")
        } else {
            fpEmit("rt_ui_widget_set_bool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_CHECKED, (int32_t)(" + fpExpr(a2) + "));")
        }
        return toText("")
    } else if nm == IUiGetEnabled() {
        if cpUiPortFlag {
            return "clar_fn_rtUiWidgetGetBool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_ENABLED)"
        }
        return "rt_ui_widget_get_bool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_ENABLED)"
    } else if nm == IUiSetEnabled() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiWidgetSetBool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_ENABLED, (int32_t)(" + fpExpr(a2) + "));")
        } else {
            fpEmit("rt_ui_widget_set_bool(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_ENABLED, (int32_t)(" + fpExpr(a2) + "));")
        }
        return toText("")
    } else if nm == IUiGetWidth() {
        if cpUiPortFlag {
            return "clar_fn_rtUiWidgetGetInt(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_WIDTH)"
        }
        return "rt_ui_widget_get_int(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_WIDTH)"
    } else if nm == IUiGetHeight() {
        if cpUiPortFlag {
            return "clar_fn_rtUiWidgetGetInt(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_HEIGHT)"
        }
        return "rt_ui_widget_get_int(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_HEIGHT)"
    } else if nm == IUiGetSelected() {
        // popup/table `selected` read (mac-target-4d Task 5) -- rt_ui.h's
        // rt_ui_widget_get_int returns `short`; the implicit short->int32_t
        // widening on return needs no explicit cast, same as
        // IUiGetWidth/IUiGetHeight just above.
        if cpUiPortFlag {
            return "clar_fn_rtUiWidgetGetInt(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_SELECTED)"
        }
        return "rt_ui_widget_get_int(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_SELECTED)"
    } else if nm == IUiSetSelected() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiWidgetSetInt(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_SELECTED, (int32_t)(" + fpExpr(a2) + "));")
        } else {
            fpEmit("rt_ui_widget_set_int(" + fpExpr(a0) + ", " + fpExpr(a1) + ", RTUI_PROP_SELECTED, (int32_t)(" + fpExpr(a2) + "));")
        }
        return toText("")
    } else if nm == IUiMenuEnable() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiMenuEnable(" + fpExpr(a0) + ", " + fpExpr(a1) + ", (int32_t)(" + fpExpr(a2) + "));")
        } else {
            fpEmit("rt_ui_menu_enable(" + fpExpr(a0) + ", " + fpExpr(a1) + ", (int32_t)(" + fpExpr(a2) + "));")
        }
        return toText("")
    } else if nm == IUiCancel() {
        // `cancel` (Ch5/Ch8) -- writes through the dispatcher-owned scratch
        // pointer (see ir.cla's IUiCancel doc comment and
        // cpEmitOneWinEventDispatcher's RTUI_EV_CLOSEREQUEST case).
        fpEmit("*clar_ui_cur_cancel = 1;")
        return toText("")
    } else if nm == IUiAskOpen() {
        // `askOpen(p)` -- p is filled IN PLACE by the runtime, so its
        // address is passed non-const (unlike fpStrAddr's const cast, used
        // for every read-only Str255 argument elsewhere in this function),
        // the same "(uint8_t*)&(<addrable lvalue>)" shape IStrSetIndex uses
        // above for its own out-parameter. Embedded directly (no temp): the
        // call's own int (0/1) result IS the Bool value, same as every
        // other int-returning rt_* call in this function (e.g. IStrCmp).
        return "rt_ui_ask_open((uint8_t*)&(" + fpAddrable(a0) + "))"
    } else if nm == IUiAskSave() {
        // `askSave(p, suggested)` -- p filled in place (see IUiAskOpen
        // above); suggested is read-only, so it takes the ordinary
        // fpStrAddr const-cast path.
        return "rt_ui_ask_save((uint8_t*)&(" + fpAddrable(a0) + "), " + fpStrAddr(a1) + ")"
    } else if nm == IUiAskSaveChanges() {
        // `askSaveChanges(name)` -- name is read-only; the result is the
        // raw saveChoice enum word (0/1/2), embedded directly like
        // IUiGetWidth/IUiGetHeight's `short` results just below.
        return "rt_ui_ask_save_changes(" + fpStrAddr(a0) + ")"
    } else if nm == IUiCanvasClear() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiCanvasClear(" + fpExpr(a0) + ", " + fpExpr(a1) + ");")
        } else {
            fpEmit("rt_ui_canvas_clear(" + fpExpr(a0) + ", " + fpExpr(a1) + ");")
        }
        return toText("")
    } else if nm == IUiCanvasLine() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiCanvasLine(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ", " + fpExpr(fpArgAt(a0, 5)) + ");")
        } else {
            fpEmit("rt_ui_canvas_line(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ", " + fpExpr(fpArgAt(a0, 5)) + ");")
        }
        return toText("")
    } else if nm == IUiCanvasRect() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiCanvasRect(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ", " + fpExpr(fpArgAt(a0, 5)) + ", " + fpExpr(fpArgAt(a0, 6)) + ");")
        } else {
            fpEmit("rt_ui_canvas_rect(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ", " + fpExpr(fpArgAt(a0, 5)) + ", " + fpExpr(fpArgAt(a0, 6)) + ");")
        }
        return toText("")
    } else if nm == IUiCanvasCircle() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiCanvasCircle(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ");")
        } else {
            fpEmit("rt_ui_canvas_circle(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ");")
        }
        return toText("")
    } else if nm == IUiCanvasFillCircle() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiCanvasFillCircle(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ");")
        } else {
            fpEmit("rt_ui_canvas_fill_circle(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpExpr(fpArgAt(a0, 4)) + ");")
        }
        return toText("")
    } else if nm == IUiCanvasPattern() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiCanvasPattern(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ");")
        } else {
            fpEmit("rt_ui_canvas_pattern(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ");")
        }
        return toText("")
    } else if nm == IUiCanvasDrawText() {
        if cpUiPortFlag {
            fpEmit("clar_fn_rtUiCanvasDrawText(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpStrAddr(fpArgAt(a0, 4)) + ");")
        } else {
            fpEmit("rt_ui_canvas_draw_text(" + fpExpr(a0) + ", " + fpExpr(a1) + ", " + fpExpr(fpArgAt(a0, 2)) + ", " + fpExpr(fpArgAt(a0, 3)) + ", " + fpStrAddr(fpArgAt(a0, 4)) + ");")
        }
        return toText("")
    } else if nm == IUiEdit() {
        fpUiEditStmt(x, a0, a1, a2)
        return toText("")
    } else if nm == IUiFormIsNew() {
        return "(rt_ui_form_is_new())"

    // ---- native-5e Task 6: reverse-waist dispatcher synthesis intrinsics
    // (ir.cla's own doc comment on all three) ----
    } else if nm == IUiSetCancelFlag() {
        fpEmit("clar_ui_cur_cancel = (long *)" + fpExpr(a0) + ";")
        return toText("")
    } else if nm == IUiValueAtPtr() {
        if irtKind(irExprType(x)) == KStr {
            return "(*(const clar_str_" + numToStr(irtN(irExprType(x))) + " *)(" + fpExpr(a0) + "))"
        }
        return "(*(clar_rec_" + poolGet(irtName(irExprType(x))) + " *)(" + fpExpr(a0) + "))"
    } else if nm == IUiAddrOfGlobal() {
        return "((void*)&(" + fpExpr(a0) + "))"
    }
    return toText("")
}

// fpUiEditStmt prints one `edit F, target` / `edit F, new T` call (Ch10;
// ir.cla's IUiEdit doc comment pins the arg shape this decodes: kindArg is
// an IntConst tag, 0=`new T`/RT_UI_WB_NONE, 1=RT_UI_WB_ADDR, 2=RT_UI_WB_LIST,
// 3=RT_UI_WB_MAP). winName comes off the Intr node's OWN hijacked `ty`
// (irWinRefType), same trick IUiOpen/IUiFront use for their own window name.
//
// LIST's index and MAP's key are each evaluated into a fresh temp EXACTLY
// ONCE (fpExpr(opB)/fpStrAddr(opB) called a single time each) even though
// the emitted call site's own src-pointer expression and its own idx/key
// parameter both need that same value -- an index/key expr with a side
// effect (a function call, say) must not run twice for one `edit`
// statement. The list/map CONTAINER itself (opA) is always a plain
// variable/per-instance-field reference (never an arbitrary expression --
// same "always a bare global" shape lowTableRowsGlobalName already pins for
// a table's `rows:`), so referencing its printed text twice is safe with no
// temp needed.
func fpUiEditStmt(x: int, kindArg: int, opA: int, opB: int) {
    var winName: string
    var kind: int
    var recName: string
    var t: text
    var lstText: text
    var mapText: text
    var idxT: text
    var keyT: text
    var addrText: text

    winName = poolGet(irtName(irExprType(x)))
    kind = irIntConstV(kindArg)

    if kind == 0 {
        // `edit F, new T` -- T is F's own form record type.
        recName = poolGet(cpFindWindowFormRecName(winName))
        t = fpNewTmp("clar_rec_" + recName)
        fpEmit(t + " = clar_new_" + recName + "();")
        fpEmit("rt_ui_edit(&clar_ui_window_" + winName + ", (const void *)&" + t + ", 1, RT_UI_WB_NONE, 0, 0, 0, 0, 0);")
    } else if kind == 1 {
        // Global or window-scoped per-instance record variable.
        addrText = fpAddrable(opA)
        fpEmit("rt_ui_edit(&clar_ui_window_" + winName + ", (const void *)&(" + addrText + "), 0, RT_UI_WB_ADDR, (void *)&(" + addrText + "), 0, 0, 0, 0);")
    } else if kind == 2 {
        // List element -- src is rt_list_at, RE-DERIVED right here (rt_ui_edit
        // copies immediately, so the transient pointer is safe). cpListPorted
        // (unconditional since 5b) redirects the access call itself to
        // clar_fn_rtListAt, same as fpIndexRef's own KList arm.
        lstText = fpExpr(opA)
        idxT = fpNewTmp("int32_t")
        fpEmit(idxT + " = (int32_t)(" + fpExpr(opB) + ");")
        if cpListPorted {
            fpEmit("rt_ui_edit(&clar_ui_window_" + winName + ", (const void *)clar_fn_rtListAt((void*)" + lstText + ", " + idxT + "), 0, RT_UI_WB_LIST, 0, " + lstText + ", (long)(" + idxT + "), 0, 0);")
        } else {
            fpEmit("rt_ui_edit(&clar_ui_window_" + winName + ", (const void *)rt_list_at(" + lstText + ", " + idxT + "), 0, RT_UI_WB_LIST, 0, " + lstText + ", (long)(" + idxT + "), 0, 0);")
        }
    } else if kind == 3 {
        // Map element -- rt_map has no pointer-returning lookup (only a
        // copy-out get), so the initial value is fetched into a fresh
        // record temp (defaulted via clar_new_T, then overwritten if the
        // key is already present) before the call; the key itself is
        // copied into its own Str255 temp once, reused for both the lookup
        // and the RT_UI_WB_MAP key255 argument.
        mapText = fpExpr(opA)
        keyT = fpNewTmp("clar_str_255")
        if cpStrPorted {
            fpEmit("clar_fn_rtStrStore((void*)&" + keyT + ", 255, (void*)" + fpStrAddr(opB) + ");")
        } else {
            fpEmit("rt_str_store((uint8_t*)&" + keyT + ", 255, " + fpStrAddr(opB) + ");")
        }
        recName = poolGet(cpFindWindowFormRecName(winName))
        t = fpNewTmp("clar_rec_" + recName)
        fpEmit(t + " = clar_new_" + recName + "();")
        // cpMapPorted (unconditional since 5b) redirects the get_dv call
        // itself to clar_fn_rtMapGetDv, same spelling as IMapGetDv above.
        if cpMapPorted {
            fpEmit("clar_fn_rtMapGetDv((void*)" + mapText + ", (void*)&" + keyT + ", (void*)&" + t + ");")
        } else {
            fpEmit("rt_map_get_dv(" + mapText + ", (const uint8_t*)&" + keyT + ", &" + t + ");")
        }
        fpEmit("rt_ui_edit(&clar_ui_window_" + winName + ", (const void *)&" + t + ", 0, RT_UI_WB_MAP, 0, 0, 0, " + mapText + ", (const unsigned char*)&" + keyT + ");")
    }
}

// fpStoreStr prints a clamped string store: `rt_str_store(&dst, CAP, &src);`
// (or, once str.cla is ported, `clar_fn_rtStrStore(&dst, CAP, &src);`) --
// funcprint.go's storeStr. cpEmitGlobalsInit's KStr global-init path routes
// through this same helper, so redirecting it here covers that call site
// too -- no separate cpStrPorted branch needed there.
func fpStoreStr(dst: int, src: int) {
    if cpStrPorted {
        fpEmit("clar_fn_rtStrStore((void*)&(" + fpAddrable(dst) + "), " + numToStr(irtN(irExprType(dst))) + ", (void*)" + fpStrAddr(src) + ");")
    } else {
        fpEmit("rt_str_store((uint8_t*)&(" + fpAddrable(dst) + "), " + numToStr(irtN(irExprType(dst))) + ", " + fpStrAddr(src) + ");")
    }
}

// fpStmt is the per-statement printing funnel (funcprint.go's stmt) --
// re-entrant: SIf/SWhile/SForRange/SForList/SForMap recurse into fpStmts for
// their bodies, which calls back into fpStmt per inner statement.
//
// memory-audit Task 6: fpStmtTmps is save/swapped around the whole call,
// mirroring fpCaptureExpr's fpBody swap (:404) -- a fresh (empty) list
// tracks only the text temps THIS statement's own printing creates, so a
// nested statement's own fpStmt frame tracks and frees its own temps
// independently. Any name still tracked when this statement is done
// (nothing handed it off to a variable/return/container/callee) is freed at
// the tail, after the statement's own C code -- see fpFreeStmtTmps.
func fpStmt(s: int) {
    var e: text
    var d: text
    var v: text
    var saved: list of text
    var fresh: list of text
    var savedRel: list of text
    var freshRel: list of text
    var savedIsRec: list of bool
    var freshIsRec: list of bool
    var savedType: list of int
    var freshType: list of int
    var terminal: bool

    saved = fpStmtTmps
    fpStmtTmps = fresh
    savedRel = fpStmtTmpRel
    fpStmtTmpRel = freshRel
    savedIsRec = fpStmtTmpIsRec
    fpStmtTmpIsRec = freshIsRec
    savedType = fpStmtTmpType
    fpStmtTmpType = freshType
    terminal = false

    if irStmtKind(s) == SExprStmt {
        // ARC Task 8 review round 2: mark this exact node as the
        // discarded-result position (fpDiscardExprIdx's own doc comment) --
        // consulted by fpIntrCall's IListPop/IListShift branch, cleared
        // right after so it can never stick around for a later statement.
        fpDiscardExprIdx = irExprStmtX(s)
        e = fpExpr(irExprStmtX(s))
        fpDiscardExprIdx = -1
        if e != "" {
            // ARC fix-wave Task 3, Part D: a discarded expression statement
            // whose own C text is just a bare temp name (e.g. a
            // rt_list_pop into a scratch temp, side effects already
            // emitted separately above by fpExpr) prints as a lone `tN;`
            // -- valid C, but `cc -Wall` flags it "expression result
            // unused". Wrap ONLY that shape in a (void) cast (the standard
            // idiom for a deliberately discarded value): fpIsBareTempName
            // matches fpNewTmp's own naming convention (`t` + digits)
            // exactly, so a genuine discarded call statement (which cc
            // never warns on) keeps printing unwrapped, unchanged from
            // before -- this is purely a cosmetic warning fix, not a
            // behavior change, and every existing emitui .c.golden stays
            // byte-identical.
            if fpIsBareTempName(e) {
                fpEmit("(void)(" + e + ");")
            } else {
                fpEmit(e + ";")
            }
        }
    } else if irStmtKind(s) == SIf {
        fpIfStmt(s)
    } else if irStmtKind(s) == SAssign {
        d = fpExpr(irAssignDst(s))
        v = fpExpr(irAssignSrc(s))
        if fpIsHandleType(irExprType(irAssignDst(s))) or irtKind(irExprType(irAssignDst(s))) == KRec {
            // A tracked temp assigned into a variable IS that variable's
            // new value now -- handed off, not freed here (ARC Task 3:
            // widened from text-only to List/Map; ARC Task 7 widens again
            // to KRec -- lowCountedStoreRec's own generated
            // `tmp = src`/`dst = tmp` byte-copy assigns, and lowReturn's
            // `retRef = x`, both route a record-returning call's own
            // fpCallFn-materialized tracked temp through a bare SAssign;
            // without this, that temp would auto-release at THIS
            // statement's own end -- immediately, one statement before the
            // very next statement (an IRetain over the SAME now-aliased
            // struct copy) needs those fields still valid: a
            // release-then-use-after-free, not merely a leak).
            fpHandoff(v)
        }
        fpEmit(d + " = " + v + ";")
    } else if irStmtKind(s) == SStoreStr {
        fpStoreStr(irStoreStrDst(s), irStoreStrSrc(s))
    } else if irStmtKind(s) == SWhile {
        fpWhileStmt(s)
    } else if irStmtKind(s) == SForRange {
        fpForRangeStmt(s)
    } else if irStmtKind(s) == SReturn {
        terminal = true
        if irReturnX(s) == -1 {
            fpFreeStmtTmps()
            fpEmit(toText("return;"))
        } else {
            e = fpExpr(irReturnX(s))
            fpHandoff(e) // the returned value escapes to the caller
            // A sub-expression that FED the returned value (e.g. a concat
            // consumed by an outer concat) can still be tracked here and
            // must be freed BEFORE the `return` -- anything emitted after
            // an unconditional jump is unreachable C, never runs.
            fpFreeStmtTmps()
            fpEmit("return " + e + ";")
        }
    } else if irStmtKind(s) == SForList {
        fpForListStmt(s)
    } else if irStmtKind(s) == SForMap {
        fpForMapStmt(s)
    } else if irStmtKind(s) == SBreak {
        terminal = true
        fpFreeStmtTmps()
        fpEmit(toText("break;"))
    } else if irStmtKind(s) == SContinue {
        terminal = true
        fpFreeStmtTmps()
        fpEmit(toText("continue;"))
    }

    if not terminal {
        fpFreeStmtTmps()
    }
    fpStmtTmps = saved
    fpStmtTmpRel = savedRel
    fpStmtTmpIsRec = savedIsRec
    fpStmtTmpType = savedType
}

// fpForListStmt lowers `for x in l { ... }` to an index loop over a count
// snapshotted once at loop entry (Ch5 doesn't promise behavior for a list
// mutated mid-iteration; a fixed count is the simplest defensible choice)
// -- a port of funcprint.go's forListStmt.
func fpForListStmt(s: int) {
    var lv: text
    var lt: text
    var cnt: text
    var ix: text
    var elemC: string
    var vName: string

    lv = fpExpr(irForListListV(s))
    lt = fpNewTmp("rt_list *")
    fpEmit(lt + " = " + lv + ";")
    cnt = fpNewTmp("int32_t")
    // Plan 5b Task 10: only the count snapshot redirects -- the per-
    // iteration rt_list_at deref just below STAYS C (RC boundary).
    if cpListPorted {
        fpEmit(cnt + " = clar_fn_rtListCount((void*)" + lt + ");")
    } else {
        fpEmit(cnt + " = rt_list_count(" + lt + ");")
    }
    ix = fpNewTmp("int32_t")
    elemC = cpCType(irtElem(irExprType(irForListListV(s))))
    vName = poolGet(irForListV(s))
    fpEmit("for (" + ix + " = 0; " + ix + " < " + cnt + "; " + ix + "++) {")
    fpIndent = fpIndent + 1
    fpEmit("cv_" + vName + " = *(" + elemC + "*)rt_list_at(" + lt + ", " + ix + ");")
    fpStmts(irForListBody(s))
    fpIndent = fpIndent - 1
    fpEmit(toText("}"))
}

// fpForMapStmt lowers `for k, v in m { ... }` to an index loop over
// rt_map_count/rt_map_key_at/rt_map_val_at -- ascending key order, per
// rt.c's CONTRACT comment on rt_map -- a port of funcprint.go's
// forMapStmt. The value fetch only emits when the loop declared a V:
// irForMapV(s) is -1 (parseForStmt's own "no second IDENT" signal,
// threaded straight through lowFor) when the loop wrote `for k in m`
// without a value variable.
func fpForMapStmt(s: int) {
    var mv: text
    var mt: text
    var cnt: text
    var ix: text
    var vNameIdx: int

    mv = fpExpr(irForMapMapV(s))
    mt = fpNewTmp("rt_map *")
    fpEmit(mt + " = " + mv + ";")
    cnt = fpNewTmp("int32_t")
    // Plan 5b Task 11: cpMapPorted redirects count/key_at/val_at (all
    // three ported, not RC) -- the loop structure itself is unchanged.
    if cpMapPorted {
        fpEmit(cnt + " = clar_fn_rtMapCount((void*)" + mt + ");")
    } else {
        fpEmit(cnt + " = rt_map_count(" + mt + ");")
    }
    ix = fpNewTmp("int32_t")
    fpEmit("for (" + ix + " = 0; " + ix + " < " + cnt + "; " + ix + "++) {")
    fpIndent = fpIndent + 1
    if cpMapPorted {
        fpEmit("clar_fn_rtMapKeyAt((void*)" + mt + ", " + ix + ", (void*)&cv_" + poolGet(irForMapK(s)) + ");")
    } else {
        fpEmit("rt_map_key_at(" + mt + ", " + ix + ", (uint8_t*)&cv_" + poolGet(irForMapK(s)) + ");")
    }
    vNameIdx = irForMapV(s)
    if vNameIdx != -1 {
        if cpMapPorted {
            fpEmit("clar_fn_rtMapValAt((void*)" + mt + ", " + ix + ", (void*)&cv_" + poolGet(vNameIdx) + ");")
        } else {
            fpEmit("rt_map_val_at(" + mt + ", " + ix + ", &cv_" + poolGet(vNameIdx) + ");")
        }
    }
    fpStmts(irForMapBody(s))
    fpIndent = fpIndent - 1
    fpEmit(toText("}"))
}

// fpWhileStmt prints `while (1) { <cond's temps, re-run every iteration>;
// if (!(cond)) break; <body> }` rather than a plain C `while (cond)`: cond
// may itself need statement-level temporaries (e.g. a string concat), which
// must be recomputed every iteration, not hoisted out and reused stale --
// funcprint.go's whileStmt.
//
// memory-audit Task 6: cond's own construction lands INSIDE this `while (1)`
// block (not hoisted before it), so a text temp it creates is rebuilt fresh
// every iteration -- freeing it only once, after the loop (fpStmt's usual
// end-of-statement tail), would leak every iteration but the last. Nothing
// hands off a condition value (it's read by a comparison/`!`, never stored),
// so whatever fpExpr(cond) tracked is exactly the temps to free; flush them
// here, right after the break check, once per iteration, before the body
// (which tracks/frees its own temps independently via its own fpStmt calls).
//
// ARC Task 8 fix (corpus regression fixture p9_while_cond.cla, documented
// leak pinned since the memory-audit-4e whole-branch review): the free
// call above only ever sits on the "loop continues" path -- textually AFTER
// `if (!(cond)) break;`, so the FINAL (false) evaluation's own temps are
// never reached; `break` jumps straight out. That leaked exactly one
// condition-temp per loop EXECUTION (not per iteration). Fix: when cond
// tracked at least one temp, print the SAME release lines into the break
// branch too (fpEmitTmpRelease reads fpStmtTmps/fpStmtTmpRel/fpStmtTmpIsRec
// by position without mutating them, so calling it here and then letting
// the ordinary fpFreeStmtTmps() call below ALSO iterate+clear is safe --
// the two printed copies sit on mutually exclusive runtime paths, so
// exactly one of them ever executes for any given iteration). A condition
// with no temps at all (the common case -- a plain int/bool comparison)
// keeps the original one-line `if (!(cond)) break;`, unchanged.
func fpWhileStmt(s: int) {
    var cond: text
    var i: int

    fpEmit(toText("while (1) {"))
    fpIndent = fpIndent + 1
    cond = fpExpr(irWhileCond(s))
    if fpStmtTmps.count > 0 {
        fpEmit("if (!(" + cond + ")) {")
        fpIndent = fpIndent + 1
        i = 0
        while i < fpStmtTmps.count {
            fpEmitTmpRelease(i)
            i = i + 1
        }
        fpEmit(toText("break;"))
        fpIndent = fpIndent - 1
        fpEmit(toText("}"))
    } else {
        fpEmit("if (!(" + cond + ")) break;")
    }
    fpFreeStmtTmps()
    fpStmts(irWhileBody(s))
    fpIndent = fpIndent - 1
    fpEmit(toText("}"))
}

// fpForRangeStmt evaluates From/To once into temps (never re-embeds their
// expression text into the loop header, which would re-evaluate -- and for
// a From/To that's a function call, re-run -- them every iteration) and
// loops the bound variable, already declared at function top, over
// [from, to] inclusive -- funcprint.go's forRangeStmt.
func fpForRangeStmt(s: int) {
    var from: text
    var ft: text
    var toVal: text
    var tt: text
    var vName: string

    from = fpExpr(irForRangeFrom(s))
    ft = fpNewTmp("int32_t")
    fpEmit(ft + " = " + from + ";")
    toVal = fpExpr(irForRangeTo(s))
    tt = fpNewTmp("int32_t")
    fpEmit(tt + " = " + toVal + ";")
    vName = poolGet(irForRangeV(s))
    fpEmit("for (cv_" + vName + " = " + ft + "; cv_" + vName + " <= " + tt + "; cv_" + vName + "++) {")
    fpIndent = fpIndent + 1
    fpStmts(irForRangeBody(s))
    fpIndent = fpIndent - 1
    fpEmit(toText("}"))
}

// fpStripOuterParens removes one matching outer parenthesis pair from s, if
// present -- a port of funcprint.go's stripOuterParens. fpExpr always wraps
// a Bin/Un result in its own parens (needed when nested inside another
// expression); printed directly as an `if (...)` condition, a top-level
// comparison would come out double-parenthesized (`if ((a == b))`). Used
// only where the condition becomes the entire, sole content of a C
// `if (...)`.
func fpStripOuterParens(s: text): text {
    var depth: int
    var i: int
    var c: char
    var r: text

    if s.length < 2 or s[0] != '(' or s[s.length - 1] != ')' {
        return s
    }
    depth = 0
    i = 0
    while i < s.length {
        c = s[i]
        if c == '(' {
            depth = depth + 1
        } else if c == ')' {
            depth = depth - 1
            if depth == 0 and i != s.length - 1 {
                return s
            }
        }
        i = i + 1
    }
    // Build the inner run s[1 .. length-2] by appending each char: a text
    // slice (s[1, length-2]) would route through rt_text_slice into a
    // clar_str_255, re-imposing the 255-byte cap this whole change removes
    // (and overflowing outright on a long condition). Char-append is
    // uncapped and byte-identical.
    r = ""
    i = 1
    while i < s.length - 1 {
        r.append(s[i])
        i = i + 1
    }
    return r
}

// fpIfStmt prints an SIf node (funcprint.go's ifStmt).
// memory-audit Task 6 (review fix): if the condition itself created a text
// temp (e.g. a concat feeding a comparison), that temp is tracked at the
// SIf statement's level (fpStmt's own fpStmtTmps), meant to be freed by
// fpStmt's generic end-of-statement flush AFTER this whole if/else prints.
// But a `return`/`break`/`continue` inside either branch jumps out of the
// generated C before that flush ever runs -- the same trap fpWhileStmt's
// condition already had to dodge. Fix: when the condition creates a temp,
// materialize its bool value into a flag (same trick fpAndOr uses for its
// own short-circuit result) and free right after, BEFORE printing the
// `if`/branches at all -- the free then always runs exactly once,
// regardless of which branch is taken or whether it exits early. A
// condition with no temps (the overwhelming common case) is untouched:
// still a plain, direct `if (cond) {`.
func fpIfStmt(s: int) {
    var cond: text
    var flag: text
    var markCount: int

    markCount = fpStmtTmps.count
    cond = fpStripOuterParens(fpExpr(irIfCond(s)))
    if fpStmtTmps.count > markCount {
        flag = fpNewTmp("int32_t")
        fpEmit(flag + " = " + cond + ";")
        fpFreeStmtTmps()
        cond = flag
    }
    fpEmit("if (" + cond + ") {")
    fpIndent = fpIndent + 1
    fpStmts(irIfThen(s))
    fpIndent = fpIndent - 1
    if irIfElse(s) != -1 {
        fpEmit(toText("} else {"))
        fpIndent = fpIndent + 1
        fpStmts(irIfElse(s))
        fpIndent = fpIndent - 1
    }
    fpEmit(toText("}"))
}

func fpStmts(head: int) {
    var s: int

    s = head
    while s != -1 {
        fpStmt(s)
        s = irStmtNext(s)
    }
}

// ================================================================
// Function + main printing (cprint.go subset)
// ================================================================

// cpFuncProto renders a function/handler's C prototype (cprint.go's
// funcProto), without the trailing ";" or " {". params/the return value are
// `text`, not `string`: a `string` is a fixed 255-byte buffer, and a
// function with enough params (or record-typed/long-named ones) produces a
// comma-joined param list that can run past that -- the same class of bug
// cpEmitEnums had (fixed above) for an enum's ordinal list.
func cpFuncProto(f: int): text {
    var params: text
    var p: int
    var first: bool

    params = toText("")
    first = true
    p = irFuncParamsHead(f)
    while p != -1 {
        if not first {
            params = params + ", "
        }
        first = false
        params = params + cpCType(irLocalType(p)) + " cv_" + poolGet(irLocalName(p))
        p = irLocalNext(p)
    }
    if first {
        params = toText("void")
    }
    return toText("static " + cpCType(irFuncRet(f)) + " clar_fn_" + poolGet(irFuncName(f)) + "(") + params + toText(")")
}

// cpDefaultInit emits the default-value statement(s) for dst at type t, via
// fpEmit (so it lands wherever the caller's fpBody/fpIndent currently point
// -- a record's clar_new_NAME ctor, clar_init_globals, or a function's local
// declarations all reuse this same one code path, exactly like Go's
// defaultInit being one function called from emitRecords/emitGlobalsAndInit/
// emitFunc alike): `dst = 0;` for a scalar, a clamped rt_str_store for a Str
// default (or `dst = (clar_str_N){0};` with no override), `dst =
// rt_text_new();` (+ a store, if a string default) for Text, a fresh
// list/map handle, `dst = clar_new_NAME();` for a Rec (which itself applies
// that record's OWN per-field defaults -- a nil-Init Rec value gets exactly
// the same defaults as clar_new_NAME because this is that same function),
// `{0, ""}`-equivalent field-by-field zeroing for Err, and an unrolled
// bounds-checked `for` loop recursing into the element type for Arr -- a
// port of defaults.go's defaultInit. scalarDefault/strDefault are 0/-1 (no
// override) for every nil-Init global/local; a record field's OWN default
// (IRFieldSlot.default/defaultStr) is passed through by cpEmitRecords.
func cpDefaultInit(dst: text, t: int, scalarDefault: int, strDefault: int) {
    var k: IRKind
    var ix: text

    k = irtKind(t)
    if k == KInt or k == KBool or k == KFixed or k == KChar or k == KEnum {
        fpEmit(dst + " = " + numToStr(scalarDefault) + ";")
    } else if k == KWinRef or k == KPtr or k == KOverlay {
        // `var w: SomeWindow` declares a nil window reference (Ch8) -- a
        // plain NULL `void *`, same spelling nil itself lowers to (lower.cla's
        // ExNilLit case). `var p: ptr` gets the same treatment (Ch13's zero
        // value of ptr is the null address, tested via ptr(0)). `var o:
        // SomeOverlay` (Ch13: Overlay Records) is the same NULL C pointer --
        // an overlay's zero value is the null address too (tested via
        // ptr(o) == ptr(0)).
        fpEmit(dst + " = 0;")
    } else if k == KStr {
        if strDefault < 0 {
            fpEmit(dst + " = (" + cpCType(t) + "){0};")
        } else if cpStrPorted {
            fpEmit("clar_fn_rtStrStore((void*)&(" + dst + "), " + numToStr(irtN(t)) + ", (void*)&clar_lit_" + numToStr(strDefault) + ");")
        } else {
            fpEmit("rt_str_store((uint8_t*)&(" + dst + "), " + numToStr(irtN(t)) + ", (const uint8_t*)&clar_lit_" + numToStr(strDefault) + ");")
        }
    } else if k == KText {
        // Plan 5b Task 9: cpTextPorted redirects both the birth call
        // (rtTextNew, cast back to `rt_text *`) and the optional string
        // default's store (rtTextStore's params are ptr, so the literal's
        // address needs the `(void*)` wrap -- same discipline as every
        // other cpTextPorted arm in fpIntrCall above).
        if cpTextPorted {
            fpEmit(dst + " = (rt_text *)clar_fn_rtTextNew();")
            if strDefault >= 0 {
                fpEmit("clar_fn_rtTextStore((void*)" + dst + ", (void*)&clar_lit_" + numToStr(strDefault) + ");")
            }
        } else {
            fpEmit(dst + " = rt_text_new();")
            if strDefault >= 0 {
                fpEmit("rt_text_store(" + dst + ", (const uint8_t*)&clar_lit_" + numToStr(strDefault) + ");")
            }
        }
    } else if k == KList {
        // Plan 5b Task 10: cpListPorted redirects the birth call (rtListNew,
        // cast back to `rt_list *`) -- same "external delegation" pattern
        // KText's arm above established for rtTextNew.
        if cpListPorted {
            fpEmit(dst + " = (rt_list *)clar_fn_rtListNew(sizeof(" + cpCType(irtElem(t)) + "));")
        } else {
            fpEmit(dst + " = rt_list_new(sizeof(" + cpCType(irtElem(t)) + "));")
        }
    } else if k == KMap {
        // Plan 5b Task 11: cpMapPorted redirects the birth call (rtMapNew,
        // cast back to `rt_map *`) -- same "external delegation" pattern
        // KText/KList's arms above established for rtTextNew/rtListNew.
        if cpMapPorted {
            fpEmit(dst + " = (rt_map *)clar_fn_rtMapNew(sizeof(" + cpCType(irtElem(t)) + "));")
        } else {
            fpEmit(dst + " = rt_map_new(sizeof(" + cpCType(irtElem(t)) + "));")
        }
    } else if k == KRec {
        fpEmit(dst + " = clar_new_" + poolGet(irtName(t)) + "();")
    } else if k == KErr {
        fpEmit(dst + ".code = 0;")
        fpEmit(dst + ".message = (clar_str_255){0};")
    } else if k == KArr {
        cpLoopN = cpLoopN + 1
        ix = "ix" + numToStr(cpLoopN)
        fpEmit("for (int32_t " + ix + " = 0; " + ix + " < " + numToStr(irtN(t)) + "; " + ix + "++) {")
        fpIndent = fpIndent + 1
        cpDefaultInit(dst + ".e[" + ix + "]", irtElem(t), 0, -1)
        fpIndent = fpIndent - 1
        fpEmit(toText("}"))
    }
}

// cpEmitRelease (ARC Task 2: renamed+upgraded from memory-audit Task 5's
// cpEmitFree, now that Task 1's runtime made rt_text_free/rt_list_free/
// rt_map_free one-line aliases for rt_text_release/rt_list_release/
// rt_map_release -- identical behavior at rc==1, the only case any
// call site below actually reaches yet) appends to dst the release
// statement(s) that drop cexpr's (an lvalue C expression) OWN reference at
// IR type t -- the shallow-plus rule (memory-audit spec, Task 5, unchanged
// by this rename): KText releases its own buffer; KList/KMap release their
// own handle, plus -- when the element/value type is itself KText OR a
// handle-backed KRec (ARC Task 7, carry-forward 3 from Task 2's review) --
// a loop releasing each element's own reference(s) first (an element type
// that is itself KList/KMap, or an all-scalar KRec, is left alone: shallow
// only, matching Ch3 reference semantics, until a later ARC task / because
// there is nothing to release); KArr/KRec recurse into exactly the slots
// cpDefaultInit constructs (mirroring its KArr/KRec branches above, so the
// release walk precisely mirrors what init built); every other kind emits
// nothing. A reusable helper -- called here for globals, and again by
// later tasks for function-local and record-field disposal.
func cpEmitRelease(dst: text, cexpr: string, t: int) {
    var k: IRKind
    var et: int
    var f: int
    var ix: string
    var en: string
    var ri: int
    var recName: string
    var lastrefCall: string
    var atPrefix: string
    var countCall: string
    var valAtFn: string
    var mArg: string
    var outCast: string

    k = irtKind(t)
    if k == KText {
        // Plan 5c wave2a Task 2: cpTextArcPorted redirects to the
        // Clarus-ported rtTextRelease.
        if cpTextArcPorted {
            cpAppendLine(dst, "    clar_fn_rtTextRelease((void*)" + cexpr + ");")
        } else {
            cpAppendLine(dst, "    rt_text_release(" + cexpr + ");")
        }
    } else if k == KList {
        et = irtElem(t)
        // Plan 5c wave2a Task 3: the walk-internal `rt_list_lastref`/
        // `rt_list_at`/`rt_list_count` calls every branch below composes
        // redirect independently -- `rt_list_lastref` via THIS task's own
        // cpListArcPorted (an ARC operation, same flag as the container's
        // own retain/release/dispose below); `rt_list_at`/`rt_list_count`
        // via the EXISTING cpListPorted flag (wave1, already unconditionally
        // true -- these are plain interior-pointer/count accessors, not ARC
        // operations themselves; list.cla's own module header comment
        // documents why rtListAt is gated this way). atPrefix omits its
        // trailing index argument/close-paren so each branch below can
        // append its own index variable name (`i` or `ixN`).
        if cpListArcPorted {
            lastrefCall = "clar_fn_rtListLastref((void*)" + cexpr + ")"
        } else {
            lastrefCall = "rt_list_lastref(" + cexpr + ")"
        }
        if cpListPorted {
            atPrefix = "clar_fn_rtListAt((void*)" + cexpr + ", "
            countCall = "clar_fn_rtListCount((void*)" + cexpr + ")"
        } else {
            atPrefix = "rt_list_at(" + cexpr + ", "
            countCall = "rt_list_count(" + cexpr + ")"
        }
        if irtKind(et) == KText {
            // ARC Task 6 fix round 3 (reviewer Critical: shared-container
            // element double-free): the element walk only runs when THIS
            // release is the container's own LAST reference
            // (rt_list_lastref reads rc BEFORE the rt_list_release call
            // below decrements it) -- two release call sites sharing one
            // rc>=2 list must not each walk and re-release the same
            // elements; only the site that actually drops the container to
            // 0 may free what it owns. Every caller of cpEmitRelease (local
            // scope-exit, window-var teardown, cl_free_globals, record
            // element/field recursion via cpEmitRcWalks) funnels through
            // this one branch, so the guard covers all of them at once.
            // Plan 5c wave2a Task 2: cpTextArcPorted redirects the
            // element's own release to the Clarus-ported rtTextRelease.
            if cpTextArcPorted {
                cpAppendLine(dst, "    if (" + lastrefCall + ") { int32_t i; for (i = 0; i < " + countCall + "; i++) clar_fn_rtTextRelease((void*)*(rt_text **)" + atPrefix + "i)); }")
            } else {
                cpAppendLine(dst, "    if (" + lastrefCall + ") { int32_t i; for (i = 0; i < " + countCall + "; i++) rt_text_release(*(rt_text **)" + atPrefix + "i)); }")
            }
        } else if irtKind(et) == KRec and irRecHasHandleField(irtName(et)) {
            // ARC Task 7 (carry-forward 3, Task 2 review): a list-of-record
            // element is stored BY VALUE inline in the backing array
            // (rt_list_at returns a pointer straight to the struct, unlike
            // Text's pointer-to-pointer) -- release each element's own
            // clar_release_NAME walk in place, same rt_list_lastref guard
            // as the KText case (shared-container double-free protection),
            // same handle-backed gate as every other Task 7 site.
            recName = poolGet(irtName(et))
            irMarkRcWalkNeeded(irtName(et))
            cpAppendLine(dst, "    if (" + lastrefCall + ") { int32_t i; for (i = 0; i < " + countCall + "; i++) clar_release_" + recName + "((clar_rec_" + recName + " *)" + atPrefix + "i)); }")
        } else if irtKind(et) == KList or irtKind(et) == KMap {
            // ARC Task 8 (carry-forward 3): a NESTED container element
            // (`list of list of text`, `list of map of text`, ... -- the
            // type system permits arbitrary nesting: parseType/resolveType
            // both recurse on the element type with no kind restriction,
            // confirmed by direct probe, so this is reachable, not merely
            // hypothetical) needs its own full release walk, not just a
            // bare handle release -- recurse into cpEmitRelease per
            // element, inheriting whatever the ELEMENT's own type needs
            // (another nesting level, or nothing further). Still gated by
            // the SAME rt_list_lastref guard as every other element-walk
            // branch here (shared-container double-free protection, Task 6
            // round 3): decrementing the OUTER container's rc more than
            // once is exactly the same hazard for a container element as
            // for a Text/Rec one.
            //
            // Copies each element out into a freshly-named LOCAL (`enN`)
            // before recursing, rather than recursing directly on a
            // composed `rt_list_at(cexpr, ix)` expression string (the way
            // KArr's own recursion, just below, safely can for a fixed
            // array -- there, the index chain is always short: `.e[ixN]`
            // per level). Every level of THIS recursion is instead
            // re-embedding a growing `cexpr` -- `cpEmitRelease`'s own
            // `cexpr` parameter is a capacity-255 `string`, silently
            // truncated by Ch3's fixed-string semantics past that -- and a
            // truncated cexpr is corrupt C, not a compile error, found by
            // probing 3+ levels of nesting directly (`list of list of list
            // of text`) and reading the truncated output before this fix.
            // A short, constant-length local name keeps every level's own
            // line length bounded regardless of nesting depth.
            cpLoopN = cpLoopN + 1
            ix = "ix" + numToStr(cpLoopN)
            en = "en" + numToStr(cpLoopN)
            cpAppendLine(dst, "    if (" + lastrefCall + ") {")
            cpAppendLine(dst, "    for (int32_t " + ix + " = 0; " + ix + " < " + countCall + "; " + ix + "++) {")
            cpAppendLine(dst, "    " + cpCType(et) + " " + en + " = *(" + cpCType(et) + "*)" + atPrefix + ix + ");")
            cpEmitRelease(dst, en, et)
            cpAppendLine(dst, "    }")
            cpAppendLine(dst, "    }")
        }
        // Plan 5c wave2a Task 3: cpListArcPorted redirects to the
        // Clarus-ported rtListRelease.
        if cpListArcPorted {
            cpAppendLine(dst, "    clar_fn_rtListRelease((void*)" + cexpr + ");")
        } else {
            cpAppendLine(dst, "    rt_list_release(" + cexpr + ");")
        }
    } else if k == KMap {
        et = irtElem(t)
        // Plan 5c wave2a Task 4: the walk-internal `rt_map_lastref`/
        // `rt_map_val_at`/`rt_map_count` calls every branch below composes
        // redirect independently -- `rt_map_lastref` via THIS task's own
        // cpMapArcPorted (an ARC operation, same flag as the container's
        // own retain/release/dispose below); `rt_map_val_at`/`rt_map_count`
        // via the EXISTING cpMapPorted flag (wave1, already unconditionally
        // true -- these are plain accessors, not ARC operations themselves;
        // map.cla's own module header comment documents why they're gated
        // this way, same split as List's own rtListAt/rtListCount). Unlike
        // List's atPrefix (an address-returning call), Map's val_at is an
        // out-param call (`rt_map_val_at(m, i, &out)`/
        // `clar_fn_rtMapValAt((void*)m, i, (void*)&out)`) -- valAtFn/mArg/
        // outCast let each branch below compose its own call with its own
        // index/output-variable names.
        if cpMapArcPorted {
            lastrefCall = "clar_fn_rtMapLastref((void*)" + cexpr + ")"
        } else {
            lastrefCall = "rt_map_lastref(" + cexpr + ")"
        }
        if cpMapPorted {
            countCall = "clar_fn_rtMapCount((void*)" + cexpr + ")"
            valAtFn = "clar_fn_rtMapValAt"
            mArg = "(void*)" + cexpr
            outCast = "(void*)"
        } else {
            countCall = "rt_map_count(" + cexpr + ")"
            valAtFn = "rt_map_val_at"
            mArg = cexpr
            outCast = ""
        }
        if irtKind(et) == KText {
            // Same guard, same reasoning as KList just above. Plan 5c
            // wave2a Task 2: cpTextArcPorted redirects the element's own
            // release.
            if cpTextArcPorted {
                cpAppendLine(dst, "    if (" + lastrefCall + ") { int32_t i; rt_text *v; for (i = 0; i < " + countCall + "; i++) { " + valAtFn + "(" + mArg + ", i, " + outCast + "&v); clar_fn_rtTextRelease((void*)v); } }")
            } else {
                cpAppendLine(dst, "    if (" + lastrefCall + ") { int32_t i; rt_text *v; for (i = 0; i < " + countCall + "; i++) { " + valAtFn + "(" + mArg + ", i, " + outCast + "&v); rt_text_release(v); } }")
            }
        } else if irtKind(et) == KRec and irRecHasHandleField(irtName(et)) {
            // ARC Task 7 (carry-forward 3): a map value is copied OUT by
            // rt_map_val_at (the map's own internal storage is opaque
            // bytes, unlike a list's directly-addressable backing array),
            // so the release walk runs on a LOCAL copy `v` -- which shares
            // the SAME underlying handle-field pointers the map's own
            // stored bytes still hold, so releasing it correctly drops
            // those handles' rc exactly once (mirrors the KText case's own
            // local `rt_text *v` copy-out-then-release shape).
            recName = poolGet(irtName(et))
            irMarkRcWalkNeeded(irtName(et))
            cpAppendLine(dst, "    if (" + lastrefCall + ") { int32_t i; clar_rec_" + recName + " v; for (i = 0; i < " + countCall + "; i++) { " + valAtFn + "(" + mArg + ", i, " + outCast + "&v); clar_release_" + recName + "(&v); } }")
        } else if irtKind(et) == KList or irtKind(et) == KMap {
            // ARC Task 8 (carry-forward 3) -- same nested-container reasoning
            // as the KList branch just above, adapted for a map value: a map's
            // own internal storage is opaque bytes (unlike a list's directly
            // addressable backing array), so each element is copied OUT into a
            // local `v` first (same shape the KRec-in-map case just above
            // uses), then released via a recursive cpEmitRelease call.
            cpLoopN = cpLoopN + 1
            ix = "ix" + numToStr(cpLoopN)
            cpAppendLine(dst, "    if (" + lastrefCall + ") {")
            cpAppendLine(dst, "    { int32_t " + ix + "; " + cpCType(et) + " v" + numToStr(cpLoopN) + ";")
            cpAppendLine(dst, "    for (" + ix + " = 0; " + ix + " < " + countCall + "; " + ix + "++) {")
            cpAppendLine(dst, "    " + valAtFn + "(" + mArg + ", " + ix + ", " + outCast + "&v" + numToStr(cpLoopN) + ");")
            cpEmitRelease(dst, "v" + numToStr(cpLoopN), et)
            cpAppendLine(dst, "    }")
            cpAppendLine(dst, "    }")
            cpAppendLine(dst, "    }")
        }
        // Plan 5c wave2a Task 4: cpMapArcPorted redirects to the
        // Clarus-ported rtMapRelease.
        if cpMapArcPorted {
            cpAppendLine(dst, "    clar_fn_rtMapRelease((void*)" + cexpr + ");")
        } else {
            cpAppendLine(dst, "    rt_map_release(" + cexpr + ");")
        }
    } else if k == KArr {
        et = irtElem(t)
        if irtNeedsCtor(et) {
            cpLoopN = cpLoopN + 1
            ix = "ix" + numToStr(cpLoopN)
            cpAppendLine(dst, "    for (int32_t " + ix + " = 0; " + ix + " < " + numToStr(irtN(t)) + "; " + ix + "++) {")
            cpEmitRelease(dst, cexpr + ".e[" + ix + "]", et)
            cpAppendLine(dst, "    }")
        }
    } else if k == KRec {
        ri = 0
        while ri < irRecords.count {
            if irRecordLayoutName(ri) == irtName(t) {
                f = irRecordLayoutFieldsHead(ri)
                while f != -1 {
                    if irtNeedsCtor(irFieldSlotType(f)) {
                        cpEmitRelease(dst, cexpr + ".cv_" + poolGet(irFieldSlotName(f)), irFieldSlotType(f))
                    }
                    f = irFieldSlotNext(f)
                }
                ri = irRecords.count
            } else {
                ri = ri + 1
            }
        }
    }
}

// cpEmitRetain (ARC Task 2) appends to dst the retain statement(s) that add
// ONE more owner of cexpr's OWN reference at IR type t -- the retain-side
// mirror of cpEmitRelease immediately above, walking exactly the same
// KArr/KRec slots cpEmitRelease/cpDefaultInit do. Deliberately NOT
// symmetric with cpEmitRelease's KList/KMap element loop: retaining a
// container only needs to bump the CONTAINER's own rc (its elements stay
// owned by that one container reference, same as before this reference was
// copied) -- see the ARC design doc's "deep release, shallow retain"
// rationale. Used by cpEmitRcWalks below to build a record type's
// generated clar_retain_NAME walk helper.
func cpEmitRetain(dst: text, cexpr: string, t: int) {
    var k: IRKind
    var et: int
    var f: int
    var ix: string
    var ri: int

    k = irtKind(t)
    if k == KText {
        // Plan 5c wave2a Task 2: cpTextArcPorted redirects to the
        // Clarus-ported rtTextRetain.
        if cpTextArcPorted {
            cpAppendLine(dst, "    clar_fn_rtTextRetain((void*)" + cexpr + ");")
        } else {
            cpAppendLine(dst, "    rt_text_retain(" + cexpr + ");")
        }
    } else if k == KList {
        // Plan 5c wave2a Task 3: cpListArcPorted redirects to the
        // Clarus-ported rtListRetain.
        if cpListArcPorted {
            cpAppendLine(dst, "    clar_fn_rtListRetain((void*)" + cexpr + ");")
        } else {
            cpAppendLine(dst, "    rt_list_retain(" + cexpr + ");")
        }
    } else if k == KMap {
        // Plan 5c wave2a Task 4: cpMapArcPorted redirects to the
        // Clarus-ported rtMapRetain.
        if cpMapArcPorted {
            cpAppendLine(dst, "    clar_fn_rtMapRetain((void*)" + cexpr + ");")
        } else {
            cpAppendLine(dst, "    rt_map_retain(" + cexpr + ");")
        }
    } else if k == KArr {
        et = irtElem(t)
        if irtNeedsCtor(et) {
            cpLoopN = cpLoopN + 1
            ix = "ix" + numToStr(cpLoopN)
            cpAppendLine(dst, "    for (int32_t " + ix + " = 0; " + ix + " < " + numToStr(irtN(t)) + "; " + ix + "++) {")
            cpEmitRetain(dst, cexpr + ".e[" + ix + "]", et)
            cpAppendLine(dst, "    }")
        }
    } else if k == KRec {
        ri = 0
        while ri < irRecords.count {
            if irRecordLayoutName(ri) == irtName(t) {
                f = irRecordLayoutFieldsHead(ri)
                while f != -1 {
                    if irtNeedsCtor(irFieldSlotType(f)) {
                        cpEmitRetain(dst, cexpr + ".cv_" + poolGet(irFieldSlotName(f)), irFieldSlotType(f))
                    }
                    f = irFieldSlotNext(f)
                }
                ri = irRecords.count
            } else {
                ri = ri + 1
            }
        }
    }
}

// cpEmitRcWalks (ARC Task 2; gate unified onto irRecHasHandleField by ARC
// Task 7 -- see that function's doc comment for the gate-asymmetry
// rationale) emits, for every record type IRetain/IRelease's fpIntrCall
// case marked via irMarkRcWalkNeeded, a
// `static void clar_retain_<Rec>(clar_rec_<Rec> *r)` /
// `static void clar_release_<Rec>(clar_rec_<Rec> *r)` pair into cpRecBuf,
// right after cpEmitRecords' own clar_new_<Rec> constructors. A marked
// record type with zero handle-backed fields (irRecHasHandleField) gets no
// walk pair at all -- retaining/releasing it would be a no-op, so there's
// nothing to generate, and every CALLER of clar_retain_NAME/
// clar_release_NAME (lower.cla's copy sites, cprint.cla's tracked-temp/
// container-element helpers) consults this SAME predicate before ever
// emitting a call, so a marked-but-scalar-only type can't happen.
//
// ARC Task 7: emitProgram() now calls this AFTER cpEmitFuncs()/
// cpEmitGlobalsInit() (moved from right after cpEmitRecords, its original
// Task 2 position) -- irMarkRcWalkNeeded only ever fires from INSIDE
// fpIntrCall's IRetain/IRelease dispatch while PRINTING a function/handler
// body or a global's Init, both of which happen later in emitProgram()'s
// own call sequence; running this walk-pair emitter before any of that
// printing had occurred would read an empty irRcWalkNeededByName every
// time, silently dropping every mark (found by tracing emitProgram()'s
// call order while diagnosing why marks set during this task's own
// hand-probes never produced a walk pair -- moving WHEN this populates
// cpRecBuf doesn't move WHERE cpRecBuf's contents land in the final
// output: emitProgram()'s bottom assembly step reads cpRecBuf once, after
// every cpEmit* call has run, regardless of call order).
// cpEmitOneRcWalk builds and appends ONE record type's clar_retain_NAME/
// clar_release_NAME pair into cpRecBuf -- split out of cpEmitRcWalks (ARC
// Task 7) so retainBody/releaseBody are fresh, function-LOCAL text values
// on every call, never a single outer-scope local reset-and-reused across
// multiple walk-pair emissions in the same loop -- a pattern that was
// found, empirically, to corrupt an EARLIER call's already-pushed
// cpRecBuf entry once a SECOND record's walk pair got built in the same
// cpEmitRcWalks invocation (reproduced with a minimal two-record fixture;
// root cause not fully isolated, but eliminated by construction here:
// each record's own retainBody/releaseBody now live only as long as this
// one function call, with no reuse across records at all).
func cpEmitOneRcWalk(i: int, name: int) {
    var f: int
    var recName: string
    var ctype: string
    var retainBody: text
    var releaseBody: text

    recName = poolGet(name)
    ctype = "clar_rec_" + recName
    retainBody = ""
    releaseBody = ""
    f = irRecordLayoutFieldsHead(i)
    while f != -1 {
        if irtNeedsCtor(irFieldSlotType(f)) {
            cpEmitRetain(retainBody, "r->cv_" + poolGet(irFieldSlotName(f)), irFieldSlotType(f))
            cpEmitRelease(releaseBody, "r->cv_" + poolGet(irFieldSlotName(f)), irFieldSlotType(f))
        }
        f = irFieldSlotNext(f)
    }
    cpRecBuf.add(toText("static void clar_retain_" + recName + "(" + ctype + " *r) {"))
    cpRecBuf.add(retainBody)
    cpRecBuf.add(toText("}"))
    cpRecBuf.add(toText(""))
    cpRecBuf.add(toText("static void clar_release_" + recName + "(" + ctype + " *r) {"))
    cpRecBuf.add(releaseBody)
    cpRecBuf.add(toText("}"))
    cpRecBuf.add(toText(""))
}

func cpEmitRcWalks() {
    var i: int
    var name: int

    i = 0
    while i < irRecords.count {
        name = irRecordLayoutName(i)
        if irRcWalkNeeded(name) and irRecHasHandleField(name) {
            cpEmitOneRcWalk(i, name)
        }
        i = i + 1
    }
}

// cpZeroLiteral renders a type-correct placeholder value for t, for the
// unreachable trailing return cpEmitFunc appends after a non-void body
// (types.go's zeroLiteral).
func cpZeroLiteral(t: int): string {
    var k: IRKind

    k = irtKind(t)
    if k == KText or k == KList or k == KMap {
        return "NULL"
    } else if k == KRec {
        return "clar_new_" + poolGet(irtName(t)) + "()"
    } else if k == KStr or k == KArr or k == KErr {
        return "(" + cpCType(t) + "){0}"
    }
    return "0"
}

// cpEmitFunc appends one function's full definition to cpRestBuf
// (cprint.go's emitFunc). Skeleton: scalar-only locals default-init, no
// trailing return (handlers are void).
func cpEmitFunc(f: int) {
    var loc: int
    var i: int
    var declared: map of int
    var nm: string

    cpEnsureType(irFuncRet(f))
    fpReset(1)

    // Every local (var-declared, or a for-range loop's bound variable) is
    // hoisted to the top of the C function (Ch5: "var only at the top of a
    // function/handler body"). Two sibling (non-nested, non-overlapping)
    // for-range loops reusing the same bound-variable name is legal Clarus
    // and common style (lowFor appends a fresh IRLocal per loop, same name,
    // same Int type every time): declaring the shared C variable once and
    // reusing it across both loops is semantically identical to two
    // independent loops in C, so a duplicate (name, same-type) entry just
    // skips re-declaration -- cprint.go's emitFunc. A genuine same-name/
    // different-type collision is a real ambiguity in a flat-by-name IR and
    // is reported loudly rather than silently miscompiled.
    loc = irFuncLocalsHead(f)
    while loc != -1 {
        nm = poolGet(irLocalName(loc))
        if declared.has(nm) {
            if not cpTypeEqual(declared.get(nm, -1), irLocalType(loc)) {
                log("cprint: local " + nm + " redeclared with a different type in func " + poolGet(irFuncName(f)) + " (unsupported: same name, different type, in sibling scopes)")
                quit 1
            }
        } else {
            declared[nm] = irLocalType(loc)
            fpEmit(toText(cpCType(irLocalType(loc)) + " cv_" + nm + ";"))
            cpDefaultInit(toText("cv_" + nm), irLocalType(loc), 0, -1)
        }
        loc = irLocalNext(loc)
    }
    fpStmts(irFuncBodyHead(f))
    // Every path through a well-formed Clarus function already returns (or is
    // void), but proving that from C is harder than the checker's own
    // analysis -- an unconditional trailing return sidesteps -Wreturn-type.
    // Dead code when the real body returns on every path (cprint.go's emitFunc).
    if irtKind(irFuncRet(f)) != KVoid {
        fpEmit(toText("return " + cpZeroLiteral(irFuncRet(f)) + ";"))
    }

    cpRestBuf.add(cpFuncProto(f) + " {")
    i = 0
    while i < fpBody.count {
        cpRestBuf.add(fpBody[i])
        i = i + 1
    }
    cpRestBuf.add(toText("}"))
    cpRestBuf.add(toText(""))
    // Harvesting above copies each line's `text` HANDLE into cpRestBuf (Ch3:
    // text is a reference), not its bytes -- fpBody still points at those
    // same handles until the NEXT cpEmitFunc call's fpReset clears it. For
    // every function but the last one that's harmless (the next call's
    // fpReset runs before fpBody is read again); for the LAST function
    // compiled, nothing else ever clears fpBody, so cv_fpBody and
    // cv_cpRestBuf would both still reference those handles at program
    // exit -- cl_free_globals (memory-audit Task 5) would then double-free
    // them. Clearing here (not disposing -- cpRestBuf now owns them) closes
    // that gap unconditionally rather than relying on being non-last.
    fpReset(fpIndent)
}

// cpEmitExternProtos emits one `extern` C prototype per registered
// `external func` (Task 3, Ch13) into cpTypeBuf -- an external has no
// clar_fn_NAME definition (cpEmitFuncs only ever iterates irFuncs, which
// lowFuncDecl -- never lowExternDecl -- populates), only this forward
// declaration of its host symbol rt_ext_NAME, defined in
// rt_ext_host.inc/rt.c. Must run before anything that could CALL an
// extern gets printed -- emitProgram calls it just ahead of cpEmitFuncs.
// A KStr param prints as `const uint8_t *` (Plan 5b Task 3), NOT cpCType's
// ordinary by-value `clar_str_N` -- an extern receives a string's address,
// same convention as fpStrAddr's builtin-call marshalling -- so this skips
// cpCType (and the clar_str_N typedef it would otherwise emit unused) for
// that one case. KText already prints correctly via cpCType/cpCTypeName
// ("rt_text *"), so it takes the ordinary path.
func cpEmitExternProtos() {
    var i: int
    var j: int
    var params: string
    var first: bool
    var pty: int
    var skip: bool

    i = 0
    while i < irExternCount() {
        // native-5e Task 6: under --uiport, ui.cla's reverse-waist externs
        // (Task 7+) never link against a rt_ext_ shim at all -- either they
        // resolve straight to a synthesized clar_ui_fire_* function
        // (lowUiSynthExternName) or, for UiProgDesc, straight to the blob's
        // own address (fpCallExt's own special case) -- so declaring this
        // prototype would be dead and, worse, a NAME nothing ever defines.
        skip = cpUiPortFlag and (lowUiSynthExternName(irExternName(i)) != -1 or poolGet(irExternName(i)) == "UiProgDesc")
        if not skip {
            params = ""
            first = true
            j = 0
            while j < irExternParamCount(i) {
                if not first {
                    params = params + ", "
                }
                first = false
                pty = irExternParam(i, j)
                if irtKind(pty) == KStr {
                    params = params + "const uint8_t *"
                } else {
                    params = params + cpCType(pty)
                }
                j = j + 1
            }
            if first {
                params = "void"
            }
            cpTypeBuf.add(toText("extern " + cpCType(irExternRet(i)) + " rt_ext_" + poolGet(irExternName(i)) + "(" + params + ");"))
        }
        i = i + 1
    }
}

// cpEmitFuncs prints every prototype up front, then every definition
// (cprint.go's emitFuncs). Plan native-5d Task 1: skips the proto+body of
// any function shake.cla's shakeProgram proved unreachable from the
// program's real entry points -- shakeReachable(i) is always available
// here since main.cla calls shakeProgram() before emitProgram ever runs.
func cpEmitFuncs() {
    var i: int

    i = 0
    while i < irFuncs.count {
        if shakeReachable(i) {
            cpRestBuf.add(cpFuncProto(i) + ";")
        }
        i = i + 1
    }
    cpRestBuf.add(toText(""))
    i = 0
    while i < irFuncs.count {
        if shakeReachable(i) {
            cpEmitFunc(i)
        }
        i = i + 1
    }
}

// cpEmitDefaultInitFnProtos (Plan 5b Task 9 fix) forward-declares, into
// cpTypeBuf (the FIRST section of the final output -- emitProgram's
// cpAppendTextList call order), the small closed set of ported clar_fn_
// functions cpDefaultInit can call: rtStrStore (KStr's literal-default
// arm) and rtTextNew/rtTextStore (KText's unconditional birth + optional
// string-default arms). Every OTHER clar_fn_rtXxx call happens inside a
// real function/handler BODY (fpIntrCall), always printed by cpEmitFunc
// AFTER cpEmitFuncs's own up-front prototype loop -- safe already, no
// forward decl needed there.
//
// Why this exists: cpDefaultInit's callers are cpEmitRecords' clar_new_NAME
// constructors (cpRecBuf) and cpEmitGlobalsInit's clar_init_globals
// (cpRestBuf, appended before cpEmitFuncs's own prototype+definition
// block) -- BOTH land, in the final assembled file, before cpEmitFuncs ever
// runs its prototype loop. Text's cpDefaultInit arm calls clar_fn_rtTextNew
// UNCONDITIONALLY (every Text field/global needs its birth handle,
// regardless of whether it has a literal default) -- Task 8's str.cla
// redirect never hit this ordering gap because a KStr default with no
// literal override takes the plain `(clar_str_N){0}` struct-literal path,
// no function call at all, and no record/global in clarusc's own corpus
// happens to declare a KStr field WITH a literal default; Task 9's
// text.cla redirect exposed it immediately (any Text-typed record field or
// global calls clar_fn_rtTextNew from a pre-prototype position). Reuses
// cpFuncProto for the exact signature text -- no duplicated signature
// knowledge to drift out of sync with the real definitions.
//
// Deliberately NOT a blanket "forward-declare every clar_fn_ prototype
// early" fix: a user function taking a record parameter needs that
// record's clar_rec_NAME typedef (cpRecBuf, also not yet visible this
// early) to already be a complete type -- only safe because str.cla/
// text.cla's own functions never take a record-typed parameter (their
// whole signature surface is int/ptr/bool/text, by construction).
//
// *** MAINTENANCE, READ BEFORE TOUCHING cpDefaultInit AGAIN ***: this name
// set is a hardcoded, NOT self-extending, closed list -- Tasks 10/11 (list/
// map redirects) WILL hit this exact ordering gap the moment cpDefaultInit's
// KList/KMap arms start calling clar_fn_rtListNew/clar_fn_rtMapNew instead
// of the raw C rt_list_new/rt_map_new (same "record ctor / clar_init_globals
// call a ported clar_fn_ before its own prototype exists" failure mode this
// function was built to fix for KText). Adding a KList/KMap redirect to
// cpDefaultInit WITHOUT adding "rtListNew"/"rtMapNew" (or whatever their
// final names are) to the `if` below will compile clean on any corpus that
// happens not to default-construct a List/Map record field or global --
// then fail with -Wimplicit-function-declaration on the first one that
// does, exactly like this task's own bootstrap gate caught KText's version
// of the bug. Add the new name here in the SAME commit as the redirect.
//
// Plan 5c wave2a Task 2 widens this past cpDefaultInit's own two callers: a
// record with a handle-backed field (irRecHasHandleField) gets a
// clar_retain_NAME/clar_release_NAME walk pair too (cpEmitOneRcWalk, ARC
// Task 7), built via cpEmitRetain/cpEmitRelease and ALSO landing in
// cpRecBuf -- the exact same pre-cpEmitFuncs position cpDefaultInit's own
// clar_new_NAME constructors land in, so a Text-typed record field hits
// this identical ordering gap for clar_fn_rtTextRetain/rtTextRelease
// (arc_ported_list.cla's own `Item.label: text` field is exactly this
// case: cpEmitOneRcWalk's clar_retain_Item/clar_release_Item, cpRecBuf,
// calling both). "rtTextRetain"/"rtTextRelease" added below for that
// reason -- list/map ARC porting (this wave's later tasks) will need their
// own "rtListRetain"/"rtListRelease"/"rtMapRetain"/"rtMapRelease" entries
// for the exact same reason, the moment a record has a List/Map field.
func cpEmitDefaultInitFnProtos() {
    var i: int
    var nm: string

    i = 0
    while i < irFuncs.count {
        nm = poolGet(irFuncName(i))
        // Plan 5b Task 10: "rtListNew" added -- cpDefaultInit's KList arm
        // now calls clar_fn_rtListNew unconditionally (every List field/
        // global needs its birth handle), the exact call-before-prototype
        // gap this function's maintenance comment above warned Task 10
        // about. Plan 5b Task 11: "rtMapNew" added for the same reason,
        // cpDefaultInit's KMap arm. Plan 5c wave2a Task 2: "rtTextRetain"/
        // "rtTextRelease" added -- cpEmitOneRcWalk's record retain/release
        // walk pair, this function's own header comment above. Plan 5c
        // wave2a Task 3: "rtListRetain"/"rtListRelease" added for the exact
        // same reason, the moment a record has a handle-backed List field
        // (cpEmitOneRcWalk's own walk pair calls cpEmitRetain/cpEmitRelease,
        // which now redirect List's KList arm too) -- and "rtListLastref"/
        // "rtListAt"/"rtListCount" added alongside them: cpEmitRelease's own
        // KList element-release walk (a `list of Item` field whose Item has
        // a handle-backed field, say) now ALSO calls these three from
        // inside cpEmitOneRcWalk's clar_release_NAME body (same cpRecBuf
        // pre-cpEmitFuncs landing spot) and from cpEmitGlobalsInit's
        // cl_free_globals (cpRestBuf, appended before cpEmitFuncs's own
        // prototype loop too) -- found by this task's own bootstrap gate
        // (clarusc's self-hosted source has List-of-record globals whose
        // cl_free_globals walk hit exactly this gap). Plan 5c wave2a Task
        // 4: "rtMapRetain"/"rtMapRelease"/"rtMapLastref" added for the
        // exact same reason as List's Task 3 trio, the moment a record has
        // a handle-backed Map field -- and "rtMapValAt"/"rtMapCount" added
        // alongside them too: cpEmitRelease's own KMap element-release walk
        // now ALSO calls these two (already-existing, wave1 functions) from
        // the same pre-cpEmitFuncs positions, now that this task routes
        // that walk's calls through cpMapPorted (map.cla's own module
        // header comment documents the split).
        // Plan native-5d Task 1: also require shakeReachable(i) -- always
        // true for this exact closed name set in practice (shake.cla always
        // roots it unconditionally, the same "these flags are all
        // unconditionally true in the emit path" invariant this function's
        // own condition below already relies on), kept here anyway so the
        // two lists can never silently drift apart into a forward-declared-
        // but-body-skipped mismatch.
        if shakeReachable(i) and ((cpStrPorted and nm == "rtStrStore") or (cpTextPorted and (nm == "rtTextNew" or nm == "rtTextStore")) or (cpTextArcPorted and (nm == "rtTextRetain" or nm == "rtTextRelease")) or (cpListPorted and (nm == "rtListNew" or nm == "rtListAt" or nm == "rtListCount")) or (cpListArcPorted and (nm == "rtListRetain" or nm == "rtListRelease" or nm == "rtListLastref")) or (cpMapPorted and (nm == "rtMapNew" or nm == "rtMapValAt" or nm == "rtMapCount")) or (cpMapArcPorted and (nm == "rtMapRetain" or nm == "rtMapRelease" or nm == "rtMapLastref"))) {
            cpTypeBuf.add(cpFuncProto(i) + ";")
        }
        i = i + 1
    }
}

// cpEmitRecords prints every record struct (and its clar_new_NAME
// constructor) in declaration order, into cpRecBuf -- cprint.go's
// emitRecords. Clarus requires declare-before-use for record-typed fields,
// so any nested record a field refers to was already fully emitted by an
// earlier iteration of this same loop -- cpEnsureType's lazy array-wrapper
// emission (for Arr-typed fields) can safely assume that. clar_new_NAME's
// body is built via the same fpReset/fpEmit/fpBody machinery cpEmitFunc uses
// for a real function body (indent level 1), then harvested into cpRecBuf,
// since cpDefaultInit only knows how to append to "whatever fpBody
// currently is".
func cpEmitRecords() {
    var i: int
    var f: int
    var name: string
    var ctype: string
    var j: int

    i = 0
    while i < irRecords.count {
        f = irRecordLayoutFieldsHead(i)
        while f != -1 {
            cpEnsureType(irFieldSlotType(f))
            f = irFieldSlotNext(f)
        }
        name = poolGet(irRecordLayoutName(i))
        ctype = "clar_rec_" + name

        cpRecBuf.add(toText("typedef struct {"))
        f = irRecordLayoutFieldsHead(i)
        while f != -1 {
            cpRecBuf.add(toText("    " + cpCType(irFieldSlotType(f)) + " cv_" + poolGet(irFieldSlotName(f)) + ";"))
            f = irFieldSlotNext(f)
        }
        cpRecBuf.add(toText("} " + ctype + ";"))

        if not irRecordLayoutIsOverlay(i) {
            // Plan 5b Task 2: an overlay record is never constructed (only
            // cast onto existing memory via OverlayName(p) -- CvPtrToOverlay)
            // so it gets no clar_new_NAME at all; the typedef above is the
            // only thing cpEmitRecords produces for it.
            fpReset(1)
            f = irRecordLayoutFieldsHead(i)
            while f != -1 {
                cpDefaultInit(toText("r.cv_" + poolGet(irFieldSlotName(f))), irFieldSlotType(f), irFieldSlotDefault(f), irFieldSlotDefaultStr(f))
                f = irFieldSlotNext(f)
            }
            cpRecBuf.add(toText("static " + ctype + " clar_new_" + name + "(void) {"))
            cpRecBuf.add(toText("    " + ctype + " r;"))
            j = 0
            while j < fpBody.count {
                cpRecBuf.add(fpBody[j])
                j = j + 1
            }
            cpRecBuf.add(toText("    return r;"))
            cpRecBuf.add(toText("}"))
            cpRecBuf.add(toText(""))
            // See cpEmitFunc's matching comment: harvesting shares fpBody's
            // text handles into cpRecBuf by reference; clear fpBody so a
            // program whose LAST harvest happens to be a record ctor (no
            // functions follow) doesn't leave cv_fpBody aliasing cv_cpRecBuf
            // at exit.
            fpReset(1)
        }
        i = i + 1
    }
}

// cpEnumArraysEmitted dedupes clar_enumvals_NAME/clar_enumlabels_NAME array
// emission (cpEmitEnumArraysOnce below) across every record field that
// references the same enum type -- keyed by name like cpStrCapsEmitted/
// cpArrEmitted above (neither of those is reset in cpResetBuffers either;
// same "one emitProgram call per process" precedent this follows).
var cpEnumArraysEmitted: map of int

// cpEmitEnumArraysOnce emits enumNameIdx's clar_enumvals_NAME/
// clar_enumlabels_NAME arrays into cpRecBuf the first time enumNameIdx is
// seen. Walks irEnums for the matching IREnumLayout (same linear scan as
// cpEnumCount above); labels reuse cpUiCaptionOrNull's Pascal-string
// escaping -- lowEnumDecl (lower.cla) guarantees every member has a label
// (its own, or its name default), so idx == -1 never reaches
// cpUiCaptionOrNull here.
func cpEmitEnumArraysOnce(enumNameIdx: int) {
    var name: string
    var i: int
    var m: int
    var vals: text
    var labels: text
    var first: bool

    name = poolGet(enumNameIdx)
    if cpEnumArraysEmitted.has(name) {
        return
    }
    cpEnumArraysEmitted[name] = 1

    i = 0
    while i < irEnums.count {
        if irEnumLayoutName(i) == enumNameIdx {
            vals = ""
            labels = ""
            first = true
            m = irEnumLayoutMembersHead(i)
            while m != -1 {
                if not first {
                    vals.append(", ")
                    labels.append(", ")
                }
                first = false
                vals.append(numToStr(irEnumMemberValue(m)))
                labels.append(cpUiCaptionOrNull(irEnumMemberLabel(m)))
                m = irEnumMemberNext(m)
            }
            cpRecBuf.add(toText("static const int32_t clar_enumvals_" + name + "[] = {") + vals + toText("};"))
            cpRecBuf.add(toText("static const unsigned char *const clar_enumlabels_" + name + "[] = {") + labels + toText("};"))
            return
        }
        i = i + 1
    }
    log("cprint: unknown enum " + name)
    quit 1
}

// cpFieldDescRow renders one clar_fields_NAME[] entry (an rt_field_desc
// literal, rt.h's Task 1 contract) for field slot f of record recName. Only
// KInt/KFixed/KBool/KChar/KStr/KEnum can appear here -- lower.cla's
// lowCheckSerializableFields already rejected every other field kind before
// a record could reach cpEmitLayouts, so KEnum is the correctness-preserving
// fallthrough (not a silent default).
func cpFieldDescRow(recName: string, f: int): string {
    var t: int
    var k: IRKind
    var ftype: string
    var strCap: int
    var enumCount: int
    var enumVals: string
    var enumLabels: string

    t = irFieldSlotType(f)
    k = irtKind(t)
    strCap = 0
    enumCount = 0
    enumVals = "0"
    enumLabels = "0"
    if k == KInt {
        ftype = "RT_FT_INT"
    } else if k == KFixed {
        ftype = "RT_FT_FIXED"
    } else if k == KBool {
        ftype = "RT_FT_BOOL"
    } else if k == KChar {
        ftype = "RT_FT_CHAR"
    } else if k == KStr {
        ftype = "RT_FT_STR"
        strCap = irtN(t)
    } else {
        ftype = "RT_FT_ENUM"
        enumCount = cpEnumCount(irtName(t))
        enumVals = "clar_enumvals_" + poolGet(irtName(t))
        enumLabels = "clar_enumlabels_" + poolGet(irtName(t))
    }
    return "{ " + ftype + ", " + numToStr(strCap) + ", (long)offsetof(clar_rec_" + recName + ", cv_" + poolGet(irFieldSlotName(f)) + "), " + numToStr(enumCount) + ", " + enumVals + ", " + enumLabels + " }"
}

// cpEmitLayouts (Task 2, mac-target-4d) prints, for every record type
// lower.cla's irLayoutNeeded registry marked (i.e. one that reached
// file.save/load), a static rt_field_desc[] + rt_layout_desc pair into
// cpRecBuf -- cprint.go has no equivalent (this whole feature postdates the
// Go reference compiler's freeze). Appended right after cpEmitRecords'
// clar_rec_NAME structs (same buffer, in the SAME call to emitProgram, so
// every offsetof/sizeof below always follows its target typedef) and so
// always before cpUiBuf's window descs in emitProgram's fixed assembly
// order (cpRecBuf prints first). Enum sub-arrays are emitted once per enum
// type via cpEmitEnumArraysOnce, walked BEFORE this record's own fields
// array so they're always declared above their first use.
func cpEmitLayouts() {
    var i: int
    var f: int
    var name: int
    var recName: string
    var ft: int
    var nFields: int

    i = 0
    while i < irRecords.count {
        name = irRecordLayoutName(i)
        if irLayoutNeeded(name) {
            recName = poolGet(name)
            f = irRecordLayoutFieldsHead(i)
            while f != -1 {
                ft = irFieldSlotType(f)
                if irtKind(ft) == KEnum {
                    cpEmitEnumArraysOnce(irtName(ft))
                }
                f = irFieldSlotNext(f)
            }

            cpRecBuf.add(toText("static const rt_field_desc clar_fields_" + recName + "[] = {"))
            nFields = 0
            f = irRecordLayoutFieldsHead(i)
            while f != -1 {
                cpRecBuf.add(toText("    " + cpFieldDescRow(recName, f) + ","))
                nFields = nFields + 1
                f = irFieldSlotNext(f)
            }
            cpRecBuf.add(toText("};"))
            cpRecBuf.add(toText("static const rt_layout_desc clar_layout_" + recName + " = { (long)sizeof(clar_rec_" + recName + "), " + numToStr(nFields) + ", clar_fields_" + recName + " };"))
            cpRecBuf.add(toText(""))
        }
        i = i + 1
    }
}

// cpSerEnumValsInline returns ", v0, v1, ..." (one leading ", " per member,
// empty text if the enum has none) for enum nameIdx's ordinal values --
// same irEnums walk as cpEnumCount/cpEmitEnumArraysOnce, but the values are
// returned for splicing inline into clar_serdesc_ (Task 7's Clarus-side
// serializer has no pointers to walk, so it can't follow a
// clar_enumvals_NAME reference the way cpFieldDescRow's rt_field_desc row
// does).
func cpSerEnumValsInline(nameIdx: int): text {
    var i: int
    var m: int
    var out: text

    out = toText("")
    i = 0
    while i < irEnums.count {
        if irEnumLayoutName(i) == nameIdx {
            m = irEnumLayoutMembersHead(i)
            while m != -1 {
                out.append(", " + numToStr(irEnumMemberValue(m)))
                m = irEnumMemberNext(m)
            }
            return out
        }
        i = i + 1
    }
    log("cprint: unknown enum " + poolGet(nameIdx))
    quit 1
    return out
}

// cpSerFieldRow renders one clar_serdesc_<REC> field block: ftype, strCap,
// offset, enumCount, then (RT_FT_ENUM only) enumCount inline ordinal
// values -- the "4 + enumCount" int32s Task 7's serializer peekl-walks per
// field. Same field-kind switch as cpFieldDescRow, minus the labels column
// (peekl has no use for display strings) and with enum values inlined
// instead of referencing clar_enumvals_<REC>.
func cpSerFieldRow(recName: string, f: int): text {
    var t: int
    var k: IRKind
    var ftype: string
    var strCap: int
    var enumCount: int
    var row: text

    t = irFieldSlotType(f)
    k = irtKind(t)
    strCap = 0
    enumCount = 0
    if k == KInt {
        ftype = "RT_FT_INT"
    } else if k == KFixed {
        ftype = "RT_FT_FIXED"
    } else if k == KBool {
        ftype = "RT_FT_BOOL"
    } else if k == KChar {
        ftype = "RT_FT_CHAR"
    } else if k == KStr {
        ftype = "RT_FT_STR"
        strCap = irtN(t)
    } else {
        ftype = "RT_FT_ENUM"
        enumCount = cpEnumCount(irtName(t))
    }
    row = toText("    " + ftype + ", " + numToStr(strCap) + ", (int32_t)offsetof(clar_rec_" + recName + ", cv_" + poolGet(irFieldSlotName(f)) + "), " + numToStr(enumCount))
    if k == KEnum {
        row.append(cpSerEnumValsInline(irtName(t)))
    }
    row.append(",")
    return row
}

// cpEmitSerDescs (Task 5, mac-target-5b) prints, for the same
// irLayoutNeeded-gated records as cpEmitLayouts just above, a second,
// pointer-free descriptor per record: a flat `static const int32_t
// clar_serdesc_<REC>[]` that Task 7's Clarus-side serializer walks with
// peekl alone (clarusc has no way to dereference the rt_field_desc/
// rt_layout_desc pointer tables cpEmitLayouts emits). Format, walked at a
// stride of 4 starting from index 0:
//
//   [0] = (int32_t)sizeof(clar_rec_<REC>)  -- record size in bytes
//   [1] = nFields                          -- field count
//   then nFields field blocks, each "4 + enumCount" int32s (cpSerFieldRow):
//     ftype      -- RT_FT_INT 0 / FIXED 1 / BOOL 2 / CHAR 3 / STR 4 / ENUM 5
//     strCap     -- RT_FT_STR only, else 0
//     offset     -- (int32_t)offsetof(clar_rec_<REC>, cv_<field>)
//     enumCount  -- RT_FT_ENUM only, else 0
//     <enumCount inline ordinal values>      -- RT_FT_ENUM only
//
// Same field order as clar_fields_<REC>. nFields must be counted before the
// fields loop (it's the second array slot, printed before any field row),
// unlike cpEmitLayouts' rt_layout_desc line which plugs nFields in AFTER
// building the separate clar_fields_ array -- hence the two passes over
// the field list below.
func cpEmitSerDescs() {
    var i: int
    var f: int
    var name: int
    var recName: string
    var nFields: int

    i = 0
    while i < irRecords.count {
        name = irRecordLayoutName(i)
        if irLayoutNeeded(name) {
            recName = poolGet(name)
            nFields = 0
            f = irRecordLayoutFieldsHead(i)
            while f != -1 {
                nFields = nFields + 1
                f = irFieldSlotNext(f)
            }

            cpRecBuf.add(toText("static const int32_t clar_serdesc_" + recName + "[] = {"))
            cpRecBuf.add(toText("    (int32_t)sizeof(clar_rec_" + recName + "), " + numToStr(nFields) + ","))
            f = irRecordLayoutFieldsHead(i)
            while f != -1 {
                cpRecBuf.add(cpSerFieldRow(recName, f))
                f = irFieldSlotNext(f)
            }
            cpRecBuf.add(toText("};"))
            cpRecBuf.add(toText(""))
        }
        i = i + 1
    }
}

// cpEmitEnums prints each enum's value table (for the checked int->enum
// conversion, rt_enum_from_int) plus a matching _count constant, into
// cpRestBuf -- cprint.go's emitEnums. Marked __attribute__((unused)): a
// program that declares an enum but never runs a checked EnumType(i)
// conversion on it would otherwise fail -Wunused-const-variable under
// -Werror.
func cpEmitEnums() {
    var i: int
    var m: int
    // vals is `text`, not `string`: a `string` is a fixed 255-byte buffer,
    // and the comma-joined ordinal list can run past that for an enum with
    // enough members (clarusc's own TokKind has 67) -- it would silently
    // truncate rather than error, emitting invalid C. Self-emission is what
    // exposed this: no testdata corpus enum is large enough to hit it.
    var vals: text
    var first: bool
    var count: int
    var name: string

    i = 0
    while i < irEnums.count {
        vals = toText("")
        first = true
        count = 0
        m = irEnumLayoutMembersHead(i)
        while m != -1 {
            if not first {
                vals = vals + ", "
            }
            first = false
            vals = vals + numToStr(irEnumMemberValue(m))
            count = count + 1
            m = irEnumMemberNext(m)
        }
        name = poolGet(irEnumLayoutName(i))
        cpRestBuf.add(toText("static const int32_t clar_enum_" + name + "[] __attribute__((unused)) = {") + vals + toText("};"))
        cpRestBuf.add(toText("static const int clar_enum_" + name + "_count __attribute__((unused)) = " + numToStr(count) + ";"))
        i = i + 1
    }
    cpRestBuf.add(toText(""))
}

// ================================================================
// UI descriptor printing (Task 4): irWindowDescs/irMenuDescs (ir.cla) ->
// static const rt_ui_widget_desc[]/rt_ui_window_desc/rt_ui_item_desc[]/
// rt_ui_menu_desc tables, matching the shape internal/mactest/uiprobe/
// probe_ui.c hand-authors (rt_ui.h's own living example). Every C
// identifier this section mints uses the "clar_ui_" prefix, alongside this
// file's existing cv_/clar_fn_/clar_rec_/clar_str_/clar_lit_/clar_enum_/
// clar_new_ conventions -- never bare, so a generated name can never
// collide with a user identifier (those are always cv_/clar_fn_-prefixed
// too). Handler-table fields (rt_ui_window_desc.handlers) print a bare `0`
// for a window with no `extend` block at all (NULL still compiles and
// links against rt_ui.h's `const rt_ui_handlers *` field type); Task 5 wires
// a real `&clar_ui_handlers_NAME` for every window that registers at least
// one handler -- see cpEmitWinHandlersFwd/cpEmitUiDispatchers below.
// ================================================================

func cpBoolLit(b: bool): string {
    if b {
        return "1"
    }
    return "0"
}

// cpOctal3 renders v (0-255) as exactly three octal digits, for C string
// escapes: \311 is self-delimiting where \xC9 would swallow a following
// hex digit (C's \x is maximal-munch).
func cpOctal3(v: int): string {
    var d: string
    d = numToStr(v mod 8)
    d = numToStr((v / 8) mod 8) + d
    d = numToStr(v / 64) + d
    return d
}

// cpEscapeCStr escapes s for embedding inside a C double-quoted string
// literal: backslash and doublequote are backslash-escaped, and any byte
// outside printable ASCII (e.g. a \xHH escape decoded from a Clarus source
// literal, such as MacRoman accented text) is emitted as a 3-digit octal
// escape rather than passed through raw.
func cpEscapeCStr(s: string): string {
    var out: string
    var i: int
    var c: char

    out = ""
    i = 0
    while i < s.length {
        c = s[i]
        if c == '"' {
            out = out + "\\\""
        } else if c == '\\' {
            out = out + "\\\\"
        } else if int(c) < 32 or int(c) > 126 {
            out = out + "\\" + cpOctal3(int(c))
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// cpUiCaptionOrNull renders a widget/menu-item caption slot: idx == -1 (no
// caption -- e.g. a canvas widget, or a separator) prints a bare `0`
// (matching probe_ui.c's own NULL-caption widgets/separators exactly);
// otherwise a Retro68 "\pFoo"-escaped Str255 literal cast to `const
// unsigned char *`, the same spelling probe_ui.c hand-authors throughout.
func cpUiCaptionOrNull(idx: int): string {
    if idx == -1 {
        return "0"
    }
    return "(const unsigned char *)\"\\p" + cpEscapeCStr(poolGet(idx)) + "\""
}

// cpUiTitleStr renders a window/menu title slot: unlike a widget caption, a
// title is never semantically absent (NewWindow/NewMenu both want a real,
// possibly-empty Str255, not NULL), so idx == -1 (no `title:` property
// given) prints an empty Pascal string rather than 0.
func cpUiTitleStr(idx: int): string {
    if idx == -1 {
        return "(const unsigned char *)\"\\p\""
    }
    return "(const unsigned char *)\"\\p" + cpEscapeCStr(poolGet(idx)) + "\""
}

// cpMenuKeyChar renders a menu item's key-equivalent slot (`unsigned char
// key`): 0 if the item declared no `key "K"`, else a C char literal.
func cpMenuKeyChar(keyIdx: int): string {
    var s: string

    if keyIdx == -1 {
        return "0"
    }
    s = poolGet(keyIdx)
    if s.length == 0 {
        return "0"
    }
    return "'" + s + "'"
}

// cpWidgetKindMacro is an explicit five-way dispatch over rt_ui's whole
// widget-kind surface (mac-target-4c Task 2) -- lower.cla's lowWidgetDesc
// already rejects every other kind before an IRWidgetDesc can exist, so
// reaching the fallthrough below means an IRWidgetDesc was constructed with
// a kind that guard didn't validate (an internal-invariant break, not a
// user-facing error), reported loudly rather than silently mis-emitted as
// RTUI_LABEL the way the old default fallthrough did.
func cpWidgetKindMacro(kindIdx: int): string {
    var kind: string

    kind = poolGet(kindIdx)
    if kind == "button" {
        return "RTUI_BUTTON"
    }
    if kind == "check" {
        return "RTUI_CHECK"
    }
    if kind == "canvas" {
        return "RTUI_CANVAS"
    }
    if kind == "label" {
        return "RTUI_LABEL"
    }
    if kind == "field" {
        return "RTUI_FIELD"
    }
    if kind == "textview" {
        return "RTUI_TEXTVIEW"
    }
    if kind == "popup" {
        return "RTUI_POPUP"
    }
    if kind == "table" {
        return "RTUI_TABLE"
    }
    log("cprint: unknown widget kind " + kind)
    quit 1
    return ""
}

func cpAtKindMacro(k: int): string {
    if k == 1 {
        return "RTUI_AT_NEXT"
    }
    if k == 2 {
        return "RTUI_AT_RIGHT"
    }
    if k == 3 {
        return "RTUI_AT_AUTO"
    }
    return "RTUI_AT_XY"
}

func cpFillMacro(fillBoth: bool): string {
    if fillBoth {
        return "RTUI_FILL_BOTH"
    }
    return "RTUI_FILL_NONE"
}

func cpWidgetFlagsMacro(isDefault: bool, isCancel: bool, isBuffered: bool, isScrollV: bool, isScrollH: bool): string {
    var s: string

    s = ""
    if isDefault {
        s = "RTUI_DEFAULT"
    }
    if isCancel {
        if s == "" {
            s = "RTUI_CANCEL"
        } else {
            s = s + " | RTUI_CANCEL"
        }
    }
    if isBuffered {
        if s == "" {
            s = "RTUI_BUFFERED"
        } else {
            s = s + " | RTUI_BUFFERED"
        }
    }
    if isScrollV {
        if s == "" {
            s = "RTUI_SCROLL_V"
        } else {
            s = s + " | RTUI_SCROLL_V"
        }
    }
    if isScrollH {
        if s == "" {
            s = "RTUI_SCROLL_H"
        } else {
            s = s + " | RTUI_SCROLL_H"
        }
    }
    if s == "" {
        return "0"
    }
    return s
}

// cpEmitUiStateStruct prints one window's per-instance-var state struct
// (clar_uistate_NAME) into cpRecBuf -- a plain typedef, deliberately NOT
// routed through cpEmitRecords: a UI state block is allocated and zeroed by
// rt_ui itself (rt_ui_state's Handle), never via a clar_new_NAME
// constructor, so there is no per-field default-init body to emit here.
// Two passes over fieldsHead, same shape as cpEmitRecords: an Arr-typed
// field's cpEnsureType lazily appends its clar_arr_ELEM_N wrapper typedef to
// this SAME cpRecBuf, which would otherwise land in the middle of this
// struct's own still-open "typedef struct {" (clarusc-ui-gaps Fix round 1 --
// no window state field was Arr-typed before item 1 widened construction
// into arrays, so this ordering bug was latent until now) -- every
// referenced type must already exist before the struct opens.
func cpEmitUiStateStruct(name: string, fieldsHead: int) {
    var f: int

    f = fieldsHead
    while f != -1 {
        cpEnsureType(irFieldSlotType(f))
        f = irFieldSlotNext(f)
    }
    cpRecBuf.add(toText("typedef struct {"))
    f = fieldsHead
    while f != -1 {
        cpRecBuf.add(toText("    " + cpCType(irFieldSlotType(f)) + " cv_" + poolGet(irFieldSlotName(f)) + ";"))
        f = irFieldSlotNext(f)
    }
    cpRecBuf.add(toText("} clar_uistate_" + name + ";"))
    cpRecBuf.add(toText(""))
}

// cpEmitWidgetDescArray prints one window's rt_ui_widget_desc[] array (Ch8)
// into cpUiBuf, in the SAME order lower.cla's lowWindowDecl chained them --
// the order uiWidgetIndex (lower.cla) and this array's own positions agree
// on. Returns the array's own C name, for the window desc below to
// reference.
func cpEmitWidgetDescArray(winName: string, headIdx: int): string {
    var name: string
    var w: int
    var yStr: string
    var widthStr: string
    var capIdx: int
    var kind: string

    // Pre-pass (mac-target-4d Task 5): any table widget's cols[]/table_desc
    // must already exist before the widget array below takes their address
    // (same "declare before use" reasoning as cpEmitMenuItemsArray's own
    // call-before-reference in cpEmitMenuDescs) -- a window with no table at
    // all makes this loop a no-op, so every pre-Task-5 golden's cpUiBuf text
    // is completely untouched.
    w = headIdx
    while w != -1 {
        if poolGet(irWidgetDescKind(w)) == "table" {
            cpEmitOneTableDesc(winName, w)
        }
        w = irWidgetDescNext(w)
    }

    name = "clar_ui_widgets_" + winName
    cpUiBuf.add(toText("static const rt_ui_widget_desc " + name + "[] = {"))
    w = headIdx
    while w != -1 {
        yStr = "RTUI_BOTTOM"
        if not irWidgetDescYIsBottom(w) {
            yStr = numToStr(irWidgetDescY(w))
        }
        widthStr = "RTUI_FILL"
        if not irWidgetDescWidthIsFill(w) {
            widthStr = numToStr(irWidgetDescWidth(w))
        }
        // Ch8 doc addition (mac-target-4d final-validation Fix wave, FIX 1):
        // a widget with no caption/label/text property at all (captionIdx
        // -1) falls back to its own declared NAME -- the same "member name
        // when unlabeled" rule Chapter 3 already gives an unlabeled enum
        // member (lowEnumDecl, clarusc/lower.cla). Scoped to the five kinds
        // that can even declare a caption-like property at all (checker's
        // widgetDeclProps: button.caption, check.caption, field.label,
        // popup.label, label.text -- the only ones rt_ui.c's `cap = wd->
        // caption ? ... : kEmptyPStr` ever feeds into NewControl's title or
        // a TETextBox lane); table/textview/canvas have no such property in
        // the grammar, so their captionIdx is always -1 for an unrelated
        // reason (there was never anything TO label), and baking a name in
        // there would just be inert noise in the emitted C. One spot, not
        // one per kind.
        capIdx = irWidgetDescCaption(w)
        if capIdx == -1 {
            kind = poolGet(irWidgetDescKind(w))
            if kind == "button" or kind == "check" or kind == "field" or kind == "popup" or kind == "label" {
                capIdx = irWidgetDescName(w)
            }
        }
        cpUiBuf.add(toText("    { " + cpWidgetKindMacro(irWidgetDescKind(w)) + ", \"" + poolGet(irWidgetDescName(w)) + "\", " +
            cpUiCaptionOrNull(capIdx) + ", " +
            cpAtKindMacro(irWidgetDescAtKind(w)) + ", " + numToStr(irWidgetDescX(w)) + ", " + yStr + ", " + widthStr + ", " +
            cpFillMacro(irWidgetDescFillBoth(w)) + ", " +
            cpWidgetFlagsMacro(irWidgetDescIsDefault(w), irWidgetDescIsCancel(w), irWidgetDescIsBuffered(w), irWidgetDescIsScrollV(w), irWidgetDescIsScrollH(w)) +
            cpUiWidgetExtra(winName, w) + " },"))
        w = irWidgetDescNext(w)
    }
    cpUiBuf.add(toText("};"))
    cpUiBuf.add(toText(""))
    return name
}

// cpFindWinHandlers returns winName's irWinHandlers arena index, or -1 if
// the window has no `extend` block at all (lower.cla's lowGetOrCreateWinHandlers
// only ever creates an entry on a window's FIRST registered handler) -- a
// linear scan over irWinHandlers, cheap given a program's handful of window
// types.
func cpFindWinHandlers(winName: string): int {
    var i: int

    i = 0
    while i < irWinHandlers.count {
        if poolGet(irWinHandlersName(i)) == winName {
            return i
        }
        i = i + 1
    }
    return -1
}

// cpFindWindowStateFields (clarusc-ui-gaps Task 2) returns winName's
// per-instance state fields list head (irWindowDescStateFieldsHead), or -1
// if winName names no window -- IUiStateDefaults' cprint case (fpIntrCall)
// walks this to find which fields need construction. Linear scan over
// irWindowDescs, same precedent as cpFindWinHandlers just above.
func cpFindWindowStateFields(winName: string): int {
    var i: int

    i = 0
    while i < irWindowDescs.count {
        if poolGet(irWindowDescName(i)) == winName {
            return irWindowDescStateFieldsHead(i)
        }
        i = i + 1
    }
    return -1
}

// cpFindWindowIndex (Task 7 Step 6, native-5e): winName's 0-based
// position in irWindowDescs declaration order -- the SAME index
// uiblob.cla's own blob builder uses for a Window section entry (both
// walk irWindowDescs in the same order), so this is exactly the winIdx
// the ported rtUiOpen/rtUiFront (report log entry #5's own winIdx-not-
// descriptor-pointer redesign) expect. Same linear-scan-by-name shape as
// cpFindWinHandlers/cpFindWindowStateFields just above; a window name
// with no match can't happen here (the checker already rejected an
// `open`/`front` of an undeclared window type before this ever runs).
func cpFindWindowIndex(winName: string): int {
    var i: int

    i = 0
    while i < irWindowDescs.count {
        if poolGet(irWindowDescName(i)) == winName {
            return i
        }
        i = i + 1
    }
    return -1
}

// cpFindWindowFormRecName (mac-target-4d Task 7) returns winName's form
// record type name (interned), or -1 if winName isn't a form window --
// fpUiEditStmt's own lookup for the `new T`/map-target temp's `clar_rec_T`
// spelling. Same linear-scan precedent as cpFindWindowStateFields just
// above.
func cpFindWindowFormRecName(winName: string): int {
    var i: int

    i = 0
    while i < irWindowDescs.count {
        if poolGet(irWindowDescName(i)) == winName {
            return irWindowDescFormRecName(i)
        }
        i = i + 1
    }
    return -1
}

// cpFindGlobalRecName (mac-target-4d Task 5) returns the row-record type
// name of the global list variable named globalNameIdx (IRWidgetDesc's own
// rowsGlobalIdx -- lower.cla stores only the global's NAME, not its record
// type, so cprint re-derives clar_layout_<RecName> from irGlobals here, the
// one place that needs it). Linear scan, same precedent as
// cpFindWinHandlers/cpFindWindowStateFields above.
func cpFindGlobalRecName(globalNameIdx: int): int {
    var i: int

    i = 0
    while i < irGlobals.count {
        if irGlobalName(i) == globalNameIdx {
            return irtName(irtElem(irGlobalType(i)))
        }
        i = i + 1
    }
    log("cprint: unknown table rows global " + poolGet(globalNameIdx))
    quit 1
    return -1
}

// cpEmitOneTableDesc (mac-target-4d Task 4) prints, for one table widget,
// its rt_ui_col_desc[] array and rt_ui_table_desc into cpUiBuf -- the same
// cpEmitMenuItemsArray precedent (Task 2), called from cpEmitWidgetDescArray's
// pre-pass BEFORE that window's own rt_ui_widget_desc[] array (whose table
// row takes this table_desc's ADDRESS, so it must already exist). Also
// forward-declares the bound `rows:` global as a bare tentative definition
// (`static rt_list *cv_NAME;`, no initializer) -- legal C even though
// cpEmitGlobalsInit (called later in emitProgram, but printing into
// cpRestBuf, which assembles AFTER cpUiBuf) declares the SAME global again;
// multiple tentative definitions of one static object merge under C's own
// rules, so this is the simplest way to satisfy "declared before used"
// without reordering cpEmitGlobalsInit's own buffer (which every OTHER
// existing golden's byte-identical output depends on staying put).
func cpEmitOneTableDesc(winName: string, w: int): string {
    var wgName: string
    var globalName: string
    var recName: string
    var colsName: string
    var tableName: string
    var c: int
    var nCols: int
    var widthFillStr: string

    wgName = poolGet(irWidgetDescName(w))
    globalName = poolGet(irWidgetDescRowsGlobalIdx(w))
    recName = poolGet(cpFindGlobalRecName(irWidgetDescRowsGlobalIdx(w)))

    cpUiBuf.add(toText("static rt_list *cv_" + globalName + ";"))

    colsName = "clar_ui_cols_" + winName + "_" + wgName
    cpUiBuf.add(toText("static const rt_ui_col_desc " + colsName + "[] = {"))
    c = irWidgetDescColumnsHead(w)
    nCols = 0
    while c != -1 {
        widthFillStr = "0"
        if irColumnDescWidthFill(c) {
            widthFillStr = "1"
        }
        cpUiBuf.add(toText("    { " + cpUiCaptionOrNull(irColumnDescHeader(c)) + ", " + numToStr(irColumnDescWidthPx(c)) + ", " + widthFillStr + ", " + numToStr(irColumnDescFieldIndex(c)) + " },"))
        nCols = nCols + 1
        c = irColumnDescNext(c)
    }
    cpUiBuf.add(toText("};"))

    tableName = "clar_ui_table_" + winName + "_" + wgName
    cpUiBuf.add(toText("static const rt_ui_table_desc " + tableName + " = { &cv_" + globalName + ", &clar_layout_" + recName + ", " + numToStr(nCols) + ", " + colsName + " };"))
    cpUiBuf.add(toText(""))
    return tableName
}

// cpUiWidgetExtra returns the trailing rt_ui_widget_desc `extra` field text
// (", (const void *)&clar_ui_table_<Win>_<W>", comma-prefixed to append onto
// an already-open row literal) for a table widget, or "" for every other
// kind -- the row keeps its old 9-field shape when extra is empty, so every
// pre-Task-5 golden (no table/popup ever reaches here) stays byte-identical
// (mac-target-4d Task 5's own "10th field only when non-NULL" contract).
func cpUiWidgetExtra(winName: string, w: int): string {
    if poolGet(irWidgetDescKind(w)) == "table" {
        return ", (const void *)&clar_ui_table_" + winName + "_" + poolGet(irWidgetDescName(w))
    }
    return ""
}

// cpWidgetKindForIndex returns the widget kind word ("button"/"check"/
// "canvas"/"label"/"field"/"textview") at position widgetIndex in window
// winName's declared widget list -- cpEmitOneWidgetDispatcher needs this to
// pick each widget's calling convention (0 args for button click/check
// change/field enter vs. (x, y) from a/b for canvas click/drag).
func cpWidgetKindForIndex(winName: string, widgetIndex: int): string {
    var i: int
    var w: int
    var n: int

    i = 0
    while i < irWindowDescs.count {
        if poolGet(irWindowDescName(i)) == winName {
            w = irWindowDescWidgetsHead(i)
            n = 0
            while w != -1 {
                if n == widgetIndex {
                    return poolGet(irWidgetDescKind(w))
                }
                n = n + 1
                w = irWidgetDescNext(w)
            }
        }
        i = i + 1
    }
    return "" // unreachable for a checker-clean program
}

// cpWinHandlersHasWinEvent/HasWidget report whether window handlers `whIdx`
// registered at least one bare window event / widget event -- used both to
// decide whether to forward-declare+wire that half of the rt_ui_handlers
// struct (cpEmitWinHandlersFwd) and whether to define its dispatcher body
// at all (cpEmitUiDispatchers).
func cpWinHandlersHasWinEvent(whIdx: int): bool {
    return irWinHandlersOpenedFn(whIdx) != -1 or irWinHandlersCloseRequestFn(whIdx) != -1 or irWinHandlersClosedFn(whIdx) != -1 or irWinHandlersResizedFn(whIdx) != -1 or irWinHandlersKeyFn(whIdx) != -1 or irWinHandlersAcceptedFn(whIdx) != -1 or irWinHandlersCancelledFn(whIdx) != -1
}

func cpWinHandlersHasWidget(whIdx: int): bool {
    return irWinHandlersWidgetHead(whIdx) != -1
}

// cpEmitWinReleaseFn (memory-audit-4e Task 8) emits, for winName's state
// block, a static void clar_ui_release_<Win>(void *inst) freeing every
// irtNeedsCtor per-instance var, UNCONDITIONALLY (ARC Task 6 -- Tasks 4-5
// made every store into a window var counted, so the old lowWinVarQualifies
// escape-walker consult guarding against a double-freed alias is now
// provably unnecessary; see cpEmitGlobalsInit's matching comment for the
// globals-side version of this same argument). Exact mirror of
// fpIntrCall's IUiStateDefaults() case above (the constructor this is the
// destructor for), freeing instead of constructing, via the same
// cpEmitRelease helper Task 5's globals and Task 7's locals already use. No
// forward-declare/define split like winFn/widgetFn below needs: cpEmitRelease
// may emit clar_fn_rtTextRelease/rtListRelease/rtMapRelease calls (ARC), but
// their prototypes come from cpEmitDefaultInitFnProtos into cpTypeBuf, which
// emitProgram assembles before cpUiBuf where this function's body lands, so
// it can be defined here directly. Returns the
// function's own C name, or "0" if winName has no needs-ctor field at all
// (callers wire a plain 0 into rt_ui_handlers.releaseVars instead of a
// pointer to an empty function).
func cpEmitWinReleaseFn(winName: string): string {
    var fld: int
    var any: bool
    var body: text
    var fname: string

    fld = cpFindWindowStateFields(winName)
    any = false
    body = ""
    while fld != -1 {
        if irtNeedsCtor(irFieldSlotType(fld)) {
            any = true
            cpEmitRelease(body, "(*(clar_uistate_" + winName + " *)rt_ui_state(inst)).cv_" + poolGet(irFieldSlotName(fld)), irFieldSlotType(fld))
        }
        fld = irFieldSlotNext(fld)
    }
    if not any {
        return "0"
    }
    fname = "clar_ui_release_" + winName
    cpUiBuf.add(toText("static void " + fname + "(void *inst)"))
    cpUiBuf.add(toText("{"))
    cpUiBuf.add(body)
    cpUiBuf.add(toText("}"))
    cpUiBuf.add(toText(""))
    return fname
}

// cpEmitWinHandlersFwd prints (into cpUiBuf, BEFORE any clar_fn_ handler-body
// prototype exists anywhere in the emitted file -- cpEmitFuncs's own
// "prototypes up front" pass hasn't run yet at this point in emitProgram's
// assembly order) the forward declarations for window `winName`'s dispatcher
// functions (whichever of winEvent/widget actually have >=1 registered
// handler -- matching probe_ui.c's own "0 for the unused half" convention,
// e.g. kBounceHandlers = { bounce_win_event, 0 }) plus the rt_ui_handlers
// struct wiring them together. The dispatcher bodies themselves are defined
// later (cpEmitUiDispatchers, called AFTER cpEmitFuncs -- see that
// function's header comment for why the split is necessary). Returns the
// handlers struct's own C name (for the window desc to reference), or "0"
// if winName has no `extend` block at all.
func cpEmitWinHandlersFwd(winName: string): string {
    var whIdx: int
    var winFn: string
    var widgetFn: string
    var releaseFn: string

    whIdx = cpFindWinHandlers(winName)
    if whIdx == -1 {
        return "0"
    }
    winFn = "0"
    if cpWinHandlersHasWinEvent(whIdx) and not cpUiPortFlag {
        // native-5e Task 6: under --uiport, clar_ui_fire_winevent (lower.cla's
        // synthesized dispatcher) replaces this per-window function entirely
        // -- suppressed here (not just left undefined) so this struct never
        // forward-declares a name cpEmitUiDispatchers no longer defines.
        // rt_ui_startup itself is untouched this task (Task 7's job), so the
        // struct -- and this NULL slot -- still has to exist.
        winFn = "clar_ui_winevent_" + winName
        cpUiBuf.add(toText("static void " + winFn + "(void *inst, short event, long a, long b);"))
    }
    widgetFn = "0"
    if cpWinHandlersHasWidget(whIdx) and not cpUiPortFlag {
        widgetFn = "clar_ui_widget_" + winName
        cpUiBuf.add(toText("static void " + widgetFn + "(void *inst, short widgetIndex, short event, long a, long b);"))
    }
    releaseFn = cpEmitWinReleaseFn(winName)
    cpUiBuf.add(toText("static const rt_ui_handlers clar_ui_handlers_" + winName + " = { " + winFn + ", " + widgetFn + ", " + releaseFn + " };"))
    cpUiBuf.add(toText(""))
    return "clar_ui_handlers_" + winName
}

// cpEmitOneFormDesc (mac-target-4d Task 7) prints, for one form window, its
// rt_ui_bind_desc[] array (if it has >=1 bound widget; a bare "0" pointer
// otherwise -- an empty-braces array isn't valid C, and rt_ui_form_desc's
// own nBinds=0 already tells the runtime never to read the pointer) and its
// rt_ui_form_desc, into cpUiBuf -- the same cpEmitOneTableDesc precedent
// (Task 4). Returns the form desc's own C name, for the window desc's
// trailing `form` field to reference.
func cpEmitOneFormDesc(winName: string, formRecNameIdx: int, bindsHead: int): string {
    var bindsName: string
    var formName: string
    var b: int
    var nBinds: int
    var bindsRef: string

    bindsName = "clar_ui_binds_" + winName
    nBinds = 0
    b = bindsHead
    while b != -1 {
        nBinds = nBinds + 1
        b = irBindDescNext(b)
    }

    bindsRef = "0"
    if nBinds > 0 {
        cpUiBuf.add(toText("static const rt_ui_bind_desc " + bindsName + "[] = {"))
        b = bindsHead
        while b != -1 {
            cpUiBuf.add(toText("    { " + numToStr(irBindDescWidgetIndex(b)) + ", " + numToStr(irBindDescFieldIndex(b)) + " },"))
            b = irBindDescNext(b)
        }
        cpUiBuf.add(toText("};"))
        bindsRef = bindsName
    }

    formName = "clar_ui_form_" + winName
    cpUiBuf.add(toText("static const rt_ui_form_desc " + formName + " = { &clar_layout_" + poolGet(formRecNameIdx) + ", " + numToStr(nBinds) + ", " + bindsRef + " };"))
    cpUiBuf.add(toText(""))
    return formName
}

// cpEmitWindowDescs prints every window TYPE's widget array + state struct +
// rt_ui_window_desc, in declaration order, into cpUiBuf/cpRecBuf. A form
// window (mac-target-4d Task 7) additionally gets its bind table/form desc
// (cpEmitOneFormDesc) and the window desc's own trailing `form` field,
// appended ONLY when set (irWindowDescFormRecName(i) != -1) -- every
// non-form window's own 11-field literal stays byte-identical to every
// pre-Task-7 golden.
func cpEmitWindowDescs() {
    var i: int
    var name: string
    var widgetsArrName: string
    var nWidgets: int
    var w: int
    var handlersName: string
    var formDescName: string

    i = 0
    while i < irWindowDescs.count {
        name = poolGet(irWindowDescName(i))

        widgetsArrName = "0"
        nWidgets = 0
        w = irWindowDescWidgetsHead(i)
        if w != -1 {
            widgetsArrName = cpEmitWidgetDescArray(name, w)
            while w != -1 {
                nWidgets = nWidgets + 1
                w = irWidgetDescNext(w)
            }
        }

        if irWindowDescStateFieldsHead(i) != -1 {
            cpEmitUiStateStruct(name, irWindowDescStateFieldsHead(i))
            if cpUiPortFlag {
                // Task 5 (native-5e): catches any divergence between
                // uiblob.cla's uibStateSize (mirroring cg68k.cla's
                // LAYOUT AUTHORITY, cg68k.cla:713-807) and the real C
                // struct layout above -- a build-time compile error, not a
                // silent size mismatch discovered only at runtime. Skipped
                // for the no-state-fields case just below: that struct is
                // a deliberate one-byte placeholder never sized against
                // real field layout, so there is nothing to compare.
                cpRecBuf.add(toText("typedef char clar_ui_szassert_" + name + "[(sizeof(clar_uistate_" + name + ") == " + numToStr(uibStateSize(i)) + ") ? 1 : -1];"))
                cpRecBuf.add(toText(""))
            }
        } else {
            // No per-instance vars: a zero-size struct isn't portable C, so
            // a one-byte placeholder stands in -- nothing ever reads it.
            cpRecBuf.add(toText("typedef struct { char clar_ui_unused; } clar_uistate_" + name + ";"))
            cpRecBuf.add(toText(""))
        }

        handlersName = cpEmitWinHandlersFwd(name)
        if handlersName != "0" {
            handlersName = "&" + handlersName
        }

        formDescName = "0"
        if irWindowDescFormRecName(i) != -1 {
            formDescName = "&" + cpEmitOneFormDesc(name, irWindowDescFormRecName(i), irWindowDescFormBindsHead(i))
        }

        cpUiBuf.add(toText("static const rt_ui_window_desc clar_ui_window_" + name + " = {"))
        cpUiBuf.add(toText("    \"" + name + "\", " + cpUiTitleStr(irWindowDescTitle(i)) + ","))
        cpUiBuf.add(toText("    " + numToStr(irWindowDescW(i)) + ", " + numToStr(irWindowDescH(i)) + ", " + cpBoolLit(irWindowDescResizable(i)) + ", " + numToStr(irWindowDescMinW(i)) + ", " + numToStr(irWindowDescMinH(i)) + ","))
        cpUiBuf.add(toText("    " + numToStr(nWidgets) + ", " + widgetsArrName + ","))
        cpUiBuf.add(toText("    (short)sizeof(clar_uistate_" + name + "),"))
        if formDescName == "0" {
            cpUiBuf.add(toText("    " + handlersName))
        } else {
            cpUiBuf.add(toText("    " + handlersName + ","))
            cpUiBuf.add(toText("    " + formDescName))
        }
        cpUiBuf.add(toText("};"))
        cpUiBuf.add(toText(""))
        i = i + 1
    }
}

// cpEmitMenuItemsArray prints one menu's rt_ui_item_desc[] array (Ch9) into
// cpUiBuf, in declaration order (separators occupy a real slot, matching
// lower.cla's uiMenuItemIdx numbering exactly).
func cpEmitMenuItemsArray(menuName: string, headIdx: int): string {
    var name: string
    var it: int

    name = "clar_ui_items_" + menuName
    cpUiBuf.add(toText("static const rt_ui_item_desc " + name + "[] = {"))
    it = headIdx
    while it != -1 {
        if irMenuItemDescIsSeparator(it) {
            cpUiBuf.add(toText("    { 0, 0, 0, 1 },"))
        } else {
            cpUiBuf.add(toText("    { \"" + poolGet(irMenuItemDescName(it)) + "\", " + cpUiCaptionOrNull(irMenuItemDescCaption(it)) + ", " + cpMenuKeyChar(irMenuItemDescKey(it)) + ", 0 },"))
        }
        it = irMenuItemDescNext(it)
    }
    cpUiBuf.add(toText("};"))
    cpUiBuf.add(toText(""))
    return name
}

// cpEmitMenuDescs prints every menu's items array + rt_ui_menu_desc, in
// declaration order, into cpUiBuf. A `standard edit` menu (mac-target-4c
// Task 3) skips the items array entirely -- the runtime builds Undo/Cut/
// Copy/Paste/Clear itself -- and emits the pinned `0, 0, 1` tail instead of
// a real item count/array; every OTHER menu now also gains the trailing
// `standardEdit` field (always 0), since rt_ui_menu_desc (rt_ui.h) gained
// that field for every menu, not just standard-edit ones.
func cpEmitMenuDescs() {
    var i: int
    var name: string
    var itemsName: string
    var nItems: int
    var it: int

    i = 0
    while i < irMenuDescs.count {
        name = poolGet(irMenuDescName(i))
        if irMenuDescIsStandardEdit(i) {
            cpUiBuf.add(toText("static const rt_ui_menu_desc clar_ui_menu_" + name + " = {"))
            cpUiBuf.add(toText("    \"" + name + "\", " + cpUiTitleStr(irMenuDescTitle(i)) + ", 0, 0, 1"))
            cpUiBuf.add(toText("};"))
            cpUiBuf.add(toText(""))
        } else {
            itemsName = cpEmitMenuItemsArray(name, irMenuDescItemsHead(i))
            nItems = 0
            it = irMenuDescItemsHead(i)
            while it != -1 {
                nItems = nItems + 1
                it = irMenuItemDescNext(it)
            }
            cpUiBuf.add(toText("static const rt_ui_menu_desc clar_ui_menu_" + name + " = {"))
            cpUiBuf.add(toText("    \"" + name + "\", " + cpUiTitleStr(irMenuDescTitle(i)) + ", " + numToStr(nItems) + ", " + itemsName + ", 0"))
            cpUiBuf.add(toText("};"))
            cpUiBuf.add(toText(""))
        }
        i = i + 1
    }
}

// cpEmitAppInfo emits the (at most one) `app` section's strong
// rt_ui_app_info definition into cpRestBuf -- NOT cpUiBuf: an `app` section
// is legal (and must still emit) in a non-UI program, unlike everything
// cpEmitUiDescs writes, which is gated on irIsUiProgram(). No-op when the
// program declares no `app` section at all (rt_ui.c's weak default covers
// that case at link time).
func cpEmitAppInfo() {
    var line: text

    if not irHasApp { return }
    if cpUiPortFlag and irIsUiProgram() {
        // native-5e Task 6: for a real UI program, the blob's own App
        // section (cpEmitUiBlob, Task 5) already carries these same four
        // fields -- rt_ui_app_info would be pure duplication. NOT gated on
        // cpUiPortFlag alone: an app-only, non-UI program's cpUiBuf (where
        // the blob would otherwise land) never gets appended to the output
        // at all (emitProgram's own irIsUiProgram() gate), so THAT
        // program's app metadata would vanish outright if this stayed
        // gated on the flag alone.
        return
    }
    // Built as `text` field-by-field, not one `string` concatenation: the
    // four cpUiTitleStr() results plus separators can together exceed 255
    // bytes (an about string alone can run to 255), and `string + string`
    // silently clamps at 255 (rt_str_concat, Ch4) -- exactly the mid-literal
    // C-string truncation this file's `text` convention exists to avoid.
    line = toText("const rt_ui_app_desc rt_ui_app_info = { ")
    line.append(cpUiTitleStr(irAppName))
    line.append(", ")
    line.append(cpUiTitleStr(irAppVersion))
    line.append(", ")
    line.append(cpUiTitleStr(irAppAuthor))
    line.append(", ")
    line.append(cpUiTitleStr(irAppAbout))
    line.append(" };")
    cpRestBuf.add(line)
    if irAppId != -1 {
        // Strong override beside rt_ui_app_info -- overrides Task 1's weak
        // '????' rt_app_creator default (rt.h/rt_mac.c) so saved data files
        // carry this app's own creator. Only emitted when the app section
        // actually declared an id (checkAppDecl requires icon to imply id,
        // but id alone is legal without an icon).
        cpRestBuf.add(toText("const unsigned long rt_app_creator = " + cpAppCreatorHex(irAppId) + "UL; /* '" + poolGet(irAppId) + "' */"))
    }
    cpRestBuf.add(toText(""))
}

// cpAppCreatorHex renders idIdx's 4-character app id (check.cla's
// checkAppId already validated exactly 4 printable ASCII characters) as the
// big-endian hex literal rt_app_creator's strong override needs -- e.g.
// "CBKM" -> "0x43424B4D".
func cpAppCreatorHex(idIdx: int): string {
    var s: string
    var out: string
    var i: int

    s = poolGet(idIdx)
    out = "0x"
    i = 0
    while i < 4 {
        out = out + cpHexByte(int(s[i]))
        i = i + 1
    }
    return out
}

// cpHexByte renders b (0-255) as 2 uppercase hex digits.
func cpHexByte(b: int): string {
    var digits: string
    var out: string

    digits = "0123456789ABCDEF"
    out = ""
    out = out + digits[(b >> 4) & 15]
    out = out + digits[b & 15]
    return out
}

// cpEmitUiBlob (Task 5, native-5e) prints uiblob.cla's uibBuild() result
// -- the plan's normative flat pointer-free UI descriptor blob -- as a
// byte array into cpUiBuf, under --uiport only (cpUiPortFlag). This is
// purely ADDITIVE: every rt_ui_*_desc table cpEmitWindowDescs/
// cpEmitMenuDescs already print above is untouched (Task 11 is the flip
// that retires them and makes ui.cla read this blob exclusively). Grouped
// 20 bytes/line for a readable golden diff; the grouping has no semantic
// meaning, byte VALUES are the only normative contract (uiblob.cla's own
// doc comment).
func cpEmitUiBlob() {
    var bytes: list of int
    var i: int
    var line: string

    bytes = uibBuild()
    cpUiBuf.add(toText("static const unsigned char clar_ui_blob[] = {"))
    line = "   "
    i = 0
    while i < bytes.count {
        line = line + " " + numToStr(bytes[i]) + ","
        if i mod 20 == 19 {
            cpUiBuf.add(toText(line))
            line = "   "
        }
        i = i + 1
    }
    if line != "   " {
        cpUiBuf.add(toText(line))
    }
    cpUiBuf.add(toText("};"))
    cpUiBuf.add(toText(""))
}

func cpEmitUiDescs() {
    cpEmitWindowDescs()
    cpEmitMenuDescs()
    if cpUiPortFlag {
        cpEmitUiBlob()
    }
    if irAnyCloseRequestHandler() {
        // Into cpUiBuf, NOT cpEmitUiWiring's cpRestBuf section: a
        // closeRequest handler's own BODY (an ordinary IRFunc, printed by
        // cpEmitFuncs) references this global directly (the lowered
        // `cancel` statement), and cpEmitFuncs's output lands in cpRestBuf
        // strictly AFTER cpUiBuf in the final file -- declaring it any
        // later would be a forward reference the C compiler rejects.
        cpUiBuf.add(toText("static long *clar_ui_cur_cancel;"))
        cpUiBuf.add(toText(""))
    }
}

// irIsUiProgram reports whether this program declares any window, menu, or
// `every` block -- gates every UI-only emission (the #include "rt_ui.h"
// line, cpUiBuf's own blank-line separator, and Task 5's main()/dispatcher
// wiring below), so a UI-free program's output stays byte-for-byte
// unchanged (the differential suite enforces this).
func irIsUiProgram(): bool {
    return irWindowDescs.count > 0 or irMenuDescs.count > 0 or irEveryCount > 0
}

// irAnyCloseRequestHandler reports whether ANY window type registered a
// closeRequest handler -- gates the `clar_ui_cur_cancel` scratch global
// (cpEmitUiWiring): declaring it unconditionally for every UI program would
// be a static file-scope variable no code ever references on a program with
// no closeRequest handler at all, which -Wall's -Wunused-variable flags (a
// NEW warning the gate forbids).
func irAnyCloseRequestHandler(): bool {
    var i: int

    i = 0
    while i < irWinHandlers.count {
        if irWinHandlersCloseRequestFn(i) != -1 {
            return true
        }
        i = i + 1
    }
    return false
}

// cpEmitOneWinEventDispatcher defines (into cpRestBuf) window `winName`'s
// winEvent dispatcher body -- cpEmitWinHandlersFwd already forward-declared
// its prototype into cpUiBuf; this runs AFTER cpEmitFuncs (see
// cpEmitUiWiring) so every clar_fn_ handler-body name it calls is already
// declared. The RTUI_EV_CLOSEREQUEST case sets clar_ui_cur_cancel from `a`
// BEFORE calling in (the ledger's `a = (long)&long cancelFlag` convention);
// RTUI_EV_KEY casts `a` to the handler's own declared `char` param.
func cpEmitOneWinEventDispatcher(winName: string, whIdx: int) {
    if not cpWinHandlersHasWinEvent(whIdx) {
        return
    }
    cpRestBuf.add(toText("static void clar_ui_winevent_" + winName + "(void *inst, short event, long a, long b) {"))
    cpRestBuf.add(toText("    switch (event) {"))
    if irWinHandlersOpenedFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_OPENED: clar_fn_" + poolGet(irWinHandlersOpenedFn(whIdx)) + "(inst); break;"))
    }
    if irWinHandlersCloseRequestFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_CLOSEREQUEST: clar_ui_cur_cancel = (long *)a; clar_fn_" + poolGet(irWinHandlersCloseRequestFn(whIdx)) + "(inst); break;"))
    }
    if irWinHandlersClosedFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_CLOSED: clar_fn_" + poolGet(irWinHandlersClosedFn(whIdx)) + "(inst); break;"))
    }
    if irWinHandlersResizedFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_RESIZED: clar_fn_" + poolGet(irWinHandlersResizedFn(whIdx)) + "(inst); break;"))
    }
    if irWinHandlersKeyFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_KEY: clar_fn_" + poolGet(irWinHandlersKeyFn(whIdx)) + "(inst, (char)a); break;"))
    }
    if irWinHandlersAcceptedFn(whIdx) != -1 {
        // Ch10: `on accepted(b: T)` -- `a` is (long)&<the walker's own
        // validated record>; the handler's own declared param is BY VALUE
        // (cast+deref), never a pointer (rt_ui.h's RTUI_EV_ACCEPTED comment).
        cpRestBuf.add(toText("    case RTUI_EV_ACCEPTED: clar_fn_" + poolGet(irWinHandlersAcceptedFn(whIdx)) + "(inst, *(clar_rec_" + poolGet(irWinHandlersFormRecName(whIdx)) + " *)a); break;"))
    }
    if irWinHandlersCancelledFn(whIdx) != -1 {
        cpRestBuf.add(toText("    case RTUI_EV_CANCELLED: clar_fn_" + poolGet(irWinHandlersCancelledFn(whIdx)) + "(inst); break;"))
    }
    cpRestBuf.add(toText("    default: break;"))
    cpRestBuf.add(toText("    }"))
    cpRestBuf.add(toText("}"))
    cpRestBuf.add(toText(""))
}

// cpEmitOneWidgetDispatcher defines (into cpRestBuf) window `winName`'s
// widget dispatcher body -- switches on widgetIndex, then on event; each
// widget's calling convention (0 args for button click / check change vs.
// (x, y) cast from a/b for canvas click/drag) is picked by that widget's OWN
// kind (cpWidgetKindForIndex), since RTUI_WEV_CLICK is shared by both
// button.click and canvas.click.
func cpEmitOneWidgetDispatcher(winName: string, whIdx: int) {
    var wEntry: int
    var kind: string
    var idx: int

    if not cpWinHandlersHasWidget(whIdx) {
        return
    }
    cpRestBuf.add(toText("static void clar_ui_widget_" + winName + "(void *inst, short widgetIndex, short event, long a, long b) {"))
    cpRestBuf.add(toText("    switch (widgetIndex) {"))
    wEntry = irWinHandlersWidgetHead(whIdx)
    while wEntry != -1 {
        idx = irWidgetHandlerEntryWidgetIndex(wEntry)
        kind = cpWidgetKindForIndex(winName, idx)
        cpRestBuf.add(toText("    case " + numToStr(idx) + ":"))
        if kind == "canvas" {
            if irWidgetHandlerEntryClickFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_CLICK) clar_fn_" + poolGet(irWidgetHandlerEntryClickFn(wEntry)) + "(inst, (int32_t)a, (int32_t)b);"))
            }
            if irWidgetHandlerEntryDragFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_DRAG) clar_fn_" + poolGet(irWidgetHandlerEntryDragFn(wEntry)) + "(inst, (int32_t)a, (int32_t)b);"))
            }
        } else if kind == "table" {
            // table.select/doubleClick (mac-target-4d Task 5): one-arg
            // handlers, the clicked row index (RTUI_WEV_SELECT/DBLCLICK's
            // `a`) -- same (int32_t)a cast canvas's click/drag already use.
            if irWidgetHandlerEntrySelectFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_SELECT) clar_fn_" + poolGet(irWidgetHandlerEntrySelectFn(wEntry)) + "(inst, (int32_t)a);"))
            }
            if irWidgetHandlerEntryDoubleClickFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_DBLCLICK) clar_fn_" + poolGet(irWidgetHandlerEntryDoubleClickFn(wEntry)) + "(inst, (int32_t)a);"))
            }
        } else {
            // button (click only) / check/field/textview (change only) /
            // field (enter, mac-target-4c Task 2): all zero-param Clarus
            // handlers (Ch8's event table).
            if irWidgetHandlerEntryClickFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_CLICK) clar_fn_" + poolGet(irWidgetHandlerEntryClickFn(wEntry)) + "(inst);"))
            }
            if irWidgetHandlerEntryChangeFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_CHANGE) clar_fn_" + poolGet(irWidgetHandlerEntryChangeFn(wEntry)) + "(inst);"))
            }
            if irWidgetHandlerEntryEnterFn(wEntry) != -1 {
                cpRestBuf.add(toText("        if (event == RTUI_WEV_ENTER) clar_fn_" + poolGet(irWidgetHandlerEntryEnterFn(wEntry)) + "(inst);"))
            }
        }
        cpRestBuf.add(toText("        break;"))
        wEntry = irWidgetHandlerEntryNext(wEntry)
    }
    cpRestBuf.add(toText("    default: break;"))
    cpRestBuf.add(toText("    }"))
    cpRestBuf.add(toText("}"))
    cpRestBuf.add(toText(""))
}

// cpEmitUiDispatchers defines every window type's forward-declared
// dispatcher bodies, in declaration order.
func cpEmitUiDispatchers() {
    var i: int
    var name: string
    var whIdx: int

    i = 0
    while i < irWindowDescs.count {
        name = poolGet(irWindowDescName(i))
        whIdx = cpFindWinHandlers(name)
        if whIdx != -1 {
            cpEmitOneWinEventDispatcher(name, whIdx)
            cpEmitOneWidgetDispatcher(name, whIdx)
        }
        i = i + 1
    }
}

// cpEmitMenuHandlerArray prints the rt_ui_menu_handler[] table (Ch9), in
// declaration order -- referencing clar_fn_ fire functions (already
// declared by cpEmitFuncs, called before this) and window-desc pointers
// (already fully defined earlier in cpUiBuf; a forward-direction reference
// is always fine in C).
func cpEmitMenuHandlerArray() {
    var e: int
    var scopeStr: string

    if irMenuHandlersHead == -1 {
        return
    }
    cpRestBuf.add(toText("static const rt_ui_menu_handler clar_ui_menu_handlers[] = {"))
    e = irMenuHandlersHead
    while e != -1 {
        scopeStr = "0"
        if irMenuHandlerEntryScopeWinType(e) != -1 {
            scopeStr = "&clar_ui_window_" + poolGet(irMenuHandlerEntryScopeWinType(e))
        }
        cpRestBuf.add(toText("    { clar_fn_" + poolGet(irMenuHandlerEntryFuncName(e)) + ", \"" +
            cpEscapeCStr(poolGet(irMenuHandlerEntryMenuName(e))) + "\", \"" +
            cpEscapeCStr(poolGet(irMenuHandlerEntryItemName(e))) + "\", " +
            numToStr(irMenuHandlerEntryMenuIdx(e)) + ", " + numToStr(irMenuHandlerEntryItemIdx(e)) + ", " + scopeStr + " },"))
        e = irMenuHandlerEntryNext(e)
    }
    cpRestBuf.add(toText("};"))
    cpRestBuf.add(toText(""))
}

// cpEmitEveryArray prints the rt_ui_every_desc[] table (Ch7/Ch11), in
// declaration order (the SAME order the `T FIRE every.<n>` trace index
// uses).
func cpEmitEveryArray() {
    var e: int

    if irEveryHead == -1 {
        return
    }
    cpRestBuf.add(toText("static const rt_ui_every_desc clar_ui_every[] = {"))
    e = irEveryHead
    while e != -1 {
        cpRestBuf.add(toText("    { clar_fn_" + poolGet(irEveryEntryFuncName(e)) + ", " + numToStr(irEveryEntryTicks(e)) + " },"))
        e = irEveryEntryNext(e)
    }
    cpRestBuf.add(toText("};"))
    cpRestBuf.add(toText(""))
}

// cpEmitUiWiring emits (into cpRestBuf, called AFTER cpEmitFuncs so every
// clar_fn_ name it references is already declared -- see
// cpEmitOneWinEventDispatcher's header comment): the dispatcher
// definitions, the menu-handler array, and the every array (the
// `clar_ui_cur_cancel` scratch global itself is declared earlier, by
// cpEmitUiDescs -- see that function's header comment for why). A no-op for
// a UI-free program.
func cpEmitUiWiring() {
    if not irIsUiProgram() {
        return
    }
    if not cpUiPortFlag {
        // native-5e Task 6: clar_ui_winevent_<Win>/clar_ui_widget_<Win> --
        // the OLD per-window dispatcher bodies (cpEmitOneWinEventDispatcher/
        // cpEmitOneWidgetDispatcher) -- are suppressed under --uiport;
        // lower.cla's synthesized clar_ui_fire_winevent/_widget (ordinary
        // IRFuncs, printed by cpEmitFuncs above like any other function)
        // replace them. cpEmitWinHandlersFwd (cpEmitWindowDescs, called
        // earlier) already nulled the two forward-declared function-pointer
        // slots that used to name them, so nothing is left dangling.
        //
        // clar_ui_menu_handlers[]/clar_ui_every[] (cpEmitMenuHandlerArray/
        // cpEmitEveryArray) are NOT suppressed: cpEmitUiMain -- untouched
        // this task, Task 7's job -- still passes their addresses to
        // rt_ui_startup by name; suppressing them here would leave that
        // still-live call site referencing an undefined symbol.
        cpEmitUiDispatchers()
    }
    cpEmitMenuHandlerArray()
    cpEmitEveryArray()
}

// cpEmitGlobalsInit declares every global as a bare (uninitialized-in-C)
// file-scope variable, then defines clar_init_globals, which applies each
// one's default (RecordLayout defaults for a nil-Init Rec; the type's zero/
// empty/fresh-handle value for anything else nil-Init) followed by its
// explicit Init expression, if any, in declaration order -- cprint.go's
// emitGlobalsAndInit. Globals can't be given real C initializers at file
// scope: several of their defaults (clar_new_NAME, rt_list_new, ...) are
// function calls, and C requires file-scope initializers to be constant
// expressions. Right after clar_init_globals, also emits cl_free_globals
// (memory-audit Task 5): the destructor mirror of the init loop above,
// walking the same irGlobals arena and calling cpEmitRelease per global,
// UNCONDITIONALLY (ARC Task 6) -- Tasks 4-5 made every RUNTIME store into a
// global (assignment/push/element-read/record-field-store that aliases two
// globals) counted, so both roots of a runtime alias carry their own
// independent +1 and releasing every global's slot here is sound. This
// replaces the old lowGlobalsVarQualifies escape-walker consult (final-
// review Critical 1's fix, formerly guarding against exactly that double-
// free) -- now provably unnecessary for RUNTIME stores; cpEmitRelease
// itself no-ops for a non-ctor type, so the call is unconditional rather
// than re-testing irtNeedsCtor here too.
//
// A global's OWN Init expression is a SEPARATE code path, though (this
// function prints it directly below, never via lowCountedStore -- unlike
// every runtime store) -- ARC Task 6 review round 1 shipped this function
// still trusting an uncounted `else { cv_g2 = fpExpr(initE); }` plain
// pointer-copy for a bare-alias Init (`var g2: text = g1`), which the new
// unconditional release then double-released: reviewer-reproduced
// over-release, fixed in round 2 by giving the Init path its own birth-vs-
// retain classification (irGlobalInitBirth, set by lowGlobalVarDecl using
// the SAME lowStoreIsBirth/lowStoreIntrOwnsResult rule a runtime store
// uses) and retaining a non-birth Init's value right after the plain-assign
// below -- see that branch's own comment.
func cpEmitGlobalsInit() {
    var i: int
    var gt: int
    var initE: int
    var nm: string
    var j: int
    var freeBuf: text
    var fullReplace: bool
    var initRetainBuf: text

    i = 0
    while i < irGlobals.count {
        cpRestBuf.add(toText("static " + cpCType(irGlobalType(i)) + " cv_" + poolGet(irGlobalName(i)) + ";"))
        i = i + 1
    }

    fpReset(1)
    i = 0
    while i < irGlobals.count {
        gt = irGlobalType(i)
        nm = poolGet(irGlobalName(i))
        initE = irGlobalInit(i)
        // A needs-ctor global (Text/List/Map/Rec/Arr) whose Init falls
        // through to the plain `cv_x = fpExpr(initE);` replace below (every
        // case except the KStr and Text<-Str special-cases, which store
        // INTO the default-built handle rather than replacing it) would
        // have cpDefaultInit's fresh handle immediately discarded and
        // orphaned -- a leak cl_free_globals can never reach, since nothing
        // still points to it once overwritten. Skip building it: the bare
        // `static` C global is already zero/NULL, a safe placeholder for
        // the one instant before the real assignment runs right after.
        fullReplace = initE != -1 and irtNeedsCtor(gt) and not (irtKind(gt) == KText and irtKind(irExprType(initE)) == KStr)
        if not fullReplace {
            cpDefaultInit(toText("cv_" + nm), gt, 0, -1)
        }
        if initE != -1 {
            if irtKind(gt) == KStr {
                fpStoreStr(newIRVarRef(irGlobalName(i), true, gt), initE)
            } else if irtKind(gt) == KText and irtKind(irExprType(initE)) == KStr {
                // String -> Text is documented assignability (Ch3); a Text
                // handle and a Str value have no common C representation to
                // plain-assign between, so this goes through rt_text_store
                // like a local var's matching ExprStmt/ITextStore case does
                // (lower.cla's lowStoreStmt) -- globals just never route
                // through that helper. Plan 5b Task 9: cpTextPorted
                // redirects to clar_fn_rtTextStore, same (void*) discipline
                // as every other ported text call site.
                if cpTextPorted {
                    fpEmit("clar_fn_rtTextStore((void*)cv_" + nm + ", (void*)" + fpStrAddr(initE) + ");")
                } else {
                    fpEmit("rt_text_store(cv_" + nm + ", " + fpStrAddr(initE) + ");")
                }
            } else {
                fpEmit("cv_" + nm + " = " + fpExpr(initE) + ";")
                if irtNeedsCtor(gt) and not irGlobalInitBirth(i) {
                    // ARC Task 6 fix (reviewer Critical): this plain
                    // pointer-copy is a bare-alias (or other non-birth)
                    // Init -- `cv_g2 = cv_g1` shares g1's handle with NO
                    // retain, so cl_free_globals's now-unconditional
                    // release of both g1 and g2 would over-release an
                    // rc==1 handle. Retain here: lowGlobalVarDecl computed
                    // irGlobalInitBirth using the SAME lowStoreIsBirth/
                    // lowStoreIntrOwnsResult rule a real lowCountedStore
                    // does for a runtime store. cpEmitRetain, not a bare
                    // rt_*_retain call: it's the ALREADY-correct dispatcher
                    // for every needs-ctor kind (KRec's own retain walk,
                    // KArr's per-element loop, not just KText/KList/KMap --
                    // same reason IListFreeVar's own retain/release
                    // counterpart above reuses cpEmitRelease instead of
                    // hand-rolling a kind switch). It appends into a
                    // caller-owned `text` buffer (its own one-level indent),
                    // so the whole result -- one line for a scalar handle,
                    // several for a walked Arr/Rec -- is emitted as ONE
                    // fpBody entry, same trick this function's OWN
                    // cl_free_globals loop (below) and IListFreeVar use.
                    initRetainBuf = ""
                    cpEmitRetain(initRetainBuf, "cv_" + nm, gt)
                    fpEmit(initRetainBuf)
                }
            }
        }
        i = i + 1
    }
    cpRestBuf.add(toText("static void clar_init_globals(void) {"))
    j = 0
    while j < fpBody.count {
        cpRestBuf.add(fpBody[j])
        j = j + 1
    }
    cpRestBuf.add(toText("}"))
    cpRestBuf.add(toText(""))
    // See cpEmitFunc's matching comment: clear fpBody so a program with no
    // functions at all (globals-init is the last fpBody harvest) doesn't
    // leave cv_fpBody aliasing cv_cpRestBuf's just-copied handles at exit.
    fpReset(1)

    freeBuf = ""
    i = 0
    while i < irGlobals.count {
        gt = irGlobalType(i)
        nm = poolGet(irGlobalName(i))
        cpEmitRelease(freeBuf, "cv_" + nm, gt)
        i = i + 1
    }
    cpRestBuf.add(toText("static void cl_free_globals(void) {"))
    cpRestBuf.add(freeBuf)
    cpRestBuf.add(toText("}"))
    cpRestBuf.add(toText(""))
}

// cpEmitStrLits prints the interned string-literal pool as clar_str_255
// constants (cprint.go's emitStrLits). StrConst.Idx indexes this pool.
func cpEmitStrLits() {
    var i: int
    var s: string
    var bytesStr: text
    var j: int

    i = 0
    while i < irStrLits.count {
        s = poolGet(irStrLitPoolIdx(i))
        bytesStr = ""
        j = 0
        while j < s.length {
            if j > 0 {
                bytesStr = bytesStr + ", "
            }
            bytesStr = bytesStr + numToStr(int(s[j]))
            j = j + 1
        }
        cpLitBuf.add("static const clar_str_255 clar_lit_" + numToStr(i) + " = {" + numToStr(s.length) + ", {" + bytesStr + "}};")
        i = i + 1
    }
}

// cpEmitUiMain prints main() for a program declaring any window/menu/every
// (Task 5): rt_args_init/clar_init_globals (same relative order as the
// non-UI path below -- nothing depends on the other), the window-desc and
// menu-desc pointer arrays rt_ui_startup wants, rt_ui_startup itself,
// launch (Ch7: startCLI never fires on the Macintosh, so a UI program's own
// `on App.startCLI` handler, if any, is simply never called here -- dead
// per the reference, not a lowering gap), then rt_ui_launch (mac-target-4c
// Task 5) -- which decides openDocument-vs-startEmpty itself (GetAppFiles/
// AppleEvents on a real build, the scripted `launchdoc` verb under
// RT_MAC_TEST) -- then rt_ui_run (returns on quit).
func cpEmitUiMain() {
    var i: int
    var winsExpr: string
    var winsCount: string
    var menusExpr: string
    var menusCount: string
    var mhExpr: string
    var mhCount: string
    var evExpr: string
    var evCount: string
    var openDocExpr: string
    var startEmptyExpr: string

    // Task 7 Step 6 (native-5e): under --uiport, main() calls the PORTED
    // rtUiStartup/rtUiLaunch/rtUiRun instead -- all three are zero-arg
    // (report log entry #5's own redesign: every count/table the old
    // 8-arg rt_ui_startup signature took now comes straight from the
    // blob at RUNTIME, via UiProgDesc()/uidesc.cla's own accessors, so
    // none of this function's own array-building/wrapper-function
    // machinery below is needed at all under this flag). App.launch
    // still fires exactly where it always did (between startup and
    // launch) -- unrelated to any of this port's own changes.
    if cpUiPortFlag {
        cpRestBuf.add(toText("int main(int argc, char **argv) {"))
        cpRestBuf.add(toText("    clar_init_globals();"))
        cpRestBuf.add(toText("    rt_register_cleanup(cl_free_globals);"))
        cpRestBuf.add(toText("    rt_args_init(argc, argv);"))
        cpRestBuf.add(toText("    clar_fn_rtUiStartup();"))
        if irHasLaunch {
            cpRestBuf.add(toText("    clar_fn_handler_App_launch();"))
        }
        cpRestBuf.add(toText("    clar_fn_rtUiLaunch();"))
        cpRestBuf.add(toText("    clar_fn_rtUiRun();"))
        cpRestBuf.add(toText("    return 0;"))
        cpRestBuf.add(toText("}"))
        return
    }

    winsExpr = "0"
    winsCount = "0"
    if irWindowDescs.count > 0 {
        cpRestBuf.add(toText("static const rt_ui_window_desc *clar_ui_windows[] = {"))
        i = 0
        while i < irWindowDescs.count {
            cpRestBuf.add(toText("    &clar_ui_window_" + poolGet(irWindowDescName(i)) + ","))
            i = i + 1
        }
        cpRestBuf.add(toText("};"))
        cpRestBuf.add(toText(""))
        winsExpr = "clar_ui_windows"
        winsCount = numToStr(irWindowDescs.count)
    }

    menusExpr = "0"
    menusCount = "0"
    if irMenuDescs.count > 0 {
        cpRestBuf.add(toText("static const rt_ui_menu_desc *clar_ui_menus[] = {"))
        i = 0
        while i < irMenuDescs.count {
            cpRestBuf.add(toText("    &clar_ui_menu_" + poolGet(irMenuDescName(i)) + ","))
            i = i + 1
        }
        cpRestBuf.add(toText("};"))
        cpRestBuf.add(toText(""))
        menusExpr = "clar_ui_menus"
        menusCount = numToStr(irMenuDescs.count)
    }

    mhExpr = "0"
    mhCount = "0"
    if irMenuHandlersHead != -1 {
        mhExpr = "clar_ui_menu_handlers"
        mhCount = numToStr(irMenuHandlerCount)
    }

    evExpr = "0"
    evCount = "0"
    if irEveryHead != -1 {
        evExpr = "clar_ui_every"
        evCount = numToStr(irEveryCount)
    }

    // openDocument's handler takes its `path: string` by value (clar_str_255,
    // same convention as every other by-value string param -- see
    // cpFuncProto), but rt_ui_launch's fnptr ABI (rt_ui.h) is pinned to
    // `void (*)(const uint8_t *path255)` so rt_ui.c -- which never sees
    // clar_str_255, a per-program typedef -- can call it without knowing the
    // emitted program's own types. clar_str_255 and a Str255-shaped
    // `path255` buffer are the SAME 256-byte layout (uint8_t len + 255
    // bytes), the same identity every other rt_ui string call site already
    // relies on (e.g. rt_ui_ask_open's `(uint8_t*)&(clar_str_255_var)`), so
    // the wrapper below is a bare reinterpret + by-value call, no copy.
    openDocExpr = "0"
    if irHasOpenDocument {
        cpRestBuf.add(toText("static void clar_ui_opendoc_wrap(const uint8_t *path255) {"))
        cpRestBuf.add(toText("    clar_fn_handler_App_openDocument(*(const clar_str_255 *)path255);"))
        cpRestBuf.add(toText("}"))
        cpRestBuf.add(toText(""))
        openDocExpr = "clar_ui_opendoc_wrap"
    }

    // startEmpty already matches rt_ui_launch's `void (*)(void)` exactly
    // (no params) -- no wrapper needed, the bare function name decays to a
    // pointer like any other C function reference.
    startEmptyExpr = "0"
    if irHasStartEmpty {
        startEmptyExpr = "clar_fn_handler_App_startEmpty"
    }

    cpRestBuf.add(toText("int main(int argc, char **argv) {"))
    cpRestBuf.add(toText("    clar_init_globals();"))
    cpRestBuf.add(toText("    rt_register_cleanup(cl_free_globals);"))
    cpRestBuf.add(toText("    rt_args_init(argc, argv);"))
    cpRestBuf.add(toText("    rt_ui_startup(" + winsExpr + ", " + winsCount + ", " + menusExpr + ", " + menusCount + ", " + mhExpr + ", " + mhCount + ", " + evExpr + ", " + evCount + ");"))
    if irHasLaunch {
        cpRestBuf.add(toText("    clar_fn_handler_App_launch();"))
    }
    cpRestBuf.add(toText("    rt_ui_launch(" + openDocExpr + ", " + startEmptyExpr + ");"))
    cpRestBuf.add(toText("    rt_ui_run();"))
    cpRestBuf.add(toText("    return 0;"))
    cpRestBuf.add(toText("}"))
}

// cpEmitMain prints the fixed entry point (cprint.go's emitMain): init
// globals, stash argv, then launch, then startCLI (else startEmpty) -- for
// a UI program (Task 5), cpEmitUiMain takes over instead, so a UI-free
// program's output stays byte-for-byte unchanged (the differential suite
// enforces this).
func cpEmitMain() {
    if irIsUiProgram() {
        cpEmitUiMain()
        return
    }
    cpRestBuf.add(toText("int main(int argc, char **argv) {"))
    cpRestBuf.add(toText("    clar_init_globals();"))
    cpRestBuf.add(toText("    rt_register_cleanup(cl_free_globals);"))
    cpRestBuf.add(toText("    rt_args_init(argc, argv);"))
    if irHasLaunch {
        cpRestBuf.add(toText("    clar_fn_handler_App_launch();"))
    }
    if irHasStartCLI {
        cpRestBuf.add(toText("    clar_fn_handler_App_startCLI(rt_args_list());"))
    } else if irHasStartEmpty {
        cpRestBuf.add(toText("    clar_fn_handler_App_startEmpty();"))
    }
    cpRestBuf.add(toText("    return 0;"))
    cpRestBuf.add(toText("}"))
}

// ================================================================
// Assembly + output
// ================================================================

func cpResetBuffers() {
    while cpTypeBuf.count > 0 {
        cpTypeBuf.pop()
    }
    while cpLitBuf.count > 0 {
        cpLitBuf.pop()
    }
    while cpRecBuf.count > 0 {
        cpRecBuf.pop()
    }
    while cpUiBuf.count > 0 {
        cpUiBuf.pop()
    }
    while cpRestBuf.count > 0 {
        cpRestBuf.pop()
    }
}

// cpAppendLine appends a `string`-sourced line to out, followed by a single
// LF (byte 10, via char(10) -- never CR/13, and never alert's own newline
// handling). append takes a char directly, unlike `+` concatenation.
func cpAppendLine(out: text, line: string) {
    out.append(line)
    out.append(char(10))
}

// cpAppendTextLine is cpAppendLine for a `text`-sourced line -- one that may
// exceed a `string`'s 255-byte capacity (cpLitBuf's lines). A separate
// function, not an overload: a `text` argument bound to a `string` parameter
// (or vice versa) is either a type error or a lowering gap (see the header
// comment), so each buffer's lines must reach `out.append` through the
// function whose parameter already matches their real type.
func cpAppendTextLine(out: text, line: text) {
    out.append(line)
    out.append(char(10))
}

// cpAppendTextList appends every line of a `list of text` buffer to out
// (cpAppendTextLine per line, in order). Every C-code buffer is `list of
// text` now (see the header comment), so this is the only list appender.
func cpAppendTextList(out: text, buf: list of text) {
    var i: int

    i = 0
    while i < buf.count {
        cpAppendTextLine(out, buf[i])
        i = i + 1
    }
}

// emitProgram renders the whole IR (ir.cla arenas) into one `text` buffer, in
// Emit's fixed assembly order (cprint.go's Emit), and returns it. Same input
// always assembles the same buffers in the same order, so the returned bytes
// are deterministic.
func emitProgram(): text {
    var out: text

    out = ""
    cpResetBuffers()

    cpEnsureStr(255)   // literal pool + every intrinsic string temp use this
    cpRecBuf.add(toText("typedef struct { int32_t code; clar_str_255 message; } clar_rec_Err;"))
    cpRecBuf.add(toText(""))

    cpEmitStrLits()
    cpEmitDefaultInitFnProtos()
    cpEmitRecords()
    cpEmitLayouts()
    cpEmitSerDescs()
    cpEmitEnums()
    cpEmitUiDescs()
    cpEmitAppInfo()
    cpEmitGlobalsInit()
    cpEmitExternProtos()
    cpEmitFuncs()
    cpEmitUiWiring()
    cpEmitMain()
    // ARC Task 7: cpEmitRcWalks must run AFTER cpEmitFuncs()/
    // cpEmitGlobalsInit() -- see its own doc comment. It still populates
    // cpRecBuf, which the assembly below still places right after
    // cpEmitRecords' own output (position in the FINAL file is controlled
    // by cpAppendTextList's own call order below, not by when cpRecBuf
    // gets appended to during this function's execution).
    cpEmitRcWalks()

    cpAppendLine(out, "/* Generated by clarus (internal/cprint). Do not edit. */")
    cpAppendLine(out, "#include \"rt.h\"")
    if irIsUiProgram() or irHasApp {
        // Only when the program actually declares a window/menu/every, OR
        // an `app` section -- a UI-free, app-free program's emitted C must
        // stay byte-identical to before this task (the differential suite
        // enforces it). An every-only program (no window/menu at all)
        // still needs rt_ui.h: its main() calls rt_ui_startup/rt_ui_run
        // (Task 5) same as any other UI program. An `app`-only program
        // (Task 2) needs rt_ui.h too, for the rt_ui_app_desc typedef its
        // rt_ui_app_info definition uses -- irIsUiProgram() itself stays
        // untouched: widening THAT would route a CLI program into
        // cpEmitUiMain, the wrong main().
        cpAppendLine(out, "#include \"rt_ui.h\"")
    }
    cpAppendLine(out, "#include <stddef.h> /* NULL, used by rt_text_concat's bstr/btext args */")
    cpAppendLine(out, "")
    cpAppendTextList(out, cpTypeBuf)
    cpAppendLine(out, "")
    cpAppendTextList(out, cpLitBuf)
    cpAppendLine(out, "")
    cpAppendTextList(out, cpRecBuf)
    cpAppendLine(out, "")
    if irIsUiProgram() {
        // Gated exactly like the #include above: a UI-free program's cpUiBuf
        // is always empty, and emitting an unconditional extra blank line
        // here would perturb byte-identical UI-free output.
        cpAppendTextList(out, cpUiBuf)
        cpAppendLine(out, "")
    }
    cpAppendTextList(out, cpRestBuf)

    return out
}

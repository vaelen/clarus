// cprint.cla: arena IR (ir.cla) -> one self-contained C99 translation unit
// that #includes "rt.h". A port of the walking-skeleton subset of
// internal/cprint (cprint.go / funcprint.go / intr.go / types.go).
//
// Output channel: emitProgram returns the whole translation unit as one
// `text` buffer (mirrors the Go internal/cprint.Emit, which returns the unit
// as bytes) -- the caller (main.cla) writes it via file.writeText, which is
// byte-faithful and uncapped. Each section still accumulates its lines into a
// buffer as before (cType may append a clar_str_N typedef to cpTypeBuf at any
// point during body printing, the first time an unseen capacity appears, so
// the buffers are assembled fully before any line is appended to the output);
// emitProgram then appends every buffer's lines, each followed by a single LF
// (char(10)), into the returned text in Emit's fixed assembly order.
//
// cpLitBuf is `list of text`, not `list of string`, unlike the other three
// buffers: its one producer, cpEmitStrLits, builds each line as `... + {" +
// bytesStr + "}};"` where bytesStr is itself a `text` accumulator (the
// literal's byte list, which can run well past 255 bytes for a >60-byte
// source string) -- a `string`, capped at 255, would silently clamp that
// line before it ever reached the output stage. Once bytesStr is `text`,
// the `+` chain that embeds it is *already* `text`-typed by the checker
// (Ch3: `string + text` -> `text`), so cpLitBuf must hold `text` values to
// receive it without a truncating re-clamp.
//
// The other three buffers (cpTypeBuf, cpRecBuf, cpRestBuf) stay `list of
// string`: every line they hold today is fixed, short boilerplate (a
// typedef, an init function, main) built from pure `string` concatenation
// with no `text` operand anywhere in the expression. That matters beyond
// style: passing a plain `string` value where a `text` is expected only
// type-checks (Ch3's documented `string` -> `text` widen) at a plain
// assignment (`t = s`) -- a user function call's argument, a `list of
// text`'s pushed element, and a function's `return` value are separate
// lowering paths that do not yet implement that widen (each binds the value
// into a `text`-shaped C slot without going through the assignment machinery
// that performs the conversion), so a `string` value handed to any of those
// three either fails to compile (a call argument, where the mismatch is a
// visible C type error) or is silently miscopied (a list push, which goes
// through a `void*`-typed runtime call the C compiler can't check). Widening
// cpTypeBuf/cpRecBuf/cpRestBuf to `list of text` wholesale would put every
// one of their many pure-`string` `.add(...)` calls on the second, silent
// path. Keeping them `string` (their real content never needs more) and
// widening only cpLitBuf -- whose one line is already `text`-typed by
// construction, never by an implicit call/push/return conversion -- fixes
// the reported bug without relying on an unimplemented conversion.
//
// This is the Task 3 skeleton: it emits ONLY what the seed program needs
// (clar_str_255, the string-literal pool, the clar_rec_Err typedef, an empty
// clar_init_globals, one void handler Func with an ExprStmt body, and main).
// Every branch a later task fills in is marked "Task 4+".

include "lib.cla"
include "ir.cla"

// ================================================================
// Whole-program buffers (cprint.go's printer struct), assembled in a fixed
// final order. One emitProgram call per process, so these start empty.
// ================================================================

var cpTypeBuf: list of string   // string-capacity (+ array-wrapper, Task 4+) typedefs
var cpLitBuf: list of text      // string-literal pool -- `text`, not `string`: see below
var cpRecBuf: list of string    // record structs (seeded with clar_rec_Err)
var cpRestBuf: list of string   // globals init, funcs, main

// cpStrCapsEmitted keys the string capacities already emitted into cpTypeBuf
// (keyed by numToStr(n)); each clar_str_N typedef is emitted once.
var cpStrCapsEmitted: map of int

// cpArrEmitted keys the clar_arr_<elem>_<N> wrapper typedefs already
// emitted into cpRecBuf (keyed by the wrapper's own type name), so each
// distinct array shape is emitted once.
var cpArrEmitted: map of int

// ================================================================
// funcPrinter (funcprint.go): one function body's lines, temp counter, and
// indent. Modeled as module state -- one function is printed at a time and
// printing is not reentrant in the skeleton.
// ================================================================

var fpBody: list of string
var fpTmpN: int
var fpIndent: int

func fpReset(indent: int) {
    while fpBody.count > 0 {
        fpBody.pop()
    }
    fpTmpN = 0
    fpIndent = indent
}

// fpEmit appends one indented body line (4 spaces per indent level).
func fpEmit(line: string) {
    var pad: string
    var i: int

    pad = ""
    i = 0
    while i < fpIndent {
        pad = pad + "    "
        i = i + 1
    }
    fpBody.add(pad + line)
}

// fpNewTmp declares a fresh `ctype tN;` at the current position and returns
// its name (funcprint.go's newTmp). The counter is monotonic within a
// function and never reset mid-function -- load-bearing for later bootstrap
// determinism.
func fpNewTmp(ctype: string): string {
    var name: string

    fpTmpN = fpTmpN + 1
    name = "t" + numToStr(fpTmpN)
    fpEmit(ctype + " " + name + ";")
    return name
}

// ================================================================
// Type printing (types.go subset)
// ================================================================

// cpCTypeName is the pure C type name for an IR type index (no side effects).
func cpCTypeName(t: int): string {
    switch irtKind(t) {
    case KVoid { return "void" }
    case KInt { return "int32_t" }
    case KBool { return "int32_t" }
    case KFixed { return "int32_t" }
    case KEnum { return "int32_t" }
    case KChar { return "uint8_t" }
    case KStr { return "clar_str_" + numToStr(irtN(t)) }
    case KText { return "rt_text *" }
    case KList { return "rt_list *" }
    case KMap { return "rt_map *" }
    case KRec { return "clar_rec_" + poolGet(irtName(t)) }
    case KErr { return "clar_rec_Err" }
    case KArr { return "clar_arr_" + cpArrKey(t) }
    }
    return "void"
}

// cpArrKey names one Arr type's wrapper typedef, distinct per (element
// shape, length) pair -- a pure function of t, no side effects (types.go's
// arrKey).
func cpArrKey(t: int): string {
    return cpElemKey(irtElem(t)) + "_" + numToStr(irtN(t))
}

// cpElemKey renders t as an identifier fragment, for composing cpArrKey --
// types.go's elemKey, reduced to the element kinds an Arr can hold in this
// task's subset (int/bool/fixed/char/str/text/nested-arr); Rec/Enum/List/
// Map/Err elements are Task 6+.
func cpElemKey(t: int): string {
    switch irtKind(t) {
    case KInt { return "int" }
    case KBool { return "bool" }
    case KFixed { return "fixed" }
    case KChar { return "char" }
    case KStr { return "str" + numToStr(irtN(t)) }
    case KText { return "text" }
    case KArr { return "arr_" + cpArrKey(t) }
    }
    return "unsupported"
}

// cpEnsureStr emits the clar_str_N capacity typedef into cpTypeBuf once.
func cpEnsureStr(n: int) {
    var key: string

    key = numToStr(n)
    if cpStrCapsEmitted.has(key) {
        return
    }
    cpStrCapsEmitted[key] = 1
    cpTypeBuf.add("typedef struct { uint8_t len; uint8_t b[" + key + "]; } clar_str_" + key + ";")
}

// cpEnsureType lazily emits whatever typedef(s) t depends on (types.go's
// ensureType). Rec/Enum are emitted in declaration order elsewhere (Task 4+).
func cpEnsureType(t: int) {
    var k: IRKind

    k = irtKind(t)
    if k == KStr {
        cpEnsureStr(irtN(t))
    } else if k == KList {
        cpEnsureType(irtElem(t))
    } else if k == KMap {
        cpEnsureType(irtElem(t))
    } else if k == KArr {
        cpEnsureArr(t)
    }
}

// cpEnsureArr lazily emits t's clar_arr_<elem>_<N> wrapper typedef, first
// ensuring its element type's own typedef (if any) -- types.go's ensureArr.
// Written into cpRecBuf (like Go's recBuf): an array of records (Task 6+)
// needs that record's struct already defined, which only exists in
// cpRecBuf; a scalar/Str element has no such requirement but cpRecBuf works
// fine for it too.
func cpEnsureArr(t: int): string {
    var name: string

    name = cpCTypeName(t)
    if cpArrEmitted.has(name) {
        return name
    }
    cpArrEmitted[name] = 1
    cpEnsureType(irtElem(t))
    cpRecBuf.add("typedef struct { " + cpCTypeName(irtElem(t)) + " e[" + numToStr(irtN(t)) + "]; } " + name + ";")
    return name
}

// cpCType returns t's C type name, first emitting any typedef it depends on.
func cpCType(t: int): string {
    cpEnsureType(t)
    return cpCTypeName(t)
}

// cpTypeEqual is a pure structural comparison of two IR types (kind,
// capacity/length, record/enum name, and -- recursively -- element type),
// with no side effects -- types.go's typeEqual. Needed because ir.cla's
// arena interns every IRType afresh (two structurally-identical types built
// at different call sites get different indices), unlike Go's ir.Type,
// which is a plain comparable-by-field struct.
func cpTypeEqual(a: int, b: int): bool {
    if irtKind(a) != irtKind(b) or irtN(a) != irtN(b) or irtName(a) != irtName(b) {
        return false
    }
    if (irtElem(a) == -1) != (irtElem(b) == -1) {
        return false
    }
    if irtElem(a) != -1 {
        return cpTypeEqual(irtElem(a), irtElem(b))
    }
    return true
}

// ================================================================
// Expression + statement printing (funcprint.go / intr.go subset)
// ================================================================

func fpExpr(e: int): string {
    switch irExprKind(e) {
    case EIntConst {
        return numToStr(irIntConstV(e))
    }
    case EStrConst {
        return "clar_lit_" + numToStr(irStrConstIdx(e))
    }
    case EVarRef {
        return "cv_" + poolGet(irVarRefName(e))
    }
    case EBin {
        return fpBin(e)
    }
    case EUn {
        return fpUn(e)
    }
    case EConv {
        return fpConv(e)
    }
    case EIntr {
        return fpIntrCall(e)
    }
    case EIndexRef {
        return fpIndexRef(e)
    }
    }
    // Task 6+: EFieldRef/ECallFn/ENewRec.
    return ""
}

// fpIndexRef implements the ir.IndexRef printer contract for Arr (a
// bounds-checked plain C array access) and List (a bounds-checked
// rt_list_at call, sharing this same node -- see ir.IndexRef's doc comment
// in ir.go) -- a port of funcprint.go's indexRef.
func fpIndexRef(e: int): string {
    var xt: int

    xt = irExprType(irIndexRefX(e))
    if irtKind(xt) == KArr {
        return "(" + fpExpr(irIndexRefX(e)) + ").e[rt_arr_check((int32_t)(" + fpExpr(irIndexRefI(e)) + "), " + numToStr(irtN(xt)) + ")]"
    } else if irtKind(xt) == KList {
        return "(*(" + cpCType(irExprType(e)) + "*)rt_list_at(" + fpExpr(irIndexRefX(e)) + ", (int32_t)(" + fpExpr(irIndexRefI(e)) + ")))"
    }
    return ""
}

// cOp maps a Bin/Un op string to its C spelling (funcprint.go's cOp):
// and/or short-circuit as &&/||, mod as %, everything else (+ - * / & | ^
// << >> == != < <= > >=) passes straight through.
func cOp(op: string): string {
    if op == "and" {
        return "&&"
    } else if op == "or" {
        return "||"
    } else if op == "mod" {
        return "%"
    }
    return op
}

// fpBin prints an EBin node: and/or route to fpAndOr (short-circuit); every
// other operator (arithmetic, bitwise, comparison) prints as a plain
// `(x op y)` via cOp -- funcprint.go's expr's *ir.Bin case.
func fpBin(e: int): string {
    var op: string

    op = poolGet(irBinOp(e))
    if op == "and" or op == "or" {
        return fpAndOr(e)
    }
    return "(" + fpExpr(irBinX(e)) + " " + cOp(op) + " " + fpExpr(irBinY(e)) + ")"
}

// FpCapture is fpCaptureExpr's return value: the statements it would have
// emitted (joined in order, each already indented one level deeper -- the
// level fpAndOr's guarded `if` body will land at) and e's own value
// expression -- funcprint.go's captureExpr returns (stmts, value string);
// Clarus has no tuple return, so this record serves the same purpose.
record FpCapture {
    stmts: list of string
    value: string
}

// fpCaptureExpr prints e one indent level deeper than fp's current level
// (matching where it would land if fpAndOr decides to nest it inside a new
// `if`), returning any statements it emitted separately from its value
// expression -- a port of funcprint.go's captureExpr. fpBody is swapped out
// for a fresh (empty) list for the duration of the call so e's statements
// land in the returned capture, not the caller's in-progress body; `list of
// T`'s reference semantics (Ch3: Value and Reference Semantics) make this a
// cheap pointer swap, not a copy.
func fpCaptureExpr(e: int): FpCapture {
    var saved: list of string
    var fresh: list of string
    var cap: FpCapture

    saved = fpBody
    fpBody = fresh
    fpIndent = fpIndent + 1
    cap.value = fpExpr(e)
    fpIndent = fpIndent - 1
    cap.stmts = fpBody
    fpBody = saved
    return cap
}

// fpAndOr prints `and`/`or`, preserving short-circuit evaluation even when
// the right operand needs statement-level temps of its own -- a port of
// funcprint.go's andOr. The left operand always evaluates, printed in place
// like any other operand; the right operand is speculatively captured first
// (fpCaptureExpr): if it produced no statements, the simple case (both
// sides pure) stays a plain C &&/|| -- no churn. If it did produce
// statements, they're moved inside an `if`, guarded by the already-
// evaluated left operand, so they run only when short-circuiting wouldn't
// skip them.
func fpAndOr(e: int): string {
    var x: string
    var op: string
    var cap: FpCapture
    var t: string
    var cond: string
    var i: int

    x = fpExpr(irBinX(e))
    op = poolGet(irBinOp(e))
    cap = fpCaptureExpr(irBinY(e))
    if cap.stmts.count == 0 {
        return "(" + x + " " + cOp(op) + " " + cap.value + ")"
    }

    t = fpNewTmp(cpCType(irExprType(e)))
    fpEmit(t + " = " + x + ";")
    cond = t
    if op == "or" {
        cond = "!" + t
    }
    fpEmit("if (" + cond + ") {")
    fpIndent = fpIndent + 1
    i = 0
    while i < cap.stmts.count {
        fpBody.add(cap.stmts[i])
        i = i + 1
    }
    fpEmit(t + " = " + cap.value + ";")
    fpIndent = fpIndent - 1
    fpEmit("}")
    return t
}

// fpUn prints an EUn node (funcprint.go's un).
func fpUn(e: int): string {
    var x: string
    var op: string

    x = fpExpr(irUnX(e))
    op = poolGet(irUnOp(e))
    if op == "-" {
        return "(-(" + x + "))"
    } else if op == "not" {
        return "(!(" + x + "))"
    } else if op == "~" {
        return "(~(" + x + "))"
    }
    return ""
}

// fpConv prints an EConv node (funcprint.go's conv). IntToFixed/FixedToInt
// avoid a raw `<<`/plain arithmetic-shift on a possibly-negative value by
// multiplying/dividing by 65536 instead; C99 integer division truncates
// toward zero, exactly Ch3's "int(f) ... truncates toward zero".
func fpConv(e: int): string {
    var x: string
    var op: IRConvOp

    x = fpExpr(irConvX(e))
    op = irConvOp(e)
    if op == CvIntToFixed {
        return "((int32_t)((int64_t)(" + x + ") * 65536))"
    } else if op == CvFixedToInt {
        return "((int32_t)((" + x + ") / 65536))"
    } else if op == CvIntToChar {
        return "((uint8_t)(" + x + "))"
    } else if op == CvCharToInt or op == CvEnumToInt {
        return "((int32_t)(" + x + "))"
    }
    // CvIntToEnum: Task 8.
    return ""
}

// fpAddrable returns a C expression for e that is safe to take the address
// of (funcprint.go's addrable). VarRef/FieldRef/IndexRef print to C
// lvalues, StrConst to a named static, Intr's value-producing cases already
// materialize into a named temp -- none of these need a further copy;
// anything else (a Bin/Un/Conv/CallFn/NewRec result) is first copied into a
// fresh temp of its own type via fpCopyToTemp.
func fpAddrable(e: int): string {
    var k: IRExprKind

    k = irExprKind(e)
    if k == EVarRef or k == EFieldRef or k == EIndexRef or k == EStrConst or k == EIntr {
        return fpExpr(e)
    }
    return fpCopyToTemp(e)
}

// fpCopyToTemp unconditionally materializes e's value into a fresh
// statement-level temp and returns the temp's name -- never the "already an
// lvalue, print as-is" shortcut fpAddrable takes for a VarRef/FieldRef/
// IndexRef/StrConst/Intr. Used for the *value* argument of every
// list/map-growing intrinsic (Task 6+'s list_push, list_unshift, map_set):
// those can realloc their target's backing store mid-call, so if the value
// argument were instead a raw rt_list_at/rt_map-derived pointer, the
// realloc could free that pointer's block before the call's own memmove
// reads it -- an ASan-confirmed use-after-free (funcprint.go's copyToTemp).
func fpCopyToTemp(e: int): string {
    var v: string
    var t: string

    v = fpExpr(e)
    t = fpNewTmp(cpCType(irExprType(e)))
    fpEmit(t + " = " + v + ";")
    return t
}

// fpStrAddr renders `(const uint8_t*)&(<addrable e>)` (funcprint.go's strAddr).
func fpStrAddr(e: int): string {
    return "(const uint8_t*)&(" + fpAddrable(e) + ")"
}

// fpTextCmp handles text/text, text/string, and string/text comparisons
// (intr.go's textCmp). rt_text_cmp_str only knows (text, string); a string
// on the left needs the call flipped and its sign negated to preserve
// `a < b` orientation.
func fpTextCmp(a: int, b: int): string {
    var atk: IRKind
    var btk: IRKind

    atk = irtKind(irExprType(a))
    btk = irtKind(irExprType(b))
    if atk == KText and btk == KText {
        return "rt_text_cmp(" + fpExpr(a) + ", " + fpExpr(b) + ")"
    } else if atk == KText and btk == KStr {
        return "rt_text_cmp_str(" + fpExpr(a) + ", " + fpStrAddr(b) + ")"
    }
    // atk == KStr and btk == KText: lowComparison only ever calls ITextCmp
    // when at least one side is Text, so this is the only remaining combo.
    return "(-rt_text_cmp_str(" + fpExpr(b) + ", " + fpStrAddr(a) + "))"
}

// fpTextConcat allocates a fresh rt_text handle for the `text + (text|
// string)` result (text has reference semantics, but `+` always produces a
// new value), then concatenates a and b into it (intr.go's textConcat).
func fpTextConcat(a: int, b: int): string {
    var ae: string
    var t: string

    ae = fpExpr(a)
    t = fpNewTmp("rt_text *")
    fpEmit(t + " = rt_text_new();")
    if irtKind(irExprType(b)) == KStr {
        fpEmit("rt_text_concat(" + t + ", " + ae + ", " + fpStrAddr(b) + ", NULL);")
    } else {
        fpEmit("rt_text_concat(" + t + ", " + ae + ", NULL, " + fpExpr(b) + ");")
    }
    return t
}

// fpIntrCall prints one Intr call (intr.go). Every rt_* function whose
// result comes back through an out-parameter (concat, text concat, ...) is
// materialized into a fresh statement-level temp here and its name
// returned; pure value-returning rt_* calls (len, cmp, index_of, ...) are
// embedded directly with no temp, since C already lets them nest safely.
// Void operations (alert, quit, set_index, append, ...) emit their call as
// a statement and return "" -- see fpStmt's SExprStmt case, the only
// context they appear in.
func fpIntrCall(x: int): string {
    var nm: int
    var a0: int
    var a1: int
    var a2: int
    var t: string
    var s0: string
    var s1: string
    var cap0: int
    var cap1: int
    var l: string
    var v: string
    var fn: string
    var m: string
    var k: string
    var dv: string

    nm = irIntrName(x)
    a0 = irIntrArgsHead(x)
    if a0 != -1 {
        a1 = irExprNext(a0)
    }
    if a1 != -1 {
        a2 = irExprNext(a1)
    }

    if nm == IAlert() {
        fpEmit("rt_alert(" + fpStrAddr(a0) + ");")
        return ""
    } else if nm == ILog() {
        fpEmit("rt_log(" + fpStrAddr(a0) + ");")
        return ""
    } else if nm == IQuit() {
        fpEmit("rt_quit((int32_t)(" + fpExpr(a0) + "));")
        return ""
    } else if nm == IFixMul() {
        return "rt_fix_mul((int32_t)(" + fpExpr(a0) + "), (int32_t)(" + fpExpr(a1) + "))"
    } else if nm == IFixDiv() {
        return "rt_fix_div((int32_t)(" + fpExpr(a0) + "), (int32_t)(" + fpExpr(a1) + "))"

    // ---- strings ----
    } else if nm == IStrConcat() {
        s0 = fpStrAddr(a0)
        s1 = fpStrAddr(a1)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_str_concat((uint8_t*)&" + t + ", " + s0 + ", " + s1 + ");")
        return t
    } else if nm == IStrConcatChar() {
        s0 = fpStrAddr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_str_concat_char((uint8_t*)&" + t + ", " + s0 + ", (uint8_t)(" + s1 + "));")
        return t
    } else if nm == IStrPrependChar() {
        s0 = fpExpr(a0)
        s1 = fpStrAddr(a1)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_str_prepend_char((uint8_t*)&" + t + ", (uint8_t)(" + s0 + "), " + s1 + ");")
        return t
    } else if nm == IStrCmp() {
        return "rt_str_cmp(" + fpStrAddr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == IStrLen() {
        return "rt_str_len(" + fpStrAddr(a0) + ")"
    } else if nm == IStrIndex() {
        return "rt_str_index(" + fpStrAddr(a0) + ", (int32_t)(" + fpExpr(a1) + "))"
    } else if nm == IStrSetIndex() {
        s0 = fpAddrable(a0)
        s1 = fpExpr(a1)
        fpEmit("rt_str_set_index((uint8_t*)&(" + s0 + "), (int32_t)(" + s1 + "), (uint8_t)(" + fpExpr(a2) + "));")
        return ""
    } else if nm == IStrFromBytes() {
        s0 = fpAddrable(a0)
        cap0 = irtN(irExprType(a0))
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        fpEmit("rt_str_from_bytes((uint8_t*)&(" + s0 + "), " + numToStr(cap0) + ", (const uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ", (int32_t)(" + fpExpr(a2) + "));")
        return ""
    } else if nm == IStrToBytes() {
        s0 = fpStrAddr(a0)
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        return "rt_str_to_bytes(" + s0 + ", (uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ")"
    } else if nm == IStrCoerce() {
        // Materializes a0 (any Str capacity) into a fresh temp at x.Ty's
        // (different) capacity via the same clamped rt_str_store fpStoreStr
        // uses for a plain lvalue -- see lowCoerceStr's doc comment
        // (lower.cla) for why this can't just be a plain `=`.
        s0 = fpStrAddr(a0)
        t = fpNewTmp(cpCType(irExprType(x)))
        fpEmit("rt_str_store((uint8_t*)&" + t + ", " + numToStr(irtN(irExprType(x))) + ", " + s0 + ");")
        return t
    } else if nm == IStrSlice() {
        s0 = fpStrAddr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_str_slice((uint8_t*)&" + t + ", " + s0 + ", (int32_t)(" + s1 + "), (int32_t)(" + fpExpr(a2) + "));")
        return t
    } else if nm == IStrIndexOfStr() {
        return "rt_str_index_of_str(" + fpStrAddr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == IStrIndexOfChar() {
        return "rt_str_index_of_char(" + fpStrAddr(a0) + ", (uint8_t)(" + fpExpr(a1) + "))"

    // ---- text ----
    } else if nm == ITextCmp() {
        return fpTextCmp(a0, a1)
    } else if nm == ITextConcat() {
        return fpTextConcat(a0, a1)
    } else if nm == ITextConcatSL() {
        s0 = fpStrAddr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("rt_text *")
        fpEmit(t + " = rt_text_new();")
        fpEmit("rt_text_concat_sl(" + t + ", " + s0 + ", " + s1 + ");")
        return t
    } else if nm == ITextStore() {
        fpEmit("rt_text_store(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ");")
        return ""
    } else if nm == ITextLen() {
        return "rt_text_len(" + fpExpr(a0) + ")"
    } else if nm == ITextIndex() {
        return "rt_text_index(" + fpExpr(a0) + ", (int32_t)(" + fpExpr(a1) + "))"
    } else if nm == ITextSetIndex() {
        s0 = fpExpr(a0)
        s1 = fpExpr(a1)
        fpEmit("rt_text_set_index(" + s0 + ", (int32_t)(" + s1 + "), (uint8_t)(" + fpExpr(a2) + "));")
        return ""
    } else if nm == ITextFromBytes() {
        s0 = fpExpr(a0)
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        fpEmit("rt_text_from_bytes(" + s0 + ", (const uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ", (int32_t)(" + fpExpr(a2) + "));")
        return ""
    } else if nm == ITextToBytes() {
        s0 = fpExpr(a0)
        s1 = fpAddrable(a1)
        cap1 = irtN(irExprType(a1))
        return "rt_text_to_bytes(" + s0 + ", (uint8_t*)(" + s1 + ").e, " + numToStr(cap1) + ")"
    } else if nm == ITextSlice() {
        s0 = fpExpr(a0)
        s1 = fpExpr(a1)
        t = fpNewTmp("clar_str_255")
        fpEmit("rt_text_slice((uint8_t*)&" + t + ", " + s0 + ", (int32_t)(" + s1 + "), (int32_t)(" + fpExpr(a2) + "));")
        return t
    } else if nm == ITextIndexOfStr() {
        return "rt_text_index_of_str(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == ITextIndexOfChar() {
        return "rt_text_index_of_char(" + fpExpr(a0) + ", (uint8_t)(" + fpExpr(a1) + "))"
    } else if nm == ITextAppendStr() {
        fpEmit("rt_text_append_str(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ");")
        return ""
    } else if nm == ITextAppendChar() {
        fpEmit("rt_text_append_char(" + fpExpr(a0) + ", (uint8_t)(" + fpExpr(a1) + "));")
        return ""
    } else if nm == ITextAppendText() {
        fpEmit("rt_text_append_text(" + fpExpr(a0) + ", " + fpExpr(a1) + ");")
        return ""

    // ---- list ----
    } else if nm == IListPush() or nm == IListUnshift() {
        // v goes through fpCopyToTemp, not fpAddrable: push/unshift can
        // realloc a0's backing store, and if v were instead a raw
        // rt_list_at pointer (fpAddrable's IndexRef shortcut, e.g.
        // `l.push(l[0])`), that realloc could free it before this call's
        // own memmove reads it.
        l = fpExpr(a0)
        v = fpCopyToTemp(a1)
        fn = "rt_list_push"
        if nm == IListUnshift() {
            fn = "rt_list_unshift"
        }
        fpEmit(fn + "(" + l + ", &(" + v + "));")
        return ""
    } else if nm == IListPop() or nm == IListShift() or nm == IListFirst() or nm == IListLast() {
        l = fpExpr(a0)
        t = fpNewTmp(cpCType(irExprType(x)))
        fn = "rt_list_pop"
        if nm == IListShift() {
            fn = "rt_list_shift"
        } else if nm == IListFirst() {
            fn = "rt_list_first"
        } else if nm == IListLast() {
            fn = "rt_list_last"
        }
        fpEmit(fn + "(" + l + ", &" + t + ");")
        return t
    } else if nm == IListRemove() {
        fpEmit("rt_list_remove(" + fpExpr(a0) + ", (int32_t)(" + fpExpr(a1) + "));")
        return ""
    } else if nm == IListCount() {
        return "rt_list_count(" + fpExpr(a0) + ")"

    // ---- map ----
    } else if nm == IMapSet() {
        // v goes through fpCopyToTemp, not fpAddrable, for the same reason
        // as list_push/unshift above: map_set grows m's key/value arrays on
        // a new key, so a raw rt_list_at-derived pointer passed as v (e.g.
        // `m.set(k, l[0])`) must be copied out before the call, not handed
        // in live. (m's own values never alias this way: map subscript
        // lowers to the map_get intrinsic, which always materializes into
        // its own temp before it can be used as another call's argument --
        // see IMapGet below.)
        m = fpExpr(a0)
        k = fpStrAddr(a1)
        v = fpCopyToTemp(a2)
        fpEmit("rt_map_set(" + m + ", " + k + ", &(" + v + "));")
        return ""
    } else if nm == IMapGet() {
        m = fpExpr(a0)
        k = fpStrAddr(a1)
        t = fpNewTmp(cpCType(irExprType(x)))
        fpEmit("rt_map_get(" + m + ", " + k + ", &" + t + ");")
        return t
    } else if nm == IMapGetDv() {
        m = fpExpr(a0)
        k = fpStrAddr(a1)
        dv = fpExpr(a2)
        t = fpNewTmp(cpCType(irExprType(x)))
        fpEmit(t + " = " + dv + ";") // pre-fill with the default; get_dv leaves it untouched if absent
        fpEmit("rt_map_get_dv(" + m + ", " + k + ", &" + t + ");")
        return t
    } else if nm == IMapHas() {
        return "rt_map_has(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ")"
    } else if nm == IMapRemove() {
        fpEmit("rt_map_remove(" + fpExpr(a0) + ", " + fpStrAddr(a1) + ");")
        return ""
    } else if nm == IMapCount() {
        return "rt_map_count(" + fpExpr(a0) + ")"
    }
    // Later tasks: lasterr/file intrinsics.
    return ""
}

// fpStoreStr prints a clamped string store: `rt_str_store(&dst, CAP, &src);`
// -- funcprint.go's storeStr.
func fpStoreStr(dst: int, src: int) {
    fpEmit("rt_str_store((uint8_t*)&(" + fpAddrable(dst) + "), " + numToStr(irtN(irExprType(dst))) + ", " + fpStrAddr(src) + ");")
}

func fpStmt(s: int) {
    var e: string
    var d: string
    var v: string

    if irStmtKind(s) == SExprStmt {
        e = fpExpr(irExprStmtX(s))
        if e != "" {
            fpEmit(e + ";")
        }
    } else if irStmtKind(s) == SIf {
        fpIfStmt(s)
    } else if irStmtKind(s) == SAssign {
        d = fpExpr(irAssignDst(s))
        v = fpExpr(irAssignSrc(s))
        fpEmit(d + " = " + v + ";")
    } else if irStmtKind(s) == SStoreStr {
        fpStoreStr(irStoreStrDst(s), irStoreStrSrc(s))
    } else if irStmtKind(s) == SWhile {
        fpWhileStmt(s)
    } else if irStmtKind(s) == SForRange {
        fpForRangeStmt(s)
    } else if irStmtKind(s) == SReturn {
        if irReturnX(s) == -1 {
            fpEmit("return;")
        } else {
            fpEmit("return " + fpExpr(irReturnX(s)) + ";")
        }
    } else if irStmtKind(s) == SForList {
        fpForListStmt(s)
    } else if irStmtKind(s) == SForMap {
        fpForMapStmt(s)
    } else if irStmtKind(s) == SBreak {
        fpEmit("break;")
    } else if irStmtKind(s) == SContinue {
        fpEmit("continue;")
    }
}

// fpForListStmt lowers `for x in l { ... }` to an index loop over a count
// snapshotted once at loop entry (Ch5 doesn't promise behavior for a list
// mutated mid-iteration; a fixed count is the simplest defensible choice)
// -- a port of funcprint.go's forListStmt.
func fpForListStmt(s: int) {
    var lv: string
    var lt: string
    var cnt: string
    var ix: string
    var elemC: string
    var vName: string

    lv = fpExpr(irForListListV(s))
    lt = fpNewTmp("rt_list *")
    fpEmit(lt + " = " + lv + ";")
    cnt = fpNewTmp("int32_t")
    fpEmit(cnt + " = rt_list_count(" + lt + ");")
    ix = fpNewTmp("int32_t")
    elemC = cpCType(irtElem(irExprType(irForListListV(s))))
    vName = poolGet(irForListV(s))
    fpEmit("for (" + ix + " = 0; " + ix + " < " + cnt + "; " + ix + "++) {")
    fpIndent = fpIndent + 1
    fpEmit("cv_" + vName + " = *(" + elemC + "*)rt_list_at(" + lt + ", " + ix + ");")
    fpStmts(irForListBody(s))
    fpIndent = fpIndent - 1
    fpEmit("}")
}

// fpForMapStmt lowers `for k, v in m { ... }` to an index loop over
// rt_map_count/rt_map_key_at/rt_map_val_at -- ascending key order, per
// rt.c's CONTRACT comment on rt_map -- a port of funcprint.go's
// forMapStmt. The value fetch only emits when the loop declared a V:
// irForMapV(s) is -1 (parseForStmt's own "no second IDENT" signal,
// threaded straight through lowFor) when the loop wrote `for k in m`
// without a value variable.
func fpForMapStmt(s: int) {
    var mv: string
    var mt: string
    var cnt: string
    var ix: string
    var vNameIdx: int

    mv = fpExpr(irForMapMapV(s))
    mt = fpNewTmp("rt_map *")
    fpEmit(mt + " = " + mv + ";")
    cnt = fpNewTmp("int32_t")
    fpEmit(cnt + " = rt_map_count(" + mt + ");")
    ix = fpNewTmp("int32_t")
    fpEmit("for (" + ix + " = 0; " + ix + " < " + cnt + "; " + ix + "++) {")
    fpIndent = fpIndent + 1
    fpEmit("rt_map_key_at(" + mt + ", " + ix + ", (uint8_t*)&cv_" + poolGet(irForMapK(s)) + ");")
    vNameIdx = irForMapV(s)
    if vNameIdx != -1 {
        fpEmit("rt_map_val_at(" + mt + ", " + ix + ", &cv_" + poolGet(vNameIdx) + ");")
    }
    fpStmts(irForMapBody(s))
    fpIndent = fpIndent - 1
    fpEmit("}")
}

// fpWhileStmt prints `while (1) { <cond's temps, re-run every iteration>;
// if (!(cond)) break; <body> }` rather than a plain C `while (cond)`: cond
// may itself need statement-level temporaries (e.g. a string concat), which
// must be recomputed every iteration, not hoisted out and reused stale --
// funcprint.go's whileStmt.
func fpWhileStmt(s: int) {
    var cond: string

    fpEmit("while (1) {")
    fpIndent = fpIndent + 1
    cond = fpExpr(irWhileCond(s))
    fpEmit("if (!(" + cond + ")) break;")
    fpStmts(irWhileBody(s))
    fpIndent = fpIndent - 1
    fpEmit("}")
}

// fpForRangeStmt evaluates From/To once into temps (never re-embeds their
// expression text into the loop header, which would re-evaluate -- and for
// a From/To that's a function call, re-run -- them every iteration) and
// loops the bound variable, already declared at function top, over
// [from, to] inclusive -- funcprint.go's forRangeStmt.
func fpForRangeStmt(s: int) {
    var from: string
    var ft: string
    var toVal: string
    var tt: string
    var vName: string

    from = fpExpr(irForRangeFrom(s))
    ft = fpNewTmp("int32_t")
    fpEmit(ft + " = " + from + ";")
    toVal = fpExpr(irForRangeTo(s))
    tt = fpNewTmp("int32_t")
    fpEmit(tt + " = " + toVal + ";")
    vName = poolGet(irForRangeV(s))
    fpEmit("for (cv_" + vName + " = " + ft + "; cv_" + vName + " <= " + tt + "; cv_" + vName + "++) {")
    fpIndent = fpIndent + 1
    fpStmts(irForRangeBody(s))
    fpIndent = fpIndent - 1
    fpEmit("}")
}

// fpStripOuterParens removes one matching outer parenthesis pair from s, if
// present -- a port of funcprint.go's stripOuterParens. fpExpr always wraps
// a Bin/Un result in its own parens (needed when nested inside another
// expression); printed directly as an `if (...)` condition, a top-level
// comparison would come out double-parenthesized (`if ((a == b))`). Used
// only where the condition becomes the entire, sole content of a C
// `if (...)`.
func fpStripOuterParens(s: string): string {
    var depth: int
    var i: int
    var c: char

    if s.length < 2 or s[0] != '(' or s[s.length - 1] != ')' {
        return s
    }
    depth = 0
    i = 0
    while i < s.length {
        c = s[i]
        if c == '(' {
            depth = depth + 1
        } else if c == ')' {
            depth = depth - 1
            if depth == 0 and i != s.length - 1 {
                return s
            }
        }
        i = i + 1
    }
    return s[1, s.length - 2]
}

// fpIfStmt prints an SIf node (funcprint.go's ifStmt).
func fpIfStmt(s: int) {
    fpEmit("if (" + fpStripOuterParens(fpExpr(irIfCond(s))) + ") {")
    fpIndent = fpIndent + 1
    fpStmts(irIfThen(s))
    fpIndent = fpIndent - 1
    if irIfElse(s) != -1 {
        fpEmit("} else {")
        fpIndent = fpIndent + 1
        fpStmts(irIfElse(s))
        fpIndent = fpIndent - 1
    }
    fpEmit("}")
}

func fpStmts(head: int) {
    var s: int

    s = head
    while s != -1 {
        fpStmt(s)
        s = irStmtNext(s)
    }
}

// ================================================================
// Function + main printing (cprint.go subset)
// ================================================================

// cpFuncProto renders a function/handler's C prototype (cprint.go's
// funcProto), without the trailing ";" or " {".
func cpFuncProto(f: int): string {
    var params: string
    var p: int
    var first: bool

    params = ""
    first = true
    p = irFuncParamsHead(f)
    while p != -1 {
        if not first {
            params = params + ", "
        }
        first = false
        params = params + cpCType(irLocalType(p)) + " cv_" + poolGet(irLocalName(p))
        p = irLocalNext(p)
    }
    if first {
        params = "void"
    }
    return "static " + cpCType(irFuncRet(f)) + " clar_fn_" + poolGet(irFuncName(f)) + "(" + params + ")"
}

// cpDefaultInit emits the default-value statement(s) for a nil-Init local:
// `dst = 0;` for a scalar (Int/Bool/Fixed/Char/Enum), `dst = (clar_str_N)
// {0};` for a Str (empty string, no field-default override exists yet --
// Task 6+'s record fields add that), and `dst = rt_text_new();` for a Text
// -- the fresh-handle contract every Text local needs before any append/
// store/index touches it, since there is no null "no text yet" state. A
// port of defaults.go's defaultInit, reduced to the scalarDefault==0/
// strDefault==-1 (no override) cases; List/Map/Rec/Err/Arr defaults are
// Task 6+.
func cpDefaultInit(dst: string, t: int) {
    var k: IRKind

    k = irtKind(t)
    if k == KInt or k == KBool or k == KFixed or k == KChar or k == KEnum {
        fpEmit(dst + " = 0;")
    } else if k == KStr {
        fpEmit(dst + " = (" + cpCType(t) + "){0};")
    } else if k == KText {
        fpEmit(dst + " = rt_text_new();")
    } else if k == KList {
        fpEmit(dst + " = rt_list_new(sizeof(" + cpCType(irtElem(t)) + "));")
    } else if k == KMap {
        fpEmit(dst + " = rt_map_new(sizeof(" + cpCType(irtElem(t)) + "));")
    }
}

// cpEmitFunc appends one function's full definition to cpRestBuf
// (cprint.go's emitFunc). Skeleton: scalar-only locals default-init, no
// trailing return (handlers are void).
func cpEmitFunc(f: int) {
    var loc: int
    var i: int
    var declared: map of int
    var nm: string

    cpEnsureType(irFuncRet(f))
    fpReset(1)

    // Every local (var-declared, or a for-range loop's bound variable) is
    // hoisted to the top of the C function (Ch5: "var only at the top of a
    // function/handler body"). Two sibling (non-nested, non-overlapping)
    // for-range loops reusing the same bound-variable name is legal Clarus
    // and common style (lowFor appends a fresh IRLocal per loop, same name,
    // same Int type every time): declaring the shared C variable once and
    // reusing it across both loops is semantically identical to two
    // independent loops in C, so a duplicate (name, same-type) entry just
    // skips re-declaration -- cprint.go's emitFunc. A genuine same-name/
    // different-type collision is a real ambiguity in a flat-by-name IR and
    // is reported loudly rather than silently miscompiled.
    loc = irFuncLocalsHead(f)
    while loc != -1 {
        nm = poolGet(irLocalName(loc))
        if declared.has(nm) {
            if not cpTypeEqual(declared.get(nm, -1), irLocalType(loc)) {
                log("cprint: local " + nm + " redeclared with a different type in func " + poolGet(irFuncName(f)) + " (unsupported: same name, different type, in sibling scopes)")
                quit 1
            }
        } else {
            declared[nm] = irLocalType(loc)
            fpEmit(cpCType(irLocalType(loc)) + " cv_" + nm + ";")
            cpDefaultInit("cv_" + nm, irLocalType(loc))
        }
        loc = irLocalNext(loc)
    }
    fpStmts(irFuncBodyHead(f))
    // Task 4+: `return <zeroLiteral>;` for a non-void return type.

    cpRestBuf.add(cpFuncProto(f) + " {")
    i = 0
    while i < fpBody.count {
        cpRestBuf.add(fpBody[i])
        i = i + 1
    }
    cpRestBuf.add("}")
    cpRestBuf.add("")
}

// cpEmitFuncs prints every prototype up front, then every definition
// (cprint.go's emitFuncs).
func cpEmitFuncs() {
    var i: int

    i = 0
    while i < irFuncs.count {
        cpRestBuf.add(cpFuncProto(i) + ";")
        i = i + 1
    }
    cpRestBuf.add("")
    i = 0
    while i < irFuncs.count {
        cpEmitFunc(i)
        i = i + 1
    }
}

// cpEmitGlobalsInit declares every global then defines clar_init_globals
// (cprint.go's emitGlobalsAndInit). Skeleton: no globals -> just the empty
// init function (main always calls it).
func cpEmitGlobalsInit() {
    var i: int

    i = 0
    while i < irGlobals.count {
        cpRestBuf.add("static " + cpCType(irGlobalType(i)) + " cv_" + poolGet(irGlobalName(i)) + ";")
        i = i + 1
    }
    cpRestBuf.add("static void clar_init_globals(void) {")
    // Task 4+: per-global default-init + Init expression.
    cpRestBuf.add("}")
    cpRestBuf.add("")
}

// cpEmitStrLits prints the interned string-literal pool as clar_str_255
// constants (cprint.go's emitStrLits). StrConst.Idx indexes this pool.
func cpEmitStrLits() {
    var i: int
    var s: string
    var bytesStr: text
    var j: int

    i = 0
    while i < irStrLits.count {
        s = poolGet(irStrLitPoolIdx(i))
        bytesStr = ""
        j = 0
        while j < s.length {
            if j > 0 {
                bytesStr = bytesStr + ", "
            }
            bytesStr = bytesStr + numToStr(int(s[j]))
            j = j + 1
        }
        cpLitBuf.add("static const clar_str_255 clar_lit_" + numToStr(i) + " = {" + numToStr(s.length) + ", {" + bytesStr + "}};")
        i = i + 1
    }
}

// cpEmitMain prints the fixed entry point (cprint.go's emitMain): init
// globals, stash argv, then launch, then startCLI (else startEmpty).
func cpEmitMain() {
    cpRestBuf.add("int main(int argc, char **argv) {")
    cpRestBuf.add("    clar_init_globals();")
    cpRestBuf.add("    rt_args_init(argc, argv);")
    if irHasLaunch {
        cpRestBuf.add("    clar_fn_handler_App_launch();")
    }
    if irHasStartCLI {
        cpRestBuf.add("    clar_fn_handler_App_startCLI(rt_args_list());")
    } else if irHasStartEmpty {
        cpRestBuf.add("    clar_fn_handler_App_startEmpty();")
    }
    cpRestBuf.add("    return 0;")
    cpRestBuf.add("}")
}

// ================================================================
// Assembly + output
// ================================================================

func cpResetBuffers() {
    while cpTypeBuf.count > 0 {
        cpTypeBuf.pop()
    }
    while cpLitBuf.count > 0 {
        cpLitBuf.pop()
    }
    while cpRecBuf.count > 0 {
        cpRecBuf.pop()
    }
    while cpRestBuf.count > 0 {
        cpRestBuf.pop()
    }
}

// cpAppendLine appends a `string`-sourced line to out, followed by a single
// LF (byte 10, via char(10) -- never CR/13, and never alert's own newline
// handling). append takes a char directly, unlike `+` concatenation.
func cpAppendLine(out: text, line: string) {
    out.append(line)
    out.append(char(10))
}

// cpAppendTextLine is cpAppendLine for a `text`-sourced line -- one that may
// exceed a `string`'s 255-byte capacity (cpLitBuf's lines). A separate
// function, not an overload: a `text` argument bound to a `string` parameter
// (or vice versa) is either a type error or a lowering gap (see the header
// comment), so each buffer's lines must reach `out.append` through the
// function whose parameter already matches their real type.
func cpAppendTextLine(out: text, line: text) {
    out.append(line)
    out.append(char(10))
}

// cpAppendList appends every line of a `list of string` buffer to out
// (cpAppendLine per line, in order) -- the text-buffer replacement for the
// old per-line alert output.
func cpAppendList(out: text, buf: list of string) {
    var i: int

    i = 0
    while i < buf.count {
        cpAppendLine(out, buf[i])
        i = i + 1
    }
}

// cpAppendTextList is cpAppendList for cpLitBuf (`list of text`).
func cpAppendTextList(out: text, buf: list of text) {
    var i: int

    i = 0
    while i < buf.count {
        cpAppendTextLine(out, buf[i])
        i = i + 1
    }
}

// emitProgram renders the whole IR (ir.cla arenas) into one `text` buffer, in
// Emit's fixed assembly order (cprint.go's Emit), and returns it. Same input
// always assembles the same buffers in the same order, so the returned bytes
// are deterministic.
func emitProgram(): text {
    var out: text

    out = ""
    cpResetBuffers()

    cpEnsureStr(255)   // literal pool + every intrinsic string temp use this
    cpRecBuf.add("typedef struct { int32_t code; clar_str_255 message; } clar_rec_Err;")
    cpRecBuf.add("")

    cpEmitStrLits()
    // Task 4+: cpEmitRecords / cpEmitEnums.
    cpEmitGlobalsInit()
    cpEmitFuncs()
    cpEmitMain()

    cpAppendLine(out, "/* Generated by clarus (internal/cprint). Do not edit. */")
    cpAppendLine(out, "#include \"rt.h\"")
    cpAppendLine(out, "#include <stddef.h> /* NULL, used by rt_text_concat's bstr/btext args */")
    cpAppendLine(out, "")
    cpAppendList(out, cpTypeBuf)
    cpAppendLine(out, "")
    cpAppendTextList(out, cpLitBuf)
    cpAppendLine(out, "")
    cpAppendList(out, cpRecBuf)
    cpAppendLine(out, "")
    cpAppendList(out, cpRestBuf)

    return out
}

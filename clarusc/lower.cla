// lower.cla: AST + checker-type-info -> arena IR (ir.cla). A port of the
// walking-skeleton subset of internal/lower (lower.go / stmt.go / expr.go).
//
// This is Task 3's walking skeleton: it lowers ONLY what the seed program
//   on App.startCLI(args: list of string) { alert("...") quit 0 }
// needs -- Program flags + one handler Func, ExprStmt, Intr(IAlert/ILog),
// Intr(IQuit), StrConst and IntConst -- plus the structural scaffolding
// (scope stack, curFuncRet, per-function locals chain, full lowType/
// lowResolveType) that Tasks 4-9 extend without reshaping. Every branch a
// later task fills in is marked "Task 4+".
//
// One program is lowered per process (a fresh `clarusc emit FILE` exec per
// program): the checker's exprTypeOf and the AST arenas are never cleared
// between check and lower, so exprTypeGet(e) resolves against the very AST
// this pass walks. irReset() (ir.cla) must run once before lowerProgram to
// seed the singleton IR scalar types (irIntT, irVoidT, ...).

include "lib.cla"
include "ast.cla"
include "types.cla"
include "check.cla"
include "ir.cla"

// ================================================================
// Lowerer state (lower.go's `lowerer` struct, reduced to the skeleton).
// ================================================================

// LowScope is one nested local-variable scope: names present as locals in
// this scope (value 1). Mirrors lower.go's localScopes entries -- consulted
// by lowIsLocal so lowIdent can tell a local VarRef from a global one.
record LowScope {
    names: map of int
}

var lowScopes: list of LowScope

// lowStrIdx dedups string literals into the irStrLits pool by literal value
// (lower.go's strIdx): identical literals share one clar_lit_K slot.
var lowStrIdx: map of int

// lowCurFuncRet is the enclosing function's declared return IR type index,
// for the Return-statement coercion Task 4 adds (lower.go's curFuncRet).
var lowCurFuncRet: int

// lowLocalsHead/lowLocalsTail thread the current function's flat locals
// chain (lower.go's f.Locals): every nested block's `var` flattens into it,
// which is what cprint declares at C function scope.
var lowLocalsHead: int
var lowLocalsTail: int

// lowSwitchN counts synthesized switch-subject temps (lowNewSwitchTemp,
// below) program-wide, NEVER per-function or per-scope -- so two switches
// landing in the same function (or in sibling functions) never collide on
// the same "__switchN" local name (lower.go's lowerer.switchN). Reset once
// per program in lowerProgram, alongside irReset().
var lowSwitchN: int

func lowPushScope() {
    var s: LowScope

    lowScopes.add(s)
}

func lowPopScope() {
    lowScopes.pop()
}

func lowDeclareLocal(nameIdx: int) {
    var top: int

    top = lowScopes.count - 1
    lowScopes[top].names[poolGet(nameIdx)] = 1
}

func lowIsLocal(nameIdx: int): bool {
    var i: int
    var key: string

    key = poolGet(nameIdx)
    i = lowScopes.count - 1
    while i >= 0 {
        if lowScopes[i].names.has(key) {
            return true
        }
        i = i - 1
    }
    return false
}

// lowAddLocal appends one local (name + IR type) to the current function's
// flat locals chain and returns its irLocals index.
func lowAddLocal(nameIdx: int, t: int): int {
    var loc: int

    loc = newIRLocal(nameIdx, t)
    if lowLocalsHead == -1 {
        lowLocalsHead = loc
    }
    lowLocalsTail = irLocalListAppend(lowLocalsTail, loc)
    return loc
}

// ================================================================
// Type lowering
// ================================================================

// lowType maps a checked type-arena index (types.cla) to its IR type index
// (ir.cla) -- a port of lower.go's lowerType.
func lowType(t: int): int {
    switch typeKind(t) {
    case TyInt { return irIntT }
    case TyBool { return irBoolT }
    case TyFixed { return irFixedT }
    case TyChar { return irCharT }
    case TyText { return irTextT }
    case TyVoid { return irVoidT }
    case TyErrorType { return irErrT }
    case TyStr { return irStrType(typeN(t)) }
    case TyEnum { return irEnumType(typeNameIdx(t)) }
    case TyRec { return irRecType(typeNameIdx(t)) }
    case TyArr { return irArrType(lowType(typeElem(t)), typeN(t)) }
    case TyList { return irListType(lowType(typeElem(t))) }
    case TyMap { return irMapType(lowType(typeElem(t))) }
    }
    // TyInvalid and the checker-only pseudo-kinds never reach a
    // checker-clean lowering (lower.go's lowerType panics here).
    return irVoidT
}

// lowResolveType maps an AST TypeExpr (ast.cla) directly to an IR type index
// -- a fused port of lower.go's resolveType + lowerType, used for the type
// annotations (params, `var`, fields) that never went through checkExpr and
// so have no exprTypeOf entry.
func lowResolveType(tx: int): int {
    var nm: string

    switch typeExprKind(tx) {
    case TxNamed {
        nm = poolGet(namedTypeName(tx))
        if nm == "int" {
            return irIntT
        } else if nm == "bool" {
            return irBoolT
        } else if nm == "fixed" {
            return irFixedT
        } else if nm == "char" {
            return irCharT
        } else if nm == "text" {
            return irTextT
        }
        // Task 4+: user record/enum names via a declTypes registry.
        return irIntT
    }
    case TxString {
        return irStrType(stringTypeN(tx))
    }
    case TxList {
        return irListType(lowResolveType(listTypeElem(tx)))
    }
    case TxMap {
        return irMapType(lowResolveType(mapTypeVal(tx)))
    }
    case TxArray {
        return irArrType(lowResolveType(arrayTypeElem(tx)), arrayTypeN(tx))
    }
    }
    return irIntT
}

// lowMustType returns e's IR type from the checker's recorded type
// (exprTypeGet, Task 1) -- lower.go's mustType.
func lowMustType(e: int): int {
    return lowType(exprTypeGet(e))
}

// lowInternStr interns a string literal into the irStrLits pool, deduping by
// value, and returns its pool index (a StrConst's Idx) -- lower.go's
// internStr.
func lowInternStr(s: string): int {
    var idx: int

    if lowStrIdx.has(s) {
        return lowStrIdx.get(s, -1)
    }
    idx = irAddStrLit(intern(s))
    lowStrIdx[s] = idx
    return idx
}

// lowUnsupported reports that `lower` hit an AST construct Task 4+ hasn't
// implemented yet, and aborts -- so an unimplemented construct fails loudly
// (a clear message, non-zero exit) instead of either silently dropping the
// node (a stray -1 return that a caller ignores) or crashing later with an
// opaque arena-index error (a stray -1 dereferenced as an index). `lower`
// has no diagnostic-accumulation path of its own, so this reuses the same
// log+quit machinery main.cla's own error paths use.
func lowUnsupported(what: string) {
    log("clarusc emit: unsupported construct: " + what + " (not yet implemented)")
    quit 1
}

// ================================================================
// Expression lowering (expr.go subset)
// ================================================================

func lowExpr(e: int): int {
    var v: int

    switch exprKind(e) {
    case ExIntLit {
        return newIRIntConst(intLitVal(e), irIntT)
    }
    case ExBoolLit {
        v = 0
        if boolLitVal(e) {
            v = 1
        }
        return newIRIntConst(v, irBoolT)
    }
    case ExCharLit {
        return newIRIntConst(charLitVal(e), irCharT)
    }
    case ExFixedLit {
        return newIRIntConst(fixedLitRaw(e), irFixedT)
    }
    case ExStringLit {
        return newIRStrConst(lowInternStr(poolGet(stringLitIdx(e))), irStrType(255))
    }
    case ExUnary {
        return newIRUn(intern(unOpSymbol(unaryOp(e))), lowExpr(unaryX(e)), lowMustType(e))
    }
    case ExBinary {
        return lowBinary(e)
    }
    case ExCall {
        return lowCall(e)
    }
    case ExIdent {
        return lowIdent(e)
    }
    case ExIndex {
        return lowIndex(e)
    }
    case ExSlice {
        return lowSlice(e)
    }
    case ExSelect {
        return lowSelect(e)
    }
    }
    // Task 6+: ExNew.
    lowUnsupported("expression kind " + numToStr(int(exprKind(e))))
    return -1
}

// lowBin builds a plain IR Bin node (lower.go's l.bin): op is interned here
// so every call site hands it a bare source spelling from binOpSymbol/
// unOpSymbol, matching ir.cla's "Bin.Op/Un.Op are interned strPool strings"
// contract.
func lowBin(opSym: string, ty: int, xAst: int, yAst: int): int {
    return newIRBin(intern(opSym), lowExpr(xAst), lowExpr(yAst), ty)
}

// lowBin2Args lowers two AST expressions into a 2-element IR expr chain
// (lower.go's l.lowArgs applied to a 2-element Go slice) -- used for
// IFixMul/IFixDiv's Args, since a Binary node's X/Y are plain fields, not an
// AST arg-chain lowArgs can walk directly.
func lowBin2Args(xAst: int, yAst: int): int {
    var x: int
    var y: int

    x = lowExpr(xAst)
    y = lowExpr(yAst)
    irExprListAppend(x, y)
    return x
}

// lowBinary dispatches `+` (int/fixed stay Bin; string/text/char concat
// routes to the matching concat/prepend intrinsic by operand-kind combo),
// `*`/`/` (fixed routes to IFixMul/IFixDiv; int stays Bin), comparisons, and
// everything else (`-`, mod, bitwise, and/or), which all stay Bin -- a port
// of expr.go's lowerBinary.
func lowBinary(e: int): int {
    var op: int
    var ty: int
    var ltk: TypeKind
    var rtk: TypeKind
    var name: int

    op = binOp(e)
    ty = lowMustType(e)

    if op == OpAdd {
        ltk = typeKind(exprTypeGet(binLeft(e)))
        rtk = typeKind(exprTypeGet(binRight(e)))
        if ltk == TyStr and rtk == TyStr {
            return newIRIntr(IStrConcat(), lowBin2Args(binLeft(e), binRight(e)), ty)
        } else if ltk == TyStr and rtk == TyChar {
            return newIRIntr(IStrConcatChar(), lowBin2Args(binLeft(e), binRight(e)), ty)
        } else if ltk == TyText and (rtk == TyText or rtk == TyStr) {
            return newIRIntr(ITextConcat(), lowBin2Args(binLeft(e), binRight(e)), ty)
        } else if ltk == TyChar and rtk == TyStr {
            return newIRIntr(IStrPrependChar(), lowBin2Args(binLeft(e), binRight(e)), ty)
        } else if ltk == TyStr and rtk == TyText {
            return newIRIntr(ITextConcatSL(), lowBin2Args(binLeft(e), binRight(e)), ty)
        } else if ltk == TyStr or ltk == TyText or ltk == TyChar or rtk == TyStr or rtk == TyText or rtk == TyChar {
            // Every other string/text/char `+` combo is rejected by the
            // checker before lowering ever sees it.
            lowUnsupported("string/text/char + operand combo")
            return -1
        }
        return lowBin(binOpSymbol(op), ty, binLeft(e), binRight(e))
    } else if op == OpMul or op == OpDiv {
        if typeKind(exprTypeGet(binLeft(e))) == TyFixed {
            name = IFixMul()
            if op == OpDiv {
                name = IFixDiv()
            }
            return newIRIntr(name, lowBin2Args(binLeft(e), binRight(e)), ty)
        }
        return lowBin(binOpSymbol(op), ty, binLeft(e), binRight(e))
    } else if op == OpEq or op == OpNe or op == OpLt or op == OpLe or op == OpGt or op == OpGe {
        return lowComparison(e)
    }
    // "-", mod, &, |, ^, <<, >>, and, or.
    return lowBin(binOpSymbol(op), ty, binLeft(e), binRight(e))
}

// lowComparison lowers `== != < <= > >=`: a String/Text operand (either
// side) compares via the byte-wise cmp intrinsics wrapped as `<op> 0` (Text
// wins over String when mixed, since IStrCmp only knows fixed-capacity
// strings); everything else (int/fixed/char/bool/enum) stays a plain Bin
// comparison -- a port of expr.go's lowerComparison.
func lowComparison(e: int): int {
    var ltk: TypeKind
    var rtk: TypeKind
    var name: int
    var cmp: int
    var zero: int

    ltk = typeKind(exprTypeGet(binLeft(e)))
    rtk = typeKind(exprTypeGet(binRight(e)))
    if ltk == TyStr or ltk == TyText or rtk == TyStr or rtk == TyText {
        name = IStrCmp()
        if ltk == TyText or rtk == TyText {
            name = ITextCmp()
        }
        cmp = newIRIntr(name, lowBin2Args(binLeft(e), binRight(e)), irIntT)
        zero = newIRIntConst(0, irIntT)
        return newIRBin(intern(binOpSymbol(binOp(e))), cmp, zero, irBoolT)
    }
    return lowBin(binOpSymbol(binOp(e)), irBoolT, binLeft(e), binRight(e))
}

// lowIdent lowers a bare variable reference (expr.go's lowerIdent, reduced).
// Task 4+ adds enum-member constants, const inlining, and lastError.
func lowIdent(e: int): int {
    var nm: int
    var global: bool

    nm = identName(e)
    global = not lowIsLocal(nm)
    return newIRVarRef(nm, global, lowMustType(e))
}

// lowArgs lowers an AST argument chain (each linked via exprNext) into an IR
// expr chain (linked via irExprListAppend), returning the chain head (-1 if
// none).
func lowArgs(argsHead: int): int {
    var head: int
    var tail: int
    var a: int
    var le: int

    head = -1
    tail = -1
    a = argsHead
    while a != -1 {
        le = lowExpr(a)
        if head == -1 {
            head = le
        }
        tail = irExprListAppend(tail, le)
        a = exprNext(a)
    }
    return head
}

// lowCall lowers a bare-name call. Skeleton: alert/log intrinsics only.
func lowCall(e: int): int {
    var fn: int
    var name: string
    var ty: int

    fn = callFn(e)
    if exprKind(fn) == ExIdent {
        name = poolGet(identName(fn))
        ty = lowMustType(e)
        if name == "alert" {
            return newIRIntr(IAlert(), lowArgs(callArgsHead(e)), ty)
        } else if name == "log" {
            return newIRIntr(ILog(), lowArgs(callArgsHead(e)), ty)
        } else if name == "int" {
            return lowIntConv(e, ty)
        } else if name == "fixed" {
            return newIRConv(CvIntToFixed, lowExpr(callArgsHead(e)), -1, ty)
        } else if name == "char" {
            return newIRConv(CvIntToChar, lowExpr(callArgsHead(e)), -1, ty)
        }
        // Task 6+: enum conversions, user functions.
        lowUnsupported("call to " + name)
        return -1
    } else if exprKind(fn) == ExSelect {
        return lowMethodCall(e, fn)
    }
    lowUnsupported("call target")
    return -1
}

// lowMethodCall dispatches `x.name(args)` by the receiver's kind (expr.go's
// lowerMethodCall, reduced to the String/Text receiver -- list/map/file
// receivers are Task 6+).
func lowMethodCall(e: int, fn: int): int {
    var ty: int
    var xk: TypeKind
    var recv: int

    ty = lowMustType(e)
    xk = typeKind(exprTypeGet(selectX(fn)))
    recv = lowExpr(selectX(fn))
    if xk == TyStr or xk == TyText {
        return lowStringTextMethod(recv, xk == TyText, fn, callArgsHead(e), ty)
    }
    lowUnsupported("method call on receiver kind " + numToStr(int(xk)))
    return -1
}

// lowMethodArgs2 chains an already-lowered receiver IR expr with one
// freshly-lowered AST argument, returning the chain head (recvIR) -- the
// mixed-source counterpart to lowBin2Args/lowArgs, needed because a method
// call's receiver is lowered once up front (lowMethodCall) while its
// arguments are still raw AST nodes.
func lowMethodArgs2(recvIR: int, a0Ast: int): int {
    var a: int

    a = lowExpr(a0Ast)
    irExprListAppend(recvIR, a)
    return recvIR
}

// lowMethodArgs3 is lowMethodArgs2 for a 2-argument method call (fromBytes).
func lowMethodArgs3(recvIR: int, a0Ast: int, a1Ast: int): int {
    var a: int
    var b: int

    a = lowExpr(a0Ast)
    b = lowExpr(a1Ast)
    irExprListAppend(recvIR, a)
    irExprListAppend(a, b)
    return recvIR
}

// lowStringTextMethod lowers `.fromBytes`/`.toBytes`/`.indexOf`/`.append` on
// a String or Text receiver (expr.go's lowerStringTextMethod).
func lowStringTextMethod(recv: int, isText: bool, sel: int, argsHead: int, ty: int): int {
    var nm: string
    var name: int
    var arg0: int
    var arg1: int

    nm = poolGet(selectName(sel))
    arg0 = argsHead
    if nm == "fromBytes" {
        arg1 = exprNext(arg0)
        name = IStrFromBytes()
        if isText {
            name = ITextFromBytes()
        }
        return newIRIntr(name, lowMethodArgs3(recv, arg0, arg1), ty)
    } else if nm == "toBytes" {
        name = IStrToBytes()
        if isText {
            name = ITextToBytes()
        }
        return newIRIntr(name, lowMethodArgs2(recv, arg0), ty)
    } else if nm == "indexOf" {
        return lowIndexOf(recv, isText, arg0, ty)
    } else if nm == "append" {
        // textOnlyMethods (check.cla) only reaches here for a text
        // receiver -- isText is always true.
        return lowAppend(recv, arg0, ty)
    }
    lowUnsupported("string/text method " + nm)
    return -1
}

// lowIndexOf lowers `x.indexOf(arg)` (Ch3: string/text -- indexOf), picking
// the char vs. string needle intrinsic for whichever of string/text recv is
// -- a port of expr.go's lowerIndexOf.
func lowIndexOf(recv: int, isText: bool, argAst: int, ty: int): int {
    var isChar: bool
    var name: int

    isChar = typeKind(exprTypeGet(argAst)) == TyChar
    name = IStrIndexOfStr()
    if (not isText) and isChar {
        name = IStrIndexOfChar()
    } else if isText and isChar {
        name = ITextIndexOfChar()
    } else if isText {
        name = ITextIndexOfStr()
    }
    return newIRIntr(name, lowMethodArgs2(recv, argAst), ty)
}

// lowAppend lowers `t.append(arg)` (Ch3: Text -- append grows t in place);
// arg is string, char, or text -- a port of expr.go's lowerAppend.
func lowAppend(recv: int, argAst: int, ty: int): int {
    var name: int
    var argk: TypeKind

    argk = typeKind(exprTypeGet(argAst))
    name = ITextAppendStr()
    if argk == TyChar {
        name = ITextAppendChar()
    } else if argk == TyText {
        name = ITextAppendText()
    }
    return newIRIntr(name, lowMethodArgs2(recv, argAst), ty)
}

// lowSlice lowers `x[start, len]` (Ch3: Strings, Text -- Slicing) to the
// str/text slice intrinsic -- a port of expr.go's lowerSlice.
func lowSlice(e: int): int {
    var ty: int
    var name: int
    var x: int
    var start: int
    var ln: int

    ty = lowMustType(e)
    name = IStrSlice()
    if typeKind(exprTypeGet(sliceX(e))) == TyText {
        name = ITextSlice()
    }
    x = lowExpr(sliceX(e))
    start = lowExpr(sliceStart(e))
    ln = lowExpr(sliceLen(e))
    irExprListAppend(x, start)
    irExprListAppend(start, ln)
    return newIRIntr(name, x, ty)
}

// lowIndex lowers `a[i]`. Array indexing lowers to IndexRef (Task 6+ adds
// List); string/text index to their read intrinsic -- a port of expr.go's
// lowerIndex, minus the List/Map receivers.
func lowIndex(e: int): int {
    var ty: int
    var xk: TypeKind

    ty = lowMustType(e)
    xk = typeKind(exprTypeGet(indexX(e)))
    if xk == TyArr {
        return newIRIndexRef(lowExpr(indexX(e)), lowExpr(indexI(e)), ty)
    } else if xk == TyStr {
        return newIRIntr(IStrIndex(), lowBin2Args(indexX(e), indexI(e)), ty)
    } else if xk == TyText {
        return newIRIntr(ITextIndex(), lowBin2Args(indexX(e), indexI(e)), ty)
    }
    lowUnsupported("index of unsupported kind " + numToStr(int(xk)))
    return -1
}

// lowSelect lowers a bare `a.b` -- reduced to the String/Text `.length`
// property (Task 6+ adds record fields and list/map `.count`) -- a port of
// expr.go's lowerSelect.
func lowSelect(e: int): int {
    var ty: int
    var xk: TypeKind
    var propName: string
    var name: int

    ty = lowMustType(e)
    xk = typeKind(exprTypeGet(selectX(e)))
    propName = poolGet(selectName(e))
    if (xk == TyStr or xk == TyText) and propName == "length" {
        name = IStrLen()
        if xk == TyText {
            name = ITextLen()
        }
        return newIRIntr(name, lowExpr(selectX(e)), ty)
    }
    lowUnsupported("select ." + propName)
    return -1
}

// coerceStr wraps x in a capacity-clamping temp when x is a Str value whose
// capacity differs from target's -- a port of expr.go's coerceStr. No call
// site in this task's conservative subset reaches a mismatched-capacity
// Str binding yet (no user functions/lists/maps are wired); ported now so
// Task 6+'s call/list/map slices can call it directly.
func lowCoerceStr(target: int, x: int): int {
    if irtKind(target) != KStr or irtKind(irExprType(x)) != KStr or irtN(irExprType(x)) == irtN(target) {
        return x
    }
    return newIRIntr(IStrCoerce(), x, target)
}

// lowIntConv lowers `int(x)`, whose ConvOp depends on x's source kind (Ch3:
// Numeric Conversions, Enums) -- a port of expr.go's lowerIntConv, minus the
// Enum source (Task 8).
func lowIntConv(e: int, ty: int): int {
    var argT: int
    var argK: TypeKind

    argT = exprTypeGet(callArgsHead(e))
    argK = typeKind(argT)
    if argK == TyFixed {
        return newIRConv(CvFixedToInt, lowExpr(callArgsHead(e)), -1, ty)
    } else if argK == TyChar {
        return newIRConv(CvCharToInt, lowExpr(callArgsHead(e)), -1, ty)
    }
    // TyEnum: Task 8. Anything else is a checker bug (int() from an
    // unsupported source kind should never pass checkCall).
    lowUnsupported("int(...) from unsupported source kind")
    return -1
}

// ================================================================
// Statement lowering (stmt.go subset)
// ================================================================

// lowStoreStmt builds the store form for `dst = src` at IR type t: a Str
// destination clamps through StoreStr; a Text destination fed by a Str
// source (the checker's String -> Text assignability) goes through the
// text_store intrinsic, since a Text handle and a Str value have no common
// C representation to plain-assign between; everything else (Text=Text
// reference copy, records/arrays copy by value) is a plain Assign --
// stmt.go's storeStmt.
func lowStoreStmt(dst: int, src: int, t: int): int {
    if irtKind(t) == KStr {
        return newIRStoreStr(dst, src)
    } else if irtKind(t) == KText and irtKind(irExprType(src)) == KStr {
        irExprListAppend(dst, src)
        return newIRExprStmt(newIRIntr(ITextStore(), dst, irVoidT))
    }
    return newIRAssign(dst, src)
}

// lowStmt lowers one statement, returning its irStmts index, or -1 for a
// statement that contributes no IR node.
func lowStmt(s: int): int {
    switch stmtKind(s) {
    case StExprStmt {
        return newIRExprStmt(lowExpr(exprStmtX(s)))
    }
    case StIf {
        return lowIf(s)
    }
    case StQuit {
        return lowQuit(s)
    }
    case StAssign {
        return lowAssign(s)
    }
    case StWhile {
        return lowWhile(s)
    }
    case StFor {
        return lowFor(s)
    }
    case StReturn {
        return lowReturn(s)
    }
    case StBreak {
        return newIRBreak()
    }
    case StContinue {
        return newIRContinue()
    }
    case StSwitch {
        return lowSwitch(s)
    }
    }
    lowUnsupported("statement kind " + numToStr(int(stmtKind(s))))
    return -1
}

// lowWhile lowers `while cond { ... }` -- stmt.go's While case.
func lowWhile(s: int): int {
    var cond: int
    var body: int

    cond = lowExpr(whileCond(s))
    body = lowBlock(whileBody(s))
    return newIRWhile(cond, body)
}

// lowFor lowers the inclusive int-range `for` form only (Ch5: For) --
// stmt.go's lowerFor, RANGE case. From/To are lowered in the ENCLOSING
// scope (mirroring checkForStmt's own scope nesting), THEN V is declared as
// an Int local in a fresh scope wrapping the body. The list/map `for` forms
// (ForList/ForMap) are Task 7 -- left loud via lowUnsupported.
func lowFor(s: int): int {
    var seq: int
    var toExpr: int
    var body: int
    var n: int

    seq = lowExpr(forSeq(s))
    if forTo(s) != -1 {
        toExpr = lowExpr(forTo(s))
        lowPushScope()
        lowAddLocal(forV1(s), irIntT)
        lowDeclareLocal(forV1(s))
        body = lowBlock(forBody(s))
        n = newIRForRange(forV1(s), seq, toExpr, body)
        lowPopScope()
        return n
    }
    // Task 7: for-over-list / for-over-map.
    lowUnsupported("for-list/for-map (not yet implemented)")
    return -1
}

// lowReturn lowers `return` / `return expr` -- stmt.go's Return case. A
// value clamps through lowCoerceStr against the enclosing function's
// declared return type (lowCurFuncRet), exactly like a plain `var`
// initializer's store.
func lowReturn(s: int): int {
    var x: int

    x = -1
    if returnX(s) != -1 {
        x = lowCoerceStr(lowCurFuncRet, lowExpr(returnX(s)))
    }
    return newIRReturn(x)
}

// lowAssign lowers `lvalue = expr` (stmt.go's lowerAssign): `l[i] = v`
// routes through lowIndexAssign; everything else (a plain variable) is a
// normal store through lowStoreStmt.
func lowAssign(s: int): int {
    var lhs: int
    var ty: int

    lhs = assignLHS(s)
    if exprKind(lhs) == ExIndex {
        return lowIndexAssign(lhs, assignRHS(s))
    }
    ty = lowMustType(lhs)
    return lowStoreStmt(lowExpr(lhs), lowExpr(assignRHS(s)), ty)
}

// lowIndexAssign lowers `x[i] = rhs` (stmt.go's lowerIndexAssign, minus the
// Map case -- Task 6+): an array element write reuses IndexRef as an lvalue
// through lowStoreStmt (same printer contract as a read); string/text
// writes have no lvalue form and lower to their set-index intrinsic as an
// ExprStmt instead.
func lowIndexAssign(lhs: int, rhsAst: int): int {
    var xk: TypeKind
    var x: int
    var i: int
    var rhs: int
    var elemTy: int

    xk = typeKind(exprTypeGet(indexX(lhs)))
    x = lowExpr(indexX(lhs))
    i = lowExpr(indexI(lhs))
    rhs = lowExpr(rhsAst)
    if xk == TyArr {
        elemTy = lowMustType(lhs)
        return lowStoreStmt(newIRIndexRef(x, i, elemTy), rhs, elemTy)
    } else if xk == TyStr {
        irExprListAppend(x, i)
        irExprListAppend(i, rhs)
        return newIRExprStmt(newIRIntr(IStrSetIndex(), x, irVoidT))
    } else if xk == TyText {
        irExprListAppend(x, i)
        irExprListAppend(i, rhs)
        return newIRExprStmt(newIRIntr(ITextSetIndex(), x, irVoidT))
    }
    lowUnsupported("index-assign of unsupported kind " + numToStr(int(xk)))
    return -1
}

// lowIf lowers `if cond { ... } [else { ... } | else if ...]` -- a port of
// stmt.go's lowerIf. Else is -1 (no else), a StBlock, or another StIf
// (an else-if chain), mirroring ast.go's Stmt-typed Else.
func lowIf(s: int): int {
    var cond: int
    var thenHead: int
    var elseNode: int
    var elseHead: int

    cond = lowExpr(ifCond(s))
    thenHead = lowBlock(ifThen(s))
    elseHead = -1
    elseNode = ifElse(s)
    if elseNode != -1 {
        if stmtKind(elseNode) == StBlock {
            elseHead = lowBlock(elseNode)
        } else if stmtKind(elseNode) == StIf {
            elseHead = lowIf(elseNode)
        } else {
            lowUnsupported("if-else shape")
        }
    }
    return newIRIf(cond, thenHead, elseHead)
}

// lowQuit lowers `quit [code]` to Intr(IQuit) with exactly one int argument
// (bare `quit` supplies IntConst 0) -- stmt.go's lowerQuit.
func lowQuit(s: int): int {
    var code: int

    if quitCode(s) == -1 {
        code = newIRIntConst(0, irIntT)
    } else {
        code = lowExpr(quitCode(s))
    }
    return newIRExprStmt(newIRIntr(IQuit(), code, irVoidT))
}

// lowNewSwitchTemp names one switch desugar's subject temp. The "__switch"
// prefix keeps it out of the way of any user-declared local -- Clarus
// source identifiers are never expected to start with a double underscore
// -- and lowSwitchN is program-wide (never reset per function) so nested/
// sibling switches never collide even when several land in the same
// function body -- stmt.go's newSwitchTemp.
func lowNewSwitchTemp(): int {
    lowSwitchN = lowSwitchN + 1
    return intern("__switch" + numToStr(lowSwitchN))
}

// lowLabelEq builds `tmp == label`: a plain int/char/enum comparison, or
// `str_cmp(tmp, label) == 0` for a string subject (a case label is always a
// literal, bare enum member, or const Ident -- checkCaseLabel's "must be a
// constant" rule) -- stmt.go's labelEq.
func lowLabelEq(subjT: int, ty: int, tmpNameIdx: int, lbl: int): int {
    var ref: int
    var lblExpr: int
    var cmp: int
    var zero: int

    ref = newIRVarRef(tmpNameIdx, false, ty)
    lblExpr = lowExpr(lbl)
    if typeKind(subjT) == TyStr {
        irExprListAppend(ref, lblExpr)
        cmp = newIRIntr(IStrCmp(), ref, irIntT)
        zero = newIRIntConst(0, irIntT)
        return newIRBin(intern("=="), cmp, zero, irBoolT)
    }
    return newIRBin(intern("=="), ref, lblExpr, irBoolT)
}

// lowCaseCond builds one case's condition: its label(s), OR'd together when
// there's more than one (`case 2, 3`) -- stmt.go's caseCond.
func lowCaseCond(subjT: int, ty: int, tmpNameIdx: int, labelsHead: int): int {
    var cond: int
    var eq: int
    var lbl: int

    cond = -1
    lbl = labelsHead
    while lbl != -1 {
        eq = lowLabelEq(subjT, ty, tmpNameIdx, lbl)
        if cond == -1 {
            cond = eq
        } else {
            cond = newIRBin(intern("or"), cond, eq, irBoolT)
        }
        lbl = exprNext(lbl)
    }
    return cond
}

// lowSwitch desugars `switch subject { case labels {body} ... [else
// {body}] }` into: the subject expression evaluated exactly ONCE into a
// synthesized function-local temp (so a subject with side effects, e.g. a
// function call, never re-runs per case), followed by an
// if/else-if/.../else chain comparing that temp against each case's
// label(s) -- cases are iterated in REVERSE, each wrapping the
// previously-built chain as its Else, so the final result is exactly TWO
// chained statements: the subject store, then one nested If -- stmt.go's
// lowerSwitch.
//
// The desugared chain is pure IR If/Assign -- no C loop or switch construct
// is ever emitted for it -- so a `break`/`continue` lowered from inside a
// case body automatically binds whatever LOOP lexically encloses the
// switch, never the switch itself, with no special-casing required here.
func lowSwitch(s: int): int {
    var subjT: int
    var ty: int
    var tmpNameIdx: int
    var storeIdx: int
    var tailHead: int
    var caseIdxs: list of int
    var cs: int
    var i: int
    var cond: int
    var body: int

    subjT = exprTypeGet(switchSubject(s))
    ty = lowType(subjT)
    tmpNameIdx = lowNewSwitchTemp()
    lowAddLocal(tmpNameIdx, ty)
    storeIdx = lowStoreStmt(newIRVarRef(tmpNameIdx, false, ty), lowExpr(switchSubject(s)), ty)

    tailHead = -1
    if switchElse(s) != -1 {
        tailHead = lowBlock(switchElse(s))
    }

    cs = switchCasesHead(s)
    while cs != -1 {
        caseIdxs.add(cs)
        cs = stmtNext(cs)
    }

    i = caseIdxs.count - 1
    while i >= 0 {
        cond = lowCaseCond(subjT, ty, tmpNameIdx, caseLabelsHead(caseIdxs[i]))
        body = lowBlock(caseBody(caseIdxs[i]))
        tailHead = newIRIf(cond, body, tailHead)
        i = i - 1
    }

    irStmtListAppend(storeIdx, tailHead)
    return storeIdx
}

// lowBlock lowers one StBlock's local `var`s (flattened into the current
// function's locals chain) then its statements, in a fresh nested scope, and
// returns the statement-chain head (-1 if empty) -- stmt.go's lowerBlock.
func lowBlock(blk: int): int {
    var head: int
    var tail: int
    var v: int
    var t: int
    var dst: int
    var s: int
    var st: int

    lowPushScope()
    head = -1
    tail = -1

    v = blockVarsHead(blk)
    while v != -1 {
        t = lowResolveType(varDeclType(v))
        lowAddLocal(varDeclName(v), t)
        lowDeclareLocal(varDeclName(v))
        if varDeclInit(v) != -1 {
            dst = newIRVarRef(varDeclName(v), false, t)
            st = lowStoreStmt(dst, lowExpr(varDeclInit(v)), t)
            if head == -1 {
                head = st
            }
            tail = irStmtListAppend(tail, st)
        }
        v = declNext(v)
    }

    s = blockStmtsHead(blk)
    while s != -1 {
        st = lowStmt(s)
        if st != -1 {
            if head == -1 {
                head = st
            }
            // lowStmt normally returns one node (its own .next left at -1
            // by every newIRXxx constructor), but lowSwitch returns a
            // 2-node chain (the subject store, already linked to its
            // if-chain via .next) -- walk to the chain's TRUE end so the
            // next statement appends after it, not in the middle.
            tail = irStmtListAppend(tail, st)
            while irStmtNext(tail) != -1 {
                tail = irStmtNext(tail)
            }
        }
        s = stmtNext(s)
    }

    lowPopScope()
    return head
}

// ================================================================
// Declaration + top-level lowering (lower.go / stmt.go subset)
// ================================================================

// lowFuncBody lowers params + a body block into an ir.Func, registering the
// signature scope and returning its irFuncs index (stmt.go's lowerFuncBody).
func lowFuncBody(nameIdx: int, astParamsHead: int, ret: int, bodyBlk: int): int {
    var paramsHead: int
    var paramsTail: int
    var p: int
    var loc: int
    var savedRet: int
    var bodyHead: int
    var fn: int

    lowPushScope()

    paramsHead = -1
    paramsTail = -1
    p = astParamsHead
    while p != -1 {
        loc = newIRLocal(paramName(p), lowResolveType(paramType(p)))
        if paramsHead == -1 {
            paramsHead = loc
        }
        paramsTail = irLocalListAppend(paramsTail, loc)
        lowDeclareLocal(paramName(p))
        p = declNext(p)
    }

    lowLocalsHead = -1
    lowLocalsTail = -1
    savedRet = lowCurFuncRet
    lowCurFuncRet = ret
    bodyHead = lowBlock(bodyBlk)
    lowCurFuncRet = savedRet

    fn = newIRFunc(nameIdx, paramsHead, ret, lowLocalsHead, bodyHead)
    lowPopScope()
    return fn
}

// lowTopHandler lowers a top-level `on App.launch`/`startEmpty`/`startCLI`
// handler into an ir.Func plus the matching Program flag (stmt.go's
// lowerTopHandlerDecl). Any other handler event is host-unsupported (Task 4+).
func lowTopHandler(d: int) {
    var path: string

    path = poolGet(handlerDeclPath(d))
    if path == "App.launch" {
        lowFuncBody(intern("handler_App_launch"), -1, irVoidT, handlerDeclBody(d))
        irHasLaunch = true
    } else if path == "App.startEmpty" {
        lowFuncBody(intern("handler_App_startEmpty"), -1, irVoidT, handlerDeclBody(d))
        irHasStartEmpty = true
    } else if path == "App.startCLI" {
        lowFuncBody(intern("handler_App_startCLI"), handlerDeclParamsHead(d), irVoidT, handlerDeclBody(d))
        irHasStartCLI = true
    } else {
        // Task 4+: `on App.openDocument` and resource handlers are
        // unsupported.
        lowUnsupported("handler " + path)
    }
}

// lowDecl dispatches one top-level declaration (lower.go's lowerDecl subset).
func lowDecl(d: int) {
    var k: DeclKind

    k = declKind(d)
    if k == DkHandler {
        lowTopHandler(d)
    } else if k == DkInclude or k == DkConst {
        // DkInclude/DkConst intentionally emit no IR (includes are already
        // expanded; consts inline at use, Task 4+) -- not a stub.
    } else {
        // Task 4+: DkRecord/DkEnum/DkVar(global)/DkFunc, and any other
        // top-level decl kind, are unsupported until their task lands.
        lowUnsupported("declaration kind " + numToStr(int(k)))
    }
}

// lowerProgram walks the assembled top-level decl chain (declHead, linked via
// declNext), populating the ir.cla arenas + Program flags. Returns 0 (ir.cla
// has no wrapping Program value: the arenas ARE the program). irReset() must
// have run first.
func lowerProgram(declHead: int): int {
    var d: int

    lowSwitchN = 0
    d = declHead
    while d != -1 {
        lowDecl(d)
        d = declNext(d)
    }
    return 0
}

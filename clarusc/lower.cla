// lower.cla: AST + checker-type-info -> arena IR (ir.cla). A port of the
// walking-skeleton subset of internal/lower (lower.go / stmt.go / expr.go).
//
// This is Task 3's walking skeleton: it lowers ONLY what the seed program
//   on App.startCLI(args: list of string) { alert("...") quit 0 }
// needs -- Program flags + one handler Func, ExprStmt, Intr(IAlert/ILog),
// Intr(IQuit), StrConst and IntConst -- plus the structural scaffolding
// (scope stack, curFuncRet, per-function locals chain, full lowType/
// lowResolveType) that Tasks 4-9 extend without reshaping. Every branch a
// later task fills in is marked "Task 4+".
//
// One program is lowered per process (a fresh `clarusc emit FILE` exec per
// program): the checker's exprTypeOf and the AST arenas are never cleared
// between check and lower, so exprTypeGet(e) resolves against the very AST
// this pass walks. irReset() (ir.cla) must run once before lowerProgram to
// seed the singleton IR scalar types (irIntT, irVoidT, ...).

include "lib.cla"
include "ast.cla"
include "types.cla"
include "check.cla"
include "ir.cla"

// ================================================================
// Lowerer state (lower.go's `lowerer` struct, reduced to the skeleton).
// ================================================================

// LowScope is one nested local-variable scope: names present as locals in
// this scope (value 1), keyed by interned nameIdx. Mirrors lower.go's
// localScopes entries -- consulted by lowIsLocal so lowIdent can tell a
// local VarRef from a global one.
record LowScope {
    names: intmap of int
}

var lowScopes: list of LowScope

// lowStrIdx dedups string literals into the irStrLits pool by literal value
// (lower.go's strIdx): identical literals share one clar_lit_K slot.
var lowStrIdx: map of int

// lowResumeFromBake (runtime-ir-bake Task 4) tells lowerProgram (below) it
// is lowering USER code only, on top of an already-installed baked
// runtime image (bake.cla's bkInstallArenas), rather than starting a
// program's IR from scratch -- gates the two pieces of lowerProgram's own
// top that would otherwise silently duplicate baked state: the counter
// resets (lowSwitchN/uiMenuCount/lowStrIdx must RESUME from the baked
// end-values a normal compile's own driveCompile already restored via
// bkInstallArenas, not restart at zero) and lowBuiltinSaveChoiceLayout
// (the runtime bake's own lowerProgram call already built the ONE
// "saveChoice" IREnumLayout+members this program needs; calling it again
// would mint a second, dead-weight copy). The front end (driveCompile)
// sets this immediately before every lowerProgram call, true or false,
// the same "always set, never rely on a stale value" convention
// wantEmit/want68k already use -- never left implicitly true across
// compiles. Default false: every OTHER lowerProgram caller (the bake
// generator's own bakeGenerateChain, and driveCompile's own from-source
// branch) is completely unaffected by this flag's existence.
var lowResumeFromBake: bool

// lowSkipUiDispatchers (runtime-ir-bake Task 5, fix round 1) tells
// lowerProgram to skip lowSynthUiDispatchers entirely -- set ONLY by
// bake.cla's own bakeGenerateChain, around its own two lowerProgram
// calls (base pass and uitest pass), false everywhere else including
// every real driveCompile call (bake-path or from-source). The real
// per-compile lowerProgram(combined2) call ALWAYS runs
// lowSynthUiDispatchers unconditionally regardless of this flag (it
// never sets this true), so the eight dispatcher stubs still get built
// exactly once, against the REAL program's own window/menu/every state,
// on every actual compile -- this flag only stops the GENERATOR from
// wastefully building a second (always-empty-state, always-discarded)
// copy that a real compile's own dispatcher synthesis would otherwise
// dedup its panic-message string literals against (lowStrIdx), landing
// them at the WRONG (early, baked) position instead of the tail
// position a from-source compile's ONE synthesis pass always gives them
// -- runtime-ir-bake Task 5's own report, "inherited problem, second
// wave".
var lowSkipUiDispatchers: bool

// ---- `on App.log(line: string)` (onlog phase) ----
//
// lowHasAppLog is set by lowerProgram's own pre-pass (a scan of the
// top-level decl chain for an `on App.log` handler) BEFORE any function
// body is lowered -- a pre-pass, not lowTopHandler's own side effect,
// because a `log()` call site lowered EARLIER in the same chain has to
// route the same way as one lowered after the handler's own decl (the
// same reason the extern pre-pass right above the main walk exists).
//
// lowCurFnRuntimeOrigin mirrors lowFuncBody's own `runtimeOrigin`
// argument for the duration of that body's lowering, so the `log()` arm
// of lowCall can tell a USER `log()` statement from a runtime module's
// own (runtime/clarus/uiscript.cla and uiwidgets.cla each carry one
// "uiport: ..." diagnostic). Only the user-facing statement is routed
// through the handler; a runtime module's stays the raw ILog intrinsic.
// Two reasons, both load-bearing:
//   - the feature's own contract (only the user-facing `log()` path
//     fires the handler; runtime-internal writes never do), and
//   - baked-vs-from-source parity: under a runtime-IR bake the runtime
//     chain was lowered in a SEPARATE lowerProgram pass (bake.cla's
//     bakeGenerateChain), where no user handler exists and where these
//     two calls were therefore already frozen as raw ILog. Gating on
//     runtime origin makes the from-source lane agree with the baked
//     lane instead of diverging on exactly those two lines.
var lowHasAppLog: bool
var lowCurFnRuntimeOrigin: bool

// ---- connection lowering state (serial-connection phase, Task 5) ----
//
// lowConnSlotOf maps a global `connection` var's own name to its slot
// index (0..3), assigned by lowerProgram's own pre-pass in declaration
// order (spec %3.3: "global connection vars only" -- the same GLOBAL-only
// scope check.cla's usesConn already enforces). Built ONLY when usesConn
// (check.cla), before the main decl walk, so lowTopHandler/lowConnMethod
// (below) can resolve a slot for a handler/method reached in ANY source
// order relative to the var's own decl -- same reason the extern and
// `on App.log` pre-passes above exist. Never reset from a bake (a runtime
// module can never declare a `connection` global, so this is always
// empty during a bake pass regardless).
//
// Name-keyed, guarded by lowIsLocal at every read site (final-review
// Important 2): `curScope` is pinned at the program's TOP scope for the
// whole lowering pass (see lowTableRowsGlobalName's own doc comment --
// check.cla's block/function scopes are pushed and popped during
// CHECKING only and don't survive into lowering), so a symbol-table
// scopeLookup from inside a function body can never see that function's
// own locals -- it would just re-resolve to the global every time,
// reproducing the exact bug this map switched away from name-keying to
// fix. lowIsLocal(nameIdx) is lowering's OWN real answer to "does the
// current lowering scope shadow this name with a local?" (lowScopes,
// populated by lowDeclareLocal as lowering walks each block -- the same
// mechanism isBareWindowTitleIdent/lowIdent already use for this exact
// kind of shadow guard), so every lowConnSlotOf lookup below first checks
// `not lowIsLocal(name)`: a LOCAL `var conn: connection` that shadows a
// same-named global no longer matches this map at all, regardless of the
// name collision, and falls through to the spec-mandated
// not-yet-implemented rejection like any other unsupported receiver
// shape.
//
// 4 (not a named const): matches conn.cla's own `const rtConnMax: int =
// 4` -- clarusc's own source (this file) and a user program's runtime
// modules (conn.cla) are different compilation units with no shared
// namespace, so there is no single symbol both sides could reference;
// keep the two literal 4s in sync by hand if that ever changes.
var lowConnSlotOf: map of int

// lowConnHandlerFn maps "<slot>|<event>" (event one of opened/received/
// closed/failed) to the interned C name of that slot's minted handler
// IRFunc -- absent (map default -1) when no `on <var>.<event>` handler
// was declared for that slot, which lowSynthConnFireOpened/Received/
// Closed/Failed (below) read as "no-op arm", per the brief's own rule
// ("a slot with no handler for an event is a no-op").
var lowConnHandlerFn: map of int

// lowCurFuncRet is the enclosing function's declared return IR type index,
// for the Return-statement coercion Task 4 adds (lower.go's curFuncRet).
var lowCurFuncRet: int

// lowLocalsHead/lowLocalsTail thread the current function's flat locals
// chain (lower.go's f.Locals): every nested block's `var` flattens into it,
// which is what cprint declares at C function scope.
var lowLocalsHead: int
var lowLocalsTail: int

// lowSwitchN counts synthesized switch-subject temps (lowNewSwitchTemp,
// below) program-wide, NEVER per-function or per-scope -- so two switches
// landing in the same function (or in sibling functions) never collide on
// the same "__switchN" local name (lower.go's lowerer.switchN). Reset once
// per program in lowerProgram, alongside irReset().
var lowSwitchN: int

// uiMenuCount/uiMenuIdx/uiMenuItemIdx (Task 4) are lowMenuDecl's own
// declaration-order registries, existing solely so `Menu.Item.enabled = b`
// (lowMenuEnableAssign) can resolve rt_ui_menu_enable's two indices:
// uiMenuIdx maps a menu name to its 0-based declaration-order position
// (rt_ui_menu_enable's menuIdx parameter is 0-based -- see rt_ui.c's
// gMenuHandles/gNMenus bounds check; the 1-based "Nth declared menu" phrasing
// belongs only to the RT_MAC_TEST event script's `menu M I` bar position, a
// different, human-facing index space, not this C parameter);
// uiMenuItemIdx maps (menu, item) to that item's 0-based position in its
// OWN menu's declared entry list, separators included (matching
// rt_ui_item_desc[]'s array order -- see probe_ui.c's kProbeMenuHandlers).
// uiMenuIdx is progGen-prefixed directly (its own inline key, not
// menuKey); uiMenuItemIdx is keyed via check.cla's menuKey, which USED to
// be progGen-prefixed too but memory-leak-fix Task 7 dropped that
// namespacing (menuKey is shared with check.cla's own menuItems, folded
// into checkReset instead) -- so uiMenuItemIdx now gets an explicit
// fresh-reassign of its own at the top of lowerProgram (see that reset's
// own comment) rather than relying on namespacing. uiMenuCount is reset
// to 0 in lowerProgram, alongside lowSwitchN, so a second program's menus
// renumber from 0 again either way. Relies on
// every menu being declared before any code that references it, which is
// the only order Clarus source ever writes it in (see the language
// reference's own examples) -- lowerProgram's single top-to-bottom pass
// over declHead never revisits an earlier decl to re-register it.
var uiMenuCount: int
var uiMenuIdx: map of int
var uiMenuItemIdx: map of int

// lowCurWinType (Task 5) is the checked-type-arena index of the window type
// whose `extend` body (or window-scoped menu `extend`) is CURRENTLY being
// lowered by lowHandlerFunc, or -1 outside any such body (every-block,
// app-scope menu handler, or simply "not lowering a handler body at all").
// Mirrors check.cla's curWindow exactly, but as lower.cla's own variable --
// checkProgram already ran to completion before lowerProgram starts (see
// lowResolveType's header comment on curScope/symbols being read-only
// leftovers from checking), so check.cla's curWindow itself is always back
// at -1 by the time any lowering runs and cannot be reused here. Consulted
// by lowIdent (a bare per-instance-var/`title` reference), lowWidgetRecv (a
// bare widget receiver), and ExWindowSelf's lowExpr case (the `window`
// keyword) to resolve against the handler's own hidden instance value
// (lowWinInstRef) instead of a local/global (Ch8: "bare names resolve first
// against the firing instance's properties, fields, and widgets").
var lowCurWinType: int

// lowCurHandlerEvent/lowCurAcceptedParam (Task 7, Ch10 forms) scope `isNew`
// to exactly one place: a read of the `accepted` handler's own declared
// parameter. Saved/set/restored around a handler body's own lowHandlerFunc
// call in lowWindowHandlerEntry (the same save-set-restore shape lowCurWinType
// itself uses, just driven from the caller that actually knows the event
// name/param, rather than from lowHandlerFunc -- widget/menu/every handlers
// have no such concept at all). -1 outside any accepted/cancelled handler
// body. lowCurAcceptedParam (the accepted param's own interned name, e.g.
// "b" for `on accepted(b: Bookmark)`) is meaningful only while
// lowCurHandlerEvent == intern("accepted"); consulted by lowSelect's TyRec
// case (`b.isNew`) to tell "the accepted param itself" apart from any other
// record read that happens to spell a field `isNew`.
var lowCurHandlerEvent: int
var lowCurAcceptedParam: int

// uiWinHandlersIdx (Task 5) maps a window type name to its irWinHandlers
// arena index, lazily created on that window's FIRST registered handler
// (lowGetOrCreateWinHandlers) -- a window with no `extend` block at all
// never gets an entry, matching cpFindWinHandlers' "-1 means no extend
// block" contract. progGen-prefixed like uiMenuIdx, for the same reason.
var uiWinHandlersIdx: map of int

// WinVarDefault/winVarDefaults/winVarDefaultsHead (Task 7, mac-target-4b
// acceptance-example fix): a per-instance window `var` declared with an
// initializer (Ch8's own `var dirty: bool = false` example) was checked for
// type-compatibility (check.cla's checkWindowVar) but the initializer AST
// node itself was then discarded -- lowWindowDecl's OWN header comment used
// to document this as deliberate ("applying a default is wiring the opened
// handler owns, not this task"), but Task 5 never actually wired it either,
// so a declared default was silently never applied: the runtime allocates
// a per-instance state block zeroed (rt_ui_alloc_locked/NewHandleClear),
// nothing else ever touched it. Surfaced by real-input testing of
// testdata/valid/bounce.cla (Ch11's own worked example, `var x: fixed =
// 10.0`) never animating. Fixed by recording each defaulted var's (name,
// init-AST, type) here during lowWindowDecl, then applying it as ordinary
// per-instance-field assignment statements -- prepended to an explicit
// `on opened` handler's body if one exists (lowWindowHandlerEntry), or a
// freshly synthesized opened handler if not (lowSynthesizeMissingOpenedHandlers,
// called once at the end of lowerProgram) -- entirely at the IR level, no
// rt_ui.h/rt_ui.c runtime change needed, since `opened` dispatch already
// exists for exactly this purpose. progGen-prefixed like uiWinHandlersIdx,
// for the same reason; the winVarDefaults arena itself is never reset
// (matching uiMenuIdx/uiWinHandlersIdx's own precedent -- namespacing by
// key is what makes reuse across generations safe, not clearing the arena).
record WinVarDefault {
    fieldNameIdx: int
    initAST: int
    typeIdx: int
    next: int
}
var winVarDefaults: list of WinVarDefault
var winVarDefaultsHead: map of int

func newWinVarDefault(fieldNameIdx: int, initAST: int, typeIdx: int): int {
    var n: WinVarDefault

    n.fieldNameIdx = fieldNameIdx
    n.initAST = initAST
    n.typeIdx = typeIdx
    n.next = -1
    winVarDefaults.add(n)
    return winVarDefaults.count - 1
}

func winVarDefaultListAppend(tailIdx: int, idx: int): int {
    if tailIdx != -1 {
        winVarDefaults[tailIdx].next = idx
    }
    return idx
}

func lowPushScope() {
    var s: LowScope

    lowScopes.add(s)
}

func lowPopScope() {
    lowScopes.pop()
}

func lowDeclareLocal(nameIdx: int) {
    var top: int

    top = lowScopes.count - 1
    lowScopes[top].names[nameIdx] = 1
}

func lowIsLocal(nameIdx: int): bool {
    var i: int

    i = lowScopes.count - 1
    while i >= 0 {
        if lowScopes[i].names.has(nameIdx) {
            return true
        }
        i = i - 1
    }
    return false
}

// lowAddLocal appends one local (name + IR type) to the current function's
// flat locals chain and returns its irLocals index.
func lowAddLocal(nameIdx: int, t: int): int {
    var loc: int

    loc = newIRLocal(nameIdx, t)
    if lowLocalsHead == -1 {
        lowLocalsHead = loc
    }
    lowLocalsTail = irLocalListAppend(lowLocalsTail, loc)
    return loc
}

// ================================================================
// Type lowering
// ================================================================

// lowType maps a checked type-arena index (types.cla) to its IR type index
// (ir.cla) -- a port of lower.go's lowerType. Thin wrapper over lowTypeAt
// with no diagnostic position (0:0) -- every call site that CAN realistically
// carry a TyXRec (an extern-record-typed var decl or expression) goes
// through lowTypeAt directly instead (lowResolveType's TxNamed case,
// lowMustType), so 0:0 here only covers container-element/param/subject
// positions the checker already forbids from ever being TyXRec (extern
// records can't be container elements -- check.cla's own "extern records
// cannot be container elements" diagnostic).
func lowType(t: int): int {
    return lowTypeAt(t, 0, 0)
}

// lowTypeAt is lowType's real implementation, taking an explicit
// diagnostic position (task-8, native-gaps-cleanup Part C item 4) for the
// TyXRec arm's own -1 guard: a `var r: SomeXRec` whose `extern record
// SomeXRec` declaration comes AFTER it in the source checks clean (the
// checker's declaration pass is two-phase -- order-independent), but
// lowering processes top-level decls in ONE sequential pass, so
// irFindRecordLayoutByName(name) can return -1 here if SomeXRec's own
// irRecords entry hasn't been appended yet. Reports the composition-
// ordering failure as a real diagnostic (instead of the ir.cla accessor
// panicking on irRecords[-1], "runtime error: list index out of range")
// and returns a safe dummy (irCharT array size 0, same SHAPE the real
// TyXRec arm returns) so lowering can keep collecting diagnostics rather
// than aborting on the first one.
func lowTypeAt(t: int, line: int, col: int): int {
    var recIdx: int

    switch typeKind(t) {
    case TyInt { return irIntT }
    case TyBool { return irBoolT }
    case TyFixed { return irFixedT }
    case TyChar { return irCharT }
    case TyText { return irTextT }
    case TyVoid { return irVoidT }
    case TyPtr { return irPtrT }
    case TyErrorType { return irErrT }
    case TyStr { return irStrType(typeN(t)) }
    case TyEnum { return irEnumType(typeNameIdx(t)) }
    case TyRec { return irRecType(typeNameIdx(t)) }
    case TyOverlay { return irOverlayType(typeNameIdx(t)) }
    case TyXRec {
        // Task 4 (toolbox-integration Feature B): an xrec VARIABLE's own
        // storage is a plain byte buffer (Ch13: "reserves the record's
        // packed size in bytes, zero-initialized") -- reusing the SAME
        // fixed T[n] contiguous-storage shape a `char[N]` local/global
        // already gets (both backends' existing declare/zero-init path,
        // and irtNeedsCtor's own KArr-of-KChar case, which is already
        // correctly ARC-exempt) rather than inventing a second one, per
        // the brief's own instruction. EXRecAddr (lowXRecAddr) computes
        // this variable's address directly by name -- it never reads this
        // array type back.
        //
        // task-8: recIdx can be -1 -- see lowTypeAt's own doc comment --
        // when SomeXRec's `extern record` declaration hasn't been lowered
        // yet (irRecords entry not appended). Diagnose instead of letting
        // irXRecSize's irRecordLayoutFieldsHead(-1) panic on irRecords[-1].
        recIdx = irFindRecordLayoutByName(typeNameIdx(t))
        if recIdx == -1 {
            emitDiag(line, col, "extern record " + poolGet(typeNameIdx(t)) + " is not declared before this use")
            return irArrType(irCharT, 0)
        }
        return irArrType(irCharT, irXRecSize(recIdx))
    }
    case TyArr { return irArrType(lowType(typeElem(t)), typeN(t)) }
    case TyList { return irListType(lowType(typeElem(t))) }
    case TyMap { return irMapType(lowType(typeElem(t))) }
    case TySortedMap { return irSortedMapType(lowType(typeElem(t))) }
    case TyIntMap { return irIntMapType(lowType(typeElem(t))) }
    case TyWindowRef { return irWinRefType(typeNameIdx(t)) }
    }
    // TyInvalid and the checker-only pseudo-kinds never reach a
    // checker-clean lowering (lower.go's lowerType panics here).
    return irVoidT
}

// lowResolveType maps an AST TypeExpr (ast.cla) directly to an IR type index
// -- a fused port of lower.go's resolveType + lowerType, used for the type
// annotations (params, `var`, fields) that never went through checkExpr and
// so have no exprTypeOf entry.
//
// A named type that isn't one of the five hardcoded scalars (record/enum/
// error/saveChoice, plus the host-unsupported resource types) resolves via
// curScope, exactly like check.cla's own resolveType -- unlike lower.go,
// which rebuilds an independent declTypes registry (check.Info doesn't
// export the Go checker's symbol table), this single-process self-hosted
// compiler never tears down curScope between checkProgram and lowerProgram
// (see main.cla), so the SAME topScope checkRecordDecl/checkEnumDecl/
// registerUniverse already populated is still there to read back.
func lowResolveType(tx: int): int {
    var nm: string
    var nameIdx: int
    var symIdx: int

    switch typeExprKind(tx) {
    case TxNamed {
        nameIdx = namedTypeName(tx)
        nm = poolGet(nameIdx)
        if nm == "int" {
            return irIntT
        } else if nm == "bool" {
            return irBoolT
        } else if nm == "fixed" {
            return irFixedT
        } else if nm == "char" {
            return irCharT
        } else if nm == "text" {
            return irTextT
        } else if nm == "ptr" {
            return irPtrT
        }
        symIdx = scopeLookup(curScope, nameIdx)
        if symIdx != -1 and symbols[symIdx].isType {
            // task-8: real position (tx, this named-type node) so a
            // forward-referenced `extern record` diagnoses at the `var`'s
            // own type annotation, not 0:0.
            return lowTypeAt(symbols[symIdx].typeIdx, typeExprLine(tx), typeExprCol(tx))
        }
        // check.Files already rejected an undefined type name; reaching
        // here on a checker-clean program would be a lowerer bug.
        return irIntT
    }
    case TxWord {
        // Task 4 (native-5e, Ch13): the ONLY place a TxWord TypeExpr ever
        // lowers to the distinct KWord IR type -- lowExternDecl calls
        // lowResolveType directly on each param/return TypeExpr (never
        // through lowType(checked-type), which would collapse it back to
        // plain int, per resolveType's own TxWord case in check.cla).
        return irWordT
    }
    case TxString {
        return irStrType(stringTypeN(tx))
    }
    case TxList {
        return irListType(lowResolveType(listTypeElem(tx)))
    }
    case TxMap {
        return irMapType(lowResolveType(mapTypeVal(tx)))
    }
    case TxSortedMap {
        return irSortedMapType(lowResolveType(sortedMapTypeVal(tx)))
    }
    case TxIntMap {
        return irIntMapType(lowResolveType(intMapTypeVal(tx)))
    }
    case TxArray {
        return irArrType(lowResolveType(arrayTypeElem(tx)), arrayTypeN(tx))
    }
    }
    return irIntT
}

// lowMustType returns e's IR type from the checker's recorded type
// (exprTypeGet, Task 1) -- lower.go's mustType. Threads e's own position
// into lowTypeAt (task-8) so an xrec-typed expression whose `extern
// record` hasn't been lowered yet (see lowTypeAt's doc comment) diagnoses
// at the USE site, not 0:0.
func lowMustType(e: int): int {
    return lowTypeAt(exprTypeGet(e), exprLine(e), exprCol(e))
}

// lowInternStr interns a string literal into the irStrLits pool, deduping by
// value, and returns its pool index (a StrConst's Idx) -- lower.go's
// internStr.
func lowInternStr(s: string): int {
    var idx: int

    if lowStrIdx.has(s) {
        return lowStrIdx.get(s, -1)
    }
    idx = irAddStrLit(intern(s))
    lowStrIdx[s] = idx
    return idx
}

// lowUnsupported reports that `lower` hit an AST construct Task 4+ hasn't
// implemented yet, and aborts -- so an unimplemented construct fails loudly
// (a clear message, non-zero exit) instead of either silently dropping the
// node (a stray -1 return that a caller ignores) or crashing later with an
// opaque arena-index error (a stray -1 dereferenced as an index). `lower`
// has no diagnostic-accumulation path of its own, so this reuses the same
// abort() machinery clarusc's own pipeline fatal sites use (attempt-abort
// phase Task 6: this used to be a bare `log(msg); quit 1` before that
// conversion -- the observable non-UI-default behavior is unchanged, see
// design doc %3.5, but the mechanism is no longer a direct process exit).
func lowUnsupported(what: string) {
    abort("clarusc emit: unsupported construct: " + what + " (not yet implemented)")
}

// ================================================================
// Expression lowering (expr.go subset)
// ================================================================

func lowExpr(e: int): int {
    var v: int

    switch exprKind(e) {
    case ExIntLit {
        return newIRIntConst(intLitVal(e), irIntT)
    }
    case ExBoolLit {
        v = 0
        if boolLitVal(e) {
            v = 1
        }
        return newIRIntConst(v, irBoolT)
    }
    case ExCharLit {
        return newIRIntConst(charLitVal(e), irCharT)
    }
    case ExFixedLit {
        return newIRIntConst(fixedLitRaw(e), irFixedT)
    }
    case ExStringLit {
        return newIRStrConst(lowInternStr(poolGet(stringLitIdx(e))), irStrType(255))
    }
    case ExUnary {
        return newIRUn(intern(unOpSymbol(unaryOp(e))), lowExpr(unaryX(e)), lowMustType(e))
    }
    case ExBinary {
        return lowBinary(e)
    }
    case ExCall {
        return lowCall(e)
    }
    case ExIdent {
        return lowIdent(e)
    }
    case ExIndex {
        return lowIndex(e)
    }
    case ExSlice {
        return lowSlice(e)
    }
    case ExSelect {
        return lowSelect(e)
    }
    case ExNew {
        return newIRNewRec(newExprTypeName(e), lowMustType(e))
    }
    case ExNilLit {
        // `nil`'s checked type is always the OTHER side's window/resource
        // type (checkNil/checkComparison -- see check.cla), so lowMustType
        // already resolves to the right KWinRef; a bare void* NULL always
        // prints as plain `0` in C regardless of which window type it's
        // compared against.
        return newIRIntConst(0, lowMustType(e))
    }
    case ExOpen {
        // `open W` used as an expression (Ch5: Open) -- `open W` as a bare
        // statement is StOpen (lowStmt), not this case.
        return newIRIntr(IUiOpen(), -1, irWinRefType(openExprWindowName(e)))
    }
    case ExWindowSelf {
        // The `window` keyword (Ch8: "the keyword window names the firing
        // instance") -- valid only inside a window-scoped handler body
        // (checkExprInner's ExWindowSelf case already rejects it elsewhere,
        // so lowCurWinType is always set here for a checker-clean program).
        return lowWinInstRef()
    }
    case ExAppConst {
        return lowAppConst(e)
    }
    }
    lowUnsupported("expression kind " + numToStr(int(exprKind(e))))
    return -1
}

// padTo4 space-pads s on the right to exactly 4 characters (native-gaps-
// cleanup Task 1, Part A padding rule) -- s is already checker-guaranteed
// <= 4 chars (checkAppDoctype: 1..4; checkAppId: exactly 4), so this only
// ever adds spaces, never truncates.
func padTo4(s: string): string {
    var r: string

    r = s
    while r.length < 4 {
        r = r + " "
    }
    return r
}

// lowArgAt walks argsHead's exprNext chain and returns the AST node at
// (0-based) index idx, or -1 past the end -- native-gaps-cleanup Task 2's
// literal-argument checks (below) need the RAW (pre-lowering) arg node to
// tell a genuine source-level string literal from anything else (an
// app.doctype/app.id ExAppConst or a const identifier are ALWAYS a legal
// <=4-char value by construction -- checkAppDoctype/checkAppId/
// declBuiltinStrConst already guarantee it -- so this deliberately only
// ever flags a literal ExStringLit; every other shape, including a
// genuinely dynamic expression, is left for the runtime pad/validate
// call to handle, per the design doc's "check/lower diagnostic for
// literals, runtime validate for dynamic strings" rule).
func lowArgAt(argsHead: int, idx: int): int {
    var a: int
    var i: int

    a = argsHead
    i = 0
    while i < idx and a != -1 {
        a = exprNext(a)
        i = i + 1
    }
    return a
}

// lowCheckLiteral4CCArg flags a source-level string literal (file.writeText/
// file.save's type/creator args) longer than 4 characters as a compile-time
// diagnostic -- native-gaps-cleanup Task 2's "LITERAL bad args are
// compile-time diagnostics" rule. what names the argument in the message
// ("file.writeText type", "file.save creator", ...). A non-literal arg
// (identifier, app.doctype/id, any other expression) is left untouched
// here -- it's validated at runtime instead (rtFourCC and its callers),
// uniformly for every lane.
func lowCheckLiteral4CCArg(argAst: int, what: string) {
    var s: string

    if argAst == -1 {
        return
    }
    if exprKind(argAst) != ExStringLit {
        return
    }
    s = poolGet(stringLitIdx(argAst))
    if s.length > 4 {
        emitDiag(exprLine(argAst), exprCol(argAst), what + " must be at most 4 characters")
    }
}

// lowCheckLiteralFilter is lowCheckLiteral4CCArg's askOpen counterpart:
// a LITERAL filter string (comma-separated 4-char codes, "*" = all files)
// is validated at compile time -- more than 4 entries, or any entry
// longer than 4 characters, is a diagnostic. A non-literal filter arg
// validates at runtime instead (uidialogs.cla's nat_UiSFGetFile /
// rt_ext_mac.inc's rt_ext_UiSFGetFile, both lanes).
func lowCheckLiteralFilter(argAst: int) {
    var s: string
    var i: int
    var segLen: int
    var nSeg: int

    if argAst == -1 {
        return
    }
    if exprKind(argAst) != ExStringLit {
        return
    }
    s = poolGet(stringLitIdx(argAst))
    if s == "*" {
        return
    }
    nSeg = 1
    segLen = 0
    i = 0
    while i < s.length {
        if s[i] == ',' {
            if segLen > 4 {
                emitDiag(exprLine(argAst), exprCol(argAst), "askOpen filter entry must be at most 4 characters")
                return
            }
            nSeg = nSeg + 1
            segLen = 0
        } else {
            segLen = segLen + 1
        }
        i = i + 1
    }
    if segLen > 4 {
        emitDiag(exprLine(argAst), exprCol(argAst), "askOpen filter entry must be at most 4 characters")
        return
    }
    if nSeg > 4 {
        emitDiag(exprLine(argAst), exprCol(argAst), "askOpen filter must have at most 4 entries")
    }
}

// lowAppConst lowers `app.doctype` / `app.id` (ExAppConst) straight to a
// padded STRING LITERAL IR node -- checkAppConstExpr already restricted
// the field name to "doctype" or "id", so this is total. Resolved
// entirely at compile time: irAppDoctype/irAppId are -1 when the program
// has no `app` section (or omits the field), which is when the
// "TEXT"/"????" defaults from the spec apply. After this, no backend
// (cprint/cg68k) knows app.doctype/app.id ever existed -- zero emission
// work, exactly like any other string literal.
func lowAppConst(e: int): int {
    var name: string
    var v: string

    name = poolGet(appConstField(e))
    if name == "doctype" {
        if irAppDoctype == -1 {
            v = "TEXT"
        } else {
            v = padTo4(poolGet(irAppDoctype))
        }
    } else {
        if irAppId == -1 {
            v = "????"
        } else {
            v = padTo4(poolGet(irAppId))
        }
    }
    return newIRStrConst(lowInternStr(v), irStrType(255))
}

// lowBin builds a plain IR Bin node (lower.go's l.bin): op is interned here
// so every call site hands it a bare source spelling from binOpSymbol/
// unOpSymbol, matching ir.cla's "Bin.Op/Un.Op are interned strPool strings"
// contract.
func lowBin(opSym: string, ty: int, xAst: int, yAst: int): int {
    return newIRBin(intern(opSym), lowExpr(xAst), lowExpr(yAst), ty)
}

// lowBin2Args lowers two AST expressions into a 2-element IR expr chain
// (lower.go's l.lowArgs applied to a 2-element Go slice) -- used for
// IFixMul/IFixDiv's Args, since a Binary node's X/Y are plain fields, not an
// AST arg-chain lowArgs can walk directly.
func lowBin2Args(xAst: int, yAst: int): int {
    var x: int
    var y: int

    x = lowExpr(xAst)
    y = lowExpr(yAst)
    irExprListAppend(x, y)
    return x
}

// lowBinary dispatches `+` (int/fixed stay Bin; string/text/char concat
// routes to the matching concat/prepend intrinsic by operand-kind combo),
// `*`/`/` (fixed routes to IFixMul/IFixDiv; int stays Bin), comparisons, and
// everything else (`-`, mod, bitwise, and/or), which all stay Bin -- a port
// of expr.go's lowerBinary.
func lowBinary(e: int): int {
    var op: int
    var ty: int
    var ltk: TypeKind
    var rtk: TypeKind
    var name: int

    op = binOp(e)
    ty = lowMustType(e)

    if op == OpAdd {
        ltk = typeKind(exprTypeGet(binLeft(e)))
        rtk = typeKind(exprTypeGet(binRight(e)))
        if ltk == TyStr and rtk == TyStr {
            return newIRIntr(IStrConcat(), lowBin2Args(binLeft(e), binRight(e)), ty)
        } else if ltk == TyStr and rtk == TyChar {
            return newIRIntr(IStrConcatChar(), lowBin2Args(binLeft(e), binRight(e)), ty)
        } else if ltk == TyText and (rtk == TyText or rtk == TyStr) {
            return newIRIntr(ITextConcat(), lowBin2Args(binLeft(e), binRight(e)), ty)
        } else if ltk == TyChar and rtk == TyStr {
            return newIRIntr(IStrPrependChar(), lowBin2Args(binLeft(e), binRight(e)), ty)
        } else if ltk == TyStr and rtk == TyText {
            return newIRIntr(ITextConcatSL(), lowBin2Args(binLeft(e), binRight(e)), ty)
        } else if ltk == TyStr or ltk == TyText or ltk == TyChar or rtk == TyStr or rtk == TyText or rtk == TyChar {
            // Every other string/text/char `+` combo is rejected by the
            // checker before lowering ever sees it.
            lowUnsupported("string/text/char + operand combo")
            return -1
        }
        return lowBin(binOpSymbol(op), ty, binLeft(e), binRight(e))
    } else if op == OpMul or op == OpDiv {
        if typeKind(exprTypeGet(binLeft(e))) == TyFixed {
            name = IFixMul()
            if op == OpDiv {
                name = IFixDiv()
            }
            return newIRIntr(name, lowBin2Args(binLeft(e), binRight(e)), ty)
        }
        return lowBin(binOpSymbol(op), ty, binLeft(e), binRight(e))
    } else if op == OpEq or op == OpNe or op == OpLt or op == OpLe or op == OpGt or op == OpGe {
        return lowComparison(e)
    }
    // "-", mod, &, |, ^, <<, >>, and, or.
    return lowBin(binOpSymbol(op), ty, binLeft(e), binRight(e))
}

// lowComparison lowers `== != < <= > >=`: a String/Text operand (either
// side) compares via the byte-wise cmp intrinsics wrapped as `<op> 0` (Text
// wins over String when mixed, since IStrCmp only knows fixed-capacity
// strings); everything else (int/fixed/char/bool/enum) stays a plain Bin
// comparison -- a port of expr.go's lowerComparison.
func lowComparison(e: int): int {
    var ltk: TypeKind
    var rtk: TypeKind
    var name: int
    var cmp: int
    var zero: int

    ltk = typeKind(exprTypeGet(binLeft(e)))
    rtk = typeKind(exprTypeGet(binRight(e)))
    if ltk == TyStr or ltk == TyText or rtk == TyStr or rtk == TyText {
        name = IStrCmp()
        if ltk == TyText or rtk == TyText {
            name = ITextCmp()
        }
        cmp = newIRIntr(name, lowBin2Args(binLeft(e), binRight(e)), irIntT)
        zero = newIRIntConst(0, irIntT)
        return newIRBin(intern(binOpSymbol(binOp(e))), cmp, zero, irBoolT)
    }
    return lowBin(binOpSymbol(binOp(e)), irBoolT, binLeft(e), binRight(e))
}

// lowWinInstRef builds a fresh IR reference to the CURRENTLY-lowered
// handler's hidden instance parameter (lowHandlerFunc always names it
// "window", Ch8's own keyword for exactly this value -- see that function's
// header comment) -- a new node every call, never a cached one, since an
// IRExpr's `next` slot can only ever link it into ONE argument chain (a
// shared node reused at two call sites would corrupt whichever chain lost
// the race). Only valid while lowCurWinType != -1.
func lowWinInstRef(): int {
    return newIRVarRef(intern("window"), false, irWinRefType(typeNameIdx(lowCurWinType)))
}

// lowWinHasCtorField (clarusc-ui-gaps Task 2) reports whether winType's
// per-instance state has ANY handle-backed var (irtNeedsCtor, ir.cla) --
// exactly the windows whose `opened` glue needs an IUiStateDefaults
// statement prepended. Linear scan over irWindowDescs by name, cheap given
// a program's handful of window types (same precedent as cprint.cla's
// cpFindWinHandlers).
func lowWinHasCtorField(winType: int): bool {
    var nameIdx: int
    var i: int
    var f: int

    nameIdx = typeNameIdx(winType)
    i = 0
    while i < irWindowDescs.count {
        if irWindowDescName(i) == nameIdx {
            f = irWindowDescStateFieldsHead(i)
            while f != -1 {
                if irtNeedsCtor(irFieldSlotType(f)) {
                    return true
                }
                f = irFieldSlotNext(f)
            }
            return false
        }
        i = i + 1
    }
    return false
}

// lowIsUnshadowedLastError reports whether nameIdx is the built-in global
// `lastError` -- as opposed to a local variable that happens to shadow that
// name -- the distinction lowIdent and lowSelect both need to route a
// `lastError`/`lastError.code`/`lastError.message` reference to the
// runtime's rt_lasterr_* globals instead of treating it as an ordinary
// error-typed variable (expr.go's isUnshadowedLastError).
func lowIsUnshadowedLastError(nameIdx: int): bool {
    return poolGet(nameIdx) == "lastError" and not lowIsLocal(nameIdx)
}

// lowBareWindowMemberRef resolves nm as a bare per-instance-var reference of
// the currently-lowered window-scoped handler (lowCurWinType), returning its
// lowered FieldRef, or -1 if nm doesn't name one (Ch8: "bare names resolve
// first against the firing instance's properties, fields"). Reads
// check.cla's own windowVarsHead/fieldInfos side table directly -- the SAME
// table lowWindowInstSelect already walks for the explicit `w.name` form; a
// bare `title` reference matches no fieldInfos entry (it's a synthetic
// windowScope symbol, not a real per-instance var) and so is deliberately
// NOT resolved by this function -- lowIdent's caller handles bare `title`
// as its own explicit case (IUiGetTitle, mac-target-4c Task 4b), matching
// lowWindowInstSelect's IUiGetTitle handling for the explicit form.
func lowBareWindowMemberRef(nm: int, ty: int): int {
    var winNameIdx: int
    var fh: int
    var stateExpr: int

    winNameIdx = typeNameIdx(lowCurWinType)
    fh = windowVarsHead.get(winNameIdx, -1)
    while fh != -1 {
        if poolGet(fieldInfos[fh].nameIdx) == poolGet(nm) {
            stateExpr = newIRIntr(IUiState(), lowWinInstRef(), irUiStateType(winNameIdx))
            return newIRFieldRef(stateExpr, nm, ty)
        }
        fh = fieldInfos[fh].next
    }
    return -1
}

// lowIdent lowers a resolved variable reference or a bare enum-member/const
// constant (check.cla's enumConstOf/constUseIsStr, keyed by e's own arena
// index, mirror Go's Info.EnumConsts/Info.Consts) -- a port of expr.go's
// lowerIdent. A bare, unshadowed `lastError` materializes an Err-record
// value via the ILastErr intrinsic instead of a VarRef, since there is no
// cv_lastError global to reference (see lowSelect's ErrorType case for the
// matching .code/.message read path). Task 5 adds: inside a window-scoped
// handler body, a bare per-instance-var name (lowBareWindowMemberRef) or the
// bare `title` (IUiGetTitle, mac-target-4c Task 4b -- rt_ui_get_title)
// resolve against the firing instance BEFORE the local/global fallback,
// mirroring windowScope's own scope-nesting order (Ch8: "bare names resolve
// first against the firing instance's properties, fields, and widgets, then
// against globals").
func lowIdent(e: int): int {
    var nm: int
    var global: bool
    var ty: int
    var key: int
    var winRef: int

    nm = identName(e)
    ty = lowMustType(e)
    key = e
    if enumConstOf.has(key) {
        return newIRIntConst(enumConstOf.get(key, 0), ty)
    }
    if constUseIsStr.has(key) {
        if intToBool(constUseIsStr.get(key, 0)) {
            return newIRStrConst(lowInternStr(constUseStr.get(key, "")), irStrType(255))
        }
        return newIRIntConst(constUseInt.get(key, 0), ty)
    }
    if lowIsUnshadowedLastError(nm) {
        return newIRIntr(ILastErr(), -1, ty)
    }
    if (not lowIsLocal(nm)) and lowCurWinType != -1 {
        winRef = lowBareWindowMemberRef(nm, ty)
        if winRef != -1 {
            return winRef
        }
        if poolGet(nm) == "title" {
            return newIRIntr(IUiGetTitle(), lowWinInstRef(), ty)
        }
    }
    global = not lowIsLocal(nm)
    return newIRVarRef(nm, global, ty)
}

// lowArgs lowers an AST argument chain (each linked via exprNext) into an IR
// expr chain (linked via irExprListAppend), returning the chain head (-1 if
// none).
func lowArgs(argsHead: int): int {
    var head: int
    var tail: int
    var a: int
    var le: int

    head = -1
    tail = -1
    a = argsHead
    while a != -1 {
        le = lowExpr(a)
        if head == -1 {
            head = le
        }
        tail = irExprListAppend(tail, le)
        a = exprNext(a)
    }
    return head
}

// lowIsValueKind reports whether t's IR type kind is a value kind (KStr,
// KRec, KArr) -- storage that lives inline in its container rather than
// behind a heap-reachable indirection (a KList/KMap/KText/KIntMap element
// or field). lowArgNeedsCopy's root-walk (below) treats stepping through
// anything else as leaving safely-borrowable storage.
func lowIsValueKind(t: int): bool {
    var k: IRKind

    k = irtKind(t)
    return k == KStr or k == KRec or k == KArr
}

// lowIntrIsNonOwningContainerRead (final-review fix wave: UAF fix) reports
// whether nm names a container-READ intrinsic whose result ALIASES the
// container's own stored element without transferring ownership out of it
// -- the element (and any handle field it carries) stays reachable through
// the container after the read, so if the callee re-enters the container
// past the call (e.g. removes the very key/index just read), a borrowed
// shallow copy's handle field would dangle. Exhaustive over every
// KRec-producing "read without removing" op across all three map kinds
// plus list: map/sortedmap/intmap get, get-with-default, and
// get-with-default-birth (the birth variant is a RUNTIME conditional --
// present-key returns the container's own value, absent-key returns a
// freshly birthed one -- but classification here is compile-time and must
// stay conservative for both branches; treating it as non-owning is safe
// either way, see lowArgNeedsCopy's own doc comment) -- and list first/last
// (read without removing, unlike pop/shift below). NOT included:
// list_pop/list_shift, which REMOVE the element and transfer ownership OUT
// of the list -- see lowIntrIsOwningContainerRead just below.
func lowIntrIsNonOwningContainerRead(nm: int): bool {
    if nm == IMapGet() or nm == IMapGetDv() or nm == IMapGetDvBirth() {
        return true
    }
    if nm == ISortedMapGet() or nm == ISortedMapGetDv() or nm == ISortedMapGetDvBirth() {
        return true
    }
    if nm == IIntMapGet() or nm == IIntMapGetDv() or nm == IIntMapGetDvBirth() {
        return true
    }
    return nm == IListFirst() or nm == IListLast()
}

// lowIntrIsOwningContainerRead (final-review fix wave) reports whether nm
// names a container-read intrinsic that REMOVES the element and transfers
// ownership out of the container (list_pop/list_shift -- the only two;
// no map/sortedmap/intmap kind has a remove-and-return op). These stay
// classified as borrow (lowArgNeedsCopy never marks them COPY -- nothing
// else can alias a just-removed element), but a bare pop/shift used
// directly as a call argument still needs its own release scheduled once
// the call returns (the popped/shifted handle is real and freshly owned,
// with no other owner) -- both backends (cprint.cla's fpCallFnArg,
// cg68k.cla's cgPushArgs) consult this to add release-only scheduling,
// mirroring how an ECallFn/ENewRec result is tracked.
func lowIntrIsOwningContainerRead(nm: int): bool {
    return nm == IListPop() or nm == IListShift()
}

// lowArgNeedsCopy classifies a KStr/KRec call-argument expression (param-abi
// phase, Task 3 -- spec doc's own borrow/copy table, single authority here):
// walk EFieldRef/EIndexRef wrappers toward the root, staying borrow only
// while every step's BASE stays value-typed (KStr/KRec/KArr) storage; a
// step through anything else (a KList/KMap/KText/KIntMap element or field)
// means the arg is reachable through container storage the callee could
// re-enter past the call, so it needs a COPY. At the root: a global
// EVarRef needs COPY (its storage outlives the call); a local/param
// EVarRef, an EStrConst, or any other rvalue temp (ECallFn, EConv,
// ENewRec, most EIntr, ...) borrows -- nothing else can alias a
// caller-local temporary during the callee's lifetime.
//
// final-review fix wave (UAF fix): ONE more root shape needs COPY --
// e's own type is a handle-bearing KRec (irRecHasHandleField -- a plain
// scalar record or a KStr result never aliases anything, so both are
// exempt) AND the walk's root is a bare, non-owning container-read EIntr
// (lowIntrIsNonOwningContainerRead: map/sortedmap/intmap get(_dv[_birth])
// or list first/last). That root's materialized temp is a SHALLOW copy --
// its handle field(s) still point at the SAME storage the container's
// element owns, so if the callee mutates the container past the call
// (e.g. `gm.remove(k)` on the very key just read), the borrowed handle
// dangles. The list-index-read path (EIndexRef over a KList base) already
// gets COPY from the walk loop above (KList is never a "value kind"); this
// closes the exact same hole for the map/sortedmap/intmap/list-first/last
// path, which lowers to a bare EIntr root instead of an EIndexRef. Owning
// reads (list_pop/list_shift, lowIntrIsOwningContainerRead) stay borrow --
// see that function's own doc comment for why, and for the release-only
// scheduling the backends still owe them.
func lowArgNeedsCopy(e: int): bool {
    var k: IRExprKind
    var cur: int
    var base: int
    var et: int

    et = irExprType(e)
    cur = e
    k = irExprKind(cur)
    while k == EFieldRef or k == EIndexRef {
        if k == EFieldRef {
            base = irFieldRefX(cur)
        } else {
            base = irIndexRefX(cur)
        }
        if not lowIsValueKind(irExprType(base)) {
            return true
        }
        cur = base
        k = irExprKind(cur)
    }
    if k == EIntr and irtKind(et) == KRec and irRecHasHandleField(irtName(et)) and lowIntrIsNonOwningContainerRead(irIntrName(cur)) {
        return true
    }
    if k == EVarRef {
        return irVarRefGlobal(cur)
    }
    return false
}

// lowCallArgs lowers a user function call's argument chain, coercing each arg
// through lowCoerceStr against the callee's DECLARED param IR type (read back
// from the checker's already-resolved FuncSig, whose signatures phase 1
// registered before any body -- so forward/mutual/self calls all resolve) so a
// `string(n)` param called with a wider-string arg clamps at the boundary --
// expr.go's lowerIdentCall user path.
//
// Task 4 (toolbox-integration Feature B) adds extern-record decay/Point-int
// coercion here, the ONE place both are legal (checkArgsCall's own rule):
// an xrec-typed argument passes its ADDRESS (lowXRecAddr, not lowExpr --
// there is no scalar "value" to read for a whole xrec) directly for a ptr
// param, or a peekl of that same address for an int param. checkArgsCall
// has already proven, on a checker-clean program, that an xrec-typed
// argument reaches lowCallArgs ONLY at an extern call (decay/coercion are
// both extern-only) and ONLY against a ptr or int param (any other
// pairing is a checker error) -- so no isExtern flag is needed here, and
// the `pt` checks below are exhaustive for this arg shape.
//
// isUserCall (param-abi phase, Task 3): true only for a real user-function
// (ECallFn) call -- lowArgNeedsCopy's borrow/copy classification is an
// ECallFn-only ABI concern (Tasks 5-6), so it must NOT run for an
// ECallExt (extern) call, whose ABI this phase leaves untouched.
func lowCallArgs(argsHead: int, sig: int, isUserCall: bool): int {
    var head: int
    var tail: int
    var a: int
    var i: int
    var le: int
    var pt: int
    var k: IRKind

    head = -1
    tail = -1
    a = argsHead
    i = 0
    while a != -1 {
        if typeKind(exprTypeGet(a)) == TyXRec {
            pt = -1
            if i < funcSigParamCount(sig) {
                pt = funcSigParam(sig, i)
            }
            if pt != -1 and typeKind(pt) == TyInt {
                le = newIRIntr(IPeekL(), lowXRecAddr(a), irIntT)
            } else {
                le = lowXRecAddr(a)
            }
        } else if typeKind(exprTypeGet(a)) == TyCallback {
            // Task 7 (toolbox-integration Feature C): checkArgsCall has
            // already proven, on a checker-clean program, that a
            // TyCallback-typed argument reaches lowCallArgs ONLY at an
            // extern call's ptr param (checkIdent's own
            // checkInExternPtrArgCtx-gated branch is the sole producer of
            // TyCallback) -- `a` is therefore always the bare ExIdent
            // naming the callback, so its own identName is the callback's
            // Name.
            le = newIRCbAddr(identName(a))
        } else {
            le = lowExpr(a)
            if i < funcSigParamCount(sig) {
                le = lowCoerceStr(lowType(funcSigParam(sig, i)), le)
            }
            if isUserCall {
                k = irtKind(irExprType(le))
                if (k == KStr or k == KRec) and lowArgNeedsCopy(le) {
                    irArgMarkCopy(le)
                }
            }
        }
        if head == -1 {
            head = le
        }
        tail = irExprListAppend(tail, le)
        a = exprNext(a)
        i = i + 1
    }
    return head
}

// lowCall lowers a bare-name call: a scalar conversion, alert/log, an
// enum's checked int->enum conversion (EnumName(i) -- resolved the same way
// lowResolveType resolves a named type, via curScope), or a method call.
// User function CALLS (and standalone top-level `func` DECLARATIONS, which
// this package doesn't lower at all yet) remain Task 9.
func lowCall(e: int): int {
    var fn: int
    var name: string
    var ty: int
    var symIdx: int

    fn = callFn(e)
    if exprKind(fn) == ExIdent {
        name = poolGet(identName(fn))
        ty = lowMustType(e)
        if name == "alert" {
            return newIRIntr(IAlert(), lowArgs(callArgsHead(e)), ty)
        } else if name == "abort" {
            // abort(msg) (attempt-abort phase Task 2, design doc %3.1) --
            // handled exactly like alert just above. lowUsesAbort is set
            // defensively here too (checkIdentCall's cnAbort arm already
            // set it during checking -- see that flag's own doc comment,
            // check.cla).
            lowUsesAbort = true
            return newIRIntr(IAbort(), lowArgs(callArgsHead(e)), ty)
        } else if name == "log" {
            // onlog phase: with an `on App.log` handler declared, a USER
            // `log(x)` lowers to a plain call to the synthesized
            // clar_app_fire_log dispatcher (lowSynthAppLog, below), which
            // does the raw persist FIRST and then fires the handler.
            // Everything else -- a runtime module's own `log()`, the
            // fail-closed lowSynthPanic tail below, cg68k/cprint's own
            // hand-emitted abort-default rt_log/natLog writes, and
            // nat_CorePanic's direct natLog call -- keeps building/emitting
            // the bare ILog intrinsic, so none of them can re-enter user
            // code. A program with no handler is byte-identical to before
            // this phase: same intrinsic, no extra function, no extra
            // global.
            if lowHasAppLog and not lowCurFnRuntimeOrigin {
                return newIRCallFn(intern("clar_app_fire_log"), lowArgs(callArgsHead(e)), ty)
            }
            return newIRIntr(ILog(), lowArgs(callArgsHead(e)), ty)
        } else if name == "peekb" {
            return newIRIntr(IPeekB(), lowArgs(callArgsHead(e)), ty)
        } else if name == "peekw" {
            return newIRIntr(IPeekW(), lowArgs(callArgsHead(e)), ty)
        } else if name == "peekl" {
            return newIRIntr(IPeekL(), lowArgs(callArgsHead(e)), ty)
        } else if name == "pokeb" {
            return newIRIntr(IPokeB(), lowArgs(callArgsHead(e)), ty)
        } else if name == "pokew" {
            return newIRIntr(IPokeW(), lowArgs(callArgsHead(e)), ty)
        } else if name == "pokel" {
            return newIRIntr(IPokeL(), lowArgs(callArgsHead(e)), ty)
        } else if name == "int" {
            return lowIntConv(e, ty)
        } else if name == "fixed" {
            return newIRConv(CvIntToFixed, lowExpr(callArgsHead(e)), -1, ty)
        } else if name == "char" {
            return newIRConv(CvIntToChar, lowExpr(callArgsHead(e)), -1, ty)
        } else if name == "ptr" {
            return lowPtrConv(e, ty)
        } else if name == "askOpen" {
            // askOpen(path, types) -- native-gaps-cleanup Task 2: types is
            // a literal-checked filter string (lowCheckLiteralFilter,
            // below); a dynamic (non-literal) filter validates at
            // runtime instead (uidialogs.cla's nat_UiSFGetFile /
            // rt_ext_mac.inc's rt_ext_UiSFGetFile).
            lowCheckLiteralFilter(lowArgAt(callArgsHead(e), 1))
            return newIRIntr(IUiAskOpen(), lowArgs(callArgsHead(e)), ty)
        } else if name == "askSave" {
            return newIRIntr(IUiAskSave(), lowArgs(callArgsHead(e)), ty)
        } else if name == "askSaveChanges" {
            return newIRIntr(IUiAskSaveChanges(), lowArgs(callArgsHead(e)), ty)
        } else if name == "now" {
            return newIRCallFn(intern("rtNow"), -1, ty)
        } else if name == "dateTimeStr" {
            symIdx = scopeLookup(curScope, identName(fn))
            return newIRCallFn(intern("rtDateTimeStr"), lowCallArgs(callArgsHead(e), symbols[symIdx].sigIdx, true), ty)
        } else if name == "durationStr" {
            symIdx = scopeLookup(curScope, identName(fn))
            return newIRCallFn(intern("rtDurationStr"), lowCallArgs(callArgsHead(e), symbols[symIdx].sigIdx, true), ty)
        }
        symIdx = scopeLookup(curScope, identName(fn))
        if symIdx != -1 and symbols[symIdx].isType and typeKind(symbols[symIdx].typeIdx) == TyEnum {
            return newIRConv(CvIntToEnum, lowExpr(callArgsHead(e)), identName(fn), ty)
        }
        if symIdx != -1 and symbols[symIdx].isType and typeKind(symbols[symIdx].typeIdx) == TyOverlay {
            // `OverlayName(p)` (Ch13: Overlay Records) -- checkConversion
            // already required p: ptr; ty (lowMustType(e)) is the overlay
            // type itself, carrying the target name fpConv's CvPtrToOverlay
            // case reads back off the EConv node's own `ty`.
            return newIRConv(CvPtrToOverlay, lowExpr(callArgsHead(e)), -1, ty)
        }
        if symIdx != -1 and irIsExtern(identName(fn)) {
            return newIRCallExt(identName(fn), lowCallArgs(callArgsHead(e), symbols[symIdx].sigIdx, false), ty)
        }
        if symIdx != -1 and symbols[symIdx].isFunc {
            return newIRCallFn(identName(fn), lowCallArgs(callArgsHead(e), symbols[symIdx].sigIdx, true), ty)
        }
        lowUnsupported("call to " + name)
        return -1
    } else if exprKind(fn) == ExSelect {
        return lowMethodCall(e, fn)
    }
    lowUnsupported("call target")
    return -1
}

// lowMethodCall dispatches `x.name(args)` by the receiver's kind (expr.go's
// lowerMethodCall, reduced to the String/Text/List/Map receivers -- file
// receivers are Task 6+).
func lowMethodCall(e: int, fn: int): int {
    var ty: int
    var xk: TypeKind
    var recv: int

    ty = lowMustType(e)
    if exprKind(selectX(fn)) == ExIdent and poolGet(identName(selectX(fn))) == "file" {
        return lowFileCall(e, fn, ty)
    }
    xk = typeKind(exprTypeGet(selectX(fn)))
    if xk == TyWidget {
        // Canvas drawing (Ch11): selectX(fn) is itself a widget-select
        // (`w.Board`), never lowered as a standalone value -- lowCanvasMethod
        // peels both levels itself, same as lowWidgetPropGet does for a
        // property read, so recv is never computed generically here.
        return lowCanvasMethod(e, fn, ty)
    }
    if xk == TyConnection {
        // Connection methods (serial-connection phase, Task 5): the
        // receiver is never lowered to a real IR value (see
        // lowGlobalVarDecl's own comment) -- lowConnMethod resolves it
        // straight to a compile-time slot number instead, so this must
        // return BEFORE the generic `recv = lowExpr(...)` line below ever
        // runs, exactly like the TyWidget case just above.
        return lowConnMethod(e, fn, ty, xk)
    }
    recv = lowExpr(selectX(fn))
    if xk == TyStr or xk == TyText {
        return lowStringTextMethod(recv, xk == TyText, fn, callArgsHead(e), ty)
    } else if xk == TyList {
        return lowListMethod(recv, fn, callArgsHead(e), ty)
    } else if xk == TyMap {
        return lowMapMethod(recv, fn, callArgsHead(e), ty, false, false)
    } else if xk == TySortedMap {
        return lowMapMethod(recv, fn, callArgsHead(e), ty, true, false)
    } else if xk == TyIntMap {
        return lowMapMethod(recv, fn, callArgsHead(e), ty, false, true)
    }
    lowUnsupported("method call on receiver kind " + numToStr(int(xk)))
    return -1
}

// lowConnCoerceArg reads target Clarus function fnName's own DECLARED
// param type back off its checker-registered signature (scopeLookup +
// sigIdx -- the same source lowCallArgs' own per-arg loop reads) and
// coerces argAst's lowered value against it via lowCoerceStr -- the same
// per-arg treatment an ordinary user call gets, just indexed by hand
// since a connection call's real arg list is a compile-time slot number
// (or two) PREPENDED ahead of the one AST argument the user actually
// wrote, not a straight lowering of callArgsHead(e).
func lowConnCoerceArg(fnName: string, paramIdx: int, argAst: int): int {
    var symIdx: int

    symIdx = scopeLookup(curScope, intern(fnName))
    return lowCoerceStr(lowType(funcSigParam(symbols[symIdx].sigIdx, paramIdx)), lowExpr(argAst))
}

// lowConnMethod dispatches `connVar.open/send/close(...)` (serial-
// connection phase, Task 5) to the matching rtConn* runtime call, slot
// number substituted for the receiver. Only a BARE global connection-var
// receiver (its name present in lowConnSlotOf AND not shadowed by a
// lowering-local of the same name -- lowIsLocal, final-review Important 2;
// see lowConnSlotOf's own doc comment for why a scopeLookup-based symbol
// resolution can't do this job here) reaches a real lowering here; and
// for `open`, only the `serial` transport tag (callTransport(e) == 2)
// does. Every other shape this method-call node can take on a
// checker-clean program -- a local/field/array-element connection
// receiver (never added to lowConnSlotOf), a local that SHADOWS a global
// connection var of the same name (lowIsLocal excludes it even though
// the name IS in the map), `open` with no transport prefix, the
// `appletalk` prefix, or a resolved `address` argument (all legal per
// connectionMethods' own signature, just not implemented yet) -- falls
// through to the exact SAME generic not-yet-implemented diagnostic
// lowMethodCall's own fallback produces for an unhandled receiver kind
// (brief: "EXACTLY as today"), since xk == TyConnection either way.
// Task 6 lifts the `not want68k` gate this function used to carry (Task
// 4/5: rtConnOpen/etc. were host-lane-only symbols, drive.cla's own `if
// usesConn and not want68k`) -- drive.cla now splices conn.cla +
// conn_68k.cla unconditionally under want68k, so
// rtConnOpen/rtConnSendText/rtConnSendStr/rtConnClose exist as declared
// symbols on every native build too, and this method-call lowering runs
// identically on both lanes now.
func lowConnMethod(e: int, fn: int, ty: int, xk: TypeKind): int {
    var recvExpr: int
    var name: string
    var slot: int
    var argsHead: int
    var args: int
    var tail: int

    recvExpr = selectX(fn)
    slot = -1
    if exprKind(recvExpr) == ExIdent and not lowIsLocal(identName(recvExpr)) {
        slot = lowConnSlotOf.get(poolGet(identName(recvExpr)), -1)
    }
    name = poolGet(selectName(fn))
    argsHead = callArgsHead(e)

    if slot != -1 and name == "open" and callTransport(e) == 2 {
        args = newIRIntConst(slot, irIntT)
        tail = irExprListAppend(args, newIRIntConst(2, irIntT))
        irExprListAppend(tail, lowConnCoerceArg("rtConnOpen", 2, argsHead))
        return newIRCallFn(intern("rtConnOpen"), args, irVoidT)
    }
    if slot != -1 and name == "send" {
        args = newIRIntConst(slot, irIntT)
        if typeKind(exprTypeGet(argsHead)) == TyText {
            irExprListAppend(args, lowConnCoerceArg("rtConnSendText", 1, argsHead))
            return newIRCallFn(intern("rtConnSendText"), args, irVoidT)
        }
        irExprListAppend(args, lowConnCoerceArg("rtConnSendStr", 1, argsHead))
        return newIRCallFn(intern("rtConnSendStr"), args, irVoidT)
    }
    if slot != -1 and name == "close" {
        return newIRCallFn(intern("rtConnClose"), newIRIntConst(slot, irIntT), irVoidT)
    }
    // xk (this function's own 4th param, the caller's already-computed
    // receiver kind) is what lowMethodCall's own fallback reports for
    // every OTHER unhandled receiver kind -- ty is the CALL's result
    // type, not the receiver's, and must not be substituted here.
    lowUnsupported("method call on receiver kind " + numToStr(int(xk)))
    return -1
}

// LowWidgetRecv carries the resolved (instance IR value, window TYPE
// name index, widget name) triple for a widget-typed receiver expression
// -- lowCanvasMethod/lowWidgetPropGet/lowWidgetSetAssign, wired against
// lowWidgetRecv below. winNameIdx (Task 6, layer1-compiler-perf: was
// winName: string) is the window type's own interned name index --
// lowWidgetRecv always had this int already (typeNameIdx(...)) before
// wrapping it in poolGet, so storing it directly here drops that
// round-trip for every one of this record's three consumers below.
record LowWidgetRecv {
    instIR: int
    winNameIdx: int
    wgName: string
}

// lowWidgetRecv resolves a widget-typed receiver expression (typeKind ==
// TyWidget), which is either the explicit `w.Widget` shape (ExSelect; w's
// own type names the window -- Task 4's original, only-supported form) or,
// inside a window-scoped handler body, the bare `Widget` shape windowScope
// resolves directly (Ch8: "bare names resolve first against the firing
// instance's ... widgets"): an ExIdent with no explicit instance
// sub-expression to peel at all, since IT IS the widget-select in the
// caller's eyes (recvAst IS what Task 4's callers named `wgSel`/`instAst`'s
// combined shape) -- the implicit instance is the handler's own hidden
// `window` value (lowWinInstRef) instead. Every one of Task 4's three
// widget-receiver call sites (lowCanvasMethod, lowWidgetPropGet,
// lowWidgetSetAssign) peeled this exact shape inline; Task 5 centralizes it
// here since all three need the identical bare-vs-explicit branch.
func lowWidgetRecv(recvAst: int): LowWidgetRecv {
    var r: LowWidgetRecv

    if exprKind(recvAst) == ExSelect {
        r.instIR = lowExpr(selectX(recvAst))
        r.winNameIdx = typeNameIdx(exprTypeGet(selectX(recvAst)))
        r.wgName = poolGet(selectName(recvAst))
    } else {
        r.instIR = lowWinInstRef()
        r.winNameIdx = typeNameIdx(lowCurWinType)
        r.wgName = poolGet(identName(recvAst))
    }
    return r
}

// lowCanvasMethod lowers `w.Board.name(args)` (Ch11: Drawing) -- fn is the
// method select (`w.Board.name`); selectX(fn) (`w.Board`) is the
// widget-select, peeled directly for the instance + widget index exactly
// like lowWidgetPropGet's TyWidget case. `rect`/`fillRect` are Clarus's two
// distinct method names for rt_ui_canvas_rect's single runtime function
// (see rt_ui.h's own comment on this collapse) -- the trailing fill literal
// (0/1) is picked here by WHICH method was called, never exposed as a
// Clarus-level argument.
func lowCanvasMethod(e: int, fn: int, ty: int): int {
    var wgSel: int
    var recv: LowWidgetRecv
    var widgetIdx: int
    var head: int
    var tail: int
    var nm: string
    var intrName: int
    var a: int
    var fillLit: int

    wgSel = selectX(fn)
    recv = lowWidgetRecv(wgSel)
    widgetIdx = uiWidgetIndex(recv.winNameIdx, recv.wgName)

    nm = poolGet(selectName(fn))
    intrName = -1
    fillLit = -1
    if nm == "clear" {
        intrName = IUiCanvasClear()
    } else if nm == "line" {
        intrName = IUiCanvasLine()
    } else if nm == "rect" {
        intrName = IUiCanvasRect()
        fillLit = 0
    } else if nm == "fillRect" {
        intrName = IUiCanvasRect()
        fillLit = 1
    } else if nm == "circle" {
        intrName = IUiCanvasCircle()
    } else if nm == "fillCircle" {
        intrName = IUiCanvasFillCircle()
    } else if nm == "pattern" {
        intrName = IUiCanvasPattern()
    } else if nm == "drawText" {
        intrName = IUiCanvasDrawText()
    } else {
        lowUnsupported("canvas method " + nm)
        return -1
    }

    head = recv.instIR
    tail = irExprListAppend(head, newIRIntConst(widgetIdx, irIntT))
    a = callArgsHead(e)
    while a != -1 {
        tail = irExprListAppend(tail, lowExpr(a))
        a = exprNext(a)
    }
    if fillLit != -1 {
        tail = irExprListAppend(tail, newIRIntConst(fillLit, irBoolT))
    }
    return newIRIntr(intrName, head, ty)
}

// lowFileCall lowers `file.fn(args)` (expr.go's lowerFileCall): readText/
// writeText/name are host-supported and map to the matching file intrinsics;
// save/load (Task 2, mac-target-4d) resolve the record type reached through
// data's checker type (TyRec directly, or the elem of TyList/TyMap -- the
// only shapes checkParamArg's AnyRecordish accepts), run the value-field
// guard over it, register it for cpEmitLayouts, and lower to the matching
// intrinsic. Both share one arg-lowering call (lowArgs), same as the three
// host-supported cases above -- the container tag and layout name cprint
// needs are read back off the data arg's own IR type at print time (see
// ir.cla's IFileSave/IFileLoad doc comment), never carried as extra args
// here.
func lowFileCall(e: int, fn: int, ty: int): int {
    var nm: string
    var dataAst: int
    var xt: int
    var recNameIdx: int
    var intrName: int

    nm = poolGet(selectName(fn))
    if nm == "readText" {
        return newIRIntr(IFileReadText(), lowArgs(callArgsHead(e)), ty)
    } else if nm == "writeText" {
        // file.writeText(path, text, type, creator) -- native-gaps-
        // cleanup Task 2: type/creator are mandatory, literal-checked
        // (lowCheckLiteral4CCArg) here; a dynamic (non-literal) value
        // validates at runtime instead (rtFourCC/natFileWriteText,
        // rt_mac.c's rt_file_write_text).
        lowCheckLiteral4CCArg(lowArgAt(callArgsHead(e), 2), "file.writeText type")
        lowCheckLiteral4CCArg(lowArgAt(callArgsHead(e), 3), "file.writeText creator")
        return newIRIntr(IFileWriteText(), lowArgs(callArgsHead(e)), ty)
    } else if nm == "readResource" {
        return newIRIntr(IFileReadResource(), lowArgs(callArgsHead(e)), ty)
    } else if nm == "writeRes" {
        // file.writeRes(path, fork, doctype, creator) -- Task 7: same
        // mandatory-literal-length validation as writeText above.
        lowCheckLiteral4CCArg(lowArgAt(callArgsHead(e), 2), "file.writeRes doctype")
        lowCheckLiteral4CCArg(lowArgAt(callArgsHead(e), 3), "file.writeRes creator")
        return newIRIntr(IFileWriteRes(), lowArgs(callArgsHead(e)), ty)
    } else if nm == "name" {
        return newIRIntr(IFileName(), lowArgs(callArgsHead(e)), ty)
    } else if nm == "save" or nm == "load" {
        dataAst = exprNext(callArgsHead(e))
        xt = exprTypeGet(dataAst)
        if typeKind(xt) == TyRec {
            recNameIdx = typeNameIdx(xt)
        } else {
            recNameIdx = typeNameIdx(typeElem(xt))
        }
        lowCheckSerializableFields(recNameIdx, "file." + nm)
        irMarkLayoutNeeded(recNameIdx)
        intrName = IFileSave()
        if nm == "load" {
            intrName = IFileLoad()
        } else {
            // file.save(path, rec, type, creator) -- same Task 2 rule as
            // writeText above; file.load stays 2-arg (no type/creator).
            lowCheckLiteral4CCArg(lowArgAt(callArgsHead(e), 2), "file.save type")
            lowCheckLiteral4CCArg(lowArgAt(callArgsHead(e), 3), "file.save creator")
        }
        return newIRIntr(intrName, lowArgs(callArgsHead(e)), ty)
    }
    lowUnsupported("file." + nm)
    return -1
}

// lowCheckSerializableFields is the value-field guard shared by file.save/
// load (Ch12: "every field of the record ... must be a by-value type"; a
// `text`, `list`, or `map` field is a build-time error) and a table
// widget's row record (mac-target-4d Task 5: a table's row reaches this
// same cpEmitLayouts registry, so the identical invariant applies -- see
// cpFieldDescRow's own comment on why every field reaching cpEmitLayouts
// MUST already be a value type). Walks ONLY the record's own fields, one
// level deep -- a nested-record field is rejected outright (TyRec isn't in
// the allow-list below) rather than recursed into, and likewise a
// fixed-array field (TyArr), because rt.h's rt_field_desc (Task 1) has no
// RT_FT_* encoding for either shape, so neither is serializable yet
// regardless of what it itself contains. Reuses the exact recordFieldsHead/
// fieldInfos walk lowRecordDecl (:2000ish above) already established for
// reading back check.cla's field-layout side table. ctx prefixes the
// diagnostic ("file.save"/"file.load"/"table rows") -- callers pass their
// own already-composed context string rather than a bare op name, so this
// function stays reusable across both call sites' differently-shaped
// messages.
func lowCheckSerializableFields(recNameIdx: int, ctx: string) {
    var fi: int
    var ft: int
    var k: TypeKind

    fi = recordFieldsHead(recNameIdx)
    while fi != -1 {
        ft = fieldInfos[fi].typeIdx
        k = typeKind(ft)
        if not (k == TyInt or k == TyBool or k == TyFixed or k == TyChar or k == TyStr or k == TyEnum) {
            lowUnsupported(ctx + ": record " + poolGet(recNameIdx) + " field " + poolGet(fieldInfos[fi].nameIdx) + " is not a value type")
        }
        fi = fieldInfos[fi].next
    }
}

// lowListMethod lowers `l.name(args)` for a List receiver (expr.go's
// lowerListMethod): add/push/unshift route the value through lowCoerceStr
// against the list's OWN element type (recv's elem, not `ty` -- push/
// unshift both return void) before chaining it onto recv, since the
// checker's compatible() accepts any Str capacity against elem but
// IListPush/IListUnshift's C printer copies the value's OWN struct type,
// sized to fit the list's declared element size.
//
// ARC Task 5: add/push/unshift additionally pick the *Retain intrinsic
// variant whenever the value is NON-birth (lowElemIsBirth false) and the
// element kind is heap-tracked -- the SAME retain-unless-birth rule Task 4
// established for named-slot stores (lowCountedStore), now applied to
// container element slots: the container is a counted owner, so a
// non-birth push needs its own +1 (cprint.cla's shared IListPush(Retain)/
// IListUnshift(Retain) printer branch emits it). Birth classification runs
// on rawV (argsHead lowered but NOT yet coerced), mirroring
// lowCountedStore's own src-before-coercion timing -- lowCoerceStr's
// Str->Text override is folded into lowElemIsBirth itself, same as
// lowCountedStore's.
func lowListMethod(recv: int, sel: int, argsHead: int, ty: int): int {
    var nm: string
    var elemT: int
    var rawV: int
    var v: int
    var pushName: int
    var unshiftName: int

    nm = poolGet(selectName(sel))
    if nm == "add" or nm == "push" {
        elemT = irtElem(irExprType(recv))
        rawV = lowExpr(argsHead)
        pushName = IListPush()
        // ARC Task 7 site 4: a record-bearing element type mirrors site 1's
        // own birth rule (lowRecStoreIsBirth), never lowElemIsBirth's
        // Text/List/Map rule (which trusts ANY call, including a container
        // method read like `.first()` -- not yet retain-on-read-safe for
        // record elements; see lowRecStoreIsBirth's own doc comment).
        // Mutually exclusive with the Text/List/Map branch (lowIsRecBearing
        // is only ever true where lowEscapeTrackableKind is false).
        // memory-leak-fix phase, fix round 2: lowArrHeapScalarBearing
        // (a fixed array whose innermost element is Text/List/Map, e.g.
        // `text[3]`) joins lowIsRecBearing in this SAME branch -- an
        // array's element type is never simultaneously rec-bearing AND
        // heap-scalar-bearing (lowIsRecBearing/lowArrHeapScalarBearing's
        // own KRec-vs-lowEscapeTrackableKind split is mutually exclusive
        // at the innermost element), so combining them here can never
        // double-fire; lowRecStoreIsBirth is the right birth check for
        // BOTH (it's a pure AST-shape check -- ExCall to ExIdent/pop/shift
        // -- not actually record-specific despite its name; see its own
        // doc comment). Before this fix, a whole array-of-Text/List/Map
        // VALUE pushed onto a container was never retained at all --
        // silent under-retention that a correct element-release walk
        // (memory-leak-fix Tasks 4/5) then double-releases against the
        // source array's own scope-exit release (fix round 2's own
        // over-release regression, confirmed by hand-probe).
        if lowEscapeTrackableKind(irtKind(elemT)) and not lowElemIsBirth(argsHead, rawV, elemT) {
            pushName = IListPushRetain()
        } else if (lowIsRecBearing(elemT) or lowArrHeapScalarBearing(elemT)) and not lowRecStoreIsBirth(argsHead) {
            pushName = IListPushRetain()
        }
        v = lowCoerceStr(elemT, rawV)
        irExprListAppend(recv, v)
        return newIRIntr(pushName, recv, ty)
    } else if nm == "unshift" {
        elemT = irtElem(irExprType(recv))
        rawV = lowExpr(argsHead)
        unshiftName = IListUnshift()
        // memory-leak-fix phase, fix round 2: same combined predicate as
        // push/add above.
        if lowEscapeTrackableKind(irtKind(elemT)) and not lowElemIsBirth(argsHead, rawV, elemT) {
            unshiftName = IListUnshiftRetain()
        } else if (lowIsRecBearing(elemT) or lowArrHeapScalarBearing(elemT)) and not lowRecStoreIsBirth(argsHead) {
            unshiftName = IListUnshiftRetain()
        }
        v = lowCoerceStr(elemT, rawV)
        irExprListAppend(recv, v)
        return newIRIntr(unshiftName, recv, ty)
    } else if nm == "pop" {
        return newIRIntr(IListPop(), recv, ty)
    } else if nm == "shift" {
        return newIRIntr(IListShift(), recv, ty)
    } else if nm == "first" {
        return newIRIntr(IListFirst(), recv, ty)
    } else if nm == "last" {
        return newIRIntr(IListLast(), recv, ty)
    } else if nm == "remove" {
        return newIRIntr(IListRemove(), lowMethodArgs2(recv, argsHead), ty)
    } else if nm == "count" {
        return newIRIntr(IListCount(), recv, ty)
    } else if nm == "clear" {
        // memory-leak-fix phase Task 4: a ref-bearing element type needs
        // its whole current population released before the O(1) hard
        // reset -- same predicate trio the scope-exit release walk uses
        // (lowFreeAt), applied to the ELEMENT type instead of a whole
        // local. Scalar elements keep the plain O(1) reset unchanged.
        elemT = irtElem(irExprType(recv))
        if lowEscapeTrackableKind(irtKind(elemT)) or lowIsRecBearing(elemT) or lowArrHeapScalarBearing(elemT) {
            return newIRIntr(IListClearDeep(), recv, ty)
        }
        return newIRIntr(IListClear(), recv, ty)
    } else if nm == "clone" {
        // clir-load-perf: arity 0, same shape as count/clear above --
        // check.cla's own "clone" arm already restricted the element type
        // to flat (no text/list/map anywhere), so no birth/retain
        // classification is needed here the way push/unshift/clear need.
        return newIRIntr(IListClone(), recv, ty)
    }
    lowUnsupported("list method " + nm)
    return -1
}

// lowMapMethod lowers `m.name(args)` for a Map, SortedMap, OR IntMap
// receiver (expr.go's lowerMapMethod), parameterized by `sorted`/`im` so
// the three families share one implementation instead of three
// provably-identical copies (mirrors cg68k.cla's own cgIntrMapGet/etc.
// parameterization): at most one of sorted/im is true (map is neither).
// get's default-value argument goes through lowCoerceStr against the
// map's elem type for the same reason list push's value arg does --
// IMapGetDv's C printer pre-fills its result temp with a plain `=`
// from the default, which requires the default's own C struct type to
// already match. The KEY itself (string for map/sortedmap, int for
// intmap) needs no such coercion -- lowExpr's own result already matches
// the runtime's expected shape for either key type.
func lowMapMethod(recv: int, sel: int, argsHead: int, ty: int, sorted: bool, im: bool): int {
    var nm: string
    var key: int
    var dv: int
    var dvAst: int
    var rawDv: int
    var elemT: int
    var getName: int
    var hasName: int
    var removeName: int
    var countName: int
    var clearName: int
    var clearDeepName: int

    nm = poolGet(selectName(sel))
    if im {
        hasName = IIntMapHas()
        removeName = IIntMapRemove()
        countName = IIntMapCount()
        clearName = IIntMapClear()
        clearDeepName = IIntMapClearDeep()
    } else if sorted {
        hasName = ISortedMapHas()
        removeName = ISortedMapRemove()
        countName = ISortedMapCount()
        clearName = ISortedMapClear()
        clearDeepName = ISortedMapClearDeep()
    } else {
        hasName = IMapHas()
        removeName = IMapRemove()
        countName = IMapCount()
        clearName = IMapClear()
        clearDeepName = IMapClearDeep()
    }
    if nm == "get" {
        elemT = irtElem(irExprType(recv))
        key = lowExpr(argsHead)
        dvAst = exprNext(argsHead)
        rawDv = lowExpr(dvAst)
        // ARC Task 8 fix (known open leak bug 2): IMapGetDv vs
        // IMapGetDvBirth, chosen exactly like lowListMethod picks
        // IListPush vs IListPushRetain above -- lowElemIsBirth is the SAME
        // birth-vs-retain rule every other counted store site uses,
        // applied here to the DEFAULT-VALUE argument. See
        // IMapGetDvBirth's own ir.cla doc comment for why a birth default
        // needs different (and currently missing) retain/release handling
        // than a non-birth one.
        if im {
            getName = IIntMapGetDv()
        } else if sorted {
            getName = ISortedMapGetDv()
        } else {
            getName = IMapGetDv()
        }
        if lowEscapeTrackableKind(irtKind(elemT)) and lowElemIsBirth(dvAst, rawDv, elemT) {
            if im {
                getName = IIntMapGetDvBirth()
            } else if sorted {
                getName = ISortedMapGetDvBirth()
            } else {
                getName = IMapGetDvBirth()
            }
        }
        dv = lowCoerceStr(elemT, rawDv)
        irExprListAppend(recv, key)
        irExprListAppend(key, dv)
        return newIRIntr(getName, recv, ty)
    } else if nm == "has" {
        return newIRIntr(hasName, lowMethodArgs2(recv, argsHead), ty)
    } else if nm == "remove" {
        return newIRIntr(removeName, lowMethodArgs2(recv, argsHead), ty)
    } else if nm == "count" {
        return newIRIntr(countName, recv, ty)
    } else if nm == "clear" {
        // memory-leak-fix phase Task 4: dispatch on the VALUE type
        // (lowListMethod's own "clear" doc comment applies unchanged) --
        // keys are inline strings, never released, so only the value type
        // matters here.
        elemT = irtElem(irExprType(recv))
        if lowEscapeTrackableKind(irtKind(elemT)) or lowIsRecBearing(elemT) or lowArrHeapScalarBearing(elemT) {
            return newIRIntr(clearDeepName, recv, ty)
        }
        return newIRIntr(clearName, recv, ty)
    }
    lowUnsupported("map method " + nm)
    return -1
}

// lowMethodArgs2 chains an already-lowered receiver IR expr with one
// freshly-lowered AST argument, returning the chain head (recvIR) -- the
// mixed-source counterpart to lowBin2Args/lowArgs, needed because a method
// call's receiver is lowered once up front (lowMethodCall) while its
// arguments are still raw AST nodes.
func lowMethodArgs2(recvIR: int, a0Ast: int): int {
    var a: int

    a = lowExpr(a0Ast)
    irExprListAppend(recvIR, a)
    return recvIR
}

// lowMethodArgs3 is lowMethodArgs2 for a 2-argument method call (fromBytes).
func lowMethodArgs3(recvIR: int, a0Ast: int, a1Ast: int): int {
    var a: int
    var b: int

    a = lowExpr(a0Ast)
    b = lowExpr(a1Ast)
    irExprListAppend(recvIR, a)
    irExprListAppend(a, b)
    return recvIR
}

// lowMethodArgs4 is lowMethodArgs3 for a 3-argument method call (hashStep,
// clir-load-perf Task 2).
func lowMethodArgs4(recvIR: int, a0Ast: int, a1Ast: int, a2Ast: int): int {
    var a: int
    var b: int
    var c: int

    a = lowExpr(a0Ast)
    b = lowExpr(a1Ast)
    c = lowExpr(a2Ast)
    irExprListAppend(recvIR, a)
    irExprListAppend(a, b)
    irExprListAppend(b, c)
    return recvIR
}

// lowStringTextMethod lowers `.fromBytes`/`.toBytes`/`.indexOf`/`.append` on
// a String or Text receiver (expr.go's lowerStringTextMethod).
func lowStringTextMethod(recv: int, isText: bool, sel: int, argsHead: int, ty: int): int {
    var nm: string
    var name: int
    var arg0: int
    var arg1: int
    var arg2: int

    nm = poolGet(selectName(sel))
    arg0 = argsHead
    if nm == "fromBytes" {
        arg1 = exprNext(arg0)
        name = IStrFromBytes()
        if isText {
            name = ITextFromBytes()
        }
        return newIRIntr(name, lowMethodArgs3(recv, arg0, arg1), ty)
    } else if nm == "toBytes" {
        name = IStrToBytes()
        if isText {
            name = ITextToBytes()
        }
        return newIRIntr(name, lowMethodArgs2(recv, arg0), ty)
    } else if nm == "indexOf" {
        return lowIndexOf(recv, isText, arg0, ty)
    } else if nm == "append" {
        // textOnlyMethods (check.cla) only reaches here for a text
        // receiver -- isText is always true.
        return lowAppend(recv, arg0, ty)
    } else if nm == "hashStep" {
        // textOnlyMethods (check.cla) only reaches here for a text
        // receiver -- isText is always true, same as append above.
        arg1 = exprNext(arg0)
        arg2 = exprNext(arg1)
        return newIRIntr(ITextHashStep(), lowMethodArgs4(recv, arg0, arg1, arg2), ty)
    } else if nm == "intAt" {
        return newIRIntr(ITextIntAt(), lowMethodArgs2(recv, arg0), ty)
    } else if nm == "stringAt" {
        return newIRIntr(ITextStringAt(), lowMethodArgs2(recv, arg0), ty)
    } else if nm == "textAt" {
        arg1 = exprNext(arg0)
        return newIRIntr(ITextTextAt(), lowMethodArgs3(recv, arg0, arg1), ty)
    }
    lowUnsupported("string/text method " + nm)
    return -1
}

// lowIndexOf lowers `x.indexOf(arg)` (Ch3: string/text -- indexOf), picking
// the char vs. string needle intrinsic for whichever of string/text recv is
// -- a port of expr.go's lowerIndexOf.
func lowIndexOf(recv: int, isText: bool, argAst: int, ty: int): int {
    var isChar: bool
    var name: int

    isChar = typeKind(exprTypeGet(argAst)) == TyChar
    name = IStrIndexOfStr()
    if (not isText) and isChar {
        name = IStrIndexOfChar()
    } else if isText and isChar {
        name = ITextIndexOfChar()
    } else if isText {
        name = ITextIndexOfStr()
    }
    return newIRIntr(name, lowMethodArgs2(recv, argAst), ty)
}

// lowAppend lowers `t.append(arg)` (Ch3: Text -- append grows t in place);
// arg is string, char, or text -- a port of expr.go's lowerAppend.
func lowAppend(recv: int, argAst: int, ty: int): int {
    var name: int
    var argk: TypeKind

    argk = typeKind(exprTypeGet(argAst))
    name = ITextAppendStr()
    if argk == TyChar {
        name = ITextAppendChar()
    } else if argk == TyText {
        name = ITextAppendText()
    }
    return newIRIntr(name, lowMethodArgs2(recv, argAst), ty)
}

// lowSlice lowers `x[start, len]` (Ch3: Strings, Text -- Slicing) to the
// str/text slice intrinsic -- a port of expr.go's lowerSlice.
func lowSlice(e: int): int {
    var ty: int
    var name: int
    var x: int
    var start: int
    var ln: int

    ty = lowMustType(e)
    name = IStrSlice()
    if typeKind(exprTypeGet(sliceX(e))) == TyText {
        name = ITextSlice()
    }
    x = lowExpr(sliceX(e))
    start = lowExpr(sliceStart(e))
    ln = lowExpr(sliceLen(e))
    irExprListAppend(x, start)
    irExprListAppend(start, ln)
    return newIRIntr(name, x, ty)
}

// lowIndex lowers `a[i]`. Array and List indexing share IndexRef (see
// ir.IndexRef's doc comment for the printer contract this relies on for
// List -- funcprint.go's indexRef, Task 7 branch); string/text/map index to
// their read intrinsic -- a port of expr.go's lowerIndex.
func lowIndex(e: int): int {
    var ty: int
    var xk: TypeKind

    ty = lowMustType(e)
    xk = typeKind(exprTypeGet(indexX(e)))
    if xk == TyArr or xk == TyList {
        return newIRIndexRef(lowExpr(indexX(e)), lowExpr(indexI(e)), ty)
    } else if xk == TyStr {
        return newIRIntr(IStrIndex(), lowBin2Args(indexX(e), indexI(e)), ty)
    } else if xk == TyText {
        return newIRIntr(ITextIndex(), lowBin2Args(indexX(e), indexI(e)), ty)
    } else if xk == TyMap {
        return newIRIntr(IMapGet(), lowBin2Args(indexX(e), indexI(e)), ty)
    } else if xk == TySortedMap {
        return newIRIntr(ISortedMapGet(), lowBin2Args(indexX(e), indexI(e)), ty)
    } else if xk == TyIntMap {
        return newIRIntr(IIntMapGet(), lowBin2Args(indexX(e), indexI(e)), ty)
    }
    lowUnsupported("index of unsupported kind " + numToStr(int(xk)))
    return -1
}

// lowRecHasLiteralField reports whether record type recType declares a REAL
// field named fieldName -- the same recordFieldsHead/fieldInfos walk
// check.cla's readOnlyPropName (TyRec case) already uses to decide whether
// `isNew` is the synthetic pseudo-property or a shadowing real field.
func lowRecHasLiteralField(recType: int, fieldName: string): bool {
    var fh: int

    fh = recordFieldsHead(typeNameIdx(recType))
    while fh != -1 {
        if poolGet(fieldInfos[fh].nameIdx) == fieldName {
            return true
        }
        fh = fieldInfos[fh].next
    }
    return false
}

// lowXRecAddr returns an EXRecAddr IR node for the address of e (Task 4,
// toolbox-integration Feature B) -- e is an xrec-typed lvalue: either a
// bare variable (ExIdent) or a nested field select (ExSelect) whose OWN
// receiver (selectX(e)) is itself xrec-typed. Recurses down to the base
// variable, then adds each level's own field offset on the way back up --
// an arbitrarily deep `ev.a.b.c` collapses into exactly ONE EXRecAddr with
// ONE summed literal offset (never a chain of them), per EXRecAddr's own
// "flat" contract (see IRExprKind's doc comment). Every offset comes from
// irXRecFieldOffsetByName (ir.cla) -- the SAME shared layout authority
// irXRecSize/irXRecFieldOffset implement, so a nested nested field's
// address always agrees with what irXRecSize/irXRecFieldOffset would say
// about the same position computed a different way.
func lowXRecAddr(e: int): int {
    var baseAddr: int
    var recIdx: int
    var off: int

    if exprKind(e) == ExIdent {
        return newIRXRecAddr(identName(e), not lowIsLocal(identName(e)), 0, irPtrT)
    }
    baseAddr = lowXRecAddr(selectX(e))
    recIdx = irFindRecordLayoutByName(typeNameIdx(exprTypeGet(selectX(e))))
    if recIdx == -1 {
        // task-8: same composition-ordering -1 as lowTypeAt's TyXRec arm
        // (lowTypeAt's own doc comment), reached here via exprTypeGet's
        // CHECKED type -- irXRecFieldOffsetByName would panic on
        // irRecords[-1] otherwise. Zero-offset dummy so lowering can keep
        // collecting diagnostics.
        lowXRecMissingLayout(typeNameIdx(exprTypeGet(selectX(e))), exprLine(e), exprCol(e))
        return newIRXRecAddr(irXRecAddrName(baseAddr), irXRecAddrGlobal(baseAddr), irXRecAddrOffset(baseAddr), irPtrT)
    }
    off = irXRecFieldOffsetByName(recIdx, selectName(e))
    return newIRXRecAddr(irXRecAddrName(baseAddr), irXRecAddrGlobal(baseAddr), irXRecAddrOffset(baseAddr) + off, irPtrT)
}

// lowXRecMissingLayout (task-8) is lowXRecAddr/lowXRecFieldRead/
// lowXRecFieldWrite's shared -1 guard -- the same "extern record not
// declared before this use" diagnostic lowTypeAt's TyXRec arm emits, for
// the sibling case where the -1 shows up via exprTypeGet's CHECKED type
// (unaffected by lowTypeAt's own already-guarded dummy IR type) instead of
// through a `var`'s type annotation.
func lowXRecMissingLayout(nameIdx: int, line: int, col: int) {
    emitDiag(line, col, "extern record " + poolGet(nameIdx) + " is not declared before this use")
}

// lowXRecFieldRead lowers a scalar extern-record field READ (`ev.what`,
// `ev.where.v`, `sfr.fName`) -- Task 4's own field palette: byte/int/ptr
// read through the existing peekb/peekl intrinsics unchanged (their
// existing zero-extend-8/full-32-bits contract already matches the
// palette exactly); word needs an EXPLICIT sign-extend after peekw's own
// zero-extend (peekw's contract doesn't match the palette's word-field
// rule -- see peekw's own reference-doc contrast and CvSExt16's doc
// comment); bool needs peekb's zero-extend PLUS an explicit nonzero->1
// normalize (CvIntNonZero); str[N] goes through the two dedicated
// IXRecStrRead/Write intrinsics (see their own doc comment for why, not
// SStoreStr).
func lowXRecFieldRead(e: int): int {
    var xExpr: int
    var recIdx: int
    var slot: int
    var xk: int
    var addr: int
    var ty: int
    var raw: int
    var head: int
    var tail: int

    xExpr = selectX(e)
    ty = lowMustType(e)
    recIdx = irFindRecordLayoutByName(typeNameIdx(exprTypeGet(xExpr)))
    if recIdx == -1 {
        lowXRecMissingLayout(typeNameIdx(exprTypeGet(xExpr)), exprLine(e), exprCol(e))
        return newIRIntConst(0, ty)
    }
    slot = irXRecFieldSlotByName(recIdx, selectName(e))
    xk = irFieldSlotXKind(slot)
    addr = lowXRecAddr(e)
    if xk == XFStr {
        head = addr
        tail = irExprListAppend(head, newIRIntConst(irFieldSlotXN(slot), irIntT))
        return newIRIntr(IXRecStrRead(), head, ty)
    }
    if xk == XFByte {
        return newIRIntr(IPeekB(), addr, irIntT)
    }
    if xk == XFBool {
        raw = newIRIntr(IPeekB(), addr, irIntT)
        return newIRConv(CvIntNonZero, raw, -1, irBoolT)
    }
    if xk == XFWord {
        raw = newIRIntr(IPeekW(), addr, irIntT)
        return newIRConv(CvSExt16, raw, -1, irIntT)
    }
    // XFInt / XFPtr
    return newIRIntr(IPeekL(), addr, ty)
}

// lowXRecFieldWrite lowers a scalar extern-record field WRITE (`ev.what =
// x`, an assignment statement's target) -- the palette's write half:
// bool/byte through pokeb, word through pokew, int/ptr through pokel, all
// unextended (a poke intrinsic already truncates to its own width, Ch13's
// peek/poke section); str[N] through IXRecStrWrite (truncates at N, fixes
// the length byte -- rtStrStore's own contract). srcExpr is the already-
// lowered RHS IR expr (lowAssign's own caller has NOT yet coerced it --
// str fields need the raw string value, not lowCoerceStr's capacity-only
// clamp, since IXRecStrWrite's OWN runtime call does the N-byte clamp).
func lowXRecFieldWrite(target: int, srcExpr: int): int {
    var xExpr: int
    var recIdx: int
    var slot: int
    var xk: int
    var addr: int
    var head: int
    var tail: int

    xExpr = selectX(target)
    recIdx = irFindRecordLayoutByName(typeNameIdx(exprTypeGet(xExpr)))
    if recIdx == -1 {
        lowXRecMissingLayout(typeNameIdx(exprTypeGet(xExpr)), exprLine(target), exprCol(target))
        return newIRExprStmt(newIRIntConst(0, irVoidT))
    }
    slot = irXRecFieldSlotByName(recIdx, selectName(target))
    xk = irFieldSlotXKind(slot)
    addr = lowXRecAddr(target)
    if xk == XFStr {
        head = addr
        tail = irExprListAppend(head, newIRIntConst(irFieldSlotXN(slot), irIntT))
        tail = irExprListAppend(tail, srcExpr)
        return newIRExprStmt(newIRIntr(IXRecStrWrite(), head, irVoidT))
    }
    head = addr
    tail = irExprListAppend(head, srcExpr)
    if xk == XFBool or xk == XFByte {
        return newIRExprStmt(newIRIntr(IPokeB(), head, irVoidT))
    }
    if xk == XFWord {
        return newIRExprStmt(newIRIntr(IPokeW(), head, irVoidT))
    }
    // XFInt / XFPtr
    return newIRExprStmt(newIRIntr(IPokeL(), head, irVoidT))
}

// lowSelect lowers a bare `a.b` -- a record field, or a no-argument
// property (.length/.count, lastError's .code/.message) -- a port of
// expr.go's lowerSelect. Method calls go through lowMethodCall instead,
// since only a Call carries argument expressions.
func lowSelect(e: int): int {
    var ty: int
    var xk: TypeKind
    var propName: string
    var name: int
    var xExpr: int
    var symIdx: int

    ty = lowMustType(e)
    xExpr = selectX(e)
    propName = poolGet(selectName(e))

    // `WindowType.front` (Ch8: Window Instances) -- xExpr names a window
    // TYPE, never an ordinary checked expression (checkSelect's own
    // early-return path for this exact shape; exprTypeGet(xExpr) is unset
    // here, so xk below must not be computed from it for this case). An
    // instance's OWN `.front`-named var/widget, if any, is a different,
    // ordinary shape (an ExIdent variable, not a type name) and falls
    // through to the generic TyWindowRef dispatch below untouched.
    if exprKind(xExpr) == ExIdent and propName == "front" {
        symIdx = scopeLookup(curScope, identName(xExpr))
        if symIdx != -1 and symbols[symIdx].isType and typeKind(symbols[symIdx].typeIdx) == TyWindowRef {
            return newIRIntr(IUiFront(), -1, irWinRefType(symbols[symIdx].nameIdx))
        }
    }

    xk = typeKind(exprTypeGet(xExpr))
    if xk == TyWidget {
        // The OUTER select of a `w.Widget.prop` chain: xExpr (`w.Widget`)
        // is itself never lowered as a standalone value -- lowWidgetPropGet
        // peels both levels itself (Ch8: Widgets' runtime-property column).
        return lowWidgetPropGet(e, xExpr, ty)
    } else if xk == TyWindowRef {
        return lowWindowInstSelect(e, xExpr, propName, ty)
    } else if xk == TyRec {
        if propName == "isNew" and not lowRecHasLiteralField(exprTypeGet(xExpr), "isNew") {
            // Ch10: `isNew` reads back the `edit`/`accepted` call's own
            // isNew flag -- but ONLY on the accepted handler's own
            // parameter (see lowCurHandlerEvent/lowCurAcceptedParam's doc
            // comment); a record that happens to declare a REAL field
            // named isNew shadows this entirely (falls through to the
            // ordinary FieldRef below, per checkSelect's own field-walk-
            // first order) and never reaches this branch at all.
            if lowCurHandlerEvent == intern("accepted") and exprKind(xExpr) == ExIdent and identName(xExpr) == lowCurAcceptedParam {
                return newIRIntr(IUiFormIsNew(), -1, ty)
            }
            lowUnsupported("isNew is only defined on the accepted handler's parameter")
        }
        return newIRFieldRef(lowExpr(xExpr), selectName(e), ty)
    } else if xk == TyOverlay {
        // Ch13: an overlay field read/write -- no isNew special-case (that's
        // TyRec-only, Ch10 accepted-handler machinery), just a plain
        // FieldRef; fpFieldRef (cprint.cla) prints it `->cv_` since the
        // receiver is a real C pointer, not a by-value struct.
        return newIRFieldRef(lowExpr(xExpr), selectName(e), ty)
    } else if xk == TyXRec {
        // Task 4 (toolbox-integration Feature B): xExpr (`ev`, or a nested
        // `ev.where`) is itself extern-record-typed. Two shapes reach
        // here, distinguished by e's OWN checked type (not xk, which
        // always describes xExpr): a NESTED xrec select (`ev.where`,
        // exprTypeGet(e) itself TyXRec) is valid only as a decay/coercion
        // call argument (checker-enforced) -- lowering it means computing
        // its ADDRESS, exactly like the base-variable case lowXRecAddr's
        // own ExIdent branch handles, just one level deeper; a scalar leaf
        // (`ev.what`, `ev.where.v`) is an ordinary field READ.
        if typeKind(exprTypeGet(e)) == TyXRec {
            return lowXRecAddr(e)
        }
        return lowXRecFieldRead(e)
    } else if xk == TyErrorType {
        // `lastError.code`/`.message` read the runtime's rt_lasterr_*
        // globals directly (see lowIdent's doc comment). Every OTHER
        // error-typed receiver (a `var e: error`, ...) is an ordinary
        // Err-record value instead -- its .code/.message are a plain
        // FieldRef into that record (cprint's FieldRef case special-cases
        // ir.Err's field names, since clar_rec_Err has no cv_ prefix).
        if exprKind(xExpr) == ExIdent and lowIsUnshadowedLastError(identName(xExpr)) {
            if propName == "code" {
                return newIRIntr(ILastErrCode(), -1, ty)
            } else if propName == "message" {
                return newIRIntr(ILastErrMsg(), -1, ty)
            }
        }
        return newIRFieldRef(lowExpr(xExpr), selectName(e), ty)
    } else if (xk == TyStr or xk == TyText) and propName == "length" {
        name = IStrLen()
        if xk == TyText {
            name = ITextLen()
        }
        return newIRIntr(name, lowExpr(xExpr), ty)
    } else if xk == TyList and propName == "count" {
        return newIRIntr(IListCount(), lowExpr(xExpr), ty)
    } else if xk == TyMap and propName == "count" {
        return newIRIntr(IMapCount(), lowExpr(xExpr), ty)
    } else if xk == TySortedMap and propName == "count" {
        return newIRIntr(ISortedMapCount(), lowExpr(xExpr), ty)
    } else if xk == TyIntMap and propName == "count" {
        return newIRIntr(IIntMapCount(), lowExpr(xExpr), ty)
    }
    lowUnsupported("select ." + propName)
    return -1
}

// uiWidgetIndex returns wgName's 0-based position in window winNameIdx's
// declared widget list -- reads check.cla's own windowWidgetsHead/
// widgetInfos side tables directly (both modules share one process, one
// scope/type arena, per lowResolveType's header comment), so this is the
// SAME order cprint.cla's rt_ui_widget_desc[] array walk uses (lower.cla's
// lowWindowDecl), and thus the SAME index rt_ui's runtime expects.
// winNameIdx (Task 6, layer1-compiler-perf: was winName: string) is the
// window type's own interned name index; every caller already had it (or
// could get it without a poolGet) -- see each call site.
func uiWidgetIndex(winNameIdx: int, wgName: string): int {
    var wi: int
    var idx: int

    wi = windowWidgetsHead.get(winNameIdx, -1)
    idx = 0
    while wi != -1 {
        if poolGet(widgetInfos[wi].nameIdx) == wgName {
            return idx
        }
        wi = widgetInfos[wi].next
        idx = idx + 1
    }
    return -1 // unreachable in a checker-clean program
}

// lowWindowInstSelect lowers `w.name` where w is a window-instance VALUE
// (xk == TyWindowRef): either a per-instance `var` (Ch8) -- read through
// the rt_ui_state() cast (IUiState + an ordinary FieldRef, so the same
// FieldRef printer that already knows how to render "(X).cv_name" does all
// the work; see IRKind's KUiState doc comment in ir.cla) -- or `.title`
// (mac-target-4c Task 4b: IUiGetTitle/rt_ui_get_title, checked AFTER the
// fieldInfos walk since "title" is a synthetic windowScope symbol, never a
// real per-instance var entry). A widget-select (`w.Widget`) is never
// reached here as a value in its own right -- the OUTER property select
// peels both levels itself (lowWidgetPropGet).
func lowWindowInstSelect(e: int, xExpr: int, propName: string, ty: int): int {
    var winNameIdx: int
    var fh: int
    var stateExpr: int

    winNameIdx = typeNameIdx(exprTypeGet(xExpr))
    fh = windowVarsHead.get(winNameIdx, -1)
    while fh != -1 {
        if poolGet(fieldInfos[fh].nameIdx) == propName {
            stateExpr = newIRIntr(IUiState(), lowExpr(xExpr), irUiStateType(winNameIdx))
            return newIRFieldRef(stateExpr, intern(propName), ty)
        }
        fh = fieldInfos[fh].next
    }
    if propName == "title" {
        return newIRIntr(IUiGetTitle(), lowExpr(xExpr), ty)
    }
    lowUnsupported("select ." + propName)
    return -1
}

// lowWidgetPropGet lowers `w.Widget.prop` (Ch8: Widgets' runtime-property
// column) -- e is the OUTER select (the `.prop` one); wgSel is `w.Widget`,
// itself never lowered as a standalone value (see lowSelect's TyWidget
// case). Covers the get half of rt_ui.h's ABI as built: bool props via
// rt_ui_widget_get_bool (check/button `enabled`), int props via
// rt_ui_widget_get_int (canvas `width`/`height`), field.text/label.text via
// rt_ui_widget_get_str (mac-target-4c Task 2; label.text added by
// native-gaps-cleanup Task 5 -- rt_ui_widget_get_str reads the SAME
// labels[] slot rt_ui_widget_set_str's RTUI_LABEL arm writes, see
// uiwidgets.cla's rtUiWidgetGetStr), textview.text via
// rt_ui_widget_get_text -- a button caption READ is still unsupported here
// (only ever a write, via lowWidgetSetAssign).
func lowWidgetPropGet(e: int, wgSel: int, ty: int): int {
    var recv: LowWidgetRecv
    var widgetKind: string
    var propName: string
    var widgetIdx: int
    var head: int
    var intrName: int

    recv = lowWidgetRecv(wgSel)
    widgetKind = findWidgetKind(recv.winNameIdx, recv.wgName)
    widgetIdx = uiWidgetIndex(recv.winNameIdx, recv.wgName)
    propName = poolGet(selectName(e))

    intrName = -1
    if widgetKind == "check" and propName == "checked" {
        intrName = IUiGetChecked()
    } else if (widgetKind == "button" or widgetKind == "field") and propName == "enabled" {
        intrName = IUiGetEnabled()
    } else if widgetKind == "canvas" and propName == "width" {
        intrName = IUiGetWidth()
    } else if widgetKind == "canvas" and propName == "height" {
        intrName = IUiGetHeight()
    } else if widgetKind == "field" and propName == "text" {
        intrName = IUiGetFieldText()
    } else if widgetKind == "label" and propName == "text" {
        intrName = IUiGetLabelText()
    } else if widgetKind == "textview" and propName == "text" {
        intrName = IUiGetTextviewText()
    } else if (widgetKind == "popup" or widgetKind == "table") and propName == "selected" {
        intrName = IUiGetSelected()
    }
    if intrName == -1 {
        lowUnsupported("read of " + widgetKind + "." + propName)
        return -1
    }

    head = recv.instIR
    irExprListAppend(head, newIRIntConst(widgetIdx, irIntT))
    return newIRIntr(intrName, head, ty)
}

// coerceStr wraps x in a capacity-clamping temp when x is a Str value whose
// capacity differs from target's, or materializes a fresh Text handle when
// x is a Str value binding into a Text-typed slot (the checker's
// String -> Text assignability, Ch3 -- the conversion always creates a
// FRESH text copy, per docs/clarus-language-reference.md's Text section) --
// a port of expr.go's coerceStr. No call site in this task's conservative
// subset reaches a mismatched-capacity Str binding yet (no user functions/
// lists/maps are wired); ported now so Task 6+'s call/list/map slices can
// call it directly.
func lowCoerceStr(target: int, x: int): int {
    if irtKind(target) == KText and irtKind(irExprType(x)) == KStr {
        return newIRIntr(ITextOfStr(), x, target)
    }
    if irtKind(target) != KStr or irtKind(irExprType(x)) != KStr or irtN(irExprType(x)) == irtN(target) {
        return x
    }
    return newIRIntr(IStrCoerce(), x, target)
}

// lowIntConv lowers `int(x)`, whose ConvOp depends on x's source kind (Ch3:
// Numeric Conversions, Enums) -- a port of expr.go's lowerIntConv.
func lowIntConv(e: int, ty: int): int {
    var argT: int
    var argK: TypeKind

    argT = exprTypeGet(callArgsHead(e))
    argK = typeKind(argT)
    if argK == TyFixed {
        return newIRConv(CvFixedToInt, lowExpr(callArgsHead(e)), -1, ty)
    } else if argK == TyChar {
        return newIRConv(CvCharToInt, lowExpr(callArgsHead(e)), -1, ty)
    } else if argK == TyEnum {
        return newIRConv(CvEnumToInt, lowExpr(callArgsHead(e)), -1, ty)
    } else if argK == TyPtr {
        return newIRConv(CvPtrToInt, lowExpr(callArgsHead(e)), -1, ty)
    }
    // Anything else is a checker bug (int() from an unsupported source
    // kind should never pass checkCall).
    lowUnsupported("int(...) from unsupported source kind")
    return -1
}

// lowPtrConv lowers `ptr(x)`, whose ConvOp depends on x's source kind (Ch13:
// Low-Level Memory Access's `ptr(int)`, widened by Ch13's Overlay Records to
// also accept `ptr(overlay)`) -- mirrors lowIntConv's dispatch shape exactly.
func lowPtrConv(e: int, ty: int): int {
    var argK: TypeKind

    argK = typeKind(exprTypeGet(callArgsHead(e)))
    if argK == TyOverlay {
        return newIRConv(CvOverlayToPtr, lowExpr(callArgsHead(e)), -1, ty)
    }
    // checkConversion only accepts TyInt/TyOverlay as ptr()'s source kind.
    return newIRConv(CvIntToPtr, lowExpr(callArgsHead(e)), -1, ty)
}

// ================================================================
// Statement lowering (stmt.go subset)
// ================================================================

// lowStoreStmt builds the store form for `dst = src` at IR type t: a Str
// destination clamps through StoreStr; a Text destination fed by a Str
// source (the checker's String -> Text assignability) goes through the
// text_store intrinsic, since a Text handle and a Str value have no common
// C representation to plain-assign between; everything else (Text=Text
// reference copy, records/arrays copy by value) is a plain Assign --
// stmt.go's storeStmt.
func lowStoreStmt(dst: int, src: int, t: int): int {
    if irtKind(t) == KStr {
        return newIRStoreStr(dst, src)
    } else if irtKind(t) == KText and irtKind(irExprType(src)) == KStr {
        irExprListAppend(dst, src)
        return newIRExprStmt(newIRIntr(ITextStore(), dst, irVoidT))
    }
    return newIRAssign(dst, src)
}

// lowStoreTempN counts synthesized store-materialization temps program-wide
// (lowNewStoreTemp, below) -- same never-reused-across-functions discipline
// as lowRetTempN/lowSwitchN's own counters.
var lowStoreTempN: int

// lowNewStoreTemp names one lowCountedStore materialization temp (below).
// Always a FRESH name (unlike lowNewReturnTemp's per-function cache): each
// materialization is a strictly local, single-use scratch value consumed
// immediately by the retain+store pair that follows it, never reused across
// statements, so there is no leak-scaling reason to collapse repeat calls
// within one function the way the return-value temp does.
func lowNewStoreTemp(): int {
    lowStoreTempN = lowStoreTempN + 1
    return intern("__store" + numToStr(lowStoreTempN))
}

// lowStoreIsBirth is ARC Task 4's review-focus predicate: reports whether
// srcAst syntactically produces a value that ALREADY carries its own,
// uniquely-owned +1 -- so a store from it should be a HANDOFF (no lower.cla
// retain; whatever already owns the +1 hands it straight to dst) rather
// than a retain of a reference someone else still owns. Four birth shapes,
// each independently verified fresh:
//
//   - ExStringLit: a string literal. Never reaches this predicate directly
//     for a Str->Text coercion store (lowCountedStore special-cases that by
//     IR TYPE, below, since Str is a by-value type any AST shape can
//     produce -- not just a literal); kept here for the direct
//     Text<-literal-of-Text-type case (a literal is always a fresh
//     construction).
//   - ExBinary(OpAdd) at Text result type: text concatenation -- Ch3's
//     "always a fresh copy" contract.
//   - ExSlice: text/string slicing -- likewise always a fresh copy (Ch3).
//   - ExCall: ANY call (a plain user-function call OR a method call like
//     .first()/.last()/.get()/.getDefault()/.pop()/.shift()) that types as
//     Text/List/Map. This is the ARC Task 3-enabled addition beyond 4e's
//     old rule 2 (which never trusted a call result as fresh, since 4e had
//     no +1-return convention to make that trust sound): cprint.cla's own
//     printer ALREADY balances every one of these -- fpCallFn materializes
//     a user call's heap-typed result into a tracked temp (a genuine +1,
//     the callee's own retain-before-return); IListFirst/IListLast/IMapGet/
//     IMapGetDv retain+track their own alias read (also a genuine, freshly
//     minted +1); IListPop/IListShift transfer without retaining (already
//     +1, simply handed onward). In EVERY case the value cprint hands back
//     is already a value nothing else owns a competing claim to -- retaining
//     it AGAIN here would be a real, silent double-retain leak (rc off by
//     one forever, never caught as a crash, only as a slowly climbing
//     `.leaks` count). Since fpStmt's own SAssign/SReturn printer ALREADY
//     hands off a tracked temp when it lands directly in a store/return
//     (fpHandoff, ARC Task 3), lower.cla must stay out of the way for every
//     call shape uniformly, not just plain user calls.
//
// Everything else -- a bare identifier (local, global, or an
// in-handler-bare window-var name, all ExIdent at this AST level), a
// `rec.field`/`w.field` select, or a `list[i]`/`map[k]` element read -- is a
// REFERENCE to a value some other slot/container still owns: non-birth,
// must retain its own copy. Default false: err toward retain (an
// unnecessary retain is a leak, caught immediately by the `.leaks` corpus
// gate; a missing one is a silent, much harder to catch UAF).
func lowStoreIsBirth(srcAst: int): bool {
    var k: ExprKind

    k = exprKind(srcAst)
    if k == ExStringLit {
        return true
    }
    if k == ExBinary and binOp(srcAst) == OpAdd and typeKind(exprTypeGet(srcAst)) == TyText {
        return true
    }
    if k == ExSlice {
        return true
    }
    if k == ExCall {
        return true
    }
    return false
}

// lowStoreIntrOwnsResult is lowStoreIsBirth's IR-SHAPE counterpart (Task 4
// review fix, Critical 1 + Important 2): some intrinsics hand back a value
// cprint.cla's OWN printer already gave its own +1 -- a fresh
// `rt_text_new()` construction (IUiGetTextviewText: `w.Widget.text`, ExSelect
// at the AST level -- lowStoreIsBirth's own ExCall check never sees it) or a
// retain into a tracked temp (IMapGet: `m[k]`, ExIndex at the AST level --
// same already-retained contract IMapGetDv/IListFirst/IListLast already get
// via their OWN ExCall shape, `.get()`/`.first()`/`.last()`). Classifying
// either as non-birth would add a SECOND, unbalanced retain on top of the
// one cprint already baked in: a permanent, silent leak (rc off by one
// forever), not a crash -- caught by inspecting the regenerated
// dialogs/textwidgets emitui goldens directly (rc going 1->2 with only one
// release ever firing), not by any runtime probe.
//
// An AST-shape check (lowStoreIsBirth) can't see this: it runs on srcAst
// BEFORE lowExpr ever produces the IR node whose SHAPE -- which specific
// intrinsic, if any -- actually determines whether cprint already retained.
// This check runs AFTER `src = lowExpr(srcAst)`, on the lowered IR, for
// exactly that reason.
//
// Audited every intrinsic that hands back an owned/tracked heap-typed
// result (grepped cprint.cla for every `rt_text_new()`/`fpNewTrackedTmp`
// call site reachable as an EXPRESSION value, not just cpDefaultInit's own
// prologue construction, which is a different mechanism entirely and never
// reaches a store RHS): fpCallFn (ECallFn user calls), IListFirst/
// IListLast/IListPop/IListShift/IMapGetDv (all `.method()` calls, ExSelect
// fn but the CALL itself is ExCall) are already covered by
// lowStoreIsBirth's ExCall branch. ITextConcat/ITextConcatSL (string/text
// `+`) are already covered by its ExBinary/OpAdd/TyText branch. ITextOfStr
// is handled separately, by IR TYPE not AST shape, in lowCountedStore's own
// KStr override (any Str source feeding a Text dst, not just this specific
// intrinsic). IUiGetFieldText returns a Str (clar_str_255, untracked,
// non-heap) -- covered by the SAME KStr override when it feeds a Text dst,
// not by this function. IFileReadText is a fresh runtime allocation too,
// but reached via plain ExCall (`file.readText(...)`) -- already covered,
// not listed here. IUiGetTextviewText (ExSelect) and IMapGet (ExIndex) are
// the only two owned-result intrinsics reachable via a non-ExCall AST
// shape -- hence this function.
func lowStoreIntrOwnsResult(src: int): bool {
    var nm: int

    if irExprKind(src) != EIntr {
        return false
    }
    nm = irIntrName(src)
    return nm == IUiGetTextviewText() or nm == IMapGet() or nm == ISortedMapGet() or nm == IIntMapGet()
}

// lowElemIsBirth is ARC Task 5's container-ELEMENT-store counterpart to
// lowCountedStore's own two birth checks -- the IDENTICAL birth-vs-retain
// rule Task 4 established for named-slot stores, reused verbatim: a
// container element slot is just another counted owner now, no different in
// kind from a local/global/window-var slot (lowListMethod's push/unshift,
// lowIndexAssign's list/map index-write -- every ARC Task 5 store site).
//
// srcAst is the un-lowered AST source; rawSrc is srcAst's ALREADY-LOWERED IR
// form, taken BEFORE any lowCoerceStr coercion -- mirrors lowCountedStore's
// own `src = lowExpr(srcAst)` timing exactly (lowStoreIntrOwnsResult needs
// the lowered-but-uncoerced shape, same as lowCountedStore's own call site).
// elemT is the destination element's IR type (a list's own element type, or
// a map's).
func lowElemIsBirth(srcAst: int, rawSrc: int, elemT: int): bool {
    if irtKind(elemT) == KText and irtKind(irExprType(rawSrc)) == KStr {
        // Same override lowCountedStore's own KStr branch uses: a Str
        // source feeding a Text-typed element always coerces through
        // lowCoerceStr's ITextOfStr, which ALWAYS constructs a fresh box
        // (Ch3: "the conversion always creates a fresh text copy"),
        // regardless of srcAst's own shape -- see lowCountedStore's doc
        // comment for the full argument; kept here as a second, independent
        // application of the SAME override rather than folded into
        // lowStoreIntrOwnsResult, whose own doc comment explicitly
        // documents deferring to this IR-type check instead.
        return true
    }
    return lowStoreIsBirth(srcAst) or lowStoreIntrOwnsResult(rawSrc)
}

// lowIsRecBearing (ARC Task 7) reports whether t is a KRec value with at
// least one handle-backed field (irRecHasHandleField, ir.cla -- the shared
// gate-asymmetry-proof test), or a fixed array (KArr, any nesting depth)
// whose element type is. This is the master gate for every one of Task 7's
// seven copy sites: false for every OTHER kind (int/bool/fixed/char/enum/
// Str/Text/List/Map -- Text/List/Map keep using the EXISTING, separately-
// reviewed lowEscapeTrackableKind machinery, untouched by this task) and
// false for an all-scalar record/array-of-records, so a caller that only
// emits IRetain/IRelease when this is true can never reach fpIntrCall's
// KRec branch for a type cpEmitRcWalks decided not to define a walk pair
// for (see irRecHasHandleField's own doc comment).
func lowIsRecBearing(t: int): bool {
    var k: IRKind

    k = irtKind(t)
    if k == KArr {
        return lowIsRecBearing(irtElem(t))
    }
    if k == KRec {
        return irRecHasHandleField(irtName(t))
    }
    return false
}

// lowArrHeapScalarBearing reports whether t is a KArr (any nesting depth)
// whose innermost element is a directly counted handle
// (lowEscapeTrackableKind) -- the KArr-of-Text counterpart to
// lowIsRecBearing's KArr-of-Rec case, kept as its own predicate rather than
// folded into lowIsRecBearing (whose contract is documented as
// record-only elsewhere -- see its own doc comment).
func lowArrHeapScalarBearing(t: int): bool {
    var et: int

    if irtKind(t) != KArr {
        return false
    }
    et = irtElem(t)
    if irtKind(et) == KArr {
        return lowArrHeapScalarBearing(et)
    }
    return lowEscapeTrackableKind(irtKind(et))
}

// lowRecStoreIsBirth (ARC Task 7) is lowStoreIsBirth's RECORD counterpart --
// deliberately NARROWER than lowStoreIsBirth's own ExCall branch, which
// trusts ANY call (including a built-in method call like `.first()`/
// `.get()`) as birth because Task 3 already made every one of those
// RETAIN its own alias read for Text/List/Map. This task does NOT extend
// that retain-on-read work to record CONTAINER elements read via
// `.first()`/`.last()`/`.get()`/a map-index-read (out of the brief's
// site-4 scope, which names only push/set/remove/pop) -- trusting those as
// birth here would UNDER-retain a record whose fields still alias the
// container's own copy, a UAF risk once the receiver's own copy is later
// released, not merely a leak. Two birth shapes exist for a record source:
//   - a plain user function call (ExCall, callee ExIdent) -- ARC Task 7
//     site 3 makes every record-returning function's result a genuine +1
//     transfer, exactly Task 3's own text/list/map convention.
//   - `.pop()`/`.shift()` on a list (ExCall, callee ExSelect named "pop"/
//     "shift") -- TRANSFER semantics (brief's site 4: "no retain -- pop
//     transfers"): cprint.cla's IListPop/IListShift printer already does a
//     raw copy-out-and-remove for ANY element type, kind-agnostically, no
//     printer change needed -- the popped/shifted value already carries
//     its own uncontested +1 (nothing else in the list references it
//     anymore), so retaining it again here would be an unbalanced leak.
// A record literal has no syntax in this language (checked against
// check.cla's expression forms and the language reference) -- a record
// value is only ever produced by clar_new_<Rec>()'s own construction
// (never a store RHS directly) or one of the two call shapes above, so
// ExCall is the only AST kind this predicate ever needs to inspect.
func lowRecStoreIsBirth(srcAst: int): bool {
    var fn: int
    var mname: string

    if exprKind(srcAst) != ExCall {
        return false
    }
    fn = callFn(srcAst)
    if exprKind(fn) == ExIdent {
        return true
    }
    if exprKind(fn) == ExSelect {
        mname = poolGet(selectName(fn))
        return mname == "pop" or mname == "shift"
    }
    return false
}

// lowNullValueAppend (ARC Task 7) appends the statement(s) that null OUT
// dst's own reference(s) at IR type t, mirroring cpEmitRelease's own
// KText/KList/KMap/KRec recursive structure (ir.cla/cprint.cla) but
// building an ASSIGNMENT-TO-ZERO instead of a release CALL: a plain
// IntConst 0 is NULL-safe for retain/release per rt.h's own contract (the
// SAME idiom lowCountedStore's own scalar-handle materialization temp
// already uses to detach itself after handoff) for a bare handle
// (KText/KList/KMap); a NESTED record field (KRec) is NOT a pointer --
// `dst = 0` doesn't compile for a struct -- so it recurses field-by-field
// instead, exactly like cpEmitRelease's own KRec branch recurses instead
// of trying to zero the whole struct at once (found via a real build
// failure: `emit_record.cla`'s nested `Address` field assigned `= 0`,
// `error: assigning to 'clar_rec_...' from incompatible type 'int'` --
// fixed by recursing here rather than guessing). A ctor-needing KArr field
// (ARC fix-wave Task 2, Gap B) recurses per INDEX instead, unrolled at
// LOWER time since the array's length is a compile-time constant -- same
// precedent the KRec arm above already establishes for per-field
// unrolling; mirrors cpEmitRelease/cpEmitRetain's own KArr loop shape in
// cprint.cla. Every other kind (int/bool/fixed/char/enum/Str, and a
// non-ctor-needing KArr) emits nothing. tail must already be a valid
// (non -1) statement-chain tail; returns the new tail.
//
// Used ONLY by lowCountedStoreRecVal's own scratch temp (below): a record
// scratch temp is a REUSED C local (declared once, at function-prologue
// scope, by cpDefaultInit -- same as lowCountedStore's own scalar temp),
// so the SAME "detach after handoff, so the NEXT run's leading release
// sees a safe no-op instead of double-releasing a reference the
// destination now owns" discipline applies, per-field instead of to a
// single pointer.
func lowNullValueAppend(tail: int, dst: int, t: int): int {
    var ri: int
    var f: int
    var ft: int
    var et: int
    var k: IRKind
    var n: int
    var ix: int
    var t2: int
    t2 = tail

    k = irtKind(t)
    if k == KText or k == KList or k == KMap or k == KSortedMap or k == KIntMap {
        t2 = irStmtListAppend(t2, newIRAssign(dst, newIRIntConst(0, t)))
    } else if k == KRec {
        ri = 0
        while ri < irRecords.count {
            if irRecordLayoutName(ri) == irtName(t) {
                f = irRecordLayoutFieldsHead(ri)
                while f != -1 {
                    if irtNeedsCtor(irFieldSlotType(f)) {
                        ft = irFieldSlotType(f)
                        t2 = lowNullValueAppend(t2, newIRFieldRef(dst, irFieldSlotName(f), ft), ft)
                    }
                    f = irFieldSlotNext(f)
                }
                ri = irRecords.count
            } else {
                ri = ri + 1
            }
        }
    } else if k == KArr {
        et = irtElem(t)
        if irtNeedsCtor(et) {
            n = irtN(t)
            ix = 0
            while ix < n {
                t2 = lowNullValueAppend(t2, newIRIndexRef(dst, newIRIntConst(ix, irIntT), et), et)
                ix = ix + 1
            }
        }
    }
    return t2
}

// lowCountedStoreRecVal (ARC Task 7, site 1; extracted for ARC fix-wave
// Task 2) is lowCountedStoreRec's body, parameterized on an already-lowered
// src -- extracted so a caller that has ALREADY lowered its source
// expression (lowIndexAssign's TyArr arm, which lowers x/i/rhs once up
// front for every branch) can reuse the temp-copy walk order without
// lowering srcAst a second time (which would re-execute a side-effecting
// source, e.g. a call, twice at runtime).
//
// This is lowCountedStore's KRec sequence: a record assignment/declared-
// initializer/window-var-default/array-element store, for a handle-backed
// record type (lowIsRecBearing already gated this -- an all-scalar record
// falls straight through to a plain byte-copy, see lowCountedStore's own
// dispatch). Mandatory temp-copy order (brief's own worked example, picked
// over the alternative "retain-new-then-release-old on dst directly"
// ordering scalar handles use): byte-copy src to a scratch temp,
// retain-walk the TEMP's copy, release-walk dst's OLD value, byte-copy the
// temp into dst.
//
// This order is SAFE for self-assign (`r = r`, src and dst the exact same
// lvalue) where the scalar-handle ordering is NOT: dst's own fields are
// retained (via the temp's independent copy) BEFORE dst's original
// reference is ever released, so a field handle shared between src and dst
// (in the self-assign case, the SAME physical field) never has its rc drop
// to 0 mid-sequence. Retaining dst's fields directly, in place, AFTER the
// byte-copy (the scalar-handle-style ordering) would require proving no
// field of src and dst can ever alias, which self-assign trivially
// violates -- costs one extra struct copy, always safe.
//
// The scratch temp has the identical "default-init orphan" hazard
// lowCountedStore's own scalar materialization temp already documents:
// cpDefaultInit's prologue clar_new_<Rec>() unconditionally constructs it
// once per function entry, but this statement may lower ONCE yet execute
// MANY times per call (inside a loop) -- a plain byte-copy INTO the temp
// (`temp = src`) does NOT release whatever the temp held from its previous
// run, so: release-walk the temp's stale content BEFORE overwriting it
// (correct on the very first run -- the genuine prologue construction;
// nulled to a safe no-op every run after by the last step below), then
// null the temp's handle fields out again AFTER handing them off to dst
// (lowNullValueAppend), so the temp holds nothing of its own by the
// time the NEXT run's leading release fires.
func lowCountedStoreRecVal(dst: int, srcAst: int, src: int, t: int): int {
    var tmpNameIdx: int
    var tmpRef: int
    var head: int
    var tail: int

    tmpNameIdx = lowNewStoreTemp()
    // no prologue birth: this temp's own store site releases-then-overwrites it
    // (NULL-safe), and nulls it after transfer -- memory-leak-fix Task 2, findings root-cause 1.
    irLocalMarkNoBirth(lowAddLocal(tmpNameIdx, t))
    tmpRef = newIRVarRef(tmpNameIdx, false, t)

    head = newIRExprStmt(newIRIntr(IRelease(), tmpRef, irVoidT))
    tail = irStmtListAppend(head, newIRAssign(tmpRef, src))
    if not lowRecStoreIsBirth(srcAst) {
        tail = irStmtListAppend(tail, newIRExprStmt(newIRIntr(IRetain(), tmpRef, irVoidT)))
    }
    tail = irStmtListAppend(tail, newIRExprStmt(newIRIntr(IRelease(), dst, irVoidT)))
    tail = irStmtListAppend(tail, lowStoreStmt(dst, tmpRef, t))
    tail = lowNullValueAppend(tail, tmpRef, t)
    return head
}

// lowCountedStoreRec (ARC Task 7, site 1) is lowCountedStore's KRec branch:
// a record assignment/declared-initializer/window-var-default store, for a
// handle-backed record type. Lowers srcAst, then delegates to
// lowCountedStoreRecVal for the actual temp-copy walk order -- see that
// function's own doc comment for the mandatory ordering and why it's safe
// under self-assign.
func lowCountedStoreRec(dst: int, srcAst: int, t: int): int {
    var src: int

    src = lowExpr(srcAst)
    return lowCountedStoreRecVal(dst, srcAst, src, t)
}

// lowCountedStoreVal (extracted for ARC fix-wave Task 2) is lowCountedStore's
// body, parameterized on an already-lowered src -- extracted so a caller
// that has ALREADY lowered its source expression (lowIndexAssign's TyArr
// arm, which lowers x/i/rhs once up front for every branch) can reuse the
// retain/release sequence without lowering srcAst a second time (which
// would re-execute a side-effecting source, e.g. a call, twice at runtime).
// Callable only for a heap-scalar (Text/List/Map) t -- lowCountedStore's own
// lowIsRecBearing/lowEscapeTrackableKind gates (below) stay in that thin
// wrapper, before src is computed, since a record destination or a plain
// scalar destination never reaches this sequence at all.
//
// This is the ARC Task 4 store sequence for a heap-typed store to a NAMED
// slot (a local, a global, a window var's per-instance field, or -- as of
// ARC fix-wave Task 2 -- a fixed-array element): [IRetain(src) unless
// birth] -> IRelease(dst's OLD value) -> the plain store.
//
// Order is load-bearing: retaining the NEW value BEFORE releasing the OLD
// one is what makes a self-assign (`a = a`) safe -- src and dst can be the
// SAME live handle, and bumping its rc to >=2 before the matching decrement
// guarantees the decrement never sees rc reach 0 on a value that's still
// referenced (by `a` itself). Retain-then-release is unconditional whenever
// a retain is emitted at all; a birth store skips the retain (its own +1 is
// already the whole story) but still releases dst's old value -- including
// a local's `var x: text = someOtherText`-shaped DECLARED initializer
// (dst=src both Text, the plain-Assign branch below, a genuine POINTER
// REPLACEMENT), whose "old value" is cpDefaultInit's function-prologue
// default-construction (4e's documented "default-init orphan": nothing
// ever released it before this task) -- AND a Str->Text literal coercion
// (`var x: text = "hi"`, `x = "hi"`): see the ITextOfStr rewrite just
// below, which turns that case into an ordinary birth pointer-replacement
// too (never lowStoreStmt's own in-place ITextStore branch -- that one
// mutates dst's CURRENT box, unsafe whenever dst might be aliased).
//
// dst is the CALLER's already-lowered destination ref (reused directly for
// both the release-old and the store's own LHS -- a bare EVarRef, the
// EFieldRef-over-IUiState shape lowBareWindowMemberRef/lowWindowInstSelect
// build for a window var, or an EIndexRef for an array element, all pure,
// side-effect-free lvalue address computations, safe to re-emit). srcAst is
// the UN-lowered source expression -- lowStoreIsBirth needs the AST shape;
// src is srcAst already lowered exactly once by the caller.
func lowCountedStoreVal(dst: int, srcAst: int, src: int, t: int): int {
    var isBirth: bool
    var srcUsed: int
    var tmpNameIdx: int
    var head: int
    var tail: int
    var src2: int
    src2 = src

    tmpNameIdx = -1
    isBirth = lowStoreIsBirth(srcAst) or lowStoreIntrOwnsResult(src2)
    if irtKind(t) == KText and irtKind(irExprType(src2)) == KStr {
        // A Text destination fed by a Str source: NEVER lowStoreStmt's own
        // inline ITextStore branch here -- that intrinsic copies the
        // string's bytes into dst's ALREADY-EXISTING buffer IN PLACE
        // (cprint.cla's ITextStore case), which is only safe when dst's box
        // is PROVABLY unshared. It is NOT: Ch3's own reference semantics
        // ("assignment... copies the reference... all references to the
        // same handle point to the same underlying data") mean dst's box
        // may be ALIASED by another local/global sharing the same handle
        // (`var b: text = a`) -- an in-place store would silently corrupt
        // every alias, not just dst (hand-probe #2's exact repro: `var b:
        // text = a; a = "other"` left `b` reading "other" too, no crash, no
        // leak-count signal -- caught only by comparing VALUES). Route
        // through lowCoerceStr's ITextOfStr instead: allocates a FRESH,
        // unshared box and stores into THAT, an ordinary birth construction
        // -- unifies with the general birth path below (materialize if not
        // a bare ref, release dst's OLD reference, plain-assign the fresh
        // box in). Overrides lowStoreIsBirth's own AST-based verdict:
        // regardless of srcAst's shape (a bare Str variable read is
        // syntactically non-birth, but the COERCION itself always
        // constructs fresh), the value actually being stored here is
        // always a brand-new box.
        src2 = lowCoerceStr(t, src2)
        isBirth = true
    }

    srcUsed = src2
    head = -1
    tail = -1
    if exprKind(srcAst) != ExIdent {
        // Not a bare name -- materialize once into a scratch temp, BEFORE
        // dst's old value is released below, for TWO independent reasons:
        //
        //   1. (non-birth) so the retain and the store's own RHS read the
        //      SAME already-computed value exactly once each -- reprinting
        //      a non-bare-ref source expression (a field chain, and
        //      especially a `list[i]`/`map[k]` element read whose
        //      index/key can itself carry side effects, e.g. a function
        //      call) a second time would re-evaluate it.
        //   2. (birth OR non-birth) cprint's OWN C-level computation for a
        //      non-bare expression -- e.g. ITextConcat's `t=rt_text_new();
        //      rt_text_concat(t, ...)` -- only happens at PRINT time,
        //      folded into whichever statement actually embeds the
        //      expression. If that expression itself reads dst's CURRENT
        //      value (the common case: `t = t + " world"`, a birth concat
        //      that reads t as its own left operand), emitting dst's
        //      release as an EARLIER, separate statement and deferring the
        //      concat's own read of dst to the LATER store statement would
        //      make the concat read an already-released (possibly
        //      disposed/scrambled) dst -- a use-after-free, caught the hard
        //      way (reviewer repro: `t = t + " world"` segfaulting inside
        //      rt_text_concat, reading 0xa5-scrambled freed memory).
        //      Materializing FIRST forces the expression's own computation
        //      to run, and finish reading dst, before dst's release ever
        //      executes -- true for every non-bare shape, birth or not.
        //
        // The materialization temp's role is purely transient -- compute,
        // retain if non-birth, hand off to dst, forget -- but it is a
        // REUSED C variable (declared once, at function-prologue scope;
        // this statement may be lowered ONCE yet embedded inside a loop
        // body, so its C runs many times per call). Releasing whatever it
        // held BEFORE overwriting it is right on the FIRST run (its own
        // cpDefaultInit prologue construction -- the usual "default-init
        // orphan," same class lowReturn's synthetic already guards
        // against) but WRONG on every later run: by then its previous
        // value has already been aliased into dst with no independent
        // ownership left on the temp's own side (birth: never retained at
        // all; non-birth: the one retain belongs to dst, not to a second,
        // phantom "the temp still owns it too" claim) -- releasing it
        // again would double-release dst's own live reference (reviewer's
        // exact repro: cprint.cla's own cpEmitStrLits, `bytesStr = bytesStr
        // + numToStr(...)` inside a `while j < s.length` loop, aborted with
        // `rt_rc: over-release` during the self-hosting bootstrap -- no
        // corpus fixture loops large enough to trip this; the compiler
        // compiling ITSELF, thousands of literals long, did).
        //
        // Fix: NULL the temp out (a plain `0`, NULL-safe for retain/release
        // per rt.h's own contract) immediately after handing its value to
        // dst, below -- so EVERY run's "release what the temp held before"
        // is correct: the prologue box on the very first run, a safe
        // release-of-NULL no-op on every run after.
        tmpNameIdx = lowNewStoreTemp()
        // no prologue birth: this temp's own store site releases-then-overwrites it
        // (NULL-safe), and nulls it after transfer -- memory-leak-fix Task 2, findings root-cause 1.
        irLocalMarkNoBirth(lowAddLocal(tmpNameIdx, t))
        head = newIRExprStmt(newIRIntr(IRelease(), newIRVarRef(tmpNameIdx, false, t), irVoidT))
        tail = irStmtListAppend(head, newIRAssign(newIRVarRef(tmpNameIdx, false, t), src2))
        srcUsed = newIRVarRef(tmpNameIdx, false, t)
    }

    if not isBirth {
        tail = irStmtListAppend(tail, newIRExprStmt(newIRIntr(IRetain(), srcUsed, irVoidT)))
        if head == -1 {
            head = tail
        }
    }

    tail = irStmtListAppend(tail, newIRExprStmt(newIRIntr(IRelease(), dst, irVoidT)))
    if head == -1 {
        head = tail
    }

    tail = irStmtListAppend(tail, lowStoreStmt(dst, srcUsed, t))
    if tmpNameIdx != -1 {
        // Detach the materialization temp from the value it just handed
        // to dst (see the materialization comment above) -- a plain `0`,
        // NULL-safe for retain/release, so the NEXT run of this same
        // statement's "release what the temp held before" (above) is a
        // no-op instead of a double-release.
        irStmtListAppend(tail, newIRAssign(newIRVarRef(tmpNameIdx, false, t), newIRIntConst(0, t)))
    }
    return head
}

// lowCountedStore is the ARC Task 4 store funnel for a heap-typed store to a
// NAMED slot (a local, a global, or a window var's per-instance field --
// every lowAssign/lowBlock-declared-initializer/window-var-default call
// site below). Lowers srcAst, then delegates to lowCountedStoreVal for the
// actual retain/release sequence -- see that function's own doc comment for
// the algorithm. The lowIsRecBearing/lowEscapeTrackableKind gates stay here,
// BEFORE src is computed: a record destination gets its own dedicated
// sequence (lowCountedStoreRec, a by-value C struct copy, not a single
// pointer swap -- the self-assign safety argument is different, see that
// function's own doc comment); a plain scalar destination (int/bool/fixed/
// char/enum/Rec-with-no-handle-fields/Str) needs no rc traffic at all and
// falls straight through to lowStoreStmt, unchanged from before this task.
func lowCountedStore(dst: int, srcAst: int, t: int): int {
    var src: int

    // ARC Task 7 site 1 (+ window-var defaults, which route through this
    // SAME funnel -- lowWinVarDefaultsStmts): a record destination gets its
    // OWN dedicated sequence (lowCountedStoreRec), never the Text/List/Map
    // logic below (a record is a by-value C struct copy, not a single
    // pointer swap -- the self-assign safety argument is different, see
    // that function's own doc comment). lowIsRecBearing already excludes an
    // all-scalar record (no rc traffic needed at all -- falls through to
    // the ordinary lowEscapeTrackableKind bypass below, an unconditional
    // plain byte-copy, unchanged from before this task).
    //
    // memory-leak-fix phase, fix round 3 (finding F-A): a heap-scalar
    // fixed array (`text[3]`, lowArrHeapScalarBearing) joins this SAME
    // branch. lowCountedStoreRec/lowCountedStoreRecVal's own sequence
    // (temp copy, retain-unless-birth, release dst's OLD value, store,
    // null the temp) is already GENERIC over t, not record-specific
    // despite the name -- lowNullValueAppend already recurses into KArr
    // (ARC fix-wave Task 2, Gap A) and IRetain/IRelease's own KArr arms
    // already walk array slots (fpRetainVal/cpEmitRetain host,
    // cgRetainAt native -- proven correct in round 2). Direct precedent:
    // lowIndexAssign's TyList branch already calls lowCountedStoreRecVal
    // for `arr[i] = recVal` where recVal is itself array-of-record
    // (lowIsRecBearing recurses into KArr), and testdata/leakgate/
    // arrstore.cla's own passing test proves a whole `Box[3] = Box[3]`
    // assignment already goes through this exact sequence correctly (a
    // record-typed array). Before this fix, `text[3]` matched NEITHER
    // lowIsRecBearing NOR lowEscapeTrackableKind, so a named-slot store
    // or declared-initializer of a heap-scalar array (e.g. `popped =
    // l.pop()` where `popped: text[3]`) fell through to the ordinary
    // lowEscapeTrackableKind bypass below -- an UNCOUNTED plain
    // byte-copy: nothing released what `popped` held before, a leak
    // (fix round 3's own repro: live=6, the prologue default-constructed
    // placeholder array orphaned).
    if lowIsRecBearing(t) or lowArrHeapScalarBearing(t) {
        return lowCountedStoreRec(dst, srcAst, t)
    }

    if not lowEscapeTrackableKind(irtKind(t)) {
        return lowStoreStmt(dst, lowExpr(srcAst), t)
    }

    src = lowExpr(srcAst)
    return lowCountedStoreVal(dst, srcAst, src, t)
}

// lowStmt lowers one statement, returning its irStmts index, or -1 for a
// statement that contributes no IR node.
func lowStmt(s: int): int {
    switch stmtKind(s) {
    case StExprStmt {
        return newIRExprStmt(lowExpr(exprStmtX(s)))
    }
    case StIf {
        return lowIf(s)
    }
    case StQuit {
        return lowQuit(s)
    }
    case StAssign {
        return lowAssign(s)
    }
    case StWhile {
        return lowWhile(s)
    }
    case StFor {
        return lowFor(s)
    }
    case StReturn {
        return lowReturn(s)
    }
    case StBreak {
        return newIRBreak()
    }
    case StContinue {
        return newIRContinue()
    }
    case StSwitch {
        return lowSwitch(s)
    }
    case StOpen {
        // `open W` as a bare statement (Ch5: Open) -- the reference is
        // created and discarded; ExOpen (lowExpr) is the assigned/returned
        // form (`w = open W`).
        return newIRExprStmt(newIRIntr(IUiOpen(), -1, irWinRefType(openStmtWindowName(s))))
    }
    case StClose {
        // `close w` (Ch5: Close) -- rt_ui_close takes just the instance
        // pointer; no window-type name is needed (unlike open/front, which
        // must know which descriptor to reference).
        return newIRExprStmt(newIRIntr(IUiClose(), lowExpr(closeX(s)), irVoidT))
    }
    case StCancel {
        // `cancel` (Ch5/Ch8) -- see IUiCancel's doc comment (ir.cla) for the
        // scratch-pointer convention it writes through.
        return newIRExprStmt(newIRIntr(IUiCancel(), -1, irVoidT))
    }
    case StEdit {
        return lowEditStmt(s)
    }
    case StAttempt {
        return lowAttempt(s)
    }
    }
    lowUnsupported("statement kind " + numToStr(int(stmtKind(s))))
    return -1
}

// lowAttempt lowers `attempt { body } aborted msg { handler }`
// (attempt-abort phase Task 2, design doc %3.1/%3.3) into the structured
// SAttempt IR node -- mirroring lowIf's own shape (irAttemptBody/
// irAttemptHandler are irIfThen/irIfElse's twins). The binder is a
// fresh, ordinary `string` local (Str255 value type, not one of
// lowEscapeTrackableKind's counted kinds, so it needs no scope-exit
// release -- unlike a for-loop's List/Map element borrow), scoped to the
// HANDLER block only, matching lowFor's own "push a scope, add+declare
// the loop var, lower the body, pop" shape (lowFor, above).
//
// Sets lowUsesAbort defensively (checkAttemptStmt already set it during
// checking -- see that flag's own doc comment for why it must be known
// before ANY function starts lowering, which is why this isn't the
// flag's only setter). Task 3/4 own how a checked call site inside
// `body` actually branches to `handler` on abort; this only emits the
// structural node both backends will walk to find body/handler -- their
// own cgStmt/fpStmt unmatched-case fallbacks reject SAttempt LOUDLY until
// then (verified by hand-run, see the task report).
func lowAttempt(s: int): int {
    var bodyHead: int
    var handlerHead: int
    var binderNameIdx: int

    lowUsesAbort = true
    bodyHead = lowBlock(attemptBody(s))
    binderNameIdx = attemptBinder(s)
    lowPushScope()
    lowAddLocal(binderNameIdx, irStrType(255))
    lowDeclareLocal(binderNameIdx)
    handlerHead = lowBlock(attemptHandler(s))
    lowPopScope()
    return newIRAttempt(bodyHead, binderNameIdx, handlerHead)
}

// lowEditEmit builds the IUiEdit Intr call (ir.cla's IUiEdit doc comment
// pins the arg shape) for one of lowEditStmt's three non-`new` target
// kinds: 1=RT_UI_WB_ADDR (opA the lvalue, opB unused/-1), 2=RT_UI_WB_LIST
// (opA the list, opB the index), 3=RT_UI_WB_MAP (opA the map, opB the key)
// -- opA/opB are already-lowered IR exprs. Shared tail so lowEditStmt's own
// branches stay flat.
func lowEditEmit(winNameIdx: int, kind: int, opA: int, opB: int): int {
    var kindConst: int

    kindConst = newIRIntConst(kind, irIntT)
    irExprListAppend(kindConst, opA)
    if opB != -1 {
        irExprListAppend(opA, opB)
    }
    return newIRExprStmt(newIRIntr(IUiEdit(), kindConst, irWinRefType(winNameIdx)))
}

// lowEditStmt lowers `edit F, target` / `edit F, new T` (Ch10: The Edit
// Statement). checkEditStmt already guarantees F is a form window and
// (isNew case) T matches its form record, or (target case) target's type
// equals the form record type -- but NOT that target is one of the four
// runtime-supported lvalue shapes (checkExpr accepts any expr of the right
// TYPE, including a shape like `xs[i].nested` that happens to select a
// field of the form record's own type nested inside another record): this
// function is what actually restricts target to a bare variable (global or
// window-scoped per-instance, both via lowExpr -- lowIdent/lowSelect's
// TyWindowRef case already produce an addressable FieldRef/VarRef either
// way), a list element, or a map element, rejecting anything else with the
// brief's own pinned message.
func lowEditStmt(s: int): int {
    var winNameIdx: int
    var target: int
    var xk: TypeKind

    winNameIdx = editForm(s)

    if editIsNew(s) {
        return lowEditEmit(winNameIdx, 0, -1, -1)
    }

    target = editTarget(s)
    if exprKind(target) == ExIdent {
        return lowEditEmit(winNameIdx, 1, lowExpr(target), -1)
    }
    if exprKind(target) == ExSelect and typeKind(exprTypeGet(selectX(target))) == TyWindowRef {
        return lowEditEmit(winNameIdx, 1, lowExpr(target), -1)
    }
    if exprKind(target) == ExIndex {
        xk = typeKind(exprTypeGet(indexX(target)))
        if xk == TyList {
            return lowEditEmit(winNameIdx, 2, lowExpr(indexX(target)), lowExpr(indexI(target)))
        }
        if xk == TyMap {
            return lowEditEmit(winNameIdx, 3, lowExpr(indexX(target)), lowExpr(indexI(target)))
        }
    }
    lowUnsupported("edit target must be a variable, list element, or map element")
    return -1
}

// lowWhile lowers `while cond { ... }` -- stmt.go's While case.
func lowWhile(s: int): int {
    var cond: int
    var body: int

    cond = lowExpr(whileCond(s))
    body = lowBlock(whileBody(s))
    return newIRWhile(cond, body)
}

// lowFor lowers all three `for` forms (Ch5: For) that the checker
// validates: an inclusive int range (ToExpr set), list iteration (one
// element var), and map iteration (key + optional value var) -- a port of
// stmt.go's lowerFor. Seq/ToExpr are lowered in the ENCLOSING scope
// (mirroring checkForStmt's own scope nesting), THEN the loop variable(s)
// are declared in a fresh scope wrapping the body.
//
// ARC Task 4: a list/map element-bound loop var (forV1's list branch,
// forV1/forV2's map branch) deliberately gets NEITHER a retain on bind NOR
// a release at scope exit -- it's a BORROW of the container's own element
// storage (fpForListStmt/fpForMapStmt materialize it as a fresh alias each
// iteration, never an owned +1), so retaining it would double-count an
// element the container still solely owns, and releasing it at loop-body
// scope exit would decrement a reference nothing here ever incremented (a
// spurious release, undercounting the container's real element towards
// zero while iterating it). This exclusion falls out of lowAddLocal here
// NEVER routing through a `var`-decl AST node (lowCollectScopeExitCandidates,
// the unconditional-release candidate collector, only ever walks
// blockVarsHead's `var` list) -- no explicit skip needed, just documented
// here so the omission reads as intentional.
// lowExcludeFreeName evicts nm from lowFreeNames/lowFreeTypes if present.
// ARC bug fix (task-5b, over-release/double-free class -- regression
// fixture testdata/run/lib/for_loop_var_alias.cla): a list/map element-
// bound for-loop variable (forV1's list branch, forV1/forV2's map branch,
// just below) is a BORROW of the container's own element storage --
// fpForListStmt/fpForMapStmt (cprint.cla) materialize it as a fresh alias
// each iteration, NEVER an owned +1 -- and lowCollectScopeExitCandidates'
// own doc comment says this exclusion "falls out of lowAddLocal here NEVER
// routing through a `var`-decl AST node", i.e. it assumes a loop variable's
// name can never also be a scope-exit release candidate.
//
// That assumption breaks when the SAME name is ALSO declared with an
// ordinary `var` in the enclosing function body (legal Clarus: checkForStmt
// always opens a fresh nested scope for forV1/forV2, so reusing an outer
// name is just ordinary shadowing) -- lowCollectScopeExitCandidates already
// added that outer declaration to lowFreeNames by the time lowFor runs (it
// is called once, up front, by lowRunEscapePrepass, before the body -- and
// any `for` inside it -- is lowered). cpEmitFunc (cprint.cla) then dedups
// ALL of a function's hoisted locals by (name, type) into exactly ONE C
// variable, so the outer var's owned slot and the loop's borrowed slot
// become the SAME storage: every iteration's unretained rt_map_val_at/
// rt_list_at overwrite lands in the outer var's owned cv_<name>, and the
// scope-exit release meant for the OUTER declaration then releases a
// reference the container itself still owns -- an over-release the
// container's own teardown walk (cpEmitRelease's rt_map_lastref/
// rt_list_lastref-gated walk) hits again, double-freeing. Reproduces even
// with an EMPTY loop body (testdata/cg68k/smoke.cla's smokeMapText -- see
// task-5b report) -- no value escape (`outer = v`) required; escaping just
// makes the corruption easier to notice via a wrong compare downstream.
//
// The loop-var borrow must always win: evicting here (before the body --
// and any `return` inside it, which also consults lowFreeNames, see
// lowReturn -- is lowered) guarantees the shared C variable is NEVER a
// release candidate, regardless of an outer declaration racing to add it
// first. Harmless no-op when the name was never a candidate (fresh loop-var
// name, the common/idiomatic style, or a non-counted-kind type like the
// map key's fixed string(255)).
func lowExcludeFreeName(nameIdx: int) {
    var nm: string
    var i: int
    var kept: list of string

    nm = poolGet(nameIdx)
    if not lowFreeTypes.has(nm) {
        return
    }
    i = 0
    while i < lowFreeNames.count {
        if lowFreeNames[i] != nm {
            kept.add(lowFreeNames[i])
        }
        i = i + 1
    }
    lowFreeNames = kept
    lowFreeTypes.remove(nm)
}

func lowFor(s: int): int {
    var seq: int
    var toExpr: int
    var body: int
    var n: int
    var seqT: int

    seq = lowExpr(forSeq(s))
    if forTo(s) != -1 {
        toExpr = lowExpr(forTo(s))
        lowPushScope()
        lowAddLocal(forV1(s), irIntT)
        lowDeclareLocal(forV1(s))
        body = lowBlock(forBody(s))
        n = newIRForRange(forV1(s), seq, toExpr, body)
        lowPopScope()
        return n
    }

    seqT = exprTypeGet(forSeq(s))
    if typeKind(seqT) == TyList {
        lowPushScope()
        lowAddLocal(forV1(s), lowType(typeElem(seqT)))
        lowDeclareLocal(forV1(s))
        lowExcludeFreeName(forV1(s))
        body = lowBlock(forBody(s))
        n = newIRForList(forV1(s), seq, body)
        lowPopScope()
        return n
    } else if typeKind(seqT) == TyMap or typeKind(seqT) == TySortedMap {
        lowPushScope()
        lowAddLocal(forV1(s), irStrType(255))
        lowDeclareLocal(forV1(s))
        lowExcludeFreeName(forV1(s))
        if forV2(s) != -1 {
            lowAddLocal(forV2(s), lowType(typeElem(seqT)))
            lowDeclareLocal(forV2(s))
            lowExcludeFreeName(forV2(s))
        }
        body = lowBlock(forBody(s))
        // SForMap is reused for BOTH map kinds (no new IR stmt kind) --
        // both backends key off irtKind(irExprType(irForMapMapV(s))) to
        // pick the right runtime accessors (cprint.cla's fpForMapStmt,
        // cg68k.cla's cgForMapStmt).
        n = newIRForMap(forV1(s), forV2(s), seq, body)
        lowPopScope()
        return n
    } else if typeKind(seqT) == TyIntMap {
        // map-hashtable phase Task 7: intmap's key local is IntT's own IR
        // type (irIntT), NOT irStrType(255) -- intmap keys are ints, not
        // Str255 pointers. SForMap is still reused (no new IR stmt kind);
        // both backends key off irtKind(irExprType(irForMapMapV(s))) to
        // fetch the key via rtIntMapKeyAt's return value instead of an
        // out-pointer Str255 copy.
        lowPushScope()
        lowAddLocal(forV1(s), irIntT)
        lowDeclareLocal(forV1(s))
        lowExcludeFreeName(forV1(s))
        if forV2(s) != -1 {
            lowAddLocal(forV2(s), lowType(typeElem(seqT)))
            lowDeclareLocal(forV2(s))
            lowExcludeFreeName(forV2(s))
        }
        body = lowBlock(forBody(s))
        n = newIRForMap(forV1(s), forV2(s), seq, body)
        lowPopScope()
        return n
    }
    lowUnsupported("cannot iterate for-loop sequence kind " + numToStr(int(typeKind(seqT))))
    return -1
}

// ================================================================
// ARC Task 8: unconditional scope-exit frees for every counted local
// ================================================================
//
// Every function/handler-body-top local of a counted kind (Text/List/Map
// via lowEscapeTrackableKind, or a handle-backed record/array-of-records
// via lowIsRecBearing) gets a full, unconditional release at scope exit
// (or immediately before a `return`, lowReturn below) -- no shallow-vs-deep
// distinction and no disqualification-by-handoff-site to compute.
//
// This drops the 4e-era escape-walk apparatus this section used to host
// (lowEscapeWalk*, lowFreeDisq/lowFreeUnsafe, lowEscapeFreshInit,
// lowEscapeHandoff(Unsafe), lowEscapeDisqAll -- deleted this task) because
// its whole reason to exist -- deciding when a scope-exit release might be
// unsound -- is now answered by construction, everywhere in the compiler:
//
//   - Every NAMED-SLOT store (local, global, window var, record field,
//     container element -- lowCountedStore/lowCountedStoreRec/lowElemIsBirth,
//     Tasks 3-7) retains before it lands unless the source is provably
//     fresh ("birth"). So whatever a local's own handle gets handed to
//     (an assignment RHS, a container push, a record field, a global) keeps
//     its OWN independent reference the instant it lands there -- the
//     local's own copy stays safe to release regardless.
//   - A user-function-call argument gets no caller-side retain (fpCallFn's
//     own doc comment: conservative, "a callee that does NOT retain it
//     leaks instead") -- but if the callee stores it anywhere persistent,
//     that store is ALSO one of the funnels above, and independently
//     retains. A scalar (non-record) parameter is never itself a
//     scope-exit candidate in the callee (lowFuncBody only adds params to
//     lowFreeNames for the handle-backed-RECORD case, which gets its own
//     retain-at-entry, ARC Task 7 site 2) -- so there's no double-release
//     at the call boundary either.
//   - Every container's own DEEP release walk (cpEmitRelease, cprint.cla)
//     is gated on `rt_list_lastref`/`rt_map_lastref` (Task 6 round 3) --
//     only the release that actually drops a shared container to rc==0
//     ever walks its elements, so two aliased owners releasing the same
//     container can no longer double-free what it holds. That was the
//     ONE remaining reason a local's OWN deep release used to need a
//     compile-time non-aliasing proof at all.
//   - `.get(k, dv)`'s key/default-value arguments and a form `edit`
//     target were the last two handoff sites still marked "genuinely
//     unsafe to release at all" under the old scheme -- neither actually
//     depended on the walker for correctness: IMapGetDv/IMapGetDvBirth
//     (cprint.cla) already retain/release their OWN default-value temp
//     correctly regardless of what fed it (see IMapGetDvBirth's own doc
//     comment for ARC Task 8's dv-orphan fix), and an `edit` target's
//     static type is always a record (checkEditStmt requires
//     `typeKind(tt) == TyRec`, never Text/List/Map), so the old marking
//     never actually reached a Text/List/Map release decision in the
//     first place -- confirmed dead before this deletion, not just after.
//
// Net effect of deleting the walker: it only ever WITHHELD a release
// (lowFreeUnsafe's skip, lowFreeDisq's shallow-only downgrade) -- it never
// caused one. Removing it can only turn a withheld release into a real
// one (closing a leak); it cannot turn a safe release into an unsafe one,
// since nothing above depended on the walker to BE safe -- the retain-on-
// store discipline and the lastref-gated container walk do that
// independently. Verified against the full `.leaks` corpus (see the
// task-8 report): every remaining nonzero count traced to a distinct
// emission bug (lowReturn's own return-value retain, IMapGetDv's
// dv-orphan, nested container elements) and fixed there, not by
// resurrecting a disqualify list.

// lowFreeNames: the CURRENT function's scope-exit-release candidate names
// (body-top locals of a counted kind only -- param-abi phase Task 7
// deleted the record/heap-scalar-array PARAM entries lowRetainRecParams
// used to add here, now that both backends pass KStr/KRec params by
// address and a param never owns its record's handles), in declaration
// order -- reset at the start of every lowRunEscapePrepass.
var lowFreeNames: list of string

// lowFreeTypes: candidate name -> IR type index.
var lowFreeTypes: map of int

// lowRetTempN counts synthesized `return`-value temps program-wide (never
// reused across functions -- see lowNewReturnTemp's own doc comment.
var lowRetTempN: int

// lowRetTempIdx caches the CURRENT function's own return-value synthetic
// local (its interned name-pool index), or -1 if this function hasn't
// needed one yet. Reset to -1 once per function/handler body by
// lowRunEscapePrepass (below) -- lowReturn (below) is only ever called
// while lowering ONE function's body, so this is never live across two
// functions at once.
var lowRetTempIdx: int

// lowNewReturnTemp returns the CURRENT function's own return-value
// synthetic local, creating it (a fresh, program-wide-unique name, never
// colliding with a user identifier -- Clarus identifiers can't start with
// `_`) on first use and reusing it for every subsequent `return` site in
// the SAME function (ARC Task 3 review fix: a function's return type is
// fixed for its whole body, so one shared local across all its `return`s
// is type-safe -- and required: a distinct local per return SITE, as this
// used to mint, means cpEmitFunc's function-prologue default-init
// (cpDefaultInit) constructs one fresh heap handle per un-taken sibling
// return, per call, that nothing ever releases -- a leak scaling with a
// function's return-statement count, not its call count. One shared local
// means exactly one prologue default-init, released by whichever return
// site actually executes -- see lowReturn's own release-before-store
// comment).
func lowNewReturnTemp(): int {
    if lowRetTempIdx != -1 {
        return lowRetTempIdx
    }
    lowRetTempN = lowRetTempN + 1
    lowRetTempIdx = intern("__ret" + numToStr(lowRetTempN))
    return lowRetTempIdx
}

// lowEscapeTrackableKind reports whether t is one of the five counted
// (Text/List/Map/SortedMap/IntMap) kinds this section's release machinery
// tracks by NAME (as opposed to lowIsRecBearing's record/array walk, which
// needs no such per-name bookkeeping) -- used throughout lower.cla wherever
// a birth/retain/release decision needs to know "is this a directly
// counted handle" (lowCountedStore, lowElemIsBirth, lowReturn, the
// globals/window-var release-walk gates).
func lowEscapeTrackableKind(k: IRKind): bool {
    return k == KText or k == KList or k == KMap or k == KSortedMap or k == KIntMap
}

// lowCollectScopeExitCandidates (ARC Task 4, generalized Task 8) adds
// every body-top local of a counted kind (lowEscapeTrackableKind), a
// handle-backed record/array-of-records (lowIsRecBearing), or a
// heap-scalar array (lowArrHeapScalarBearing -- ARC fix-wave Task 2, Gap A:
// a `text[n]` local otherwise matched NEITHER predicate and was silently
// never released) to lowFreeNames/lowFreeTypes -- bodyBlk's OWN vars list
// only (a function/handler body's top-level `var`s; a nested block never
// declares any, Ch4). Every candidate releases unconditionally at scope
// exit (lowBuildScopeExitFrees) regardless of how it was initialized or
// what it was later handed to -- see this section's own header comment for
// why that's sound.
func lowCollectScopeExitCandidates(bodyBlk: int) {
    var v: int
    var t: int
    var nm: string

    v = blockVarsHead(bodyBlk)
    while v != -1 {
        t = lowResolveType(varDeclType(v))
        if lowEscapeTrackableKind(irtKind(t)) or lowIsRecBearing(t) or lowArrHeapScalarBearing(t) {
            nm = poolGet(varDeclName(v))
            lowFreeNames.add(nm)
            lowFreeTypes[nm] = t
        }
        v = declNext(v)
    }
}

// lowRunEscapePrepass resets this function/handler body's own scope-exit
// bookkeeping and collects its release candidates -- called from
// lowFuncBody/lowHandlerFunc BEFORE lowBlock lowers that same body, so
// lowFreeNames/lowFreeTypes are ready for lowReturn to consult mid-body.
// Also resets lowRetTempIdx (ARC Task 3 review fix) -- lowNewReturnTemp's
// per-function cache -- to -1, so each function/handler body mints (at
// most) its own one shared return-value synthetic, never a stale one left
// over from the previous function.
func lowRunEscapePrepass(bodyBlk: int) {
    lowRetTempIdx = -1
    lowFreeNames.clear()
    lowCollectScopeExitCandidates(bodyBlk)
}

// lowBuildScopeExitFrees builds (and returns the head of) a fresh IR
// statement chain -- one SExprStmt(EIntr(name, EVarRef(x))) per name in
// lowFreeNames -- or -1 if lowFreeNames is empty. Declaration order
// (lowFreeNames' own order).
//
// ARC Task 8: every candidate releases, unconditionally, with the FULL
// deep intrinsic (I*FreeVar's handle + element walk for List/Map, plain
// IRelease for a record/array/Text -- Text has no elements to walk, so
// IRelease and ITextFreeVar print identical C for it). No shallow-vs-deep
// distinction and no skip-entirely case survive from the old escape walk
// -- see this section's header comment for why every one of those old
// carve-outs is now unconditionally safe.
func lowBuildScopeExitFrees(): int {
    var head: int
    var tail: int
    var nm: string
    var t: int
    var intrName: int
    var st: int

    head = -1
    tail = -1
    for nm in lowFreeNames {
        t = lowFreeTypes.get(nm, -1)
        if lowIsRecBearing(t) or lowArrHeapScalarBearing(t) {
            // ARC fix-wave Task 2, Gap A: a heap-scalar array (e.g.
            // text[n]) routes through IRelease -- its printer arm recurses
            // correctly into any KArr's .e[n] slots -- never through the
            // Text/List/Map-only I*FreeVar intrinsics below, which don't
            // know how to address an array at all.
            intrName = IRelease()
        } else {
            intrName = ITextFreeVar()
            if irtKind(t) == KList {
                intrName = IListFreeVar()
            } else if irtKind(t) == KMap {
                intrName = IMapFreeVar()
            } else if irtKind(t) == KSortedMap {
                intrName = ISortedMapFreeVar()
            } else if irtKind(t) == KIntMap {
                intrName = IIntMapFreeVar()
            }
        }
        st = newIRExprStmt(newIRIntr(intrName, newIRVarRef(intern(nm), false, t), irVoidT))
        if head == -1 {
            head = st
        }
        tail = irStmtListAppend(tail, st)
    }
    return head
}

// lowAppendTrailingFrees appends lowBuildScopeExitFrees' chain onto the end
// of bodyHead's top-level statement chain, UNLESS that chain's last
// statement is already an SReturn (which lowReturn already prefixed with
// its own copy of these same frees -- see lowReturn below) -- brief's Step
// 3: "if the last IR statement isn't an SReturn, append the same frees at
// the end." A body ending in `quit` (or any other non-SReturn statement
// that transfers control away, e.g. a fully-exhaustive if/else where every
// branch itself returns) still gets the frees appended textually here; they
// are simply unreachable C in that case (rt_quit calls exit() and never
// returns; a fully-exhaustive if/else's own branches already emitted their
// own frees before their own returns) -- harmless dead code, not a
// double-free, matching "quit mid-handler: no frees" by construction rather
// than by special-casing StQuit here.
func lowAppendTrailingFrees(bodyHead: int): int {
    var tail: int
    var freesHead: int

    if bodyHead != -1 {
        tail = bodyHead
        while irStmtNext(tail) != -1 {
            tail = irStmtNext(tail)
        }
        if irStmtKind(tail) == SReturn {
            return bodyHead
        }
    }
    freesHead = lowBuildScopeExitFrees()
    if freesHead == -1 {
        return bodyHead
    }
    if bodyHead == -1 {
        return freesHead
    }
    irStmtListAppend(tail, freesHead)
    return bodyHead
}

// lowEnsureTrailingReturn (attempt-abort phase Task 5 fix) guarantees
// bodyHead's own top-level statement chain ends in a real SReturn --
// a no-op if it already does (lowReturn's own inline release-before-
// return, or a previous call already fixed this up). Called only for a
// function that is about to get a bail block appended right after its
// own body (see lowFuncBody's own call site doc comment for the full
// rationale/repro: without this, normal execution can fall straight
// through into the bail block instead of actually returning, silently
// double-releasing this function's own scope-exit locals). When a real
// trailing return is missing, appends one: a bare `return` for a void
// function, or `return __retN` (lowRetTempIdx -- already minted and
// declared by lowFuncBody's own caller-side step, for ANY non-void ret,
// before this runs) otherwise -- exactly lowBuildAbortBailBlock's own
// return-value shape, safe here for the identical reason: this appended
// return is either the function's own genuine implicit exit (void, no
// prior explicit return) or provably unreachable dead code (a non-void
// function whose real paths already all returned -- lowAppendTrailingFrees'
// own documented case), never a path that actually needs a MEANINGFUL
// value.
func lowEnsureTrailingReturn(bodyHead: int, ret: int): int {
    var tail: int
    var retStmt: int

    if bodyHead != -1 {
        tail = bodyHead
        while irStmtNext(tail) != -1 {
            tail = irStmtNext(tail)
        }
        if irStmtKind(tail) == SReturn {
            return bodyHead
        }
    }
    if ret == irVoidT {
        retStmt = newIRReturn(-1)
    } else {
        retStmt = newIRReturn(newIRVarRef(lowRetTempIdx, false, ret))
    }
    if bodyHead == -1 {
        return retStmt
    }
    irStmtListAppend(tail, retStmt)
    return bodyHead
}

// lowReturn lowers `return` / `return expr` -- stmt.go's Return case. A
// value clamps through lowCoerceStr against the enclosing function's
// declared return type (lowCurFuncRet), exactly like a plain `var`
// initializer's store.
//
// ARC Task 8: EVERY scope-exit candidate still in scope (lowFreeNames) gets
// a free at this return point, unconditionally -- including, now, `x`
// itself when `return x` names a qualifying local directly (the old escape
// walker used to disqualify x for appearing as a return operand at all,
// specifically so this case could never arise; that disqualification is
// gone, so it now can). If the frees were simply emitted as statements
// preceding a plain `return <expr>`, the generated C would free `cv_t` and
// only THEN evaluate an expression that reads `cv_t` to build the actual
// return value -- a real use-after-free (this is exactly what `return x`
// itself would do now, and what `return "prefix" + t + "suffix"` -- t a
// concat operand -- always could). Fix: whenever there's at least one free
// to insert AND a value being returned, materialize that value into a
// fresh synthetic local FIRST (its own store, while every qualifying local
// is still alive), THEN free, THEN return the temp -- mirrors exactly how
// cprint.cla's own SReturn printer (Task 6) already handles its
// statement-level text temps (compute into a name, free, THEN emit `return
// name;`), just at the IR/lower.cla level instead of at print time. A bare
// `return` (no value) has no expression to protect, so its frees can
// precede it directly.
//
// ARC Task 3: the +1-return convention -- every heap-typed (text/list/map)
// user-function return is retained by the callee, so the caller always owns
// a fresh reference to release. This means the synthetic-local
// materialization above must now run for EVERY heap-typed return, not only
// the (rarer) case of a function with qualifying locals still to free: the
// retain has to see the SAME already-evaluated value the `return` statement
// hands back, exactly the double-evaluation hazard the doc comment above
// already solved for frees. So the gate widens from `freesHead != -1` to
// `freesHead != -1 or heapRet` -- once materialized, the retain (ARC Task 8:
// now GATED on the returned value's own birth-ness, see heapRetBirth below
// -- an already-fresh value needs no second retain) is appended right
// before the (possibly frees-preceded) `return`. lowEscapeTrackableKind
// (Text/List/Map) is the heap-typed test here; a handle-backed record
// (KRec) return gets the analogous recRet treatment just below.
func lowReturn(s: int): int {
    var x: int
    var rawX: int
    var freesHead: int
    var tail: int
    var tmpNameIdx: int
    var storeStmt: int
    var retRef: int
    var heapRet: bool
    var heapRetBirth: bool
    var recRet: bool
    var head: int

    x = -1
    heapRetBirth = false
    if returnX(s) != -1 {
        // ARC Task 8 fix (known open leak bug 1): birth check computed on
        // rawX (returnX(s) lowered but NOT yet coerced), mirroring
        // lowCountedStore's own src-before-coercion timing exactly --
        // lowStoreIsBirth/lowStoreIntrOwnsResult are the SAME two
        // predicates every other counted store site applies, plus the SAME
        // Str->Text widening override lowCountedStore's own KStr branch
        // uses (a Str source feeding a Text-typed return always coerces
        // through lowCoerceStr's ITextOfStr, which ALWAYS constructs a
        // fresh box, regardless of returnX(s)'s own shape -- e.g. `func f():
        // text { return s }` where s: string). Previously this branch
        // always retained heapRet unconditionally, over-retaining an
        // already-fresh widened value with nothing to balance it -- a
        // permanent 2-block leak per call, reproduced in isolation with no
        // push/list/map involved (widen_text.cla's own `widenTextMakeText`).
        rawX = lowExpr(returnX(s))
        heapRetBirth = lowStoreIsBirth(returnX(s)) or lowStoreIntrOwnsResult(rawX)
        if irtKind(lowCurFuncRet) == KText and irtKind(irExprType(rawX)) == KStr {
            heapRetBirth = true
        }
        x = lowCoerceStr(lowCurFuncRet, rawX)
    }

    freesHead = lowBuildScopeExitFrees()
    if x == -1 {
        if freesHead == -1 {
            return newIRReturn(-1)
        }
        tail = freesHead
        while irStmtNext(tail) != -1 {
            tail = irStmtNext(tail)
        }
        irStmtListAppend(tail, newIRReturn(-1))
        return freesHead
    }

    heapRet = lowEscapeTrackableKind(irtKind(lowCurFuncRet))
    // ARC Task 7 site 3: a handle-backed record return type gets the SAME
    // synthetic-materialization treatment as heapRet (Text/List/Map) --
    // retain-walk the materialized return value, a genuine +1 transfer,
    // mirroring Task 3's own convention for the other heap kinds.
    // memory-leak-fix phase, fix round 3 (finding F-B): a heap-scalar
    // fixed array (`text[3]`) joins this SAME branch -- neither heapRet
    // nor the old recRet recognized it, so a function returning `text[3]`
    // never retained its return value at all while the local's own
    // scope-exit release still fired (fix round 3's own repro: two
    // `l.push(makeArr(...))` calls -> rt_rc: over-release). The retain
    // gate just below (`recRet and not lowRecStoreIsBirth(...)`) already
    // works unchanged for the array case -- lowRecStoreIsBirth is a pure
    // AST-shape check (ExCall), not record-specific (see round 2's own
    // reasoning), and lowStoreStmt/IRetain/IRelease are already generic
    // over KArr.
    recRet = lowIsRecBearing(lowCurFuncRet) or lowArrHeapScalarBearing(lowCurFuncRet)
    if freesHead == -1 and not heapRet and not recRet {
        return newIRReturn(x)
    }

    tmpNameIdx = lowNewReturnTemp()
    lowAddLocal(tmpNameIdx, lowCurFuncRet)
    retRef = newIRVarRef(tmpNameIdx, false, lowCurFuncRet)
    head = -1
    if heapRet or recRet {
        // cpEmitFunc's function-prologue default-init (cpDefaultInit)
        // unconditionally constructs EVERY declared local at function
        // entry, including this synthetic one -- a fresh, unshared,
        // rc==1 handle nothing else can reach before the store below
        // overwrites it. Release it here or every heap-typed return would
        // leak one allocation per call now that this synthetic local is
        // created for ALL of them (not just the rarer frees-needed case) --
        // this is the same "default-init orphan" class Task 4 later closes
        // generically for every local store, but that mechanism doesn't
        // exist yet and this synthetic local is Task 3's own creation, so
        // it can't wait. Correct for recRet too: cpDefaultInit's KRec
        // branch constructs a fresh clar_new_<Rec>() for the same reason.
        head = newIRExprStmt(newIRIntr(IRelease(), newIRVarRef(tmpNameIdx, false, lowCurFuncRet), irVoidT))
    }
    storeStmt = lowStoreStmt(retRef, x, lowCurFuncRet)
    if head == -1 {
        head = storeStmt
    } else {
        irStmtListAppend(head, storeStmt)
    }
    tail = storeStmt
    while irStmtNext(tail) != -1 {
        tail = irStmtNext(tail)
    }

    // ARC Task 4 review-fix: the return-value retain MUST run BEFORE the
    // scope-exit frees below, not after. Every scope-exit candidate
    // releases unconditionally now (ARC Task 8), including the one just
    // returned: `return localVar` stores localVar's pointer into the
    // synthetic just above (aliasing, no rc change yet) -- retaining the
    // synthetic FIRST bumps rc to >=2 before freesHead's release of
    // localVar decrements it back to >=1: the object survives long enough
    // to be handed back at the final `return`. Retaining AFTER freesHead
    // (the old position) would let localVar's own release drop a rc==1
    // object to 0 -- disposed -- while the synthetic (the SAME pointer) is
    // still about to be retained and returned: a use-after-free on the
    // exact common case this function exists to protect (`return x` for a
    // local `x`).
    if heapRet and not heapRetBirth {
        // ARC Task 8: gated on birth-ness now (see heapRetBirth above) --
        // an already-fresh returned value (a literal, a concat, a slice, any
        // call result, or a Str->Text widening) already carries its own
        // uncontested +1 into the synthetic via the plain byte-copy store
        // just above; retaining it again here would be an unbalanced leak,
        // not merely a missed optimization. A non-birth value (a bare
        // local/global/field/element reference) still needs its own +1,
        // same as before.
        tail = irStmtListAppend(tail, newIRExprStmt(newIRIntr(IRetain(), newIRVarRef(tmpNameIdx, false, lowCurFuncRet), irVoidT)))
    } else if recRet and not lowRecStoreIsBirth(returnX(s)) {
        // ARC Task 7: the analogous gate for a handle-backed record return
        // -- see heapRet's own comment just above for the shared reasoning
        // (lowRecStoreIsBirth is lowStoreIsBirth's record-shaped
        // counterpart, same birth-vs-retain rule).
        tail = irStmtListAppend(tail, newIRExprStmt(newIRIntr(IRetain(), newIRVarRef(tmpNameIdx, false, lowCurFuncRet), irVoidT)))
    }
    if freesHead != -1 {
        irStmtListAppend(tail, freesHead)
        tail = freesHead
        while irStmtNext(tail) != -1 {
            tail = irStmtNext(tail)
        }
    }
    irStmtListAppend(tail, newIRReturn(newIRVarRef(tmpNameIdx, false, lowCurFuncRet)))
    return head
}

// lowAssign lowers `lvalue = expr` (stmt.go's lowerAssign): `l[i] = v`
// routes through lowIndexAssign; everything else (a plain variable) is a
// normal store through lowStoreStmt.
// isWindowTitleSelect reports whether e is `w.title` where w is a window
// INSTANCE value (Ch8: title is "assignable at runtime") -- used to route
// the ASSIGNMENT form to IUiSetTitle directly, before ever reaching
// lowSelect/lowWindowInstSelect (whose own `.title` case, IUiGetTitle,
// handles the READ form instead -- see that function's doc comment).
// lowTitleIdx memoizes "title"'s own interned pool index (layer1-compiler-
// perf phase Task 14, findings 1.5) -- isWindowTitleSelect compares
// selectName(e) (already an interned int) directly against it instead of
// poolGet'ing a fresh string copy just to re-compare. Reset to -1 at the
// top of lowerProgram every compile (memory-leak-fix Task 7) -- see that
// reset's own comment.
var lowTitleIdx: int = -1

func isWindowTitleSelect(e: int): bool {
    if exprKind(e) != ExSelect {
        return false
    }
    if lowTitleIdx == -1 {
        lowTitleIdx = intern("title")
    }
    if selectName(e) != lowTitleIdx {
        return false
    }
    return typeKind(exprTypeGet(selectX(e))) == TyWindowRef
}

// isBareWindowTitleIdent reports whether e is a BARE `title` reference
// inside a window-scoped handler body (Task 5) -- windowScope declares
// "title" as its own scope symbol (check.cla's windowScope), so the bare
// form is a plain ExIdent, never an ExSelect like isWindowTitleSelect's
// explicit `w.title` shape; not a local var (which would shadow it, per
// windowScope's own scope nesting -- see lowIdent's matching guard).
func isBareWindowTitleIdent(e: int): bool {
    if exprKind(e) != ExIdent {
        return false
    }
    if lowCurWinType == -1 {
        return false
    }
    if lowIsLocal(identName(e)) {
        return false
    }
    return poolGet(identName(e)) == "title"
}

// isWidgetPropSelect reports whether e is `w.Widget.prop` -- e's own base
// (`w.Widget`) checks as the TyWidget pseudo-type (Ch8: Widgets' runtime
// properties).
func isWidgetPropSelect(e: int): bool {
    if exprKind(e) != ExSelect {
        return false
    }
    return typeKind(exprTypeGet(selectX(e))) == TyWidget
}

// isMenuNameIdent reports whether e is a bare Ident naming a declared menu
// (check.cla's Symbol.isMenu) -- mirrors checkSelect's own menu-name guard.
func isMenuNameIdent(e: int): bool {
    var symIdx: int

    if exprKind(e) != ExIdent {
        return false
    }
    symIdx = scopeLookup(curScope, identName(e))
    return symIdx != -1 and symbols[symIdx].isMenu
}

// isMenuItemEnabledSelect reports whether e is `MenuName.ItemName.enabled`
// (Ch9: Runtime Menu-Item Property) -- the only per-spec menu-item op, and
// rt_ui.h has no getter for it (rt_ui_menu_enable is write-only), so this
// shape is only ever handled as an assignment LHS; lowSelect has no
// TyMenuItem case at all (see its own header note).
func isMenuItemEnabledSelect(e: int): bool {
    var inner: int

    if exprKind(e) != ExSelect {
        return false
    }
    if poolGet(selectName(e)) != "enabled" {
        return false
    }
    inner = selectX(e)
    if exprKind(inner) != ExSelect {
        return false
    }
    return isMenuNameIdent(selectX(inner))
}

// lowMenuEnableAssign lowers `MenuName.ItemName.enabled = b` to
// rt_ui_menu_enable(menuIdx, itemIdx, b) -- menuIdx is the 0-based
// declaration-order index (uiMenuIdx, populated by lowMenuDecl) and itemIdx
// is the item's 0-based position in its menu's declared entry list
// (uiMenuItemIdx), matching rt_ui_menu_enable's contract (see rt_ui.c's
// usage and probe_ui.c's kProbeMenuHandlers).
func lowMenuEnableAssign(lhs: int, rhsAst: int): int {
    var inner: int
    var menuName: string
    var itemName: string
    var menuIdx: int
    var itemIdx: int
    var head: int
    var tail: int

    inner = selectX(lhs)
    menuName = poolGet(identName(selectX(inner)))
    itemName = poolGet(selectName(inner))
    menuIdx = uiMenuIdx.get(numToStr(progGen) + "|" + menuName, -1)
    itemIdx = uiMenuItemIdx.get(menuKey(menuName, itemName), -1)

    head = newIRIntConst(menuIdx, irIntT)
    tail = irExprListAppend(head, newIRIntConst(itemIdx, irIntT))
    tail = irExprListAppend(tail, lowExpr(rhsAst))
    return newIRExprStmt(newIRIntr(IUiMenuEnable(), head, irVoidT))
}

// lowWidgetSetAssign lowers `w.Widget.prop = rhs` (Ch8: Widgets' runtime
// properties, write half) -- covers rt_ui.h's ABI as built: caption
// (button)/text (label, field) via rt_ui_widget_set_str, checked (check)/
// enabled (button, field) via rt_ui_widget_set_bool, text (textview) via
// rt_ui_widget_set_text (mac-target-4c Task 2). field.text reuses
// IUiSetText directly rather than minting its own intrinsic: field.text is
// strT(255) (check.cla's widgetRuntimeProps), the same Str shape label.text
// already writes, so lowExpr(rhsAst) below produces an identical
// fpStrAddr-able value either way and cprint.cla's IUiSetText case emits the
// exact same rt_ui_widget_set_str(..., RTUI_PROP_TEXT, ...) call for both
// widget kinds -- see cprint.cla's IUiSetText case. `title` is handled
// separately (isWindowTitleSelect, above it in lowAssign) since it's a
// window property, not a widget one.
func lowWidgetSetAssign(lhs: int, rhsAst: int): int {
    var wgSel: int
    var recv: LowWidgetRecv
    var widgetKind: string
    var propName: string
    var widgetIdx: int
    var head: int
    var tail: int
    var intrName: int

    wgSel = selectX(lhs)
    recv = lowWidgetRecv(wgSel)
    widgetKind = findWidgetKind(recv.winNameIdx, recv.wgName)
    widgetIdx = uiWidgetIndex(recv.winNameIdx, recv.wgName)
    propName = poolGet(selectName(lhs))

    intrName = -1
    if widgetKind == "button" and propName == "caption" {
        intrName = IUiSetCaption()
    } else if (widgetKind == "label" or widgetKind == "field") and propName == "text" {
        intrName = IUiSetText()
    } else if widgetKind == "textview" and propName == "text" {
        intrName = IUiSetTextviewText()
    } else if widgetKind == "check" and propName == "checked" {
        intrName = IUiSetChecked()
    } else if (widgetKind == "button" or widgetKind == "field") and propName == "enabled" {
        intrName = IUiSetEnabled()
    } else if (widgetKind == "popup" or widgetKind == "table") and propName == "selected" {
        intrName = IUiSetSelected()
    }
    if intrName == -1 {
        lowUnsupported("set of " + widgetKind + "." + propName)
        return -1
    }

    head = recv.instIR
    tail = irExprListAppend(head, newIRIntConst(widgetIdx, irIntT))
    tail = irExprListAppend(tail, lowCoerceStr(lowMustType(lhs), lowExpr(rhsAst)))
    return newIRExprStmt(newIRIntr(intrName, head, irVoidT))
}

func lowAssign(s: int): int {
    var lhs: int
    var ty: int
    var head: int

    lhs = assignLHS(s)
    if exprKind(lhs) == ExIndex {
        return lowIndexAssign(lhs, assignRHS(s))
    }
    if exprKind(lhs) == ExSelect and typeKind(exprTypeGet(selectX(lhs))) == TyXRec {
        // Task 4 (toolbox-integration Feature B): a scalar extern-record
        // field write (`ev.what = x`) -- a whole-record assign (`ev2 =
        // ev`, lhs itself TyXRec) never reaches lowAssign at all, banned
        // at check time ("extern records cannot be assigned"), so lhs here
        // is always a scalar leaf.
        return lowXRecFieldWrite(lhs, lowExpr(assignRHS(s)))
    }
    if isMenuItemEnabledSelect(lhs) {
        return lowMenuEnableAssign(lhs, assignRHS(s))
    }
    if isWindowTitleSelect(lhs) {
        head = lowExpr(selectX(lhs))
        irExprListAppend(head, lowExpr(assignRHS(s)))
        return newIRExprStmt(newIRIntr(IUiSetTitle(), head, irVoidT))
    }
    if isBareWindowTitleIdent(lhs) {
        head = lowWinInstRef()
        irExprListAppend(head, lowExpr(assignRHS(s)))
        return newIRExprStmt(newIRIntr(IUiSetTitle(), head, irVoidT))
    }
    if isWidgetPropSelect(lhs) {
        return lowWidgetSetAssign(lhs, assignRHS(s))
    }
    ty = lowMustType(lhs)
    return lowCountedStore(lowExpr(lhs), assignRHS(s), ty)
}

// lowIndexAssign lowers `x[i] = rhs` (stmt.go's lowerIndexAssign): a fixed
// ARRAY element write (never heap-typed -- Ch12's serializable-field rules
// and this language's own array usage never construct a Text/List/Map
// array; ARC's own staged migration leaves arrays qualified/untouched, same
// as record fields, pending a later task) reuses IndexRef as an lvalue
// through lowStoreStmt (same printer contract as a read); string/text
// writes have no lvalue form and lower to their set-index intrinsic as an
// ExprStmt instead.
//
// ARC Task 5: a LIST element write of a heap-tracked elem type routes
// through the NEW IListSet/IListSetRetain intrinsic pair instead of
// lowStoreStmt -- lowStoreStmt's own ITextStore branch mutates an EXISTING
// Text box IN PLACE (safe only when provably unshared), which a container
// element is NOT once elements are aliasable/counted (the same class of bug
// ARC Task 4's Bug 2 fixed for named slots); IListSet(Retain) additionally
// releases the REPLACED element, which the old plain-Assign path never did
// at all. A non-heap-tracked list element (int/bool/fixed/char/enum/string)
// keeps the OLD lowStoreStmt/IndexRef path unchanged -- no rc traffic to
// add there. A MAP write's rhs goes through lowCoerceStr against the map's
// OWN elem type -- IMapSet(Retain)'s C printer copies rhs's OWN struct type
// into a temp before taking its address (same class of bug lowListMethod's
// push/unshift value guards against) -- and, for a heap-tracked value type,
// picks IMapSetRetain over IMapSet by the SAME retain-unless-birth rule
// lowListMethod's push/unshift now use (lowElemIsBirth); cprint.cla's
// shared IMapSet(Retain) printer branch ALWAYS emits the upsert's
// has/get/release guard for the replaced value, regardless of which name is
// chosen (see fpMapReleaseGuard's own doc comment).
func lowIndexAssign(lhs: int, rhsAst: int): int {
    var xk: TypeKind
    var x: int
    var i: int
    var rhs: int
    var rawRhs: int
    var elemTy: int
    var intrName: int

    xk = typeKind(exprTypeGet(indexX(lhs)))
    x = lowExpr(indexX(lhs))
    i = lowExpr(indexI(lhs))
    rhs = lowExpr(rhsAst)
    if xk == TyArr {
        // ARC fix-wave Task 2, Part 1: a fixed array has no rc of its own,
        // but each SLOT does when the element type is heap-bearing -- x/i/
        // rhs are already lowered above (reused here, never re-lowered, so
        // a side-effecting rhs never runs twice). Mirrors lowCountedStore's
        // own top-level dispatch (lowIsRecBearing / lowEscapeTrackableKind),
        // just against the pre-lowered rhs via the *Val extractions instead
        // of re-lowering rhsAst.
        // memory-leak-fix phase, fix round 3 (F-family sweep): elemTy can
        // itself be a heap-scalar array (a NESTED array, e.g. storing a
        // whole `text[3]` slice into `text[3][2]`'s own element) --
        // lowArrHeapScalarBearing joins lowIsRecBearing here too, same
        // mutual-exclusion reasoning as lowCountedStore's own fix above.
        elemTy = lowMustType(lhs)
        if lowIsRecBearing(elemTy) or lowArrHeapScalarBearing(elemTy) {
            return lowCountedStoreRecVal(newIRIndexRef(x, i, elemTy), rhsAst, rhs, elemTy)
        } else if lowEscapeTrackableKind(irtKind(elemTy)) {
            return lowCountedStoreVal(newIRIndexRef(x, i, elemTy), rhsAst, rhs, elemTy)
        }
        return lowStoreStmt(newIRIndexRef(x, i, elemTy), rhs, elemTy)
    } else if xk == TyList {
        elemTy = lowMustType(lhs)
        // memory-leak-fix phase, fix round 2: lowArrHeapScalarBearing
        // joins the early-bail guard too -- a `text[3]`-typed elemTy is
        // neither lowEscapeTrackableKind nor lowIsRecBearing, so it used
        // to fall through to the plain, uncounted lowStoreStmt below
        // (no retain of the new value, no release of the old one either).
        if not lowEscapeTrackableKind(irtKind(elemTy)) and not lowIsRecBearing(elemTy) and not lowArrHeapScalarBearing(elemTy) {
            return lowStoreStmt(newIRIndexRef(x, i, elemTy), rhs, elemTy)
        }
        rawRhs = rhs
        intrName = IListSet()
        // ARC Task 7 site 4 (overwrite): mirrors the push/unshift birth
        // split just above -- lowElemIsBirth for Text/List/Map,
        // lowRecStoreIsBirth for a record-bearing OR array-heap-scalar-
        // bearing element (fix round 2), mutually exclusive gates -- the
        // `else` below already covers BOTH once the guard above admits
        // the array case, no further change needed here.
        if lowEscapeTrackableKind(irtKind(elemTy)) {
            if not lowElemIsBirth(rhsAst, rawRhs, elemTy) {
                intrName = IListSetRetain()
            }
        } else if not lowRecStoreIsBirth(rhsAst) {
            intrName = IListSetRetain()
        }
        rhs = lowCoerceStr(elemTy, rawRhs)
        irExprListAppend(x, i)
        irExprListAppend(i, rhs)
        return newIRExprStmt(newIRIntr(intrName, x, irVoidT))
    } else if xk == TyStr {
        irExprListAppend(x, i)
        irExprListAppend(i, rhs)
        return newIRExprStmt(newIRIntr(IStrSetIndex(), x, irVoidT))
    } else if xk == TyText {
        irExprListAppend(x, i)
        irExprListAppend(i, rhs)
        return newIRExprStmt(newIRIntr(ITextSetIndex(), x, irVoidT))
    } else if xk == TyMap {
        elemTy = irtElem(irExprType(x))
        intrName = IMapSet()
        if lowEscapeTrackableKind(irtKind(elemTy)) and not lowElemIsBirth(rhsAst, rhs, elemTy) {
            intrName = IMapSetRetain()
        } else if (lowIsRecBearing(elemTy) or lowArrHeapScalarBearing(elemTy)) and not lowRecStoreIsBirth(rhsAst) {
            // ARC Task 7 site 4: map-of-record upsert, same rule as list.
            // memory-leak-fix phase, fix round 2: map-of-array-of-Text/
            // List/Map upsert joins the same branch.
            intrName = IMapSetRetain()
        }
        rhs = lowCoerceStr(elemTy, rhs)
        irExprListAppend(x, i)
        irExprListAppend(i, rhs)
        return newIRExprStmt(newIRIntr(intrName, x, irVoidT))
    } else if xk == TySortedMap {
        elemTy = irtElem(irExprType(x))
        intrName = ISortedMapSet()
        if lowEscapeTrackableKind(irtKind(elemTy)) and not lowElemIsBirth(rhsAst, rhs, elemTy) {
            intrName = ISortedMapSetRetain()
        } else if (lowIsRecBearing(elemTy) or lowArrHeapScalarBearing(elemTy)) and not lowRecStoreIsBirth(rhsAst) {
            // ARC Task 7 site 4: sortedmap-of-record upsert, same rule as
            // map/list. memory-leak-fix phase, fix round 2:
            // sortedmap-of-array-of-Text/List/Map upsert joins the same
            // branch.
            intrName = ISortedMapSetRetain()
        }
        rhs = lowCoerceStr(elemTy, rhs)
        irExprListAppend(x, i)
        irExprListAppend(i, rhs)
        return newIRExprStmt(newIRIntr(intrName, x, irVoidT))
    } else if xk == TyIntMap {
        // map-hashtable phase Task 7: the key (i) is an int, pushed
        // directly (no lowCoerceStr -- that only applies to the VALUE);
        // otherwise identical to Map/SortedMap's own upsert-guard shape.
        elemTy = irtElem(irExprType(x))
        intrName = IIntMapSet()
        if lowEscapeTrackableKind(irtKind(elemTy)) and not lowElemIsBirth(rhsAst, rhs, elemTy) {
            intrName = IIntMapSetRetain()
        } else if (lowIsRecBearing(elemTy) or lowArrHeapScalarBearing(elemTy)) and not lowRecStoreIsBirth(rhsAst) {
            // ARC Task 7 site 4: intmap-of-record upsert, same rule as
            // map/sortedmap/list. memory-leak-fix phase, fix round 2:
            // intmap-of-array-of-Text/List/Map upsert joins the same
            // branch.
            intrName = IIntMapSetRetain()
        }
        rhs = lowCoerceStr(elemTy, rhs)
        irExprListAppend(x, i)
        irExprListAppend(i, rhs)
        return newIRExprStmt(newIRIntr(intrName, x, irVoidT))
    }
    lowUnsupported("index-assign of unsupported kind " + numToStr(int(xk)))
    return -1
}

// lowIf lowers `if cond { ... } [else { ... } | else if ...]` -- a port of
// stmt.go's lowerIf. Else is -1 (no else), a StBlock, or another StIf
// (an else-if chain), mirroring ast.go's Stmt-typed Else.
func lowIf(s: int): int {
    var cond: int
    var thenHead: int
    var elseNode: int
    var elseHead: int

    cond = lowExpr(ifCond(s))
    thenHead = lowBlock(ifThen(s))
    elseHead = -1
    elseNode = ifElse(s)
    if elseNode != -1 {
        if stmtKind(elseNode) == StBlock {
            elseHead = lowBlock(elseNode)
        } else if stmtKind(elseNode) == StIf {
            elseHead = lowIf(elseNode)
        } else {
            lowUnsupported("if-else shape")
        }
    }
    return newIRIf(cond, thenHead, elseHead)
}

// lowQuit lowers `quit [code]` -- stmt.go's lowerQuit, extended for
// mac-target-4b's final-review fix (the quit cascade, reference doc's Quit
// Semantics ~line 767): a UI-free program still lowers to Intr(IQuit)
// (bare `quit` supplies IntConst 0) exactly as before -- the differential
// suite pins this byte-for-byte. A UI program (irIsUiProgram(), cprint.cla
// -- the same predicate that gates main()/dispatcher emission) instead
// lowers to a call to IUiQuit (runtime/mac/rt_ui.c's rt_ui_quit: the
// closeRequest cascade over every open window). Relies on irIsUiProgram()
// already being accurate at THIS point in lowerProgram's single top-to-
// bottom pass -- true as long as every window/menu/every declaration in
// the source comes before the code that needs it, the only order Clarus
// source ever writes it in (see uiMenuIdx's own doc comment above for the
// same documented assumption elsewhere in this file).
// ARC Task 4: locals release before the quit call now (freesHead, both
// branches) -- was a no-op (no frees ever emitted here) before this task;
// safe now that a "free" is a release (Task 1's rt_*_free alias), and the
// scope-exit walk is unconditional (lowBuildScopeExitFrees). Global cleanup
// still runs via the existing rt_quit/rt_ui_quit hook, untouched here (Task
// 6's scope). Ordering: any code-expression side effects evaluate FIRST
// (unchanged from before this task), frees run next (locals are read, if
// at all, only by that already-evaluated code expression), and the actual
// quit call is always last.
func lowQuit(s: int): int {
    var code: int
    var codeStmt: int
    var call: int
    var freesHead: int
    var head: int
    var tail: int

    head = -1
    tail = -1

    if irIsUiProgram() {
        if quitCode(s) != -1 {
            // Ch5/line 624: the exit code is accepted-and-ignored on the
            // Macintosh -- the VALUE, not its evaluation, so a
            // user-supplied expression still runs once, for any side
            // effects, right before the cascade (same relative order a
            // non-UI `quit` already gives it as rt_quit's argument).
            // ponytail: a literal-only code expr (`quit 5`, no side
            // effects) prints as a no-op statement here (e.g. "5;") --
            // harmless at runtime but would trip -Wunused-value under
            // -Wall/-Werror; no scenario in this codebase writes `quit
            // <expr>` in a UI program (only bare `quit`, which skips this
            // branch entirely) to have caught it. Upgrade path if one ever
            // does: skip this statement when lowExpr's node is a plain
            // IntConst/etc.
            codeStmt = newIRExprStmt(lowExpr(quitCode(s)))
            head = codeStmt
            tail = codeStmt
        }
        freesHead = lowBuildScopeExitFrees()
        if freesHead != -1 {
            if head == -1 {
                head = freesHead
            } else {
                irStmtListAppend(tail, freesHead)
            }
            tail = freesHead
            while irStmtNext(tail) != -1 {
                tail = irStmtNext(tail)
            }
        }
        call = newIRExprStmt(newIRIntr(IUiQuit(), -1, irVoidT))
        if head == -1 {
            return call
        }
        irStmtListAppend(tail, call)
        return head
    }

    if quitCode(s) == -1 {
        code = newIRIntConst(0, irIntT)
    } else {
        code = lowExpr(quitCode(s))
    }
    call = newIRExprStmt(newIRIntr(IQuit(), code, irVoidT))
    freesHead = lowBuildScopeExitFrees()
    if freesHead == -1 {
        return call
    }
    tail = freesHead
    while irStmtNext(tail) != -1 {
        tail = irStmtNext(tail)
    }
    irStmtListAppend(tail, call)
    return freesHead
}

// lowNewSwitchTemp names one switch desugar's subject temp. The "__switch"
// prefix keeps it out of the way of any user-declared local -- Clarus
// source identifiers are never expected to start with a double underscore
// -- and lowSwitchN is program-wide (never reset per function) so nested/
// sibling switches never collide even when several land in the same
// function body -- stmt.go's newSwitchTemp.
func lowNewSwitchTemp(): int {
    lowSwitchN = lowSwitchN + 1
    return intern("__switch" + numToStr(lowSwitchN))
}

// lowLabelEq builds `tmp == label`: a plain int/char/enum comparison, or
// `str_cmp(tmp, label) == 0` for a string subject (a case label is always a
// literal, bare enum member, or const Ident -- checkCaseLabel's "must be a
// constant" rule) -- stmt.go's labelEq.
func lowLabelEq(subjT: int, ty: int, tmpNameIdx: int, lbl: int): int {
    var ref: int
    var lblExpr: int
    var cmp: int
    var zero: int

    ref = newIRVarRef(tmpNameIdx, false, ty)
    lblExpr = lowExpr(lbl)
    if typeKind(subjT) == TyStr {
        irExprListAppend(ref, lblExpr)
        cmp = newIRIntr(IStrCmp(), ref, irIntT)
        zero = newIRIntConst(0, irIntT)
        return newIRBin(intern("=="), cmp, zero, irBoolT)
    }
    return newIRBin(intern("=="), ref, lblExpr, irBoolT)
}

// lowCaseCond builds one case's condition: its label(s), OR'd together when
// there's more than one (`case 2, 3`) -- stmt.go's caseCond.
func lowCaseCond(subjT: int, ty: int, tmpNameIdx: int, labelsHead: int): int {
    var cond: int
    var eq: int
    var lbl: int

    cond = -1
    lbl = labelsHead
    while lbl != -1 {
        eq = lowLabelEq(subjT, ty, tmpNameIdx, lbl)
        if cond == -1 {
            cond = eq
        } else {
            cond = newIRBin(intern("or"), cond, eq, irBoolT)
        }
        lbl = exprNext(lbl)
    }
    return cond
}

// lowSwitch desugars `switch subject { case labels {body} ... [else
// {body}] }` into: the subject expression evaluated exactly ONCE into a
// synthesized function-local temp (so a subject with side effects, e.g. a
// function call, never re-runs per case), followed by an
// if/else-if/.../else chain comparing that temp against each case's
// label(s) -- cases are iterated in REVERSE, each wrapping the
// previously-built chain as its Else, so the final result is exactly TWO
// chained statements: the subject store, then one nested If -- stmt.go's
// lowerSwitch.
//
// The desugared chain is pure IR If/Assign -- no C loop or switch construct
// is ever emitted for it -- so a `break`/`continue` lowered from inside a
// case body automatically binds whatever LOOP lexically encloses the
// switch, never the switch itself, with no special-casing required here.
func lowSwitch(s: int): int {
    var subjT: int
    var ty: int
    var tmpNameIdx: int
    var storeIdx: int
    var tailHead: int
    var caseIdxs: list of int
    var cs: int
    var i: int
    var cond: int
    var body: int

    subjT = exprTypeGet(switchSubject(s))
    ty = lowType(subjT)
    tmpNameIdx = lowNewSwitchTemp()
    lowAddLocal(tmpNameIdx, ty)
    storeIdx = lowStoreStmt(newIRVarRef(tmpNameIdx, false, ty), lowExpr(switchSubject(s)), ty)

    tailHead = -1
    if switchElse(s) != -1 {
        tailHead = lowBlock(switchElse(s))
    }

    cs = switchCasesHead(s)
    while cs != -1 {
        caseIdxs.add(cs)
        cs = stmtNext(cs)
    }

    i = caseIdxs.count - 1
    while i >= 0 {
        cond = lowCaseCond(subjT, ty, tmpNameIdx, caseLabelsHead(caseIdxs[i]))
        body = lowBlock(caseBody(caseIdxs[i]))
        tailHead = newIRIf(cond, body, tailHead)
        i = i - 1
    }

    irStmtListAppend(storeIdx, tailHead)
    return storeIdx
}

// lowBlock lowers one StBlock's local `var`s (flattened into the current
// function's locals chain) then its statements, in a fresh nested scope, and
// returns the statement-chain head (-1 if empty) -- stmt.go's lowerBlock.
func lowBlock(blk: int): int {
    var head: int
    var tail: int
    var v: int
    var t: int
    var dst: int
    var s: int
    var st: int

    lowPushScope()
    head = -1
    tail = -1

    v = blockVarsHead(blk)
    while v != -1 {
        t = lowResolveType(varDeclType(v))
        lowAddLocal(varDeclName(v), t)
        lowDeclareLocal(varDeclName(v))
        if varDeclInit(v) != -1 {
            dst = newIRVarRef(varDeclName(v), false, t)
            st = lowCountedStore(dst, varDeclInit(v), t)
            if head == -1 {
                head = st
            }
            // lowCountedStore (ARC Task 4) can return a multi-node chain
            // (retain/materialize + release + store), not always the single
            // node lowStoreStmt alone used to -- walk to its TRUE end, same
            // fix the statement loop just below already applies for
            // lowSwitch's own multi-node return.
            tail = irStmtListAppend(tail, st)
            while irStmtNext(tail) != -1 {
                tail = irStmtNext(tail)
            }
        }
        v = declNext(v)
    }

    s = blockStmtsHead(blk)
    while s != -1 {
        st = lowStmt(s)
        if st != -1 {
            if head == -1 {
                head = st
            }
            // lowStmt normally returns one node (its own .next left at -1
            // by every newIRXxx constructor), but lowSwitch returns a
            // 2-node chain (the subject store, already linked to its
            // if-chain via .next) -- walk to the chain's TRUE end so the
            // next statement appends after it, not in the middle.
            tail = irStmtListAppend(tail, st)
            while irStmtNext(tail) != -1 {
                tail = irStmtNext(tail)
            }
        }
        s = stmtNext(s)
    }

    lowPopScope()
    return head
}

// ================================================================
// Declaration + top-level lowering (lower.go / stmt.go subset)
// ================================================================

// lowFuncBody lowers params + a body block into an ir.Func, registering the
// signature scope and returning its irFuncs index (stmt.go's lowerFuncBody).
//
// param-abi phase Task 7: this used to run lowRetainRecParams here --
// retain-walking each handle-backed record/heap-scalar-array param and
// prepending the retain statements via lowPrependStmts (both now deleted)
// -- because a C struct param used to be passed BY VALUE, so the callee's
// own copy silently aliased the caller's handle-field pointers with no
// retain of its own. Tasks 5-6 made both backends pass KStr/KRec params
// BY ADDRESS instead: a param never owns its record's handles at all (the
// caller, or the call-site copy-temp, does), so the entry retain + its
// matching scope-exit release were a balanced but pure-waste pair -- and
// registering params into lowFreeNames/lowFreeTypes is gone with them, so
// a param is never a scope-exit-release candidate. The KArr case (still
// C by-value-copy on the host lane) is sound too: Task 2's immutability
// makes the slot-store mutation that used to alias-corrupt the caller's
// copy a compile error, so the callee's own aliased copy is simply never
// written through and never released -- ownership stays with the caller,
// balanced without any retain.
func lowFuncBody(nameIdx: int, astParamsHead: int, ret: int, bodyBlk: int, runtimeOrigin: bool): int {
    var paramsHead: int
    var paramsTail: int
    var p: int
    var loc: int
    var savedRet: int
    var savedRtOrigin: bool
    var bodyHead: int
    var fn: int

    lowPushScope()

    // onlog phase: mirror `runtimeOrigin` into module state for the
    // duration of THIS body's lowering (saved/restored in the same shape
    // as savedRet just below, so a future nested caller cannot leak it),
    // so lowCall's `log()` arm can tell a user statement from a runtime
    // module's own -- see lowCurFnRuntimeOrigin's own doc comment.
    savedRtOrigin = lowCurFnRuntimeOrigin
    lowCurFnRuntimeOrigin = runtimeOrigin

    paramsHead = -1
    paramsTail = -1
    p = astParamsHead
    while p != -1 {
        loc = newIRLocal(paramName(p), lowResolveType(paramType(p)))
        if paramsHead == -1 {
            paramsHead = loc
        }
        paramsTail = irLocalListAppend(paramsTail, loc)
        lowDeclareLocal(paramName(p))
        p = declNext(p)
    }

    lowLocalsHead = -1
    lowLocalsTail = -1
    savedRet = lowCurFuncRet
    lowCurFuncRet = ret
    lowRunEscapePrepass(bodyBlk)
    bodyHead = lowBlock(bodyBlk)
    bodyHead = lowAppendTrailingFrees(bodyHead)
    lowCurFuncRet = savedRet

    if not runtimeOrigin and lowUsesAbort and ret != irVoidT {
        // attempt-abort phase Task 5 fix: the bail block's own return
        // statement hands back lowNewReturnTemp's __retN (see
        // lowBuildAbortBailBlock's own doc comment) -- it must be minted
        // and DECLARED (lowAddLocal) HERE, before newIRFunc below freezes
        // lowLocalsHead into the IRFunc record, not inside
        // lowBuildAbortBailBlock itself (which runs AFTER newIRFunc): a
        // function whose body declares no locals of its own and never
        // needed __retN during its own ordinary return-statement lowering
        // (no `var`s, one `return <simple expr>`) reaches this point with
        // lowLocalsHead still -1 -- adding a local afterward only updates
        // the module-level lowLocalsHead/lowLocalsTail bookkeeping
        // variables, never the value already COPIED into the IRFunc
        // record's own localsHead field (a plain int, not a live
        // reference), silently orphaning it. Reproduced compiling
        // testsuite/core once cases_abort.cla made it abort-enabled:
        // `use of undeclared identifier 'cv___retN'` -- most core-suite
        // cases return a small all-scalar TestResult with no local vars
        // of their own.
        lowAddLocal(lowNewReturnTemp(), ret)
    }
    if not runtimeOrigin and lowUsesAbort {
        // attempt-abort phase Task 5 fix (found compiling testsuite/core
        // once cases_abort.cla made it abort-enabled -- `rt_rc:
        // over-release` on a plain, unrelated case like StrConcatClamp):
        // a bail block is printed TEXTUALLY right after this function's
        // own ordinary body (cpEmitFunc/cgEmitFunc), reached ONLY via an
        // explicit `goto`/branch -- never by falling off the end of the
        // ordinary body. But a function whose own body doesn't end in a
        // real SReturn -- a void function with no explicit trailing
        // `return` (legal; C's own implicit end-of-function return
        // normally covers it) or a non-void function whose tail is an
        // exhaustive if/else where every branch already returns
        // internally (lowAppendTrailingFrees' own documented "dead code"
        // case) -- has NOTHING stopping normal execution from falling
        // STRAIGHT THROUGH into the bail block once one exists,
        // double-releasing this function's own scope-exit locals a
        // SECOND time. Reproduced exactly this way:
        // `coreCliRunAndReport` (testsuite/core/runner.cla) is void with
        // no trailing `return`; its own `cv_coreResults` list got
        // released once by its normal trailing frees, then again by
        // falling through into `bail:`'s own release. Fix: whenever this
        // function is getting a bail block, guarantee its body ends in a
        // real SReturn first (lowEnsureTrailingReturn is a no-op if it
        // already does).
        bodyHead = lowEnsureTrailingReturn(bodyHead, ret)
    }

    fn = newIRFunc(nameIdx, paramsHead, ret, lowLocalsHead, bodyHead)
    // attempt-abort phase Task 2, Ruling A2/A3: a runtime-origin function
    // gets tagged (never gets a bail block -- runtime code is
    // conventionally forbidden from using attempt/abort, design doc %3.4,
    // so it never needs one); otherwise, in an abort-enabled program
    // (lowUsesAbort, already known-final by now -- see its own doc
    // comment, check.cla), build+attach this function's shared bail
    // block using lowFreeNames/lowFreeTypes' STILL-VALID snapshot for
    // THIS function (lowRunEscapePrepass above set it, lowBuildScopeExit
    // Frees below reads it, and it isn't reset again until the NEXT
    // function's own lowRunEscapePrepass call) -- must happen here, not
    // in a later pass, or the exact release list this function's own
    // trailing-frees already used would no longer be available.
    if runtimeOrigin {
        irFuncMarkRuntimeOrigin(fn)
    } else if lowUsesAbort {
        irFuncSetBail(fn, lowBuildAbortBailBlock(ret))
    }
    lowCurFnRuntimeOrigin = savedRtOrigin
    lowPopScope()
    return fn
}

// lowBuildAbortBailBlock (attempt-abort phase Task 2, Ruling A2) builds
// the CURRENT function's shared bail block: release every scope-exit
// candidate still tracked in lowFreeNames/lowFreeTypes -- the EXACT same
// walk lowAppendTrailingFrees/lowReturn already use via
// lowBuildScopeExitFrees (not duplicated by hand, per the ruling) --
// then return ret's default/zero value. Called once per (non-runtime-
// origin) function, from lowFuncBody, right after that function's own
// body finishes lowering; attached to the IRFunc via irFuncSetBail. Both
// backends' Task 3/4 own how to actually branch here as a target -- this
// only builds and attaches the IR.
//
// Task 5 fix (task-1-report P5 probe (a) -- __retN leak -- AND a second,
// independently-found bug: `newIRReturn(newIRIntConst(0, ret))` is only
// valid C/68k for a SCALAR or heap-pointer (Text/List/Map/SortedMap/
// IntMap -- 0 == NULL) return type. For any STRUCT-shaped return type --
// KRec, KArr, or a bounded KStr (`string(N)`) -- a bare `0` is not a
// value of that type at all; this broke as soon as a real abort-enabled
// program contained a record/string-returning function (testsuite/core's
// OWN convention: every `caseXxx(): TestResult` -- surfaced immediately
// by Task 5's own cases_abort.cla, `returning 'int' from a function with
// incompatible result type 'clar_rec_TestResult'`).
//
// Both bugs share one fix: instead of synthesizing a fresh literal value,
// reuse (or, if this function never needed one, mint) the SAME synthetic
// return-value local `lowReturn` itself uses (lowNewReturnTemp's __retN)
// and return THAT, by ordinary value/handoff -- not a release. This
// works uniformly for every return kind because __retN is an ordinary
// declared IRLocal: both backends' existing function-prologue default-
// init (cpDefaultInit / cg68k's own per-local init) already knows how to
// zero-construct ANY type correctly (struct compound-literal, NULL
// pointer, zeroed scalar), and both backends' existing `return <a named
// local>` machinery (cgEmitReturnRec/cgEmitReturnStr's generic
// address-and-copy tail, cprint's plain `return cv_name;`) already knows
// how to hand one back correctly, for every kind, since ordinary
// user-written `return` statements naming a local do this constantly.
// No new per-kind dispatch is needed (unlike the original release-based
// draft of this fix, reverted -- see git history), and no double-
// release/UAF risk: bail and a real `return` site's own store into
// __retN are mutually exclusive within one call activation, so whenever
// this block runs, __retN still holds exactly its function-prologue
// default-init value, and handing that off (not releasing it) is exactly
// what an ordinary `return` of a fresh value already does.
//
// This also fully closes the __retN-leak class probe (a) flagged,
// WITHOUT a dedicated release step here: a heap/rec-typed __retN handed
// off this way becomes an ordinary tracked call result at the FIRST
// caller/checked-call-site above this frame (fpNewTrackedTmp/
// cgNewTrackedTmp, exactly as any other checked call's return value is),
// where it is released like any other pending statement-scoped temp on
// the aborting branch -- the SAME machinery cgEmitAbortCheck/
// fpEmitAbortCheck's own Task 5 fix (probe (b)) already added. Verified
// empirically (task-5-report.md): probe (a)'s fixture goes from
// live=4000 (2000 iters, unfixed) to live=0.
//
// lowRetTempIdx is ALREADY minted and declared by the time this runs
// (lowFuncBody's own pre-newIRFunc step, for exactly this reason -- see
// its own doc comment) whenever ret != irVoidT, so this reads it
// directly rather than calling lowNewReturnTemp/lowAddLocal again.
func lowBuildAbortBailBlock(ret: int): int {
    var head: int
    var tail: int
    var retStmt: int

    head = lowBuildScopeExitFrees()
    if ret == irVoidT {
        retStmt = newIRReturn(-1)
    } else {
        retStmt = newIRReturn(newIRVarRef(lowRetTempIdx, false, ret))
    }
    if head == -1 {
        return retStmt
    }
    tail = head
    while irStmtNext(tail) != -1 {
        tail = irStmtNext(tail)
    }
    irStmtListAppend(tail, retStmt)
    return head
}

// declIsRuntimeOrigin (attempt-abort phase Task 2, Ruling A3; fixed
// twice at Task 8 close-out -- see below) reports whether decl d was
// parsed from a runtime-module source file -- task-1-report P2's chosen
// mechanism (getDeclFile + a path check) for the "never check after
// this callee" tag Tasks 3/4 consume via irFuncIsRuntimeOrigin. NOT
// bkPathIsUitest's basename-suffix trick (bake.cla) -- ruled explicitly,
// not Task 2's call to revisit.
//
// Task 8 close-out, fix round 1: the ORIGINAL check was a literal
// path-PREFIX match (path[0, want.length] == "runtime/clarus/"), which
// broke for the default (no --rtdir) rtDir resolution itself, not just
// a --rtdir override -- findRtDir (drive.cla) walks UPWARD from the
// working directory, prepending one "../" per level, so a compile
// launched from any directory other than the repo root (every Go test
// package in this tree) records paths like
// "../../runtime/clarus/core.cla", which does not START WITH the
// literal prefix at all. Found via TestSnapshotFixedPoint's own
// freshness check. First fix attempt: search for "runtime/clarus/" as a
// SUBSTRING anywhere in path -- repaired the upward-search case, but
// review (fix round 1) correctly flagged that this widens the OTHER,
// dangerous failure direction: a USER file whose own path happens to
// CONTAIN "runtime/clarus/" anywhere (not just as its actual root)
// would be misclassified as runtime-origin, silently DROPPING its
// abort-propagation check -- lost propagation, the worst failure mode
// this feature has. Not reachable by anything in this tree today (no
// fixture/example lives at such a path, and the Mac lane's colon-form
// disk paths can't spell the '/'-form substring at all -- see below),
// but a real, wider risk surface than the original bug, and not
// something a compiler meant to gain outside users should ship.
//
// Task 8 close-out, fix round 2 (superseded by fix round 3 below --
// history kept, not condensed): replaced the substring heuristic with a
// predicate comparing against the RAW `rtDir` global directly (`readPath[0,
// rtDir.length] == rtDir`, mirroring expand()'s own unrelated key2 check).
// This closed fix round 1's dangerous direction (a decl path merely
// CONTAINING "runtime/clarus/" anywhere was misclassified as
// runtime-origin) but re-review found it reopened the ORIGINAL,
// safe-direction bug for one class of input: `rtDir` is compared RAW,
// while every recorded decl path is `normalizePath`'d (drive.cla's
// `expand`, host branch: `readPath = normalizePath(rawPath)`) before
// storage. Any `--rtdir` spelling containing a lexically-cancelable
// segment -- a leading `./` is the natural case -- collapses in the
// stored decl path but NOT in the raw `rtDir` used for comparison, so
// the prefix match fails and real runtime functions are misclassified
// as non-runtime-origin again (spurious bail-block/`__retN` scaffolding
// -- reproduced on `rtSetLastErr`/`rtArrCheck` under `--rtdir
// ./runtime/clarus/`). Not reachable via any committed gate (all of
// which use either the default search or the canonical
// `--rtdir runtime/clarus/`, no leading dot), but the fix's own doc
// comment (this one) had claimed correctness "whatever [rtDir's] own
// spelling happens to be" -- which was false for this case.
//
// Task 8 close-out, fix round 3 (this fix): normalize `rtDir` through
// the exact SAME `normalizePath` function the decl path itself went
// through, at the one point they're compared -- not a second, ad-hoc
// cleanup routine, and not a fix scattered across every place `rtDir`
// happens to get assigned (main.cla's `--rtdir` parsing, findRtDir's
// two call sites) which would need auditing again every time a future
// caller sets `rtDir` a new way. `normalizePath` strips trailing
// separators as a side effect of rebuilding from '/'-joined segments
// (e.g. `normalizePath("./runtime/clarus/")` == `"runtime/clarus"`, no
// trailing slash) -- a bare prefix match against that WOULD reopen a
// narrower boundary gap of its own (a decl path
// `"runtime/clarusFOO/evil.cla"` would wrongly match a 14-char prefix
// `"runtime/clarus"` with no separator to rule it out), so a single
// trailing `/` is restored after normalizing before comparing, matching
// the directory-prefix shape `rtDir` always denotes.
//
// Two comparisons remain, matching how the two lanes actually record a
// runtime-module decl's path (read from expand()/driveKeyResolve in
// drive.cla before choosing either):
//
//   - Host lane (hostPaths true): normalize `rtDir` (findRtDir's search
//     result or an explicit --rtdir, whatever its own spelling), restore
//     the trailing '/' normalizePath dropped, and prefix-match the decl
//     path against THAT -- correct for every `--rtdir` spelling that
//     denotes the same real directory (with or without `./`, with or
//     without a trailing slash), and still correct for the default
//     upward-search case (already lexically clean, so normalizing is a
//     no-op there). A user file would need to sit inside that EXACT
//     resolved directory to collide -- i.e., it would genuinely BE a
//     runtime module for this compile, not a false positive.
//   - Mac lane (hostPaths false): `rtDir` is never populated on this
//     lane -- runtime-module identity there is always the baked-resource
//     KEY string (rtModuleKey/driveKeyResolve), a '/'-separated
//     "runtime/clarus/<file>" form, stored verbatim via setDeclFile
//     (expand()'s `path = ... key2 ...`/`path = key2` arms) -- distinct
//     BY CONSTRUCTION from ordinary Mac disk paths, which drivePathJoin/
//     driveMacDirOf always spell in HFS colon form (":Volume:Dir:file.cla")
//     and can therefore never contain a '/' at all, let alone this exact
//     substring. A literal prefix match against the key-space constant
//     is exactly right here, and was ALREADY correct before any Task 8
//     fix round -- neither the substring-widening risk (fix round 1) nor
//     the raw-vs-normalized gap (fix round 2) ever applied to this lane.
func declIsRuntimeOrigin(d: int): bool {
    var p: int
    var path: string
    var want: string
    var normRtDir: string

    p = getDeclFile(d)
    if p == -1 {
        return false
    }
    path = poolGet(p)
    if hostPaths {
        if rtDir == "" {
            return false
        }
        normRtDir = normalizePath(rtDir)
        if normRtDir == "" or normRtDir[normRtDir.length - 1] != '/' {
            normRtDir = normRtDir + "/"
        }
        return path.length >= normRtDir.length and path[0, normRtDir.length] == normRtDir
    }
    want = "runtime/clarus/"
    return path.length >= want.length and path[0, want.length] == want
}

// lowFuncDecl lowers a user `func` declaration into an ir.Func (stmt.go's
// lowerFuncDecl): resolve the declared return type (void if none), then
// lowFuncBody registers the signature scope and lowers the body.
func lowFuncDecl(d: int) {
    var ret: int

    if funcDeclRetType(d) != -1 {
        ret = lowResolveType(funcDeclRetType(d))
    } else {
        ret = irVoidT
    }
    lowFuncBody(funcDeclName(d), funcDeclParamsHead(d), ret, funcDeclBody(d), declIsRuntimeOrigin(d))
}

// lowTopHandler lowers a top-level `on App.launch`/`startEmpty`/`startCLI`
// handler into an ir.Func plus the matching Program flag (stmt.go's
// lowerTopHandlerDecl). Any other handler event is host-unsupported (Task 4+).
func lowTopHandler(d: int) {
    var path: string
    var parts: list of string
    var root: string
    var event: string
    var symIdx: int
    var slot: int
    var fnNameIdx: int

    path = poolGet(handlerDeclPath(d))
    if path == "App.launch" {
        lowFuncBody(intern("handler_App_launch"), -1, irVoidT, handlerDeclBody(d), false)
        irHasLaunch = true
    } else if path == "App.startEmpty" {
        lowFuncBody(intern("handler_App_startEmpty"), -1, irVoidT, handlerDeclBody(d), false)
        irHasStartEmpty = true
    } else if path == "App.startCLI" {
        lowFuncBody(intern("handler_App_startCLI"), handlerDeclParamsHead(d), irVoidT, handlerDeclBody(d), false)
        irHasStartCLI = true
    } else if path == "App.openDocument" {
        lowFuncBody(intern("handler_App_openDocument"), handlerDeclParamsHead(d), irVoidT, handlerDeclBody(d), false)
        irHasOpenDocument = true
    } else if path == "App.log" {
        // onlog phase. No `irHasLog` program flag: unlike every handler
        // above, nothing in either backend's startup emission needs to
        // know -- the only consumer is lowerProgram's own pre-pass
        // (lowHasAppLog, already set before this point) and the
        // synthesized dispatcher it drives, both of which live entirely
        // in this file. Keeping it out of ir.cla also keeps it out of
        // bake.cla's bkWriteIrScalars, which would otherwise be a CLIR
        // format-version bump for a value the runtime bake can never
        // carry anyway (a runtime module never declares this handler).
        lowFuncBody(intern("handler_App_log"), handlerDeclParamsHead(d), irVoidT, handlerDeclBody(d), false)
    } else {
        // Connection-var handlers (serial-connection phase, Task 5): `on
        // <connvar>.<event>` for a GLOBAL `connection` var -- checkTop-
        // HandlerDecl (check.cla) already proved root resolves to a
        // TyConnection symbol and event is one of opened/received/
        // closed/failed before this ever checks clean, so no re-
        // validation is needed here, only the same root/event split.
        // Every other path (App.* names not matched above, listener/
        // serviceBrowser vars, or any other target) still falls to the
        // generic diagnostic below -- Task 4+ territory, untouched.
        parts = splitDots(path)
        root = parts[0]
        event = parts[1]
        symIdx = scopeLookup(curScope, intern(root))
        if symIdx != -1 and symbols[symIdx].typeIdx == connectionT {
            // lowConnSlotOf is guaranteed to already carry `root`:
            // lowerProgram's own pre-pass (usesConn-gated, same as this
            // whole branch's premise -- symbols[symIdx].typeIdx ==
            // connectionT can only hold true when usesConn is true) walks
            // every global connection var BEFORE the main decl walk that
            // reaches this function ever starts. An `on <var>.<event>`
            // handler's target can only ever be a global per spec %3.3
            // (checkTopHandlerDecl enforces it), so -- unlike
            // lowConnMethod's receiver, which can be shadowed by a local
            // of the same name (final-review Important 2) -- `root` here
            // needs no lowIsLocal guard: this whole branch runs at
            // top-level decl lowering, never inside a function body.
            slot = lowConnSlotOf.get(root, -1)
            fnNameIdx = intern("handler_" + root + "_" + event)
            lowFuncBody(fnNameIdx, handlerDeclParamsHead(d), irVoidT, handlerDeclBody(d), false)
            lowConnHandlerFn[numToStr(slot) + "|" + event] = fnNameIdx
        } else {
            // Task 4+: resource handlers (listener/serviceBrowser) are
            // unsupported.
            lowUnsupported("handler " + path)
        }
    }
}

// lowRecordDecl builds the record's IRRecordLayout (field slots with their
// lowered type and constant default) -- a port of lower.go's
// lowerRecordDecl. Field TYPES are read back from check.cla's own
// recordFieldsHead/fieldInfos side table (checkRecordDecl already resolved
// them, walking the exact same AST field chain in the exact same order) --
// simpler than lower.go's independent re-resolution, and correct for the
// same reason lowResolveType's named-type case is: curScope/fieldInfos are
// still the very tables checkProgram built, untouched since.
func lowRecordDecl(d: int) {
    var f: int
    var fi: int
    var fieldsHead: int
    var fieldsTail: int
    var ft: int
    var dv: int
    var defaultVal: int
    var defaultStr: int
    var slot: int

    if recordDeclIsXRec(d) {
        // Task 4 (toolbox-integration Feature B): an `extern record`'s
        // fields have no counterpart in check.cla's fieldInfos byte/word
        // distinction (both read back as plain IntT there -- see
        // checkXRecFieldType's own doc comment), so this walks the AST
        // field chain directly instead of fieldInfos, and builds a
        // completely different IRRecordLayout shape (xkind/xn-carrying
        // field slots, no defaults, isXRec not isOverlay).
        lowXRecDecl(d)
        return
    }

    fieldsHead = -1
    fieldsTail = -1
    f = recordDeclFieldsHead(d)
    fi = recordFieldsHead(recordDeclName(d))
    while f != -1 {
        ft = fieldInfos[fi].typeIdx
        defaultVal = 0
        defaultStr = -1
        if fieldDefault(f) != -1 {
            dv = lowExpr(fieldDefault(f))
            if typeKind(ft) == TyStr or typeKind(ft) == TyText {
                defaultStr = irStrConstIdx(dv)
            } else {
                defaultVal = irIntConstV(dv)
            }
        } else if typeKind(ft) == TyEnum {
            // Ch3: an enum-typed field with no explicit default starts at
            // the first declared member, whose value may be non-zero.
            defaultVal = enumMembers[typeElem(ft)].value
        }
        slot = newIRFieldSlot(fieldName(f), lowType(ft), defaultVal, defaultStr)
        if fieldsHead == -1 {
            fieldsHead = slot
        }
        fieldsTail = irFieldSlotListAppend(fieldsTail, slot)
        f = declNext(f)
        fi = fieldInfos[fi].next
    }
    newIRRecordLayout(recordDeclName(d), fieldsHead, recordDeclIsOverlay(d))
}

// lowXRecDecl builds an `extern record`'s IRRecordLayout (Task 4,
// toolbox-integration Feature B) -- lowRecordDecl's dedicated xrec path.
// Walks the AST field chain directly (never fieldInfos -- see
// lowRecordDecl's own doc comment on why), deriving each field's xkind/xn
// straight from its TypeExprKind: this is the ONE place that mapping is
// made, read back later by irXRecFieldSize/irXRecFieldAlign (ir.cla).
// Lookup-before-append guard (mirrors irRegisterExtern's own, Task 3):
// Ch13's dedup rule lets an identical `extern record NAME` redeclare
// clean, and lowDecl's main walk still visits BOTH AST decl nodes (never
// pruned -- same "don't share/prune nodes across merged decls" invariant
// Task 3's own forward note states for extern funcs), so without this
// guard a merged duplicate would grow irRecords to two entries for one
// name; checkRecordDecl has already proven, by the time lowering runs,
// that two same-name xrecs are either field-for-field identical or a
// build error, so a bare name lookup here is safe.
func lowXRecDecl(d: int) {
    var f: int
    var fieldsHead: int
    var fieldsTail: int
    var k: TypeExprKind
    var name: string
    var nameIdx: int
    var xkind: int
    var xn: int
    var t: int
    var slot: int

    nameIdx = recordDeclName(d)
    if irFindRecordLayoutByName(nameIdx) != -1 {
        return
    }
    fieldsHead = -1
    fieldsTail = -1
    f = recordDeclFieldsHead(d)
    while f != -1 {
        k = typeExprKind(fieldType(f))
        xn = 0
        if k == TxWord {
            xkind = XFWord
            t = irIntT
        } else if k == TxByte {
            xkind = XFByte
            t = irIntT
        } else if k == TxXStr {
            xkind = XFStr
            xn = xstrTypeN(fieldType(f))
            t = irStrType(xn)
        } else if k == TxPad {
            xkind = XFPad
            xn = padTypeN(fieldType(f))
            t = irVoidT
        } else {
            // TxNamed: bool/int/ptr, or a nested extern record -- the only
            // shapes checkXRecFieldType accepts for TxNamed (a
            // checker-clean program never reaches lowering with any
            // other TxNamed spelling here).
            name = poolGet(namedTypeName(fieldType(f)))
            if name == "bool" {
                xkind = XFBool
                t = irBoolT
            } else if name == "int" {
                xkind = XFInt
                t = irIntT
            } else if name == "ptr" {
                xkind = XFPtr
                t = irPtrT
            } else {
                xkind = XFRec
                t = irXRecType(namedTypeName(fieldType(f)))
            }
        }
        slot = newIRXRecFieldSlot(fieldName(f), t, xkind, xn)
        if fieldsHead == -1 {
            fieldsHead = slot
        }
        fieldsTail = irFieldSlotListAppend(fieldsTail, slot)
        f = declNext(f)
    }
    newIRRecordLayoutXRec(nameIdx, fieldsHead)
}

// lowEnumDecl builds the enum's IREnumLayout, replicating checkEnumDecl's
// auto-numbering (member's own value, or previous+1) and label default
// (member's own label, or its name) -- a port of lower.go's lowerEnumDecl.
func lowEnumDecl(d: int) {
    var m: int
    var head: int
    var tail: int
    var val: int
    var next: int
    var label: int
    var mem: int

    head = -1
    tail = -1
    next = 0
    m = enumDeclMembersHead(d)
    while m != -1 {
        if enumMemberHasValue(m) {
            val = enumMemberValue(m)
        } else {
            val = next
        }
        label = enumMemberLabel(m)
        if label == -1 {
            label = enumMemberName(m)
        }
        mem = newIREnumMember(enumMemberName(m), val, label)
        if head == -1 {
            head = mem
        }
        tail = irEnumMemberListAppend(tail, mem)
        next = val + 1
        m = declNext(m)
    }
    newIREnumLayout(enumDeclName(d), head)
}

// lowGlobalVarDecl lowers one top-level `var` into an ir.Global -- a port of
// lower.go's lowerGlobalVarDecl. Globals are appended in the same
// source-order traversal lowerProgram itself uses, so Program.Globals order
// matches declaration order.
func lowGlobalVarDecl(d: int) {
    var t: int
    var init: int
    var initAst: int
    var isBirth: bool

    // Connection globals (serial-connection phase, Task 5) get NO IR
    // global at all: a `connection` value has no runtime storage of its
    // own -- every slot's real state lives in conn.cla's own rtConn*
    // arrays, indexed by a compile-time SLOT number (lowConnSlotOf), not
    // by a C variable. Every reference to this var resolves straight to
    // its slot constant (lowConnMethod, lowTopHandler) -- nothing ever
    // reads it as a plain rvalue (spec %3.3: exclusively a method/handler
    // receiver). There is also nothing meaningful to lower it TO:
    // lowTypeAt has no TyConnection case, by design. lowConnSlotOf is
    // only ever populated for connection-typed globals (lowerProgram's
    // own pre-pass), so membership alone is the right test.
    if lowConnSlotOf.has(poolGet(varDeclName(d))) {
        return
    }

    t = lowResolveType(varDeclType(d))
    init = -1
    isBirth = true
    initAst = varDeclInit(d)
    if initAst != -1 {
        init = lowExpr(initAst)
        // ARC Task 6 fix (reviewer Critical, reproduced double-free): a
        // global's Init is printed directly by cpEmitGlobalsInit, never
        // routed through lowCountedStore's own retain-on-store -- so a
        // bare-alias Init (`var g2: text = g1`) needs the SAME birth-vs-
        // retain classification lowCountedStore applies to a runtime
        // store, computed here (AST is only available at lowering time)
        // and carried on the IRGlobal for cpEmitGlobalsInit to consult.
        isBirth = lowStoreIsBirth(initAst) or lowStoreIntrOwnsResult(init)
    }
    newIRGlobal(varDeclName(d), t, init, isBirth)
}

// lowBuiltinSaveChoiceLayout seeds irEnums with saveChoice's IREnumLayout
// (as if declared `enum saveChoice { Save, Discard "Don't Save", Cancel }`)
// -- a port of lower.go's builtinSaveChoiceLayout. The checked EnumType(i)
// conversion (ir.IntToEnum, cprint's enumCount) needs an irEnums entry for
// every enum a program can convert INTO, but saveChoice is a checker-side
// builtin (types.cla's seedSaveChoice) with no matching *ast.EnumDecl for
// lowEnumDecl to have ever registered.
func lowBuiltinSaveChoiceLayout() {
    var head: int
    var tail: int

    head = newIREnumMember(intern("Save"), 0, intern("Save"))
    tail = irEnumMemberListAppend(head, newIREnumMember(intern("Discard"), 1, intern("Don't Save")))
    tail = irEnumMemberListAppend(tail, newIREnumMember(intern("Cancel"), 2, intern("Cancel")))
    newIREnumLayout(intern("saveChoice"), head)
}

// lowRequireIntLit reads a window/widget property value that must be a
// compile-time pixel/tick count (Ch8's `at`/`size`/`width`/`resizable`
// values) -- checkWidget/checkWindowDecl validate property NAMES but not
// these values' SHAPE (parseProperty always parses a full expression, so a
// named int constant is legal grammar there too), so a non-literal reaching
// here is a checker-clean program lowering genuinely cannot handle yet, not
// a lowerer bug -- reported and aborted the same way lowUnsupported is,
// rather than silently reading a wrong/garbage value.
func lowRequireIntLit(e: int): int {
    if exprKind(e) != ExIntLit {
        abort("clarusc emit: window property requires an integer literal")
    }
    return intLitVal(e)
}

// widgetBindsIdx returns widget wgName's checker-resolved bindsIdx (the
// interned bound form-record field name, or -1) from window winNameIdx's
// widgetInfos chain -- check.cla's checkBindsProperty already computed and
// stored this (WidgetInfo.bindsIdx); lower.cla only ever needs to read it
// back, exact same linear-scan idiom as uiWidgetIndex just above (both walk
// windowWidgetsHead/widgetInfos to correlate an AST widget name with its
// side-table entry). winNameIdx (Task 6, layer1-compiler-perf: was
// winName: string) same as uiWidgetIndex's own parameter.
func widgetBindsIdx(winNameIdx: int, wgName: string): int {
    var wi: int

    wi = windowWidgetsHead.get(winNameIdx, -1)
    while wi != -1 {
        if poolGet(widgetInfos[wi].nameIdx) == wgName {
            return widgetInfos[wi].bindsIdx
        }
        wi = widgetInfos[wi].next
    }
    return -1 // unreachable in a checker-clean program
}

// lowColumnFieldIndex returns showsName's 0-based position in row record
// rowRecType's own field order -- the SAME order cpEmitLayouts' rt_field_desc[]
// walk uses (lowRecordDecl builds irRecords' fieldsHead by walking this
// exact recordFieldsHead/fieldInfos chain in lockstep with the AST field
// list), so this index is exactly what rt_ui_col_desc.fieldIndex must be.
// checkColumn (check.cla) already validated showsName names a real field of
// rowRecType, so the fallthrough below is unreachable for a checker-clean
// program.
func lowColumnFieldIndex(rowRecType: int, showsName: string): int {
    var fi: int
    var idx: int

    fi = recordFieldsHead(typeNameIdx(rowRecType))
    idx = 0
    while fi != -1 {
        if poolGet(fieldInfos[fi].nameIdx) == showsName {
            return idx
        }
        fi = fieldInfos[fi].next
        idx = idx + 1
    }
    return -1 // unreachable in a checker-clean program
}

// lowTableRowsVh returns a table's `rows: expr` (Ch10) property VALUE node,
// or -1 if the widget declares no `rows:` property at all -- a bare linear
// scan over widgetPropsHead, since DkColumn nodes are interleaved in the
// same chain (ast.cla's own doc comment on DkColumn/DkProperty ordering)
// and a table's own `at`/`fill`/`width` properties can appear before OR
// after `rows:` (checkWidget itself runs this identical two-pass shape: a
// dedicated first pass just for `rows:`, THEN a second pass validating
// everything else against the now-resolved row type).
func lowTableRowsVh(w: int): int {
    var p: int
    var rowsVh: int

    rowsVh = -1
    p = widgetPropsHead(w)
    while p != -1 {
        if declKind(p) == DkProperty and poolGet(propertyName(p)) == "rows" {
            rowsVh = propertyValuesHead(p)
        }
        p = declNext(p)
    }
    return rowsVh
}

// lowTableRowsGlobalName resolves a table's `rows: expr` (Ch10) to the
// interned NAME of a bare top-level `list of Record` variable -- the only
// shape this task's runtime contract supports (rt_ui_table_desc.rows is a
// pointer to the PROGRAM's own rt_list* variable cell, rt_ui.h's own doc
// comment on double indirection). Every widget-declaration-time expression
// (this one included) is checked with curScope == the program's top-level
// scope (checkWindowDecl/checkWidget never push a nested scope -- see
// checkFuncSig's fnScope = scopeNew(curScope) for the ONE place that
// actually would), so a bare ExIdent resolving here names a global by
// construction; anything else (a call, a binary expr, an absent `rows:` at
// all, or an ExIdent that somehow resolves to a func/type/const/menu name
// rather than a plain var) is rejected with the brief's pinned message.
// Returns -1 only via lowUnsupported's own quit (never a normal return),
// same "abort, don't return a sentinel the caller must remember to check"
// shape lowRequireIntLit already uses above.
func lowTableRowsGlobalName(rowsVh: int): int {
    var symIdx: int

    if rowsVh == -1 or exprKind(rowsVh) != ExIdent {
        lowUnsupported("table rows must be a global list variable")
        return -1
    }
    symIdx = scopeLookup(curScope, identName(rowsVh))
    if symIdx == -1 or symbols[symIdx].isFunc or symbols[symIdx].isType or symbols[symIdx].isConst or symbols[symIdx].isMenu {
        lowUnsupported("table rows must be a global list variable")
        return -1
    }
    return identName(rowsVh)
}

// lowWidgetDesc builds one widget's IRWidgetDesc from its DkWidget AST node
// (w) -- Ch8/Ch10: Widgets/Layout. Walks the exact same DkProperty/DkColumn
// chain checkWidget already validated; this covers rt_ui's whole widget
// surface as of mac-target-4d Task 5 (button/check/canvas/label/field/
// textview/popup/table). winName is the OWNING window's name -- needed for
// popup's form-window guard (windowIsForm, still name-keyed) and table's
// desc/column C-name composition (cprint.cla's clar_ui_table_<Win>_<W>).
// winNameIdx (Task 6, layer1-compiler-perf) is the same window's interned
// name index, passed alongside winName rather than re-derived via
// intern(winName): its only use here is widgetBindsIdx, now nameIdx-keyed.
func lowWidgetDesc(w: int, winName: string, winNameIdx: int): int {
    var kind: string
    var wgName: string
    var p: int
    var pname: string
    var vh: int
    var v1: int
    var atKind: int
    var sawAt: bool
    var x: int
    var yIsBottom: bool
    var y: int
    var widthIsFill: bool
    var width: int
    var fillBoth: bool
    var isDefault: bool
    var isCancel: bool
    var isBuffered: bool
    var isScrollV: bool
    var isScrollH: bool
    var scrollVal: string
    var captionIdx: int
    var bindsIdx: int
    var rowsGlobalIdx: int
    var columnsHead: int
    var colsTail: int
    var rowRecType: int
    var recNameIdx: int
    var fieldIdx: int
    var col: int

    kind = poolGet(widgetKindName(w))
    wgName = poolGet(widgetName(w))
    if kind != "button" and kind != "check" and kind != "canvas" and kind != "label" and kind != "field" and kind != "textview" and kind != "popup" and kind != "table" {
        lowUnsupported("widget kind " + kind)
    }

    atKind = 0
    sawAt = false
    x = 0
    yIsBottom = false
    y = 0
    widthIsFill = false
    width = 0
    fillBoth = false
    isDefault = false
    isCancel = false
    isBuffered = false
    isScrollV = false
    isScrollH = false
    captionIdx = -1
    bindsIdx = -1
    rowsGlobalIdx = -1
    columnsHead = -1
    colsTail = -1

    p = widgetPropsHead(w)
    while p != -1 {
        if declKind(p) == DkProperty {
            pname = poolGet(propertyName(p))
            vh = propertyValuesHead(p)
            if pname == "caption" or pname == "text" or pname == "label" {
                captionIdx = stringLitIdx(vh)
            } else if pname == "at" {
                sawAt = true
                v1 = exprNext(vh)
                if exprKind(vh) == ExIdent and poolGet(identName(vh)) == "next" {
                    atKind = 1
                    x = 0
                } else if exprKind(vh) == ExIdent and poolGet(identName(vh)) == "right" {
                    atKind = 2
                    x = 0
                } else {
                    atKind = 0
                    x = lowRequireIntLit(vh)
                }
                if exprKind(v1) == ExIdent and poolGet(identName(v1)) == "bottom" {
                    yIsBottom = true
                    y = 0
                } else {
                    yIsBottom = false
                    y = lowRequireIntLit(v1)
                }
            } else if pname == "width" {
                if exprKind(vh) == ExIdent and poolGet(identName(vh)) == "fill" {
                    widthIsFill = true
                    width = 0
                } else {
                    widthIsFill = false
                    width = lowRequireIntLit(vh)
                }
            } else if pname == "fill" {
                fillBoth = poolGet(identName(vh)) == "both"
            } else if pname == "default" {
                isDefault = true
            } else if pname == "cancel" {
                isCancel = true
            } else if pname == "buffered" {
                isBuffered = true
            } else if pname == "scrollbar" {
                // Ch8: `scrollbar: vertical|both` (textview only; the
                // checker's widgetDeclProps already limits this property to
                // textview). `vertical` sets only RTUI_SCROLL_V; `both` sets
                // RTUI_SCROLL_V|RTUI_SCROLL_H -- rt_ui.h's own values, not
                // spelled out here (cprint.cla owns the C macro names).
                scrollVal = poolGet(identName(vh))
                isScrollV = true
                isScrollH = scrollVal == "both"
            }
        }
        p = declNext(p)
    }

    // Layout default (mac-target-4d Task 9, Ch8 Layout doc addition): a
    // widget with NO `at:` property at all (the language reference's own
    // Appendix C EditForm gives none to any of its five bound widgets or
    // two buttons) gets a vertical-stack position from the runtime instead
    // of literally stacking at (0,0) -- see rt_ui_layout's RTUI_AT_AUTO
    // case. The one exception is `fill: both`: a widget already meant to
    // occupy the whole window regardless of declaration order keeps the
    // pre-existing (0,0)-origin default untouched (examples/texteditor.cla's
    // `textview Body { fill: both; ... }`, and every canvas fixture, rely on
    // exactly that combination already) -- this is the only place in this
    // function fillBoth is read before table's own forced widthIsFill
    // override below, so it reflects only what the widget's own `fill:`
    // property said, never a table's implicit fill.
    if not sawAt and not fillBoth {
        atKind = 3
        x = 0
        yIsBottom = false
        y = 0
    }

    if kind == "field" or kind == "check" or kind == "popup" {
        // `binds:` (Ch10) is checker-validated (WidgetInfo.bindsIdx) for all
        // three of field/check/popup, but Task 5 only ever READ it back here
        // for popup (its own form-window guard, just below) -- field/check's
        // bindsIdx silently never reached this widget's own IRWidgetDesc at
        // all, a latent gap invisible until Task 7's form fixture (the first
        // to actually declare a bound field/check) needed the bind table
        // built from THIS field, not re-derived elsewhere. Capturing it here
        // uniformly is what makes lowWindowDecl's own bind-table walk (which
        // reads irWidgetDescBindsIdx back off each widget) see field/check
        // binds at all, not just popup's.
        bindsIdx = widgetBindsIdx(winNameIdx, wgName)
    }
    if kind == "popup" {
        // Ch10: a popup finds its item labels through the OWNING window's
        // form binding (rt_ui_form_desc, Task 7) -- both pieces that walk
        // needs are checker-resolved already: bindsIdx (just above) and
        // windowIsForm.
        if bindsIdx == -1 or windowIsForm.get(winName, 0) != 1 {
            lowUnsupported("popup requires binds inside a form window")
        }
    } else if kind == "table" {
        // Ch10's table grammar has no `width:` property at all (checker's
        // widgetDeclProps only allows table.rows/at/fill) -- a table always
        // fills the window's remaining width, the only sensible behavior
        // absent any per-widget knob to say otherwise (rt_ui.h's
        // RTUI_TABLE_W natural-size fallback exists only for hand-rolled
        // descs like uiprobe's; clarusc always emits the fill sentinel).
        widthIsFill = true
        rowsGlobalIdx = lowTableRowsGlobalName(lowTableRowsVh(w))
        rowRecType = typeElem(exprTypeGet(lowTableRowsVh(w)))
        recNameIdx = typeNameIdx(rowRecType)
        lowCheckSerializableFields(recNameIdx, "table rows")
        irMarkLayoutNeeded(recNameIdx)

        p = widgetPropsHead(w)
        while p != -1 {
            if declKind(p) == DkColumn {
                fieldIdx = lowColumnFieldIndex(rowRecType, poolGet(columnShows(p)))
                col = newIRColumnDesc(columnHeader(p), fieldIdx, columnWidthPx(p), columnWidthFill(p))
                if columnsHead == -1 {
                    columnsHead = col
                }
                colsTail = irColumnDescListAppend(colsTail, col)
            }
            p = declNext(p)
        }
        if columnsHead == -1 {
            // Deferred minor from Task 5 (reviewer-recommended): the checker
            // never enforced Ch10's "a table declares >=1 column" -- a
            // zero-column table widget passed checking and would have
            // emitted a `static const rt_ui_col_desc clar_ui_cols_W_T[] =
            // { };`, invalid C (an empty array initializer).
            lowUnsupported("table must have at least one column")
        }
    }

    return newIRWidgetDesc(widgetName(w), widgetKindName(w), captionIdx, atKind, x, yIsBottom, y, widthIsFill, width, fillBoth, isDefault, isCancel, isBuffered, isScrollV, isScrollH, bindsIdx, rowsGlobalIdx, columnsHead)
}

// lowWindowDecl lowers `window W { ... }` (Ch8) into an IRWindowDesc: the
// window-body properties (title/size/resizable), each widget (lowWidgetDesc,
// in declaration order -- the SAME order uiWidgetIndex and rt_ui's widget
// indices rely on), and each per-instance `var` (an IRFieldSlot, reusing
// the record-layout arena -- see IRWindowDesc's doc comment in ir.cla). A
// var's own INIT expression (if any) is recorded into winVarDefaultsHead
// (this function's own doc comment on that var explains why and how it's
// later applied) rather than lowered here directly: it's an ordinary
// per-instance-field assignment, which needs `window`/lowCurWinType wiring
// only lowHandlerFunc's machinery sets up, not available at this point in
// lowering a bare window declaration.
//
// `form for` (Ch10, Task 7): resolved up front from check.cla's own
// windowIsForm/windowFormRecType side tables (already fully populated --
// checkWindowDecl's OWN first pass resolves `form for` before validating
// anything else in the body, and checking has run to completion before any
// lowering starts at all, per lowCurWinType's doc comment) rather than by
// re-walking the item loop below for the DkFormFor node -- so this reads
// the same regardless of where `form for` appears textually in the body.
// The per-window bind table (IRBindDesc chain, widgetIndex -> fieldIndex)
// is built AFTER the item loop, once widgetsHead is fully assembled: each
// bound widget's field name (widgetBindsIdx, checker's WidgetInfo.bindsIdx)
// resolves to its 0-based field-layout position via lowColumnFieldIndex,
// the exact same resolution a table's own columns already use.
func lowWindowDecl(d: int) {
    var winNameIdx: int
    var winName: string
    var item: int
    var titleIdx: int
    var w: int
    var h: int
    var resizable: bool
    var minW: int
    var minH: int
    var widgetsHead: int
    var widgetsTail: int
    var stateHead: int
    var stateTail: int
    var defHead: int
    var defTail: int
    var defIdx: int
    var vh: int
    var pname: string
    var wd: int
    var fslot: int
    var fty: int
    var formRecNameIdx: int
    var formRecType: int
    var bindsHead: int
    var bindsTail: int
    var bw: int
    var bWidgetIdx: int
    var bFieldNameIdx: int
    var bFieldIdx: int
    var nb: int

    winNameIdx = windowDeclName(d)
    winName = poolGet(winNameIdx)
    titleIdx = -1
    w = 0
    h = 0
    resizable = false
    minW = 0
    minH = 0
    widgetsHead = -1
    widgetsTail = -1
    stateHead = -1
    stateTail = -1
    defHead = -1
    defTail = -1

    formRecNameIdx = -1
    formRecType = windowFormRecType.get(winName, -1)
    if windowIsForm.get(winName, 0) == 1 and formRecType != -1 {
        formRecNameIdx = typeNameIdx(formRecType)
        lowCheckSerializableFields(formRecNameIdx, "form for")
        irMarkLayoutNeeded(formRecNameIdx)
    }

    item = windowDeclItemsHead(d)
    while item != -1 {
        if declKind(item) == DkProperty {
            pname = poolGet(propertyName(item))
            vh = propertyValuesHead(item)
            if pname == "title" {
                titleIdx = stringLitIdx(vh)
            } else if pname == "size" {
                w = lowRequireIntLit(vh)
                h = lowRequireIntLit(exprNext(vh))
            } else if pname == "resizable" {
                resizable = true
                if vh != -1 {
                    minW = lowRequireIntLit(callArgsHead(vh))
                    minH = lowRequireIntLit(exprNext(callArgsHead(vh)))
                }
            }
        } else if declKind(item) == DkVar {
            fty = lowResolveType(varDeclType(item))
            fslot = newIRFieldSlot(varDeclName(item), fty, 0, -1)
            if stateHead == -1 {
                stateHead = fslot
            }
            stateTail = irFieldSlotListAppend(stateTail, fslot)
            if varDeclInit(item) != -1 {
                defIdx = newWinVarDefault(varDeclName(item), varDeclInit(item), fty)
                if defHead == -1 {
                    defHead = defIdx
                }
                defTail = winVarDefaultListAppend(defTail, defIdx)
            }
        } else if declKind(item) == DkWidget {
            wd = lowWidgetDesc(item, winName, winNameIdx)
            if widgetsHead == -1 {
                widgetsHead = wd
            }
            widgetsTail = irWidgetDescListAppend(widgetsTail, wd)
        } else if declKind(item) == DkFormFor {
            // Already resolved up front (see this function's own doc
            // comment) -- nothing left to do per-occurrence.
        }
        item = declNext(item)
    }
    if resizable and minW == 0 and minH == 0 {
        // No explicit `min(...)` -- default to the window's own opening
        // size (never shrinks below what it opened at), a sane choice
        // absent from the language reference's own bare-`resizable` example.
        minW = w
        minH = h
    }
    if defHead != -1 {
        winVarDefaultsHead[numToStr(progGen) + "|" + winName] = defHead
    }

    bindsHead = -1
    bindsTail = -1
    if formRecNameIdx != -1 {
        bw = widgetsHead
        bWidgetIdx = 0
        while bw != -1 {
            bFieldNameIdx = widgetBindsIdx(winNameIdx, poolGet(irWidgetDescName(bw)))
            if bFieldNameIdx != -1 {
                bFieldIdx = lowColumnFieldIndex(formRecType, poolGet(bFieldNameIdx))
                nb = newIRBindDesc(bWidgetIdx, bFieldIdx)
                if bindsHead == -1 {
                    bindsHead = nb
                }
                bindsTail = irBindDescListAppend(bindsTail, nb)
            }
            bWidgetIdx = bWidgetIdx + 1
            bw = irWidgetDescNext(bw)
        }
    }

    newIRWindowDesc(winNameIdx, titleIdx, w, h, resizable, minW, minH, widgetsHead, stateHead, formRecNameIdx, bindsHead)
}

// lowMenuDecl lowers `menu M { ... }` (Ch9) into an IRMenuDesc, and records
// M's declaration-order menuIdx plus each item's 0-based position (separators
// included) into uiMenuIdx/uiMenuItemIdx for lowMenuEnableAssign to read back
// later in this same pass (see those vars' own doc comment).
func lowMenuDecl(d: int) {
    var nameIdx: int
    var menuName: string
    var e: int
    var itemsHead: int
    var itemsTail: int
    var idx: int
    var it: int
    var isStdEdit: bool

    nameIdx = menuDeclName(d)
    menuName = poolGet(nameIdx)
    // Capture BEFORE incrementing: rt_ui_menu_enable's menuIdx is 0-based
    // (rt_ui.c's gMenuHandles/gNMenus bounds check), so the first declared
    // menu is index 0, not 1.
    uiMenuIdx[numToStr(progGen) + "|" + menuName] = uiMenuCount
    uiMenuCount = uiMenuCount + 1

    itemsHead = -1
    itemsTail = -1
    idx = 0
    isStdEdit = false
    e = menuDeclEntriesHead(d)
    while e != -1 {
        // `standard edit` (Ch9, mac-target-4c Task 3) contributes no
        // IRMenuItemDesc of its own -- the runtime builds Undo/Cut/Copy/
        // Paste/Clear itself from the isStandardEdit flag alone, so this
        // entry doesn't occupy an item-array slot (idx stays put).
        if menuEntryIsStandardEdit(e) {
            isStdEdit = true
        } else if menuEntryIsItem(e) {
            uiMenuItemIdx[menuKey(menuName, poolGet(menuEntryName(e)))] = idx
            it = newIRMenuItemDesc(menuEntryName(e), menuEntryCaption(e), menuEntryKey(e), false)
            if itemsHead == -1 {
                itemsHead = it
            }
            itemsTail = irMenuItemDescListAppend(itemsTail, it)
            idx = idx + 1
        } else {
            it = newIRMenuItemDesc(-1, -1, -1, true)
            if itemsHead == -1 {
                itemsHead = it
            }
            itemsTail = irMenuItemDescListAppend(itemsTail, it)
            idx = idx + 1
        }
        e = declNext(e)
    }
    newIRMenuDesc(nameIdx, nameIdx, itemsHead, isStdEdit)
}

// ================================================================
// `extend`/`every` lowering (Task 5): handlers, dispatch, timers
// ================================================================

// lowGetOrCreateWinHandlers returns winName's irWinHandlers arena index,
// creating it on first use -- a window with no `extend` block at all never
// gets an entry (cprint.cla's cpFindWinHandlers reads absence as "handlers
// field prints 0", exactly Task 4's placeholder). progGen-prefixed like
// uiMenuIdx, for the same reason (see that var's own doc comment).
func lowGetOrCreateWinHandlers(winName: string): int {
    var key: string
    var idx: int
    var formRecNameIdx: int
    var formRecType: int

    key = numToStr(progGen) + "|" + winName
    if uiWinHandlersIdx.has(key) {
        return uiWinHandlersIdx.get(key, -1)
    }
    formRecNameIdx = -1
    formRecType = windowFormRecType.get(winName, -1)
    if windowIsForm.get(winName, 0) == 1 and formRecType != -1 {
        formRecNameIdx = typeNameIdx(formRecType)
    }
    idx = newIRWinHandlers(intern(winName), formRecNameIdx)
    uiWinHandlersIdx[key] = idx
    return idx
}

// lowFindWidgetHandlerEntry returns widgetIndex's IRWidgetHandlerEntry
// within window handlers `whIdx`, creating one on first use -- a linear
// scan, since a window's own widget count is always small and this only
// ever runs once per registered handler at lowering time.
func lowFindWidgetHandlerEntry(whIdx: int, widgetIndex: int): int {
    var w: int

    w = irWinHandlersWidgetHead(whIdx)
    while w != -1 {
        if irWidgetHandlerEntryWidgetIndex(w) == widgetIndex {
            return w
        }
        w = irWidgetHandlerEntryNext(w)
    }
    return irWinHandlersAppendWidgetEntry(whIdx, widgetIndex)
}

// lowHandlerFunc lowers one handler body (window event, widget event,
// window-scoped or app-scope menu item, or an `every` block) into a fresh
// top-level IR Func, added to irFuncs exactly like a user `func` or a
// top-level `on App.*` handler -- cpEmitFuncs's existing prototype+
// definition pass prints it with NO special-casing at all.
//
//   cName          the C function's own name (interned here); every caller
//                  picks one built from Clarus identifiers that can't
//                  collide (window/widget/menu/scope names are already
//                  distinct within one program).
//   winType        sets lowCurWinType for the body (bare-name/`window`
//                  resolution, see that var's own doc comment) -- -1 for an
//                  every-block or an app-scope menu handler, neither of
//                  which the checker ever lets reference `window` or a bare
//                  instance member.
//   instParamName  -1: no leading C parameter at all (an every-block's
//                  `fire` is `void (*)(void)`); otherwise the interned name
//                  of the hidden first parameter -- intern("window") for a
//                  window/widget/window-scoped-menu handler (bound as the
//                  firing instance, Ch8's own keyword for exactly this
//                  value); any OTHER name for an app-scope menu handler,
//                  whose `fire` function pointer type still needs exactly
//                  one `void *` parameter it never uses (rt_ui_menu_handler
//                  ABI).
//   astParamsHead  the user-declared param list (key's `k`, canvas
//                  click/drag's x/y; -1 for every other event, which the
//                  checker guarantees are param-count 0), appended AFTER
//                  the hidden instance parameter -- the exact same
//                  paramName/paramType/declNext walk lowFuncBody uses.
//
// Returns cName's own interned pool index (NOT the irFuncs arena index --
// every caller only ever needs the printable name, to build cprint's
// hand-generated dispatcher/table text; the func is already fully
// registered as a side effect of this call).
func lowHandlerFunc(cName: string, winType: int, instParamName: int, astParamsHead: int, body: int): int {
    var nameIdx: int
    var paramsHead: int
    var paramsTail: int
    var instLoc: int
    var p: int
    var loc: int
    var savedWinType: int
    var savedRet: int
    var bodyHead: int

    nameIdx = intern(cName)
    lowPushScope()
    paramsHead = -1
    paramsTail = -1
    savedWinType = lowCurWinType
    lowCurWinType = winType

    if instParamName != -1 {
        if winType != -1 {
            instLoc = newIRLocal(instParamName, irWinRefType(typeNameIdx(winType)))
        } else {
            // App-scope menu handler: a dummy KWinRef param purely for its
            // "void *" C spelling (cpCTypeName ignores KWinRef's name field
            // entirely) -- never read, since lowCurWinType stays -1 and the
            // checker never lets an app-scope body reference `window` or a
            // bare instance member.
            instLoc = newIRLocal(instParamName, irWinRefType(instParamName))
        }
        paramsHead = instLoc
        paramsTail = instLoc
        lowDeclareLocal(instParamName)
    }
    p = astParamsHead
    while p != -1 {
        loc = newIRLocal(paramName(p), lowResolveType(paramType(p)))
        if paramsHead == -1 {
            paramsHead = loc
        }
        paramsTail = irLocalListAppend(paramsTail, loc)
        lowDeclareLocal(paramName(p))
        p = declNext(p)
    }

    lowLocalsHead = -1
    lowLocalsTail = -1
    savedRet = lowCurFuncRet
    lowCurFuncRet = irVoidT
    lowRunEscapePrepass(body)
    bodyHead = lowBlock(body)
    bodyHead = lowAppendTrailingFrees(bodyHead)
    lowCurFuncRet = savedRet

    lowCurWinType = savedWinType
    lowPopScope()
    newIRFunc(nameIdx, paramsHead, irVoidT, lowLocalsHead, bodyHead)
    return nameIdx
}

// lowWinVarDefaultsStmts builds the IR assignment-statement chain (in
// declaration order) that applies winName's per-instance `var` default
// initializers (see winVarDefaultsHead's own doc comment for why this
// exists). Requires lowCurWinType already set to winName's window type
// (caller's job, matching lowHandlerFunc's own convention -- lowExpr and
// lowBareWindowMemberRef both read it). Returns -1 if winName has no
// defaulted vars.
func lowWinVarDefaultsStmts(winName: string): int {
    var defIdx: int
    var head: int
    var tail: int
    var dst: int
    var st: int

    head = -1
    tail = -1
    defIdx = winVarDefaultsHead.get(numToStr(progGen) + "|" + winName, -1)
    while defIdx != -1 {
        dst = lowBareWindowMemberRef(winVarDefaults[defIdx].fieldNameIdx, winVarDefaults[defIdx].typeIdx)
        st = lowCountedStore(dst, winVarDefaults[defIdx].initAST, winVarDefaults[defIdx].typeIdx)
        if head == -1 {
            head = st
        }
        // Walk to the true end -- lowCountedStore can return a multi-node
        // chain now (see lowBlock's own identical fix/comment).
        tail = irStmtListAppend(tail, st)
        while irStmtNext(tail) != -1 {
            tail = irStmtNext(tail)
        }
        defIdx = winVarDefaults[defIdx].next
    }
    return head
}

// lowPrependWinVarDefaults splices winName's construction + default-assignment
// statements (if any) onto the FRONT of the already-lowered function
// fnNameIdx (an explicit user `on opened` handler, just built by
// lowHandlerFunc) -- called right after that lowHandlerFunc call, before the
// result is wired into irWinHandlersSetOpenedFn, so an explicit handler's own
// code always runs AFTER them, same ordering a hand-written `on opened {
// log = clar_text_new(); x = 10; ...; <user code> }` would have. Ordering is
// construction (IUiStateDefaults, clarusc-ui-gaps Task 2 -- every
// handle-backed state var must exist before ANY in-place use, even a bare
// `var t: text` with no declared default) THEN declared defaults
// (WinVarDefault) THEN the user's own statements. A no-op if winName has
// neither a handle-backed var nor a defaulted var.
func lowPrependWinVarDefaults(winName: string, winType: int, fnNameIdx: int) {
    var savedWinType: int
    var hasDefaults: bool
    var needsCtor: bool
    var ctorHead: int
    var declHead: int
    var defsHead: int
    var defsTail: int
    var fIdx: int

    hasDefaults = winVarDefaultsHead.has(numToStr(progGen) + "|" + winName)
    needsCtor = lowWinHasCtorField(winType)
    if not hasDefaults and not needsCtor {
        return
    }
    savedWinType = lowCurWinType
    lowCurWinType = winType
    ctorHead = -1
    if needsCtor {
        ctorHead = newIRExprStmt(newIRIntr(IUiStateDefaults(), lowWinInstRef(), irUiStateType(typeNameIdx(winType))))
    }
    declHead = -1
    if hasDefaults {
        declHead = lowWinVarDefaultsStmts(winName)
    }
    lowCurWinType = savedWinType

    defsHead = ctorHead
    defsTail = ctorHead
    if declHead != -1 {
        if defsHead == -1 {
            defsHead = declHead
        } else {
            irStmtListAppend(defsTail, declHead)
        }
        defsTail = declHead
        while irStmtNext(defsTail) != -1 {
            defsTail = irStmtNext(defsTail)
        }
    }
    if defsHead == -1 {
        return
    }
    fIdx = findIRFuncIdxByName(fnNameIdx)
    irStmtListAppend(defsTail, irFuncBodyHead(fIdx))
    irFuncSetBodyHead(fIdx, defsHead)
    // ARC Task 4: lowWinVarDefaultsStmts (via lowCountedStore) can mint a
    // materialization temp through lowAddLocal, which only APPENDS to the
    // shared lowLocalsHead/lowLocalsTail globals -- if the handler body
    // above declared no `var`s of its own, lowHandlerFunc already froze
    // localsHead=-1 into fIdx's IRFunc record before this function ever
    // ran, so a temp minted here would otherwise never reach cpEmitFunc's
    // C declaration walk at all (reviewer's exact repro: `bodyText =
    // Body.text` inside a locals-free `on opened` handler emitted
    // `rt_text_release(cv___store2);` with no matching declaration --
    // caught by the m68k compile-check gate, not the corpus). Re-sync
    // unconditionally; a harmless no-op when nothing new was minted.
    irFuncSetLocalsHead(fIdx, lowLocalsHead)
}

// lowWindowHandlerEntry lowers one DkHandler child of `extend Win { ... }`
// -- a bare window event (Ch8) or `Widget.event` -- into its own IRFunc,
// wired into win's IRWinHandlers entry.
func lowWindowHandlerEntry(winType: int, winName: string, whIdx: int, h: int) {
    var displayName: string
    var parts: list of string
    var event: string
    var cName: string
    var fnNameIdx: int
    var savedEvent: int
    var savedParam: int

    displayName = poolGet(handlerDeclPath(h))
    parts = splitDots(displayName)
    if parts.count == 1 {
        event = parts[0]
        cName = "ui_" + winName + "_" + event
        if event == "opened" {
            fnNameIdx = lowHandlerFunc(cName, winType, intern("window"), handlerDeclParamsHead(h), handlerDeclBody(h))
            lowPrependWinVarDefaults(winName, winType, fnNameIdx)
            irWinHandlersSetOpenedFn(whIdx, fnNameIdx)
        } else if event == "closeRequest" {
            irWinHandlersSetCloseRequestFn(whIdx, lowHandlerFunc(cName, winType, intern("window"), handlerDeclParamsHead(h), handlerDeclBody(h)))
        } else if event == "closed" {
            irWinHandlersSetClosedFn(whIdx, lowHandlerFunc(cName, winType, intern("window"), handlerDeclParamsHead(h), handlerDeclBody(h)))
        } else if event == "resized" {
            irWinHandlersSetResizedFn(whIdx, lowHandlerFunc(cName, winType, intern("window"), handlerDeclParamsHead(h), handlerDeclBody(h)))
        } else if event == "key" {
            irWinHandlersSetKeyFn(whIdx, lowHandlerFunc(cName, winType, intern("window"), handlerDeclParamsHead(h), handlerDeclBody(h)))
        } else if event == "accepted" {
            // Ch10: `on accepted(b: T)` -- lowCurHandlerEvent/lowCurAcceptedParam
            // scope `b.isNew` (lowSelect's TyRec case) to exactly this body;
            // checkWindowHandler already guarantees exactly one declared
            // param, typed as the form's own record.
            savedEvent = lowCurHandlerEvent
            savedParam = lowCurAcceptedParam
            lowCurHandlerEvent = intern("accepted")
            lowCurAcceptedParam = paramName(handlerDeclParamsHead(h))
            fnNameIdx = lowHandlerFunc(cName, winType, intern("window"), handlerDeclParamsHead(h), handlerDeclBody(h))
            lowCurHandlerEvent = savedEvent
            lowCurAcceptedParam = savedParam
            irWinHandlersSetAcceptedFn(whIdx, fnNameIdx)
        } else if event == "cancelled" {
            savedEvent = lowCurHandlerEvent
            lowCurHandlerEvent = intern("cancelled")
            fnNameIdx = lowHandlerFunc(cName, winType, intern("window"), handlerDeclParamsHead(h), handlerDeclBody(h))
            lowCurHandlerEvent = savedEvent
            irWinHandlersSetCancelledFn(whIdx, fnNameIdx)
        } else {
            lowUnsupported("window event " + event)
        }
    } else {
        lowWidgetHandlerEvent(winType, winName, whIdx, parts[0], parts[1], h)
    }
}

// lowWidgetHandlerEvent lowers `on Widget.event { }` inside `extend Win`
// (Ch8: button.click, check.change, canvas.click/drag, field/textview.change,
// field.enter -- mac-target-4c Task 2).
func lowWidgetHandlerEvent(winType: int, winName: string, whIdx: int, wgName: string, event: string, h: int) {
    var widgetIdx: int
    var entryIdx: int
    var fnName: int
    var cName: string

    widgetIdx = uiWidgetIndex(typeNameIdx(winType), wgName)
    entryIdx = lowFindWidgetHandlerEntry(whIdx, widgetIdx)
    cName = "ui_" + winName + "_" + wgName + "_" + event
    fnName = lowHandlerFunc(cName, winType, intern("window"), handlerDeclParamsHead(h), handlerDeclBody(h))
    if event == "click" {
        irWidgetHandlerEntrySetClickFn(entryIdx, fnName)
    } else if event == "change" {
        irWidgetHandlerEntrySetChangeFn(entryIdx, fnName)
    } else if event == "drag" {
        irWidgetHandlerEntrySetDragFn(entryIdx, fnName)
    } else if event == "enter" {
        irWidgetHandlerEntrySetEnterFn(entryIdx, fnName)
    } else if event == "select" {
        irWidgetHandlerEntrySetSelectFn(entryIdx, fnName)
    } else if event == "doubleClick" {
        irWidgetHandlerEntrySetDoubleClickFn(entryIdx, fnName)
    } else {
        lowUnsupported("widget event " + event)
    }
}

// lowWindowExtend lowers `extend Win { ... }` (Ch8/Ch9): bare window/widget
// handlers directly (lowWindowHandlerEntry); a nested `extend Menu { ... }`
// (window-scoped menu commands) via lowMenuExtend.
func lowWindowExtend(winType: int, d: int) {
    var winName: string
    var whIdx: int
    var c: int

    winName = poolGet(typeNameIdx(winType))
    whIdx = lowGetOrCreateWinHandlers(winName)
    c = extendDeclChildrenHead(d)
    while c != -1 {
        if declKind(c) == DkHandler {
            lowWindowHandlerEntry(winType, winName, whIdx, c)
        } else if declKind(c) == DkExtend {
            lowMenuExtend(extendDeclTarget(c), c, winType)
        }
        c = declNext(c)
    }
}

// lowMenuExtend lowers `extend MenuName { on Item.select { } }` (Ch9),
// either at the top level (winType == -1: app-scope commands) or nested
// inside `extend Win` (winType != -1: window-scoped, auto-dimmed by the
// runtime while a window of that type is frontmost).
func lowMenuExtend(menuNameIdx: int, d: int, winType: int) {
    var menuName: string
    var menuIdx: int
    var scopeName: int
    var c: int
    var path: string
    var parts: list of string
    var itemName: string
    var itemIdx: int
    var instParam: int
    var cName: string
    var fnName: int

    menuName = poolGet(menuNameIdx)
    menuIdx = uiMenuIdx.get(numToStr(progGen) + "|" + menuName, -1)
    scopeName = -1
    if winType != -1 {
        scopeName = typeNameIdx(winType)
    }
    c = extendDeclChildrenHead(d)
    while c != -1 {
        if declKind(c) == DkHandler {
            path = poolGet(handlerDeclPath(c))
            parts = splitDots(path)
            itemName = parts[0]
            itemIdx = uiMenuItemIdx.get(menuKey(menuName, itemName), -1)
            instParam = intern("menuArg")
            cName = "ui_menuh_" + menuName + "_" + itemName + "_app"
            if winType != -1 {
                instParam = intern("window")
                cName = "ui_menuh_" + menuName + "_" + itemName + "_" + poolGet(typeNameIdx(winType))
            }
            fnName = lowHandlerFunc(cName, winType, instParam, handlerDeclParamsHead(c), handlerDeclBody(c))
            newIRMenuHandlerEntry(menuNameIdx, intern(itemName), menuIdx, itemIdx, fnName, scopeName)
        }
        // No nested extend inside a menu extend (checker already rejects
        // it, checkMenuExtend's own DkExtend branch).
        c = declNext(c)
    }
}

// lowEveryDecl lowers a top-level `every N ticks { }` block (Ch7/Ch11) into
// its own IRFunc (winType/instParamName both -1: an every-block is never
// window-scoped -- Ch7/Ch11's own examples always reach a window through an
// explicit `.front` local, never a bare/implicit `window` reference) plus
// an IREveryEntry recording its tick count, in declaration order (the SAME
// order the ledger's `T FIRE every.<n>` trace index and rt_ui_every_desc[]'s
// array position both use).
func lowEveryDecl(d: int) {
    var fnName: int

    fnName = lowHandlerFunc("ui_every_" + numToStr(irEveryCount), -1, -1, -1, everyDeclBody(d))
    newIREveryEntry(fnName, everyDeclTicks(d))
}

// lowExtendDecl dispatches a top-level `extend` block (Ch8/Ch9) -- mirrors
// checkExtendDecl's own dispatch exactly, reusing curScope/symbols (still
// populated from checking -- see lowResolveType's header comment on why
// that's safe).
func lowExtendDecl(d: int) {
    var tgtNameIdx: int
    var symIdx: int

    tgtNameIdx = extendDeclTarget(d)
    symIdx = scopeLookup(curScope, tgtNameIdx)
    if symIdx != -1 and symbols[symIdx].isType and typeKind(symbols[symIdx].typeIdx) == TyWindowRef {
        lowWindowExtend(symbols[symIdx].typeIdx, d)
    } else if symIdx != -1 and symbols[symIdx].isMenu {
        lowMenuExtend(tgtNameIdx, d, -1)
    } else {
        lowUnsupported("extend target")
    }
}

// lowDecl dispatches one top-level declaration (lower.go's lowerDecl subset).
func lowDecl(d: int) {
    var k: DeclKind

    k = declKind(d)
    if k == DkHandler {
        lowTopHandler(d)
    } else if k == DkInclude or k == DkConst or k == DkExternFunc {
        // DkInclude/DkConst intentionally emit no IR (includes are already
        // expanded; consts inline at use). DkExternFunc (Task 3, Ch13) was
        // already fully registered into the extern registry by
        // lowerProgram's pre-pass, run before this main walk starts, so
        // every call site sees a complete registry regardless of whether
        // its callee's `external func` decl appears earlier or later in
        // source order (Ch13: "may appear anywhere") -- registering it a
        // second time here, in source-order-dependent position, would be
        // too late for a call that precedes it. Not a stub either way.
    } else if k == DkRecord {
        lowRecordDecl(d)
    } else if k == DkEnum {
        lowEnumDecl(d)
    } else if k == DkVar {
        lowGlobalVarDecl(d)
    } else if k == DkFunc {
        lowFuncDecl(d)
    } else if k == DkCallbackFunc {
        // Task 7 (toolbox-integration Feature C): a `callback func` is an
        // ordinary Clarus function with a restricted signature palette
        // (checkCallbackFunc, check.cla) -- its BODY lowers exactly like
        // any DkFunc's (lowFuncDecl reads paramType(p) straight off the
        // AST via lowResolveType, so a `word` param already lowers to the
        // precise KWord IR type here, independent of the checker's own
        // word-folds-to-int simplification -- see lowResolveType's TxWord
        // case). The generated pascal glue wrapper (cprint.cla) is a
        // SEPARATE emission driven by irCbGlueNames, not by this decl
        // kind at all -- a callback with no ECbAddr anywhere gets an
        // ordinary irFuncs entry here and nothing else.
        lowFuncDecl(d)
    } else if k == DkWindow {
        lowWindowDecl(d)
    } else if k == DkMenu {
        lowMenuDecl(d)
    } else if k == DkExtend {
        lowExtendDecl(d)
    } else if k == DkEvery {
        lowEveryDecl(d)
    } else if k == DkApp {
        lowAppDecl(d)
    } else {
        lowUnsupported("declaration kind " + numToStr(int(k)))
    }
}

// lowExternDecl records an `external func` decl's signature into the IR
// extern registry (Task 3, Ch13: `external func`) -- an external has no
// body to lower; only lowCall's ECallExt routing and cprint's
// cpEmitExternProtos ever read the registry back. Called from
// lowerProgram's extern pre-pass, NOT from lowDecl's main dispatch (see
// that dispatch's DkExternFunc arm) -- every extern must be registered
// before any call site lowers, regardless of source order. Task 2
// (native-5d) passes the decl's already-checked trap/inline clause
// (ast.cla's externFuncTrap/externFuncConv) straight through to
// irRegisterExtern -- lowering does no validation of its own, that's all
// checkExternFunc's job. Task 1 (toolbox-integration Feature A) adds each
// param's resolved register code (paramRegBind, read directly off the
// param handle already in hand -- ast.cla's astExternRegBind wrapper is
// for callers without one) and the extern's own `ret REG` code
// (astExternRetReg), same already-checked passthrough.
func lowExternDecl(d: int) {
    var paramTys: list of int
    var paramRegs: list of int
    var p: int
    var ret: int

    p = funcDeclParamsHead(d)
    while p != -1 {
        paramTys.add(lowResolveType(paramType(p)))
        paramRegs.add(paramRegBind(p))
        p = declNext(p)
    }
    if funcDeclRetType(d) != -1 {
        ret = lowResolveType(funcDeclRetType(d))
    } else {
        ret = irVoidT
    }
    irRegisterExtern(funcDeclName(d), ret, paramTys, externFuncTrap(d), externFuncConv(d), externFuncSel(d), paramRegs, astExternRetReg(d))
}

// lowAppDecl records the (at most one, checker-validated) `app` section's
// string properties as pool indices for cprint's rt_ui_app_info emission --
// icon is deliberately not read here (build-time only, per the Task 2
// brief). id IS read (Task 2, mac-target-4d): cpEmitAppInfo turns it into
// the strong rt_app_creator override, so saved data files carry the app's
// own creator instead of Task 1's weak '????' default. doctype is ALSO
// read (native-gaps-cleanup Task 1, Part A), but for a different
// consumer: lowAppConst reads irAppDoctype back only to lower
// `app.doctype` expressions to a padded string literal -- no backend
// module reads it, unlike id. stack (native-gaps-cleanup Task 4) is the
// one non-string property -- its own int literal's VALUE (not a pool
// index) is read straight into irAppStack; cg68k.cla's cgStackHeuristic is
// its only consumer. No validation needed either way,
// checkAppDecl/checkAppId/checkAppDoctype/checkAppStack already rejected
// everything wrong by the time lowering runs.
func lowAppDecl(d: int) {
    var item: int
    var pname: string
    var vh: int

    irHasApp = true
    item = appDeclPropsHead(d)
    while item != -1 {
        pname = poolGet(propertyName(item))
        vh = propertyValuesHead(item)
        if pname == "name" { irAppName = stringLitIdx(vh) }
        if pname == "version" { irAppVersion = stringLitIdx(vh) }
        if pname == "author" { irAppAuthor = stringLitIdx(vh) }
        if pname == "about" { irAppAbout = stringLitIdx(vh) }
        if pname == "id" { irAppId = stringLitIdx(vh) }
        if pname == "doctype" { irAppDoctype = stringLitIdx(vh) }
        if pname == "stack" { irAppStack = intLitVal(vh) }
        item = declNext(item)
    }
}

// lowSynthesizeMissingOpenedHandlers (Task 7, mac-target-4b; widened by
// clarusc-ui-gaps Task 2 to cover construction, not just declared defaults)
// is lowPrependWinVarDefaults' other half: for every window type that has
// >=1 handle-backed state var (needing construction) or >=1 defaulted var,
// but reached the end of the program with NO explicit `on opened` handler
// registered (either no `extend` block at all, or one with other handlers
// but not `opened` -- lowPrependWinVarDefaults already covered the
// "explicit opened handler exists" case inline, as each `extend` block was
// lowered), synthesize a fresh opened handler whose entire body is
// construction (IUiStateDefaults) then the default-assignment statements,
// same ordering lowPrependWinVarDefaults gives an explicit handler. Iterates
// irWindowDescs directly (not just winVarDefaultsHead's keys, as before)
// since a window can now need this with zero declared defaults -- safe to
// scan un-prefixed because irReset() clears irWindowDescs every program
// generation (unlike winVarDefaultsHead/uiMenuIdx, which persist and so
// stay progGen-prefixed), so it holds only the CURRENT program's windows.
// Run once, after lowerProgram's main pass, so every window/extend
// declaration has already been lowered (curScope/symbols are still the
// checker's own read-only leftovers at this point -- see
// lowResolveType's header comment on why that's safe).
func lowSynthesizeMissingOpenedHandlers() {
    var i: int
    var winName: string
    var symIdx: int
    var winType: int
    var whIdx: int
    var hasDefaults: bool
    var needsCtor: bool
    var ctorHead: int
    var declHead: int
    var stmtsHead: int
    var stmtsTail: int
    var instLoc: int
    var fnNameIdx: int

    i = 0
    while i < irWindowDescs.count {
        winName = poolGet(irWindowDescName(i))
        i = i + 1
        symIdx = scopeLookup(curScope, intern(winName))
        if symIdx == -1 or not symbols[symIdx].isType or typeKind(symbols[symIdx].typeIdx) != TyWindowRef {
            continue
        }
        winType = symbols[symIdx].typeIdx
        hasDefaults = winVarDefaultsHead.has(numToStr(progGen) + "|" + winName)
        needsCtor = lowWinHasCtorField(winType)
        if not hasDefaults and not needsCtor {
            // Neither: don't touch this window's handlers entry at all --
            // lowGetOrCreateWinHandlers CREATES one on first call, and a
            // window with no `extend` block must keep printing its
            // rt_ui_handlers field as the bare 0 placeholder (cpFindWinHandlers'
            // own "absence means no extend block" contract), not an
            // all-zero-but-present struct.
            continue
        }
        whIdx = lowGetOrCreateWinHandlers(winName)
        if irWinHandlersOpenedFn(whIdx) != -1 {
            continue
        }
        lowCurWinType = winType
        // ARC Task 4: reset the shared locals-accumulation globals for THIS
        // window's own synthesized function, same as lowHandlerFunc/
        // lowFuncBody already do at the start of every real function --
        // lowWinVarDefaultsStmts (via lowCountedStore) can now mint a
        // materialization temp through lowAddLocal (a non-fresh window-var
        // default, e.g. `var note: text = "hi"`), and this loop iterates
        // MULTIPLE windows without ever having needed a fresh locals chain
        // per window before this task -- without the reset, one window's
        // synthesized-opened temp silently accumulates onto (and gets
        // mis-attributed to) another's, or -- since newIRFunc was always
        // hardcoded to localsHead=-1 just below -- is orphaned from every
        // function's C declaration walk entirely (reviewer's exact repro:
        // TextWin's synthesized `note = "hi"` default used `cv___store3`
        // with no declaration in clar_fn_ui_TextWin_opened, while
        // NoteWin's unrelated, explicit-handler `on opened` -- a
        // DIFFERENT, already-correct code path, lowPrependWinVarDefaults --
        // ended up declaring it anyway, since the shared globals still
        // pointed at the same never-reset chain).
        lowLocalsHead = -1
        lowLocalsTail = -1
        ctorHead = -1
        if needsCtor {
            ctorHead = newIRExprStmt(newIRIntr(IUiStateDefaults(), lowWinInstRef(), irUiStateType(typeNameIdx(winType))))
        }
        declHead = -1
        if hasDefaults {
            declHead = lowWinVarDefaultsStmts(winName)
        }
        lowCurWinType = -1

        stmtsHead = ctorHead
        stmtsTail = ctorHead
        if declHead != -1 {
            if stmtsHead == -1 {
                stmtsHead = declHead
            } else {
                irStmtListAppend(stmtsTail, declHead)
            }
            stmtsTail = declHead
            while irStmtNext(stmtsTail) != -1 {
                stmtsTail = irStmtNext(stmtsTail)
            }
        }
        if stmtsHead == -1 {
            continue
        }
        instLoc = newIRLocal(intern("window"), irWinRefType(typeNameIdx(winType)))
        fnNameIdx = intern("ui_" + winName + "_opened")
        // lowLocalsHead (NOT a hardcoded -1): any materialization temp
        // lowWinVarDefaultsStmts minted above for THIS window must reach
        // this function's own C declaration walk.
        newIRFunc(fnNameIdx, instLoc, irVoidT, lowLocalsHead, stmtsHead)
        irWinHandlersSetOpenedFn(whIdx, fnNameIdx)
    }
}

// ================================================================
// Reverse-waist dispatcher synthesis
// ================================================================
//
// lowSynthUiDispatchers builds the 10 program-emitted reverse-waist
// IRFuncs the plan's "reverse waist" section names (docs/superpowers/
// plans/2026-08-01-native-5e-ui-runtime.md), directly at the IR level --
// ordinary IRFuncs assembled by hand from already-lowered IR data
// (irWindowDescs/irWinHandlers/irMenuHandlersHead/irEveryHead/irGlobals),
// bypassing the AST/checker pipeline entirely (there is no Clarus SOURCE
// for any of these bodies, unlike every other lowXxx entry point in this
// file). Both cprint (this task) and cg68k (Task 12) can then compile them
// as ordinary functions, with zero backend-specific dispatcher code of
// their own -- the only backend-specific pieces are the LEAF intrinsics
// they call (IUiState, IUiSetCancelFlag, IUiValueAtPtr, IUiAddrOfGlobal,
// ...), exactly like every other UI construct already works.
//
// Called once, from lowerProgram's tail, only when the program actually
// declares a window/menu/every -- mirrors irIsUiProgram()'s own gate,
// duplicated here rather than called across the cprint.cla layering
// boundary (lower.cla is included BEFORE cprint.cla in main.cla's
// manifest, and is meant to stay backend-agnostic).
//
// Every synthesized function is registered as a shakeProgram() root
// (shakeAddRoot): nothing calls any of them yet -- ui.cla, their only
// caller, lands in Task 7 -- so shaking would otherwise discard every one
// of them as unreachable.
//
// Fail-closed (the plan's own rule): an out-of-range INDEX (winIdx,
// widgetIdx, handlerIdx, every-idx, rowsIdx -- every number that is a
// structural position into a blob-described array, so a value outside its
// declared count can only mean a corrupted blob or a caller bug) hits
// lowSynthPanic (log the offending dispatcher's own name + what was out of
// range, then rt_quit(1) via IQuit) instead of silently falling through.
// An EVENT value (RTUI_EV_*/RTUI_WEV_*) with no registered handler on an
// otherwise-valid window/widget is NOT an out-of-range index -- most
// windows/widgets legitimately handle only some events -- so that case
// stays a plain no-op, exactly like the OLD per-window dispatchers' own
// `default: break`.
//
// Clarus's IR has no native switch/else-if-chain statement, only nested
// SIf -- lowSynthFoldIfChain's else-arms nest a nARROWing `} else { if
// (...) {` rather than printing a flat `} else if (...) {`; both are
// valid, semantically identical C. Deepest nesting in practice is one
// level per case (7 window events, 6 widget-kind events, or a handful of
// windows/widgets/menu handlers/every blocks) -- readable, if not as flat
// as the old hand-written switches.

// lowSynthPanic builds the fail-closed "index out of range" tail every
// index-dispatching synthesized function's else-chain ends in: log a
// fixed, named message, then rt_quit(1) (IQuit) -- never reached once
// ui.cla passes only in-range indices, but the plan requires it never
// silently fall through. trailingRet (-1 for none) is appended AFTER the
// quit -- dead code, but every non-void synthesized function (only
// clar_ui_fire_staterows) still needs a real `return` for C's sake.
func lowSynthPanic(dispatcherName: string, what: string, trailingRet: int): int {
    var s1: int
    var s2: int

    s1 = newIRExprStmt(newIRIntr(ILog(), newIRStrConst(lowInternStr(dispatcherName + ": " + what + " out of range"), irStrType(255)), irVoidT))
    s2 = newIRExprStmt(newIRIntr(IQuit(), newIRIntConst(1, irIntT), irVoidT))
    irStmtListAppend(s1, s2)
    if trailingRet != -1 {
        irStmtListAppend(s2, trailingRet)
    }
    return s1
}

// lowSynthFoldIfChain folds parallel conds/bodies (same length; index i's
// cond guards bodies[i], which may be -1 for an empty arm -- a window/
// widget/etc. with no registered handler is still a real, valid index) into
// a right-nested if/else chain terminating in tailElse (-1 for "nothing
// matched, do nothing" -- the ev-level chains; a lowSynthPanic chain for
// every index-level chain).
func lowSynthFoldIfChain(conds: list of int, bodies: list of int, tailElse: int): int {
    var i: int
    var chain: int

    chain = tailElse
    i = conds.count - 1
    while i >= 0 {
        chain = newIRIf(conds[i], bodies[i], chain)
        i = i - 1
    }
    return chain
}

// lowSynthIntRef/lowSynthPtrRef mint a FRESH int/ptr-typed EVarRef to one
// of a synthesized function's own params, by name -- matching this file's
// existing convention of building a fresh VarRef at every use site (e.g.
// lowWinInstRef) rather than sharing one node across multiple parents.
func lowSynthIntRef(nm: string): int {
    return newIRVarRef(intern(nm), false, irIntT)
}

func lowSynthPtrRef(nm: string): int {
    return newIRVarRef(intern(nm), false, irPtrT)
}

// lowSynthEqInt builds `<paramName> == v` (both int) -- every index-level
// and event-level comparison these dispatchers make.
func lowSynthEqInt(paramName: string, v: int): int {
    // newIRBin's op is an INTERNED STRING ("==", not ast.cla's numeric
    // OpEq -- see fpBin's own `poolGet(irBinOp(e))`, and every existing
    // lower.cla call site, e.g. lower.cla:3173's `newIRBin(intern("=="), ...)`).
    return newIRBin(intern("=="), lowSynthIntRef(paramName), newIRIntConst(v, irIntT), irBoolT)
}

// lowFindWidgetHandlerEntryRO is lowFindWidgetHandlerEntry's read-only half
// (no append-if-missing side effect -- ordinary lowering has already
// finished by the time Task 6's synthesis runs; appending a fresh, empty
// entry here would be a silent, pointless irWinHandlers mutation).
func lowFindWidgetHandlerEntryRO(whIdx: int, widgetIndex: int): int {
    var w: int

    w = irWinHandlersWidgetHead(whIdx)
    while w != -1 {
        if irWidgetHandlerEntryWidgetIndex(w) == widgetIndex {
            return w
        }
        w = irWidgetHandlerEntryNext(w)
    }
    return -1
}

// lowSynthWinEventBody builds ONE window's ev-dispatch chain (no trailing
// else -- see this section's header comment on why an unregistered event
// is a no-op, not a fail-closed index). Mirrors cpEmitOneWinEventDispatcher's
// arg shapes exactly (cprint.cla:5154-5188); RTUI_EV_* numbers are
// rt_ui.h:98-112's own (0=OPENED..6=CANCELLED), hardcoded here exactly like
// uiblob.cla's own handlerMask walk (uibWinHandlerMask) already does --
// there is no shared Clarus-side constant table for them.
func lowSynthWinEventBody(whIdx: int): int {
    var conds: list of int
    var bodies: list of int
    var crHead: int
    var callArgs: int

    if irWinHandlersOpenedFn(whIdx) != -1 {
        conds.add(lowSynthEqInt("ev", 0))
        bodies.add(newIRExprStmt(newIRCallFn(irWinHandlersOpenedFn(whIdx), lowSynthPtrRef("inst"), irVoidT)))
    }
    if irWinHandlersCloseRequestFn(whIdx) != -1 {
        // `a` is the cancel-flag's own address (cprint.cla:5164's own
        // comment) -- set the scratch global BEFORE calling in, exactly
        // like the OLD dispatcher did.
        crHead = newIRExprStmt(newIRIntr(IUiSetCancelFlag(), newIRConv(CvIntToPtr, lowSynthIntRef("a"), -1, irPtrT), irVoidT))
        irStmtListAppend(crHead, newIRExprStmt(newIRCallFn(irWinHandlersCloseRequestFn(whIdx), lowSynthPtrRef("inst"), irVoidT)))
        conds.add(lowSynthEqInt("ev", 1))
        bodies.add(crHead)
    }
    if irWinHandlersClosedFn(whIdx) != -1 {
        conds.add(lowSynthEqInt("ev", 2))
        bodies.add(newIRExprStmt(newIRCallFn(irWinHandlersClosedFn(whIdx), lowSynthPtrRef("inst"), irVoidT)))
    }
    if irWinHandlersResizedFn(whIdx) != -1 {
        conds.add(lowSynthEqInt("ev", 3))
        bodies.add(newIRExprStmt(newIRCallFn(irWinHandlersResizedFn(whIdx), lowSynthPtrRef("inst"), irVoidT)))
    }
    if irWinHandlersKeyFn(whIdx) != -1 {
        callArgs = lowSynthPtrRef("inst")
        irExprListAppend(callArgs, newIRConv(CvIntToChar, lowSynthIntRef("a"), -1, irCharT))
        conds.add(lowSynthEqInt("ev", 4))
        bodies.add(newIRExprStmt(newIRCallFn(irWinHandlersKeyFn(whIdx), callArgs, irVoidT)))
    }
    if irWinHandlersAcceptedFn(whIdx) != -1 {
        // `a` is the walker's own validated record's address; the handler's
        // own declared param is BY VALUE (cprint.cla:5179's own comment).
        callArgs = lowSynthPtrRef("inst")
        irExprListAppend(callArgs, newIRIntr(IUiValueAtPtr(), newIRConv(CvIntToPtr, lowSynthIntRef("a"), -1, irPtrT), irRecType(irWinHandlersFormRecName(whIdx))))
        conds.add(lowSynthEqInt("ev", 5))
        bodies.add(newIRExprStmt(newIRCallFn(irWinHandlersAcceptedFn(whIdx), callArgs, irVoidT)))
    }
    if irWinHandlersCancelledFn(whIdx) != -1 {
        conds.add(lowSynthEqInt("ev", 6))
        bodies.add(newIRExprStmt(newIRCallFn(irWinHandlersCancelledFn(whIdx), lowSynthPtrRef("inst"), irVoidT)))
    }

    return lowSynthFoldIfChain(conds, bodies, -1)
}

// lowSynthFireWinEvent builds clar_ui_fire_winevent(winIdx, inst, ev, a, b)
// -- lowSynthWinEventBody per window, folded behind one outer switch(winIdx)
// (fail-closed: an unknown winIdx panics). EVERY window gets an arm, even
// one with no `extend` block at all (whIdx == -1, body left empty) -- a
// real, valid winIdx with nothing registered is not an out-of-range index.
func lowSynthFireWinEvent() {
    var paramsHead: int
    var paramsTail: int
    var conds: list of int
    var bodies: list of int
    var i: int
    var whIdx: int
    var winName: string
    var body: int
    var chain: int
    var fnameIdx: int

    paramsHead = newIRLocal(intern("winIdx"), irIntT)
    paramsTail = paramsHead
    paramsTail = irLocalListAppend(paramsTail, newIRLocal(intern("inst"), irPtrT))
    paramsTail = irLocalListAppend(paramsTail, newIRLocal(intern("ev"), irIntT))
    paramsTail = irLocalListAppend(paramsTail, newIRLocal(intern("a"), irIntT))
    paramsTail = irLocalListAppend(paramsTail, newIRLocal(intern("b"), irIntT))

    i = 0
    while i < irWindowDescs.count {
        winName = poolGet(irWindowDescName(i))
        whIdx = uiWinHandlersIdx.get(numToStr(progGen) + "|" + winName, -1)
        body = -1
        if whIdx != -1 {
            body = lowSynthWinEventBody(whIdx)
        }
        conds.add(lowSynthEqInt("winIdx", i))
        bodies.add(body)
        i = i + 1
    }

    chain = lowSynthFoldIfChain(conds, bodies, lowSynthPanic("clar_ui_fire_winevent", "winIdx", -1))
    fnameIdx = intern("clar_ui_fire_winevent")
    newIRFunc(fnameIdx, paramsHead, irVoidT, -1, chain)
    shakeAddRoot(fnameIdx)
}

// lowSynthWidgetEventBody builds one widget's ev-dispatch chain, arg shape
// per kind -- mirrors cpEmitOneWidgetDispatcher exactly (cprint.cla:
// 5196-5249): canvas gets (x, y) from (a, b); table gets (row) from a;
// everything else is zero-arg beyond inst. RTUI_WEV_* numbers are
// rt_ui.h:115-122's own (0=CLICK,1=CHANGE,2=DRAG,3=ENTER,4=SELECT,
// 5=DBLCLICK), hardcoded here exactly like uibWidgetEventMask already does.
func lowSynthWidgetEventBody(kind: string, entry: int): int {
    var conds: list of int
    var bodies: list of int
    var callArgs: int
    var tail: int

    if kind == "canvas" {
        if irWidgetHandlerEntryClickFn(entry) != -1 {
            callArgs = lowSynthPtrRef("inst")
            tail = irExprListAppend(callArgs, lowSynthIntRef("a"))
            irExprListAppend(tail, lowSynthIntRef("b"))
            conds.add(lowSynthEqInt("ev", 0))
            bodies.add(newIRExprStmt(newIRCallFn(irWidgetHandlerEntryClickFn(entry), callArgs, irVoidT)))
        }
        if irWidgetHandlerEntryDragFn(entry) != -1 {
            callArgs = lowSynthPtrRef("inst")
            tail = irExprListAppend(callArgs, lowSynthIntRef("a"))
            irExprListAppend(tail, lowSynthIntRef("b"))
            conds.add(lowSynthEqInt("ev", 2))
            bodies.add(newIRExprStmt(newIRCallFn(irWidgetHandlerEntryDragFn(entry), callArgs, irVoidT)))
        }
    } else if kind == "table" {
        if irWidgetHandlerEntrySelectFn(entry) != -1 {
            callArgs = lowSynthPtrRef("inst")
            irExprListAppend(callArgs, lowSynthIntRef("a"))
            conds.add(lowSynthEqInt("ev", 4))
            bodies.add(newIRExprStmt(newIRCallFn(irWidgetHandlerEntrySelectFn(entry), callArgs, irVoidT)))
        }
        if irWidgetHandlerEntryDoubleClickFn(entry) != -1 {
            callArgs = lowSynthPtrRef("inst")
            irExprListAppend(callArgs, lowSynthIntRef("a"))
            conds.add(lowSynthEqInt("ev", 5))
            bodies.add(newIRExprStmt(newIRCallFn(irWidgetHandlerEntryDoubleClickFn(entry), callArgs, irVoidT)))
        }
    } else {
        if irWidgetHandlerEntryClickFn(entry) != -1 {
            conds.add(lowSynthEqInt("ev", 0))
            bodies.add(newIRExprStmt(newIRCallFn(irWidgetHandlerEntryClickFn(entry), lowSynthPtrRef("inst"), irVoidT)))
        }
        if irWidgetHandlerEntryChangeFn(entry) != -1 {
            conds.add(lowSynthEqInt("ev", 1))
            bodies.add(newIRExprStmt(newIRCallFn(irWidgetHandlerEntryChangeFn(entry), lowSynthPtrRef("inst"), irVoidT)))
        }
        if irWidgetHandlerEntryEnterFn(entry) != -1 {
            conds.add(lowSynthEqInt("ev", 3))
            bodies.add(newIRExprStmt(newIRCallFn(irWidgetHandlerEntryEnterFn(entry), lowSynthPtrRef("inst"), irVoidT)))
        }
    }

    return lowSynthFoldIfChain(conds, bodies, -1)
}

// lowSynthWidgetWinBody builds one window's widgetIdx-dispatch chain --
// EVERY widget of the window gets an arm (even one with zero registered
// events: a real, valid widgetIdx with nothing to do is not an
// out-of-range index), so only a widgetIdx past the window's own widget
// count is fail-closed.
func lowSynthWidgetWinBody(winDescIdx: int, whIdx: int): int {
    var conds: list of int
    var bodies: list of int
    var w: int
    var j: int
    var kind: string
    var entry: int
    var body: int

    w = irWindowDescWidgetsHead(winDescIdx)
    j = 0
    while w != -1 {
        kind = poolGet(irWidgetDescKind(w))
        entry = lowFindWidgetHandlerEntryRO(whIdx, j)
        body = -1
        if entry != -1 {
            body = lowSynthWidgetEventBody(kind, entry)
        }
        conds.add(lowSynthEqInt("widgetIdx", j))
        bodies.add(body)
        w = irWidgetDescNext(w)
        j = j + 1
    }
    return lowSynthFoldIfChain(conds, bodies, lowSynthPanic("clar_ui_fire_widget", "widgetIdx", -1))
}

// lowSynthFireWidget builds clar_ui_fire_widget(winIdx, inst, widgetIdx,
// ev, a, b) -- lowSynthWidgetWinBody per window (even one with no `extend`
// block: same "valid index, nothing registered" reasoning as
// lowSynthFireWinEvent), folded behind one outer switch(winIdx).
func lowSynthFireWidget() {
    var paramsHead: int
    var paramsTail: int
    var conds: list of int
    var bodies: list of int
    var i: int
    var whIdx: int
    var winName: string
    var body: int
    var chain: int
    var fnameIdx: int

    paramsHead = newIRLocal(intern("winIdx"), irIntT)
    paramsTail = paramsHead
    paramsTail = irLocalListAppend(paramsTail, newIRLocal(intern("inst"), irPtrT))
    paramsTail = irLocalListAppend(paramsTail, newIRLocal(intern("widgetIdx"), irIntT))
    paramsTail = irLocalListAppend(paramsTail, newIRLocal(intern("ev"), irIntT))
    paramsTail = irLocalListAppend(paramsTail, newIRLocal(intern("a"), irIntT))
    paramsTail = irLocalListAppend(paramsTail, newIRLocal(intern("b"), irIntT))

    i = 0
    while i < irWindowDescs.count {
        winName = poolGet(irWindowDescName(i))
        whIdx = uiWinHandlersIdx.get(numToStr(progGen) + "|" + winName, -1)
        body = -1
        if whIdx != -1 {
            body = lowSynthWidgetWinBody(i, whIdx)
        }
        conds.add(lowSynthEqInt("winIdx", i))
        bodies.add(body)
        i = i + 1
    }

    chain = lowSynthFoldIfChain(conds, bodies, lowSynthPanic("clar_ui_fire_widget", "winIdx", -1))
    fnameIdx = intern("clar_ui_fire_widget")
    newIRFunc(fnameIdx, paramsHead, irVoidT, -1, chain)
    shakeAddRoot(fnameIdx)
}

// lowSynthFireMenu builds clar_ui_fire_menu(handlerIdx, frontInstOrNil) --
// one arm per irMenuHandlersHead entry, in the SAME section-position order
// uiblob.cla's blob build already uses for handlerIdx (Task 5's convention).
// frontInstOrNil is passed straight through to the handler func regardless
// of window-scoped vs. app-scope (both print as C `void *`, see ir.cla's
// KWinRef doc comment) -- the CALLER (Task 7's ui.cla) resolves which
// instance that is; this function only dispatches on handlerIdx.
func lowSynthFireMenu() {
    var paramsHead: int
    var conds: list of int
    var bodies: list of int
    var e: int
    var idx: int
    var chain: int
    var fnameIdx: int

    paramsHead = newIRLocal(intern("handlerIdx"), irIntT)
    irLocalListAppend(paramsHead, newIRLocal(intern("frontInstOrNil"), irPtrT))

    idx = 0
    e = irMenuHandlersHead
    while e != -1 {
        conds.add(lowSynthEqInt("handlerIdx", idx))
        bodies.add(newIRExprStmt(newIRCallFn(irMenuHandlerEntryFuncName(e), lowSynthPtrRef("frontInstOrNil"), irVoidT)))
        e = irMenuHandlerEntryNext(e)
        idx = idx + 1
    }

    chain = lowSynthFoldIfChain(conds, bodies, lowSynthPanic("clar_ui_fire_menu", "handlerIdx", -1))
    fnameIdx = intern("clar_ui_fire_menu")
    newIRFunc(fnameIdx, paramsHead, irVoidT, -1, chain)
    shakeAddRoot(fnameIdx)
}

// lowSynthFireEvery builds clar_ui_fire_every(idx) -- one arm per
// irEveryHead entry, in declaration order (the SAME order the `T FIRE
// every.<n>` trace index and rt_ui_every_desc[]'s own array position both
// use). Every-block funcs are zero-arg (lowEveryDecl's own instParamName
// -1), so the call passes no args at all.
func lowSynthFireEvery() {
    var paramsHead: int
    var conds: list of int
    var bodies: list of int
    var e: int
    var idx: int
    var chain: int
    var fnameIdx: int

    paramsHead = newIRLocal(intern("idx"), irIntT)

    idx = 0
    e = irEveryHead
    while e != -1 {
        conds.add(lowSynthEqInt("idx", idx))
        bodies.add(newIRExprStmt(newIRCallFn(irEveryEntryFuncName(e), -1, irVoidT)))
        e = irEveryEntryNext(e)
        idx = idx + 1
    }

    chain = lowSynthFoldIfChain(conds, bodies, lowSynthPanic("clar_ui_fire_every", "idx", -1))
    fnameIdx = intern("clar_ui_fire_every")
    newIRFunc(fnameIdx, paramsHead, irVoidT, -1, chain)
    shakeAddRoot(fnameIdx)
}

// lowSynthReleaseVarsBody releases every needs-ctor state field of one
// window. The deep-release selection rule (IRelease for a Rec/Arr,
// I*FreeVar for List/Map/Text -- see IUiSetCancelFlag et al.'s section
// header) is lowBuildScopeExitFrees' own rule (above), copied here
// verbatim: that function releases LOCAL vars at scope exit; this releases
// per-instance STATE vars at window-close time -- the exact same "the sole
// owning reference is going away" reasoning applies to both.
func lowSynthReleaseVarsBody(winNameIdx: int, stateFieldsHead: int): int {
    var head: int
    var tail: int
    var fld: int
    var ft: int
    var fieldRef: int
    var intrName: int
    var st: int

    head = -1
    tail = -1
    fld = stateFieldsHead
    while fld != -1 {
        ft = irFieldSlotType(fld)
        if irtNeedsCtor(ft) {
            fieldRef = newIRFieldRef(newIRIntr(IUiState(), lowSynthPtrRef("inst"), irUiStateType(winNameIdx)), irFieldSlotName(fld), ft)
            if lowIsRecBearing(ft) or lowArrHeapScalarBearing(ft) {
                intrName = IRelease()
            } else {
                intrName = ITextFreeVar()
                if irtKind(ft) == KList {
                    intrName = IListFreeVar()
                } else if irtKind(ft) == KMap {
                    intrName = IMapFreeVar()
                } else if irtKind(ft) == KSortedMap {
                    intrName = ISortedMapFreeVar()
                } else if irtKind(ft) == KIntMap {
                    intrName = IIntMapFreeVar()
                }
            }
            st = newIRExprStmt(newIRIntr(intrName, fieldRef, irVoidT))
            if head == -1 {
                head = st
            }
            tail = irStmtListAppend(tail, st)
        }
        fld = irFieldSlotNext(fld)
    }
    return head
}

// lowSynthReleaseVars builds clar_ui_fire_releasevars(winIdx, inst) --
// lowSynthReleaseVarsBody per window (an empty body -- a no-op -- for a
// window with no needs-ctor state field at all), folded behind one outer
// switch(winIdx). Mirrors cpEmitWinReleaseFn's own walk (cprint.cla:
// 4754-4780) at the IR level, so both backends share it.
func lowSynthReleaseVars() {
    var paramsHead: int
    var conds: list of int
    var bodies: list of int
    var i: int
    var chain: int
    var fnameIdx: int

    paramsHead = newIRLocal(intern("winIdx"), irIntT)
    irLocalListAppend(paramsHead, newIRLocal(intern("inst"), irPtrT))

    i = 0
    while i < irWindowDescs.count {
        conds.add(lowSynthEqInt("winIdx", i))
        bodies.add(lowSynthReleaseVarsBody(irWindowDescName(i), irWindowDescStateFieldsHead(i)))
        i = i + 1
    }

    chain = lowSynthFoldIfChain(conds, bodies, lowSynthPanic("clar_ui_fire_releasevars", "winIdx", -1))
    fnameIdx = intern("clar_ui_fire_releasevars")
    newIRFunc(fnameIdx, paramsHead, irVoidT, -1, chain)
    shakeAddRoot(fnameIdx)
}

// lowSynthTableRows builds clar_ui_fire_staterows(rowsIdx): ptr, returning
// the bound global's own address (IUiAddrOfGlobal) at EXACTLY the position
// uiblob.cla's uibGlobalIndex already uses for a table's Table.rowsIdx field
// (the plan's ratified "rowsIdx = the bound global's irGlobals
// declaration-order position" convention, Task 5) -- the position
// convention itself is untouched, arm conditions still test the global's
// raw declaration-order index `i`.
//
// Originally (Task 6) this emitted one arm per irGlobals entry outright --
// "every global gets an arm (not just ones some table happens to bind),
// since that position is a pure structural fact about the program, cheap
// to cover exhaustively." That stopped being cheap at self-hosting scale:
// this phase's macgui.cla split added ~210 module globals, pushing the
// program past ~800 irGlobals entries, and the exhaustive if-chain blew
// clar_ui_fire_staterows past the 32KB single-function segment limit
// (`function clar_ui_fire_staterows exceeds the 32KB segment limit`),
// blocking the ClarusC.APPL build entirely (unplanned Task 8b).
//
// Fixed invariant: emit an arm ONLY for globals whose IR type is a list
// (irtKind(irGlobalType(i)) == KList). checkRowsProperty (check.cla) only
// ever lets a `rows:` binds target a `list of record` global -- so no
// non-list-typed global can ever reach this function as a live rowsIdx at
// runtime; the existing fail-closed panic default (lowSynthPanic below)
// already covers every skipped position exactly as it covered gaps
// before. Not narrowed further to list-of-record specifically (i.e. not
// checking irtElem(...) == KRec too) -- KList alone is what the checker's
// rule structurally guarantees is reachable, and record-typed elements
// aren't needed to make that guarantee hold.
func lowSynthTableRows() {
    var paramsHead: int
    var conds: list of int
    var bodies: list of int
    var i: int
    var chain: int
    var fnameIdx: int

    paramsHead = newIRLocal(intern("rowsIdx"), irIntT)

    i = 0
    while i < irGlobals.count {
        if irtKind(irGlobalType(i)) == KList {
            conds.add(lowSynthEqInt("rowsIdx", i))
            bodies.add(newIRReturn(newIRIntr(IUiAddrOfGlobal(), newIRVarRef(irGlobalName(i), true, irGlobalType(i)), irPtrT)))
        }
        i = i + 1
    }

    chain = lowSynthFoldIfChain(conds, bodies, lowSynthPanic("clar_ui_fire_staterows", "rowsIdx", newIRReturn(newIRIntConst(0, irPtrT))))
    fnameIdx = intern("clar_ui_fire_staterows")
    newIRFunc(fnameIdx, paramsHead, irPtrT, -1, chain)
    shakeAddRoot(fnameIdx)
}

// lowSynthLaunchDoc/StartEmpty build the two toggle-style reverse-waist
// functions -- not index-dispatched at all (no fail-closed panic: there is
// nothing to be "out of range"), just "does the program declare this App
// handler at all" (irHasOpenDocument/irHasStartEmpty), matching the plan's
// own "empty-body synthesis when a program has no handler of a class" rule.
// Handler func names are lowTopHandler's own (lower.cla:3437-3455):
// "handler_App_openDocument"/"handler_App_startEmpty". (There is no
// AppLaunch counterpart: both backends call handler_App_launch directly at
// startup -- cg68k.cla's cgEmitStartupCallIfPresent, cprint.cla's own
// startup emission -- so no clar_ui_fire_applaunch dispatcher is needed.)

func lowSynthLaunchDoc() {
    var paramsHead: int
    var body: int
    var fnameIdx: int

    paramsHead = newIRLocal(intern("path"), irPtrT)
    body = -1
    if irHasOpenDocument {
        body = newIRExprStmt(newIRCallFn(intern("handler_App_openDocument"), newIRIntr(IUiValueAtPtr(), lowSynthPtrRef("path"), irStrType(255)), irVoidT))
    }
    fnameIdx = intern("clar_ui_fire_launchdoc")
    newIRFunc(fnameIdx, paramsHead, irVoidT, -1, body)
    shakeAddRoot(fnameIdx)
}

func lowSynthStartEmpty() {
    var body: int
    var fnameIdx: int

    body = -1
    if irHasStartEmpty {
        body = newIRExprStmt(newIRCallFn(intern("handler_App_startEmpty"), -1, irVoidT))
    }
    fnameIdx = intern("clar_ui_fire_startempty")
    newIRFunc(fnameIdx, -1, irVoidT, -1, body)
    shakeAddRoot(fnameIdx)
}

// lowSynthUiDispatchers is the whole section's one entry point (called
// from lowerProgram's tail).
func lowSynthUiDispatchers() {
    lowSynthFireWinEvent()
    lowSynthFireWidget()
    lowSynthFireMenu()
    lowSynthFireEvery()
    lowSynthReleaseVars()
    lowSynthTableRows()
    lowSynthLaunchDoc()
    lowSynthStartEmpty()
}

// ================================================================
// `on App.log` dispatcher synthesis (onlog phase)
// ================================================================
//
// lowSynthAppLog builds ONE extra IRFunc (plus one int global) when --
// and only when -- the program declares `on App.log(line: string)`:
//
//     func clar_app_log(line: string) {          // clar_app_fire_log
//         log(line)                              // raw ILog: persist FIRST
//         if clar_app_log_infire == 0 {
//             clar_app_log_infire = 1
//             handler_App_log(line)
//             clar_app_log_infire = 0
//         }
//     }
//
// and lowCall's own `log` arm (above) routes every user `log(x)` here
// instead of emitting the ILog intrinsic inline. Why this shape:
//
//   - ZERO churn for a handler-less program. Neither the function nor
//     the global nor the reroute exists unless the handler is declared,
//     so every existing golden/snapshot stays byte-identical. This is
//     why the reverse-waist pattern (lowSynthUiDispatchers, above) is
//     NOT reused: those are built unconditionally and reached from the
//     runtime through a bare `external func` declared in ui.cla -- an
//     extern is unconditional by construction, so a runtime-side hook
//     would add an always-present empty stub to every program.
//
//   - Persist-before-dispatch is structural, not a convention: the raw
//     ILog is the dispatcher's FIRST statement, so no handler behavior
//     (including an abort or a panic) can lose the line from the
//     persistent channel (host stderr / the native ##CLARUS-LOG##
//     trailer).
//
//   - Abort interplay needs no explicit flag test here. Every write on
//     the runtime log path that happens WHILE the abort flag is raised
//     bypasses this dispatcher by construction, verified site by site:
//     cprint's cpEmitAbortDefaultCheck emits a literal `rt_log(...)`
//     line; cg68k's cgEmitAbortDefaultCheck calls natLog by name
//     (cgCallRuntime1); native.cla's nat_CorePanic calls natLog/natAlert
//     as ordinary intra-module functions; lowSynthPanic (above) builds
//     its ILog node directly rather than through the `log` NAME arm; and
//     the UI trace machinery goes through alert()/rtUiAlertMsg, not log
//     at all. An `attempt` handler body, meanwhile, runs with the flag
//     ALREADY cleared (cprint's `clar_aborting = 0` on handler entry, and
//     cg68k's own equivalent), so a `log()` there is ordinary user code
//     and SHOULD fire. There is therefore no reachable `log()` statement
//     that executes with the abort flag raised, and nothing to guard.
//
//   - Abort PROPAGATION is the ordinary call-site kind, deliberately not
//     the UI-dispatcher kind: cgAbortCheckAfterCall gives the
//     `clar_ui_fire_*` family the in-place %3.5 default because those are
//     called from the runtime's event loop, where an abort has no Clarus
//     caller to unwind into. This dispatcher is called from ordinary user
//     code that already HAS a bail chain, so an abort raised by the
//     handler propagates out of the `log()` call site exactly like an
//     abort raised by any other callee -- which is why the name is
//     `clar_app_fire_log`, deliberately NOT matching cgSeveredFamily's
//     `clar_ui_fire_` prefix. lowComputeCanAbort runs AFTER this
//     synthesis (lowerProgram's tail), so the interprocedural analysis
//     sees the handler edge and narrows correctly.
//
// The guard needs no unwind-safe clear, and this is worth spelling out
// because the obvious reading ("an abort escaping the handler skips
// `infire = 0`, so the handler goes dormant") is WRONG here. This
// dispatcher is built by newIRFunc, so its irFuncBail is -1 -- and BOTH
// backends gate the post-call abort check on the CURRENT function having
// a bail chain (cprint.cla's `if lowUsesAbort and fpCurFuncHasBail`,
// cg68k.cla's `else if cgCurFuncHasBail and irFuncCanAbort(fi)` in
// cgAbortCheckAfterCall). No check is emitted after the
// handler_App_log(line) call above, so control ALWAYS falls through to
// the clear; the abort is picked up one frame out, at the log() call
// site's own check in the caller (which does have a bail chain).
// Verified with a host probe: a handler that aborts on its 2nd
// invocation still fires on the 3rd and 4th, guard clear, exit 0.
//
// Side effect worth knowing (semantically intended, not a defect): a
// handler that can abort() marks this dispatcher canAbort, and through
// it every function that calls log(), so lowComputeCanAbort's Task 6b
// narrowing stops suppressing post-call checks in a diagnostics-heavy
// program. Keep handlers abort-free where that check density matters.
func lowSynthAppLog() {
    var guardName: int
    var lineT: int
    var persist: int
    var setFlag: int
    var call: int
    var clrFlag: int
    var guardTest: int
    var body: int
    var param: int
    var fnNameIdx: int

    if not lowHasAppLog {
        return
    }
    // Appended AFTER every user/runtime global this compile lowered, so
    // no existing global's ORDINAL moves -- uiblob's own rowsGlobalIdx
    // (and clar_ui_fire_staterows' index dispatch) are positional, and
    // native.cla's/ui.cla's own header comments record what inserting a
    // global anywhere earlier costs.
    guardName = intern("clar_app_log_infire")
    newIRGlobal(guardName, irIntT, -1, false)

    lineT = irStrType(255)
    persist = newIRExprStmt(newIRIntr(ILog(), newIRVarRef(intern("line"), false, lineT), irVoidT))

    setFlag = newIRAssign(newIRVarRef(guardName, true, irIntT), newIRIntConst(1, irIntT))
    call = newIRExprStmt(newIRCallFn(intern("handler_App_log"), newIRVarRef(intern("line"), false, lineT), irVoidT))
    clrFlag = newIRAssign(newIRVarRef(guardName, true, irIntT), newIRIntConst(0, irIntT))
    irStmtListAppend(setFlag, call)
    irStmtListAppend(call, clrFlag)

    // `guard == 0`, mirroring lowSynthEqInt's own newIRBin(intern("=="))
    // spelling (the op is an interned STRING, not ast.cla's numeric OpEq).
    guardTest = newIRBin(intern("=="), newIRVarRef(guardName, true, irIntT), newIRIntConst(0, irIntT), irBoolT)
    body = newIRIf(guardTest, setFlag, -1)
    irStmtListAppend(persist, body)

    // This body mints no locals of its own (every node above is
    // hand-built, nothing routes through lowExpr/lowAddLocal), so the
    // IRFunc's localsHead is a literal -1; the reset is only so the last
    // real function's chain can't leak into whatever synthesis runs
    // next, matching lowSynthesizeMissingOpenedHandlers' own discipline.
    lowLocalsHead = -1
    lowLocalsTail = -1
    param = newIRLocal(intern("line"), lineT)
    fnNameIdx = intern("clar_app_fire_log")
    newIRFunc(fnNameIdx, param, irVoidT, -1, persist)
}

// ================================================================
// Connection dispatcher synthesis (serial-connection phase, Task 5)
// ================================================================
//
// The four lowSynthConnFireXxx functions below build clar_conn_fire_
// opened/received/closed/failed -- the exact extern names conn.cla
// already declares (Task 4) and rtConnPump calls -- as ordinary IRFuncs,
// following lowSynthFireWinEvent's own if-chain-over-index shape
// (lower.cla, above): one arm per SLOT (0..3, matching conn.cla's own
// `rtConnMax`), calling that slot's minted handler (lowConnHandlerFn,
// populated by lowTopHandler) when one was declared for the event, an
// empty/no-op arm otherwise -- unlike lowSynthFireWinEvent's own
// fail-closed panic default, there is no invalid slot value to guard
// against here (rtConnPump's own `while i < rtConnMax` loop is the only
// caller, always in range), so a slot with no handler is simply a real,
// valid, empty arm -- per the brief's own rule ("a slot with no handler
// for an event is a no-op").
//
// Called when `usesConn or want68k` (lowerProgram's own tail, right
// after lowSynthAppLog). Host lane: still usage-gated exactly as Task 5
// landed it -- the host lane splices conn.cla only when usesConn
// (drive.cla, Task 4), so an unconditional synthesis there would call
// rtConnOpen/etc. by name from dead code in every OTHER host program,
// breaking the "zero churn for a conn-less program" constraint that task
// was held to. 68k lane (Task 6): unconditional now, the same full-
// superset treatment lowSynthUiDispatchers just below already has --
// drive.cla splices conn.cla + conn_68k.cla into every want68k build
// regardless of usesConn, so these four dispatchers must always exist
// there too (see lowerProgram's own call site for the full reasoning).
//
// Each dispatcher self-roots via shakeAddRoot: nothing calls any of
// these four by an ECallFn node -- conn.cla's rtConnPump reaches them
// only as `external func` (ECallExt) calls, and shakeWalkExpr's own
// ECallExt case never discovers a synthesized target through one (see
// that case's own doc comment, shake.cla) -- so without an explicit
// root, shake would prune all four as unreachable. Also needs a
// lowUiSynthExternName entry each (below), so cprint's fpCallExt and its
// extern-prototype pass route the call to `clar_fn_NAME` instead of a
// nonexistent `rt_ext_NAME` shim.

// lowSynthConnFireOpened builds clar_conn_fire_opened(slot: int).
func lowSynthConnFireOpened() {
    var paramsHead: int
    var conds: list of int
    var bodies: list of int
    var i: int
    var fnName: int
    var chain: int
    var fnameIdx: int

    paramsHead = newIRLocal(intern("slot"), irIntT)

    i = 0
    while i < 4 {
        fnName = lowConnHandlerFn.get(numToStr(i) + "|opened", -1)
        conds.add(lowSynthEqInt("slot", i))
        if fnName != -1 {
            bodies.add(newIRExprStmt(newIRCallFn(fnName, -1, irVoidT)))
        } else {
            bodies.add(-1)
        }
        i = i + 1
    }

    chain = lowSynthFoldIfChain(conds, bodies, -1)
    fnameIdx = intern("clar_conn_fire_opened")
    newIRFunc(fnameIdx, paramsHead, irVoidT, -1, chain)
    shakeAddRoot(fnameIdx)
}

// lowSynthConnFireClosed builds clar_conn_fire_closed(slot: int) --
// same shape as lowSynthConnFireOpened, different event key.
func lowSynthConnFireClosed() {
    var paramsHead: int
    var conds: list of int
    var bodies: list of int
    var i: int
    var fnName: int
    var chain: int
    var fnameIdx: int

    paramsHead = newIRLocal(intern("slot"), irIntT)

    i = 0
    while i < 4 {
        fnName = lowConnHandlerFn.get(numToStr(i) + "|closed", -1)
        conds.add(lowSynthEqInt("slot", i))
        if fnName != -1 {
            bodies.add(newIRExprStmt(newIRCallFn(fnName, -1, irVoidT)))
        } else {
            bodies.add(-1)
        }
        i = i + 1
    }

    chain = lowSynthFoldIfChain(conds, bodies, -1)
    fnameIdx = intern("clar_conn_fire_closed")
    newIRFunc(fnameIdx, paramsHead, irVoidT, -1, chain)
    shakeAddRoot(fnameIdx)
}

// lowSynthConnFireReceived builds clar_conn_fire_received(slot: int,
// data: text) -- each matched arm passes `data` straight through to the
// handler (the event spec's own single `data: text` param, checkTable
// HandlerDecl already having proven a matching handler param shape).
func lowSynthConnFireReceived() {
    var paramsHead: int
    var conds: list of int
    var bodies: list of int
    var i: int
    var fnName: int
    var chain: int
    var fnameIdx: int

    paramsHead = newIRLocal(intern("slot"), irIntT)
    irLocalListAppend(paramsHead, newIRLocal(intern("data"), irTextT))

    i = 0
    while i < 4 {
        fnName = lowConnHandlerFn.get(numToStr(i) + "|received", -1)
        conds.add(lowSynthEqInt("slot", i))
        if fnName != -1 {
            bodies.add(newIRExprStmt(newIRCallFn(fnName, newIRVarRef(intern("data"), false, irTextT), irVoidT)))
        } else {
            bodies.add(-1)
        }
        i = i + 1
    }

    chain = lowSynthFoldIfChain(conds, bodies, -1)
    fnameIdx = intern("clar_conn_fire_received")
    newIRFunc(fnameIdx, paramsHead, irVoidT, -1, chain)
    shakeAddRoot(fnameIdx)
}

// lowSynthConnFireFailed builds clar_conn_fire_failed(slot: int, code:
// int, msg: string) -- the one dispatcher that needs a scratch local: the
// handler's own `err: error` param (Ch3's `{code, message}` record,
// ErrTIndex/irErrT) has to be ASSEMBLED from the two scalar params, since
// there is no literal-record-construction syntax to lower from (ExNew's
// own ENewRec form is a NAMED user record's zero-init constructor,
// `clar_new_<Name>()` -- KErr is a builtin singleton with no such ctor).
// One shared local declared ONCE (lowAddLocal, matching the ordinary
// lowFuncBody idiom exactly -- NOT lowSynthAppLog's own "no locals of its
// own" case): every matched arm is mutually exclusive at runtime, so
// reusing the same local across arms is correct and avoids one dead local
// declaration per empty arm. `.code`/`.message` are plain FieldRef writes
// (fpFieldRef's own KErr case prints them with no cv_ prefix, cprint.cla)
// routed through lowStoreStmt for the same Str-store treatment an
// ordinary `.message = msg` assignment would get.
//
// `msg`'s own PARAM type is `ptr`, not `string`, even though the extern
// this dispatcher answers for (conn.cla's `clar_conn_fire_failed(slot,
// code, msg: string)`) declares it `string` -- fpCallExt's own KStr-arg
// marshaling always passes a Str argument's ADDRESS as a bare `const
// uint8_t *` (the extern-call convention), but cpEmitFuncs prints an
// ORDINARY function's own KStr param as `const clar_str_255 *` (a
// different, if layout-compatible, C pointer type) -- typing the param
// `ptr` here sidesteps that mismatch outright (a real
// -Wincompatible-pointer-types warning otherwise, caught building this
// task's own echo fixture), and IUiValueAtPtr (ir.cla) is the existing
// intrinsic for "reinterpret this ptr as my own by-value wire type and
// copy it out" -- exactly clar_ui_fire_launchdoc's own `path: ptr` ->
// `string` marshaling one section up (lowSynthLaunchDoc), the identical
// shape reused here for `msg`.
func lowSynthConnFireFailed() {
    var paramsHead: int
    var paramsTail: int
    var conds: list of int
    var bodies: list of int
    var i: int
    var fnName: int
    var chain: int
    var fnameIdx: int
    var setCode: int
    var setMsg: int
    var callStmt: int
    var body: int

    paramsHead = newIRLocal(intern("slot"), irIntT)
    paramsTail = irLocalListAppend(paramsHead, newIRLocal(intern("code"), irIntT))
    irLocalListAppend(paramsTail, newIRLocal(intern("msg"), irPtrT))

    lowLocalsHead = -1
    lowLocalsTail = -1
    lowAddLocal(intern("err"), irErrT)

    i = 0
    while i < 4 {
        body = -1
        fnName = lowConnHandlerFn.get(numToStr(i) + "|failed", -1)
        if fnName != -1 {
            setCode = lowStoreStmt(newIRFieldRef(newIRVarRef(intern("err"), false, irErrT), intern("code"), irIntT), lowSynthIntRef("code"), irIntT)
            setMsg = lowStoreStmt(newIRFieldRef(newIRVarRef(intern("err"), false, irErrT), intern("message"), irStrType(255)), newIRIntr(IUiValueAtPtr(), lowSynthPtrRef("msg"), irStrType(255)), irStrType(255))
            irStmtListAppend(setCode, setMsg)
            callStmt = newIRExprStmt(newIRCallFn(fnName, newIRVarRef(intern("err"), false, irErrT), irVoidT))
            irStmtListAppend(setMsg, callStmt)
            body = setCode
        }
        conds.add(lowSynthEqInt("slot", i))
        bodies.add(body)
        i = i + 1
    }

    chain = lowSynthFoldIfChain(conds, bodies, -1)
    fnameIdx = intern("clar_conn_fire_failed")
    newIRFunc(fnameIdx, paramsHead, irVoidT, lowLocalsHead, chain)
    shakeAddRoot(fnameIdx)
    lowLocalsHead = -1
    lowLocalsTail = -1
}

// lowSynthConnDispatchers is this section's one entry point (called from
// lowerProgram's tail, only when usesConn).
func lowSynthConnDispatchers() {
    lowSynthConnFireOpened()
    lowSynthConnFireReceived()
    lowSynthConnFireClosed()
    lowSynthConnFireFailed()
}

// lowUiSynthExternName maps a reverse-waist extern's OWN declared Clarus
// name (as ui.cla, Task 7+, will spell it) to the interned C name of the
// IRFunc lowSynthUiDispatchers built for it above -- the ONE place (per
// the plan's reverse-waist section) both cprint's fpCallExt (skip the
// rt_ext_ prefix, call the synthesized function directly) and its
// extern-prototype pass (skip declaring a rt_ext_ shim nobody defines)
// consult. Returns -1 for any other extern name, including UiProgDesc
// (resolved separately -- see ir.cla's own doc comment on why it isn't one
// of these 8 synthesized functions) and every per-backend glue extern in
// the reverse-waist section's second half (UiCurrentA5/UiTestEmit/
// UiTestScript, plus uitable.cla's own decay-only UiCbAddr, Task 9), none
// of which this task touches.
func lowUiSynthExternName(externNameIdx: int): int {
    var nm: string

    nm = poolGet(externNameIdx)
    if nm == "UiFireWinEvent" { return intern("clar_ui_fire_winevent") }
    if nm == "UiFireWidget" { return intern("clar_ui_fire_widget") }
    if nm == "UiFireMenu" { return intern("clar_ui_fire_menu") }
    if nm == "UiFireEvery" { return intern("clar_ui_fire_every") }
    if nm == "UiReleaseVars" { return intern("clar_ui_fire_releasevars") }
    if nm == "UiFireLaunchDoc" { return intern("clar_ui_fire_launchdoc") }
    if nm == "UiFireStartEmpty" { return intern("clar_ui_fire_startempty") }
    if nm == "UiTableRows" { return intern("clar_ui_fire_staterows") }
    // Connection dispatchers (serial-connection phase, Task 5): conn.cla
    // declares these as `external func clar_conn_fire_NAME` (Task 4) and
    // rtConnPump calls them by that same literal name -- UNLIKE the UI
    // family above, the extern's declared name and the synthesized
    // IRFunc's own name are IDENTICAL strings, so this is an identity
    // mapping, not a rename; still needed so fpCallExt/the extern-
    // prototype pass route to `clar_fn_NAME` instead of a nonexistent
    // `rt_ext_NAME` shim.
    if nm == "clar_conn_fire_opened" { return intern("clar_conn_fire_opened") }
    if nm == "clar_conn_fire_received" { return intern("clar_conn_fire_received") }
    if nm == "clar_conn_fire_closed" { return intern("clar_conn_fire_closed") }
    if nm == "clar_conn_fire_failed" { return intern("clar_conn_fire_failed") }
    return -1
}

// lowerProgram walks the assembled top-level decl chain (declHead, linked via
// declNext), populating the ir.cla arenas + Program flags. Returns 0 (ir.cla
// has no wrapping Program value: the arenas ARE the program). irReset() must
// have run first.
//
// lowStrIdx reset (Task 11 fix round 1, mac-resident-clarusc): lowInternStr's
// own dedup cache maps a literal's STRING VALUE to the irStrLits index it
// was assigned -- but irReset() just wiped irStrLits itself back to empty,
// while lowStrIdx (a plain module-level map, declared with lowSwitchN/
// uiMenuCount above but never listed alongside their own "reset once per
// program in lowerProgram" doc comment) is not one of the two things this
// function already resets. A single-shot process (every front end before
// macgui.cla) never noticed: lowStrIdx starts empty at process start and
// is used exactly once. macgui.cla's gcCompile calls driveCompile (and so
// lowerProgram) repeatedly in one process; a second compile's lowering hit
// literals it had ALSO seen in the first compile's runtime-module splice
// (near-guaranteed -- both compiles splice nearly the same core/ui module
// set, sharing the same embedded error-message strings) and returned the
// FIRST compile's now-stale irStrLits index straight from the cache,
// without ever calling irAddStrLit -- so the second compile's own
// (correctly emptied) irStrLits pool stayed short while its own AST still
// carried the old, now out-of-range indices, and cg68k.cla's
// cgReserveStrLitLabels/cgPoolStrRef ("list index out of range") crashed
// walking a function body that referenced one. Root-caused on host (no Mac
// hardware needed) with a scratch driver replaying gcCompile's own
// driveReset/resetDiags/astReset/driveCompile/driveEmit68kFork sequence
// twice in one process (testdata/cg68k/tickprobe.cla then testdata/mac-
// resident/catprobe.cla, matching the live Snow run's own two `Compile...`
// dispatches) -- not committed as a lasting fixture (would need a new
// hostPaths=false-capable Go test harness this task's brief judged not
// worth adding); the regression pin is TestMacResidentClaruscOnSnow
// itself (internal/mactest/macresident_test.go), which drives this exact
// two-compile sequence on real hardware.
func lowerProgram(declHead: int): int {
    var d: int
    var freshStrIdx: map of int
    var freshUiMenuItemIdx: map of int
    var freshConnSlot: map of int
    var freshConnHandlerFn: map of int
    var connCount: int
    var connSymIdx: int

    // runtime-ir-bake Task 4: lowResumeFromBake skips exactly the two
    // pieces of reset that would clobber/duplicate an already-installed
    // baked runtime image -- see its own doc comment above (lowStrIdx's
    // decl) for why. Every other reset below (lowCurWinType and
    // siblings, lowTitleIdx, uiMenuItemIdx) is legitimately per-compile-
    // fresh regardless of a bake -- none of it has a baked counterpart
    // (task-1-report.md section (b): lowTitleIdx is the same "re-derive,
    // don't bake" lazy-guard family as ir.cla's iXxxIdx accessors;
    // uiMenuItemIdx starts empty from the runtime bake and is reassigned
    // fresh every lowerProgram call regardless, per that same report).
    if not lowResumeFromBake {
        lowSwitchN = 0
        uiMenuCount = 0
        lowStrIdx = freshStrIdx
    }
    lowCurWinType = -1
    lowCurHandlerEvent = -1
    lowCurAcceptedParam = -1
    // lowTitleIdx (memory-leak-fix Task 7): same process-lifetime
    // lazy-init idiom as ir.cla's ~162 IXxx() intrinsic-name helpers (see
    // irReset's own doc comment) -- reset to -1 here so
    // isWindowTitleSelect re-interns "title" fresh against the current
    // compile's pool generation instead of reusing a stale index from a
    // prior compile.
    lowTitleIdx = -1
    // uiMenuItemIdx (memory-leak-fix Task 7, fix round 1): lost its
    // cross-compile namespacing when check.cla's menuKey dropped progGen
    // (Task 7's own checkReset fold-in) -- menuKey is shared between
    // check.cla's menuItems (now reset every checkReset) and this map
    // (never reset, per its own decl comment's "persist" precedent), so
    // without an explicit reset here it grows unboundedly across
    // compiles. Correctness survives regardless (every read at
    // :3493/:5329 is gated by the checker having already resolved the
    // menu/item against the now-per-compile-reset menuItems), but
    // unbounded growth violates this phase's bounded-memory charter.
    // Fresh-reassign, matching lowStrIdx's own idiom just above.
    uiMenuItemIdx = freshUiMenuItemIdx
    if not lowResumeFromBake {
        lowBuiltinSaveChoiceLayout()
    }
    // ARC Task 6 stopped calling the window-var/globals escape prepasses
    // (cpEmitWinReleaseFn/cpEmitGlobalsInit release unconditionally now);
    // ARC Task 8 deleted the pass functions themselves along with the rest
    // of the 4e escape-walk apparatus (see lowBuildScopeExitFrees' own
    // section header comment).
    //
    // Extern pre-pass (Task 3, Ch13: `external func`): register every
    // `external func`'s signature into the IR extern registry BEFORE the
    // main walk below lowers any call site, so a call to an extern
    // declared LATER in source order (Ch13 permits an externDecl "anywhere
    // among a program's top-level declarations") still routes to
    // ECallExt/rt_ext_NAME correctly -- unlike an ordinary function call
    // (which resolves via check.cla's already-complete curScope, not IR
    // lowering order), lowCall's irIsExtern test can only answer from
    // what's been registered so far in ITS OWN single forward pass.
    d = declHead
    while d != -1 {
        if declKind(d) == DkExternFunc {
            lowExternDecl(d)
        }
        d = declNext(d)
    }
    // `on App.log` pre-pass (onlog phase), same reason the extern
    // pre-pass just above exists: lowCall's own `log` arm has to route
    // identically for a `log()` call site lowered BEFORE the handler's
    // decl is reached and one lowered after, and the top-level decl
    // chain has no required order. Always recomputed, never resumed from
    // a bake (a runtime module can't declare this handler, so the flag's
    // baked value would always be false anyway).
    lowHasAppLog = false
    lowCurFnRuntimeOrigin = false
    d = declHead
    while d != -1 {
        if declKind(d) == DkHandler and poolGet(handlerDeclPath(d)) == "App.log" {
            lowHasAppLog = true
        }
        d = declNext(d)
    }
    // Connection slot pre-pass (serial-connection phase, Task 5), same
    // reason the two pre-passes above exist: a method call or `on
    // <var>.<event>` handler reached BEFORE the connection var's own
    // decl (source order is not required) still needs its slot. Always
    // recomputed, never resumed from a bake (a runtime module can never
    // declare a `connection` global, so both maps are always empty
    // during a bake pass regardless). irUsesConn mirrors check.cla's
    // already-fully-computed usesConn -- see that var's own doc comment
    // (ir.cla) for why it lives there and not here.
    lowConnSlotOf = freshConnSlot
    lowConnHandlerFn = freshConnHandlerFn
    irUsesConn = usesConn
    connCount = 0
    if usesConn {
        d = declHead
        while d != -1 {
            if declKind(d) == DkVar {
                connSymIdx = scopeLookup(curScope, varDeclName(d))
                if connSymIdx != -1 and symbols[connSymIdx].typeIdx == connectionT {
                    if connCount >= 4 {
                        abort("clarusc emit: too many connection variables (max 4)")
                    }
                    lowConnSlotOf[poolGet(varDeclName(d))] = connCount
                    connCount = connCount + 1
                }
            }
            d = declNext(d)
        }
    }
    d = declHead
    while d != -1 {
        lowDecl(d)
        d = declNext(d)
    }
    lowSynthesizeMissingOpenedHandlers()
    // `on App.log` dispatcher (onlog phase) -- a no-op unless this
    // program declared the handler, so a handler-less program's IR (and
    // therefore both backends' output) is untouched. Deliberately NOT
    // inside the lowSkipUiDispatchers guard below: that flag exists to
    // stop the BAKE GENERATOR from building the reverse-waist stubs, and
    // the bake generator lowers the runtime chain alone, where
    // lowHasAppLog is false regardless.
    lowSynthAppLog()
    // Connection dispatcher synthesis (serial-connection phase, Task 5/6):
    // gated on `usesConn or want68k` now -- the host lane keeps the
    // original usesConn-only gate exactly as Task 5 landed it (so a
    // conn-less HOST program's IR, and therefore every existing host
    // golden, stays byte-identical), but the 68k lane synthesizes these
    // four dispatchers UNCONDITIONALLY, the same full-superset treatment
    // lowSynthUiDispatchers just below already has (made unconditional by
    // runtime-ir-bake Task 2). Required because drive.cla now splices
    // conn.cla + conn_68k.cla into EVERY want68k build (Task 6's own
    // splice change): conn.cla's rtConnPump calls clar_conn_fire_* by
    // name (ECallExt) regardless of whether the program declares any
    // `connection` global, so those four IRFuncs must exist and be
    // reachable on every native build or cg68k's cgCallExtUiSynth aborts
    // with "... not found/reachable" the moment shake reaches rtConnPump.
    // A conn-less want68k program still gets four real, all-empty-arm
    // dispatchers (lowConnHandlerFn is empty when usesConn is false,
    // regardless of want68k -- see this function's own pre-pass above),
    // harmless no-ops exactly like lowSynthUiDispatchers' own degrade-to-
    // no-op-body behavior its doc comment already describes.
    //
    // Snow pair review (fix round): moved inside the lowSkipUiDispatchers
    // guard just below (was its own standalone `if` here) -- outside the
    // guard, this call was excluded from the baked IR only because
    // `want68k` happens to be false during `--bake-ir` (main.cla quits
    // before ever setting it true), an INCIDENTAL fact, not an explicit
    // guard the way lowSkipUiDispatchers is for lowSynthUiDispatchers
    // just below. A future want68k-before-bake refactor could otherwise
    // silently start duplicating these four dispatchers into the baked
    // IR. Equivalent today for every real (non-bake) compile:
    // lowSkipUiDispatchers defaults false there, so `not
    // lowSkipUiDispatchers` is always true and this inner `if usesConn or
    // want68k` governs exactly as before.
    if not lowSkipUiDispatchers {
        if usesConn or want68k {
            lowSynthConnDispatchers()
        }
    }
    // Reverse-waist dispatcher synthesis (runtime-ir-bake Task 2: made
    // UNCONDITIONAL -- was gated on irIsUiProgram()'s own condition,
    // duplicated here rather than calling across the layering boundary).
    // Under the superset splice, native.cla is spliced into EVERY 68k
    // program (driveManifestSplice), and cg68AddRoots (cg68k.cla) roots
    // every "nat_*" IRFunc unconditionally -- so nat_UiLaunchReal
    // (runtime/clarus/ui.cla), rooted regardless of program shape, always
    // calls the UiFireStartEmpty() extern, which cgCallExtUiSynth resolves
    // by name to clar_ui_fire_startempty. That dispatcher (and the shake
    // root each lowSynthXxx below already registers unconditionally for
    // itself) has to exist even for a non-UI program, or cg68k quits with
    // "UI dispatcher ... not found/reachable" (cg68k.cla). Each dispatcher
    // already degrades to an empty/no-op body when its handler doesn't
    // exist (lowSynthStartEmpty et al.), so this is a no-op in shape for
    // non-UI programs, just extra always-present stub functions.
    // lowUiPortAddRoots stays gated on isUiProgram: its own roots
    // (rtUiStartup/rtUiRun/...) are only ever called by name from
    // cgEmitStartup's UI startup path (irIsUiProgram(), cg68k.cla), never
    // from a nat_*-rooted function, so a non-UI program has no need for
    // them and shake correctly drops them.
    // lowSkipUiDispatchers (runtime-ir-bake Task 5, fix round 1): the bake
    // generator's own two lowerProgram calls set this true -- see the
    // flag's own doc comment above for why. Every real compile (bake-path
    // or from-source) leaves it at its default false, so this is a no-op
    // there; the dispatchers always get built, exactly once, against the
    // REAL program's own state.
    if not lowSkipUiDispatchers {
        lowSynthUiDispatchers()
        if irWindowDescs.count > 0 or irMenuDescs.count > 0 or irEveryCount > 0 {
            lowUiPortAddRoots()
        }
    }
    // attempt-abort phase Task 6b: every IRFunc this compile will ever
    // build (including the clar_ui_fire_* dispatchers just synthesized
    // above) now exists -- the right, and only, point to run the
    // whole-program canAbort fixpoint. Gated on lowUsesAbort (already
    // final by now, set during checking -- see its own doc comment,
    // check.cla): a no-feature program has no IAbort anywhere, so this
    // would be a real whole-program O(V+E) walk for a guaranteed-empty
    // answer -- skip it entirely, see lowComputeCanAbort's own doc
    // comment for the full rationale.
    if lowUsesAbort {
        lowComputeCanAbort()
    }
    return 0
}

// lowAbortRevHead/lowAbortRevTail/lowAbortRevNext/lowAbortRevFrom: the
// direct call graph's REVERSE adjacency (keyed by CALLEE, listing its
// callers), built fresh by every lowComputeCanAbort call -- same head/
// next/tail linked-list-in-arrays shape cg68k.cla's own cgAdjHead/
// cgAdjNext/cgAdjTo/cgAdjTail already establishes for the analogous
// forward adjacency over shake's edges (see that file's own doc comment
// for why this shape: O(1) append, O(out-degree) walk, no recursion).
// lowAbortQueue is the worklist; lowAbortCurFunc/lowAbortSeeded are
// lowComputeCanAbort's own per-function walk state (mirrors shake.cla's
// shakeCurFunc).
var lowAbortRevHead: list of int
var lowAbortRevTail: list of int
var lowAbortRevNext: list of int
var lowAbortRevFrom: list of int
var lowAbortQueue: list of int
var lowAbortCurFunc: int
var lowAbortSeeded: bool

// lowComputeCanAbort (attempt-abort phase Task 6b, design doc %8's own
// deferred "only if the perf snapshot shows the naive scheme actually
// hurts" item -- task-6-report.md's own +26.3%/+6.8% measured exactly
// that): whole-program interprocedural "can this function's own
// execution leave abort()'s flag set for ITS caller to see" analysis.
// Both backends' post-call check predicate (cgAbortCheckAfterCall,
// cprint.cla's own fpCallFn call-site) narrows from "callee is
// non-runtime-origin" to "callee canAbort" using the result, shrinking
// the checked-call-site count for the overwhelming majority of an
// abort-enabled program's calls (most functions never abort and never
// call anything that does).
//
// Deliberately LANE-INDEPENDENT: runs once, here, inside lowering,
// before either backend's own shakeProgram call exists (main.cla's own
// C-lane call; drive.cla's driveEmit68kFork call for the 68k lane) --
// each shake pass has DIFFERENT extra roots (shakeAddRoot's nat_*/
// rtEnumCheck/pascal-glue names, 68k-only), so reusing either one's own
// post-shake call graph would make a shared function's canAbort verdict
// depend on WHICH lane compiled it -- breaking the full-corpus
// byte-identity gate (from-source vs --rtbake, and C-lane vs 68k-lane
// checked-call-site counts must both be reproducible from the SAME IR).
// This walk instead covers the WHOLE program unconditionally, reachable
// or not by either lane's own shake -- an edge recorded from a function
// that later shakes away in one lane only is harmless (it can only ever
// ADD a canAbort=true nobody reads, never remove one that matters), so
// both backends always agree.
//
// Design: exactly design doc %8's own wording -- "seed = every function
// whose lowered body contains an IAbort; propagate caller-ward over the
// direct call graph ... until fixed point." "Contains an IAbort" is
// checked over the function's ENTIRE body, including inside an
// attempt's own body/handler sub-chains -- this does NOT try to prove a
// same-function attempt always catches its own abort (that would need
// its own reachability-through-the-handler analysis); a function whose
// only abort is caught by its own enclosing attempt and never re-raised
// is seeded anyway, a deliberate, sound over-approximation (removes
// fewer checks than a maximally precise analysis could, never removes
// one that isn't safe to remove). Clarus has no user-level indirect
// calls (whole-program compilation, every ECallFn names its callee
// directly) and a callback's Toolbox-invoked body is never reached via
// an ECallFn edge at all (its address is taken via ECbAddr, never
// called directly from Clarus code -- ir.cla's own ECbAddr doc comment),
// so the direct call graph this walk builds is complete and exact -- no
// unknown-callee conservatism is ever needed.
//
// Runtime-origin functions are skipped entirely by the loop below --
// never seeded, never walked for their own call-outs. Design doc %3.4
// forbids attempt/abort in runtime modules, and runtime code never
// calls user functions anyway (shake.cla's own file-header comment), so
// this is belt-and-suspenders (defense against a future convention
// violation), not load-bearing.
//
// Iteration bound: standard BFS worklist over a DAG-or-cyclic call graph
// with at most irFuncs.count nodes -- each node is enqueued at most
// once (the `not irFuncCanAbort` guard before every enqueue), so the
// outer while loop below runs at most irFuncs.count times and the total
// work across all of it (building the reverse adjacency once, plus one
// pass over each node's own caller-edge list when it's popped) is
// O(V+E), not an unbounded or exponential fixpoint.
func lowComputeCanAbort() {
    var n: int
    var i: int
    var qi: int
    var f: int
    var edge: int
    var caller: int
    var freshRevHead: list of int
    var freshRevTail: list of int
    var freshRevNext: list of int
    var freshRevFrom: list of int
    var freshQueue: list of int

    n = irFuncs.count
    lowAbortRevHead = freshRevHead
    lowAbortRevTail = freshRevTail
    lowAbortRevNext = freshRevNext
    lowAbortRevFrom = freshRevFrom
    lowAbortQueue = freshQueue

    i = 0
    while i < n {
        lowAbortRevHead.add(-1)
        lowAbortRevTail.add(-1)
        i = i + 1
    }

    i = 0
    while i < n {
        if not irFuncIsRuntimeOrigin(i) {
            lowAbortCurFunc = i
            lowAbortSeeded = false
            lowAbortWalkStmts(irFuncBodyHead(i))
            if lowAbortSeeded and not irFuncCanAbort(i) {
                irFuncMarkCanAbort(i)
                lowAbortQueue.add(i)
            }
        }
        i = i + 1
    }

    // ---- worklist: propagate every newly-true function to its callers ----
    qi = 0
    while qi < lowAbortQueue.count {
        f = lowAbortQueue[qi]
        edge = lowAbortRevHead[f]
        while edge != -1 {
            caller = lowAbortRevFrom[edge]
            if not irFuncCanAbort(caller) {
                irFuncMarkCanAbort(caller)
                lowAbortQueue.add(caller)
            }
            edge = lowAbortRevNext[edge]
        }
        qi = qi + 1
    }
}

// lowAbortAddRevEdge records a callee->[callers] reverse edge (caller =
// lowAbortCurFunc, the function whose body is currently being walked) --
// see lowAbortRevHead's own doc comment for the shape.
func lowAbortAddRevEdge(callee: int) {
    var e: int

    lowAbortRevFrom.add(lowAbortCurFunc)
    lowAbortRevNext.add(-1)
    e = lowAbortRevFrom.count - 1
    if lowAbortRevHead[callee] == -1 {
        lowAbortRevHead[callee] = e
    } else {
        lowAbortRevNext[lowAbortRevTail[callee]] = e
    }
    lowAbortRevTail[callee] = e
}

// lowAbortWalkStmts/lowAbortWalkStmt/lowAbortWalkExprList/lowAbortWalkExpr
// mirror shake.cla's shakeWalkStmts/shakeWalkStmt/shakeWalkExprList/
// shakeWalkExpr exactly in SHAPE (same statement/expression kinds
// recursed into, for the same reason: finding every embedded call site),
// but answer a different question -- shake asks "is this reachable and
// what does it call, by NAME, for runtime-redirect rooting purposes";
// this asks "does lowAbortCurFunc's body contain an IAbort, and which
// OTHER real IRFuncs does it call" -- so this does not need shake's own
// runtime-redirect table (shakeWalkIntr) or root bookkeeping at all, just
// the plain structural recursion.
func lowAbortWalkStmts(head: int) {
    var s: int

    s = head
    while s != -1 {
        lowAbortWalkStmt(s)
        s = irStmtNext(s)
    }
}

func lowAbortWalkStmt(s: int) {
    var k: IRStmtKind

    k = irStmtKind(s)
    if k == SAssign {
        lowAbortWalkExpr(irAssignDst(s))
        lowAbortWalkExpr(irAssignSrc(s))
    } else if k == SStoreStr {
        lowAbortWalkExpr(irStoreStrDst(s))
        lowAbortWalkExpr(irStoreStrSrc(s))
    } else if k == SExprStmt {
        lowAbortWalkExpr(irExprStmtX(s))
    } else if k == SIf {
        lowAbortWalkExpr(irIfCond(s))
        lowAbortWalkStmts(irIfThen(s))
        lowAbortWalkStmts(irIfElse(s))
    } else if k == SWhile {
        lowAbortWalkExpr(irWhileCond(s))
        lowAbortWalkStmts(irWhileBody(s))
    } else if k == SForRange {
        lowAbortWalkExpr(irForRangeFrom(s))
        lowAbortWalkExpr(irForRangeTo(s))
        lowAbortWalkStmts(irForRangeBody(s))
    } else if k == SForList {
        lowAbortWalkExpr(irForListListV(s))
        lowAbortWalkStmts(irForListBody(s))
    } else if k == SForMap {
        lowAbortWalkExpr(irForMapMapV(s))
        lowAbortWalkStmts(irForMapBody(s))
    } else if k == SReturn {
        lowAbortWalkExpr(irReturnX(s))
    } else if k == SAttempt {
        lowAbortWalkStmts(irAttemptBody(s))
        lowAbortWalkStmts(irAttemptHandler(s))
    }
    // SBreak/SContinue: no fields to walk.
}

func lowAbortWalkExprList(head: int) {
    var e: int

    e = head
    while e != -1 {
        lowAbortWalkExpr(e)
        e = irExprNext(e)
    }
}

func lowAbortWalkExpr(x: int) {
    var k: IRExprKind
    var callee: int

    if x == -1 {
        return
    }
    k = irExprKind(x)
    if k == EFieldRef {
        lowAbortWalkExpr(irFieldRefX(x))
    } else if k == EIndexRef {
        lowAbortWalkExpr(irIndexRefX(x))
        lowAbortWalkExpr(irIndexRefI(x))
    } else if k == EBin {
        lowAbortWalkExpr(irBinX(x))
        lowAbortWalkExpr(irBinY(x))
    } else if k == EUn {
        lowAbortWalkExpr(irUnX(x))
    } else if k == EConv {
        lowAbortWalkExpr(irConvX(x))
    } else if k == ECallFn {
        callee = findIRFuncIdxByName(irCallFnName(x))
        if callee != -1 {
            lowAbortAddRevEdge(callee)
        }
        lowAbortWalkExprList(irCallFnArgsHead(x))
    } else if k == ECallExt {
        lowAbortWalkExprList(irCallExtArgsHead(x))
    } else if k == EIntr {
        if irIntrName(x) == IAbort() {
            lowAbortSeeded = true
        }
        lowAbortWalkExprList(irIntrArgsHead(x))
    }
    // ECbAddr: taking a callback's address is not a call (mirrors
    // shake.cla's own reasoning) -- the callback's own body is walked
    // separately by lowComputeCanAbort's outer loop, as an ordinary
    // irFuncs entry in its own right; EIntConst/EStrConst/EVarRef/
    // ENewRec/EXRecAddr carry no child expressions.
}

// lowUiPortAddRoots (Task 7 Step 6, native-5e): registers every ported
// ui.cla/uiwidgets.cla entry point cprint.cla's --uiport intrinsic
// redirect (fpIntrCall's IUiOpen/IUiClose/... arms) and cpEmitUiMain
// call by NAME as a shakeProgram() root -- the SAME problem Task 6's own
// synthesized-dispatcher roots solved (this function's own header
// comment, just above): none of these are reached via an ordinary IR
// ECallFn node anywhere (cprint only ever references them by hand-built
// STRING, inside fpIntrCall/cpEmitUiMain, which runs AFTER shakeProgram
// has already decided what survives), so without this, shaking would
// discard every one of them as unreachable dead code -- confirmed
// empirically (Task 7's own report): the very first --uiport emit after
// wiring cpEmitUiMain/fpIntrCall's redirects called `clar_fn_rtUiOpen`/
// `clar_fn_rtUiStartup`/etc. from `main()` with NO matching definition
// anywhere in the output at all. Every OTHER ui.cla/uiwidgets.cla/
// uiscript.cla function (rtUiLayout, rtUiMakeWidgets, rtUiHandleUpdate,
// the whole trace/scripted-interpreter family, ...) needs no root of its
// own: normal reachability from THESE roots (ordinary Clarus-to-Clarus
// function calls, which shakeProgram tracks exactly like every other
// program's call graph) keeps them alive automatically.
func lowUiPortAddRoots() {
    shakeAddRoot(intern("rtUiStartup"))
    shakeAddRoot(intern("rtUiLaunch"))
    shakeAddRoot(intern("rtUiRun"))
    shakeAddRoot(intern("rtUiOpen"))
    shakeAddRoot(intern("rtUiClose"))
    shakeAddRoot(intern("rtUiQuit"))
    shakeAddRoot(intern("rtUiFront"))
    shakeAddRoot(intern("rtUiState"))
    shakeAddRoot(intern("rtUiSetTitle"))
    shakeAddRoot(intern("rtUiGetTitle"))
    shakeAddRoot(intern("rtUiWidgetSetStr"))
    shakeAddRoot(intern("rtUiWidgetGetStr"))
    shakeAddRoot(intern("rtUiWidgetGetText"))
    shakeAddRoot(intern("rtUiWidgetSetText"))
    shakeAddRoot(intern("rtUiWidgetGetBool"))
    shakeAddRoot(intern("rtUiWidgetSetBool"))
    shakeAddRoot(intern("rtUiWidgetGetInt"))
    shakeAddRoot(intern("rtUiWidgetSetInt"))
    shakeAddRoot(intern("rtUiMenuEnable"))
    shakeAddRoot(intern("rtUiCanvasClear"))
    shakeAddRoot(intern("rtUiCanvasLine"))
    shakeAddRoot(intern("rtUiCanvasRect"))
    shakeAddRoot(intern("rtUiCanvasCircle"))
    shakeAddRoot(intern("rtUiCanvasFillCircle"))
    shakeAddRoot(intern("rtUiCanvasPattern"))
    shakeAddRoot(intern("rtUiCanvasDrawText"))
    // Task 10 (native-5e slice D): rtUiAskOpen/rtUiAskSave/
    // rtUiAskSaveChanges/rtUiEdit/rtUiFormIsNew -- cprint.cla's
    // askOpen/askSave/askSaveChanges/edit/formIsNew arms all call these by
    // hand-emitted C text (`clar_fn_rtUiXxx(...)`), not an ordinary IR
    // call, same "needs its own root" reason every other name in this
    // list already has.
    shakeAddRoot(intern("rtUiAskOpen"))
    shakeAddRoot(intern("rtUiAskSave"))
    shakeAddRoot(intern("rtUiAskSaveChanges"))
    shakeAddRoot(intern("rtUiEdit"))
    shakeAddRoot(intern("rtUiFormIsNew"))
    // Task 9 (toolbox-integration Feature C): rtUiLdefDraw (uitable.cla)
    // used to need the same hand-rooting treatment as the names above --
    // the OLD hand-written LDEF pascal wrapper in rt_ext_mac.inc called it
    // by FIXED NAME from a genuinely different translation unit, no
    // ordinary Clarus call site reaching it at all. Now that rtUiLdefDraw
    // is a `callback func`, decayed at its one real call site
    // (rtUiMakeLdefStub, uitable.cla), shake.cla's own ECbAddr edge
    // discovers it through the ordinary reachability walk -- no explicit
    // root needed here anymore (removed).
}

// IRFunc constructors and accessors (irFuncs arena -- Program.Funcs)
// ================================================================

func newIRFunc(name: int, paramsHead: int, ret: int, localsHead: int, bodyHead: int): int {
    var n: IRFunc

    n.name = name
    n.paramsHead = paramsHead
    n.ret = ret
    n.localsHead = localsHead
    n.bodyHead = bodyHead
    irFuncs.add(n)
    if not irFuncIdxByName.has(name) {
        irFuncIdxByName[name] = irFuncs.count - 1
    }
    return irFuncs.count - 1
}

func irFuncName(i: int): int {
    return irFuncs[i].name
}

func irFuncParamsHead(i: int): int {
    return irFuncs[i].paramsHead
}


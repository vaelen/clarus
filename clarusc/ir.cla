// newIRXRecFieldSlot builds an `extern record` field slot (Task 4,
// toolbox-integration Feature B) -- lowXRecDecl's own constructor,
// carrying the palette storage KIND (xkind, an XFxxx code) and its
// str[N]/pad[N] length (xn) alongside the ordinary read TYPE t
// (newIRFieldSlot's own two fields, default/defaultStr, are always 0/-1:
// an xrec field is never defaulted, Ch13).
func newIRXRecFieldSlot(name: int, t: int, xkind: int, xn: int): int {
    var n: IRFieldSlot

    n.name = name
    n.t = t
    n.default = 0
    n.defaultStr = -1
    n.next = -1
    n.xkind = xkind
    n.xn = xn
    irFieldSlots.add(n)
    return irFieldSlots.count - 1
}

func irFieldSlotXKind(i: int): int {
    return irFieldSlots[i].xkind
}

func irFieldSlotXN(i: int): int {
    return irFieldSlots[i].xn
}


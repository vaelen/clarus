// ir.cla: the arena IR -- a port of internal/ir/ir.go (node shapes) and
// internal/ir/intrinsics.go (the 53 intrinsic-name constants). Follows
// ast.cla's arena idiom exactly: every node kind lives in a `list of X`
// arena, referenced by `int` index (`-1` is nil); variable-arity sequences
// (arg lists, stmt-list bodies, param/local lists, field/member lists) are
// intrusive singly-linked lists threaded through each node's own `next`
// field, with the sequence's head stored in whatever node/record owns it.
// Every name and every string literal is interned into the shared
// strPool/intern (lib.cla) -- ir.go's Type.Name and every *.Name string
// field become a strPool index here.
//
// This module holds no logic beyond constructors/accessors: lower.cla
// (Task 6+) is the only writer, cprint.cla (Task 9+) is the only reader.
// Every symbol here is prefixed `ir`/`IR` (functions lowercase, types
// uppercase) so it can never collide with ast.cla/check.cla/types.cla's
// identically-shaped-but-differently-named AST symbols when all modules
// are `include`d together.
//
// Go's ir.go carries no source-position fields on any IR node (lowering
// has already consumed positions into diagnostics), so unlike ast.cla's
// node records, none of the records below have line/col fields.
//
// One Program is in flight at a time (one `clarusc emit` invocation lowers
// one program from a clean slate), so -- exactly as ast.cla's four arenas
// stand in for "the AST" without a wrapping Program-of-arenas type --
// ir.go's Program.{Globals,Funcs,StrLits,Records,Enums} are simply the
// irGlobals/irFuncs/irStrLits/irRecords/irEnums arenas below, populated in
// declaration order, plus three flag vars for HasLaunch/HasStartEmpty/
// HasStartCLI. irReset clears every arena and re-seeds the singleton
// scalar IRTypes, mirroring astReset/typesReset's role in the differential
// harness: arenas must not leak across independently-compiled programs.
//
// ============================================================
// SCHEMA: per-kind meaning of fields
// ============================================================
//
// ---- IRKind (irTypes arena entries) ----
//   KVoid/KInt/KBool/KFixed/KChar/KText/KErr  no other field meaningful
//   KStr   n=capacity
//   KList  elem=element IRType index
//   KMap   elem=value IRType index
//   KRec   name=record name (interned)
//   KEnum  name=enum name (interned)
//   KArr   n=length, elem=element IRType index
//
// ---- IRStmtKind (irStmts arena) ----
//   SAssign    a=Dst expr; b=Src expr
//   SStoreStr  a=Dst expr; b=Src expr
//   SExprStmt  a=X expr
//   SIf        a=Cond expr; b=Then-body stmt-list head; c=Else-body
//              stmt-list head (-1 if no else)
//   SWhile     a=Cond expr; b=Body stmt-list head
//   SForRange  nameIdx=V (loop int local, interned); a=From expr; b=To
//              expr; c=Body stmt-list head
//   SForList   nameIdx=V (element local, interned); a=ListV expr; b=Body
//              stmt-list head
//   SForMap    nameIdx=K (interned); intVal=V (interned); a=MapV expr;
//              b=Body stmt-list head
//   SReturn    a=X expr (-1 for bare `return`)
//   SBreak     no fields used
//   SContinue  no fields used
//
// ---- IRExprKind (irExprs arena; every kind also carries ty=IRType index) ----
//   EIntConst  intVal=V (int/bool(0|1)/char/enum-value/fixed-raw constant)
//   EStrConst  intVal=Idx (irStrLits index -- the literal pool)
//   EVarRef    name=Name (interned); global=Global
//   EFieldRef  a=X expr; name=Name (interned)
//   EIndexRef  a=X expr; b=I expr
//   EBin       name=Op (interned operator spelling, e.g. "+"); a=X expr;
//              b=Y expr
//   EUn        name=Op (interned operator spelling); a=X expr
//   EConv      convOp=Op (IRConvOp); a=X expr; name=EnumName (interned,
//              -1 unless Op is CvIntToEnum/CvEnumToInt)
//   ECallFn    name=Name (interned); b=Args list head (each arg an IRExpr
//              chained via its own .next, -1 if none)
//   ECallExt   (Task 3, Ch13: `external func`) name=Name (interned); b=Args
//              list head (as ECallFn) -- printed as a call to the host
//              symbol rt_ext_NAME rather than clar_fn_NAME; the callee's
//              signature (for cprint's extern prototype) lives in the
//              extern registry below (irRegisterExtern), keyed by name,
//              not on this node
//   EIntr      name=Name (interned intrinsic name); b=Args list head (as
//              ECallFn)
//   ENewRec    name=RecName (interned)
//
// `next` on an IRExpr is used ONLY when that node is one argument in some
// ECallFn/EIntr's argument list; otherwise -1 (mirrors ast.cla's ExprNode
// .next discipline exactly).

include "lib.cla"

enum IRKind {
    KVoid
    KInt
    KBool
    KFixed
    KChar
    KStr
    KText
    KList
    KMap
    KRec
    KEnum
    KArr
    KErr

    // KWinRef/KUiState (Task 4: UI lowering) are always `void *` in C --
    // rt_ui's whole ABI addresses window instances and their per-instance
    // state opaquely (rt_ui_open/front/state all traffic in void*). `name`
    // (IRType's named-type-identity field, same slot KRec/KEnum use) carries
    // the window TYPE name: for KWinRef so `open`/`.front`/`nil` all agree on
    // which window type's C spelling to produce (see IUiOpen/IUiFront's
    // cprint case, which reads it back off the Intr node's own `ty`); for
    // KUiState so the one rt_ui_state() cast this type always wraps (see
    // IUiState's cprint case) casts to the right window's clar_uistate_NAME
    // struct. KUiState is never a real variable's type -- only the transient
    // base of a per-instance-var FieldRef (lower.cla's lowWindowInstSelect).
    KWinRef
    KUiState

    // KPtr (Task 2, Ch13: Low-Level Memory Access) is an untyped machine
    // address, C type `void *` (see cpCTypeName) -- an ordinary by-value
    // scalar, never parametrized, so it is a singleton like KInt/KBool
    // (irPtrT, seeded in irReset below).
    KPtr

    // KOverlay (Plan 5b Task 2, Ch13: Overlay Records) is a named view over
    // raw memory: `name` (same slot KRec/KEnum use) carries the overlay
    // type's own interned name, C type `clar_rec_<Name> *` (cpCTypeName) --
    // a real pointer, unlike KRec's clar_rec_<Name> (by-value struct).
    // Deliberately absent from irtNeedsCtor below: an overlay value's
    // all-zero representation (NULL) is already a valid value (Ch13's
    // zero-value guarantee, same as KPtr), so it never needs construction
    // and is never handle-backed -- the ARC machinery (irRecHasHandleField,
    // lowIsRecBearing, cpEmitRcWalks) never sees this kind at all.
    KOverlay

    // KWord (Task 4, native-5e, Ch13: the `word` extern type) marks a
    // 16-bit-at-the-trap-boundary int -- it appears ONLY inside the extern
    // registry's own param/return types (irExternParamTys/irExternRetTys,
    // populated by lower.cla's lowResolveType reading a TxWord TypeExpr
    // straight off the AST), never as a real variable/field/local's type:
    // every OTHER lowering path goes through lowType(checked-type), and
    // the checker's own resolveType resolves TxWord to plain IntT (see
    // check.cla's resolveType), so a word-declared param/return's checked
    // type -- and therefore every ordinary expression built from it -- is
    // indistinguishable from int. Only cg68k.cla's cgCallExtPascal (the
    // Pascal-convention marshaling that actually cares about the 16-bit
    // wire width) and cprint.cla's extern-shim C emission (short) ever
    // read a KWord back out of the extern registry.
    KWord

    // KXRec (Task 4, toolbox-integration Feature B: `extern record`) marks
    // a NESTED extern-record FIELD's declared type inside an IRFieldSlot's
    // own `t` (`name`, same slot KRec/KOverlay/KEnum use, carries the
    // nested record's interned name -- irFindRecordLayoutByName resolves
    // it back to an irRecords index). Deliberately NEVER the type of a
    // real variable/local/global: an xrec's own STORAGE is represented as
    // a plain KArr of KChar (lowType's TyXRec case) -- the same fixed-
    // byte-buffer shape a `char[N]` local/global already gets, reusing
    // that storage/zero-init path wholesale per the spec's own
    // instruction, rather than inventing a second one. KXRec exists
    // purely so irXRecFieldSize/irXRecFieldAlign's own XFRec case can find
    // a nested field's packed size (irXRecSize, recursively) from its
    // slot's `t` alone.
    KXRec

    // KSortedMap (map-hashtable phase, Task 2) is `sortedmap of T`'s IR
    // type -- same elem=value IRType index shape as KMap, but backed by
    // the DISTINCT rtSortedMap* runtime (ascending key order). Appended
    // last, after KXRec; ordering among the other kinds is not
    // load-bearing.
    KSortedMap

    // KIntMap (map-hashtable phase, Task 7) is `intmap of T`'s IR type --
    // same elem=value IRType index shape as KMap/KSortedMap, but keyed by
    // int (rtIntMap* runtime, Task 6). Appended last, after KSortedMap;
    // ordering among the other kinds is not load-bearing.
    KIntMap
}

enum IRStmtKind {
    SAssign
    SStoreStr
    SExprStmt
    SIf
    SWhile
    SForRange
    SForList
    SForMap
    SReturn
    SBreak
    SContinue
}

enum IRExprKind {
    EIntConst
    EStrConst
    EVarRef
    EFieldRef
    EIndexRef
    EBin
    EUn
    EConv
    ECallFn
    ECallExt
    EIntr
    ENewRec

    // EXRecAddr (Task 4, toolbox-integration Feature B: `extern record`)
    // yields the address of an xrec variable or a nested field within one
    // -- name=base var's Name (interned), global=base var's Global (EXACT
    // same two fields EVarRef itself uses -- an EXRecAddr IS conceptually
    // "EVarRef's address, plus a literal byte offset", never a pointer
    // indirection: extern-record storage is always a flat local/global
    // buffer, per Ch13, so this pair alone identifies which buffer);
    // intVal=byteOffset (a literal, already fully resolved by lower.cla's
    // own recursive field-chain walk -- an arbitrarily nested `ev.a.b.c`
    // collapses to ONE EXRecAddr with ONE summed offset, never a chain of
    // them); ty=irPtrT (the node's own value IS an address). Both
    // backends' job (Tasks 5-6): resolve (name, global) into the SAME
    // address computation EVarRef already knows how to make (a frame
    // offset for a local, a symbol for a global), then add intVal bytes --
    // conceptually identical to EIndexRef's "base address + index*elemSize"
    // (see lower.cla's lowXRecAddr), just with a byte-granular literal
    // instead of an index*width multiply. Peek/poke's existing intrinsics
    // (IPeekB/W/L, IPokeB/W/L) take an EXRecAddr as their address argument
    // completely unchanged -- an EXRecAddr is just one more `ptr`-typed
    // expression, structurally no different from an EVarRef-of-a-ptr-local
    // in that argument slot.
    EXRecAddr

    // ECbAddr (Task 7, toolbox-integration Feature C: `callback func`)
    // yields the address of a `callback func`'s generated pascal glue
    // wrapper (cprint.cla's clar_cb_<name>) -- name=the callback's own
    // Name (interned); ty=irPtrT (the node's own value IS an address,
    // same convention as EXRecAddr). Built ONLY by lower.cla's
    // lowCallArgs, at the ONE position checkArgsCall proves legal on a
    // checker-clean program (an extern call's ptr-typed argument, a bare
    // callback name) -- see newIRCbAddr's own doc comment for why building
    // one also registers into irCbGlueNames, cprint's own "which callbacks
    // need a wrapper at all" list. shake.cla's own ECbAddr arm marks name
    // reachable exactly like ECallFn does, so the callback's BODY
    // (clar_fn_<name>, which the glue wrapper calls) is never skipped as
    // dead while its glue survives -- unlike ECallFn, taking a callback's
    // address is not itself a CALL, so without this arm the callback's own
    // body would never be discovered through the ordinary call-graph walk.
    ECbAddr
}

// IRConvOp: the 6 checked/unchecked scalar conversions (ir.go:182-191), plus
// CvIntToPtr/CvPtrToInt (Task 2, Ch13: Low-Level Memory Access -- `ptr(x)`/
// `int(p)`) and CvPtrToOverlay/CvOverlayToPtr (Plan 5b Task 2, Ch13: Overlay
// Records -- `OverlayName(p)`/`ptr(o)`) -- clarusc-only additions; the
// frozen Go reference has no ptr/overlay types. CvIntToEnum is CHECKED
// (panics on no member); the rest, including all four ptr/overlay
// conversions, are unchecked reinterpretations.
//
// CvSExt16/CvIntNonZero (Task 4, toolbox-integration Feature B) are the
// extern-record field READ extension ops Ch13's field palette requires,
// unrelated to any checked-type conversion a program can write: a `word`
// field's raw peekw result is zero-extended (peekw's own existing
// contract), but the field itself must read back SIGN-extended (the same
// rule an extern call's own `word` RESULT already follows, Feature A) --
// CvSExt16 makes that correction explicit as its own IR node rather than
// silently baking it into a backend's peekw case, so both backends apply
// it identically. CvIntNonZero normalizes a `bool` field's raw peekb
// result (0..255, a real Toolbox Boolean is not guaranteed exactly 0/1)
// to canonical 0/1. Neither is reachable from ordinary Clarus source --
// only lower.cla's xrec field-read lowering ever constructs one.
enum IRConvOp {
    CvIntToFixed
    CvFixedToInt
    CvIntToChar
    CvCharToInt
    CvEnumToInt
    CvIntToEnum
    CvIntToPtr
    CvPtrToInt
    CvPtrToOverlay
    CvOverlayToPtr
    CvSExt16
    CvIntNonZero
}

record IRType {
    k: IRKind
    n: int
    elem: int
    name: int
}

record IRStmt {
    kind: IRStmtKind
    a: int
    b: int
    c: int
    next: int
    nameIdx: int
    intVal: int
}

record IRExpr {
    kind: IRExprKind
    a: int
    b: int
    name: int
    intVal: int
    global: bool
    convOp: IRConvOp
    ty: int
    next: int
}

// IRLocal covers both ir.go's Func.Params and Func.Locals -- identical
// shape (Name, T) in Go, so one record/arena serves both; a Func stores a
// separate paramsHead/localsHead chain into this same arena.
record IRLocal {
    name: int
    t: int
    next: int
    // nobirth (memory-leak-fix Task 2): true for lowering's synthetic
    // __store temps (lowCountedStoreRecVal / the counted-store site in
    // lower.cla) -- their prologue init must be NULL/zero, never a
    // container/record birth, because the temp is only released at its
    // own store site; a return path that skips that site would otherwise
    // leak the prologue birth. Never set for lowNewReturnTemp temps.
    nobirth: bool
}

record IRFunc {
    name: int
    paramsHead: int
    ret: int
    localsHead: int
    bodyHead: int
}

record IRGlobal {
    name: int
    t: int
    init: int
    // initBirth (ARC Task 6 fix): whether `init` (if any) is a birth value
    // per lowStoreIsBirth/lowStoreIntrOwnsResult -- lowGlobalVarDecl's own
    // AST-time classification, mirroring lowCountedStore's for a runtime
    // store. cpEmitGlobalsInit's Init-emission path never routes through
    // lowCountedStore (it prints the Init directly, not via a statement
    // chain), so this is how a non-birth (aliasing) Init tells the printer
    // it needs a matching retain -- see cpEmitGlobalsInit's own comment.
    initBirth: bool
}

// IRFieldSlot ports ir.go's FieldSlot: default is the scalar/enum/char/
// bool/fixed-raw default; defaultStr is -1, or an irStrLits index for a
// string default.
// xkind/xn (Task 4, toolbox-integration Feature B) carry an `extern
// record`'s own per-field storage kind (an XFxxx code, below) and its
// str[N]/pad[N] length -- meaningless (left at their zero value, XFNone/0)
// on every OTHER IRFieldSlot use (a plain/overlay record's fields, a
// window's per-instance state fields). lowXRecDecl (lower.cla) is the only
// writer; irXRecFieldSize/irXRecFieldAlign (below) are the only readers.
// t still carries the field's ordinary Clarus read type (IntT/BoolT/PtrT/a
// strT(N)'s IR shape, or -- XFRec only -- the nested record's own KXRec
// IRType) for lowering's field-read/write codegen; it is NOT the layout
// authority (xkind/xn/t-for-XFRec are).
record IRFieldSlot {
    name: int
    t: int
    default: int
    defaultStr: int
    next: int
    xkind: int
    xn: int
}

// XRecFieldKind: the Ch13 field-palette storage kinds an IRFieldSlot's
// xkind carries for an `extern record` (Task 4). Plain int codes, not a
// Clarus enum, so check.cla (which independently re-derives the exact same
// per-field kind from the AST for its OWN total-size computation -- see
// its own doc comment on why it can't just read this arena, which doesn't
// exist yet at check time) never needs to `include "ir.cla"` to agree with
// it; the two are kept in lockstep by doc comment, not by a shared type.
const XFNone: int = 0
const XFBool: int = 1
const XFByte: int = 2
const XFWord: int = 3
const XFInt: int = 4
const XFPtr: int = 5
const XFRec: int = 6
const XFStr: int = 7
const XFPad: int = 8

record IRRecordLayout {
    name: int
    fieldsHead: int
    // isOverlay (Plan 5b Task 2, Ch13: Overlay Records) tags this layout as
    // an `overlay record` -- cpEmitRecords still emits the typedef (an
    // overlay's field list is needed for the same reason a plain record's
    // is) but skips the clar_new_NAME constructor for it (an overlay is
    // never constructed, only cast onto existing memory).
    isOverlay: bool
    // isXRec (Task 4, toolbox-integration Feature B) tags this layout as
    // an `extern record` -- mutually exclusive with isOverlay. Consulted
    // by lower.cla's own irXRecFieldOffset/irXRecSize authority below;
    // cpEmitRecords/cg68k's own record emission never construct a C
    // struct/asm layout for one at all (an xrec's storage is a plain byte
    // buffer, not a typedef -- see lowType's TyXRec case), so this flag's
    // only reader today is the layout authority itself, unlike isOverlay's
    // two backend readers.
    isXRec: bool
}

// IREnumMember mirrors ir.go's EnumLayout's parallel Members/Values/Labels
// slices as one chained record per member.
record IREnumMember {
    name: int
    value: int
    label: int
    next: int
}

record IREnumLayout {
    name: int
    membersHead: int
}

// ---- UI descriptor IR (Task 4) ----
// window/menu declarations -> static rt_ui_*_desc tables. Shape mirrors
// check.cla's own already-validated side tables (widgetInfos/
// windowVarsHead/windowWidgetsHead, the DkMenuEntry chain) field-for-field;
// lower.cla (lowWindowDecl/lowWidgetDesc/lowMenuDecl) copies that data in,
// cprint.cla owns turning it into rt_ui.h's exact C spelling (macro names,
// Str255 literal syntax) -- the same lower-extracts/cprint-spells division
// IRRecordLayout/IRFieldSlot already establish for record structs, reused
// here rather than invented afresh.

// IRWidgetDesc: one entry in a window's rt_ui_widget_desc[] (Ch8: Widgets,
// Layout). kindIdx is the interned widget-kind word ("button"/"check"/
// "canvas"/"label" -- the whole rt_ui widget surface); captionIdx is the
// interned raw caption/text/label content (-1 if the widget has none, e.g.
// canvas). atKind: 0 = explicit `at: x, y`; 1 = `at: next, ...` (x taken
// from the previous widget by the runtime; this entry's own `x` is an
// unused placeholder, always 0); 2 = `at: right, ...` (x similarly
// runtime-computed, placeholder 0); 3 = no `at:` property given at all
// (mac-target-4d Task 9) -- the runtime vertical-stacks it instead, x/y
// unused placeholders, always 0 (see lowWidgetDesc's own fillBoth
// exception: a `fill: both` widget with no `at:` keeps atKind 0/(0,0)
// instead, unchanged from before this task). yIsBottom/widthIsFill mark the
// `bottom`/`fill` sentinels (`y`/`width` are unused placeholders, 0, when
// their sentinel flag is set) -- Ch8's "at: next, bottom" and "width: fill".
// isScrollV/isScrollH (mac-target-4c Task 2) mark a textview's
// `scrollbar: vertical` (isScrollV only) or `scrollbar: both` (both set) --
// always false for every other widget kind.
//
// bindsIdx/rowsGlobalIdx/columnsHead (mac-target-4d Task 5) are -1 for every
// widget kind except popup/table: bindsIdx is popup's bound form-record
// field name (interned, check.cla's WidgetInfo.bindsIdx precedent -- -1
// means no `binds:` given); rowsGlobalIdx is a table's `rows:` global list
// variable's own interned NAME (not an arena index -- cprint.cla's
// cpFindGlobalRecName scans irGlobals by this name to find the row record's
// clar_layout_NAME); columnsHead chains this table's IRColumnDesc list (-1
// if none, though a real table always has >=1 column by Ch10 grammar).
record IRWidgetDesc {
    nameIdx: int
    kindIdx: int
    captionIdx: int
    atKind: int
    x: int
    yIsBottom: bool
    y: int
    widthIsFill: bool
    width: int
    fillBoth: bool
    isDefault: bool
    isCancel: bool
    isBuffered: bool
    isScrollV: bool
    isScrollH: bool
    bindsIdx: int
    rowsGlobalIdx: int
    columnsHead: int
    next: int
}

// IRColumnDesc: one `column "Header" shows field width N|fill` entry (Ch10)
// in a table widget's rt_ui_col_desc[] -- chained off IRWidgetDesc.columnsHead,
// same arena-with-next idiom as IRMenuItemDesc. fieldIndex is the SHOWS
// field's 0-based position in the row record's own field order (the same
// order cpEmitLayouts' rt_field_desc[] uses), resolved once at lowering time
// (lower.cla's lowColumnFieldIndex) so cprint never re-walks the record.
record IRColumnDesc {
    headerIdx: int
    fieldIndex: int
    widthPx: int
    widthFill: bool
    next: int
}

// IRBindDesc: one entry in a form window's rt_ui_bind_desc[] (Ch10) --
// chained off IRWindowDesc.formBindsHead, same arena-with-next idiom as
// IRColumnDesc. widgetIndex is the bound widget's 0-based position in the
// window's OWN declared widget list (uiWidgetIndex's order); fieldIndex is
// the bound field's 0-based position in the form record's own field order
// (lower.cla's lowColumnFieldIndex, reused verbatim -- same resolved-at-
// lowering-time contract IRColumnDesc's own doc comment describes).
record IRBindDesc {
    widgetIndex: int
    fieldIndex: int
    next: int
}

// IRWindowDesc: one window TYPE's whole rt_ui_window_desc (Ch8). titleIdx
// is -1 if the window body gave no `title:` property. widgetsHead chains
// irWidgetDescs (-1 if the window declares none); stateFieldsHead chains
// irFieldSlots (reusing the exact same arena/shape record structs use) for
// the window's per-instance `var`s (-1 if none) -- cprint.cla emits these
// as a plain typedef (no clar_new_NAME ctor: a UI state block is allocated
// and zeroed by the runtime, not constructed by user-facing code).
//
// formRecNameIdx/formBindsHead (mac-target-4d Task 7, Ch10 forms): -1/-1 for
// every window that has no `form for` -- cprint.cla's window-desc printer
// then leaves the struct's trailing `form` field un-initialized (C's own
// "fewer initializers than fields" zero-fill), so every pre-Task-7 golden
// (no form window ever reaches here) stays byte-identical. A form window's
// formRecNameIdx is its `form for T`'s T (interned); formBindsHead chains
// IRBindDesc, built once in lowWindowDecl by walking the already-lowered
// widgetsHead for any widget with a checker-resolved `binds:` (bindsIdx).
record IRWindowDesc {
    nameIdx: int
    titleIdx: int
    w: int
    h: int
    resizable: bool
    minW: int
    minH: int
    widgetsHead: int
    stateFieldsHead: int
    formRecNameIdx: int
    formBindsHead: int
}

// IRMenuItemDesc: one entry in a menu's rt_ui_item_desc[] (Ch9) -- a real
// item (nameIdx/captionIdx/keyIdx set, isSeparator false) or a bare
// `separator` (nameIdx/captionIdx/keyIdx all -1, isSeparator true).
// keyIdx is the interned raw one-character key-equivalent content, -1 if
// none. Separators occupy a real array slot, like every other entry --
// `rt_ui_menu_enable`'s itemIdx is this entry's 0-based position in the
// FULL declared list, separators included (see probe_ui.c's kProbeMenuItems
// and lower.cla's lowMenuEnableAssign).
record IRMenuItemDesc {
    nameIdx: int
    captionIdx: int
    keyIdx: int
    isSeparator: bool
    next: int
}

// IRMenuDesc: one menu's whole rt_ui_menu_desc (Ch9). Clarus has no
// separate menu-title syntax -- a menu's on-screen title is always its own
// declared name -- so titleIdx is always nameIdx itself (kept as its own
// field, not folded into nameIdx's use, so cprint's title-vs-C-name
// spellings stay independently named at the call site, matching
// IRWindowDesc's shape). isStandardEdit (mac-target-4c Task 3) marks
// `menu M { standard edit }`: itemsHead is then whatever (normally -1) the
// entries loop happened to build -- cprint ignores it entirely and emits
// the pinned `{ nItems: 0, items: 0, standardEdit: 1 }` tail instead, since
// the runtime builds Undo/Cut/Copy/Paste/Clear itself rather than reading
// a declared item array for this menu.
record IRMenuDesc {
    nameIdx: int
    titleIdx: int
    itemsHead: int
    isStandardEdit: bool
}

// ---- UI handler/dispatch IR (Task 5) ----
// `extend`/`every` bodies -> rt_ui_handlers dispatch + rt_ui_menu_handler/
// rt_ui_every_desc tables. Each handler BODY itself is an ordinary IRFunc
// (lower.cla's lowHandlerFunc; ADDED TO irFuncs exactly like a top-level
// `func`/`on App.*` handler, so cpEmitFuncs's existing prototype+definition
// pass prints it with no changes) -- only the SMALL amount of glue a
// checker-validated `extend`/`every` needed beyond "a function body" lives
// here: which C function (by interned name) answers which event, so
// cprint.cla's hand-generated dispatcher switches (there is no Clarus
// source shape for "a dispatch table": clarusc invents this glue itself,
// per the same lower-extracts/cprint-spells division the descriptor tables
// already use) can call the right one. A field holds -1 when that event has
// no registered handler.

// IRWinHandlers: one window TYPE's whole `extend` block content -- the five
// bare window events (Ch8) plus the widget-event table below. winTypeNameIdx
// is the window's own name (for cprint's clar_ui_winevent_/widget_ C names);
// looked up by cprint.cla scanning this arena for a name match (see
// cpFindWinHandlers) rather than back-referenced from IRWindowDesc, since a
// window's IRWindowDesc is built (lowWindowDecl) BEFORE its `extend` block
// (a separate top-level decl) is ever seen, and nothing else needs the
// reverse link.
// acceptedFn/cancelledFn (mac-target-4d Task 7, Ch10 forms) are `on
// accepted`/`on cancelled` -- -1 if the window's `extend` block declares
// neither. formRecNameIdx is a COPY of this window's IRWindowDesc.formRecNameIdx
// (-1 if not a form), carried here too so cpEmitOneWinEventDispatcher's
// RTUI_EV_ACCEPTED case can spell the `*(clar_rec_T *)a` cast without a
// second irWindowDescs scan (cpFindWinHandlers already looked this arena up
// by name; the window desc itself is a separate arena, built earlier by a
// separate lowWindowDecl call).
record IRWinHandlers {
    winTypeNameIdx: int
    openedFn: int
    closeRequestFn: int
    closedFn: int
    resizedFn: int
    keyFn: int
    acceptedFn: int
    cancelledFn: int
    formRecNameIdx: int
    widgetHead: int   // -1; chains IRWidgetHandlerEntry
    widgetTail: int   // -1; append cursor (see lower.cla's lowGetOrCreateWidgetHandlerEntry)
}

// IRWidgetHandlerEntry: one widget's registered events within its window's
// IRWinHandlers -- clickFn covers BOTH `button.click` and `canvas.click`
// (rt_ui.h's RTUI_WEV_CLICK is one event value shared by both widget kinds;
// cprint.cla picks the right call shape -- 0 args vs. (x, y) from a/b -- by
// the widget's OWN kind, already available via IRWidgetDesc), changeFn is
// `check.change`/`field.change`/`textview.change`/`popup.change`, dragFn is
// `canvas.drag`, enterFn is `field.enter` (mac-target-4c Task 2, RTUI_WEV_ENTER --
// a zero-arg call, same convention as clickFn/changeFn's non-canvas case).
// selectFn/doubleClickFn (mac-target-4d Task 5) are `table.select`/
// `table.doubleClick` -- a one-arg call (the clicked row index, RTUI_WEV_SELECT/
// RTUI_WEV_DBLCLICK's `a`), the same (int32_t)a convention canvas's
// click/drag already use for a/b.
record IRWidgetHandlerEntry {
    widgetIndex: int
    clickFn: int
    changeFn: int
    dragFn: int
    enterFn: int
    selectFn: int
    doubleClickFn: int
    next: int
}

// IRMenuHandlerEntry: one `on Item.select` handler -- app-scope
// (scopeWinTypeNameIdx == -1) or window-scoped (nested inside `extend Win`,
// per Ch9's Window-Scoped Commands). menuIdx/itemIdx are the SAME 0-based
// indices lower.cla's uiMenuIdx/uiMenuItemIdx already compute for
// `Menu.Item.enabled = b` (lowMenuEnableAssign) -- one registry, two
// readers. menuNameIdx/itemNameIdx are carried only for cprint's raw C
// string literals in the rt_ui_menu_handler struct (trace/debugging field,
// mirroring probe_ui.c's kProbeMenuHandlers).
record IRMenuHandlerEntry {
    menuNameIdx: int
    itemNameIdx: int
    menuIdx: int
    itemIdx: int
    funcNameIdx: int
    scopeWinTypeNameIdx: int
    next: int
}

// IREveryEntry: one top-level `every N ticks { }` block (Ch7/Ch11), in
// declaration order (the SAME order the ledger's `T FIRE every.<n>` trace
// index and rt_ui_every_desc[]'s array position both use).
record IREveryEntry {
    funcNameIdx: int
    ticks: int
    next: int
}

var irTypes: list of IRType
var irStmts: list of IRStmt
var irExprs: list of IRExpr
var irLocals: list of IRLocal
var irFuncs: list of IRFunc

// irFuncIdxByName maps irFuncName(i) -> i, keyed by interned nameIdx
// directly (findings 1.4, same intern-pool-index-equality invariant
// cgRecIdxByName/shakeFuncIdxByName already rely on). Maintained at
// REGISTRATION time (newIRFunc), not built lazily on first lookup like
// cgFindRecordByName -- this map backs findIRFuncIdxByName, which both
// backends use (cprint's host lane calls it too, findings 1.4 Task 13),
// so it must be correct from the very first lookup on every lane, not
// just the 68k one. First-wins on a duplicate name, matching the old
// linear scan's first-match semantics.
var irFuncIdxByName: intmap of int
var irGlobals: list of IRGlobal
var irFieldSlots: list of IRFieldSlot
var irRecords: list of IRRecordLayout
var irEnumMembers: list of IREnumMember
var irEnums: list of IREnumLayout
var irWidgetDescs: list of IRWidgetDesc
var irColumnDescs: list of IRColumnDesc
var irBindDescs: list of IRBindDesc
var irWindowDescs: list of IRWindowDesc
var irMenuItemDescs: list of IRMenuItemDesc
var irMenuDescs: list of IRMenuDesc
var irWinHandlers: list of IRWinHandlers
var irWidgetHandlerEntries: list of IRWidgetHandlerEntry
var irMenuHandlerEntries: list of IRMenuHandlerEntry
var irEveryEntries: list of IREveryEntry

// irMenuHandlersHead/Tail/Count and irEveryHead/Tail/Count thread the
// program-wide chains (declaration order) -- lower.cla's lowMenuExtend/
// lowEveryDecl append-only, cprint.cla walks them read-only.
var irMenuHandlersHead: int
var irMenuHandlersTail: int
var irMenuHandlerCount: int
var irEveryHead: int
var irEveryTail: int
var irEveryCount: int

// irStrLits is the literal pool (ir.go's Program.StrLits): each entry is a
// strPool index, in the order literals are added; a StrConst's Idx field
// indexes THIS list, not strPool directly, matching the brief's contract.
var irStrLits: list of int

// Program-level flags (ir.go's Program.HasLaunch/HasStartEmpty/HasStartCLI).
var irHasLaunch: bool
var irHasStartEmpty: bool
var irHasStartCLI: bool
// irHasOpenDocument (mac-target-4c Task 5): `on App.openDocument(path: string)`.
var irHasOpenDocument: bool

// The (at most one) `app` section's string properties, as string-pool
// indices (-1 = property absent) -- icon stays build-time-only (check.cla's
// checkAppDecl already validated it) and never reaches IR. id reached IR as
// of Task 2 (mac-target-4d) to feed cpEmitAppInfo's strong rt_app_creator
// override beside rt_ui_app_info; that override is RETIRED as of
// native-gaps-cleanup Task 2 (file.save's own mandatory type/creator args
// replace it -- see cpEmitAppInfo's own doc comment). id's OTHER reader
// survives unchanged: cg68k.cla's cg68BuildFork reads it directly for the
// native binary's OWN application resource creator (a different concern
// entirely -- the executable's Signature, not a saved document's stamp).
// irAppDoctype (native-gaps-cleanup Task 1, Part A) is read ONLY by
// lower.cla's lowAppConst, to lower `app.doctype` to a padded string
// literal at compile time -- no backend reads it directly. irHasApp is
// false when the program declares no `app` section at all.
var irAppName: int
var irAppVersion: int
var irAppAuthor: int
var irAppAbout: int
var irAppId: int
var irAppDoctype: int

// irAppStack (native-gaps-cleanup Task 4) is the `stack: N` app field's
// int-literal value in bytes (checker-validated 4096..1048576), or -1
// when absent -- cg68k.cla's cgStackHeuristic reads it back: an explicit
// value wins outright over the deepest-call-chain heuristic, no max().
// Native lane only; the cprint host/Mac lanes never read it.
var irAppStack: int
var irHasApp: bool

// irLayoutNeededByName (Task 2, mac-target-4d) marks which record types
// reached file.save/load (lower.cla's lowFileCall) and so need a
// clar_layout_NAME table -- cprint's cpEmitLayouts walks irRecords in
// declaration order and emits only the ones this registry names. Keyed by
// interned nameIdx directly (map-hashtable phase, Stage B: was poolGet'd
// through a string map; no per-generation namespacing needed either way --
// one clarusc emit invocation lowers exactly one program, main.cla's own
// "one program per process" contract). Never reset between compiles in the
// same process -- safe only because lib.cla's intern pool (strPool/
// strIndex) is itself deliberately never reset either (drive.cla's
// driveReset doc comment); a future change that DOES reset the pool
// mid-process would need to reset this table too, or a nameIdx here could
// silently alias a different string in a later compile (the a259d0f
// staleness class).
var irLayoutNeededByName: intmap of int

func irMarkLayoutNeeded(nameIdx: int) {
    irLayoutNeededByName[nameIdx] = 1
}

func irLayoutNeeded(nameIdx: int): bool {
    return irLayoutNeededByName.get(nameIdx, 0) == 1
}

// irRcWalkNeededByName (ARC Task 2) marks which record types were seen as
// the KRec-typed argument of an IRetain/IRelease intrinsic (cprint.cla's
// fpIntrCall) -- cprint's cpEmitRcWalks walks irRecords in declaration
// order and emits a clar_retain_NAME/clar_release_NAME pair only for the
// ones this registry names. Same mark/query pair idiom as
// irMarkLayoutNeeded/irLayoutNeeded just above, keyed by interned nameIdx
// directly for the same reason (and never reset, under the SAME
// intern-pool-stability invariant irLayoutNeededByName's own comment just
// above spells out). Nothing marks this yet -- lower.cla doesn't emit
// either intrinsic until a later ARC task -- so cpEmitRcWalks stays
// dormant.
var irRcWalkNeededByName: intmap of int

func irMarkRcWalkNeeded(nameIdx: int) {
    irRcWalkNeededByName[nameIdx] = 1
}

func irRcWalkNeeded(nameIdx: int): bool {
    return irRcWalkNeededByName.get(nameIdx, 0) == 1
}

// The extern registry (Task 3, Ch13: `external func`) -- one entry per
// `external func` declaration, in declaration order, storing exactly the
// signature cprint's cpEmitExternProtos needs to emit that extern's C
// prototype and lowCall/fpCallExt need to route/print a call to it.
// Follows the arena idiom exactly: irExternNames/irExternRetTys/
// irExternParamStart/irExternParamCountArr are four parallel `list of int`
// arrays (one slot per extern, all indexed by the same "extern index");
// irExternParamTys is a SEPARATE flat list holding every extern's param
// types back-to-back (no nested lists, matching lower.cla/ast.cla's own
// no-recursive-types constraint) -- extern i's params are
// irExternParamTys[irExternParamStart[i] .. +irExternParamCountArr[i]-1].
// irIsExtern answers by a linear scan over irExternNames (int-compared
// under the intern-pool invariant -- Global Constraints; findings 1.4)
// rather than a side map -- a program declares at most a handful of
// externals, and a plain list is what irReset already knows how to clear
// (a name->flag map, as irLayoutNeededByName/irRcWalkNeededByName already
// demonstrate, would need its own reset the differential harness doesn't
// currently give those two either; a list avoids the question entirely).
var irExternNames: list of int
var irExternRetTys: list of int
var irExternParamStart: list of int
var irExternParamCountArr: list of int
var irExternParamTys: list of int

// irExternTrapWords/irExternConvs (Task 2, native-5d) are the sixth/seventh
// parallel arenas alongside the five above -- one slot per extern, same
// "extern index" as irExternNames etc. -- carrying the optional trap/inline
// clause ast.cla's externFuncTrap/externFuncConv read off the DkExternFunc
// decl (-1/0 when the extern has no clause). Nothing reads these back yet
// (cprint's fpCallExt/cpEmitExternProtos deliberately ignore them -- Task 2
// wires parse/check/IR only; m68k codegen consumes them in a later task),
// but they're registered now so that plumbing has somewhere to land.
var irExternTrapWords: list of int
var irExternConvs: list of int

// irExternSels (Task 14, native-5e) is the eighth parallel arena -- the
// optional `trap WORD sel SELECTOR` clause's selector word (ast.cla's
// externFuncSel; -1 when the extern has no `sel` clause), for a
// "Package 7"-style trap shared by several routines (e.g. UiLNew's real
// 0xA9E7, the List Manager's own single dispatch trap -- see
// parseExternFuncDecl's own doc comment for the full story).
var irExternSels: list of int

// irExternParamRegs (Task 1, toolbox-integration Feature A) is the ninth
// parallel arena, flat and parallel to irExternParamTys exactly the same
// way (extern i's param j's register code lives at
// irExternParamRegs[irExternParamStart[i] + j]) -- the resolved register
// code (ast.cla's astExternRegBind/paramRegBind; Global Constraints'
// encoding: d0..d2 = 0..2, a0 = 8, a1 = 9) each param binds to under a
// named `reg(...)` clause (conv 7/8). -1 for every param under any other
// conv, which has no per-param register story of its own.
var irExternParamRegs: list of int

// irExternRetRegs (Task 1, Feature A) is the tenth parallel arena -- one
// slot per extern, same "extern index" as the rest -- carrying the `ret
// REG` clause's resolved register code (ast.cla's astExternRetReg), or -1
// when the extern has no explicit `ret` (the conv's own default-result
// rule applies instead: A0 for a ptr result, D0 otherwise).
var irExternRetRegs: list of int

// irRegisterExtern records one `external func`'s signature (lower.cla's
// lowExternDecl, phase-1-only -- an extern has no body to lower).
// paramRegs is parallel to paramTys (one register code per param, -1 =
// none); retReg is the extern's own `ret REG` code (-1 = default rule) --
// both Task 1, Feature A. Task 3 (Ch13 dedup): lookup-before-append -- a
// SECOND `external func` sharing a name already in the registry is a
// no-op here. Safe unconditionally: check.cla's checker has already
// proven, before lowering ever runs, that any two same-name extern decls
// declare an IDENTICAL clause (checkExternFunc's externClauseMatches),
// diagnosing anything else as a build error -- so by the time
// lowExternDecl's pre-pass (lower.cla) walks a program's decls calling
// this once per DkExternFunc node, a second call for an already-known
// name is always redundant, never a conflicting one. Keeps the registry's
// "one entry" contract (spec: docs/superpowers/specs/2026-08-04-toolbox-
// integration-design.md's Extern dedup section) at the IR layer too, not
// just the checker's scope.
func irRegisterExtern(nameIdx: int, retTy: int, paramTys: list of int, trapVal: int, conv: int, sel: int, paramRegs: list of int, retReg: int) {
    var start: int
    var i: int

    if irExternLookup(nameIdx) != -1 {
        return
    }
    start = irExternParamTys.count
    i = 0
    while i < paramTys.count {
        irExternParamTys.add(paramTys[i])
        irExternParamRegs.add(paramRegs[i])
        i = i + 1
    }
    irExternNames.add(nameIdx)
    irExternRetTys.add(retTy)
    irExternParamStart.add(start)
    irExternParamCountArr.add(paramTys.count)
    irExternTrapWords.add(trapVal)
    irExternConvs.add(conv)
    irExternSels.add(sel)
    irExternRetRegs.add(retReg)
}

func irExternCount(): int {
    return irExternNames.count
}

func irExternName(i: int): int {
    return irExternNames[i]
}

func irExternRet(i: int): int {
    return irExternRetTys[i]
}

func irExternParamCount(i: int): int {
    return irExternParamCountArr[i]
}

func irExternParam(i: int, j: int): int {
    return irExternParamTys[irExternParamStart[i] + j]
}

// irExternTrap/irExternConv (Task 2, native-5d) read back extern i's
// trap/inline clause -- see irExternTrapWords/irExternConvs above.
func irExternTrap(i: int): int {
    return irExternTrapWords[i]
}

func irExternConv(i: int): int {
    return irExternConvs[i]
}

// irExternSel (Task 14, native-5e) reads back extern i's selector clause --
// see irExternSels above.
func irExternSel(i: int): int {
    return irExternSels[i]
}

// irExternParamReg/irExternRetReg (Task 1, Feature A) read back extern i's
// named-clause register assignments -- see irExternParamRegs/
// irExternRetRegs above.
func irExternParamReg(i: int, j: int): int {
    return irExternParamRegs[irExternParamStart[i] + j]
}

func irExternRetReg(i: int): int {
    return irExternRetRegs[i]
}

// irExternLookup returns the extern registry index already holding
// nameIdx, or -1 if none -- the lookup-before-append irRegisterExtern
// needs (Task 3, Ch13 dedup) so a second identical `external func NAME`
// never grows the registry past its documented "one entry" contract. Int
// compare (findings 1.4: index equality already implies string equality
// under the intern-pool invariant -- Global Constraints; shake.cla:99-105's
// shakeFuncIdxByName already relies on the same invariant).
func irExternLookup(nameIdx: int): int {
    var i: int

    i = 0
    while i < irExternNames.count {
        if irExternNames[i] == nameIdx {
            return i
        }
        i = i + 1
    }
    return -1
}

// irIsExtern reports whether nameIdx names a registered `external func` --
// lowCall's routing test (ECallExt vs the ordinary ECallFn) between the
// user-function fallback.
func irIsExtern(nameIdx: int): bool {
    return irExternLookup(nameIdx) != -1
}

// irRecHasHandleField (ARC Task 7) reports whether the record type named
// nameIdx has at least one field needing construction/disposal
// (irtNeedsCtor) -- the SINGLE canonical answer to "is this record type
// genuinely handle-backed", shared by every place that asks it:
// cpEmitRcWalks (gates whether clar_retain_NAME/clar_release_NAME get
// DEFINED at all -- cprint.cla), and every lowering/printing site that
// decides whether to emit an IRetain/IRelease intrinsic (a CALLER of
// clar_retain_NAME/clar_release_NAME) over a KRec value (lower.cla's copy
// sites; cprint.cla's container-element retain/release, tracked-temp
// release). Task 2's reviewer flagged a gate-ASYMMETRY risk if the
// "should I define this" and "should I call this" questions were ever
// answered by two independently-maintained tests that could drift apart
// (a caller emits a call to a function the definer decided not to define
// -- an undefined-symbol link failure). This function is the fix: the one
// shared test, used everywhere the question is asked, so the two
// questions can never disagree. Same linear-scan-by-name shape
// cpEmitRelease's/cpEmitRetain's own KRec branch and cpEmitRcWalks
// already used inline (before this task unified them here).
func irRecHasHandleField(nameIdx: int): bool {
    var ri: int
    var f: int

    ri = 0
    while ri < irRecords.count {
        if irRecordLayoutName(ri) == nameIdx {
            f = irRecordLayoutFieldsHead(ri)
            while f != -1 {
                if irtNeedsCtor(irFieldSlotType(f)) {
                    return true
                }
                f = irFieldSlotNext(f)
            }
            return false
        }
        ri = ri + 1
    }
    return false
}

// Singletons for the kind-only IRTypes -- set by irReset(), matching
// types.cla's IntT/BoolT/... pattern. KStr/KList/KMap/KRec/KEnum/KArr are
// parametrized (capacity/elem/name) and so are never singletons.
var irVoidT: int
var irIntT: int
var irBoolT: int
var irFixedT: int
var irCharT: int
var irTextT: int
var irErrT: int
var irPtrT: int
var irWordT: int

// irReset empties every IR arena and re-seeds the singleton scalar
// IRTypes. Call between lowering independent programs (mirrors astReset/
// typesReset).
func irReset() {
    irTypes.clear()
    irStmts.clear()
    irExprs.clear()
    irLocals.clear()
    irFuncs.clear()
    irFuncIdxByName.clear()
    irCbGlueNames.clear()
    irGlobals.clear()
    irFieldSlots.clear()
    irRecords.clear()
    irEnumMembers.clear()
    irEnums.clear()
    irWidgetDescs.clear()
    irBindDescs.clear()
    irWindowDescs.clear()
    irMenuItemDescs.clear()
    irMenuDescs.clear()
    irWinHandlers.clear()
    irWidgetHandlerEntries.clear()
    irMenuHandlerEntries.clear()
    irEveryEntries.clear()
    irStrLits.clear()
    irExternNames.clear()
    irExternRetTys.clear()
    irExternParamStart.clear()
    irExternParamCountArr.clear()
    irExternParamTys.clear()
    irExternTrapWords.clear()
    irExternConvs.clear()
    irExternSels.clear()
    irExternParamRegs.clear()
    irExternRetRegs.clear()

    irHasLaunch = false
    irHasStartEmpty = false
    irHasStartCLI = false
    irHasOpenDocument = false
    irAppName = -1
    irAppVersion = -1
    irAppAuthor = -1
    irAppAbout = -1
    irAppId = -1
    irAppDoctype = -1
    irAppStack = -1
    irHasApp = false
    irMenuHandlersHead = -1
    irMenuHandlersTail = -1
    irMenuHandlerCount = 0
    irEveryHead = -1
    irEveryTail = -1
    irEveryCount = 0

    irVoidT = irSimpleType(KVoid)
    irIntT = irSimpleType(KInt)
    irBoolT = irSimpleType(KBool)
    irFixedT = irSimpleType(KFixed)
    irCharT = irSimpleType(KChar)
    irTextT = irSimpleType(KText)
    irErrT = irSimpleType(KErr)
    irPtrT = irSimpleType(KPtr)
    irWordT = irSimpleType(KWord)
}

// ================================================================
// IRType constructors and accessors (irTypes arena)
// ================================================================

func newIRType(k: IRKind, n: int, elem: int, name: int): int {
    var t: IRType

    t.k = k
    t.n = n
    t.elem = elem
    t.name = name
    irTypes.add(t)
    return irTypes.count - 1
}

func irtKind(i: int): IRKind {
    return irTypes[i].k
}

func irtN(i: int): int {
    return irTypes[i].n
}

func irtElem(i: int): int {
    return irTypes[i].elem
}

func irtName(i: int): int {
    return irTypes[i].name
}

// irtNeedsCtor reports whether a value of type t's all-zero representation
// (what NewHandleClear leaves a fresh window state block holding) is NOT a
// valid value of t -- i.e. whether t needs runtime construction before
// first use. True for Text/List/Map/Rec (each is a handle; a zeroed handle
// is NULL, not an empty value) directly, and for Arr recursively (an array
// needs construction iff its ELEMENT type does -- KArr of KArr included --
// matching cpDefaultInit's own KArr branch, cprint.cla, which already
// recurses into the element type to build its construction loop). Every
// other kind's zero value is already a valid value, needing no
// construction. Shared by lower.cla (gating IUiStateDefaults
// insertion/synthesis-widening) and cprint.cla (filtering which window
// state fields IUiStateDefaults' cprint case constructs) so the "which
// types need construction" rule lives in exactly one place.
func irtNeedsCtor(t: int): bool {
    var k: IRKind

    k = irtKind(t)
    if k == KArr {
        return irtNeedsCtor(irtElem(t))
    }
    return k == KText or k == KList or k == KMap or k == KSortedMap or k == KIntMap or k == KRec
}

// irSimpleType builds a kind-only IRType (no capacity/elem/name) -- used
// for the singleton scalar kinds.
func irSimpleType(k: IRKind): int {
    return newIRType(k, 0, -1, -1)
}

func irStrType(n: int): int {
    return newIRType(KStr, n, -1, -1)
}

func irListType(elem: int): int {
    return newIRType(KList, 0, elem, -1)
}

func irMapType(elem: int): int {
    return newIRType(KMap, 0, elem, -1)
}

func irSortedMapType(elem: int): int {
    return newIRType(KSortedMap, 0, elem, -1)
}

func irIntMapType(elem: int): int {
    return newIRType(KIntMap, 0, elem, -1)
}

func irArrType(elem: int, n: int): int {
    return newIRType(KArr, n, elem, -1)
}

func irRecType(name: int): int {
    return newIRType(KRec, 0, -1, name)
}

// irOverlayType builds a named KOverlay IRType -- mirrors irRecType exactly
// (name alone carries the identity); see IRKind's KOverlay doc comment.
func irOverlayType(name: int): int {
    return newIRType(KOverlay, 0, -1, name)
}


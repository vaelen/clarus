// ir.cla: the arena IR -- a port of internal/ir/ir.go (node shapes) and
// internal/ir/intrinsics.go (the 53 intrinsic-name constants). Follows
// ast.cla's arena idiom exactly: every node kind lives in a `list of X`
// arena, referenced by `int` index (`-1` is nil); variable-arity sequences
// (arg lists, stmt-list bodies, param/local lists, field/member lists) are
// intrusive singly-linked lists threaded through each node's own `next`
// field, with the sequence's head stored in whatever node/record owns it.
// Every name and every string literal is interned into the shared
// strPool/intern (lib.cla) -- ir.go's Type.Name and every *.Name string
// field become a strPool index here.
//
// This module holds no logic beyond constructors/accessors: lower.cla
// (Task 6+) is the only writer, cprint.cla (Task 9+) is the only reader.
// Every symbol here is prefixed `ir`/`IR` (functions lowercase, types
// uppercase) so it can never collide with ast.cla/check.cla/types.cla's
// identically-shaped-but-differently-named AST symbols when all modules
// are `include`d together.
//
// Go's ir.go carries no source-position fields on any IR node (lowering
// has already consumed positions into diagnostics), so unlike ast.cla's
// node records, none of the records below have line/col fields.
//
// One Program is in flight at a time (one `clarusc emit` invocation lowers
// one program from a clean slate), so -- exactly as ast.cla's four arenas
// stand in for "the AST" without a wrapping Program-of-arenas type --
// ir.go's Program.{Globals,Funcs,StrLits,Records,Enums} are simply the
// irGlobals/irFuncs/irStrLits/irRecords/irEnums arenas below, populated in
// declaration order, plus three flag vars for HasLaunch/HasStartEmpty/
// HasStartCLI. irReset clears every arena and re-seeds the singleton
// scalar IRTypes, mirroring astReset/typesReset's role in the differential
// harness: arenas must not leak across independently-compiled programs.
//
// ============================================================
// SCHEMA: per-kind meaning of fields
// ============================================================
//
// ---- IRKind (irTypes arena entries) ----
//   KVoid/KInt/KBool/KFixed/KChar/KText/KErr  no other field meaningful
//   KStr   n=capacity
//   KList  elem=element IRType index
//   KMap   elem=value IRType index
//   KRec   name=record name (interned)
//   KEnum  name=enum name (interned)
//   KArr   n=length, elem=element IRType index
//
// ---- IRStmtKind (irStmts arena) ----
//   SAssign    a=Dst expr; b=Src expr
//   SStoreStr  a=Dst expr; b=Src expr
//   SExprStmt  a=X expr
//   SIf        a=Cond expr; b=Then-body stmt-list head; c=Else-body
//              stmt-list head (-1 if no else)
//   SWhile     a=Cond expr; b=Body stmt-list head
//   SForRange  nameIdx=V (loop int local, interned); a=From expr; b=To
//              expr; c=Body stmt-list head
//   SForList   nameIdx=V (element local, interned); a=ListV expr; b=Body
//              stmt-list head
//   SForMap    nameIdx=K (interned); intVal=V (interned); a=MapV expr;
//              b=Body stmt-list head
//   SReturn    a=X expr (-1 for bare `return`)
//   SBreak     no fields used
//   SContinue  no fields used
//
// ---- IRExprKind (irExprs arena; every kind also carries ty=IRType index) ----
//   EIntConst  intVal=V (int/bool(0|1)/char/enum-value/fixed-raw constant)
//   EStrConst  intVal=Idx (irStrLits index -- the literal pool)
//   EVarRef    name=Name (interned); global=Global
//   EFieldRef  a=X expr; name=Name (interned)
//   EIndexRef  a=X expr; b=I expr
//   EBin       name=Op (interned operator spelling, e.g. "+"); a=X expr;
//              b=Y expr
//   EUn        name=Op (interned operator spelling); a=X expr
//   EConv      convOp=Op (IRConvOp); a=X expr; name=EnumName (interned,
//              -1 unless Op is CvIntToEnum/CvEnumToInt)
//   ECallFn    name=Name (interned); b=Args list head (each arg an IRExpr
//              chained via its own .next, -1 if none)
//   EIntr      name=Name (interned intrinsic name); b=Args list head (as
//              ECallFn)
//   ENewRec    name=RecName (interned)
//
// `next` on an IRExpr is used ONLY when that node is one argument in some
// ECallFn/EIntr's argument list; otherwise -1 (mirrors ast.cla's ExprNode
// .next discipline exactly).

include "lib.cla"

enum IRKind {
    KVoid
    KInt
    KBool
    KFixed
    KChar
    KStr
    KText
    KList
    KMap
    KRec
    KEnum
    KArr
    KErr

    // KWinRef/KUiState (Task 4: UI lowering) are always `void *` in C --
    // rt_ui's whole ABI addresses window instances and their per-instance
    // state opaquely (rt_ui_open/front/state all traffic in void*). `name`
    // (IRType's named-type-identity field, same slot KRec/KEnum use) carries
    // the window TYPE name: for KWinRef so `open`/`.front`/`nil` all agree on
    // which window type's C spelling to produce (see IUiOpen/IUiFront's
    // cprint case, which reads it back off the Intr node's own `ty`); for
    // KUiState so the one rt_ui_state() cast this type always wraps (see
    // IUiState's cprint case) casts to the right window's clar_uistate_NAME
    // struct. KUiState is never a real variable's type -- only the transient
    // base of a per-instance-var FieldRef (lower.cla's lowWindowInstSelect).
    KWinRef
    KUiState
}

enum IRStmtKind {
    SAssign
    SStoreStr
    SExprStmt
    SIf
    SWhile
    SForRange
    SForList
    SForMap
    SReturn
    SBreak
    SContinue
}

enum IRExprKind {
    EIntConst
    EStrConst
    EVarRef
    EFieldRef
    EIndexRef
    EBin
    EUn
    EConv
    ECallFn
    EIntr
    ENewRec
}

// IRConvOp: the 6 checked/unchecked scalar conversions (ir.go:182-191).
// CvIntToEnum is CHECKED (panics on no member).
enum IRConvOp {
    CvIntToFixed
    CvFixedToInt
    CvIntToChar
    CvCharToInt
    CvEnumToInt
    CvIntToEnum
}

record IRType {
    k: IRKind
    n: int
    elem: int
    name: int
}

record IRStmt {
    kind: IRStmtKind
    a: int
    b: int
    c: int
    next: int
    nameIdx: int
    intVal: int
}

record IRExpr {
    kind: IRExprKind
    a: int
    b: int
    name: int
    intVal: int
    global: bool
    convOp: IRConvOp
    ty: int
    next: int
}

// IRLocal covers both ir.go's Func.Params and Func.Locals -- identical
// shape (Name, T) in Go, so one record/arena serves both; a Func stores a
// separate paramsHead/localsHead chain into this same arena.
record IRLocal {
    name: int
    t: int
    next: int
}

record IRFunc {
    name: int
    paramsHead: int
    ret: int
    localsHead: int
    bodyHead: int
}

record IRGlobal {
    name: int
    t: int
    init: int
    // initBirth (ARC Task 6 fix): whether `init` (if any) is a birth value
    // per lowStoreIsBirth/lowStoreIntrOwnsResult -- lowGlobalVarDecl's own
    // AST-time classification, mirroring lowCountedStore's for a runtime
    // store. cpEmitGlobalsInit's Init-emission path never routes through
    // lowCountedStore (it prints the Init directly, not via a statement
    // chain), so this is how a non-birth (aliasing) Init tells the printer
    // it needs a matching retain -- see cpEmitGlobalsInit's own comment.
    initBirth: bool
}

// IRFieldSlot ports ir.go's FieldSlot: default is the scalar/enum/char/
// bool/fixed-raw default; defaultStr is -1, or an irStrLits index for a
// string default.
record IRFieldSlot {
    name: int
    t: int
    default: int
    defaultStr: int
    next: int
}

record IRRecordLayout {
    name: int
    fieldsHead: int
}

// IREnumMember mirrors ir.go's EnumLayout's parallel Members/Values/Labels
// slices as one chained record per member.
record IREnumMember {
    name: int
    value: int
    label: int
    next: int
}

record IREnumLayout {
    name: int
    membersHead: int
}

// ---- UI descriptor IR (Task 4) ----
// window/menu declarations -> static rt_ui_*_desc tables. Shape mirrors
// check.cla's own already-validated side tables (widgetInfos/
// windowVarsHead/windowWidgetsHead, the DkMenuEntry chain) field-for-field;
// lower.cla (lowWindowDecl/lowWidgetDesc/lowMenuDecl) copies that data in,
// cprint.cla owns turning it into rt_ui.h's exact C spelling (macro names,
// Str255 literal syntax) -- the same lower-extracts/cprint-spells division
// IRRecordLayout/IRFieldSlot already establish for record structs, reused
// here rather than invented afresh.

// IRWidgetDesc: one entry in a window's rt_ui_widget_desc[] (Ch8: Widgets,
// Layout). kindIdx is the interned widget-kind word ("button"/"check"/
// "canvas"/"label" -- the whole rt_ui widget surface); captionIdx is the
// interned raw caption/text/label content (-1 if the widget has none, e.g.
// canvas). atKind: 0 = explicit `at: x, y`; 1 = `at: next, ...` (x taken
// from the previous widget by the runtime; this entry's own `x` is an
// unused placeholder, always 0); 2 = `at: right, ...` (x similarly
// runtime-computed, placeholder 0); 3 = no `at:` property given at all
// (mac-target-4d Task 9) -- the runtime vertical-stacks it instead, x/y
// unused placeholders, always 0 (see lowWidgetDesc's own fillBoth
// exception: a `fill: both` widget with no `at:` keeps atKind 0/(0,0)
// instead, unchanged from before this task). yIsBottom/widthIsFill mark the
// `bottom`/`fill` sentinels (`y`/`width` are unused placeholders, 0, when
// their sentinel flag is set) -- Ch8's "at: next, bottom" and "width: fill".
// isScrollV/isScrollH (mac-target-4c Task 2) mark a textview's
// `scrollbar: vertical` (isScrollV only) or `scrollbar: both` (both set) --
// always false for every other widget kind.
//
// bindsIdx/rowsGlobalIdx/columnsHead (mac-target-4d Task 5) are -1 for every
// widget kind except popup/table: bindsIdx is popup's bound form-record
// field name (interned, check.cla's WidgetInfo.bindsIdx precedent -- -1
// means no `binds:` given); rowsGlobalIdx is a table's `rows:` global list
// variable's own interned NAME (not an arena index -- cprint.cla's
// cpFindGlobalRecName scans irGlobals by this name to find the row record's
// clar_layout_NAME); columnsHead chains this table's IRColumnDesc list (-1
// if none, though a real table always has >=1 column by Ch10 grammar).
record IRWidgetDesc {
    nameIdx: int
    kindIdx: int
    captionIdx: int
    atKind: int
    x: int
    yIsBottom: bool
    y: int
    widthIsFill: bool
    width: int
    fillBoth: bool
    isDefault: bool
    isCancel: bool
    isBuffered: bool
    isScrollV: bool
    isScrollH: bool
    bindsIdx: int
    rowsGlobalIdx: int
    columnsHead: int
    next: int
}

// IRColumnDesc: one `column "Header" shows field width N|fill` entry (Ch10)
// in a table widget's rt_ui_col_desc[] -- chained off IRWidgetDesc.columnsHead,
// same arena-with-next idiom as IRMenuItemDesc. fieldIndex is the SHOWS
// field's 0-based position in the row record's own field order (the same
// order cpEmitLayouts' rt_field_desc[] uses), resolved once at lowering time
// (lower.cla's lowColumnFieldIndex) so cprint never re-walks the record.
record IRColumnDesc {
    headerIdx: int
    fieldIndex: int
    widthPx: int
    widthFill: bool
    next: int
}

// IRBindDesc: one entry in a form window's rt_ui_bind_desc[] (Ch10) --
// chained off IRWindowDesc.formBindsHead, same arena-with-next idiom as
// IRColumnDesc. widgetIndex is the bound widget's 0-based position in the
// window's OWN declared widget list (uiWidgetIndex's order); fieldIndex is
// the bound field's 0-based position in the form record's own field order
// (lower.cla's lowColumnFieldIndex, reused verbatim -- same resolved-at-
// lowering-time contract IRColumnDesc's own doc comment describes).
record IRBindDesc {
    widgetIndex: int
    fieldIndex: int
    next: int
}

// IRWindowDesc: one window TYPE's whole rt_ui_window_desc (Ch8). titleIdx
// is -1 if the window body gave no `title:` property. widgetsHead chains
// irWidgetDescs (-1 if the window declares none); stateFieldsHead chains
// irFieldSlots (reusing the exact same arena/shape record structs use) for
// the window's per-instance `var`s (-1 if none) -- cprint.cla emits these
// as a plain typedef (no clar_new_NAME ctor: a UI state block is allocated
// and zeroed by the runtime, not constructed by user-facing code).
//
// formRecNameIdx/formBindsHead (mac-target-4d Task 7, Ch10 forms): -1/-1 for
// every window that has no `form for` -- cprint.cla's window-desc printer
// then leaves the struct's trailing `form` field un-initialized (C's own
// "fewer initializers than fields" zero-fill), so every pre-Task-7 golden
// (no form window ever reaches here) stays byte-identical. A form window's
// formRecNameIdx is its `form for T`'s T (interned); formBindsHead chains
// IRBindDesc, built once in lowWindowDecl by walking the already-lowered
// widgetsHead for any widget with a checker-resolved `binds:` (bindsIdx).
record IRWindowDesc {
    nameIdx: int
    titleIdx: int
    w: int
    h: int
    resizable: bool
    minW: int
    minH: int
    widgetsHead: int
    stateFieldsHead: int
    formRecNameIdx: int
    formBindsHead: int
}

// IRMenuItemDesc: one entry in a menu's rt_ui_item_desc[] (Ch9) -- a real
// item (nameIdx/captionIdx/keyIdx set, isSeparator false) or a bare
// `separator` (nameIdx/captionIdx/keyIdx all -1, isSeparator true).
// keyIdx is the interned raw one-character key-equivalent content, -1 if
// none. Separators occupy a real array slot, like every other entry --
// `rt_ui_menu_enable`'s itemIdx is this entry's 0-based position in the
// FULL declared list, separators included (see probe_ui.c's kProbeMenuItems
// and lower.cla's lowMenuEnableAssign).
record IRMenuItemDesc {
    nameIdx: int
    captionIdx: int
    keyIdx: int
    isSeparator: bool
    next: int
}

// IRMenuDesc: one menu's whole rt_ui_menu_desc (Ch9). Clarus has no
// separate menu-title syntax -- a menu's on-screen title is always its own
// declared name -- so titleIdx is always nameIdx itself (kept as its own
// field, not folded into nameIdx's use, so cprint's title-vs-C-name
// spellings stay independently named at the call site, matching
// IRWindowDesc's shape). isStandardEdit (mac-target-4c Task 3) marks
// `menu M { standard edit }`: itemsHead is then whatever (normally -1) the
// entries loop happened to build -- cprint ignores it entirely and emits
// the pinned `{ nItems: 0, items: 0, standardEdit: 1 }` tail instead, since
// the runtime builds Undo/Cut/Copy/Paste/Clear itself rather than reading
// a declared item array for this menu.
record IRMenuDesc {
    nameIdx: int
    titleIdx: int
    itemsHead: int
    isStandardEdit: bool
}

// ---- UI handler/dispatch IR (Task 5) ----
// `extend`/`every` bodies -> rt_ui_handlers dispatch + rt_ui_menu_handler/
// rt_ui_every_desc tables. Each handler BODY itself is an ordinary IRFunc
// (lower.cla's lowHandlerFunc; ADDED TO irFuncs exactly like a top-level
// `func`/`on App.*` handler, so cpEmitFuncs's existing prototype+definition
// pass prints it with no changes) -- only the SMALL amount of glue a
// checker-validated `extend`/`every` needed beyond "a function body" lives
// here: which C function (by interned name) answers which event, so
// cprint.cla's hand-generated dispatcher switches (there is no Clarus
// source shape for "a dispatch table": clarusc invents this glue itself,
// per the same lower-extracts/cprint-spells division the descriptor tables
// already use) can call the right one. A field holds -1 when that event has
// no registered handler.

// IRWinHandlers: one window TYPE's whole `extend` block content -- the five
// bare window events (Ch8) plus the widget-event table below. winTypeNameIdx
// is the window's own name (for cprint's clar_ui_winevent_/widget_ C names);
// looked up by cprint.cla scanning this arena for a name match (see
// cpFindWinHandlers) rather than back-referenced from IRWindowDesc, since a
// window's IRWindowDesc is built (lowWindowDecl) BEFORE its `extend` block
// (a separate top-level decl) is ever seen, and nothing else needs the
// reverse link.
// acceptedFn/cancelledFn (mac-target-4d Task 7, Ch10 forms) are `on
// accepted`/`on cancelled` -- -1 if the window's `extend` block declares
// neither. formRecNameIdx is a COPY of this window's IRWindowDesc.formRecNameIdx
// (-1 if not a form), carried here too so cpEmitOneWinEventDispatcher's
// RTUI_EV_ACCEPTED case can spell the `*(clar_rec_T *)a` cast without a
// second irWindowDescs scan (cpFindWinHandlers already looked this arena up
// by name; the window desc itself is a separate arena, built earlier by a
// separate lowWindowDecl call).
record IRWinHandlers {
    winTypeNameIdx: int
    openedFn: int
    closeRequestFn: int
    closedFn: int
    resizedFn: int
    keyFn: int
    acceptedFn: int
    cancelledFn: int
    formRecNameIdx: int
    widgetHead: int   // -1; chains IRWidgetHandlerEntry
    widgetTail: int   // -1; append cursor (see lower.cla's lowGetOrCreateWidgetHandlerEntry)
}

// IRWidgetHandlerEntry: one widget's registered events within its window's
// IRWinHandlers -- clickFn covers BOTH `button.click` and `canvas.click`
// (rt_ui.h's RTUI_WEV_CLICK is one event value shared by both widget kinds;
// cprint.cla picks the right call shape -- 0 args vs. (x, y) from a/b -- by
// the widget's OWN kind, already available via IRWidgetDesc), changeFn is
// `check.change`/`field.change`/`textview.change`/`popup.change`, dragFn is
// `canvas.drag`, enterFn is `field.enter` (mac-target-4c Task 2, RTUI_WEV_ENTER --
// a zero-arg call, same convention as clickFn/changeFn's non-canvas case).
// selectFn/doubleClickFn (mac-target-4d Task 5) are `table.select`/
// `table.doubleClick` -- a one-arg call (the clicked row index, RTUI_WEV_SELECT/
// RTUI_WEV_DBLCLICK's `a`), the same (int32_t)a convention canvas's
// click/drag already use for a/b.
record IRWidgetHandlerEntry {
    widgetIndex: int
    clickFn: int
    changeFn: int
    dragFn: int
    enterFn: int
    selectFn: int
    doubleClickFn: int
    next: int
}

// IRMenuHandlerEntry: one `on Item.select` handler -- app-scope
// (scopeWinTypeNameIdx == -1) or window-scoped (nested inside `extend Win`,
// per Ch9's Window-Scoped Commands). menuIdx/itemIdx are the SAME 0-based
// indices lower.cla's uiMenuIdx/uiMenuItemIdx already compute for
// `Menu.Item.enabled = b` (lowMenuEnableAssign) -- one registry, two
// readers. menuNameIdx/itemNameIdx are carried only for cprint's raw C
// string literals in the rt_ui_menu_handler struct (trace/debugging field,
// mirroring probe_ui.c's kProbeMenuHandlers).
record IRMenuHandlerEntry {
    menuNameIdx: int
    itemNameIdx: int
    menuIdx: int
    itemIdx: int
    funcNameIdx: int
    scopeWinTypeNameIdx: int
    next: int
}

// IREveryEntry: one top-level `every N ticks { }` block (Ch7/Ch11), in
// declaration order (the SAME order the ledger's `T FIRE every.<n>` trace
// index and rt_ui_every_desc[]'s array position both use).
record IREveryEntry {
    funcNameIdx: int
    ticks: int
    next: int
}

var irTypes: list of IRType
var irStmts: list of IRStmt
var irExprs: list of IRExpr
var irLocals: list of IRLocal
var irFuncs: list of IRFunc
var irGlobals: list of IRGlobal
var irFieldSlots: list of IRFieldSlot
var irRecords: list of IRRecordLayout
var irEnumMembers: list of IREnumMember
var irEnums: list of IREnumLayout
var irWidgetDescs: list of IRWidgetDesc
var irColumnDescs: list of IRColumnDesc
var irBindDescs: list of IRBindDesc
var irWindowDescs: list of IRWindowDesc
var irMenuItemDescs: list of IRMenuItemDesc
var irMenuDescs: list of IRMenuDesc
var irWinHandlers: list of IRWinHandlers
var irWidgetHandlerEntries: list of IRWidgetHandlerEntry
var irMenuHandlerEntries: list of IRMenuHandlerEntry
var irEveryEntries: list of IREveryEntry

// irMenuHandlersHead/Tail/Count and irEveryHead/Tail/Count thread the
// program-wide chains (declaration order) -- lower.cla's lowMenuExtend/
// lowEveryDecl append-only, cprint.cla walks them read-only.
var irMenuHandlersHead: int
var irMenuHandlersTail: int
var irMenuHandlerCount: int
var irEveryHead: int
var irEveryTail: int
var irEveryCount: int

// irStrLits is the literal pool (ir.go's Program.StrLits): each entry is a
// strPool index, in the order literals are added; a StrConst's Idx field
// indexes THIS list, not strPool directly, matching the brief's contract.
var irStrLits: list of int

// Program-level flags (ir.go's Program.HasLaunch/HasStartEmpty/HasStartCLI).
var irHasLaunch: bool
var irHasStartEmpty: bool
var irHasStartCLI: bool
// irHasOpenDocument (mac-target-4c Task 5): `on App.openDocument(path: string)`.
var irHasOpenDocument: bool

// The (at most one) `app` section's string properties, as string-pool
// indices (-1 = property absent) -- icon stays build-time-only (check.cla's
// checkAppDecl already validated it) and never reaches IR. id DOES reach IR
// as of Task 2 (mac-target-4d): cprint's cpEmitAppInfo reads it back to emit
// the strong rt_app_creator override beside rt_ui_app_info. irHasApp is
// false when the program declares no `app` section at all.
var irAppName: int
var irAppVersion: int
var irAppAuthor: int
var irAppAbout: int
var irAppId: int
var irHasApp: bool

// irLayoutNeededByName (Task 2, mac-target-4d) marks which record types
// reached file.save/load (lower.cla's lowFileCall) and so need a
// clar_layout_NAME table -- cprint's cpEmitLayouts walks irRecords in
// declaration order and emits only the ones this registry names. Keyed by
// name (poolGet), same plain-name-key idiom as check.cla's
// recFieldsHeadByName (no per-generation namespacing: one clarusc emit
// invocation lowers exactly one program, main.cla's own "one program per
// process" contract).
var irLayoutNeededByName: map of int

func irMarkLayoutNeeded(nameIdx: int) {
    irLayoutNeededByName[poolGet(nameIdx)] = 1
}

func irLayoutNeeded(nameIdx: int): bool {
    return irLayoutNeededByName.get(poolGet(nameIdx), 0) == 1
}

// irRcWalkNeededByName (ARC Task 2) marks which record types were seen as
// the KRec-typed argument of an IRetain/IRelease intrinsic (cprint.cla's
// fpIntrCall) -- cprint's cpEmitRcWalks walks irRecords in declaration
// order and emits a clar_retain_NAME/clar_release_NAME pair only for the
// ones this registry names. Same mark/query pair idiom as
// irMarkLayoutNeeded/irLayoutNeeded just above, keyed by name (poolGet) for
// the same reason. Nothing marks this yet -- lower.cla doesn't emit either
// intrinsic until a later ARC task -- so cpEmitRcWalks stays dormant.
var irRcWalkNeededByName: map of int

func irMarkRcWalkNeeded(nameIdx: int) {
    irRcWalkNeededByName[poolGet(nameIdx)] = 1
}

func irRcWalkNeeded(nameIdx: int): bool {
    return irRcWalkNeededByName.get(poolGet(nameIdx), 0) == 1
}

// irRecHasHandleField (ARC Task 7) reports whether the record type named
// nameIdx has at least one field needing construction/disposal
// (irtNeedsCtor) -- the SINGLE canonical answer to "is this record type
// genuinely handle-backed", shared by every place that asks it:
// cpEmitRcWalks (gates whether clar_retain_NAME/clar_release_NAME get
// DEFINED at all -- cprint.cla), and every lowering/printing site that
// decides whether to emit an IRetain/IRelease intrinsic (a CALLER of
// clar_retain_NAME/clar_release_NAME) over a KRec value (lower.cla's copy
// sites; cprint.cla's container-element retain/release, tracked-temp
// release). Task 2's reviewer flagged a gate-ASYMMETRY risk if the
// "should I define this" and "should I call this" questions were ever
// answered by two independently-maintained tests that could drift apart
// (a caller emits a call to a function the definer decided not to define
// -- an undefined-symbol link failure). This function is the fix: the one
// shared test, used everywhere the question is asked, so the two
// questions can never disagree. Same linear-scan-by-name shape
// cpEmitRelease's/cpEmitRetain's own KRec branch and cpEmitRcWalks
// already used inline (before this task unified them here).
func irRecHasHandleField(nameIdx: int): bool {
    var ri: int
    var f: int

    ri = 0
    while ri < irRecords.count {
        if irRecordLayoutName(ri) == nameIdx {
            f = irRecordLayoutFieldsHead(ri)
            while f != -1 {
                if irtNeedsCtor(irFieldSlotType(f)) {
                    return true
                }
                f = irFieldSlotNext(f)
            }
            return false
        }
        ri = ri + 1
    }
    return false
}

// Singletons for the kind-only IRTypes -- set by irReset(), matching
// types.cla's IntT/BoolT/... pattern. KStr/KList/KMap/KRec/KEnum/KArr are
// parametrized (capacity/elem/name) and so are never singletons.
var irVoidT: int
var irIntT: int
var irBoolT: int
var irFixedT: int
var irCharT: int
var irTextT: int
var irErrT: int

// irReset empties every IR arena and re-seeds the singleton scalar
// IRTypes. Call between lowering independent programs (mirrors astReset/
// typesReset).
func irReset() {
    while irTypes.count > 0 {
        irTypes.pop()
    }
    while irStmts.count > 0 {
        irStmts.pop()
    }
    while irExprs.count > 0 {
        irExprs.pop()
    }
    while irLocals.count > 0 {
        irLocals.pop()
    }
    while irFuncs.count > 0 {
        irFuncs.pop()
    }
    while irGlobals.count > 0 {
        irGlobals.pop()
    }
    while irFieldSlots.count > 0 {
        irFieldSlots.pop()
    }
    while irRecords.count > 0 {
        irRecords.pop()
    }
    while irEnumMembers.count > 0 {
        irEnumMembers.pop()
    }
    while irEnums.count > 0 {
        irEnums.pop()
    }
    while irWidgetDescs.count > 0 {
        irWidgetDescs.pop()
    }
    while irBindDescs.count > 0 {
        irBindDescs.pop()
    }
    while irWindowDescs.count > 0 {
        irWindowDescs.pop()
    }
    while irMenuItemDescs.count > 0 {
        irMenuItemDescs.pop()
    }
    while irMenuDescs.count > 0 {
        irMenuDescs.pop()
    }
    while irWinHandlers.count > 0 {
        irWinHandlers.pop()
    }
    while irWidgetHandlerEntries.count > 0 {
        irWidgetHandlerEntries.pop()
    }
    while irMenuHandlerEntries.count > 0 {
        irMenuHandlerEntries.pop()
    }
    while irEveryEntries.count > 0 {
        irEveryEntries.pop()
    }
    while irStrLits.count > 0 {
        irStrLits.pop()
    }

    irHasLaunch = false
    irHasStartEmpty = false
    irHasStartCLI = false
    irHasOpenDocument = false
    irAppName = -1
    irAppVersion = -1
    irAppAuthor = -1
    irAppAbout = -1
    irAppId = -1
    irHasApp = false
    irMenuHandlersHead = -1
    irMenuHandlersTail = -1
    irMenuHandlerCount = 0
    irEveryHead = -1
    irEveryTail = -1
    irEveryCount = 0

    irVoidT = irSimpleType(KVoid)
    irIntT = irSimpleType(KInt)
    irBoolT = irSimpleType(KBool)
    irFixedT = irSimpleType(KFixed)
    irCharT = irSimpleType(KChar)
    irTextT = irSimpleType(KText)
    irErrT = irSimpleType(KErr)
}

// ================================================================
// IRType constructors and accessors (irTypes arena)
// ================================================================

func newIRType(k: IRKind, n: int, elem: int, name: int): int {
    var t: IRType

    t.k = k
    t.n = n
    t.elem = elem
    t.name = name
    irTypes.add(t)
    return irTypes.count - 1
}

func irtKind(i: int): IRKind {
    return irTypes[i].k
}

func irtN(i: int): int {
    return irTypes[i].n
}

func irtElem(i: int): int {
    return irTypes[i].elem
}

func irtName(i: int): int {
    return irTypes[i].name
}

// irtNeedsCtor reports whether a value of type t's all-zero representation
// (what NewHandleClear leaves a fresh window state block holding) is NOT a
// valid value of t -- i.e. whether t needs runtime construction before
// first use. True for Text/List/Map/Rec (each is a handle; a zeroed handle
// is NULL, not an empty value) directly, and for Arr recursively (an array
// needs construction iff its ELEMENT type does -- KArr of KArr included --
// matching cpDefaultInit's own KArr branch, cprint.cla, which already
// recurses into the element type to build its construction loop). Every
// other kind's zero value is already a valid value, needing no
// construction. Shared by lower.cla (gating IUiStateDefaults
// insertion/synthesis-widening) and cprint.cla (filtering which window
// state fields IUiStateDefaults' cprint case constructs) so the "which
// types need construction" rule lives in exactly one place.
func irtNeedsCtor(t: int): bool {
    var k: IRKind

    k = irtKind(t)
    if k == KArr {
        return irtNeedsCtor(irtElem(t))
    }
    return k == KText or k == KList or k == KMap or k == KRec
}

// irSimpleType builds a kind-only IRType (no capacity/elem/name) -- used
// for the singleton scalar kinds.
func irSimpleType(k: IRKind): int {
    return newIRType(k, 0, -1, -1)
}

func irStrType(n: int): int {
    return newIRType(KStr, n, -1, -1)
}

func irListType(elem: int): int {
    return newIRType(KList, 0, elem, -1)
}

func irMapType(elem: int): int {
    return newIRType(KMap, 0, elem, -1)
}

func irArrType(elem: int, n: int): int {
    return newIRType(KArr, n, elem, -1)
}

func irRecType(name: int): int {
    return newIRType(KRec, 0, -1, name)
}

func irEnumType(name: int): int {
    return newIRType(KEnum, 0, -1, name)
}

// irWinRefType/irUiStateType build the two UI-only pointer IRTypes (see
// IRKind's KWinRef/KUiState doc comment) -- name is the window TYPE's own
// interned nameIdx (lower.cla always already has it as an interned index in
// hand, from either the checked type table or an AST accessor; neither
// constructor re-interns a string).
func irWinRefType(name: int): int {
    return newIRType(KWinRef, 0, -1, name)
}

func irUiStateType(name: int): int {
    return newIRType(KUiState, 0, -1, name)
}


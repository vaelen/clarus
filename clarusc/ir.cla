    irEveryEntries.add(n)
    idx = irEveryEntries.count - 1
    if irEveryHead == -1 {
        irEveryHead = idx
    } else {
        irEveryEntries[irEveryTail].next = idx
    }
    irEveryTail = idx
    irEveryCount = irEveryCount + 1
    return idx
}


// ================================================================
// IRLocal constructors and accessors (irLocals arena; serves both a
// Func's Params and its Locals -- see the record comment above)
// ================================================================

func irLocalListAppend(tailIdx: int, idx: int): int {
    if tailIdx >= 0 {
        irLocals[tailIdx].next = idx
    }
    return idx
}

func newIRLocal(name: int, t: int): int {
    var n: IRLocal

    n.name = name
    n.t = t
    n.next = -1
    irLocals.add(n)
    return irLocals.count - 1
}

func irLocalName(i: int): int {
    return irLocals[i].name
}

func irLocalType(i: int): int {
    return irLocals[i].t
}

func irLocalNext(i: int): int {
    return irLocals[i].next
}


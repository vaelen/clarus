// ================================================================
// IRFieldSlot / IRRecordLayout constructors and accessors
// (irFieldSlots / irRecords arenas -- Program.Records)
// ================================================================

func irFieldSlotListAppend(tailIdx: int, idx: int): int {
    if tailIdx >= 0 {
        irFieldSlots[tailIdx].next = idx
    }
    return idx
}

func newIRFieldSlot(name: int, t: int, defaultVal: int, defaultStr: int): int {
    var n: IRFieldSlot

    n.name = name
    n.t = t
    n.default = defaultVal
    n.defaultStr = defaultStr
    n.next = -1
    irFieldSlots.add(n)
    return irFieldSlots.count - 1
}

func irFieldSlotName(i: int): int {
    return irFieldSlots[i].name
}

func irFieldSlotType(i: int): int {
    return irFieldSlots[i].t
}

func irFieldSlotDefault(i: int): int {
    return irFieldSlots[i].default
}

func irFieldSlotDefaultStr(i: int): int {
    return irFieldSlots[i].defaultStr
}

func irFieldSlotNext(i: int): int {
    return irFieldSlots[i].next
}

func newIRRecordLayout(name: int, fieldsHead: int): int {
    var n: IRRecordLayout

    n.name = name
    n.fieldsHead = fieldsHead
    irRecords.add(n)
    return irRecords.count - 1
}

func irRecordLayoutName(i: int): int {
    return irRecords[i].name
}

func irRecordLayoutFieldsHead(i: int): int {
    return irRecords[i].fieldsHead
}

// ================================================================
// IREnumMember / IREnumLayout constructors and accessors
// (irEnumMembers / irEnums arenas -- Program.Enums)
// ================================================================

func irEnumMemberListAppend(tailIdx: int, idx: int): int {
    if tailIdx >= 0 {
        irEnumMembers[tailIdx].next = idx
    }
    return idx
}

func newIREnumMember(name: int, value: int, label: int): int {
    var n: IREnumMember

    n.name = name
    n.value = value
    n.label = label
    n.next = -1
    irEnumMembers.add(n)
    return irEnumMembers.count - 1
}

func irEnumMemberName(i: int): int {
    return irEnumMembers[i].name
}

func irEnumMemberValue(i: int): int {
    return irEnumMembers[i].value
}

func irEnumMemberLabel(i: int): int {
    return irEnumMembers[i].label
}

func irEnumMemberNext(i: int): int {
    return irEnumMembers[i].next
}

func newIREnumLayout(name: int, membersHead: int): int {
    var n: IREnumLayout

    n.name = name
    n.membersHead = membersHead
    irEnums.add(n)
    return irEnums.count - 1
}

func irEnumLayoutName(i: int): int {
    return irEnums[i].name
}

func irEnumLayoutMembersHead(i: int): int {
    return irEnums[i].membersHead
}

// ================================================================
// irStrLits (literal pool) constructors and accessors
// ================================================================

// irAddStrLit appends strPoolIdx (an already-interned strPool index) to
// the literal pool and returns its irStrLits index -- the value a
// StrConst's Idx field stores.
func irAddStrLit(strPoolIdx: int): int {
    irStrLits.add(strPoolIdx)
    return irStrLits.count - 1
}

func irStrLitPoolIdx(i: int): int {
    return irStrLits[i]
}


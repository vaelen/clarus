// -- UI (Task 4: Ch7-11 windows/widgets/menus/canvas -> runtime/mac/rt_ui.h).
// One intrinsic per concrete rt_ui operation (not one generic call taking a
// runtime-selected property/op as data) -- matching this table's existing
// style (IStrLen/IStrIndex/... are one-op-per-name too) and letting each
// cprint.cla case hardcode its own fixed rt_ui.h macro name textually, so no
// macro-spelling data ever has to flow through an IR node's fields.
func IUiOpen(): int {
    return intern("ui_open")
}

func IUiClose(): int {
    return intern("ui_close")
}

// IUiQuit (mac-target-4b final review) is `quit` in a UI program (Ch7
// Quit Semantics -> runtime/mac/rt_ui.c's rt_ui_quit): the closeRequest
// cascade over every open window, front-to-back, any cancel aborting the
// whole quit. No args, same "writes through a fixed runtime entry point,
// nothing to pass" shape as IUiCancel below -- a UI program's `quit` never
// carries operands into the C call itself (an optional exit-code
// expression, if present, is still evaluated by lowQuit for its side
// effects, just not passed in: Ch5/line 624 pins the value as
// accepted-and-ignored on the Macintosh). UI-free programs keep the plain
// IQuit intrinsic (rt_quit) unchanged -- see lowQuit's irIsUiProgram()
// branch.
func IUiQuit(): int {
    return intern("ui_quit")
}


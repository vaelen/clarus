    var n: IRRecordLayout

    n.name = name
    n.fieldsHead = fieldsHead
    n.isOverlay = isOverlay
    irRecords.add(n)
    return irRecords.count - 1
}

// newIRRecordLayoutXRec builds an `extern record`'s IRRecordLayout (Task 4)
// -- mirrors newIRRecordLayout, but sets isXRec instead of isOverlay (the
// two are mutually exclusive; isOverlay's zero-value default, false, is
// always correct here without touching it).
func newIRRecordLayoutXRec(name: int, fieldsHead: int): int {
    var n: IRRecordLayout

    n.name = name
    n.fieldsHead = fieldsHead
    n.isXRec = true
    irRecords.add(n)
    return irRecords.count - 1
}

func irRecordLayoutName(i: int): int {
    return irRecords[i].name
}

func irRecordLayoutFieldsHead(i: int): int {
    return irRecords[i].fieldsHead
}

func irRecordLayoutIsOverlay(i: int): bool {
    return irRecords[i].isOverlay
}

func irRecordLayoutIsXRec(i: int): bool {
    return irRecords[i].isXRec
}

// irFindRecordLayoutByName (Task 4) returns nameIdx's irRecords index, or
// -1 -- a plain linear scan (record counts are small; no name->index map
// exists yet for this arena, matching irRecords' own no-lookup-table
// precedent elsewhere in this file). Used by lowXRecDecl (a nested xrec
// field's own layout) and irXRecFieldSize's XFRec case (recursing into a
// nested field's size).
func irFindRecordLayoutByName(nameIdx: int): int {
    var i: int

    i = 0
    while i < irRecords.count {
        if irRecords[i].name == nameIdx {
            return i
        }
        i = i + 1
    }
    return -1
}

// irXRecType builds a KXRec IRType (Task 4) -- see IRKind's own KXRec doc
// comment for why this exists (a nested extern-record FIELD's own type
// marker, never a real variable's storage type).
func irXRecType(name: int): int {
    return newIRType(KXRec, 0, -1, name)
}

// irXRecFieldAlign/irXRecFieldSize (Task 4) are irXRecFieldOffset/
// irXRecSize's own per-field primitives -- Ch13's field palette table,
// read off an irFieldSlots entry's xkind/xn (never t, except XFRec's
// recursive irXRecSize call, which needs t's KXRec-carried name to find
// the nested record's OWN irRecords entry).
func irXRecFieldAlign(f: int): int {
    var xk: int

    xk = irFieldSlotXKind(f)
    if xk == XFWord or xk == XFInt or xk == XFPtr or xk == XFRec {
        return 2
    }
    return 1
}

func irXRecFieldSize(f: int): int {
    var xk: int

    xk = irFieldSlotXKind(f)
    if xk == XFBool or xk == XFByte {
        return 1
    }
    if xk == XFWord {
        return 2
    }
    if xk == XFInt or xk == XFPtr {
        return 4
    }
    if xk == XFStr {
        return irFieldSlotXN(f) + 1
    }
    if xk == XFPad {
        return irFieldSlotXN(f)
    }
    // XFRec: irtName(t) is the nested record's own interned name
    // (irXRecType's `name` slot).
    return irXRecSize(irFindRecordLayoutByName(irtName(irFieldSlotType(f))))
}

// irXRecFieldOffset returns fieldIdx's (0-based, declaration-order)
// packed byte offset within recIdx's own layout -- THE shared layout
// authority (Ch13's field palette packing table: each field aligned per
// its own kind, no other padding), consulted ONLY by lower.cla (see
// EXRecAddr's own doc comment) -- cg68k.cla/cprint.cla never call this
// directly, they only ever consume the already-resolved literal offset an
// EXRecAddr node carries. Verified during development (Task 4) against
// both sanity anchors the brief names: EventRecord (word,int,int,Point,
// word) puts `where` at offset 10, size 16; SFReply (bool,bool,int,word,
// word,str[63]) puts `fName` at offset 10, size 74 (checked.cla's own
// xrecSizeByName implements the identical algorithm independently, see
// its doc comment for why it can't just call this).
func irXRecFieldOffset(recIdx: int, fieldIdx: int): int {
    var f: int
    var i: int
    var offset: int

    offset = 0
    f = irRecordLayoutFieldsHead(recIdx)
    i = 0
    while f != -1 {
        if irXRecFieldAlign(f) == 2 and offset mod 2 != 0 {
            offset = offset + 1
        }
        if i == fieldIdx {
            return offset
        }
        offset = offset + irXRecFieldSize(f)
        f = irFieldSlotNext(f)
        i = i + 1
    }
    return -1
}

// irXRecSize returns recIdx's total packed size, rounded up to even
// (Ch13's packing table) -- the layout authority's other half; see
// irXRecFieldOffset's own doc comment.
func irXRecSize(recIdx: int): int {
    var f: int
    var offset: int

    offset = 0
    f = irRecordLayoutFieldsHead(recIdx)
    while f != -1 {
        if irXRecFieldAlign(f) == 2 and offset mod 2 != 0 {
            offset = offset + 1
        }
        offset = offset + irXRecFieldSize(f)
        f = irFieldSlotNext(f)
    }
    if offset mod 2 != 0 {
        offset = offset + 1
    }
    return offset
}

// irXRecFieldSlotByName/irXRecFieldOffsetByName (Task 4) are lower.cla's
// own name-keyed convenience over irXRecFieldOffset's exact same walk --
// Ch13 field access always starts from a NAME (`ev.what`), never a
// position -- built on the SAME irXRecFieldAlign/irXRecFieldSize
// primitives, so they can never disagree with irXRecFieldOffset/
// irXRecSize. NOT part of the layout authority's own two-function
// signature; lower.cla is their only caller.
func irXRecFieldSlotByName(recIdx: int, nameIdx: int): int {
    var f: int

    f = irRecordLayoutFieldsHead(recIdx)
    while f != -1 {
        if irFieldSlotName(f) == nameIdx {
            return f
        }
        f = irFieldSlotNext(f)
    }
    return -1
}

func irXRecFieldOffsetByName(recIdx: int, nameIdx: int): int {
    var f: int
    var offset: int

    offset = 0
    f = irRecordLayoutFieldsHead(recIdx)
    while f != -1 {
        if irXRecFieldAlign(f) == 2 and offset mod 2 != 0 {
            offset = offset + 1
        }
        if irFieldSlotName(f) == nameIdx {
            return offset
        }
        offset = offset + irXRecFieldSize(f)
        f = irFieldSlotNext(f)
    }
    return -1
}


}

func irMenuHandlerEntryNext(i: int): int {
    return irMenuHandlerEntries[i].next
}

// newIREveryEntry appends to the program-wide irEveryHead/Tail chain
// (declaration order) and returns the new entry's index.
func newIREveryEntry(funcNameIdx: int, ticks: int): int {
    var n: IREveryEntry
    var idx: int

    n.funcNameIdx = funcNameIdx
    n.ticks = ticks
    n.next = -1
    irEveryEntries.add(n)
    idx = irEveryEntries.count - 1
    if irEveryHead == -1 {
        irEveryHead = idx
    } else {
        irEveryEntries[irEveryTail].next = idx
    }
    irEveryTail = idx
    irEveryCount = irEveryCount + 1
    return idx
}

func irEveryEntryFuncName(i: int): int {
    return irEveryEntries[i].funcNameIdx
}

func irEveryEntryTicks(i: int): int {
    return irEveryEntries[i].ticks
}

func irEveryEntryNext(i: int): int {
    return irEveryEntries[i].next
}

// ================================================================
// irStrLits (literal pool) constructors and accessors
// ================================================================

// irAddStrLit appends strPoolIdx (an already-interned strPool index) to
// the literal pool and returns its irStrLits index -- the value a
// StrConst's Idx field stores.
func irAddStrLit(strPoolIdx: int): int {
    irStrLits.add(strPoolIdx)
    return irStrLits.count - 1
}

func irStrLitPoolIdx(i: int): int {
    return irStrLits[i]
}


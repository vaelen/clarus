// newIRMenuHandlerEntry appends to the program-wide irMenuHandlersHead/Tail
// chain (declaration order) and returns the new entry's index.
func newIRMenuHandlerEntry(menuNameIdx: int, itemNameIdx: int, menuIdx: int, itemIdx: int, funcNameIdx: int, scopeWinTypeNameIdx: int): int {
    var n: IRMenuHandlerEntry
    var idx: int

    n.menuNameIdx = menuNameIdx
    n.itemNameIdx = itemNameIdx
    n.menuIdx = menuIdx
    n.itemIdx = itemIdx
    n.funcNameIdx = funcNameIdx
    n.scopeWinTypeNameIdx = scopeWinTypeNameIdx
    n.next = -1
    irMenuHandlerEntries.add(n)
    idx = irMenuHandlerEntries.count - 1
    if irMenuHandlersHead == -1 {
        irMenuHandlersHead = idx
    } else {
        irMenuHandlerEntries[irMenuHandlersTail].next = idx
    }
    irMenuHandlersTail = idx
    irMenuHandlerCount = irMenuHandlerCount + 1
    return idx
}


// -- files (record serialization, Task 2 mac-target-4d -> rt_file_save/
// rt_file_load, rt.h's Task 1 contract). Both intrinsics take the same two
// lowered args (path, data) as IFileReadText/IFileWriteText above; unlike
// those two, everything else the cprint arm needs (the RT_SER_* container
// tag, and which clar_layout_NAME to pass) is read straight back off the
// data arg's own IR type at print time (KRec directly, or KList/KMap's
// elem), never carried as extra IR fields -- see cprint.cla's fpIntrCall
// case.
func IFileSave(): int {
    return intern("file_save")
}

func IFileLoad(): int {
    return intern("file_load")
}

// -- UI (Task 4: Ch7-11 windows/widgets/menus/canvas -> runtime/mac/rt_ui.h).
// One intrinsic per concrete rt_ui operation (not one generic call taking a
// runtime-selected property/op as data) -- matching this table's existing
// style (IStrLen/IStrIndex/... are one-op-per-name too) and letting each
// cprint.cla case hardcode its own fixed rt_ui.h macro name textually, so no
// macro-spelling data ever has to flow through an IR node's fields.
func IUiOpen(): int {
    return intern("ui_open")
}

func IUiClose(): int {
    return intern("ui_close")
}

// IUiQuit (mac-target-4b final review) is `quit` in a UI program (Ch7
// Quit Semantics -> runtime/mac/rt_ui.c's rt_ui_quit): the closeRequest
// cascade over every open window, front-to-back, any cancel aborting the
// whole quit. No args, same "writes through a fixed runtime entry point,
// nothing to pass" shape as IUiCancel below -- a UI program's `quit` never
// carries operands into the C call itself (an optional exit-code
// expression, if present, is still evaluated by lowQuit for its side
// effects, just not passed in: Ch5/line 624 pins the value as
// accepted-and-ignored on the Macintosh). UI-free programs keep the plain
// IQuit intrinsic (rt_quit) unchanged -- see lowQuit's irIsUiProgram()
// branch.
func IUiQuit(): int {
    return intern("ui_quit")
}

func IUiFront(): int {
    return intern("ui_front")
}

func IUiState(): int {
    return intern("ui_state")
}

// IUiStateDefaults (clarusc-ui-gaps Task 2) constructs every handle-backed
// (text/list/map/rec) per-instance var in a window's state block -- rt_ui_open
// only zeroes that block (NewHandleClear, rt_ui.c), it never constructs
// anything in it (cpEmitUiStateStruct's own header comment), so a bare
// `var t: text` (or any Text/List/Map/Rec state var, defaulted or not) is a
// NULL handle on first in-place use without this. Single arg: the firing
// window instance (same shape as IUiState); its `ty` (a KUiState IRType,
// same as IUiState's) names which window's clar_uistate_NAME struct to walk.
// lower.cla inserts it as the FIRST statement of `opened` glue -- before
// WinVarDefault assignments, which stay before user statements -- in both
// lowPrependWinVarDefaults and lowSynthesizeMissingOpenedHandlers, for every
// window with >=1 such field. See its cprint.cla case (fpIntrCall) for the
// per-field construction, which reuses cpDefaultInit -- no duplicated type
// switch.
func IUiStateDefaults(): int {
    return intern("ui_state_defaults")
}

func IUiSetTitle(): int {
    return intern("ui_set_title")
}


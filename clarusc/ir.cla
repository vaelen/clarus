// IUiCancel (Task 5) is the `cancel` statement (Ch5/Ch8) -- valid only
// inside a closeRequest handler (checkCancelStmt already enforces this), so
// its body always runs inside a function the winEvent dispatcher's
// RTUI_EV_CLOSEREQUEST case calls with `clar_ui_cur_cancel` already pointed
// at the runtime's cancelFlag (the dispatcher sets it from `a` -- the
// ledger's `a = (long)&long cancelFlag` convention -- immediately before
// calling in; see cprint.cla's cpEmitOneWinEventDispatcher). No args: it
// writes through that one program-wide scratch pointer, never a
// per-handler parameter (closeRequest's own event spec always has 0
// declared Clarus params, so there is no AST-visible slot for one anyway).
func IUiCancel(): int {
    return intern("ui_cancel")
}

// IUiAskOpen/IUiAskSave/IUiAskSaveChanges (Task 4, mac-target-4c): the three
// built-in Standard File / save-confirmation dialogs (Ch12 Dialogs) --
// runtime/mac/rt_ui.c's rt_ui_ask_open/rt_ui_ask_save/rt_ui_ask_save_changes.
// askOpen/askSave fill their path argument IN PLACE (the runtime writes
// through the pointer cprint.cla passes, the same fill-in-place convention
// file.readText/file.name already use) and return a C int (0/1) embedded
// directly as the Bool result; askSaveChanges returns the raw saveChoice
// enum word (0/1/2), embedded directly since Save/Discard/Cancel already
// fold to the same int consts at compile time (types.cla's seeded
// saveChoice enum).
func IUiAskOpen(): int {
    return intern("ui_ask_open")
}


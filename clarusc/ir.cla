// irWinHandlersAppendWidgetEntry appends a fresh IRWidgetHandlerEntry to
// window handlers `i`'s widget chain (widgetTail bookkeeping is internal to
// this arena -- callers never see it) and returns the new entry's index.
func irWinHandlersAppendWidgetEntry(i: int, widgetIndex: int): int {
    var n: IRWidgetHandlerEntry
    var idx: int

    n.widgetIndex = widgetIndex
    n.clickFn = -1
    n.changeFn = -1
    n.dragFn = -1
    n.enterFn = -1
    n.selectFn = -1
    n.doubleClickFn = -1
    n.next = -1
    irWidgetHandlerEntries.add(n)
    idx = irWidgetHandlerEntries.count - 1
    if irWinHandlers[i].widgetHead == -1 {
        irWinHandlers[i].widgetHead = idx
    } else {
        irWidgetHandlerEntries[irWinHandlers[i].widgetTail].next = idx
    }
    irWinHandlers[i].widgetTail = idx
    return idx
}


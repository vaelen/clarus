// irCbGlueNames (Task 7, toolbox-integration Feature C) collects the
// interned name of every `callback func` newIRCbAddr has ever been called
// for, in first-decay order, deduped by linear scan (tiny -- one entry per
// DISTINCT decayed callback in the whole program, not per decay call
// site). cprint.cla's cpEmitCallbackGlue is the sole reader: it emits a
// clar_cb_<name> wrapper for exactly these names (further gated on
// shakeReachable, since a decay embedded in dead code should get neither
// the glue nor the body) -- a callback with NO entry here (no ECbAddr
// anywhere in the program) gets no wrapper at all, the tree-shake proof
// this task's brief calls for. A plain list, not a map: iteration order
// must be deterministic (byte-identical emitted-C goldens), which a `map
// of bool`'s own iteration order is not guaranteed to be.
var irCbGlueNames: list of int

// irMarkCbGlueNeeded is newIRCbAddr's own helper (below) -- see
// irCbGlueNames' own doc comment.
func irMarkCbGlueNeeded(nameIdx: int) {
    var i: int

    i = 0
    while i < irCbGlueNames.count {
        if irCbGlueNames[i] == nameIdx {
            return
        }
        i = i + 1
    }
    irCbGlueNames.add(nameIdx)
}

func irCbGlueNeededCount(): int {
    return irCbGlueNames.count
}

func irCbGlueNeededName(i: int): int {
    return irCbGlueNames[i]
}

// newIRCbAddr builds an ECbAddr node (Task 7, toolbox-integration Feature
// C) -- see IRExprKind's own ECbAddr doc comment for the field layout and
// why this also calls irMarkCbGlueNeeded.
func newIRCbAddr(name: int): int {
    var n: IRExpr

    n.kind = ECbAddr
    n.name = name
    n.ty = irPtrT
    n.next = -1
    irExprs.add(n)
    irMarkCbGlueNeeded(name)
    return irExprs.count - 1
}

func irCbAddrName(i: int): int {
    return irExprs[i].name
}


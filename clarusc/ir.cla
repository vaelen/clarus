}

func irFuncLocalsHead(i: int): int {
    return irFuncs[i].localsHead
}

func irFuncBodyHead(i: int): int {
    return irFuncs[i].bodyHead
}

// irFuncSetBodyHead overwrites an already-constructed IRFunc's body chain
// (Task 7, mac-target-4b: lower.cla's window-var-default fix needs to
// prepend synthesized default-assignment statements onto an explicit
// `on opened` handler's existing body, after lowHandlerFunc has already
// built it).
func irFuncSetBodyHead(i: int, bodyHead: int) {
    irFuncs[i].bodyHead = bodyHead
}

// irFuncSetLocalsHead overwrites an already-constructed IRFunc's locals
// chain (ARC Task 4: lowPrependWinVarDefaults's own lowWinVarDefaultsStmts
// call can now mint a NEW local -- lowCountedStore's materialization temp,
// via lowNewStoreTemp/lowAddLocal -- AFTER lowHandlerFunc has already
// frozen the handler's localsHead into its IRFunc record; if that handler
// body declared no `var`s of its own, lowLocalsHead was still -1 at freeze
// time, so the newly-minted temp is otherwise orphaned from the function's
// own C declaration walk -- cpEmitFunc would never see it, emitting a use
// of an undeclared C variable. Same fix shape as irFuncSetBodyHead just
// above.
func irFuncSetLocalsHead(i: int, localsHead: int) {
    irFuncs[i].localsHead = localsHead
}

// findIRFuncIdxByName returns irFuncs' arena index for the func whose name
// (an interned pool index, as returned by lowHandlerFunc/lowFuncDecl/etc.)
// equals nameIdx, or -1 if none. Findings 1.4 (Task 13): was a linear
// scan over irFuncs (fine when this was a rare one-per-window-with-
// defaults lookup, but cg68k's runtime-call emission calls it on every
// emitted runtime call against ~1,600 IRFuncs); now answers from
// irFuncIdxByName, maintained at newIRFunc registration time.
func findIRFuncIdxByName(nameIdx: int): int {
    return irFuncIdxByName.get(nameIdx, -1)
}


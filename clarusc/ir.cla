func newIRWidgetDesc(nameIdx: int, kindIdx: int, captionIdx: int, atKind: int, x: int, yIsBottom: bool, y: int, widthIsFill: bool, width: int, fillBoth: bool, isDefault: bool, isCancel: bool, isBuffered: bool, isScrollV: bool, isScrollH: bool, bindsIdx: int, rowsGlobalIdx: int, columnsHead: int): int {
    var n: IRWidgetDesc

    n.nameIdx = nameIdx
    n.kindIdx = kindIdx
    n.captionIdx = captionIdx
    n.atKind = atKind
    n.x = x
    n.yIsBottom = yIsBottom
    n.y = y
    n.widthIsFill = widthIsFill
    n.width = width
    n.fillBoth = fillBoth
    n.isDefault = isDefault
    n.isCancel = isCancel
    n.isBuffered = isBuffered
    n.isScrollV = isScrollV
    n.isScrollH = isScrollH
    n.bindsIdx = bindsIdx
    n.rowsGlobalIdx = rowsGlobalIdx
    n.columnsHead = columnsHead
    n.next = -1
    irWidgetDescs.add(n)
    return irWidgetDescs.count - 1
}


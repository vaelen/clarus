// recordDeclIsOverlay/recordDeclSetOverlay carry the `overlay record` flag
// (Task 1, Ch13: Overlay Records) in DkRecord's intVal slot: 0 = plain
// `record` (the zero-value default, never needs setting), 1 = `overlay
// record`. recordDeclIsXRec/recordDeclSetXRec (Task 4, toolbox-integration
// Feature B: `extern record`) add a third state, 2, in the SAME slot --
// exactly one of Is Overlay/IsXRec is ever true for a given decl, so
// recordDeclIsOverlay checks `== 1` specifically (not a bare nonzero test,
// which would also true for an xrec's `intVal == 2`).
func recordDeclIsOverlay(i: int): bool {
    return decls[i].intVal == 1
}

func recordDeclSetOverlay(i: int) {
    decls[i].intVal = 1
}


func newMenuEntry(nameIdx: int, captionIdx: int, keyIdx: int, isItem: bool, isSeparator: bool, isStandardEdit: bool, line: int, col: int): int {
    var n: DeclNode
    var flags: int

    flags = 0
    if isItem {
        flags = flags + 1
    }
    if isSeparator {
        flags = flags + 2
    }
    if isStandardEdit {
        flags = flags + 4
    }

    n.kind = DkMenuEntry
    n.nameIdx = nameIdx
    n.a = captionIdx
    n.b = keyIdx
    n.intVal = flags
    n.next = -1
    n.line = line
    n.col = col
    decls.add(n)
    return decls.count - 1
}


// ast.cla: the AST as typed arenas -- a port of internal/ast/ast.go's node
// shapes. Go's ast.go uses recursive struct/interface types (Expr, Stmt,
// Decl, TypeExpr interfaces with pointer-typed fields); Clarus has no
// recursive types, so every node kind here is instead a fixed-shape record
// pushed onto one of four global arenas (exprs, stmts, decls, typeExprs),
// referenced by its int index into that arena. A child "pointer" is just
// the child's arena index; -1 means "no node" (absent optional child).
// Variable-arity sequences (a Call's args, a Block's statements, a record's
// fields, ...) are represented as intrusive singly-linked lists threaded
// through each node's own `next` field: the sequence's head is an index
// into the arena, and each node's `next` names the following node (-1 at
// the end).
//
// parse.cla (Task 7) and check.cla (Task 9) build and walk these arenas
// exclusively through the constructor (`newXxx`) and accessor functions
// below -- never by touching `.a`/`.b`/`.c` directly. That discipline is
// what makes the schema comment below a real contract: change a field's
// meaning here and every caller changes with it, instead of silently
// drifting out of sync with a comment nobody re-reads.
//
// ============================================================
// SCHEMA: per-kind meaning of a / b / c / next / nameIdx / intVal
// ============================================================
//
// Every arena record (ExprNode, StmtNode, DeclNode, TypeExpr) shares one
// generic shape: kind + three child slots (a, b, c) + a sibling link
// (next) + nameIdx (an interned string index -- its meaning varies by
// kind, it is not always literally "the name") + intVal (a plain int,
// meaning varies by kind) + line/col (source position, 1-based).
//
// `next` is used ONLY when a node sits inside some parent's variable-arity
// sequence (e.g. one argument in a Call's argument list); a node that is
// never part of such a sequence leaves `next` at -1. A child slot holding
// "no node" is always -1 -- never 0, because 0 is a valid arena index (the
// first node ever allocated in that arena).
//
// ---- ExprKind (exprs arena) ----
//   ExIdent      nameIdx=name
//   ExIntLit     intVal=value
//   ExFixedLit   intVal=raw 16.16 value
//   ExCharLit    intVal=byte value (0-255)
//   ExStringLit  nameIdx=interned literal contents
//   ExBoolLit    intVal=0 (false) or 1 (true)
//   ExNilLit     (no fields used)
//   ExWindowSelf (no fields used) -- the `window` keyword in expr position
//   ExUnary      intVal=UnOp code (OpNeg/OpNot/OpBNot); a=operand expr
//   ExBinary     intVal=BinOp code (OpAdd..OpOr); a=left expr; b=right expr
//   ExCall       a=fn expr; b=args list head expr (-1 if none, each arg
//                chained via its own .next); intVal=appletalk flag (0/1)
//   ExIndex      a=base expr (X); b=index expr (I)
//   ExSlice      a=base expr (X); b=start expr; c=len expr
//   ExSelect     a=base expr (X); nameIdx=selected field/property name
//   ExNew        nameIdx=record type name              -- `new T`
//   ExOpen       nameIdx=window type name               -- `open T` (expr form)
//   ExAppConst   nameIdx=field name ("doctype" or "id")  -- `app.doctype` /
//                `app.id` (native-gaps-cleanup Task 1, Part A). A
//                compile-time-only expression: checkAppConstExpr
//                (check.cla) validates the field name; lowAppConst
//                (lower.cla) lowers it straight to a padded STRING
//                LITERAL (irAppDoctype/irAppId or their "TEXT"/"????"
//                defaults) -- no backend past lower.cla ever sees this
//                kind.
//
// ---- StmtKind (stmts arena) ----
//   StBlock      a=vars list head (decls arena, DkVar chain via
//                DeclNode.next, -1 if none); b=stmts list head (stmts
//                arena, chained via StmtNode.next, -1 if none)
//   StAssign     a=lhs expr; b=rhs expr
//   StExprStmt   a=expr (a call used as a statement)
//   StIf         a=cond expr; b=then StBlock; c=else stmt (-1, a StBlock,
//                or another StIf -- mirrors ast.go's Stmt-typed Else)
//   StWhile      a=cond expr; b=body StBlock
//   StFor        nameIdx=V1 (loop var name); intVal=V2 (map value var
//                name, -1 unless the map form); a=Seq expr; b=ToExpr
//                (-1 unless a range form); c=body StBlock
//   StReturn     a=expr (-1 for bare `return`)
//   StQuit       a=code expr (-1 for bare `quit`)
//   StCancel     (no fields used)
//   StBreak      (no fields used)
//   StContinue   (no fields used)
//   StSwitch     a=subject expr; b=cases list head (StCase chain via
//                StmtNode.next, -1 if none -- grammar requires at least
//                one, but the sentinel discipline stays uniform); c=else
//                StBlock (-1 if no else)
//   StCase       a=labels list head (exprs arena, chained via
//                ExprNode.next); b=body StBlock; (.next chains to the
//                next StCase in the enclosing StSwitch's case list) --
//                not a real ast.go Stmt; represents SwitchCase
//   StOpen       nameIdx=window type name                -- `open T` (stmt form)
//   StClose      a=expr (window ref to close)
//   StEdit       nameIdx=form window name; intVal=isNew flag (0/1);
//                a=target expr (meaningful iff isNew==0); b=new-type name
//                (meaningful iff isNew==1)
//
// ---- DeclKind (decls arena) ----
// -- top-level declarations (a File's Decls, chained via DeclNode.next) --
//   DkInclude    nameIdx=path string
//   DkVar        nameIdx=name; a=type (typeExprs arena); b=init expr
//                (-1 if none) -- also used for local vars (a StBlock's
//                vars list) and window-body per-instance vars
//   DkConst      nameIdx=name; a=type; b=value expr (literal or Ident)
//   DkRecord     nameIdx=name; a=fields list head (DkField chain, -1 if
//                empty); intVal=isOverlay flag (0/1) -- Task 1 (Ch13:
//                Overlay Records), `overlay record` vs. plain `record`
//   DkEnum       nameIdx=name; a=members list head (DkEnumMember chain)
//   DkFunc       nameIdx=name; a=params list head (DkParam chain, -1 if
//                none); b=return type (-1 if a procedure); c=body StBlock
//   DkWindow     nameIdx=name; a=items list head (DkProperty/DkWidget/
//                DkVar/DkFormFor chain, -1 if empty)
//   DkMenu       nameIdx=name; a=entries list head (DkMenuEntry chain)
//   DkExtend     nameIdx=target name; a=children list head (mixed
//                DkHandler/DkExtend, chained via DeclNode.next in source
//                order -- equivalent to ast.go's separate Handlers/Nested
//                slices: a stable filter by kind over this one list
//                reproduces each of them, in source order, exactly)
//   DkHandler    nameIdx=dotted event path ("Go.click", "closeRequest",
//                ... -- split with string ops at check time); a=params
//                list head (DkParam chain, -1 if none); b=body StBlock
//   DkEvery      intVal=ticks; a=body StBlock
//
// -- auxiliary structural nodes (helper structs in ast.go; live in the
//    decls arena because they need the same kind+child-slot shape) --
//   DkField      nameIdx=name; a=type; b=default expr (-1 if none)
//   DkParam      nameIdx=name; a=type; b=named `reg(...)` clause's
//                resolved register code (Task 1, Feature A -- -1 default,
//                see paramRegBind below; unused by any other DkParam)
//   DkEnumMember nameIdx=name; intVal=value; b=hasValue flag (0/1);
//                c=label (interned, -1 if unlabeled)
//   DkProperty   nameIdx=property name; a=values list head (exprs arena,
//                chained via ExprNode.next, -1 if none) -- a window/widget
//                property, e.g. `title: "x"` or a bare `resizable`
//   DkColumn     nameIdx=header (interned string content); a=shows name
//                (interned); intVal=widthPx; b=widthFill flag (0/1)
//   DkFormFor    nameIdx=record type name                -- `form for T`
//   DkWidget     nameIdx=widget instance name; a=widget kind (interned,
//                e.g. "button"); b=props list head (DkProperty/DkColumn
//                chain, -1 if none)
//   DkMenuEntry  nameIdx=item name (-1 if separator/standard-edit);
//                a=caption (interned, -1 if none); b=key (interned, -1 if
//                none); intVal=flags bitmask (bit0 IsItem, bit1
//                IsSeparator, bit2 IsStandardEdit)
//   DkApp        nameIdx=label; a=props head (DkProperty chain); b=path
//                pool idx
//   DkExternFunc (Task 3, Ch13: `external func`) nameIdx=name; a=params
//                list head (DkParam chain, -1 if none); b=return type (-1
//                if no result); c=trap word for a trap clause, -1
//                otherwise -- no clause, or an inline clause, which has no
//                trap word to store (Task 2, native-5d); intVal=convention
//                flag (0=none, 1=pascal trap, 2=reg trap [positional],
//                3=inline deref, 4=inline nop, 5=inline a5, 6=reg trap
//                [positional] memerr, 7=reg trap [named], 8=reg trap
//                [named] memerr -- 5/6 Task 12/14 native-5e, 7/8 Task 1
//                toolbox-integration Feature A) -- intVal is what
//                distinguishes the inline/reg sub-forms, since c is -1 for
//                all of them. Same a/b slot layout as DkFunc so
//                funcDeclName/ParamsHead/RetType and checkFuncSig work
//                unchanged on it; c/intVal replace DkFunc's unused body
//                slot (an external has no body) and are read back by
//                externFuncTrap/externFuncConv below. A conv-7/8 extern's
//                per-param register bindings live on its OWN params (see
//                DkParam's b slot / paramRegBind below, not here -- no
//                DeclNode slot is left); its optional `ret REG` lives in
//                the decl-keyed externRetRegByDecl map (astExternRetReg)
//                for the same reason.
//   DkCallbackFunc (Task 7, toolbox-integration Feature C: `callback
//                func`) nameIdx=name; a=params list head (DkParam chain,
//                -1 if none); b=return type (-1 if a procedure); c=body
//                StBlock -- IDENTICAL a/b/c layout to DkFunc (unlike
//                DkExternFunc, a callback has a real body), so
//                funcDeclName/ParamsHead/RetType/Body all work on it
//                unchanged; check.cla's checkCallbackFunc (not
//                checkFuncSig alone) additionally restricts the
//                param/return palette to bool/char/word/int/ptr.
//
// ---- TypeExprKind (typeExprs arena) ----
//   TxNamed      nameIdx=type name ("int", "bool", ..., or a user
//                record/enum/window name)
//   TxString     intVal=capacity N (255 for bare `string`)
//   TxList       a=element type (typeExprs arena)
//   TxMap        a=value type (typeExprs arena)
//   TxArray      a=element type; intVal=length N

enum ExprKind {
    ExIdent
    ExIntLit
    ExFixedLit
    ExCharLit
    ExStringLit
    ExBoolLit
    ExNilLit
    ExWindowSelf
    ExUnary
    ExBinary
    ExCall
    ExIndex
    ExSlice
    ExSelect
    ExNew
    ExOpen
    ExAppConst
}

enum StmtKind {
    StBlock
    StAssign
    StExprStmt
    StIf
    StWhile
    StFor
    StReturn
    StQuit
    StCancel
    StBreak
    StContinue
    StSwitch
    StCase
    StOpen
    StClose
    StEdit
}

enum DeclKind {
    DkInclude
    DkVar
    DkConst
    DkRecord
    DkEnum
    DkFunc
    DkWindow
    DkMenu
    DkExtend
    DkHandler
    DkEvery
    DkField
    DkParam
    DkEnumMember
    DkProperty
    DkColumn
    DkFormFor
    DkWidget
    DkMenuEntry
    DkApp
    DkExternFunc

    // DkCallbackFunc (Task 7, toolbox-integration Feature C: `callback
    // func`) -- SAME a/b/c slot layout as DkFunc (params list head /
    // return type / body StBlock): unlike DkExternFunc, a callback DOES
    // have a real body (an ordinary Clarus function, callable directly),
    // so funcDeclName/ParamsHead/RetType/Body all work on it unchanged,
    // same reuse DkExternFunc's own doc comment describes for itself.
    // Built only by parseCallbackFuncDecl, itself reachable only from
    // parseTopDecl -- top-level only, structurally (no statement-level
    // parser path ever recognizes `callback`).
    DkCallbackFunc
}

enum TypeExprKind {
    TxNamed
    TxString
    TxList
    TxMap
    TxArray

    // TxWord (Task 4, native-5e, Ch13: the `word` extern type) is built ONLY
    // by parseExternType, inside an `external func` param/return type
    // position -- nowhere else constructs it, so `word` used as an ordinary
    // type name (a var decl, a non-extern param) still goes through
    // TxNamed like any other identifier and fails resolveType's ordinary
    // "undefined: word" path (word is not a registered type). No extra
    // fields: like TxNamed's builtin scalar names, a TxWord node carries no
    // payload beyond its own kind.
    TxWord

    // TxByte/TxXStr/TxPad (Task 4, toolbox-integration Feature B: `extern
    // record`) are built ONLY by parseXRecFieldType/parseXRecFieldDecl,
    // inside an `extern record` body -- the same "contextual, nowhere else"
    // discipline TxWord's own doc comment describes. TxByte carries no
    // payload (like TxWord). TxXStr is `str[N]` (a Pascal string buffer
    // field; intVal=N, the declared length -- unrelated to TxString's own
    // `string(N)` grammar, a completely different field spelling). TxPad is
    // a bare `pad[N]` field LINE (intVal=N, the byte count) -- built by
    // parseXRecFieldDecl directly (not parseXRecFieldType), since a pad
    // field has no preceding `name:` at all; `name: pad[N]` does NOT build
    // a TxPad (see parseXRecFieldType's own doc comment) -- it falls
    // through to plain parseType, producing a TxNamed("pad") that fails
    // resolution as an ordinary undefined type name.
    TxByte
    TxXStr
    TxPad
}

record ExprNode {
    kind: ExprKind
    a: int
    b: int
    c: int
    next: int
    nameIdx: int
    intVal: int
    line: int
    col: int
}

record StmtNode {
    kind: StmtKind
    a: int
    b: int
    c: int
    next: int
    nameIdx: int
    intVal: int
    line: int
    col: int
}

record DeclNode {
    kind: DeclKind
    a: int
    b: int
    c: int
    next: int
    nameIdx: int
    intVal: int
    line: int
    col: int
}

// TypeExpr shares the same generic shape as the other three node records
// (uniform shape beats a bespoke smaller layout here -- one pattern to
// remember, a few unused ints per node is irrelevant on a host machine),
// though no TypeExprKind actually uses b, c, or next: a type expression is
// always a single child of some other node (a field's type, a param's
// type, ...), never itself a member of a linked list.
record TypeExpr {
    kind: TypeExprKind
    a: int
    b: int
    c: int
    next: int
    nameIdx: int
    intVal: int
    line: int
    col: int
}

var exprs: list of ExprNode
var stmts: list of StmtNode
var decls: list of DeclNode
var typeExprs: list of TypeExpr

// astReset empties all four arenas. Call between compiling independent
// programs (mirrors lexAll's clear-on-entry / lib.cla's resetDiags -- Task
// 5's established pattern for arenas that must not leak across programs in
// the differential harness).
func astReset() {
    while exprs.count > 0 {
        exprs.pop()
    }
    while stmts.count > 0 {
        stmts.pop()
    }
    while decls.count > 0 {
        decls.pop()
    }
    while typeExprs.count > 0 {
        typeExprs.pop()
    }
}

// boolToInt/intToBool convert between Clarus bool and the 0/1 ints stored
// in intVal for kinds whose Go field is a bool (BoolLit.Val, Call.AppleTalk,
// EnumMember.HasValue, Column.WidthFill, EditStmt.IsNew, MenuEntry's three
// flags).
func boolToInt(b: bool): int {
    if b {
        return 1
    }
    return 0
}

func intToBool(n: int): bool {
    return n != 0
}

// ---- ExBinary / ExUnary operator codes ----
// Op is a source string in ast.go ("+", "mod", "and", ...); the arena
// stores it as a plain int code instead (matching the brief's `newBin(op:
// int, ...)` signature) so building/reading a Binary/Unary node needs no
// intern() round trip. binOpSymbol/unOpSymbol below map a code back to its
// source spelling for renderers and diagnostics.
const OpAdd: int = 0
const OpSub: int = 1
const OpMul: int = 2
const OpDiv: int = 3
const OpMod: int = 4
const OpShl: int = 5
const OpShr: int = 6
const OpBAnd: int = 7
const OpBOr: int = 8
const OpBXor: int = 9
const OpEq: int = 10
const OpNe: int = 11
const OpLt: int = 12
const OpLe: int = 13
const OpGt: int = 14
const OpGe: int = 15
const OpAnd: int = 16
const OpOr: int = 17

const OpNeg: int = 0
const OpNot: int = 1
const OpBNot: int = 2

func binOpSymbol(op: int): string {
    switch op {
    case OpAdd { return "+" }
    case OpSub { return "-" }
    case OpMul { return "*" }
    case OpDiv { return "/" }
    case OpMod { return "mod" }
    case OpShl { return "<<" }
    case OpShr { return ">>" }
    case OpBAnd { return "&" }
    case OpBOr { return "|" }
    case OpBXor { return "^" }
    case OpEq { return "==" }
    case OpNe { return "!=" }
    case OpLt { return "<" }
    case OpLe { return "<=" }
    case OpGt { return ">" }
    case OpGe { return ">=" }
    case OpAnd { return "and" }
    case OpOr { return "or" }
    }
    return "?"
}

func unOpSymbol(op: int): string {
    switch op {
    case OpNeg { return "-" }
    case OpNot { return "not" }
    case OpBNot { return "~" }
    }
    return "?"
}

// ================================================================
// Expr constructors and accessors (exprs arena)
// ================================================================

func exprKind(i: int): ExprKind {
    return exprs[i].kind
}

func exprLine(i: int): int {
    return exprs[i].line
}

func exprCol(i: int): int {
    return exprs[i].col
}

func exprNext(i: int): int {
    return exprs[i].next
}

// exprListAppend links node idx as the successor of the node at tailIdx
// (a no-op when tailIdx is -1, i.e. the list is still empty) and returns
// idx so the caller can track it as the new tail. The caller separately
// tracks the list's head (idx itself, the first time this is called).
func exprListAppend(tailIdx: int, idx: int): int {
    if tailIdx >= 0 {
        exprs[tailIdx].next = idx
    }
    return idx
}

func newIdent(nameIdx: int, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExIdent
    n.nameIdx = nameIdx
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func identName(i: int): int {
    return exprs[i].nameIdx
}

func newIntLit(v: int, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExIntLit
    n.intVal = v
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func intLitVal(i: int): int {
    return exprs[i].intVal
}

func newFixedLit(raw: int, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExFixedLit
    n.intVal = raw
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func fixedLitRaw(i: int): int {
    return exprs[i].intVal
}

func newCharLit(v: int, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExCharLit
    n.intVal = v
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func charLitVal(i: int): int {
    return exprs[i].intVal
}

func newStringLit(nameIdx: int, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExStringLit
    n.nameIdx = nameIdx
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func stringLitIdx(i: int): int {
    return exprs[i].nameIdx
}

func newBoolLit(v: bool, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExBoolLit
    n.intVal = boolToInt(v)
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func boolLitVal(i: int): bool {
    return intToBool(exprs[i].intVal)
}

func newNilLit(line: int, col: int): int {
    var n: ExprNode

    n.kind = ExNilLit
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func newWindowSelf(line: int, col: int): int {
    var n: ExprNode

    n.kind = ExWindowSelf
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func newUnary(op: int, x: int, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExUnary
    n.intVal = op
    n.a = x
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func unaryOp(i: int): int {
    return exprs[i].intVal
}

func unaryX(i: int): int {
    return exprs[i].a
}

func newBin(op: int, left: int, right: int, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExBinary
    n.intVal = op
    n.a = left
    n.b = right
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func binOp(i: int): int {
    return exprs[i].intVal
}

func binLeft(i: int): int {
    return exprs[i].a
}

func binRight(i: int): int {
    return exprs[i].b
}

func newCall(fn: int, argsHead: int, appleTalk: bool, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExCall
    n.a = fn
    n.b = argsHead
    n.intVal = boolToInt(appleTalk)
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func callFn(i: int): int {
    return exprs[i].a
}

func callArgsHead(i: int): int {
    return exprs[i].b
}

func callAppleTalk(i: int): bool {
    return intToBool(exprs[i].intVal)
}

func newIndex(x: int, idx: int, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExIndex
    n.a = x
    n.b = idx
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func indexX(i: int): int {
    return exprs[i].a
}

func indexI(i: int): int {
    return exprs[i].b
}

func newSlice(x: int, start: int, sliceLen: int, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExSlice
    n.a = x
    n.b = start
    n.c = sliceLen
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func sliceX(i: int): int {
    return exprs[i].a
}

func sliceStart(i: int): int {
    return exprs[i].b
}

func sliceLen(i: int): int {
    return exprs[i].c
}

func newSelect(x: int, nameIdx: int, line: int, col: int): int {
    var n: ExprNode

    n.kind = ExSelect
    n.a = x
    n.nameIdx = nameIdx
    n.next = -1
    n.line = line
    n.col = col
    exprs.add(n)
    return exprs.count - 1
}

func selectX(i: int): int {
    return exprs[i].a
}

func selectName(i: int): int {
    return exprs[i].nameIdx
}

// newAppConst builds an ExAppConst node -- `app.doctype` / `app.id` in
// expression position (native-gaps-cleanup Task 1, Part A). fieldNameIdx
// is the member name after the dot; unlike ExSelect there is no base
// expr slot, since the base is always the fixed `app` keyword, never a
// user value.

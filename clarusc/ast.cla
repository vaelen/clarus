// newExternFuncDecl builds a DkExternFunc node (Task 3, Ch13: `external
// func`) -- same a/b slot layout as DkFunc (params head / return type), so
// the funcDeclName/ParamsHead/RetType accessors above and checkFuncSig
// (check.cla) work on it unchanged; c and intVal instead carry the
// optional trap/inline clause (Task 2, native-5d: trapVal is the trap word
// for a trap clause, -1 for no clause or an inline clause; convFlag is
// 0=none, 1=pascal trap, 2=reg trap, 3=inline deref, 4=inline nop).
func newExternFuncDecl(nameIdx: int, paramsHead: int, retType: int, trapVal: int, convFlag: int, line: int, col: int): int {
    var n: DeclNode

    n.kind = DkExternFunc
    n.nameIdx = nameIdx
    n.a = paramsHead
    n.b = retType
    n.c = trapVal
    n.intVal = convFlag
    n.next = -1
    n.line = line
    n.col = col
    decls.add(n)
    return decls.count - 1
}

// externFuncTrap returns a DkExternFunc's trap word (0xA000..0xAFFF once
// checked), or -1 if it has no trap clause (bare, or an inline clause).
// `c` may also carry a packed selector in its upper 16 bits (externFuncSel,
// below) -- parseExternFuncDecl's own packing comment explains why there's
// no separate DeclNode field for it. The no-clause case is short-circuited
// (not just masked): parseExternFuncDecl packs `c` as exactly -1 (all bits
// set) when there is no trap clause, and `-1 & 0xFFFF` would otherwise
// return 0xFFFF, not -1, breaking the contract this doc comment promises
// (found harmless-in-practice during native-5e Task 14/15 -- every caller
// of externFuncTrap only reads it under a conv that implies a trap clause
// exists -- but fixed for real rather than left as a doc-only caveat).
func externFuncTrap(i: int): int {
    if decls[i].c == -1 {
        return -1
    }
    return decls[i].c & 0xFFFF
}

// externFuncSel returns a DkExternFunc's `trap WORD sel SELECTOR` clause's
// selector word (Task 14, native-5e -- a "Package 7" List Manager style
// selector-dispatch trap, e.g. UiLNew's real `0xA9E7` trap shared by every
// List Manager routine, distinguished only by this selector; see
// parseExternFuncDecl's own doc comment), or -1 if the extern has no `sel`
// clause. Packed into `c`'s upper 16 bits as selVal+1 (0 = none); -1 is
// never itself a valid selVal+1 encoding here (trapVal is always
// 0xA000..0xAFFF, i.e. c is never negative), so this is exact.
func externFuncSel(i: int): int {
    return (decls[i].c >> 16) - 1
}

// externFuncConv returns a DkExternFunc's calling-convention flag: 0=none,
// 1=pascal trap, 2=reg trap (positional), 3=inline deref, 4=inline nop,
// 5=inline a5, 6=reg trap (positional) memerr, 7=reg trap (named), 8=reg
// trap (named) memerr.
func externFuncConv(i: int): int {
    return decls[i].intVal
}


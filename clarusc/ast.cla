}

func stmtListAppend(tailIdx: int, idx: int): int {
    if tailIdx >= 0 {
        stmts[tailIdx].next = idx
    }
    return idx
}

func newBlock(varsHead: int, stmtsHead: int, line: int, col: int): int {

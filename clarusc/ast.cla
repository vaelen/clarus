func newMenuEntry(nameIdx: int, captionIdx: int, keyIdx: int, isItem: bool, isSeparator: bool, isStandardEdit: bool, line: int, col: int): int {
    var n: DeclNode
    var flags: int

    flags = 0
    if isItem {
        flags = flags + 1
    }
    if isSeparator {
        flags = flags + 2
    }
    if isStandardEdit {
        flags = flags + 4
    }

    n.kind = DkMenuEntry
    n.nameIdx = nameIdx
    n.a = captionIdx
    n.b = keyIdx
    n.intVal = flags
    n.next = -1
    n.line = line
    n.col = col
    decls.add(n)
    return decls.count - 1
}

func menuEntryName(i: int): int {
    return decls[i].nameIdx
}

func menuEntryCaption(i: int): int {
    return decls[i].a
}

func menuEntryKey(i: int): int {
    return decls[i].b
}

func menuEntryIsItem(i: int): bool {
    return (decls[i].intVal & 1) != 0
}

func menuEntryIsSeparator(i: int): bool {
    return (decls[i].intVal & 2) != 0
}

func menuEntryIsStandardEdit(i: int): bool {
    return (decls[i].intVal & 4) != 0
}


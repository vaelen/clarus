}

func newFor(v1NameIdx: int, v2NameIdx: int, seq: int, toExpr: int, body: int, line: int, col: int): int {
    var n: StmtNode

    n.kind = StFor
    n.nameIdx = v1NameIdx
    n.intVal = v2NameIdx
    n.a = seq
    n.b = toExpr
    n.c = body
    n.next = -1
    n.line = line
    n.col = col
    stmts.add(n)
    return stmts.count - 1
}

func forV1(i: int): int {

    return decls[i].a
}

func menuEntryKey(i: int): int {
    return decls[i].b
}

func menuEntryIsItem(i: int): bool {
    return (decls[i].intVal & 1) != 0
}

func menuEntryIsSeparator(i: int): bool {
    return (decls[i].intVal & 2) != 0
}

func menuEntryIsStandardEdit(i: int): bool {
    return (decls[i].intVal & 4) != 0
}


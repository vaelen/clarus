// peep68k.cla -- peephole pass over asm68k's instruction arena
// (peephole68k phase; spec:
// docs/superpowers/specs/2026-08-08-peephole68k-design.md).
//
// peepFunc(startIdx) runs at the tail of cgEmitFunc, over exactly the
// items that function just emitted. Because cg68Measure sizes functions
// by calling the real cgEmitFunc, the pass runs identically under
// measurement and emission -- segment packing stays exact by
// construction.
//
// SAFETY RULES (every pattern MUST obey; see the spec's "Safety rules"):
//   - a match window never spans a KindBind (control can enter there),
//     any control-flow/call instruction (Bcc/BRA/BSR/JSR/JMP/DBRA/RTS),
//     a KindTrap, or KindData;
//   - KindComment/KindDead are transparent (peepNextReal skips them);
//   - rewrites are same-size-or-smaller, and all instruction sizes are
//     even, so parity (DKindAlign) is never disturbed;
//   - patterns match EXACT op/size/mode/register shapes -- no general
//     effect analysis. Whitelists over naive codegen's actual shapes;
//   - patterns never read it.addr (a68Relayout re-derives layout after).

// peepDisabled: set by main.cla's --nopeep (emit68k-only diagnostic
// flag). Default false = pass enabled.
var peepDisabled: bool

// peepNextReal returns the index of the next non-transparent item after
// i (skipping KindComment and KindDead), or -1 at arena end. The caller
// checks the returned item's kind/shape itself -- including whether it
// is a barrier.
func peepNextReal(i: int): int {
    var j: int

    j = i + 1
    while j < a68Items.count {
        if a68Items[j].kind != KindComment and a68Items[j].kind != KindDead {
            return j
        }
        j = j + 1
    }
    return -1
}

// peepKill marks item i deleted (KindDead, zero length).
func peepKill(i: int) {
    var it: A68Item

    it = a68Items[i]
    it.kind = KindDead
    it.len = 0
    a68Items[i] = it
}

// peepIsSimpleLoadToD0: item i is a single instruction that fully
// defines D0 without reading D0 or D1 and without touching A7 --
// naive codegen's own load shapes:
//   MOVE.L #imm,D0            (AmImm -> D0)
//   MOVE.L d16(An),D0, An!=A7 (AmDisp16 -> D0; A7 excluded because a
//                              pattern may be deleting a push above it,
//                              which would shift an A7-relative offset)
// Deliberately NOT whitelisted: AmDn sources (could read D1), AmPostInc/
// AmPreDec (mutate their base register), byte/word loads (upper bytes
// of D0 not defined), anything writing other registers.
func peepIsSimpleLoadToD0(i: int): bool {
    var it: A68Item

    it = a68Items[i]
    if it.kind != KindInstr { return false }
    if it.op != OpMove { return false }
    if it.size != 4 { return false }
    if it.dm != AmDn or it.dr != 0 { return false }
    if it.sm == AmImm { return true }
    if it.sm == AmDisp16 and it.sr != 7 { return true }
    return false
}

// peepPassPushPop -- pattern 1 (spec "Pattern set" #1):
//   MOVE.L D0,-(A7) / <simple load -> D0> / MOVE.L (A7)+,D1
//     ==>
//   MOVE.L D0,D1    / <same load>
// Left lands in D1 up front (preserving the D1=left/D0=right operator
// contract -- CMP.L D0,D1's direction depends on it), the load is
// untouched, the pop dies. The 14+12-cycle push/pop becomes a 4-cycle
// register move; 3 instructions -> 2. Only fires when the middle item
// is a whitelisted simple load (peepIsSimpleLoadToD0): those never read
// D1 and never touch A7, so the early D1 write and the deleted A7
// traffic are both invisible to it. peepNextReal only skips comments/
// dead items, so no barrier can hide inside the window.
func peepPassPushPop(startIdx: int): bool {
    var i: int
    var j: int
    var k: int
    var it: A68Item
    var didChange: bool

    didChange = false
    i = startIdx
    while i < a68Items.count {
        it = a68Items[i]
        if it.kind == KindInstr and it.op == OpMove and it.size == 4 and it.sm == AmDn and it.sr == 0 and it.dm == AmPreDec and it.dr == 7 {
            j = peepNextReal(i)
            if j != -1 and peepIsSimpleLoadToD0(j) {
                k = peepNextReal(j)
                if k != -1 {
                    if a68Items[k].kind == KindInstr and a68Items[k].op == OpMove and a68Items[k].size == 4 and a68Items[k].sm == AmPostInc and a68Items[k].sr == 7 and a68Items[k].dm == AmDn and a68Items[k].dr == 1 {
                        // rewrite i: MOVE.L D0,-(A7) -> MOVE.L D0,D1
                        it.dm = AmDn
                        it.dr = 1
                        it.dv = 0
                        a68Items[i] = it
                        peepKill(k)
                        didChange = true
                    }
                }
            }
        }
        i = i + 1
    }
    return didChange
}

// peepFullyDefinesD0: item i writes all 32 bits of D0 without reading
// D0 (or D1, or memory through A7). Whitelist: a simple load
// (peepIsSimpleLoadToD0) or CLR.L D0.
func peepFullyDefinesD0(i: int): bool {
    var it: A68Item

    if peepIsSimpleLoadToD0(i) { return true }
    it = a68Items[i]
    if it.kind != KindInstr { return false }
    if it.op == OpClr and it.size == 4 and it.dm == AmDn and it.dr == 0 { return true }
    return false
}

// peepPassShuffle -- pattern 2 (spec "Pattern set" #2), sub-shape 2a only.
// (2b -- delete a dead MOVE.L <safe-src>,D0 whose next real item fully
// redefines D0 -- was dropped, fix-round 1: peepIsSimpleLoadToD0(i) is
// true for every AmImm/AmDisp16 source, which is 2b's whole safe-src
// set minus AmDn, so any item matching 2b's guard also matches 2a's and
// takes THIS function's "if" branch; 2b's own arm was reachable only
// for an AmDn (register) source, and naive codegen never emits a dead
// MOVE.L Dn,D0 immediately followed by a full D0 redefine -- confirmed
// unreachable-by-construction against the whole testdata/cg68k corpus.
// peepFullyDefinesD0 stays; 2a still uses it.)
//
// 2a: <simple load -> D0> / MOVE.L D0,D1   [next real fully defines D0
//                                           without reading it]
//       ==>  <same load -> D1>
//     The load's own whitelist guarantees it reads neither D0 nor D1,
//     so redirecting its destination is safe; the dead-D0 requirement
//     (next real item is itself a whitelisted load-to-D0, or CLR.L D0)
//     guarantees nothing downstream wanted the loaded value in D0.
func peepPassShuffle(startIdx: int): bool {
    var i: int
    var j: int
    var k: int
    var it: A68Item
    var nx: A68Item
    var didChange: bool

    didChange = false
    i = startIdx
    while i < a68Items.count {
        it = a68Items[i]
        if peepIsSimpleLoadToD0(i) {
            j = peepNextReal(i)
            if j != -1 {
                nx = a68Items[j]
                if nx.kind == KindInstr and nx.op == OpMove and nx.size == 4 and nx.sm == AmDn and nx.sr == 0 and nx.dm == AmDn and nx.dr == 1 {
                    k = peepNextReal(j)
                    if k != -1 and peepFullyDefinesD0(k) {
                        it.dr = 1
                        a68Items[i] = it
                        peepKill(j)
                        didChange = true
                    }
                }
            }
        }
        i = i + 1
    }
    return didChange
}

// peepPassDeadClr -- pattern 4 (spec "Pattern set" #4): cgLoadVar's
// bool/char shape CLR.L D0 / MOVE.B <mem>,D0 followed by MOVE.B D0,<mem>
// (byte-width consumer) followed by an item that fully redefines D0
// (peepFullyDefinesD0, which includes the NEXT copy's own CLR.L D0)
// ==> the CLR.L dies: only the low byte was consumed, and the stale
// upper bytes are then overwritten before any read. All three follower
// checks are required -- if any is absent (barrier, other consumer),
// do not fire; the zero-extend may be live.
func peepPassDeadClr(startIdx: int): bool {
    var i: int
    var j: int
    var k: int
    var m: int
    var it: A68Item
    var didChange: bool

    didChange = false
    i = startIdx
    while i < a68Items.count {
        it = a68Items[i]
        if it.kind == KindInstr and it.op == OpClr and it.size == 4 and it.dm == AmDn and it.dr == 0 {
            j = peepNextReal(i)
            if j != -1 and a68Items[j].kind == KindInstr and a68Items[j].op == OpMove and a68Items[j].size == 1 and a68Items[j].dm == AmDn and a68Items[j].dr == 0 and a68Items[j].sm == AmDisp16 and a68Items[j].sr != 7 {
                k = peepNextReal(j)
                if k != -1 and a68Items[k].kind == KindInstr and a68Items[k].op == OpMove and a68Items[k].size == 1 and a68Items[k].sm == AmDn and a68Items[k].sr == 0 and a68Items[k].dm == AmDisp16 and a68Items[k].dr != 7 {
                    m = peepNextReal(k)
                    if m != -1 and peepFullyDefinesD0(m) {
                        peepKill(i)
                        didChange = true
                    }
                }
            }
        }
        i = i + 1
    }
    return didChange
}

// peepFunc: run all patterns over [startIdx..count) to fixpoint, then
// re-derive layout. Patterns are added per task; each returns true if
// it changed anything this sweep.
func peepFunc(startIdx: int) {
    var changed: bool
    var any: bool

    if peepDisabled {
        return
    }
    any = false
    changed = true
    while changed {
        changed = false
        if peepPassPushPop(startIdx) { changed = true }
        if peepPassShuffle(startIdx) { changed = true }
        if peepPassDeadClr(startIdx) { changed = true }
        // (further pattern calls land here in Task 8)
        if changed {
            any = true
        }
    }
    if any {
        a68Relayout(startIdx)
    }
}

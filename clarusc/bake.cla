    return sec
}

func bkWriteIrFuncIdxByName(): text {
    var sec: text
    var m: intmap of int
    var k: int
    var v: int

    m = irFuncIdxByName
    bkPutU32(sec, m.count)
    for k, v in m {
        bkPutU32(sec, k)
        bkPutU32(sec, v)
    }
    return sec
}


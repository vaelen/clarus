var bkLdIrColumnDescs: list of IRColumnDesc
var bkLdIrBindDescs: list of IRBindDesc
var bkLdIrWindowDescs: list of IRWindowDesc
var bkLdIrMenuItemDescs: list of IRMenuItemDesc
var bkLdIrMenuDescs: list of IRMenuDesc
var bkLdIrWinHandlers: list of IRWinHandlers
var bkLdIrWidgetHandlerEntries: list of IRWidgetHandlerEntry
var bkLdIrMenuHandlerEntries: list of IRMenuHandlerEntry
var bkLdIrEveryEntries: list of IREveryEntry
var bkLdIrStrLits: list of int
var bkLdIrExternNames: list of int
var bkLdIrExternRetTys: list of int
var bkLdIrExternParamStart: list of int
var bkLdIrExternParamCountArr: list of int
var bkLdIrExternParamTys: list of int
var bkLdIrExternTrapWords: list of int
var bkLdIrExternConvs: list of int
var bkLdIrExternSels: list of int
var bkLdIrExternParamRegs: list of int
var bkLdIrExternRetRegs: list of int
var bkLdIrLayoutNeededByName: intmap of int
var bkLdIrRcWalkNeededByName: intmap of int

var bkLdIrHasLaunch: bool
var bkLdIrHasStartEmpty: bool
var bkLdIrHasStartCLI: bool
var bkLdIrHasOpenDocument: bool
var bkLdIrAppName: int
var bkLdIrAppVersion: int
var bkLdIrAppAuthor: int
var bkLdIrAppAbout: int
var bkLdIrAppId: int

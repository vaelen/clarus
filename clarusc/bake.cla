// bkWriteIrScalars: the plain-scalar half of irReset() -- program flags,
// app-decl fields (always their zero/absent value for a pure runtime
// bake, since the runtime chain declares no `app` section), the menu/
// every chain heads, and the singleton IRType indices (irVoidT..irWordT),
// in irReset()'s own assignment order. The loader re-derives nothing
// here; these ARE the values a runtime-only lowerProgram produced.
func bkWriteIrScalars(): text {
    var sec: text

    bkPutBool(sec, irHasLaunch)
    bkPutBool(sec, irHasStartEmpty)
    bkPutBool(sec, irHasStartCLI)
    bkPutBool(sec, irHasOpenDocument)
    bkPutU32(sec, irAppName)
    bkPutU32(sec, irAppVersion)
    bkPutU32(sec, irAppAuthor)
    bkPutU32(sec, irAppAbout)
    bkPutU32(sec, irAppId)
    bkPutU32(sec, irAppDoctype)
    bkPutU32(sec, irAppStack)
    bkPutBool(sec, irHasApp)
    bkPutU32(sec, irMenuHandlersHead)
    bkPutU32(sec, irMenuHandlersTail)
    bkPutU32(sec, irMenuHandlerCount)
    bkPutU32(sec, irEveryHead)
    bkPutU32(sec, irEveryTail)
    bkPutU32(sec, irEveryCount)
    bkPutU32(sec, irVoidT)
    bkPutU32(sec, irIntT)
    bkPutU32(sec, irBoolT)
    bkPutU32(sec, irFixedT)
    bkPutU32(sec, irCharT)
    bkPutU32(sec, irTextT)
    bkPutU32(sec, irErrT)
    bkPutU32(sec, irPtrT)
    bkPutU32(sec, irWordT)
    return sec
}

// ================================================================
// Non-arena blocks
// ================================================================

// bkWriteStrPool: the intern pool (lib.cla's strPool), verbatim,
// length-prefixed per entry -- user parsing interns on top of this at
// load time (append-only, so baked indices never move).
func bkWriteStrPool(): text {
    var sec: text
    var i: int

    bkPutU32(sec, strPool.count)
    i = 0
    while i < strPool.count {
        bkPutStr(sec, strPool[i])
        i = i + 1
    }
    return sec
}

// bkWriteLowCounters: lowering's program-wide counters (lower.cla) --
// end values so user lowering continues numbering where the bake
// stopped, plus lowStrIdx (string-literal-by-VALUE dedup map) so a user
// literal identical to a runtime one reuses the same clar_lit_K slot.
// The ~162 lazy-intern iXxxIdx scalars, lowTitleIdx, and the always-
// empty progGen-namespaced maps (uiMenuIdx/uiMenuItemIdx/
// uiWinHandlersIdx/winVarDefaults*) are NOT here -- task-1-report.md
// section (b) is explicit that all of those are reset-on-load /
// irrelevant-while-empty, not bake state.
func bkWriteLowCounters(): text {
    var sec: text
    var m: map of int
    var k: string
    var v: int

    bkPutU32(sec, lowSwitchN)
    bkPutU32(sec, uiMenuCount)
    bkPutU32(sec, lowStoreTempN)
    bkPutU32(sec, lowRetTempN)
    m = lowStrIdx
    bkPutU32(sec, m.count)
    for k, v in m {
        bkPutStr(sec, k)
        bkPutU32(sec, v)
    }
    return sec
}

// bkWriteCheckerSymbols: the runtime's checker symbol state (types.cla/
// check.cla), used ONLY on the --testapi path (task-1-report.md section
// (b)) -- funcSigs, symbols, scopes, typeArena, enumMembers, each self-
// delimited by its own leading count, in that fixed order.
func bkWriteCheckerSymbols(): text {
    var sec: text
    var i: int
    var j: int
    var names: intmap of int
    var k: int
    var v: int

    bkPutU32(sec, funcSigs.count)
    i = 0
    while i < funcSigs.count {
        bkPutU32(sec, funcSigs[i].params.count)
        j = 0
        while j < funcSigs[i].params.count {
            bkPutU32(sec, funcSigs[i].params[j])
            j = j + 1
        }
        bkPutU32(sec, funcSigs[i].ret)
        i = i + 1
    }

    bkPutU32(sec, symbols.count)
    i = 0
    while i < symbols.count {
        bkPutU32(sec, symbols[i].nameIdx)
        bkPutU32(sec, symbols[i].typeIdx)
        bkPutBool(sec, symbols[i].isFunc)
        bkPutU32(sec, symbols[i].sigIdx)
        bkPutBool(sec, symbols[i].isType)
        bkPutBool(sec, symbols[i].isConst)
        bkPutBool(sec, symbols[i].isParam)
        bkPutBool(sec, symbols[i].constIsStr)
        bkPutU32(sec, symbols[i].constInt)
        bkPutU32(sec, symbols[i].constStrIdx)
        bkPutBool(sec, symbols[i].isMenu)
        bkPutBool(sec, symbols[i].isExtern)
        bkPutBool(sec, symbols[i].isCallback)
        i = i + 1
    }

    bkPutU32(sec, scopes.count)
    i = 0
    while i < scopes.count {
        bkPutU32(sec, scopes[i].parent)
        names = scopes[i].names
        bkPutU32(sec, names.count)
        for k, v in names {
            bkPutU32(sec, k)
            bkPutU32(sec, v)
        }
        i = i + 1
    }

    bkPutU32(sec, typeArena.count)
    i = 0
    while i < typeArena.count {
        bkPutU32(sec, int(typeArena[i].kind))
        bkPutU32(sec, typeArena[i].n)
        bkPutU32(sec, typeArena[i].elem)
        bkPutU32(sec, typeArena[i].nameIdx)
        i = i + 1
    }

    bkPutU32(sec, enumMembers.count)
    i = 0
    while i < enumMembers.count {
        bkPutU32(sec, enumMembers[i].nameIdx)
        bkPutU32(sec, enumMembers[i].value)
        bkPutU32(sec, enumMembers[i].labelIdx)
        i = i + 1
    }

    return sec
}

// bkWriteFieldInfo (format version 5, fallback-trigger-narrowing Task 2):
// check.cla's own record-field side tables, verbatim -- fieldInfos (the
// FieldInfo arena, index-linked via .next) then recFieldsHeadByName (the
// record-name -> fieldInfos-head map), each self-delimited by its own
// leading count, matching bkWriteCheckerSymbols' own field-order
// convention. See bkSecFieldInfo's own doc comment for why this exists.
func bkWriteFieldInfo(): text {
    var sec: text
    var i: int
    var k: int
    var v: int

    bkPutU32(sec, fieldInfos.count)
    i = 0
    while i < fieldInfos.count {
        bkPutU32(sec, fieldInfos[i].nameIdx)
        bkPutU32(sec, fieldInfos[i].typeIdx)
        bkPutU32(sec, fieldInfos[i].next)
        i = i + 1
    }

    bkPutU32(sec, recFieldsHeadByName.count)
    for k, v in recFieldsHeadByName {
        bkPutU32(sec, k)
        bkPutU32(sec, v)
    }

    return sec
}

// bkWriteDeclFileTab: lib.cla's declFileTab (decl-arena-index ->
// interned source-path index), verbatim -- the curPathIdx stamp table
// the brief's format block names, so a runtime-attributed diagnostic/
// panic at use time can still name the right runtime source file.
func bkWriteDeclFileTab(): text {
    var sec: text
    var i: int

    bkPutU32(sec, declFileTab.count)
    i = 0
    while i < declFileTab.count {
        bkPutU32(sec, declFileTab[i])
        i = i + 1
    }
    return sec
}

// bkWriteUitestBounds (format version 2, Task 5): the base/uitest IR-arena
// boundary counts bakeGenerateChain captured -- see bkSecUitestBounds' own
// doc comment.
func bkWriteUitestBounds(): text {
    var sec: text

    bkPutU32(sec, bkGenBaseIrFuncsCount)
    bkPutU32(sec, bkGenBaseIrStrLitsCount)
    return sec
}

// bkWriteCheckerVisibility (format version 3, Task 5 fix round 2): the
// testapi-visible checker-symbol boundary -- see bkSecCheckerVisibility's
// own doc comment.
func bkWriteCheckerVisibility(): text {
    var sec: text

    bkPutU32(sec, bkGenEarlyFuncSigsCount)
    bkPutU32(sec, bkGenEarlySymbolsCount)
    return sec
}

// bkWriteManifestHashes (format version 5, fallback-trigger-narrowing
// Task 2): the drift guard's per-manifest-path source hash + early-
// visibility flag, one entry per DISTINCT file bakeGenerateChain's own
// expand() calls touched -- walking asmHeads (0..count), not
// bakeModuleList, so nested includes (toolbox/files.cla via
// uidialogs.cla, etc.) get their own entry exactly like the eighteen
// top-level modules do, with no separate pass needed. Each file's own
// path comes from declFileTab[asmHeads[i]] (setDeclFile stamped every
// decl in that file with the same pathIdx during Phase A) -- the SAME
// disk-path identity bkComputeManifestPaths' own second loop already
// uses to build bkManifestPaths, so this map's keys match that map's
// keys one-for-one. Hashes the file straight off disk (bkHashText over
// file.readText's own bytes), not any live buffer -- this runs once, at
// --bake-ir time, not on any per-user-compile hot path (drive.cla's own
// collision branch reuses ITS OWN already-read bytes instead of
// re-reading -- see its own doc comment). Early-visible iff i is below
// bkGenEarlyVisibleAsmHeadsBoundary, mirroring bkGenEarlyFuncSigsCount/
// bkGenEarlySymbolsCount's own split exactly.
func bkWriteManifestHashes(): text {
    var sec: text
    var entries: text
    var count: int
    var i: int
    var p: string
    var src: text
    var seen: map of bool

    entries = ""
    count = 0
    i = 0
    while i < asmHeads.count {
        if asmHeads[i] != -1 {
            p = poolGet(getDeclFile(asmHeads[i]))
            if not seen.has(p) {
                seen[p] = true
                src = ""
                if file.readText(p, src) {
                    bkPutStrShort(entries, p)
                    bkPutU32(entries, bkHashText(src))
                    bkPutBool(entries, i < bkGenEarlyVisibleAsmHeadsBoundary)
                    count = count + 1
                }
            }
        }
        i = i + 1
    }

    sec = ""
    bkPutU32(sec, count)
    sec.append(entries)
    return sec
}

// bkCorruptObjCodeTestOnly (object-code-linker Task 2): set by main.cla's
// own undocumented `--bake-ir --corrupt-objcode-testonly` flag --
// bkWriteObjCode, when true, overwrites the FIRST call-kind hole's own
// reloc symbol with an impossibly large value, so internal/bake's
// corrupt-object-section refusal test gets a structurally-valid bake
// whose reloc symbol is genuinely out of range, with a genuinely correct
// body hash (computed over the real, corrupted body by the real
// bkHashText) -- never used outside that one test. See main.cla's own
// flag-parsing doc comment for why this exists instead of a Go-side
// byte patch.
var bkCorruptObjCodeTestOnly: bool

// bkWriteObjCode (format v6, object-code-linker Task 2): bkSecObjCode --
// per irFuncs-index function, its captured post-peephole byte runs
// interleaved with typed hole records (run[0],hole[0],...,hole[n-1],
// run[n], n+1 runs for n holes -- Task 1's own chosen capture
// representation; see cg68k.cla's own capture-globals doc comment,
// above cg68ProgramFork, for the hole kind/class/symbol encoding this
// mirrors field-for-field). Reads cg68k.cla's live cgObj* globals
// directly, the same "bake.cla's writer reads another module's live
// global verbatim" pattern bkWriteFieldInfo already uses for check.cla's
// fieldInfos -- valid here because bakeWriteFile calls this AFTER its
// own capture step (cgObjCaptureRuntime) has already run for lane 68k;
// lane c (or a 68k bake that somehow never captured -- defensive) writes
// count 0, since cgObjValid stays at its empty default otherwise.
func bkWriteObjCode(lane: int): text {
    var sec: text
    var count: int
    var i: int
    var k: int
    var h: CgObjHole
    var corruptedOne: bool
    var sym: int

    // Bound by irFuncs.count, not cgObjValid.count directly: cg68Measure/
    // cg68ProgramFork run AFTER cg68SynthCbGlue inside cgObjCaptureRuntime,
    // so cgObjValid was sized to a LARGER, transient irFuncs.count that
    // briefly included synthesized callback-glue trampolines --
    // cgObjCaptureRuntime restores irFuncs (and irFuncIdxByName) back to
    // its pre-synthesis size before returning, but leaves cgObjValid/
    // cgFuncSize-family at their larger capture-time size. Every
    // reference INTO a trampoline was already captured symbolically
    // (cgHoleCbGlueAddr, never a raw index into that dropped tail), so
    // truncating the OUTER per-function count here is enough -- see
    // cgObjRecordHole's own doc comment.
    count = 0
    if lane == bkLane68k {
        count = irFuncs.count
    }
    sec = ""
    bkPutU32(sec, count)
    i = 0
    while i < count {
        bkPutBool(sec, cgObjValid[i])
        if cgObjValid[i] {
            bkPutU32(sec, cgObjNHoles[i])
            k = 0
            while k <= cgObjNHoles[i] {
                bkPutBytes(sec, cgObjRuns[cgObjRunFirst[i] + k])
                if k < cgObjNHoles[i] {
                    h = cgObjHoles[cgObjHoleFirst[i] + k]
                    bkPutByte(sec, h.kind)
                    bkPutByte(sec, h.cls)
                    sym = h.sym
                    if bkCorruptObjCodeTestOnly and not corruptedOne and h.kind == cgHoleCall {
                        sym = 999999999
                        corruptedOne = true
                    }
                    bkPutU32(sec, sym)
                    bkPutByte(sec, h.op)
                    bkPutByte(sec, h.size)
                    bkPutByte(sec, h.sm)
                    bkPutByte(sec, h.sr)
                    bkPutU32(sec, h.sv)
                    bkPutByte(sec, h.dm)
                    bkPutByte(sec, h.dr)
                    bkPutU32(sec, h.dv)
                    bkPutBool(sec, h.srcSlot)
                }
                k = k + 1
            }
        }
        i = i + 1
    }
    return sec
}

// bkWriteObjMeta (format v6, object-code-linker Task 2): bkSecObjMeta --
// what cg68Measure computes for the runtime-only universe, captured for
// every irFuncs index by the SAME cgObjCaptureRuntime call
// bkWriteObjCode reads from (its own internal cg68ProgramFork call runs
// cg68Measure as its first step): per-function size/frame-size/pool-ref
// sets/UI-pool flags, plus the three once-per-artifact fixed-cost
// buckets and the five per-pool-entry size tables cgPackProgram needs so
// a future compile's own Measure pass can skip re-deriving them from a
// baked function at all (Task 3). Reads cg68k.cla's live globals
// directly; lane c writes count 0 plus zeroed fixed buckets/empty
// per-pool-entry tables (never meaningful on that lane).
func bkWriteObjMeta(lane: int): text {
    var sec: text
    var count: int
    var i: int
    var k: int
    var strLits: list of int

    // See bkWriteObjCode's own comment for why this is irFuncs.count,
    // not cgFuncSize.count directly.
    count = 0
    if lane == bkLane68k {
        count = irFuncs.count
    }
    sec = ""
    bkPutU32(sec, count)
    i = 0
    while i < count {
        bkPutU32(sec, cgFuncSize[i])
        bkPutU32(sec, cgFuncFrameSizes[i])
        // Amendment A2 (also load-bearing here, not just for the hole
        // table, bkWriteObjCode): cgReservePanicMsgs appends
        // cgListOobMsgIdx to the LIVE irStrLits AFTER bkSecIrStrLits was
        // already serialized (bakeWriteFile's own capture-runs-last
        // ordering), so it is not a valid index into the INSTALLED
        // irStrLits at compile time either -- a function needing the
        // panic message (nat_UiSFGetFile in the corpus) must not name it
        // here by its bake-time-only numeric index, same reasoning as
        // the reloc hole's own cgRelClsPanicMsg substitution. Silently
        // dropped rather than reloc'd: this list only drives
        // cgPackProgram's own per-segment pool NEED-set (which entries
        // to duplicate where), and the panic message is a fixed,
        // always-available runtime literal a future link pass can
        // simply always include, needing no per-function bookkeeping.
        strLits = driveFreshIntList()
        k = 0
        while k < cgFuncStrLits[i].count {
            if cgFuncStrLits[i][k] != cgListOobMsgIdx {
                strLits.add(cgFuncStrLits[i][k])
            }
            k = k + 1
        }
        bkPutU32(sec, strLits.count)
        k = 0
        while k < strLits.count {
            bkPutU32(sec, strLits[k])
            k = k + 1
        }
        bkPutU32(sec, cgFuncEnumTables[i].count)
        k = 0
        while k < cgFuncEnumTables[i].count {
            bkPutU32(sec, cgFuncEnumTables[i][k])
            k = k + 1
        }
        bkPutU32(sec, cgFuncSerdescs[i].count)
        k = 0
        while k < cgFuncSerdescs[i].count {
            bkPutU32(sec, cgFuncSerdescs[i][k])
            k = k + 1
        }
        bkPutBool(sec, cgFuncUsesUiBlob[i])
        bkPutBool(sec, cgFuncUsesUiEvents[i])
        i = i + 1
    }

    if lane == bkLane68k {
        bkPutU32(sec, cgSeg1ExtraSize)
        bkPutU32(sec, cgGlueBundleSize)
        bkPutU32(sec, cgPoolSize)
        bkPutU32(sec, cgStrLitSize.count)
        k = 0
        while k < cgStrLitSize.count {
            bkPutU32(sec, cgStrLitSize[k])
            k = k + 1
        }
        bkPutU32(sec, cgEnumTableSize.count)
        k = 0
        while k < cgEnumTableSize.count {
            bkPutU32(sec, cgEnumTableSize[k])
            k = k + 1
        }
        bkPutU32(sec, cgSerdescSize.count)
        k = 0
        while k < cgSerdescSize.count {
            bkPutU32(sec, cgSerdescSize[k])
            k = k + 1
        }
        bkPutU32(sec, cgUiBlobSize)
        bkPutU32(sec, cgUiEventsSize)
    } else {
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
    }
    return sec
}

// ================================================================
// Top-level orchestrator
// ================================================================

// bakeWriteFile runs the generator (bakeGenerateChain) for lane, then
// serializes every section into outPath in the brief's format (format
// v4, final-review fix wave -- added bodyHash):
//   magic(4) formatVersion(4) laneTag(1) stampLen(2) stamp bodyHash(4)
//   moduleCount(2) [keyLen(1) key]... sectionCount(2) [id(2) len(4) payload]...
// bodyHash (bkHashTextFrom) covers everything from moduleCount onward --
// the whole "body" -- built into its own buffer first so the hash can be
// computed before the header (which embeds it) is ever written; see
// bkCheckRtbakeHeader for the read-side verification this exists for.
// Returns false on a checker/lowering diagnostic (diags stays populated
// for the caller to print, exactly as driveCompile's own contract) or a
// write failure (logged directly, same as emitMode's own write-failure
// path in main.cla).
func bakeWriteFile(lane: int, outPath: string): bool {
    var out: text
    var body: text
    var mods: list of string
    var stamp: text
    var compilerSrc: text
    var i: int
    var bodyHash: int

    if not bakeGenerateChain(lane) {
        return false
    }

    mods = bakeModuleList(lane)

    body = ""
    bkPutU16(body, mods.count)
    i = 0
    while i < mods.count {
        bkPutStrShort(body, rtModuleKey(mods[i]))
        i = i + 1
    }

    bkPutU16(body, bkSectionCount)
    bkEmitSection(body, bkSecIrTypes, bkWriteIrTypes())
    bkEmitSection(body, bkSecIrStmts, bkWriteIrStmts())
    bkEmitSection(body, bkSecIrExprs, bkWriteIrExprs())
    bkEmitSection(body, bkSecIrLocals, bkWriteIrLocals())
    bkEmitSection(body, bkSecIrFuncs, bkWriteIrFuncs())
    bkEmitSection(body, bkSecIrFuncIdxByName, bkWriteIrFuncIdxByName())
    bkEmitSection(body, bkSecIrCbGlueNames, bkWriteIrCbGlueNames())
    bkEmitSection(body, bkSecIrGlobals, bkWriteIrGlobals())
    bkEmitSection(body, bkSecIrFieldSlots, bkWriteIrFieldSlots())
    bkEmitSection(body, bkSecIrRecords, bkWriteIrRecords())
    bkEmitSection(body, bkSecIrEnumMembers, bkWriteIrEnumMembers())
    bkEmitSection(body, bkSecIrEnums, bkWriteIrEnums())
    bkEmitSection(body, bkSecIrWidgetDescs, bkWriteIrWidgetDescs())
    bkEmitSection(body, bkSecIrColumnDescs, bkWriteIrColumnDescs())
    bkEmitSection(body, bkSecIrBindDescs, bkWriteIrBindDescs())
    bkEmitSection(body, bkSecIrWindowDescs, bkWriteIrWindowDescs())
    bkEmitSection(body, bkSecIrMenuItemDescs, bkWriteIrMenuItemDescs())
    bkEmitSection(body, bkSecIrMenuDescs, bkWriteIrMenuDescs())
    bkEmitSection(body, bkSecIrWinHandlers, bkWriteIrWinHandlers())
    bkEmitSection(body, bkSecIrWidgetHandlerEntries, bkWriteIrWidgetHandlerEntries())
    bkEmitSection(body, bkSecIrMenuHandlerEntries, bkWriteIrMenuHandlerEntries())
    bkEmitSection(body, bkSecIrEveryEntries, bkWriteIrEveryEntries())
    bkEmitSection(body, bkSecIrStrLits, bkWriteIrStrLits())
    bkEmitSection(body, bkSecIrExternNames, bkWriteIntList(irExternNames))
    bkEmitSection(body, bkSecIrExternRetTys, bkWriteIntList(irExternRetTys))
    bkEmitSection(body, bkSecIrExternParamStart, bkWriteIntList(irExternParamStart))
    bkEmitSection(body, bkSecIrExternParamCountArr, bkWriteIntList(irExternParamCountArr))
    bkEmitSection(body, bkSecIrExternParamTys, bkWriteIntList(irExternParamTys))
    bkEmitSection(body, bkSecIrExternTrapWords, bkWriteIntList(irExternTrapWords))
    bkEmitSection(body, bkSecIrExternConvs, bkWriteIntList(irExternConvs))
    bkEmitSection(body, bkSecIrExternSels, bkWriteIntList(irExternSels))
    bkEmitSection(body, bkSecIrExternParamRegs, bkWriteIntList(irExternParamRegs))
    bkEmitSection(body, bkSecIrExternRetRegs, bkWriteIntList(irExternRetRegs))
    bkEmitSection(body, bkSecIrLayoutNeededByName, bkWriteIrLayoutNeededByName())
    bkEmitSection(body, bkSecIrRcWalkNeededByName, bkWriteIrRcWalkNeededByName())
    bkEmitSection(body, bkSecIrScalars, bkWriteIrScalars())
    bkEmitSection(body, bkSecStrPool, bkWriteStrPool())
    bkEmitSection(body, bkSecLowCounters, bkWriteLowCounters())
    bkEmitSection(body, bkSecCheckerSymbols, bkWriteCheckerSymbols())
    bkEmitSection(body, bkSecFieldInfo, bkWriteFieldInfo())
    bkEmitSection(body, bkSecDeclFileTab, bkWriteDeclFileTab())
    bkEmitSection(body, bkSecUitestBounds, bkWriteUitestBounds())
    bkEmitSection(body, bkSecCheckerVisibility, bkWriteCheckerVisibility())
    bkEmitSection(body, bkSecManifestHashes, bkWriteManifestHashes())

    // object-code-linker Task 2: bake-time object capture runs HERE,
    // after every OTHER section has already been copied into `body` as
    // fixed bytes -- not any earlier. cg68Measure (run internally by
    // cgObjCaptureRuntime's own cg68ProgramFork call) calls
    // cgReservePanicMsgs, which unconditionally APPENDS a synthesized
    // string literal to the LIVE irStrLits global (Amendment A2's own
    // root cause), and codegen internals intern() their own strings into
    // the shared pool besides (cg68SynthCbGlue's own "clar_cb_<name>"
    // glue names, notably -- see cgObjCaptureRuntime's own doc comment
    // for why that call is unavoidable). None of that may leak into
    // bkSecIrStrLits/bkSecStrPool/bkSecIrFuncs, which is exactly what
    // placing the capture call after those sections' own bkEmitSection
    // calls (all of them, above) guarantees for free: the bytes are
    // already frozen into `body` by the time any of this runs.
    if lane == bkLane68k {
        if not cgObjCaptureRuntime() {
            log("clarusc --bake-ir: object-code capture failed")
            return false
        }
    }
    bkEmitSection(body, bkSecObjCode, bkWriteObjCode(lane))
    bkEmitSection(body, bkSecObjMeta, bkWriteObjMeta(lane))

    bodyHash = bkHashText(body)

    out = ""
    out.append(bkMagic)
    bkPutU32(out, bkFormatVersion)
    bkPutByte(out, lane)

    compilerSrc = ""
    stamp = ""
    if bkFindClarusC(compilerSrc) {
        bkLastStamp = bkHashText(compilerSrc)
    } else {
        // clarusc/clarusc.c unreachable from the working directory (an
        // unusual invocation location) -- an all-zero stamp still keeps
        // the bake deterministic (bake-twice-identical) and the loader's
        // mismatch-refusal (Task 4) errs safe either way: a real
        // clarusc.c-hash stamp will never legitimately be zero.
        bkLastStamp = 0
    }
    bkPutU32(stamp, bkLastStamp)
    bkPutU16(out, stamp.length)
    out.append(stamp)

    bkPutU32(out, bodyHash)

    out.append(body)

    if not file.writeText(outPath, out, fileTypeData, "????") {
        log("clarusc --bake-ir: cannot write " + outPath + ": " + lastError.message)
        return false
    }
    return true
}

// ================================================================
// Loader: `--rtbake FILE` on the host emit/emit68k paths (runtime-ir-bake
// Task 4). Mirrors the writer above section-for-section, field-for-field,
// in the same fixed order bakeWriteFile emits them -- consuming exactly
// what bkWrite* produced. Two-stage install, matching drive.cla's own
// pipeline order (load+verify stamp -> [check user] -> install -> lower
// user):
//   1. bkLoadRtbake parses the WHOLE file (header + every section) into
//      the bkLd*/bkLoaded* pending globals below, touching no live
//      compiler state at all.
//   2. bkInstallPool copies the intern pool into live strPool/strIndex --
//      called BEFORE Phase A (driveCompile), since every baked IR
//      arena's string-index fields are ABSOLUTE strPool indices captured
//      at bake time; nothing else may intern() before this runs.
//   3. bkInstallArenas copies everything else (the IR arenas, the
//      lowering counters) into live state -- called AFTER check#1
//      (driveCompile), so a bake's retained-but-uninstalled checker-
//      symbol/declFileTab state (Task 5's own job -- see below) can
//      never influence check#1's diagnostics for user code.
// ================================================================

// bkLoadBuf/bkLoadPos: the read cursor. A module-level pair, not a
// scalar out-param (Ch3: user functions cannot fill one) -- the read
// counterpart of bkPutByte's own `out: text` in-place-mutation idiom.
var bkLoadBuf: text
var bkLoadPos: int

// bkLoadOverrun (final-review fix wave): set true the first time
// bkGetByte is asked to read past bkLoadBuf's end, instead of indexing
// out of range (an uncatchable runtime error, per Chapter 3 -- "raises a
// runtime error" -- straight out of a hand-crafted or bit-flipped bake).
// Defense in depth for the narrow window before bkCheckRtbakeHeader's
// own body-hash check runs (or if the hash field itself were truncated,
// which the header's own length check already rules out) -- the hash
// check is expected to catch every ordinary corruption/truncation case
// first. Checked, and refused loudly, at the end of a full parse
// (bkLoadSections); reset at the start of every bkCheckRtbakeHeader call
// so repeated compiles in one process (macgui.cla) don't carry a stale
// flag forward.
var bkLoadOverrun: bool

// bkHeaderVerified (clir-load-perf Task 1, design A): set by a front
// end (macgui's gcResolveBakePath) immediately after ITS successful
// bkCheckRtbakeHeader on the exact buffer it then hands to
// driveCompile as rtbakeBytes -- bkLoadRtbake consumes it (read +
// reset) to skip re-hashing ~1.3MB it verified seconds earlier.
// Consume-once: never survives past one bkLoadRtbake call, so a stale
// value can never bless a different buffer. Host front ends never set
// it, so the host's single verify (inside bkLoadRtbake) is unchanged.
var bkHeaderVerified: bool

// bkParsedValid (clir-load-perf Task 7, design B): true iff the bkLd*/
// bkLoaded* pending state below holds a COMPLETE, PRISTINE parse of
// this session's bake -- i.e. drive.cla may install from it without
// re-parsing the bytes. Deliberately NOT reset by driveReset(): surviving
// across compiles is its entire purpose (ClarusC.APPL re-compiles in one
// process and the CLIR resource cannot change under it). Reset on parse
// failure and by the manifest-drift from-source fallback (drive.cla),
// the two paths where the pending state must not be trusted again.
//
// What makes the memo safe is copy-on-install: every bkInstall* function
// below now COPIES the pending containers into the live compiler globals
// instead of aliasing them (Task 6's audit table -- 43 rows), so a
// compile's own appends/element-mutations/.clear()s can never reach the
// pending parse this flag blesses.
var bkParsedValid: bool

func bkGetByte(): int {
    var b: int
    if bkLoadPos >= bkLoadBuf.length {
        bkLoadOverrun = true
        return 0
    }
    b = int(bkLoadBuf[bkLoadPos])
    bkLoadPos = bkLoadPos + 1
    return b
}

func bkGetU16(): int {
    var b0: int
    var b1: int
    b0 = bkGetByte()
    b1 = bkGetByte()
    return (b0 << 8) | b1
}

// bkGetU32 (clir-load-perf Task 5, design C): one bulk t.u32At call
// behind a soft pre-check, instead of four bkGetByte calls -- the
// pre-check (`bkLoadPos + 4 > bkLoadBuf.length`) is the exact STRICT
// bound u32At itself re-checks (`pos < 0 or pos > rt.len - 4`, text.cla),
// so u32At's own panic is never reachable from here: bkLoadPos is never
// negative (every advance is by a non-negative amount from 0), so the
// only way to fail u32At's bound is the same overrun this pre-check
// already catches.
func bkGetU32(): int {
    var v: int
    if bkLoadPos + 4 > bkLoadBuf.length {
        bkLoadOverrun = true
        bkLoadPos = bkLoadBuf.length
        return 0
    }
    v = bkLoadBuf.u32At(bkLoadPos)
    bkLoadPos = bkLoadPos + 4
    return v
}

func bkGetBool(): bool {
    return bkGetByte() != 0
}

// bkGetStr/bkGetStrShort mirror bkPutStr/bkPutStrShort's own two length-
// prefix conventions (4-byte BE for pool strings, 1-byte for the
// header's module keys) -- every string this format carries (pool
// entries, module keys) is well under the string type's own 255-byte cap
// by construction (the writer could never have produced a longer one --
// see bake.cla's own header doc comment).
//
// clir-load-perf Task 5 (design C): one bulk t.stringAt call behind two
// soft pre-checks, instead of a per-byte bkGetByte loop through a
// char[255] buffer. Pre-check 1 (4 bytes for the length prefix) makes
// the u32At read below panic-unreachable, same argument as bkGetU32's
// own rewrite. Pre-check 2 mirrors BOTH of stringAt's own STRICT bounds
// (text.cla's rtTextStringAt): `n <= 255` (its "string too long" panic)
// and `bkLoadPos + 4 + n <= bkLoadBuf.length` (its "text index out of
// range" panic on the payload) -- once both hold, stringAt's own
// re-read of the length prefix is redundant work (one extra u32At is
// nothing) but never a reachable panic. The `n > 255` refusal is NEW
// defensive behavior for a corrupt bake: the old char[255] loop just
// copied `n` bytes with no cap, so a hand-crafted length > 255 would
// have overrun the stack buffer; here it soft-refuses instead.
func bkGetStr(): string {
    var n: int
    var s: string

    if bkLoadPos + 4 > bkLoadBuf.length {
        bkLoadOverrun = true
        bkLoadPos = bkLoadBuf.length
        return ""
    }
    n = bkLoadBuf.u32At(bkLoadPos)
    if n < 0 or n > 255 or bkLoadPos + 4 + n > bkLoadBuf.length {
        bkLoadOverrun = true
        bkLoadPos = bkLoadBuf.length
        return ""
    }
    s = bkLoadBuf.stringAt(bkLoadPos)
    bkLoadPos = bkLoadPos + 4 + n
    return s
}

// bkGetBytes (object-code-linker Task 2) mirrors bkPutBytes: a 4-byte BE
// length followed by that many raw bytes.
//
// clir-load-perf Task 5 (design C): one bulk t.textAt call behind two
// soft pre-checks, instead of a per-byte bkGetByte + append loop. Same
// shape as bkGetStr's own rewrite above: pre-check 1 (4 bytes for the
// length prefix) makes the u32At read panic-unreachable; pre-check 2
// mirrors textAt's own STRICT bounds (rtTextTextAt, text.cla: `n < 0` and
// `pos > rt.len - n`) -- checked as `n > bkLoadBuf.length - bkLoadPos - 4`
// rather than the addition form `bkLoadPos + 4 + n > bkLoadBuf.length`:
// CLAR_ADD32 wraps, so a huge n (e.g. a corrupt length field near
// 0x7FFFFFFx) can make that sum overflow back under length and pass the
// guard, reaching textAt's STRICT panic. The subtraction form's RHS is
// never negative here (pre-check 1 already established
// `bkLoadPos + 4 <= bkLoadBuf.length`), so it can't wrap the same way.
// `n < 0` is still checked explicitly, since a huge negative n would
// otherwise satisfy the subtraction check while still failing textAt's
// own `n < 0` bound. Overrun/refusal returns "" (empty text), matching
// the current empty-start behavior.
func bkGetBytes(): text {
    var n: int
    var t: text

    if bkLoadPos + 4 > bkLoadBuf.length {
        bkLoadOverrun = true
        bkLoadPos = bkLoadBuf.length
        return ""
    }
    n = bkLoadBuf.u32At(bkLoadPos)
    if n < 0 or n > bkLoadBuf.length - bkLoadPos - 4 {
        bkLoadOverrun = true
        bkLoadPos = bkLoadBuf.length
        return ""
    }
    t = bkLoadBuf.textAt(bkLoadPos + 4, n)
    bkLoadPos = bkLoadPos + 4 + n
    return t
}

func bkGetStrShort(): string {
    var n: int
    var buf: char[255]
    var i: int
    var s: string

    n = bkGetByte()
    i = 0
    while i < n {
        buf[i] = char(bkGetByte())
        i = i + 1
    }
    s.fromBytes(buf, n)
    return s
}

// bkReadIntList/bkReadIntIntMap: shared bodies for every plain `list of
// int` / `intmap of int` section (bkWriteIntList's own read-side twin,
// generalized to cover irCbGlueNames/irStrLits/declFileTab too, all the
// same shape).
func bkReadIntList(): list of int {
    var n: int
    var i: int
    var l: list of int

    n = bkGetU32()
    i = 0
    while i < n {
        l.add(bkGetU32())
        i = i + 1
    }
    return l
}

func bkReadIntIntMap(): intmap of int {
    var n: int
    var i: int
    var k: int
    var v: int
    var m: intmap of int

    n = bkGetU32()
    i = 0
    while i < n {
        k = bkGetU32()
        v = bkGetU32()
        m[k] = v
        i = i + 1
    }
    return m
}

func bkLaneName(lane: int): string {
    if lane == bkLane68k {
        return "68k"
    }
    return "c"
}

// ---- Pending state (parsed by bkLoadRtbake, consumed by bkInstall*) ----

var bkLdIrTypes: list of IRType
var bkLdIrStmts: list of IRStmt
var bkLdIrExprs: list of IRExpr
var bkLdIrLocals: list of IRLocal
var bkLdIrFuncs: list of IRFunc
var bkLdIrFuncIdxByName: intmap of int
var bkLdIrCbGlueNames: list of int
var bkLdIrGlobals: list of IRGlobal
var bkLdIrFieldSlots: list of IRFieldSlot
var bkLdIrRecords: list of IRRecordLayout
var bkLdIrEnumMembers: list of IREnumMember
var bkLdIrEnums: list of IREnumLayout

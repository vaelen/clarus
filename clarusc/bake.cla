func bkReadCheckerSymbols() {
    var n: int
    var i: int
    var j: int
    var pn: int
    var sig: FuncSig
    var params: list of int
    var lFuncSigs: list of FuncSig
    var sym: Symbol
    var lSymbols: list of Symbol
    var scope: Scope
    var lScopes: list of Scope
    var ti: TypeInfo
    var lTypeArena: list of TypeInfo
    var em: EnumMemberInfo
    var lEnumMembers: list of EnumMemberInfo

    n = bkGetU32()
    i = 0
    while i < n {
        pn = bkGetU32()
        params = driveFreshIntList()
        j = 0
        while j < pn {
            params.add(bkGetU32())
            j = j + 1
        }
        sig.params = params
        sig.ret = bkGetU32()
        lFuncSigs.add(sig)
        i = i + 1
    }
    bkLoadedFuncSigs = lFuncSigs

    n = bkGetU32()
    i = 0
    while i < n {
        sym.nameIdx = bkGetU32()
        sym.typeIdx = bkGetU32()
        sym.isFunc = bkGetBool()
        sym.sigIdx = bkGetU32()
        sym.isType = bkGetBool()
        sym.isConst = bkGetBool()
        sym.isParam = bkGetBool()
        sym.constIsStr = bkGetBool()
        sym.constInt = bkGetU32()
        sym.constStrIdx = bkGetU32()
        sym.isMenu = bkGetBool()
        sym.isExtern = bkGetBool()
        sym.isCallback = bkGetBool()
        lSymbols.add(sym)
        i = i + 1
    }
    bkLoadedSymbols = lSymbols

    n = bkGetU32()
    i = 0
    while i < n {
        scope.parent = bkGetU32()
        scope.names = bkReadIntIntMap()
        lScopes.add(scope)
        i = i + 1
    }
    bkLoadedScopes = lScopes

    n = bkGetU32()
    i = 0
    while i < n {
        ti.kind = TypeKind(bkGetU32())
        ti.n = bkGetU32()
        ti.elem = bkGetU32()
        ti.nameIdx = bkGetU32()
        lTypeArena.add(ti)
        i = i + 1
    }
    bkLoadedTypeArena = lTypeArena

    n = bkGetU32()
    i = 0
    while i < n {
        em.nameIdx = bkGetU32()
        em.value = bkGetU32()
        em.labelIdx = bkGetU32()
        lEnumMembers.add(em)
        i = i + 1
    }
    bkLoadedEnumMembers = lEnumMembers
}


// bkWriteIntList: shared body for the ten parallel extern arenas
// (irExternNames.. irExternRetRegs), each a plain `list of int` -- one
// section per arena (task-1-report.md's inventory rows 24-33), same
// count-then-elements shape as irStrLits/irCbGlueNames.
// bkWriteIrArrLits (format version 8, language-runtime-cleanup spec
// %4.4): count, then per literal its element IR-TYPE index (a bkSecIrTypes
// arena index, installed verbatim by bkInstallArenas so it stays valid at
// load time), its element count, and its values.
func bkWriteIrArrLits(): text {
    var sec: text
    var i: int
    var j: int

    bkPutU32(sec, irArrLitCount())
    i = 0
    while i < irArrLitCount() {
        bkPutU32(sec, irArrLitElemT[i])
        bkPutU32(sec, irArrLitN[i])
        j = 0
        while j < irArrLitN[i] {
            bkPutU32(sec, irArrLitVal(i, j))
            j = j + 1
        }
        i = i + 1
    }
    return sec
}

func bkWriteIntList(l: list of int): text {
    var sec: text
    var i: int

    bkPutU32(sec, l.count)
    i = 0
    while i < l.count {
        bkPutU32(sec, l[i])
        i = i + 1
    }
    return sec
}


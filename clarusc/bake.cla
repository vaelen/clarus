// bkReadStrPool decodes the pool section straight into lib.cla's
// blob-plus-offsets shape (bkLdStrBlob/bkLdStrOff, sentinel included);
// bkInstallPool moves both into strBlob/strOff.
func bkReadStrPool() {
    var n: int
    var i: int
    var s: string
    var b: text
    var o: list of int

    n = bkGetU32()
    o.reserve(bkFitCount(n + 1))
    o.add(0)
    i = 0
    while i < n {
        s = bkGetStr()
        b.append(char(s.length))
        b.append(s)
        o.add(b.length)
        i = i + 1
    }
    bkLdStrBlob = b
    bkLdStrOff = o
}


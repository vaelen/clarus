// bkLoaded* (checker symbols + declFileTab): parsed and RETAINED, but
// deliberately never installed into live check.cla/types.cla/lib.cla
// state by this task -- see bkLoadRtbake's own doc comment and this
// task's report (open question (b)). Shape: a straight field-for-field
// mirror of the live types (FuncSig/Symbol/Scope/TypeInfo/
// EnumMemberInfo, types.cla; a plain decl-arena-index -> interned-path-
// index list, lib.cla's own declFileTab shape) -- exactly what a future
// Task 5 needs to wire `--testapi` symbol visibility / runtime-
// attributed diagnostics without re-deriving anything.
var bkLoadedFuncSigs: list of FuncSig
var bkLoadedSymbols: list of Symbol

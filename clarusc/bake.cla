// bkLoaded* (checker symbols + declFileTab): parsed and RETAINED, but
// deliberately never installed into live check.cla/types.cla/lib.cla
// state by this task -- see bkLoadRtbake's own doc comment and this
// task's report (open question (b)). Shape: a straight field-for-field
// mirror of the live types (FuncSig/Symbol/Scope/TypeInfo/
// EnumMemberInfo, types.cla; a plain decl-arena-index -> interned-path-
// index list, lib.cla's own declFileTab shape) -- exactly what a future
// Task 5 needs to wire `--testapi` symbol visibility / runtime-
// attributed diagnostics without re-deriving anything.
var bkLoadedFuncSigs: list of FuncSig
var bkLoadedSymbols: list of Symbol
var bkLoadedScopes: list of Scope
var bkLoadedTypeArena: list of TypeInfo
var bkLoadedEnumMembers: list of EnumMemberInfo
var bkLoadedDeclFileTab: list of int

// bkLdBaseIrFuncsCount/bkLdBaseIrStrLitsCount (format version 2, Task 5):
// the base/uitest IR-arena boundary bkInstallArenas truncates a non-
// testapi install back to -- see bkSecUitestBounds' own doc comment.
var bkLdBaseIrFuncsCount: int
var bkLdBaseIrStrLitsCount: int

// bkLoadedModules (Task 5, deliverable (b)): the bake header's own
// module-key manifest, retained rather than discarded (Task 4's own
// report flagged this as a "reads then discards" gap) -- one
// "runtime/clarus/NAME" key per baked runtime module, in bakeModuleList's
// own order. bkComputeManifestPaths turns this into the disk-path
// identity set expand() dedups a user `include` against.
var bkLoadedModules: list of string

// bkManifestPaths: the CURRENT bake's module disk-path identity set
// (bkComputeManifestPaths' own output), checked by drive.cla's expand()
// -- gated on haveRtbake there, so it is a no-op (empty map, never
// consulted) for every non-bake compile.
var bkManifestPaths: map of bool

// bkManifestHoistHit: set true by expand() the moment a user include
// collides with bkManifestPaths -- driveCompile checks this right after
// Phase A and falls back to a full from-source recompile when it fires
// (deliverable (b)'s "hoisting case"). Reset false before every bake-path
// Phase A run (driveCompile).
var bkManifestHoistHit: bool

// ---- Section readers -- mirror bkWrite* field-for-field ----

func bkReadIrTypes(): list of IRType {
    var n: int
    var i: int
    var e: IRType
    var l: list of IRType

    n = bkGetU32()
    i = 0
    while i < n {
        e.k = IRKind(bkGetU32())
        e.n = bkGetU32()
        e.elem = bkGetU32()
        e.name = bkGetU32()
        l.add(e)
        i = i + 1
    }
    return l
}


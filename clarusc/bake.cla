        bkPutU32(sec, irMenuHandlerEntries[i].menuNameIdx)
        bkPutU32(sec, irMenuHandlerEntries[i].itemNameIdx)
        bkPutU32(sec, irMenuHandlerEntries[i].menuIdx)
        bkPutU32(sec, irMenuHandlerEntries[i].itemIdx)
        bkPutU32(sec, irMenuHandlerEntries[i].funcNameIdx)
        bkPutU32(sec, irMenuHandlerEntries[i].scopeWinTypeNameIdx)
        bkPutU32(sec, irMenuHandlerEntries[i].next)
        i = i + 1
    }
    return sec
}

func bkWriteIrEveryEntries(): text {
    var sec: text
    var i: int

    bkPutU32(sec, irEveryEntries.count)
    i = 0
    while i < irEveryEntries.count {
        bkPutU32(sec, irEveryEntries[i].funcNameIdx)
        bkPutU32(sec, irEveryEntries[i].ticks)
        bkPutU32(sec, irEveryEntries[i].next)
        i = i + 1
    }
    return sec
}

func bkWriteIrStrLits(): text {
    var sec: text
    var i: int

    bkPutU32(sec, irStrLits.count)
    i = 0
    while i < irStrLits.count {
        bkPutU32(sec, irStrLits[i])
        i = i + 1
    }
    return sec
}

// bkWriteIntList: shared body for the ten parallel extern arenas
// (irExternNames.. irExternRetRegs), each a plain `list of int` -- one
// section per arena (task-1-report.md's inventory rows 24-33), same
// count-then-elements shape as irStrLits/irCbGlueNames.
func bkWriteIntList(l: list of int): text {
    var sec: text
    var i: int

    bkPutU32(sec, l.count)
    i = 0
    while i < l.count {
        bkPutU32(sec, l[i])
        i = i + 1
    }
    return sec
}

func bkWriteIrLayoutNeededByName(): text {
    var sec: text
    var m: intmap of int
    var k: int
    var v: int

    m = irLayoutNeededByName
    bkPutU32(sec, m.count)
    for k, v in m {
        bkPutU32(sec, k)
        bkPutU32(sec, v)
    }
    return sec
}

func bkWriteIrRcWalkNeededByName(): text {
    var sec: text
    var m: intmap of int
    var k: int
    var v: int

    m = irRcWalkNeededByName
    bkPutU32(sec, m.count)
    for k, v in m {
        bkPutU32(sec, k)
        bkPutU32(sec, v)
    }
    return sec
}

// bkWriteIrScalars: the plain-scalar half of irReset() -- program flags,
// app-decl fields (always their zero/absent value for a pure runtime
// bake, since the runtime chain declares no `app` section), the menu/
// every chain heads, and the singleton IRType indices (irVoidT..irWordT),
// in irReset()'s own assignment order. The loader re-derives nothing
// here; these ARE the values a runtime-only lowerProgram produced.
func bkWriteIrScalars(): text {
    var sec: text

    bkPutBool(sec, irHasLaunch)
    bkPutBool(sec, irHasStartEmpty)
    bkPutBool(sec, irHasStartCLI)
    bkPutBool(sec, irHasOpenDocument)
    bkPutU32(sec, irAppName)
    bkPutU32(sec, irAppVersion)
    bkPutU32(sec, irAppAuthor)
    bkPutU32(sec, irAppAbout)
    bkPutU32(sec, irAppId)
    bkPutU32(sec, irAppDoctype)
    bkPutU32(sec, irAppStack)
    bkPutBool(sec, irHasApp)
    bkPutU32(sec, irMenuHandlersHead)
    bkPutU32(sec, irMenuHandlersTail)
    bkPutU32(sec, irMenuHandlerCount)
    bkPutU32(sec, irEveryHead)
    bkPutU32(sec, irEveryTail)
    bkPutU32(sec, irEveryCount)
    bkPutU32(sec, irVoidT)
    bkPutU32(sec, irIntT)
    bkPutU32(sec, irBoolT)
    bkPutU32(sec, irFixedT)
    bkPutU32(sec, irCharT)
    bkPutU32(sec, irTextT)
    bkPutU32(sec, irErrT)
    bkPutU32(sec, irPtrT)
    bkPutU32(sec, irWordT)
    return sec
}

// ================================================================
// Non-arena blocks
// ================================================================

// bkWriteStrPool: the intern pool (lib.cla's strPool), verbatim,
// length-prefixed per entry -- user parsing interns on top of this at
// load time (append-only, so baked indices never move).
func bkWriteStrPool(): text {
    var sec: text
    var i: int

    bkPutU32(sec, strPool.count)
    i = 0
    while i < strPool.count {
        bkPutStr(sec, strPool[i])
        i = i + 1
    }
    return sec
}

// bkWriteLowCounters: lowering's program-wide counters (lower.cla) --
// end values so user lowering continues numbering where the bake
// stopped, plus lowStrIdx (string-literal-by-VALUE dedup map) so a user
// literal identical to a runtime one reuses the same clar_lit_K slot.
// The ~162 lazy-intern iXxxIdx scalars, lowTitleIdx, and the always-
// empty progGen-namespaced maps (uiMenuIdx/uiMenuItemIdx/
// uiWinHandlersIdx/winVarDefaults*) are NOT here -- task-1-report.md
// section (b) is explicit that all of those are reset-on-load /
// irrelevant-while-empty, not bake state.
func bkWriteLowCounters(): text {
    var sec: text
    var m: map of int
    var k: string
    var v: int

    bkPutU32(sec, lowSwitchN)
    bkPutU32(sec, uiMenuCount)
    bkPutU32(sec, lowStoreTempN)
    bkPutU32(sec, lowRetTempN)
    m = lowStrIdx
    bkPutU32(sec, m.count)
    for k, v in m {
        bkPutStr(sec, k)
        bkPutU32(sec, v)
    }
    return sec
}

// bkWriteCheckerSymbols: the runtime's checker symbol state (types.cla/
// check.cla), used ONLY on the --testapi path (task-1-report.md section
// (b)) -- funcSigs, symbols, scopes, typeArena, enumMembers, each self-
// delimited by its own leading count, in that fixed order.
func bkWriteCheckerSymbols(): text {
    var sec: text
    var i: int
    var j: int
    var names: intmap of int
    var k: int
    var v: int

    bkPutU32(sec, funcSigs.count)
    i = 0
    while i < funcSigs.count {
        bkPutU32(sec, funcSigs[i].params.count)
        j = 0
        while j < funcSigs[i].params.count {
            bkPutU32(sec, funcSigs[i].params[j])
            j = j + 1
        }
        bkPutU32(sec, funcSigs[i].ret)
        i = i + 1
    }

    bkPutU32(sec, symbols.count)
    i = 0
    while i < symbols.count {
        bkPutU32(sec, symbols[i].nameIdx)
        bkPutU32(sec, symbols[i].typeIdx)
        bkPutBool(sec, symbols[i].isFunc)
        bkPutU32(sec, symbols[i].sigIdx)
        bkPutBool(sec, symbols[i].isType)
        bkPutBool(sec, symbols[i].isConst)
        bkPutBool(sec, symbols[i].isParam)
        bkPutBool(sec, symbols[i].constIsStr)
        bkPutU32(sec, symbols[i].constInt)
        bkPutU32(sec, symbols[i].constStrIdx)
        bkPutBool(sec, symbols[i].isMenu)
        bkPutBool(sec, symbols[i].isExtern)
        bkPutBool(sec, symbols[i].isCallback)
        i = i + 1
    }

    bkPutU32(sec, scopes.count)
    i = 0
    while i < scopes.count {
        bkPutU32(sec, scopes[i].parent)
        names = scopes[i].names
        bkPutU32(sec, names.count)
        for k, v in names {
            bkPutU32(sec, k)
            bkPutU32(sec, v)
        }
        i = i + 1
    }

    bkPutU32(sec, typeArena.count)
    i = 0
    while i < typeArena.count {
        bkPutU32(sec, int(typeArena[i].kind))
        bkPutU32(sec, typeArena[i].n)
        bkPutU32(sec, typeArena[i].elem)
        bkPutU32(sec, typeArena[i].nameIdx)
        i = i + 1
    }

    bkPutU32(sec, enumMembers.count)
    i = 0
    while i < enumMembers.count {
        bkPutU32(sec, enumMembers[i].nameIdx)
        bkPutU32(sec, enumMembers[i].value)
        bkPutU32(sec, enumMembers[i].labelIdx)
        i = i + 1
    }

    return sec
}

// bkWriteDeclFileTab: lib.cla's declFileTab (decl-arena-index ->
// interned source-path index), verbatim -- the curPathIdx stamp table
// the brief's format block names, so a runtime-attributed diagnostic/
// panic at use time can still name the right runtime source file.
func bkWriteDeclFileTab(): text {
    var sec: text
    var i: int

    bkPutU32(sec, declFileTab.count)
    i = 0
    while i < declFileTab.count {
        bkPutU32(sec, declFileTab[i])
        i = i + 1
    }
    return sec
}

// ================================================================
// Top-level orchestrator
// ================================================================

// bakeWriteFile runs the generator (bakeGenerateChain) for lane, then
// serializes every section into outPath in the brief's format:
//   magic(4) formatVersion(4) laneTag(1) stampLen(2) stamp
//   moduleCount(2) [keyLen(1) key]... sectionCount(2) [id(2) len(4) payload]...
// Returns false on a checker/lowering diagnostic (diags stays populated
// for the caller to print, exactly as driveCompile's own contract) or a
// write failure (logged directly, same as emitMode's own write-failure
// path in main.cla).
func bakeWriteFile(lane: int, outPath: string): bool {
    var out: text
    var mods: list of string
    var stamp: text
    var compilerSrc: text
    var i: int

    if not bakeGenerateChain(lane) {
        return false
    }

    mods = bakeModuleList(lane)

    out = ""
    out.append(bkMagic)
    bkPutU32(out, bkFormatVersion)
    bkPutByte(out, lane)

    compilerSrc = ""
    stamp = ""
    if bkFindClarusC(compilerSrc) {
        bkPutU32(stamp, bkHashText(compilerSrc))
    } else {
        // clarusc/clarusc.c unreachable from the working directory (an
        // unusual invocation location) -- an all-zero stamp still keeps
        // the bake deterministic (bake-twice-identical) and the loader's
        // mismatch-refusal (Task 4) errs safe either way: a real
        // clarusc.c-hash stamp will never legitimately be zero.
        bkPutU32(stamp, 0)
    }
    bkPutU16(out, stamp.length)
    out.append(stamp)

    bkPutU16(out, mods.count)
    i = 0
    while i < mods.count {
        bkPutStrShort(out, rtModuleKey(mods[i]))
        i = i + 1
    }

    bkPutU16(out, bkSectionCount)
    bkEmitSection(out, bkSecIrTypes, bkWriteIrTypes())
    bkEmitSection(out, bkSecIrStmts, bkWriteIrStmts())
    bkEmitSection(out, bkSecIrExprs, bkWriteIrExprs())
    bkEmitSection(out, bkSecIrLocals, bkWriteIrLocals())
    bkEmitSection(out, bkSecIrFuncs, bkWriteIrFuncs())
    bkEmitSection(out, bkSecIrFuncIdxByName, bkWriteIrFuncIdxByName())
    bkEmitSection(out, bkSecIrCbGlueNames, bkWriteIrCbGlueNames())
    bkEmitSection(out, bkSecIrGlobals, bkWriteIrGlobals())
    bkEmitSection(out, bkSecIrFieldSlots, bkWriteIrFieldSlots())
    bkEmitSection(out, bkSecIrRecords, bkWriteIrRecords())
    bkEmitSection(out, bkSecIrEnumMembers, bkWriteIrEnumMembers())
    bkEmitSection(out, bkSecIrEnums, bkWriteIrEnums())
    bkEmitSection(out, bkSecIrWidgetDescs, bkWriteIrWidgetDescs())
    bkEmitSection(out, bkSecIrColumnDescs, bkWriteIrColumnDescs())
    bkEmitSection(out, bkSecIrBindDescs, bkWriteIrBindDescs())
    bkEmitSection(out, bkSecIrWindowDescs, bkWriteIrWindowDescs())
    bkEmitSection(out, bkSecIrMenuItemDescs, bkWriteIrMenuItemDescs())
    bkEmitSection(out, bkSecIrMenuDescs, bkWriteIrMenuDescs())
    bkEmitSection(out, bkSecIrWinHandlers, bkWriteIrWinHandlers())
    bkEmitSection(out, bkSecIrWidgetHandlerEntries, bkWriteIrWidgetHandlerEntries())
    bkEmitSection(out, bkSecIrMenuHandlerEntries, bkWriteIrMenuHandlerEntries())
    bkEmitSection(out, bkSecIrEveryEntries, bkWriteIrEveryEntries())
    bkEmitSection(out, bkSecIrStrLits, bkWriteIrStrLits())
    bkEmitSection(out, bkSecIrExternNames, bkWriteIntList(irExternNames))
    bkEmitSection(out, bkSecIrExternRetTys, bkWriteIntList(irExternRetTys))
    bkEmitSection(out, bkSecIrExternParamStart, bkWriteIntList(irExternParamStart))
    bkEmitSection(out, bkSecIrExternParamCountArr, bkWriteIntList(irExternParamCountArr))
    bkEmitSection(out, bkSecIrExternParamTys, bkWriteIntList(irExternParamTys))
    bkEmitSection(out, bkSecIrExternTrapWords, bkWriteIntList(irExternTrapWords))
    bkEmitSection(out, bkSecIrExternConvs, bkWriteIntList(irExternConvs))
    bkEmitSection(out, bkSecIrExternSels, bkWriteIntList(irExternSels))
    bkEmitSection(out, bkSecIrExternParamRegs, bkWriteIntList(irExternParamRegs))
    bkEmitSection(out, bkSecIrExternRetRegs, bkWriteIntList(irExternRetRegs))
    bkEmitSection(out, bkSecIrLayoutNeededByName, bkWriteIrLayoutNeededByName())
    bkEmitSection(out, bkSecIrRcWalkNeededByName, bkWriteIrRcWalkNeededByName())
    bkEmitSection(out, bkSecIrScalars, bkWriteIrScalars())
    bkEmitSection(out, bkSecStrPool, bkWriteStrPool())
    bkEmitSection(out, bkSecLowCounters, bkWriteLowCounters())
    bkEmitSection(out, bkSecCheckerSymbols, bkWriteCheckerSymbols())
    bkEmitSection(out, bkSecDeclFileTab, bkWriteDeclFileTab())

    if not file.writeText(outPath, out, fileTypeData, "????") {
        log("clarusc --bake-ir: cannot write " + outPath + ": " + lastError.message)
        return false
    }
    return true
}

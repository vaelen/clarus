var bkLoadedEnumMembers: list of EnumMemberInfo

// bkLoadedFieldInfos/bkLoadedRecFieldsHeadByName (format version 5,
// fallback-trigger-narrowing Task 2): check.cla's own record-field side
// tables (FieldInfo arena + record-name -> fieldInfos-head map), parsed
// and retained the SAME "not installed until an install function runs"

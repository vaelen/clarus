// bkObjRelocSymValid (object-code-linker Task 2) is bkReadObjCode's own
// corruption gate: a structurally-valid-but-corrupt bake (a flipped
// symIdx byte, say) must be refused HERE, before a future link pass
// (Task 3) ever hands an attacker- or bit-rot-controlled index to
// cgCallFunc/cgJtDisp/cgStrLitLabels and friends. kind/cls per this
// file's own bkSecObjCode doc comment (cg68k.cla's cgHole*/cgRelCls*
// constants, visible here the same whole-program way every other
// cg68k.cla symbol already is from bake.cla). cgRelClsPanicMsg carries
// no numeric index at all (Amendment A2 -- resolved from the live
// cgListOobMsgIdx global at link time), so any sym is valid there.
func bkObjRelocSymValid(kind: int, cls: int, sym: int): bool {
    if kind == cgHoleCall or kind == cgHoleJtAddr {
        return sym >= 0 and sym < bkLdIrFuncs.count
    }
    if kind == cgHoleCbGlueAddr {
        return sym >= 0 and sym < bkLdIrCbGlueNames.count
    }
    // kind == cgHoleLabel
    if cls == cgRelClsPoolStr {
        return sym >= 0 and sym < bkLdIrStrLits.count
    }
    if cls == cgRelClsPoolEnum {
        return sym >= 0 and sym < bkLdIrEnums.count
    }
    if cls == cgRelClsPoolSer or cls == cgRelClsRcRetain or cls == cgRelClsRcRelease {
        return sym >= 0 and sym < bkLdIrRecords.count
    }
    if cls == cgRelClsPoolUiBlob or cls == cgRelClsPoolUiEvt {
        return sym == 0
    }
    if cls == cgRelClsGlue {
        return sym >= 1 and sym <= 4
    }
    if cls == cgRelClsFuncLabel {
        return sym >= 0 and sym < bkLdIrFuncs.count
    }
    if cls == cgRelClsPanicMsg {
        return true
    }
    return false
}

// bkReadObjCode (format v6, object-code-linker Task 2) mirrors
// bkWriteObjCode field-for-field into bkLdObj* staging. Returns false
// the moment a hole's own symIdx fails bkObjRelocSymValid -- the
// dispatcher (bkLoadSections, below) turns that into the same
// emitDiag-then-refuse message path every other structural check here
// already uses, never a crash or a half-installed object set.
func bkReadObjCode(): bool {
    var count: int
    var i: int
    var k: int
    var nHoles: int
    var valid: bool
    var kind: int
    var cls: int
    var sym: int
    var h: CgObjHole
    var lValid: list of bool
    var lRunFirst: list of int
    var lHoleFirst: list of int
    var lNHoles: list of int
    var lRuns: list of text
    var lHoles: list of CgObjHole

    count = bkGetU32()
    lValid = driveFreshBoolList()
    lRunFirst = driveFreshIntList()
    lHoleFirst = driveFreshIntList()
    lNHoles = driveFreshIntList()
    lRuns = cgFreshTextList()
    i = 0
    while i < count {
        valid = bkGetBool()
        lValid.add(valid)
        lRunFirst.add(lRuns.count)
        lHoleFirst.add(lHoles.count)
        nHoles = 0
        if valid {
            nHoles = bkGetU32()
            k = 0
            while k <= nHoles {
                lRuns.add(bkGetBytes())
                if k < nHoles {
                    kind = bkGetByte()
                    cls = bkGetByte()
                    sym = bkGetU32()
                    h.kind = kind
                    h.cls = cls
                    h.sym = sym
                    h.op = bkGetByte()
                    h.size = bkGetByte()
                    h.sm = bkGetByte()
                    h.sr = bkGetByte()
                    h.sv = bkGetU32()
                    h.dm = bkGetByte()
                    h.dr = bkGetByte()
                    h.dv = bkGetU32()
                    h.srcSlot = bkGetBool()
                    if not bkObjRelocSymValid(kind, cls, sym) {
                        emitDiag(1, 1, "--rtbake: object-code section: reloc symbol " + numToStr(sym) + " out of range (kind " + numToStr(kind) + ", class " + numToStr(cls) + ")")
                        return false
                    }
                    lHoles.add(h)
                }
                k = k + 1
            }
        }
        lNHoles.add(nHoles)
        i = i + 1
    }
    bkLdObjValid = lValid
    bkLdObjRunFirst = lRunFirst
    bkLdObjHoleFirst = lHoleFirst
    bkLdObjNHoles = lNHoles
    // See bkLdObjValid's own doc comment: the flat run/hole payload
    // reuses cg68k.cla's own capture-side globals instead of a separate
    // bkLdObjRuns/bkLdObjHoles pair.
    //
    // These two are the ONE place a reader writes LIVE state instead of
    // pending state (Task 6 audit finding F3), and design B (bkParsedValid,
    // above) leans on their WRITE-ONCE property: cgObjRuns/cgObjHoles are
    // .clear()ed/.add()ed only under `if cgBakeCapture` (cg68k.cla's
    // cgObjDumpSegment and the fork-side reset), which only the --bake-ir
    // generator ever sets -- never during a --rtbake compile -- and nothing
    // resets them in driveReset or anywhere else. So a memoized parse
    // leaves them populated and correct for every later compile in the
    // session. Deliberately NOT moved to the install path: the obvious
    // bkLdObjRuns/bkLdObjHoles pair is exactly what tipped cpEmitRelease
    // over the 32KB single-function segment ceiling once before (see
    // bkLdObjValid's own doc comment). If that write-once property ever
    // changes, design B's memo breaks with it.
    cgObjRuns = lRuns
    cgObjHoles = lHoles
    return true
}

// bkObjPoolIdxValid (object-code-linker Task 2): bkReadObjMeta's own
// lighter-weight defense-in-depth check, symmetric with
// bkObjRelocSymValid but over ONE function's own flat pool-ref index
// slice (bkLdObjFuncStrLitFlat[first, first+count) and friends -- see
// that field's own doc comment for why flat, not `list of list of int`)
// -- never a call target, so no kind/cls switch is needed, just "is this
// index inside the corresponding pool arena".
func bkObjPoolIdxValid(flat: list of int, first: int, count: int, bound: int): bool {
    var i: int
    var v: int

    i = 0
    while i < count {
        v = flat[first + i]
        if v < 0 or v >= bound {
            return false
        }
        i = i + 1
    }
    return true
}

// bkReadObjMeta (format v6, object-code-linker Task 2) mirrors
// bkWriteObjMeta field-for-field into bkLdObj* staging, refusing (same
// message path as bkReadObjCode) the moment a function's own pool-ref
// index list names something outside that pool's own installed range.
// The wire shape is UNCHANGED (still count-then-elements per pool per
// function, matching bkWriteObjMeta exactly, which reads straight off
// cg68k.cla's own `list of list of int` cgFuncStrLits/etc) -- only the
// STAGING shape flattens (bkLdObjFuncStrLitFirst/Count into one shared
// bkLdObjFuncStrLitFlat, per pool).
func bkReadObjMeta(): bool {
    var count: int
    var i: int
    var k: int
    var n: int
    var lSize: list of int
    var lFrame: list of int
    var lStrLitFirst: list of int
    var lStrLitCount: list of int
    var lStrLitFlat: list of int
    var lEnumTableFirst: list of int
    var lEnumTableCount: list of int
    var lEnumTableFlat: list of int
    var lSerdescFirst: list of int
    var lSerdescCount: list of int
    var lSerdescFlat: list of int
    var lUsesUiBlob: list of bool
    var lUsesUiEvents: list of bool
    var lSeg1ExtraSize: int
    var lGlueBundleSize: int
    var lPoolSize: int
    var lStrLitSize: list of int
    var lEnumTableSize: list of int
    var lSerdescSize: list of int
    var lUiBlobSize: int
    var lUiEventsSize: int

    count = bkGetU32()
    lSize = driveFreshIntList()
    lFrame = driveFreshIntList()
    lStrLitFirst = driveFreshIntList()
    lStrLitCount = driveFreshIntList()
    lStrLitFlat = driveFreshIntList()
    lEnumTableFirst = driveFreshIntList()
    lEnumTableCount = driveFreshIntList()
    lEnumTableFlat = driveFreshIntList()
    lSerdescFirst = driveFreshIntList()
    lSerdescCount = driveFreshIntList()
    lSerdescFlat = driveFreshIntList()
    lUsesUiBlob = driveFreshBoolList()
    lUsesUiEvents = driveFreshBoolList()
    i = 0
    while i < count {
        lSize.add(bkGetU32())
        lFrame.add(bkGetU32())

        n = bkGetU32()
        lStrLitFirst.add(lStrLitFlat.count)
        lStrLitCount.add(n)
        k = 0
        while k < n {
            lStrLitFlat.add(bkGetU32())
            k = k + 1
        }
        if not bkObjPoolIdxValid(lStrLitFlat, lStrLitFirst[i], n, bkLdIrStrLits.count) {
            emitDiag(1, 1, "--rtbake: object-meta section: pool-ref index out of range for function " + numToStr(i))
            return false
        }

        n = bkGetU32()
        lEnumTableFirst.add(lEnumTableFlat.count)
        lEnumTableCount.add(n)
        k = 0
        while k < n {
            lEnumTableFlat.add(bkGetU32())
            k = k + 1
        }
        if not bkObjPoolIdxValid(lEnumTableFlat, lEnumTableFirst[i], n, bkLdIrEnums.count) {
            emitDiag(1, 1, "--rtbake: object-meta section: pool-ref index out of range for function " + numToStr(i))
            return false
        }

        n = bkGetU32()
        lSerdescFirst.add(lSerdescFlat.count)
        lSerdescCount.add(n)
        k = 0
        while k < n {
            lSerdescFlat.add(bkGetU32())
            k = k + 1
        }
        if not bkObjPoolIdxValid(lSerdescFlat, lSerdescFirst[i], n, bkLdIrRecords.count) {
            emitDiag(1, 1, "--rtbake: object-meta section: pool-ref index out of range for function " + numToStr(i))
            return false
        }

        lUsesUiBlob.add(bkGetBool())
        lUsesUiEvents.add(bkGetBool())
        i = i + 1
    }
    // fix round 1 (review finding I2): the once-per-artifact fixed
    // buckets below are read into LOCALS too, same as everything above
    // -- a post-dispatch framing refusal (bkLoadSections' own
    // expectedPos check, run by the CALLER after this function returns)
    // must never land after a live bkLdObj* global was already written,
    // or a truncated/corrupt section could leave the staging state
    // half-updated even though the load as a whole gets refused.
    // bkReadObjCode already has this shape (locals throughout, one
    // assignment block at the very end); this mirrors it.
    lSeg1ExtraSize = bkGetU32()
    lGlueBundleSize = bkGetU32()
    lPoolSize = bkGetU32()

    n = bkGetU32()
    lStrLitSize = driveFreshIntList()
    k = 0
    while k < n {
        lStrLitSize.add(bkGetU32())
        k = k + 1
    }
    n = bkGetU32()
    lEnumTableSize = driveFreshIntList()
    k = 0
    while k < n {
        lEnumTableSize.add(bkGetU32())
        k = k + 1
    }
    n = bkGetU32()
    lSerdescSize = driveFreshIntList()
    k = 0
    while k < n {
        lSerdescSize.add(bkGetU32())
        k = k + 1
    }
    lUiBlobSize = bkGetU32()
    lUiEventsSize = bkGetU32()

    bkLdObjFuncSize = lSize
    bkLdObjFuncFrameSize = lFrame
    bkLdObjFuncStrLitFirst = lStrLitFirst
    bkLdObjFuncStrLitCount = lStrLitCount
    bkLdObjFuncStrLitFlat = lStrLitFlat
    bkLdObjFuncEnumTableFirst = lEnumTableFirst
    bkLdObjFuncEnumTableCount = lEnumTableCount
    bkLdObjFuncEnumTableFlat = lEnumTableFlat
    bkLdObjFuncSerdescFirst = lSerdescFirst
    bkLdObjFuncSerdescCount = lSerdescCount
    bkLdObjFuncSerdescFlat = lSerdescFlat
    bkLdObjFuncUsesUiBlob = lUsesUiBlob
    bkLdObjFuncUsesUiEvents = lUsesUiEvents
    bkLdObjSeg1ExtraSize = lSeg1ExtraSize
    bkLdObjGlueBundleSize = lGlueBundleSize
    bkLdObjPoolSize = lPoolSize
    bkLdObjStrLitSize = lStrLitSize
    bkLdObjEnumTableSize = lEnumTableSize
    bkLdObjSerdescSize = lSerdescSize
    bkLdObjUiBlobSize = lUiBlobSize
    bkLdObjUiEventsSize = lUiEventsSize
    return true
}

// bkLoadSections reads the section table (sectionCount, then that many
// `id(2) len(4) payload(len)` frames) and dispatches each to its own
// reader by id -- section ORDER in the file always matches bkWriteFile's
// own fixed emission order, but this dispatches by id rather than
// assuming that, so a future format extension (a reordered or additional
// section) fails loudly (an unknown id) instead of silently
// misinterpreting bytes. The post-dispatch bkLoadPos check is a free
// integrity proof: every reader must consume EXACTLY `len` bytes, or the
// bake is corrupt (or this loader has a field-order bug) -- either way,
// a clear diagnostic beats a garbled downstream compile.
func bkLoadSections(): bool {
    var n: int
    var i: int
    var id: int
    var len: int
    var expectedPos: int

    n = bkGetU16()
    if n != bkSectionCount {
        emitDiag(1, 1, "--rtbake: bad section count " + numToStr(n) + " (want " + numToStr(bkSectionCount) + ")")
        return false
    }
    i = 0
    while i < n {
        id = bkGetU16()
        len = bkGetU32()
        expectedPos = bkLoadPos + len
        if id == bkSecIrTypes {
            bkLdIrTypes = bkReadIrTypes()
        } else if id == bkSecIrStmts {
            bkLdIrStmts = bkReadIrStmts()
        } else if id == bkSecIrExprs {
            bkLdIrExprs = bkReadIrExprs()
        } else if id == bkSecIrLocals {
            bkLdIrLocals = bkReadIrLocals()
        } else if id == bkSecIrFuncs {
            bkLdIrFuncs = bkReadIrFuncs()
        } else if id == bkSecIrFuncIdxByName {
            bkLdIrFuncIdxByName = bkReadIntIntMap()
        } else if id == bkSecIrCbGlueNames {
            bkLdIrCbGlueNames = bkReadIntList()
        } else if id == bkSecIrGlobals {
            bkLdIrGlobals = bkReadIrGlobals()
        } else if id == bkSecIrFieldSlots {
            bkLdIrFieldSlots = bkReadIrFieldSlots()
        } else if id == bkSecIrRecords {
            bkLdIrRecords = bkReadIrRecords()
        } else if id == bkSecIrEnumMembers {
            bkLdIrEnumMembers = bkReadIrEnumMembers()
        } else if id == bkSecIrEnums {
            bkLdIrEnums = bkReadIrEnums()
        } else if id == bkSecIrWidgetDescs {
            bkLdIrWidgetDescs = bkReadIrWidgetDescs()
        } else if id == bkSecIrColumnDescs {
            bkLdIrColumnDescs = bkReadIrColumnDescs()
        } else if id == bkSecIrBindDescs {
            bkLdIrBindDescs = bkReadIrBindDescs()
        } else if id == bkSecIrWindowDescs {
            bkLdIrWindowDescs = bkReadIrWindowDescs()
        } else if id == bkSecIrMenuItemDescs {
            bkLdIrMenuItemDescs = bkReadIrMenuItemDescs()
        } else if id == bkSecIrMenuDescs {
            bkLdIrMenuDescs = bkReadIrMenuDescs()
        } else if id == bkSecIrWinHandlers {
            bkLdIrWinHandlers = bkReadIrWinHandlers()
        } else if id == bkSecIrWidgetHandlerEntries {
            bkLdIrWidgetHandlerEntries = bkReadIrWidgetHandlerEntries()
        } else if id == bkSecIrMenuHandlerEntries {
            bkLdIrMenuHandlerEntries = bkReadIrMenuHandlerEntries()
        } else if id == bkSecIrEveryEntries {
            bkLdIrEveryEntries = bkReadIrEveryEntries()
        } else if id == bkSecIrStrLits {
            bkLdIrStrLits = bkReadIntList()
        } else if id == bkSecIrExternNames {
            bkLdIrExternNames = bkReadIntList()
        } else if id == bkSecIrExternRetTys {
            bkLdIrExternRetTys = bkReadIntList()
        } else if id == bkSecIrExternParamStart {
            bkLdIrExternParamStart = bkReadIntList()
        } else if id == bkSecIrExternParamCountArr {
            bkLdIrExternParamCountArr = bkReadIntList()
        } else if id == bkSecIrExternParamTys {
            bkLdIrExternParamTys = bkReadIntList()
        } else if id == bkSecIrExternTrapWords {
            bkLdIrExternTrapWords = bkReadIntList()
        } else if id == bkSecIrExternConvs {
            bkLdIrExternConvs = bkReadIntList()
        } else if id == bkSecIrExternSels {
            bkLdIrExternSels = bkReadIntList()
        } else if id == bkSecIrExternParamRegs {
            bkLdIrExternParamRegs = bkReadIntList()
        } else if id == bkSecIrExternRetRegs {
            bkLdIrExternRetRegs = bkReadIntList()
        } else if id == bkSecIrLayoutNeededByName {
            bkLdIrLayoutNeededByName = bkReadIntIntMap()
        } else if id == bkSecIrRcWalkNeededByName {
            bkLdIrRcWalkNeededByName = bkReadIntIntMap()
        } else if id == bkSecIrScalars {
            bkReadIrScalars()
        } else if id == bkSecStrPool {
            bkLdStrPool = bkReadStrPool()
        } else if id == bkSecLowCounters {
            bkReadLowCounters()
        } else if id == bkSecCheckerSymbols {
            bkReadCheckerSymbols()
        } else if id == bkSecFieldInfo {
            bkReadFieldInfo()
        } else if id == bkSecDeclFileTab {
            bkLoadedDeclFileTab = bkReadIntList()
        } else if id == bkSecUitestBounds {
            bkReadUitestBounds()
        } else if id == bkSecCheckerVisibility {
            bkReadCheckerVisibility()
        } else if id == bkSecManifestHashes {
            bkReadManifestHashes()
        } else if id == bkSecObjCode {
            // object-code-linker Task 2: bkReadObjCode already emitDiag's
            // its own specific reloc-symIdx message before returning
            // false -- propagate straight through, no second diagnostic.
            if not bkReadObjCode() {
                return false
            }
        } else if id == bkSecObjMeta {
            if not bkReadObjMeta() {
                return false
            }
        } else {
            emitDiag(1, 1, "--rtbake: unknown section id " + numToStr(id))
            return false
        }
        if bkLoadPos != expectedPos {
            emitDiag(1, 1, "--rtbake: section " + numToStr(id) + " framing mismatch (corrupt bake)")
            return false
        }
        i = i + 1
    }
    // runtime-ir-bake Task 6 fix round 1: a truncated OR overlong buffer
    // is refused loudly here, on BOTH lanes -- every section's own
    // framing check (above) only proves internal self-consistency
    // between adjacent length fields; it says nothing about whether the
    // WHOLE buffer this parse just walked is the artifact's real,
    // complete extent. A short copy (a lane's own resource/file read
    // silently clamping) would, in the general case, either run off the
    // end of a too-short bkLoadBuf (an out-of-range index -- a loud
    // runtime error already, not a silent gap) or, if the clamp happened
    // to land past every section this parse actually touched, leave
    // trailing bytes unconsumed with no error at all otherwise -- this
    // catches exactly that second case.
    if bkLoadPos != bkLoadBuf.length {
        emitDiag(1, 1, "--rtbake: trailing " + numToStr(bkLoadBuf.length - bkLoadPos) + " unconsumed byte(s) after the last section (truncated or overlong bake)")
        return false
    }
    // bkLoadOverrun: defense in depth (its own doc comment, above) --
    // the body-hash check should already have refused any buffer that
    // could trigger this, so reaching here loud rather than silent means
    // that check itself was somehow bypassed or its own field truncated.
    if bkLoadOverrun {
        emitDiag(1, 1, "--rtbake: read past end of buffer while parsing (corrupt or truncated bake)")
        return false
    }
    return true
}

// feExpectedStamp is a front-end seam (mirrors feReadSource/feHasKey/
// feProgress, drive.cla): "what stamp should a bake generated by THIS
// running compiler build carry?" bkCheckRtbakeHeader calls it instead of
// hashing clarusc/clarusc.c inline, so each front end can answer however
// fits its own filesystem. The host CLI (main.cla, clarusc/test/
// dblcompile*.cla) re-hashes clarusc/clarusc.c off disk (bkFindClarusC/
// bkHashText, unchanged from Task 3/4's own behavior -- a pure refactor,
// not a behavior change there). macgui.cla (Task 6, Mac integration) has
// no clarusc/clarusc.c on ClarusC.APPL's own boot disk at all (baking the
// 3.5MB bootstrap C file just to re-hash it on a 68k CPU every compile
// would be both wasteful and slow) -- it reads a tiny 4-byte stamp
// sidecar baked alongside the CLIR resource instead (bkStampResourceName,
// computed by the SAME `--bake-ir` run that generated the CLIR artifact,
// so the two always agree by construction; see macgui.cla's own
// feExpectedStamp for the full reasoning).
//
// bkCheckRtbakeHeader validates buf's header (magic, format version,
// lane, stamp, body-hash -- format v4, final-review fix wave) against
// wantLane, WITHOUT parsing the rest of the file into section structures
// -- split out of bkLoadRtbake (below, which continues into the full
// parse on success) so a front end can cheaply ask "would this bake be
// accepted?" BEFORE committing to it (macgui.cla's gcCompile: the
// never-cached, per-compile bake-vs-fallback decision, Task 6 -- a
// refused bake must never surface as a user-facing compile failure, so
// the decision has to be made, and acted on, before driveCompile's own
// unconditional `if not bkLoadRtbake(...) { return false }` would
// otherwise fail the whole compile). The body-hash check DOES walk every
// byte after the header (bkHashTextFrom) to compute the comparison hash
// -- not free, but still no section-structure parsing -- so a truncated
// buffer, a section-level bit flip, or any other body corruption is
// caught HERE, before a front end can ever act on "accepted", instead of
// only surfacing later inside bkLoadRtbake's own full parse (which used
// to run only after macgui.cla had already committed to the bake path).
// On success, leaves bkLoadBuf/bkLoadPos positioned right after the
// body-hash field, for bkLoadRtbake's own caller-visible contract
// (unchanged) to continue parsing from.
//
// Stamp contract (Task 4's own open question (a)): the stamp is a hash of
// the committed clarusc/clarusc.c snapshot (bake.cla's own bkHashText/
// bkFindClarusC, Task 3) on the host lane; the Mac lane's own sidecar
// (above) is that SAME value, computed once at bake-generation time.
// Known gap, accepted for this phase (see Task 4's own report): a dev
// binary built from EDITED .cla sources still stamps/checks against the
// COMMITTED snapshot, since bkFindClarusC always reads clarusc/clarusc.c
// off disk, never the running binary's own (possibly different) source
// -- both the generator (bake.cla, unmodified since Task 3) and every
// loader share that exact same proxy, so a bake generated and loaded by
// binaries built from the same checkout always agree, and the snapshot
// is regenerated at every phase close (CLAUDE.md), keeping drift bounded
// to "mid-phase, uncommitted .cla edits" -- exactly the same caveat any
// other snapshot-bootstrapped tool in this repo already carries.
func bkCheckRtbakeHeader(buf: text, wantLane: int): bool {
    var magic: string
    var version: int
    var lane: int
    var stampLen: int
    var stamp: int
    var expectStamp: int
    var bodyHash: int
    var actualBodyHash: int
    var i: int
    var n: int

    bkLoadOverrun = false

    // Header is magic(4) + formatVersion(4) + laneTag(1) + stampLen(2) +
    // stamp(4) + bodyHash(4) = 19 bytes (format v4, final-review fix
    // wave -- was 15 before bodyHash was added).
    if buf.length < 19 {
        emitDiag(1, 1, "--rtbake: file too short to be a CLIR bake")
        return false
    }
    magic = buf[0, 4]
    if magic != bkMagic {
        emitDiag(1, 1, "--rtbake: bad magic (not a CLIR bake)")
        return false
    }

    bkLoadBuf = buf
    bkLoadPos = 4
    version = bkGetU32()
    if version != bkFormatVersion {
        emitDiag(1, 1, "--rtbake: format version " + numToStr(version) + " unsupported (want " + numToStr(bkFormatVersion) + ")")
        return false
    }
    lane = bkGetByte()
    if lane != wantLane {
        emitDiag(1, 1, "--rtbake: lane mismatch (bake is " + bkLaneName(lane) + ", this compile wants " + bkLaneName(wantLane) + ")")
        return false
    }
    stampLen = bkGetU16()
    if stampLen != 4 {
        emitDiag(1, 1, "--rtbake: unexpected stamp length " + numToStr(stampLen))
        return false
    }
    stamp = bkGetU32()

    expectStamp = feExpectedStamp()
    if stamp != expectStamp {
        emitDiag(1, 1, "--rtbake: stamp mismatch (bake=" + numToStr(stamp) + ", this compiler=" + numToStr(expectStamp) + "); regenerate with --bake-ir")
        return false
    }

    bodyHash = bkGetU32()
    // Everything from here (bkLoadPos) to buf.length is "the body" --
    // exactly what bakeWriteFile hashed before writing the header.
    // clir-load-perf Task 5 (design C): walk it in ~32KB chunks through
    // the bulk t.hashStep method instead of bkHashTextFrom's per-byte
    // loop -- same djb2-shape seed/step, so this is bit-identical to
    // bkHashTextFrom(buf, bkLoadPos) (proven by Task 2's core-suite
    // "hashStep split" case); bkHashTextFrom itself stays untouched as
    // the reference implementation and the cold-path form the
    // manifest/stamp callers still use.
    actualBodyHash = bkFnvSeed
    i = bkLoadPos
    while i < buf.length {
        n = 32768
        if i + n > buf.length {
            n = buf.length - i
        }
        actualBodyHash = buf.hashStep(actualBodyHash, i, n)
        // Liveness pulse (attempt-abort Task 7 contract): one tick per
        // 32KB chunk, same cadence the per-byte loop's (i & 0x7FFF)
        // gate produced.
        driveProgressTick()
        i = i + n
    }
    if actualBodyHash != bodyHash {
        emitDiag(1, 1, "--rtbake: body hash mismatch (corrupt or truncated bake); regenerate with --bake-ir")
        return false
    }
    return true
}

// bkLoadRtbake parses buf (the raw --rtbake FILE contents) into the
// bkLd*/bkLoaded* pending globals above, validating the header
// (bkCheckRtbakeHeader, above) against wantLane (the CURRENT compile's
// own target -- bkLane68k for emit68k, bkLaneC for emit) and a freshly
// recomputed stamp. Touches no live compiler state -- see
// bkInstallPool/bkInstallArenas for that.
func bkLoadRtbake(buf: text, wantLane: int): bool {
    var i: int
    var n: int
    var loadedMods: list of string
    var parsed: bool

    if bkHeaderVerified {
        // Design A: the front end already verified THIS buffer.
        // Re-establish the parse preconditions bkCheckRtbakeHeader
        // normally leaves behind (cursor past the 19-byte header,
        // overrun flag clear), without the ~1.3MB body re-hash.
        bkHeaderVerified = false
        bkLoadOverrun = false
        bkLoadBuf = buf
        bkLoadPos = 19
    } else {
        if not bkCheckRtbakeHeader(buf, wantLane) {
            return false
        }
    }

    // runtime-ir-bake Task 5 (b): retained (not discarded) into
    // bkLoadedModules -- bkComputeManifestPaths (below) turns these
    // module KEYS (rtModuleKey's "runtime/clarus/NAME" form, written by
    // bkWriteFile) into the disk-path identity expand()'s own dedup uses,
    // so a user `include` of one of these SAME files is detected during
    // Phase A instead of silently double-declaring against the baked IR.
    n = bkGetU16()
    i = 0
    while i < n {
        loadedMods.add(bkGetStrShort())
        i = i + 1
    }
    bkLoadedModules = loadedMods

    parsed = bkLoadSections()
    // clir-load-perf Task 7 (design B): drop the loader cursor's own
    // reference to the caller's buffer the moment the parse is over.
    // Nothing reads bkLoadBuf outside a parse, and macgui.cla's
    // gcCompile frees its rtbakeBytes copy right after driveCompile
    // returns -- but a text is a REFERENCE, so that free reclaims the
    // ~1.3MB only if this reference is gone too. Cleared on failure as
    // well: a refused parse has no more use for it either.
    bkLoadBuf = ""
    return parsed
}

// ================================================================
// Copy-on-install helpers (clir-load-perf Task 7, design B)
// ================================================================
//
// One boring helper per element type -- Clarus has no generics, so this
// is deliberately 26 near-identical `while` + `.add` loops rather than
// anything clever. Every bkInstall* function below runs its pending
// container through one of these instead of assigning it straight into
// the live global: `text`/`list`/`map`/`intmap` are REFERENCE types
// (the language reference's own Value and Reference Semantics section),
// so the old `irExprs = bkLdIrExprs` shape aliased the two -- fine while
// every compile re-parsed the bake from bytes, fatal
// once bkParsedValid memoizes the parse (compile #1's user IR would be
// appended into the pending arenas through the alias, and compile #2's
// own irReset() would .clear() them outright before the install could
// read them -- a total loss, not a subtle corruption).
//
// `dst.add(src[i])` copies a record BY VALUE (same section; verified
// empirically by Task 6's audit probe), which is deep enough for every
// arena here: all 25 record types below are int/bool/enum-field-only
// EXCEPT Scope, whose `names: intmap of int` is a reference field and
// gets its own deep copy (bkCopyListScope). FuncSig.params (`list of
// int`) is deliberately NOT deep-copied -- it is built fresh at
// construction (types.cla's newFuncSig, bake.cla's own loader) and no
// `funcSigs[i].params` mutation site exists anywhere in clarusc/*.cla
// (Task 6 audit, Step 3); a future writer of that field must revisit
// this decision.

func bkCopyListIRType(src: list of IRType): list of IRType {
    var dst: list of IRType
    var i: int

    i = 0
    while i < src.count {
        dst.add(src[i])
        i = i + 1
    }
    return dst
}

func bkCopyListIRStmt(src: list of IRStmt): list of IRStmt {
    var dst: list of IRStmt
    var i: int

    i = 0
    while i < src.count {
        dst.add(src[i])
        i = i + 1
    }
    return dst
}

func bkCopyListIRExpr(src: list of IRExpr): list of IRExpr {
    var dst: list of IRExpr
    var i: int

    i = 0
    while i < src.count {
        dst.add(src[i])
        i = i + 1
    }
    return dst
}

func bkCopyListIRLocal(src: list of IRLocal): list of IRLocal {
    var dst: list of IRLocal
    var i: int

    i = 0
    while i < src.count {
        dst.add(src[i])
        i = i + 1
    }
    return dst
}

func bkCopyListIRFunc(src: list of IRFunc): list of IRFunc {
    var dst: list of IRFunc
    var i: int

    i = 0
    while i < src.count {
        dst.add(src[i])
        i = i + 1
    }
    return dst
}

func bkCopyListIRGlobal(src: list of IRGlobal): list of IRGlobal {
    var dst: list of IRGlobal

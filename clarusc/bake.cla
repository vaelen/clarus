    while i < irGlobals.count {
        bkPutU32(sec, irGlobals[i].name)
        bkPutU32(sec, irGlobals[i].t)
        if bodyless {
            bkPutU32(sec, bkMapIdx(exprMap, irGlobals[i].init))
        } else {
            bkPutU32(sec, irGlobals[i].init)
        }
        bkPutBool(sec, irGlobals[i].initBirth)
        i = i + 1
    }
    return sec
}


func bkReadLowCounters() {
    var n: int
    var i: int
    var k: string
    var v: int
    var m: map of int

    bkLdLowSwitchN = bkGetU32()
    bkLdUiMenuCount = bkGetU32()
    bkLdLowStoreTempN = bkGetU32()
    bkLdLowRetTempN = bkGetU32()
    n = bkGetU32()
    i = 0
    while i < n {
        k = bkGetStr()
        v = bkGetU32()
        m[k] = v
        i = i + 1
    }
    bkLdLowStrIdx = m
}

func bkReadCheckerSymbols() {
    var n: int
    var i: int
    var j: int
    var pn: int
    var sig: FuncSig
    var params: list of int
    var lFuncSigs: list of FuncSig
    var sym: Symbol
    var lSymbols: list of Symbol
    var scope: Scope
    var lScopes: list of Scope
    var ti: TypeInfo
    var lTypeArena: list of TypeInfo
    var em: EnumMemberInfo
    var lEnumMembers: list of EnumMemberInfo

    n = bkGetU32()
    i = 0
    while i < n {
        pn = bkGetU32()
        params = driveFreshIntList()
        j = 0
        while j < pn {
            params.add(bkGetU32())
            j = j + 1
        }
        sig.params = params
        sig.ret = bkGetU32()
        lFuncSigs.add(sig)
        i = i + 1
    }
    bkLoadedFuncSigs = lFuncSigs

    n = bkGetU32()
    i = 0
    while i < n {
        sym.nameIdx = bkGetU32()
        sym.typeIdx = bkGetU32()
        sym.isFunc = bkGetBool()
        sym.sigIdx = bkGetU32()
        sym.isType = bkGetBool()
        sym.isConst = bkGetBool()
        sym.isParam = bkGetBool()
        sym.constIsStr = bkGetBool()
        sym.constInt = bkGetU32()
        sym.constStrIdx = bkGetU32()
        sym.isMenu = bkGetBool()
        sym.isExtern = bkGetBool()
        sym.isCallback = bkGetBool()
        lSymbols.add(sym)
        i = i + 1
    }
    bkLoadedSymbols = lSymbols

    n = bkGetU32()
    i = 0
    while i < n {
        scope.parent = bkGetU32()
        scope.names = bkReadIntIntMap()
        lScopes.add(scope)
        i = i + 1
    }
    bkLoadedScopes = lScopes

    n = bkGetU32()
    i = 0
    while i < n {
        ti.kind = TypeKind(bkGetU32())
        ti.n = bkGetU32()
        ti.elem = bkGetU32()
        ti.nameIdx = bkGetU32()
        lTypeArena.add(ti)
        i = i + 1
    }
    bkLoadedTypeArena = lTypeArena

    n = bkGetU32()
    i = 0
    while i < n {
        em.nameIdx = bkGetU32()
        em.value = bkGetU32()
        em.labelIdx = bkGetU32()
        lEnumMembers.add(em)
        i = i + 1
    }
    bkLoadedEnumMembers = lEnumMembers
}

// bkReadUitestBounds (format version 2, Task 5): the base/uitest IR-arena
// boundary counts -- see bkSecUitestBounds' own doc comment.
func bkReadUitestBounds() {
    bkLdBaseIrFuncsCount = bkGetU32()
    bkLdBaseIrStrLitsCount = bkGetU32()
}

// bkLoadSections reads the section table (sectionCount, then that many
// `id(2) len(4) payload(len)` frames) and dispatches each to its own
// reader by id -- section ORDER in the file always matches bkWriteFile's
// own fixed emission order, but this dispatches by id rather than
// assuming that, so a future format extension (a reordered or additional
// section) fails loudly (an unknown id) instead of silently
// misinterpreting bytes. The post-dispatch bkLoadPos check is a free
// integrity proof: every reader must consume EXACTLY `len` bytes, or the
// bake is corrupt (or this loader has a field-order bug) -- either way,
// a clear diagnostic beats a garbled downstream compile.
func bkLoadSections(): bool {
    var n: int
    var i: int
    var id: int
    var len: int
    var expectedPos: int

    n = bkGetU16()
    if n != bkSectionCount {
        emitDiag(1, 1, "--rtbake: bad section count " + numToStr(n) + " (want " + numToStr(bkSectionCount) + ")")
        return false
    }
    i = 0
    while i < n {
        id = bkGetU16()
        len = bkGetU32()
        expectedPos = bkLoadPos + len
        if id == bkSecIrTypes {
            bkLdIrTypes = bkReadIrTypes()
        } else if id == bkSecIrStmts {
            bkLdIrStmts = bkReadIrStmts()
        } else if id == bkSecIrExprs {
            bkLdIrExprs = bkReadIrExprs()
        } else if id == bkSecIrLocals {
            bkLdIrLocals = bkReadIrLocals()
        } else if id == bkSecIrFuncs {
            bkLdIrFuncs = bkReadIrFuncs()
        } else if id == bkSecIrFuncIdxByName {
            bkLdIrFuncIdxByName = bkReadIntIntMap()
        } else if id == bkSecIrCbGlueNames {
            bkLdIrCbGlueNames = bkReadIntList()
        } else if id == bkSecIrGlobals {
            bkLdIrGlobals = bkReadIrGlobals()
        } else if id == bkSecIrFieldSlots {
            bkLdIrFieldSlots = bkReadIrFieldSlots()
        } else if id == bkSecIrRecords {
            bkLdIrRecords = bkReadIrRecords()
        } else if id == bkSecIrEnumMembers {
            bkLdIrEnumMembers = bkReadIrEnumMembers()
        } else if id == bkSecIrEnums {
            bkLdIrEnums = bkReadIrEnums()
        } else if id == bkSecIrWidgetDescs {
            bkLdIrWidgetDescs = bkReadIrWidgetDescs()
        } else if id == bkSecIrColumnDescs {
            bkLdIrColumnDescs = bkReadIrColumnDescs()
        } else if id == bkSecIrBindDescs {
            bkLdIrBindDescs = bkReadIrBindDescs()
        } else if id == bkSecIrWindowDescs {
            bkLdIrWindowDescs = bkReadIrWindowDescs()
        } else if id == bkSecIrMenuItemDescs {
            bkLdIrMenuItemDescs = bkReadIrMenuItemDescs()
        } else if id == bkSecIrMenuDescs {
            bkLdIrMenuDescs = bkReadIrMenuDescs()
        } else if id == bkSecIrWinHandlers {
            bkLdIrWinHandlers = bkReadIrWinHandlers()
        } else if id == bkSecIrWidgetHandlerEntries {
            bkLdIrWidgetHandlerEntries = bkReadIrWidgetHandlerEntries()
        } else if id == bkSecIrMenuHandlerEntries {
            bkLdIrMenuHandlerEntries = bkReadIrMenuHandlerEntries()
        } else if id == bkSecIrEveryEntries {
            bkLdIrEveryEntries = bkReadIrEveryEntries()
        } else if id == bkSecIrStrLits {
            bkLdIrStrLits = bkReadIntList()
        } else if id == bkSecIrExternNames {
            bkLdIrExternNames = bkReadIntList()
        } else if id == bkSecIrExternRetTys {
            bkLdIrExternRetTys = bkReadIntList()
        } else if id == bkSecIrExternParamStart {
            bkLdIrExternParamStart = bkReadIntList()
        } else if id == bkSecIrExternParamCountArr {
            bkLdIrExternParamCountArr = bkReadIntList()
        } else if id == bkSecIrExternParamTys {
            bkLdIrExternParamTys = bkReadIntList()
        } else if id == bkSecIrExternTrapWords {
            bkLdIrExternTrapWords = bkReadIntList()
        } else if id == bkSecIrExternConvs {
            bkLdIrExternConvs = bkReadIntList()
        } else if id == bkSecIrExternSels {
            bkLdIrExternSels = bkReadIntList()
        } else if id == bkSecIrExternParamRegs {
            bkLdIrExternParamRegs = bkReadIntList()
        } else if id == bkSecIrExternRetRegs {
            bkLdIrExternRetRegs = bkReadIntList()
        } else if id == bkSecIrLayoutNeededByName {
            bkLdIrLayoutNeededByName = bkReadIntIntMap()
        } else if id == bkSecIrRcWalkNeededByName {
            bkLdIrRcWalkNeededByName = bkReadIntIntMap()
        } else if id == bkSecIrScalars {
            bkReadIrScalars()
        } else if id == bkSecStrPool {
            bkLdStrPool = bkReadStrPool()
        } else if id == bkSecLowCounters {
            bkReadLowCounters()
        } else if id == bkSecCheckerSymbols {
            bkReadCheckerSymbols()
        } else if id == bkSecDeclFileTab {
            bkLoadedDeclFileTab = bkReadIntList()
        } else if id == bkSecUitestBounds {
            bkReadUitestBounds()
        } else {
            emitDiag(1, 1, "--rtbake: unknown section id " + numToStr(id))
            return false
        }
        if bkLoadPos != expectedPos {
            emitDiag(1, 1, "--rtbake: section " + numToStr(id) + " framing mismatch (corrupt bake)")
            return false
        }
        i = i + 1
    }
    return true
}

// bkLoadRtbake parses buf (the raw --rtbake FILE contents) into the
// bkLd*/bkLoaded* pending globals above, validating the header against
// wantLane (the CURRENT compile's own target -- bkLane68k for emit68k,
// bkLaneC for emit) and against a freshly recomputed stamp. Touches no
// live compiler state -- see bkInstallPool/bkInstallArenas for that.
//
// Stamp contract (this task's open question (a)): the stamp is a hash of
// the committed clarusc/clarusc.c snapshot (bake.cla's own bkHashText/
// bkFindClarusC, Task 3). The loader recomputes that SAME hash the SAME
// way, over the LOADING compiler's own clarusc/clarusc.c, and refuses on
// any mismatch, naming both values -- "regenerate with --bake-ir" is
// always the fix. Known gap, accepted for this phase (see this task's
// report): a dev binary built from EDITED .cla sources still stamps/
// checks against the COMMITTED snapshot, since bkFindClarusC always
// reads clarusc/clarusc.c off disk, never the running binary's own
// (possibly different) source -- both the generator (bake.cla,
// unmodified since Task 3) and this loader share that exact same proxy,
// so a bake generated and loaded by binaries built from the same
// checkout always agree, and the snapshot is regenerated at every phase
// close (CLAUDE.md), keeping drift bounded to "mid-phase, uncommitted
// .cla edits" -- exactly the same caveat any other snapshot-bootstrapped
// tool in this repo already carries.
func bkLoadRtbake(buf: text, wantLane: int): bool {
    var magic: string
    var i: int
    var n: int
    var version: int
    var lane: int
    var stampLen: int
    var stamp: int
    var compilerSrc: text
    var expectStamp: int
    var loadedMods: list of string

    if buf.length < 15 {
        emitDiag(1, 1, "--rtbake: file too short to be a CLIR bake")
        return false
    }
    magic = buf[0, 4]
    if magic != bkMagic {
        emitDiag(1, 1, "--rtbake: bad magic (not a CLIR bake)")
        return false
    }

    bkLoadBuf = buf
    bkLoadPos = 4
    version = bkGetU32()
    if version != bkFormatVersion {
        emitDiag(1, 1, "--rtbake: format version " + numToStr(version) + " unsupported (want " + numToStr(bkFormatVersion) + ")")
        return false
    }
    lane = bkGetByte()
    if lane != wantLane {
        emitDiag(1, 1, "--rtbake: lane mismatch (bake is " + bkLaneName(lane) + ", this compile wants " + bkLaneName(wantLane) + ")")
        return false
    }
    stampLen = bkGetU16()
    if stampLen != 4 {
        emitDiag(1, 1, "--rtbake: unexpected stamp length " + numToStr(stampLen))
        return false
    }
    stamp = bkGetU32()

    compilerSrc = ""
    if bkFindClarusC(compilerSrc) {
        expectStamp = bkHashText(compilerSrc)
    } else {
        expectStamp = 0
    }
    if stamp != expectStamp {
        emitDiag(1, 1, "--rtbake: stamp mismatch (bake=" + numToStr(stamp) + ", this compiler=" + numToStr(expectStamp) + "); regenerate with --bake-ir")
        return false
    }

    // runtime-ir-bake Task 5 (b): retained (not discarded) into
    // bkLoadedModules -- bkComputeManifestPaths (below) turns these
    // module KEYS (rtModuleKey's "runtime/clarus/NAME" form, written by
    // bkWriteFile) into the disk-path identity expand()'s own dedup uses,
    // so a user `include` of one of these SAME files is detected during
    // Phase A instead of silently double-declaring against the baked IR.
    n = bkGetU16()
    i = 0
    while i < n {
        loadedMods.add(bkGetStrShort())
        i = i + 1
    }
    bkLoadedModules = loadedMods

    return bkLoadSections()
}

// bkInstallPool copies the intern-pool prefix into live strPool/strIndex
// -- called by driveCompile BEFORE Phase A (see its own doc comment for
// why: every baked IR arena's string-index fields are absolute strPool
// indices captured at bake time, so nothing may intern() a NEW string
// before this runs, or a user identifier could steal one of those low
// indices out from under the baked arenas). Rebuilds strIndex alongside
// (not just strPool) so a user identifier/literal identical to a baked
// one dedups against it via the ordinary intern() path, the same as any
// other repeated string -- a nice-to-have (avoids pool bloat), not
// load-bearing (nothing downstream iterates strPool/strIndex; every
// consumer is a by-index poolGet or a by-value map lookup, per this
// task's report).
func bkInstallPool() {
    var freshIndex: map of int
    var i: int

    strPool = bkLdStrPool
    freshIndex = driveFreshIntMap()
    strIndex = freshIndex
    i = 0
    while i < strPool.count {
        strIndex[strPool[i]] = i
        i = i + 1
    }
}

// bkInstallTypeArenaPrefix (Task 5, deliverable (a)): testapi-only --
// replaces the just-checkReset()'d typeArena/enumMembers with the baked
// versions (Task 4's retained bkLoadedTypeArena/bkLoadedEnumMembers),
// BEFORE the user program's own checkPhase1 creates any type of its own
// -- the same "install a verbatim-identical prefix, so baked indices
// stay valid, before anything else can intern/allocate on top of it"
// discipline bkInstallPool already uses for strPool, applied here to
// typeArena instead.
//
// Why this is needed at all (found the hard way, via a real crash): NOT
// every type is a checkReset()-seeded singleton at a fixed low index --
// typesInit() only pre-seeds ~11 kind-only singletons (int/bool/fixed/
// char/text/void/address/ptr/error/callback + the saveChoice enum);
// TyStr (`string`) is NOT among them (types.cla's typesInit, directly
// read) -- it gets its own fresh typeArena entry on first use, so its
// INDEX depends on how many other types were interned before it in THIS
// PARTICULAR process. UiTestVerb and five of its own siblings take a
// `string` parameter -- their baked FuncSig.params entries are baked-
// PROCESS-specific indices, invalid against a live compile's own
// (much smaller, freshly checkReset()'d) typeArena. bkInstallCheckerSym
// bolsForTestapi's own fresh-FuncSig construction copies those baked
// indices verbatim (by design -- see its own doc comment on why that's
// safe for TRUE singletons), so this install has to run first, or
// typeKind(pt) on a copied-but-invalid index reads out of bounds
// (verified: "runtime error: list index out of range", reproduced with a
// --testapi bake fixture that actually CALLS UiTestVerb, not just
// declares a window -- tickprobe.cla's own fixture never calls any
// UiTest* function, which is why it never tripped this).
//
// Safe by the identical determinism argument bkInstallPool's own doc
// comment already makes for strPool: typesInit()'s singleton seeding is
// unconditional and first (typesReset -> typesInit, called at the very
// top of checkReset(), before ANYTHING else in this compile could
// intern/allocate a type) in BOTH the bake generator's own checkReset()
// call and this compile's -- so the baked typeArena's own FIRST ~11
// entries are BYTE-IDENTICAL to what this compile's checkReset() just
// built, and REPLACING (not appending to) the just-built array with the
// baked one is exactly "the singleton prefix, then more" -- never a
// mismatch. enumMembers travels the same way (seedSaveChoice, called
// from the SAME typesInit(), is equally deterministic).
func bkInstallTypeArenaPrefix() {
    typeArena = bkLoadedTypeArena
    enumMembers = bkLoadedEnumMembers
}

// bkComputeManifestPaths (Task 5, deliverable (b)) builds bkManifestPaths
// -- the disk-path identity expand()'s own hostPaths branch would compute
// for each baked runtime module (normalizePath(joinPath(rtDir, NAME)),
// bare NAME recovered by stripping rtModuleKey("")'s own fixed prefix off
// each retained "runtime/clarus/NAME" key) -- so a user `include` of one
// of these SAME files collides during Phase A's own expand() calls
// (drive.cla's new haveRtbake-gated check) instead of silently double-
// declaring against the baked IR. Resolves rtDir the same lazy-fill-once
// way bakeGenerateChain/driveManifestSplice already do, so a --rtdir
// override (or its absence) is honored identically. Called once, right
// after bkInstallPool, before Phase A parses any user entries.
func bkComputeManifestPaths() {
    var i: int
    var prefixLen: int
    var bareMod: string
    var p: string
    var m: map of bool

    if bkLoadedModules.count == 0 {
        bkManifestPaths = m
        return
    }
    prefixLen = rtModuleKey("").length
    if not haveRtDir {
        rtDir = findRtDir(bkLoadedModules[0][prefixLen, bkLoadedModules[0].length - prefixLen])
    }
    i = 0
    while i < bkLoadedModules.count {
        bareMod = bkLoadedModules[i][prefixLen, bkLoadedModules[i].length - prefixLen]
        p = normalizePath(joinPath(rtDir, bareMod))
        m[p] = true
        i = i + 1
    }
    bkManifestPaths = m
}

// bkInstallArenas is the second install step -- called by driveCompile
// AFTER check#1 (so the retained-but-uninstalled checker-symbol state
// above can never influence check#1's own diagnostics for user code --
// this task's open question (b)) and BEFORE the bake-path lowerProgram
// call, immediately after irReset() has just cleared every arena this
// function is about to overwrite ("install = deserialize into the
// just-reset arenas," the brief's own contract).
//
// The eight reverse-waist dispatcher stubs (clar_ui_fire_winevent and
// its seven siblings, lower.cla's lowSynthUiDispatchers) used to need a
// by-name install-time filter here (Task 4's own original design): the
// runtime-only bake generator built them against an always-empty/false
// irWindowDescs/irMenuDescs/irEveryCount/irHasStartEmpty/
// irHasOpenDocument, so their baked bodies were permanently the
// no-handler stub shape -- never this program's real one -- and had to
// be dropped so the REAL per-compile lowerProgram(combined2) call's own
// (unconditional) dispatcher rebuild could claim their names fresh.
// Task 5 fix round 1 removed the filter instead: bake.cla's own
// generator now sets lower.cla's lowSkipUiDispatchers around both its
// lowerProgram calls, so the baked arenas never contain these eight
// entries (or their panic-message string literals) AT ALL -- there is
// nothing left to filter. Verified nothing else in bkInstallArenas or
// bake.cla depended on the removed skip list before deleting it.
// testapi (Task 5, inherited-problem fix): when false, irFuncs and
// irStrLits are truncated back to the base/uitest boundary
// (bkLdBaseIrFuncsCount/bkLdBaseIrStrLitsCount, bkSecUitestBounds) BEFORE
// the dispatcher-name filter below runs, dropping uitest.cla's own
// functions and string literals entirely -- exactly what a from-source
// non-testapi compile has (it never splices uitest.cla in the first
// place, bakeModuleList's own doc comment), closing the byte-identity gap
// Task 4's report root-caused (cg68k.cla's single-segment shortcut and
// cprint.cla's string-literal-pool printer both walk irStrLits by
// PRESENCE, not shake reachability). testapi=true installs both arenas in
// full, unchanged from Task 4's own behavior -- a from-source --testapi
// build ALSO always carries uitest.cla (driveEarlySplice), so there is no
// gap to close on that path.
func bkInstallArenas(testapi: bool) {
    var i: int
    var filteredIdx: intmap of int
    var nm: int
    var srcFuncs: list of IRFunc
    var srcStrLits: list of int
    var truncFuncs: list of IRFunc
    var truncStrLits: list of int

    irTypes = bkLdIrTypes
    irStmts = bkLdIrStmts
    irExprs = bkLdIrExprs
    irLocals = bkLdIrLocals

    srcFuncs = bkLdIrFuncs
    srcStrLits = bkLdIrStrLits
    if not testapi {
        i = 0
        while i < bkLdIrFuncs.count and i < bkLdBaseIrFuncsCount {
            truncFuncs.add(bkLdIrFuncs[i])
            i = i + 1
        }
        srcFuncs = truncFuncs
        i = 0
        while i < bkLdIrStrLits.count and i < bkLdBaseIrStrLitsCount {
            truncStrLits.add(bkLdIrStrLits[i])
            i = i + 1
        }
        srcStrLits = truncStrLits
    }

    // No by-name filter needed any more (see this function's own doc
    // comment) -- srcFuncs (already truncated above for non-testapi)
    // installs verbatim; irFuncIdxByName still needs its own fresh
    // build (not a straight copy of the loaded map) since a non-testapi
    // truncation drops entries the loaded map's own indices would still
    // reference.
    irFuncs = srcFuncs
    i = 0
    while i < irFuncs.count {
        nm = irFuncs[i].name
        if not filteredIdx.has(nm) {
            filteredIdx[nm] = i
        }
        i = i + 1
    }
    irFuncIdxByName = filteredIdx

    irCbGlueNames = bkLdIrCbGlueNames
    irGlobals = bkLdIrGlobals
    irFieldSlots = bkLdIrFieldSlots
    irRecords = bkLdIrRecords
    irEnumMembers = bkLdIrEnumMembers
    irEnums = bkLdIrEnums
    irWidgetDescs = bkLdIrWidgetDescs
    irColumnDescs = bkLdIrColumnDescs
    irBindDescs = bkLdIrBindDescs
    irWindowDescs = bkLdIrWindowDescs
    irMenuItemDescs = bkLdIrMenuItemDescs
    irMenuDescs = bkLdIrMenuDescs
    irWinHandlers = bkLdIrWinHandlers
    irWidgetHandlerEntries = bkLdIrWidgetHandlerEntries
    irMenuHandlerEntries = bkLdIrMenuHandlerEntries
    irEveryEntries = bkLdIrEveryEntries
    irStrLits = srcStrLits
    irExternNames = bkLdIrExternNames
    irExternRetTys = bkLdIrExternRetTys
    irExternParamStart = bkLdIrExternParamStart
    irExternParamCountArr = bkLdIrExternParamCountArr
    irExternParamTys = bkLdIrExternParamTys
    irExternTrapWords = bkLdIrExternTrapWords
    irExternConvs = bkLdIrExternConvs
    irExternSels = bkLdIrExternSels
    irExternParamRegs = bkLdIrExternParamRegs
    irExternRetRegs = bkLdIrExternRetRegs
    irLayoutNeededByName = bkLdIrLayoutNeededByName
    irRcWalkNeededByName = bkLdIrRcWalkNeededByName

    irHasLaunch = bkLdIrHasLaunch
    irHasStartEmpty = bkLdIrHasStartEmpty
    irHasStartCLI = bkLdIrHasStartCLI
    irHasOpenDocument = bkLdIrHasOpenDocument
    irAppName = bkLdIrAppName
    irAppVersion = bkLdIrAppVersion
    irAppAuthor = bkLdIrAppAuthor
    irAppAbout = bkLdIrAppAbout
    irAppId = bkLdIrAppId
    irAppDoctype = bkLdIrAppDoctype
    irAppStack = bkLdIrAppStack
    irHasApp = bkLdIrHasApp
    irMenuHandlersHead = bkLdIrMenuHandlersHead
    irMenuHandlersTail = bkLdIrMenuHandlersTail
    irMenuHandlerCount = bkLdIrMenuHandlerCount
    irEveryHead = bkLdIrEveryHead
    irEveryTail = bkLdIrEveryTail
    irEveryCount = bkLdIrEveryCount
    irVoidT = bkLdIrVoidT
    irIntT = bkLdIrIntT
    irBoolT = bkLdIrBoolT
    irFixedT = bkLdIrFixedT
    irCharT = bkLdIrCharT
    irTextT = bkLdIrTextT
    irErrT = bkLdIrErrT
    irPtrT = bkLdIrPtrT
    irWordT = bkLdIrWordT

    lowSwitchN = bkLdLowSwitchN
    uiMenuCount = bkLdUiMenuCount
    lowStoreTempN = bkLdLowStoreTempN
    lowRetTempN = bkLdLowRetTempN
    lowStrIdx = bkLdLowStrIdx
}

// ================================================================
// --testapi checker-symbol preload (Task 5, deliverables (a)/(c))
// ================================================================

// bkUitestTestapiNames: uitest.cla's own user-facing UiTest* surface --
// UiTestVerb plus every wrapper, and UiTestChecksum (runtime/clarus/
// uitest.cla's own top doc comment) -- rtUiTestIntToStr is a private
// helper (not "UiTest*"-named, never meant for a test program to call
// directly) and is deliberately excluded. Hardcoded rather than derived
// from the bake's own module boundaries: uitest.cla is a small, curated,
// rarely-changed test-API surface (the SAME "hardcode the known name set"
// precedent bkInstallArenas' own eight-dispatcher skip list already
// uses), and every SIGNATURE is still read back from the bake itself
// (bkInstallCheckerSymbolsForTestapi below), so a change to an EXISTING
// name's params/return type is picked up automatically -- only adding or
// renaming a UiTest* function needs this list updated too.
// ponytail: a name-list ceiling, not a derived-from-bake one; upgrade to
// a real module-boundary scan (mirroring drivePathIsUitest's declFileTab
// walk) if uitest.cla's surface starts changing often enough for this to
// go stale.
func bkUitestTestapiNames(): list of string {
    var names: list of string

    names.add("UiTestVerb")
    names.add("UiTestClick")
    names.add("UiTestDblClick")
    names.add("UiTestKey")
    names.add("UiTestType")
    names.add("UiTestMenu")
    names.add("UiTestClose")
    names.add("UiTestResize")
    names.add("UiTestZoom")
    names.add("UiTestAnswerOpen")
    names.add("UiTestAnswerSave")
    names.add("UiTestAnswerChanges")
    names.add("UiTestAnswerCancel")
    names.add("UiTestAnswerPopup")
    names.add("UiTestTick")
    names.add("UiTestChecksum")
    return names
}

// bkFindUitestPathIdx scans the retained bkLoadedDeclFileTab (Task 4's own
// "at minimum load and retain" floor -- this is Task 5's consumer) for
// the first decl attributed to uitest.cla, returning its interned path-
// pool index (valid against the LIVE strPool once bkInstallPool has run,
// since a baked path-pool index is a plain prefix offset into the SAME
// pool). Returns -1 if the bake somehow carries no uitest.cla decls at
// all (bakeModuleList always includes it, so this should never happen in
// practice -- callers treat -1 defensively, not as a hard error).
func bkFindUitestPathIdx(): int {
    var i: int

    i = 0
    while i < bkLoadedDeclFileTab.count {
        if drivePathIsUitest(bkLoadedDeclFileTab[i]) {
            return bkLoadedDeclFileTab[i]
        }
        i = i + 1
    }
    return -1
}

// bkInstallCheckerSymbolsForTestapi (Task 5, deliverables (a)/(c)): for
// each of uitest.cla's own UiTest* names, looks it up BY NAME in the
// baked topScope (Task 4's retained bkLoadedScopes/bkLoadedSymbols/
// bkLoadedFuncSigs -- loaded, never installed, until now), builds a FRESH
// live FuncSig+Symbol from the baked one's fields (every field is either
// a primitive scalar type index -- valid verbatim, since checkReset's own
// typesReset bootstrap creates the same singleton primitives at the same
// low indices on every compile, baked or live, and uitest.cla's own
// signatures use nothing else, confirmed by direct read of runtime/
// clarus/uitest.cla -- or a plain bool/int flag, also copied verbatim),
// and scopeDeclare()s it into the LIVE topScope. Caller's contract
// (checkReset already ran, topScope is otherwise still empty): call this
// AFTER the user program's own checkPhase1 (so a user top-level decl that
// legitimately shadows a UiTest* name wins the ordinary "declared first,
// in this scope, keeps it" rule -- scopeDeclare's own doc comment) but
// BEFORE checkPhase2 (so a user function body calling UiTestVerb etc.
// still resolves it -- phase 2 needs every top-level name, user's own AND
// these, already declared). A declare collision (the user's own code
// already claimed a UiTest* name) is diagnosed HERE, attributed to
// uitest.cla itself via curPathIdx set from bkFindUitestPathIdx's own
// baked declFileTab lookup -- the "runtime-attributed diagnostic"
// deliverable (c) asks for: check-time is the ONLY class reachable on the
// bake path (the runtime is pre-lowered; no LOWERING diagnostic can ever
// arise for baked content again -- task-5-report.md says so explicitly).
func bkInstallCheckerSymbolsForTestapi() {
    var names: list of string
    var uitestPath: int
    var savedPath: int
    var i: int
    var nm: int
    var symIdx: int
    var bakedSym: Symbol
    var bakedSig: FuncSig
    var freshSym: Symbol
    var freshSigIdx: int
    var freshParams: list of int
    var j: int
    var topNames: intmap of int

    names = bkUitestTestapiNames()
    uitestPath = bkFindUitestPathIdx()
    savedPath = curPathIdx
    if bkLoadedScopes.count <= topScope {
        return
    }
    topNames = bkLoadedScopes[topScope].names

    i = 0
    while i < names.count {
        nm = intern(names[i])
        symIdx = topNames.get(nm, -1)
        if symIdx != -1 and symIdx < bkLoadedSymbols.count {
            bakedSym = bkLoadedSymbols[symIdx]
            bakedSig = bkLoadedFuncSigs[bakedSym.sigIdx]
            // newFuncSig's own doc comment: "list of T is a handle --
            // aliasing it into two FuncSigs would be a checker bug." A
            // FRESH list handle every iteration (driveFreshIntList(), not
            // a `.clear()`'d reuse of one outer local -- reusing one
            // handle across iterations would alias EVERY earlier
            // iteration's already-stored FuncSig.params to this same
            // list too, corrupting all of them the next time it's
            // cleared), copied element-by-element from bakedSig.params
            // rather than assigned directly, so each fresh FuncSig owns
            // its own independent params list.
            freshParams = driveFreshIntList()
            j = 0
            while j < bakedSig.params.count {
                freshParams.add(bakedSig.params[j])
                j = j + 1
            }
            freshSigIdx = newFuncSig(freshParams, bakedSig.ret)
            freshSym = bakedSym
            freshSym.sigIdx = freshSigIdx
            curPathIdx = uitestPath
            if not scopeDeclare(topScope, freshSym) {
                emitDiag(1, 1, names[i] + " redeclared (a runtime UiTest* name; --testapi makes it a reserved identifier)")
            }
            curPathIdx = savedPath
        }
        i = i + 1
    }
}

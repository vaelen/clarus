        bkPutU32(sec, irStmts[i].b)
        bkPutU32(sec, irStmts[i].c)
        bkPutU32(sec, irStmts[i].next)
        bkPutU32(sec, irStmts[i].nameIdx)
        bkPutU32(sec, irStmts[i].intVal)
        i = i + 1

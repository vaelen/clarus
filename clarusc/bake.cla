}

// bkWriteIrScalars: the plain-scalar half of irReset() -- program flags,
// app-decl fields (always their zero/absent value for a pure runtime
// bake, since the runtime chain declares no `app` section), the menu/
// every chain heads, and the singleton IRType indices (irVoidT..irWordT),
// in irReset()'s own assignment order. The loader re-derives nothing
// here; these ARE the values a runtime-only lowerProgram produced.
func bkWriteIrScalars(): text {
    var sec: text

    bkPutBool(sec, irHasLaunch)
    bkPutBool(sec, irHasStartEmpty)
    bkPutBool(sec, irHasStartCLI)
    bkPutBool(sec, irHasOpenDocument)
    bkPutU32(sec, irAppName)
    bkPutU32(sec, irAppVersion)
    bkPutU32(sec, irAppAuthor)
    bkPutU32(sec, irAppAbout)
    bkPutU32(sec, irAppId)
    bkPutU32(sec, irAppDoctype)
    bkPutU32(sec, irAppStack)
    bkPutBool(sec, irHasApp)
    bkPutU32(sec, irMenuHandlersHead)
    bkPutU32(sec, irMenuHandlersTail)
    bkPutU32(sec, irMenuHandlerCount)
    bkPutU32(sec, irEveryHead)
    bkPutU32(sec, irEveryTail)
    bkPutU32(sec, irEveryCount)
    bkPutU32(sec, irVoidT)
    bkPutU32(sec, irIntT)
    bkPutU32(sec, irBoolT)
    bkPutU32(sec, irFixedT)
    bkPutU32(sec, irCharT)
    bkPutU32(sec, irTextT)
    bkPutU32(sec, irErrT)
    bkPutU32(sec, irPtrT)
    bkPutU32(sec, irWordT)
    return sec
}

// ================================================================
// Non-arena blocks
// ================================================================

// bkWriteStrPool: the intern pool (lib.cla's strBlob/strOff), verbatim,
// length-prefixed per entry -- user parsing interns on top of this at
// load time (append-only, so baked indices never move).
func bkWriteStrPool(): text {
    var sec: text
    var i: int

    bkGenPoolCount = poolCount()
    bkPutU32(sec, poolCount())
    i = 0
    while i < poolCount() {
        bkPutStr(sec, poolGet(i))
        i = i + 1
    }
    return sec
}

// bkWriteLowCounters: lowering's program-wide counters (lower.cla) --
// end values so user lowering continues numbering where the bake
// stopped, plus lowStrIdx (string-literal-by-VALUE dedup map) so a user
// literal identical to a runtime one reuses the same clar_lit_K slot.
// The ~162 lazy-intern iXxxIdx scalars, lowTitleIdx, and the always-
// empty progGen-namespaced maps (uiMenuIdx/uiMenuItemIdx/
// uiWinHandlersIdx/winVarDefaults*) are NOT here -- task-1-report.md
// section (b) is explicit that all of those are reset-on-load /
// irrelevant-while-empty, not bake state.
func bkWriteLowCounters(): text {
    var sec: text
    var m: map of int
    var k: string
    var v: int

    bkPutU32(sec, lowSwitchN)
    bkPutU32(sec, uiMenuCount)
    bkPutU32(sec, lowStoreTempN)
    bkPutU32(sec, lowRetTempN)
    m = lowStrIdx
    bkPutU32(sec, m.count)
    for k, v in m {
        bkPutStr(sec, k)
        bkPutU32(sec, v)
    }
    return sec
}

// bkWriteCheckerSymbols: the runtime's checker symbol state (types.cla/
// check.cla), used ONLY on the --testapi path (task-1-report.md section
// (b)) -- funcSigs, symbols, scopes, typeArena, enumMembers, each self-
// delimited by its own leading count, in that fixed order.
func bkWriteCheckerSymbols(): text {
    var sec: text
    var i: int
    var j: int
    var names: intmap of int
    var k: int
    var v: int

    bkPutU32(sec, funcSigs.count)
    i = 0
    while i < funcSigs.count {
        bkPutU32(sec, funcSigs[i].params.count)
        j = 0
        while j < funcSigs[i].params.count {
            bkPutU32(sec, funcSigs[i].params[j])
            j = j + 1
        }
        bkPutU32(sec, funcSigs[i].ret)
        i = i + 1
    }

    bkPutU32(sec, symbols.count)
    i = 0
    while i < symbols.count {
        bkPutU32(sec, symbols[i].nameIdx)
        bkPutU32(sec, symbols[i].typeIdx)
        bkPutBool(sec, symbols[i].isFunc)
        bkPutU32(sec, symbols[i].sigIdx)
        bkPutBool(sec, symbols[i].isType)
        bkPutBool(sec, symbols[i].isConst)
        bkPutBool(sec, symbols[i].isParam)
        bkPutBool(sec, symbols[i].constIsStr)
        bkPutU32(sec, symbols[i].constInt)
        bkPutU32(sec, symbols[i].constStrIdx)
        bkPutBool(sec, symbols[i].isMenu)
        bkPutBool(sec, symbols[i].isExtern)
        bkPutBool(sec, symbols[i].isCallback)
        i = i + 1
    }

    bkPutU32(sec, scopes.count)
    i = 0
    while i < scopes.count {
        bkPutU32(sec, scopes[i].parent)
        names = scopes[i].names
        bkPutU32(sec, names.count)
        for k, v in names {
            bkPutU32(sec, k)
            bkPutU32(sec, v)
        }
        i = i + 1
    }

    bkPutU32(sec, typeArena.count)
    i = 0
    while i < typeArena.count {
        bkPutU32(sec, int(typeArena[i].kind))
        bkPutU32(sec, typeArena[i].n)
        bkPutU32(sec, typeArena[i].elem)
        bkPutU32(sec, typeArena[i].nameIdx)
        i = i + 1
    }

    bkPutU32(sec, enumMembers.count)
    i = 0
    while i < enumMembers.count {
        bkPutU32(sec, enumMembers[i].nameIdx)
        bkPutU32(sec, enumMembers[i].value)
        bkPutU32(sec, enumMembers[i].labelIdx)
        i = i + 1
    }

    return sec
}

// bkWriteFieldInfo (format version 5, fallback-trigger-narrowing Task 2):
// check.cla's own record-field side tables, verbatim -- fieldInfos (the
// FieldInfo arena, index-linked via .next) then recFieldsHeadByName (the
// record-name -> fieldInfos-head map), each self-delimited by its own
// leading count, matching bkWriteCheckerSymbols' own field-order
// convention. See bkSecFieldInfo's own doc comment for why this exists.
func bkWriteFieldInfo(): text {
    var sec: text
    var i: int
    var k: int
    var v: int

    bkPutU32(sec, fieldInfos.count)
    i = 0
    while i < fieldInfos.count {
        bkPutU32(sec, fieldInfos[i].nameIdx)
        bkPutU32(sec, fieldInfos[i].typeIdx)
        bkPutU32(sec, fieldInfos[i].next)
        i = i + 1
    }

    bkPutU32(sec, recFieldsHeadByName.count)
    for k, v in recFieldsHeadByName {
        bkPutU32(sec, k)
        bkPutU32(sec, v)
    }

    return sec
}

// bkWriteDeclFileTab: lib.cla's declFileTab (decl-arena-index ->
// interned source-path index), verbatim -- the curPathIdx stamp table
// the brief's format block names, so a runtime-attributed diagnostic/
// panic at use time can still name the right runtime source file.
func bkWriteDeclFileTab(): text {
    var sec: text
    var i: int

    bkPutU32(sec, declFileTab.count)
    i = 0
    while i < declFileTab.count {
        bkPutU32(sec, declFileTab[i])
        i = i + 1
    }
    return sec
}

// bkWriteUitestBounds (format version 2, Task 5): the base/uitest IR-arena
// boundary counts bakeGenerateChain captured -- see bkSecUitestBounds' own
// doc comment.
func bkWriteUitestBounds(): text {
    var sec: text

    bkPutU32(sec, bkGenBaseIrFuncsCount)
    bkPutU32(sec, bkGenBaseIrStrLitsCount)
    bkPutU32(sec, bkGenBaseIrArrLitsCount)
    bkPutU32(sec, bkGenUilogIrStrLitsStart)
    return sec
}

// bkWriteCheckerVisibility (format version 3, Task 5 fix round 2): the
// testapi-visible checker-symbol boundary -- see bkSecCheckerVisibility's
// own doc comment.
func bkWriteCheckerVisibility(): text {
    var sec: text

    bkPutU32(sec, bkGenEarlyFuncSigsCount)
    bkPutU32(sec, bkGenEarlySymbolsCount)
    return sec
}

// bkWriteManifestHashes (format version 5, fallback-trigger-narrowing
// Task 2): the drift guard's per-manifest-path source hash + early-
// visibility flag, one entry per DISTINCT file bakeGenerateChain's own
// expand() calls touched -- walking asmHeads (0..count), not
// bakeModuleList, so nested includes (toolbox/files.cla via
// uidialogs.cla, etc.) get their own entry exactly like the eighteen
// top-level modules do, with no separate pass needed. Each file's own
// path comes from declFileTab[asmHeads[i]] (setDeclFile stamped every
// decl in that file with the same pathIdx during Phase A) -- the SAME
// disk-path identity bkComputeManifestPaths' own second loop already
// uses to build bkManifestPaths, so this map's keys match that map's
// keys one-for-one. Hashes the file straight off disk (bkHashText over
// file.readText's own bytes), not any live buffer -- this runs once, at
// --bake-ir time, not on any per-user-compile hot path (drive.cla's own
// collision branch reuses ITS OWN already-read bytes instead of
// re-reading -- see its own doc comment). Early-visible iff i is below
// bkGenEarlyVisibleAsmHeadsBoundary, mirroring bkGenEarlyFuncSigsCount/
// bkGenEarlySymbolsCount's own split exactly.
func bkWriteManifestHashes(): text {
    var sec: text
    var entries: text
    var count: int
    var i: int
    var p: string
    var src: text
    var seen: map of bool

    entries = ""
    count = 0
    i = 0
    while i < asmHeads.count {
        if asmHeads[i] != -1 {
            p = poolGet(getDeclFile(asmHeads[i]))
            if not seen.has(p) {
                seen[p] = true
                src = ""
                if file.readText(p, src) {
                    bkPutStrShort(entries, p)
                    bkPutU32(entries, bkHashText(src))
                    bkPutBool(entries, i < bkGenEarlyVisibleAsmHeadsBoundary)
                    count = count + 1
                }
            }
        }
        i = i + 1
    }

    sec = ""
    bkPutU32(sec, count)
    sec.append(entries)
    return sec
}

// bkCorruptObjCodeTestOnly (object-code-linker Task 2): set by main.cla's
// own undocumented `--bake-ir --corrupt-objcode-testonly` flag --
// bkWriteObjCode, when true, overwrites the first call-kind hole's reloc
// symbol in EVERY function with an impossibly large value, so
// tests/bake/refuse_objcode.sh gets a structurally-valid library whose
// reloc symbols are genuinely out of range. Every function, not just the
// first (format v9): a compile validates only the object code it reads,
// which is its reachable functions', so the fixture must be corrupt
// wherever the test program reaches -- never used outside that one test.
var bkCorruptObjCodeTestOnly: bool

// bkEmptyObjCodeTestOnly (SE wave 4 final review): set by main.cla's
// undocumented `--bake-ir --empty-objcode-testonly` flag -- bkWriteObjCode
// then writes every record empty (a well-formed index with no valid
// function), so tests/bake/refuse_objcode.sh and resident_fallback.sh can
// drive cg68k.cla's cgObjLibMissing guard. Never used outside those tests.
var bkEmptyObjCodeTestOnly: bool

// bkWriteObjCode (format v9; v6 object-code-linker Task 2) -- bkSecObjCode:
//   count(4) | off(4) x (count + 1) | data
// The index: per irFuncs-index function, its record's offset into `data`,
// plus a closing sentinel (data's length) -- records are contiguous, so
// function f's record is data[off[f] .. off[f+1]), empty when f was not
// captured valid (lib.cla's strBlob/strOff convention). A record is the
// function's captured post-peephole byte runs interleaved with typed hole
// records -- nHoles(4) then run[0],hole[0],...,hole[n-1],run[n], a run
// being len(4)+bytes and a hole bkObjHoleBytes bytes (kind, cls, sym(4),
// op, size, sm, sr, sv(4), dm, dr, dv(4), srcSlot; cg68k.cla's CgObjHole).
// Records are laid out in function order, so a compile's reachable
// neighbours read as one span (bkLoadObjCode). Reads cg68k.cla's live
// cgObj* capture globals; lane c (no capture) writes count 0.
func bkWriteObjCode(lane: int): text {
    var sec: text
    var data: text
    var offs: list of int
    var count: int
    var i: int
    var k: int
    var h: CgObjHole
    var corruptedOne: bool
    var sym: int

    // Bound by irFuncs.count, not cgObjValid.count directly: cg68Measure/
    // cg68ProgramFork run AFTER cg68SynthCbGlue inside cgObjCaptureRuntime,
    // so cgObjValid was sized to a LARGER, transient irFuncs.count that
    // briefly included synthesized callback-glue trampolines --
    // cgObjCaptureRuntime restores irFuncs (and irFuncIdxByName) back to
    // its pre-synthesis size before returning, but leaves cgObjValid/
    // cgFuncSize-family at their larger capture-time size. Every
    // reference INTO a trampoline was already captured symbolically
    // (cgHoleCbGlueAddr, never a raw index into that dropped tail), so
    // truncating the OUTER per-function count here is enough -- see
    // cgObjRecordHole's own doc comment.
    count = 0
    if lane == bkLane68k {
        count = irFuncs.count
    }
    i = 0
    while i < count {
        offs.add(data.length)
        if cgObjValid[i] and not bkEmptyObjCodeTestOnly {
            bkPutU32(data, cgObjNHoles[i])
            corruptedOne = false
            k = 0
            while k <= cgObjNHoles[i] {
                bkPutBytes(data, cgObjRunText(cgObjRunFirst[i] + k))
                if k < cgObjNHoles[i] {
                    h = cgObjHoles[cgObjHoleFirst[i] + k]
                    bkPutByte(data, h.kind)
                    bkPutByte(data, h.cls)
                    sym = h.sym
                    if bkCorruptObjCodeTestOnly and not corruptedOne and h.kind == cgHoleCall {
                        sym = 999999999
                        corruptedOne = true
                    }
                    bkPutU32(data, sym)
                    bkPutByte(data, h.op)
                    bkPutByte(data, h.size)
                    bkPutByte(data, h.sm)
                    bkPutByte(data, h.sr)
                    bkPutU32(data, h.sv)
                    bkPutByte(data, h.dm)
                    bkPutByte(data, h.dr)
                    bkPutU32(data, h.dv)
                    bkPutBool(data, h.srcSlot)
                }
                k = k + 1
            }
        }
        i = i + 1
    }
    offs.add(data.length)
    bkPutU32(sec, count)
    i = 0
    while i <= count {
        bkPutU32(sec, offs[i])
        i = i + 1
    }
    sec.append(data)
    return sec
}

// bkWriteObjMeta (format v6, object-code-linker Task 2): bkSecObjMeta --
// what cg68Measure computes for the runtime-only universe, captured for
// every irFuncs index by the SAME cgObjCaptureRuntime call
// bkWriteObjCode reads from (its own internal cg68ProgramFork call runs
// cg68Measure as its first step): per-function size/frame-size/pool-ref
// sets/UI-pool flags, plus the three once-per-artifact fixed-cost
// buckets and the five per-pool-entry size tables cgPackProgram needs so
// a future compile's own Measure pass can skip re-deriving them from a
// baked function at all (Task 3). Reads cg68k.cla's live globals
// directly; lane c writes count 0 plus zeroed fixed buckets/empty
// per-pool-entry tables (never meaningful on that lane).
func bkWriteObjMeta(lane: int): text {
    var sec: text
    var count: int
    var i: int
    var k: int
    var strLits: list of int

    // See bkWriteObjCode's own comment for why this is irFuncs.count,
    // not cgFuncSize.count directly.
    count = 0
    if lane == bkLane68k {
        count = irFuncs.count
    }
    sec = ""
    bkPutU32(sec, count)
    i = 0
    while i < count {
        bkPutU32(sec, cgFuncSize[i])
        bkPutU32(sec, cgFuncFrameSizes[i])
        // Amendment A2 (also load-bearing here, not just for the hole
        // table, bkWriteObjCode): cgReservePanicMsgs appends
        // cgListOobMsgIdx to the LIVE irStrLits AFTER bkSecIrStrLits was
        // already serialized (bakeWriteFile's own capture-runs-last
        // ordering), so it is not a valid index into the INSTALLED
        // irStrLits at compile time either -- a function needing the
        // panic message (nat_UiSFGetFile in the corpus) must not name it
        // here by its bake-time-only numeric index, same reasoning as
        // the reloc hole's own cgRelClsPanicMsg substitution. Silently
        // dropped rather than reloc'd: this list only drives
        // cgPackProgram's own per-segment pool NEED-set (which entries
        // to duplicate where), and the panic message is a fixed,
        // always-available runtime literal a future link pass can
        // simply always include, needing no per-function bookkeeping.
        strLits = driveFreshIntList()
        k = 0
        while k < cgFuncPoolCount(i, cgPoolKStr) {
            if cgFuncPoolAt(i, cgPoolKStr, k) != cgListOobMsgIdx {
                strLits.add(cgFuncPoolAt(i, cgPoolKStr, k))
            }
            k = k + 1
        }
        bkPutU32(sec, strLits.count)
        k = 0
        while k < strLits.count {
            bkPutU32(sec, strLits[k])
            k = k + 1
        }
        bkPutU32(sec, cgFuncPoolCount(i, cgPoolKEnum))
        k = 0
        while k < cgFuncPoolCount(i, cgPoolKEnum) {
            bkPutU32(sec, cgFuncPoolAt(i, cgPoolKEnum, k))
            k = k + 1
        }
        bkPutU32(sec, cgFuncPoolCount(i, cgPoolKSerdesc))
        k = 0
        while k < cgFuncPoolCount(i, cgPoolKSerdesc) {
            bkPutU32(sec, cgFuncPoolAt(i, cgPoolKSerdesc, k))
            k = k + 1
        }
        bkPutBool(sec, cgFuncUsesUiBlob[i])
        bkPutBool(sec, cgFuncUsesUiEvents[i])
        i = i + 1
    }

    if lane == bkLane68k {
        bkPutU32(sec, cgSeg1ExtraSize)
        bkPutU32(sec, cgGlueBundleSize)
        bkPutU32(sec, cgPoolSize)
        bkPutU32(sec, cgStrLitSize.count)
        k = 0
        while k < cgStrLitSize.count {
            bkPutU32(sec, cgStrLitSize[k])
            k = k + 1
        }
        bkPutU32(sec, cgEnumTableSize.count)
        k = 0
        while k < cgEnumTableSize.count {
            bkPutU32(sec, cgEnumTableSize[k])
            k = k + 1
        }
        bkPutU32(sec, cgSerdescSize.count)
        k = 0
        while k < cgSerdescSize.count {
            bkPutU32(sec, cgSerdescSize[k])
            k = k + 1
        }
        bkPutU32(sec, cgUiBlobSize)
        bkPutU32(sec, cgUiEventsSize)
    } else {
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
        bkPutU32(sec, 0)
    }
    return sec
}

// ================================================================
// Top-level orchestrator
// ================================================================

// bakeWriteFile runs the generator (bakeGenerateChain) for lane, then
// serializes every section into outPath in format v9:
//   magic(4) formatVersion(4) laneTag(1) stampLen(2) stamp
//   moduleCount(2) [keyLen(1) key]... sectionCount(2) [id(2) off(4) len(4)]...
//   payloads, in directory order, tiling the rest of the file
// Offsets are from the start of the library, so a reader can fetch any
// one section with readAt (bkLoadRtbake). Returns false on a checker/
// lowering diagnostic (diags stays populated for the caller to print,
// exactly as driveCompile's own contract) or a write failure (logged
// directly, same as emitMode's own write-failure path in main.cla).
// bkBuildShakeSummary (SE wave 4 Task 2): records, for every generated
// irFuncs body and then every irGlobals init expression, the name sequence
// shake.cla's own walk hands shakeMarkAndEnqueue (shakeRecording mode --
// see shake.cla's summary block). Runs from bkWriteShakeSummary, AFTER
// bkSecStrPool is frozen, so the walk's own lazy intern()s (the
// iXxxIdx intrinsic names, as the capture's shake already does) never
// reach the baked pool. Every RECORDED name must be inside that frozen
// pool, or its index would mean a different string in a user compile --
// refused loudly rather than baked.
func bkBuildShakeSummary() {
    var i: int
    var starts: list of int
    var names: list of int

    shakeRecNames = names
    shakeRecording = true
    starts.add(0)
    i = 0
    while i < irFuncs.count {
        shakeWalkStmts(irFuncBodyHead(i))
        starts.add(shakeRecNames.count)
        i = i + 1
    }
    i = 0
    while i < irGlobals.count {
        shakeWalkExpr(irGlobalInit(i))
        starts.add(shakeRecNames.count)
        i = i + 1
    }
    shakeRecording = false
    bkGenShakeFuncs = irFuncs.count
    bkGenShakeStart = starts
    bkGenShakeNames = shakeRecNames
    shakeRecNames = shakeFreshIntList()
    i = 0
    while i < bkGenShakeNames.count {
        if bkGenShakeNames[i] >= bkGenPoolCount {
            abort("clarusc --bake-ir: shake summary names " + poolGet(bkGenShakeNames[i]) + ", which is not in the baked intern pool")
        }
        i = i + 1
    }
}

func bkWriteShakeSummary(): text {
    var sec: text

    bkBuildShakeSummary()
    bkPutU32(sec, bkGenShakeFuncs)
    sec.append(bkWriteIntList(bkGenShakeStart))
    sec.append(bkWriteIntList(bkGenShakeNames))
    return sec
}

// bkCheckShakeSummary (SE wave 4 Task 2): the bake's self-check that the
// summary equals the IR walk. cgObjCaptureRuntime's shakeProgram just
// walked every rooted runtime body from IR (no summary is installed in the
// bake process) and left its edges in walk order, each walked body's
// edges contiguous. For every baked function that walk marked, its edges
// must be exactly its summary names resolved through the same
// shakeFuncIdxByName (unresolved names record no edge, as in
// shakeMarkAndEnqueue). Aborts the bake on any difference.
func bkCheckShakeSummary() {
    var f: int
    var k: int
    var j: int
    var tgt: int
    var seen: list of bool

    f = 0
    while f < bkGenShakeFuncs {
        seen.add(false)
        f = f + 1
    }
    k = 0
    while k < shakeEdgeCount() {
        f = shakeEdgeFrom(k)
        if f >= bkGenShakeFuncs {
            k = k + 1
        } else {
            if seen[f] {
                abort("clarusc --bake-ir: shake summary check: edges of " + poolGet(irFuncName(f)) + " are not contiguous")
            }
            seen[f] = true
            j = bkGenShakeStart[f]
            while j < bkGenShakeStart[f + 1] {
                tgt = shakeFuncIdxByName.get(bkGenShakeNames[j], -1)
                if tgt != -1 {
                    if k >= shakeEdgeCount() or shakeEdgeFrom(k) != f or shakeEdgeTo(k) != tgt {
                        abort("clarusc --bake-ir: shake summary differs from the IR walk in " + poolGet(irFuncName(f)))
                    }
                    k = k + 1
                }
                j = j + 1
            }
            if k < shakeEdgeCount() and shakeEdgeFrom(k) == f {
                abort("clarusc --bake-ir: shake summary misses an edge of " + poolGet(irFuncName(f)))
            }
        }
    }
    // A walked body with no edges must summarize to no resolvable name.
    f = 0
    while f < bkGenShakeFuncs {
        if shakeReachable(f) and not seen[f] {
            j = bkGenShakeStart[f]
            while j < bkGenShakeStart[f + 1] {
                if shakeFuncIdxByName.get(bkGenShakeNames[j], -1) != -1 {
                    abort("clarusc --bake-ir: shake summary has an edge the IR walk lacks in " + poolGet(irFuncName(f)))
                }
                j = j + 1
            }
        }
        f = f + 1
    }
}

func bakeWriteFile(lane: int, outPath: string): bool {
    var out: text
    var mods: list of string
    var stamp: text
    var compilerSrc: text
    var i: int
    var bodyless: bool
    var hdrLen: int
    var n: int
    var e0: text
    var e1: text
    var localMap: intmap of int
    var exprMap: intmap of int

    if not bakeGenerateChain(lane) {
        return false
    }

    mods = bakeModuleList(lane)
    bodyless = lane == bkLane68k
    if bodyless {
        localMap = bkParamLocalMap()
        exprMap = bkGlobalInitExprMap()
    }
    bkWrBody = e0
    bkWrDir = e1

    bkAddSection(bkSecIrTypes, bkWriteIrTypes())
    if bodyless {
        bkAddSection(bkSecIrLocals, bkWriteParamLocals(localMap))
        bkAddSection(bkSecGlobalInits, bkWriteGlobalInits(exprMap))
    } else {
        bkAddSection(bkSecIrStmts, bkWriteIrStmts())
        bkAddSection(bkSecIrExprs, bkWriteIrExprs())
        bkAddSection(bkSecIrLocals, bkWriteIrLocals())
    }
    bkAddSection(bkSecIrFuncs, bkWriteIrFuncs(bodyless, localMap))
    bkAddSection(bkSecIrFuncIdxByName, bkWriteIrFuncIdxByName())
    bkAddSection(bkSecIrCbGlueNames, bkWriteIrCbGlueNames())
    bkAddSection(bkSecIrGlobals, bkWriteIrGlobals(bodyless, exprMap))
    bkAddSection(bkSecIrFieldSlots, bkWriteIrFieldSlots())
    bkAddSection(bkSecIrRecords, bkWriteIrRecords())
    bkAddSection(bkSecIrEnumMembers, bkWriteIrEnumMembers())
    bkAddSection(bkSecIrEnums, bkWriteIrEnums())
    bkAddSection(bkSecIrWidgetDescs, bkWriteIrWidgetDescs())
    bkAddSection(bkSecIrColumnDescs, bkWriteIrColumnDescs())
    bkAddSection(bkSecIrBindDescs, bkWriteIrBindDescs())
    bkAddSection(bkSecIrWindowDescs, bkWriteIrWindowDescs())
    bkAddSection(bkSecIrMenuItemDescs, bkWriteIrMenuItemDescs())
    bkAddSection(bkSecIrMenuDescs, bkWriteIrMenuDescs())
    bkAddSection(bkSecIrWinHandlers, bkWriteIrWinHandlers())
    bkAddSection(bkSecIrWidgetHandlerEntries, bkWriteIrWidgetHandlerEntries())
    bkAddSection(bkSecIrMenuHandlerEntries, bkWriteIrMenuHandlerEntries())
    bkAddSection(bkSecIrEveryEntries, bkWriteIrEveryEntries())
    bkAddSection(bkSecIrStrLits, bkWriteIrStrLits())
    bkAddSection(bkSecIrArrLits, bkWriteIrArrLits())
    bkAddSection(bkSecIrExternNames, bkWriteIntList(irExternNames))
    bkAddSection(bkSecIrExternRetTys, bkWriteIntList(irExternRetTys))
    bkAddSection(bkSecIrExternParamStart, bkWriteIntList(irExternParamStart))
    bkAddSection(bkSecIrExternParamCountArr, bkWriteIntList(irExternParamCountArr))
    bkAddSection(bkSecIrExternParamTys, bkWriteIntList(irExternParamTys))
    bkAddSection(bkSecIrExternTrapWords, bkWriteIntList(irExternTrapWords))
    bkAddSection(bkSecIrExternConvs, bkWriteIntList(irExternConvs))
    bkAddSection(bkSecIrExternSels, bkWriteIntList(irExternSels))
    bkAddSection(bkSecIrExternParamRegs, bkWriteIntList(irExternParamRegs))
    bkAddSection(bkSecIrExternRetRegs, bkWriteIntList(irExternRetRegs))
    bkAddSection(bkSecIrLayoutNeededByName, bkWriteIrLayoutNeededByName())
    bkAddSection(bkSecIrRcWalkNeededByName, bkWriteIrRcWalkNeededByName())
    bkAddSection(bkSecIrScalars, bkWriteIrScalars())
    bkAddSection(bkSecStrPool, bkWriteStrPool())
    bkAddSection(bkSecLowCounters, bkWriteLowCounters())
    bkAddSection(bkSecCheckerSymbols, bkWriteCheckerSymbols())
    bkAddSection(bkSecFieldInfo, bkWriteFieldInfo())
    bkAddSection(bkSecDeclFileTab, bkWriteDeclFileTab())
    bkAddSection(bkSecUitestBounds, bkWriteUitestBounds())
    bkAddSection(bkSecCheckerVisibility, bkWriteCheckerVisibility())
    bkAddSection(bkSecManifestHashes, bkWriteManifestHashes())
    bkAddSection(bkSecShakeSummary, bkWriteShakeSummary())

    // object-code-linker Task 2: bake-time object capture runs HERE,
    // after every OTHER section has already been copied into the body as
    // fixed bytes -- not any earlier. cg68Measure (run internally by
    // cgObjCaptureRuntime's own cg68ProgramFork call) calls
    // cgReservePanicMsgs, which unconditionally APPENDS a synthesized
    // string literal to the LIVE irStrLits global (Amendment A2's own
    // root cause), and codegen internals intern() their own strings into
    // the shared pool besides (cg68SynthCbGlue's own "clar_cb_<name>"
    // glue names, notably -- see cgObjCaptureRuntime's own doc comment
    // for why that call is unavoidable). None of that may leak into
    // bkSecIrStrLits/bkSecStrPool/bkSecIrFuncs, which is exactly what
    // placing the capture call after those sections' own bkAddSection
    // calls (all of them, above) guarantees for free: the bytes are
    // already frozen into the body by the time any of this runs.
    if lane == bkLane68k {
        if not cgObjCaptureRuntime() {
            log("clarusc --bake-ir: object-code capture failed")
            return false
        }
        bkCheckShakeSummary()
    }
    bkAddSection(bkSecObjCode, bkWriteObjCode(lane))
    bkAddSection(bkSecObjMeta, bkWriteObjMeta(lane))

    out = ""
    out.append(bkMagic)
    bkPutU32(out, bkFormatVersion)
    bkPutByte(out, lane)

    compilerSrc = ""
    stamp = ""
    if bkFindClarusC(compilerSrc) {
        bkLastStamp = bkHashText(compilerSrc)
    } else {
        // clarusc/clarusc.c unreachable from the working directory (an
        // unusual invocation location) -- an all-zero stamp still keeps
        // the bake deterministic (bake-twice-identical) and the loader's
        // mismatch-refusal (Task 4) errs safe either way: a real
        // clarusc.c-hash stamp will never legitimately be zero.
        bkLastStamp = 0
    }
    bkPutU32(stamp, bkLastStamp)
    bkPutU16(out, stamp.length)
    out.append(stamp)

    bkPutU16(out, mods.count)
    i = 0
    while i < mods.count {
        bkPutStrShort(out, rtModuleKey(mods[i]))
        i = i + 1
    }

    // The directory: offsets are file offsets, so they start past the
    // directory itself (2 + 10 bytes per entry).
    n = bkWrDir.length / 10
    hdrLen = out.length + 2 + 10 * n
    bkPutU16(out, n)
    i = 0
    while i < n {
        bkPutU16(out, bkWrDir.wordAt(10 * i))
        bkPutU32(out, hdrLen + bkWrDir.intAt(10 * i + 2))
        bkPutU32(out, bkWrDir.intAt(10 * i + 6))
        i = i + 1
    }
    bkWrDir.release()
    if out.length > bkHeaderMax {
        abort("clarusc --bake-ir: header + module list + directory is " + numToStr(out.length) + " bytes; bkHeaderMax is " + numToStr(bkHeaderMax))
    }
    out.append(bkWrBody)
    bkWrBody.release()

    if not file.writeText(outPath, out, fileTypeData, "????") {
        log("clarusc --bake-ir: cannot write " + outPath + ": " + lastError.message)
        return false
    }
    return true
}

// ================================================================
// Loader: `--rtbake FILE` (runtime-ir-bake Task 4; format v9, SE wave 4
// Task 6). Mirrors the writer above section-for-section, field-for-field.
// The library is read through a filehandle plus the library's base offset
// in that file, never whole:
//   1. bkLoadRtbake reads the header and directory (bkCheckRtbakeHeader,
//      one readAt), then each resident section on its own into the
//      bkLd*/bkLoaded* pending globals below -- touching no live compiler
//      state -- plus the ObjCode section's per-function index alone.
//   2. bkInstallPool moves the intern pool into live strBlob/strOff/
//      strIndex -- called BEFORE Phase A (driveCompile), since every baked
//      arena's string-index fields are ABSOLUTE pool indices captured at
//      bake time; nothing else may intern() before this runs.
//   3. bkInstallArenas moves everything else (the IR arenas, the lowering
//      counters) into live state -- called AFTER check#1 (driveCompile).
//   4. bkLoadObjCode, after shake (driveEmit68kFork), reads the object
//      records of just the reachable baked functions into bkObjBuf.
// ================================================================

// bkLoadBuf/bkLoadPos: the read cursor over the bytes of ONE section (or
// the header), read by bkLoadRtbake. A module-level pair, not a scalar
// out-param (Ch3: user functions cannot fill one) -- the read counterpart
// of bkPutByte's own `out: text` in-place-mutation idiom.
var bkLoadBuf: text
var bkLoadPos: int

// bkLoadOverrun (final-review fix wave): set true the first time
// bkGetByte is asked to read past bkLoadBuf's end, instead of indexing
// out of range (an uncatchable runtime error, per Chapter 3). With no
// body hash (format v9) this is the loader's corruption net: every
// section's reader runs over exactly its own directory-sized buffer, so a
// corrupt count runs off the end, and the loader refuses the library.
// Reset at the start of every bkCheckRtbakeHeader call and per section.
var bkLoadOverrun: bool

// bkLibFh/bkLibBase: the library this compile loaded -- the filehandle
// the front end opened and the library's offset within that file. Kept
// until bkLoadObjCode reads the object code after shake; the front end
// owns the handle (opens and closes it).
var bkLibFh: filehandle
var bkLibBase: int

// bkReadAt reads n bytes at library offset off into out, and reports the
// read (id: the section id, 0 for the header, -1 for an object-code span)
// through BakeReadLog. A short read (truncated library) or an I/O error
// returns false.
func bkReadAt(id: int, off: int, n: int, out: text): bool {
    if not bkLibFh.readAt(bkLibBase + off, n, out) {
        return false
    }
    BakeReadLog(id, out.length)
    return out.length == n
}

// BakeReadLog (tests/bake/lazyread.sh): the host runtime prints a
// `bakeread: ID BYTES` line per call when CLARUS_BAKE_READLOG=1, else
// nothing. On the 68k lane the clause-less extern resolves to the no-op
// nat_BakeReadLog below (the MemProbe pattern, main.cla).
external func BakeReadLog(id: int, bytes: int)

func nat_BakeReadLog(id: int, bytes: int) {
}

func bkGetByte(): int {
    var b: int
    if bkLoadPos >= bkLoadBuf.length {
        bkLoadOverrun = true
        return 0
    }
    b = int(bkLoadBuf[bkLoadPos])
    bkLoadPos = bkLoadPos + 1
    return b
}

func bkGetU16(): int {
    var b0: int
    var b1: int
    b0 = bkGetByte()
    b1 = bkGetByte()
    return (b0 << 8) | b1
}

// bkGetU32 (clir-load-perf Task 5, design C): one bulk t.intAt call
// behind a soft pre-check, instead of four bkGetByte calls -- the
// pre-check (`bkLoadPos + 4 > bkLoadBuf.length`) is the exact STRICT
// bound intAt itself re-checks (`pos < 0 or pos > rt.len - 4`, text.cla),
// so intAt's own panic is never reachable from here: bkLoadPos is never
// negative (every advance is by a non-negative amount from 0), so the
// only way to fail intAt's bound is the same overrun this pre-check
// already catches. (intAt renamed post-review from u32At -- bkGetU32
// itself keeps its name, it reads the format's u32 field; only the text
// METHOD it calls was renamed.)
func bkGetU32(): int {
    var v: int
    if bkLoadPos + 4 > bkLoadBuf.length {
        bkLoadOverrun = true
        bkLoadPos = bkLoadBuf.length
        return 0
    }
    v = bkLoadBuf.intAt(bkLoadPos)
    bkLoadPos = bkLoadPos + 4
    return v
}

func bkGetBool(): bool {
    return bkGetByte() != 0
}

// bkGetStr/bkGetStrShort mirror bkPutStr/bkPutStrShort's own two length-
// prefix conventions (4-byte BE for pool strings, 1-byte for the
// header's module keys) -- every string this format carries (pool
// entries, module keys) is well under the string type's own 255-byte cap
// by construction (the writer could never have produced a longer one --
// see bake.cla's own header doc comment). The CLIR wire format itself is
// UNCHANGED here -- pool strings still carry a 4-byte BE length field on
// disk -- only `text.stringAt`'s own prefix shape changed (post-review
// convention alignment, clir-load-perf: 1-byte Pascal-style, matching
// `string`'s own Str255 layout); this function's `+3` hop below is the
// adapter between the two.
//
// clir-load-perf Task 5 (design C): one bulk t.stringAt call behind two
// soft pre-checks, instead of a per-byte bkGetByte loop through a
// char[255] buffer. Pre-check 1 (4 bytes for the length prefix) makes
// the intAt read below panic-unreachable, same argument as bkGetU32's
// own rewrite. Pre-check 2's `n > 255` refusal is now the ONLY guard
// against a corrupt >255-length wire field -- stringAt itself can no
// longer see it (its own length byte is 0-255 by construction, peekb's
// own range), so this soft-refusal is load-bearing, not redundant, for
// that case. The `n > 255` refusal is defensive behavior for a corrupt
// bake: the old char[255] loop just copied `n` bytes with no cap, so a
// hand-crafted length > 255 would have overrun the stack buffer; here it
// soft-refuses instead.
//
// The payload read is `bkLoadBuf.stringAt(bkLoadPos + 3)`, not
// `bkLoadPos` -- the wire field is 4 bytes BE, but pre-check 2 already
// requires `n <= 255`, so the field's high three bytes are provably
// zero and byte `bkLoadPos + 3` IS the Pascal-style length byte stringAt
// now expects (see bkGetU32's own note: bkLoadPos is never negative, so
// this is well-defined). Domination: pre-check 2 establishes
// `bkLoadPos + 4 + n <= bkLoadBuf.length` with `0 <= n <= 255`; letting
// `pos = bkLoadPos + 3`, stringAt's length-byte bound
// (`pos > rt.len - 1`, i.e. `bkLoadPos + 4 > rt.len`) is already false
// since `bkLoadPos + 4 <= bkLoadPos + 4 + n <= rt.len`, and its payload
// bound (`pos > rt.len - 1 - l`, i.e. `bkLoadPos + 4 + l > rt.len` --
// and `l == n` here, since the byte at `pos` is exactly the wire
// field's low byte when the high three are zero) is false for the same
// reason. So pre-check 2 fully dominates stringAt's own STRICT checks
// after the `+3` shift; stringAt's own bounds panics are unreachable
// from here, same as before the prefix-shape change.
func bkGetStr(): string {
    var n: int
    var s: string

    if bkLoadPos + 4 > bkLoadBuf.length {
        bkLoadOverrun = true
        bkLoadPos = bkLoadBuf.length
        return ""
    }
    n = bkLoadBuf.intAt(bkLoadPos)
    if n < 0 or n > 255 or bkLoadPos + 4 + n > bkLoadBuf.length {
        bkLoadOverrun = true
        bkLoadPos = bkLoadBuf.length
        return ""
    }
    s = bkLoadBuf.stringAt(bkLoadPos + 3)
    bkLoadPos = bkLoadPos + 4 + n
    return s
}

func bkGetStrShort(): string {
    var n: int
    var buf: char[255]
    var i: int
    var s: string

    n = bkGetByte()
    i = 0
    while i < n {
        buf[i] = char(bkGetByte())
        i = i + 1
    }
    s.fromBytes(buf, n)
    return s
}

// bkReadIntList/bkReadIntIntMap: shared bodies for every plain `list of
// int` / `intmap of int` section (bkWriteIntList's own read-side twin,
// generalized to cover irCbGlueNames/irStrLits/declFileTab too, all the
// same shape).
// bkReadIrArrLits (format version 8) is bkWriteIrArrLits' reader --
// fills the three bkLdIrArrLit* lists in place (unlike bkReadIntList's
// return-a-list shape, since one section carries three parallel arenas).
func bkReadIrArrLits() {
    var n: int
    var i: int
    var j: int
    var cnt: int
    var elemT: list of int
    var lens: list of int
    var vals: list of int

    n = bkGetU32()
    elemT.reserve(bkFitCount(n))
    lens.reserve(bkFitCount(n))
    i = 0
    while i < n {
        elemT.add(bkGetU32())
        cnt = bkGetU32()
        lens.add(cnt)
        j = 0
        while j < cnt {
            vals.add(bkGetU32())
            j = j + 1
        }
        i = i + 1
    }
    bkLdIrArrLitElemT = elemT
    bkLdIrArrLitN = lens
    bkLdIrArrLitVals = vals
}

// bkFitCount (SE wave 2): the capacity to reserve for a list about to
// receive n decoded elements -- the power of two (>= 4) rtListGrow's
// doubling would end at anyway, so the parse skips the doubling
// transient (old + new block live at once) but the installed arena
// keeps the same headroom as before: user lowering appends to irExprs,
// strOff and friends right after install, and an exact-n reserve made
// the first user append double the whole arena (+1.28 MB live for
// bookmarks --rtbake). Returns 0 (reserve is then a no-op) unless the
// unread bytes could hold n elements of at least 4 wire bytes each
// (every pre-sized element carries a u32), so a corrupt count reserves
// nothing and the reader's own overrun checks refuse it, instead of
// reserve panicking out of memory first.
func bkFitCount(n: int): int {
    var c: int

    if n <= 0 or n > (bkLoadBuf.length - bkLoadPos) / 4 {
        return 0
    }
    c = 4
    while c < n {
        c = c * 2
    }
    return c
}

func bkReadIntList(): list of int {
    var n: int
    var i: int
    var l: list of int

    n = bkGetU32()
    l.reserve(bkFitCount(n))
    i = 0
    while i < n {
        l.add(bkGetU32())
        i = i + 1
    }
    return l
}

func bkReadIntIntMap(): intmap of int {
    var n: int
    var i: int
    var k: int
    var v: int
    var m: intmap of int

    n = bkGetU32()
    i = 0
    while i < n {
        k = bkGetU32()
        v = bkGetU32()
        m[k] = v
        i = i + 1
    }
    return m
}

func bkLaneName(lane: int): string {
    if lane == bkLane68k {
        return "68k"
    }
    return "c"
}


// bake.cla: the CLIR serializer -- `clarusc --bake-ir` host mode
// (runtime-ir-bake Task 3, docs/superpowers/specs/2026-08-12-runtime-ir-
// bake-design.md). Builds the runtime chain (the target lane's full
// module superset, per drive.cla's driveManifestSplice, PLUS uitest.cla
// -- see bakeModuleList's own doc comment) as if it were the compiled
// PROGRAM, following the runtime-ir-bake Task 1 Step 3 probe's exact
// pipeline shape (task-1-report.md section (a) Step 3, amendment 4):
// expand the runtime chain as ordinary entries, checkProgram(combined)
// ONCE, then irReset()+lowerProgram(combined2 == combined) directly -- no
// manifest re-splice, no second checkProgram, no shake (the bake captures
// PRE-shake lowered IR; per-compile shake runs later, over the combined
// user+runtime IR, not here).
//
// The resulting arena/pool/counter/checker state is then serialized to a
// flat 'CLIR' byte format (bakeWriteFile) that a future loader (Task 4)
// re-inflates at arena base 0 before a user compile's own lowering
// appends at base N. Format constants here are the shared contract both
// this serializer and that future loader read from.
//
// Sections are one per irReset-order IR arena (task-1-report.md section
// (b)'s frozen inventory table, whose row order IS irReset's own clear()
// call order -- verified against ir.cla:1039-1289 directly), plus four
// more: the intern pool, the lowering-counters block, the checker-symbol
// block, and the curPathIdx (declFileTab) stamp table -- the four extra
// blocks the design spec's own "Body, flat sections" list names beyond
// the arenas themselves. Section ids are stable constants, numbered in
// that order; gaps are fine (Task 3 controller resolution), renumbering
// an EXISTING id is not.

include "lib.cla"
include "ast.cla"
include "types.cla"
include "check.cla"
include "ir.cla"
include "lower.cla"
include "drive.cla"

// ================================================================
// Format constants -- shared contract with the future loader (Task 4)
// ================================================================

const bkMagic: string = "CLIR"
// bkFormatVersion 6 (object-code-linker Task 2): added bkSecObjCode/
// bkSecObjMeta -- per reachable runtime function (68k lane only; lane c
// writes both sections empty, count 0, keeping the header's
// bkSectionCount round-trip check lane-uniform), the function's captured
// post-peephole byte runs interleaved with typed hole records
// (bkSecObjCode) plus its Measure-time size/frame-size/pool-ref-set/
// once-per-artifact metadata (bkSecObjMeta) -- see cg68k.cla's own
// cgObjCaptureRuntime/cgObjDumpSegment doc comments for the capture
// mechanics and bkWriteObjCode/bkWriteObjMeta below for the exact wire
// shape. Lets a future compile (Task 3) skip runtime codegen entirely:
// Measure fills its per-function tables from the artifact instead of
// running cgEmitFunc, and the per-segment emit pass PASTES a baked
// function's bytes (re-registering each hole as an a68 fixup) instead of
// regenerating them. Version 5 (fallback-trigger-narrowing Task 2): added
// bkSecManifestHashes -- one FNV hash (bkHashText) plus an
// early-visibility flag per manifest-path source file (the same universe
// bkComputeManifestPaths' own bkManifestPaths covers, top-level runtime
// modules AND every nested include they pull in), so a user `include`
// that resolves to a manifest path can be drift-checked against the
// baked copy instead of forcing an unconditional fallback -- see
// bkWriteManifestHashes/bkReadManifestHashes and drive.cla's expand()
// for the collision branch that consumes this. Version 4 (final-review
// fix wave) added bkHeaderBodyHash, a 4-byte FNV hash (bkHashTextFrom,
// below) over every byte AFTER the header, stored in the header itself
// and verified by bkCheckRtbakeHeader BEFORE any section is parsed -- a
// truncated or corrupted buffer is refused there, in front of BOTH the
// host loader's full parse (bkLoadRtbake) and macgui.cla's own
// bake-vs-fallback decision (gcResolveBakePath), instead of surfacing as
// a hard compile failure only after the Mac side already committed to
// the bake path. Version 3 (runtime-ir-bake Task 5, fix round 2) added
// bkSecCheckerVisibility (the testapi-visible checker-symbol boundary --
// see that section's own doc comment). Version 2 added bkSecUitestBounds
// (the base/uitest IR-arena boundary counts). Pre-release format; the
// loader refuses any other version outright (no compat shim), per this
// phase's own controller resolution.
// v7: body/stamp/manifest hash switched from FNV-mul to shift-add -- layout unchanged.
const bkFormatVersion: int = 7

// bkClirResourceName/bkStampResourceName (runtime-ir-bake Task 6, Mac
// integration): reserved 'CLFS' resource names ClarusC.APPL's own build
// (scripts/build-clarusc-mac.sh) embeds the CLIR artifact and its tiny
// stamp sidecar under -- deliberately NOT shaped like a real module path
// (no "/" or ".cla"), so neither can ever collide with a real
// runtime/toolbox module key or a user-chosen entry file. Read back via
// the ordinary, unmodified `file.readResource(name, out)` builtin
// (macgui.cla's feExpectedStamp/gcCompile) -- reusing that single
// existing mechanism, rather than teaching the resource layer a second
// Mac resource TYPE, is this task's own deliberate simplification: see
// its report for the tradeoff.
const bkClirResourceName: string = "__clir_bake_68k__"
const bkStampResourceName: string = "__clarusc_stamp__"

// bkLastStamp (Task 6): the int stamp bakeWriteFile just computed for
// the CLIR header it wrote -- main.cla's bakeIrMode reads this right
// after a successful bakeWriteFile call to also persist a tiny 4-byte
// sidecar file (packed the same way bkPutU32 packs the header's own
// copy), which scripts/build-clarusc-mac.sh embeds as
// bkStampResourceName above. Meaningless before bakeWriteFile's first
// call in a process; every caller reads it immediately after, never
// stashed across compiles.
var bkLastStamp: int

// Lane tags (brief's format block: 0=68k, 1=c).
const bkLane68k: int = 0
const bkLaneC: int = 1

// Section ids, in irReset() clear-call order (ir.cla:1039-1289), then the
// four non-arena blocks. See this file's own top doc comment.
const bkSecIrTypes: int = 1
const bkSecIrStmts: int = 2
const bkSecIrExprs: int = 3
const bkSecIrLocals: int = 4
const bkSecIrFuncs: int = 5
const bkSecIrFuncIdxByName: int = 6
const bkSecIrCbGlueNames: int = 7
const bkSecIrGlobals: int = 8
const bkSecIrFieldSlots: int = 9
const bkSecIrRecords: int = 10
const bkSecIrEnumMembers: int = 11
const bkSecIrEnums: int = 12
const bkSecIrWidgetDescs: int = 13
const bkSecIrColumnDescs: int = 14
const bkSecIrBindDescs: int = 15
const bkSecIrWindowDescs: int = 16
const bkSecIrMenuItemDescs: int = 17
const bkSecIrMenuDescs: int = 18
const bkSecIrWinHandlers: int = 19
const bkSecIrWidgetHandlerEntries: int = 20
const bkSecIrMenuHandlerEntries: int = 21
const bkSecIrEveryEntries: int = 22
const bkSecIrStrLits: int = 23
const bkSecIrExternNames: int = 24
const bkSecIrExternRetTys: int = 25
const bkSecIrExternParamStart: int = 26
const bkSecIrExternParamCountArr: int = 27
const bkSecIrExternParamTys: int = 28
const bkSecIrExternTrapWords: int = 29
const bkSecIrExternConvs: int = 30
const bkSecIrExternSels: int = 31
const bkSecIrExternParamRegs: int = 32
const bkSecIrExternRetRegs: int = 33
const bkSecIrLayoutNeededByName: int = 34
const bkSecIrRcWalkNeededByName: int = 35
// bkSecIrScalars: irHasLaunch..irEveryCount plus the singleton IRType
// indices (irVoidT..irWordT) -- everything irReset() sets to a plain
// scalar (not a list/map clear()), bundled into one section.
const bkSecIrScalars: int = 36

// Non-arena blocks (gap left deliberately, per the controller resolution
// above -- these are conceptually a different tier than the IR arenas).
const bkSecStrPool: int = 40
const bkSecLowCounters: int = 41
const bkSecCheckerSymbols: int = 42
const bkSecDeclFileTab: int = 43
// bkSecUitestBounds (format version 2, Task 5): two counts -- irFuncs.count
// and irStrLits.count captured right after the generator lowers the BASE
// runtime chain (every baked module except uitest.cla) and BEFORE it goes
// on to lower uitest.cla itself (bakeGenerateChain's own doc comment) --
// the boundary a non-testapi install truncates both arenas back to, so a
// non-testapi --rtbake build carries exactly the same irFuncs/irStrLits
// content a from-source non-testapi compile would (which never splices
// uitest.cla at all -- bakeModuleList's own doc comment). See task-5-
// report.md's "inherited problem" section for the full root-cause chain.
const bkSecUitestBounds: int = 44
// bkSecCheckerVisibility (format version 3, Task 5 fix round 2): two
// counts -- funcSigs.count/symbols.count captured right after the
// generator's own checkPhase1 call over the thirteen testapi-visible
// modules (core.cla..uidialogs.cla + uitest.cla), before checkPhase1
// runs again over the four manifest-only modules (sortedmap.cla/
// datetime.cla(+lane)/ser.cla/native.cla). A testapi install uses these
// as a visibility boundary (NOT a truncation boundary -- funcSigs/
// symbols/scopes install in FULL; only the topScope's own name->symbol
// bindings above the boundary are excluded when repopulating the live
// topScope), so a --testapi compile's own check#1 sees exactly the
// same names a from-source --testapi compile's own check#1 does (the
// thirteen early-spliced modules, not the four manifest-only ones,
// which from-source only ever exposes to check#2 -- retired on the bake
// path). See bkInstallCheckerSymbolsForTestapi's own doc comment.
const bkSecCheckerVisibility: int = 45

// bkSecManifestHashes (format version 5, fallback-trigger-narrowing Task
// 2): one entry per distinct manifest-path source file (the same
// universe bkComputeManifestPaths' own bkManifestPaths covers) -- a path
// string, its FNV source hash (bkHashText), and an early-visibility flag
// (whether that file's checker symbols fall within the testapi preload
// boundary, bkGenEarlyVisibleAsmHeadsBoundary). The drift guard: a user
// `include` colliding with a manifest path is hash-compared against this
// before deciding check-only-include vs from-source fallback. See
// bkWriteManifestHashes/bkReadManifestHashes.
const bkSecManifestHashes: int = 46

// bkSecFieldInfo (format version 5, fallback-trigger-narrowing Task 2):
// check.cla's own record-field side tables (fieldInfos, the FieldInfo
// arena, plus recFieldsHeadByName, the record-name -> fieldInfos-head
// map) -- discovered missing from the ORIGINAL testapi checker-symbol
// bake (bkSecCheckerSymbols only ever carried funcSigs/symbols/scopes/
// typeArena/enumMembers): a --testapi UI compile's own case-(b) full
// dedup (drive.cla's expand()) excises an early-visible manifest
// collision's decls from `combined` entirely, so checkRecordDecl never
// runs for it this compile -- without this section's own install
// (bkInstallFieldInfo), a record type from the baked side (e.g.
// toolbox/files.cla's IOParam) would be NAMEABLE (typeArena/scopes cover
// that) but its OWN FIELDS unresolvable ("undefined: ioNamePtr"), and
// lower.cla reads the SAME two tables again during lowering, so this is
// load-bearing there too, not just for check#1 diagnostics. See
// bkWriteFieldInfo/bkReadFieldInfo/bkInstallFieldInfo.
const bkSecFieldInfo: int = 47

// bkSecObjCode/bkSecObjMeta (format version 6, object-code-linker Task
// 2): the per-reachable-runtime-function captured object -- byte runs +
// typed hole records (bkSecObjCode, cg68k.cla's own cgObjRuns/
// cgObjHoles) and Measure-time metadata (bkSecObjMeta, cg68k.cla's own
// cgFuncSize/cgFuncFrameSizes/cgFuncStrLits-family plus the once-per-
// artifact fixed-cost buckets and per-pool-entry size tables). 68k lane
// only; written empty (count 0) on lane c so bkSectionCount's own
// round-trip check stays lane-uniform. See bkWriteObjCode/bkWriteObjMeta
// for the exact wire shape and bkReadObjCode for the loader side (there
// is no install step any more -- clir-load-perf Task 7 replaced
// bkInstallObjCode's truncation with cgObjPasteEligible's bounds check).
const bkSecObjCode: int = 48
const bkSecObjMeta: int = 49

const bkSectionCount: int = 46

// ================================================================
// Byte-buffer primitives -- explicit one-byte-at-a-time big-endian
// (reference:1323, byte-clean verbatim), the same technique app68k.cla's
// app68PutByte/Word/Long use (`>>` is arithmetic/sign-propagating and
// char() keeps only the low byte, so this is correct for negative values
// too). Kept as this file's own tiny copies rather than reaching into
// app68k.cla, matching that file's own stated policy of not cross-
// depending on a sibling module for small shared helpers.
// ================================================================

func bkPutByte(out: text, b: int) {
    out.append(char(b))
}

func bkPutU16(out: text, w: int) {
    bkPutByte(out, w >> 8)
    bkPutByte(out, w)
}

func bkPutU32(out: text, v: int) {
    bkPutU16(out, v >> 16)
    bkPutU16(out, v)
}

func bkPutBool(out: text, b: bool) {
    if b {
        bkPutByte(out, 1)
    } else {
        bkPutByte(out, 0)
    }
}

// bkPutStr: the intern-pool string convention (controller resolution) --
// 4-byte BE length + raw bytes.
func bkPutStr(out: text, s: string) {
    var i: int

    bkPutU32(out, s.length)
    i = 0
    while i < s.length {
        out.append(s[i])
        i = i + 1
    }
}

// bkPutStrShort: the header's module-key convention (brief's format
// block) -- 1-byte length + raw bytes. rtModuleKey names ("runtime/
// clarus/uidialogs.cla") are always well under 256 bytes.
func bkPutStrShort(out: text, s: string) {
    var i: int

    bkPutByte(out, s.length)
    i = 0
    while i < s.length {
        out.append(s[i])
        i = i + 1
    }
}

// bkPutBytes (object-code-linker Task 2): 4-byte BE length + raw bytes,
// verbatim -- the same framing bkEmitSection itself uses for a whole
// section's payload, reused here per OBJECT-CODE byte run (a captured
// function's own post-peephole machine code), which unlike a pool string
// can exceed the 255-byte cap bkPutStr's own `string` parameter carries.
func bkPutBytes(out: text, data: text) {
    bkPutU32(out, data.length)
    out.append(data)
}

// bkEmitSection frames one section's already-built payload into out:
// sectionId (2) + byteLen (4) + payload, per the brief's format block.
func bkEmitSection(out: text, id: int, payload: text) {
    bkPutU16(out, id)
    bkPutU32(out, payload.length)
    out.append(payload)
}

// ================================================================
// Stamp: a deterministic djb2-shape shift-add rolling hash (masked to
// 31 bits after every step, mirroring map.cla's own mapHash convention,
// so the arithmetic never depends on unspecified 32-bit signed overflow
// behavior) over clarusc/clarusc.c's own bytes -- "the generating
// compiler (the clarusc.c snapshot identity)" per the design spec's own
// header description. A loader built from a DIFFERENT clarusc.c snapshot
// (a different compiler identity, e.g. after a codegen/IR-shape change)
// hashes to a different stamp and can refuse to load a stale bake
// (Task 4's own job -- this task only computes and writes it). Swapped
// from an FNV-1a-style multiply (clir-load-perf design C, spec %5.3):
// this hash is about to run in a tight per-call loop
// (rtTextHashStep/hashStep), where a native 68000 per-byte multiply
// (cg_mul32, ~3x MULU + JSR) would dominate; shift-add costs one shift
// and two adds instead.
// ================================================================

const bkFnvSeed: int = 5381

func bkHashText(data: text): int {
    return bkHashTextFrom(data, 0)
}

// bkHashTextFrom is bkHashText's own body, starting at an arbitrary
// offset rather than 0 -- bkCheckRtbakeHeader's body-integrity check
// (format v4) needs to hash everything in a loaded buffer AFTER the
// fixed-size header without ever materializing that (up to ~1.1MB)
// remainder as a `string` slice, which Chapter 3's 255-byte slice cap
// would reject outright; walking `data[i]` by index has no such limit.
func bkHashTextFrom(data: text, start: int): int {
    var h: int
    var i: int
    var b: int

    h = bkFnvSeed
    i = start
    while i < data.length {
        b = int(data[i])
        h = ((h << 5) + h + b) & 0x7FFFFFFF
        // Liveness pulse (attempt-abort Task 7, spec %5): this loop can
        // run for up to ~1.1MB with no other progress signal, so the
        // Status bar's spinner (macgui's feProgressTick, throttled by
        // TickCount there -- this call costs one trap every 32KB, cheap
        // even in the hot per-byte path) and the host CLI's own spinner
        // both stay visibly alive. driveProgressTick is itself a no-op
        // unless want68k, so emit/check-only/appinfo stay byte-silent.
        if (i & 0x7FFF) == 0 {
            driveProgressTick()
        }
        i = i + 1
    }
    return h
}

// bkFindClarusC loads clarusc/clarusc.c's raw bytes into out, searching
// upward from the working directory exactly like findRtDir does for
// runtime/clarus/ (drive.cla) -- clarusc.c and clarusc/ are repo-root
// siblings of runtime/clarus/, not reachable from rtDir itself, so this
// is its own small search rather than a reuse of findRtDir's.
func bkFindClarusC(out: text): bool {
    var prefix: string
    var candidate: string
    var i: int

    prefix = ""
    i = 0
    while i < 10 {
        candidate = prefix + "clarusc/clarusc.c"
        if file.readText(candidate, out) {
            return true
        }
        prefix = prefix + "../"
        i = i + 1
    }
    return false
}

// ================================================================
// Module list -- the lane's full driveManifestSplice superset (Task 2)
// PLUS uitest.cla. The design spec's pipeline restructure says the
// --testapi path preloads "the baked runtime symbols" into scope so user
// code may legally name UiTest* functions -- those symbols only exist if
// uitest.cla's own declarations are part of the baked checker-symbol
// state, so the bake chain carries uitest.cla unconditionally (its own
// VISIBILITY to a non-testapi compile is the loader's job, Task 5 per
// the dispatch brief -- this serializer only captures state, it does not
// gate anything). Ordering mirrors driveEarlySplice's own module list
// (uitest slotted right after the ui* family, ahead of sortedmap/
// datetime/ser/native), not driveManifestSplice's (which never mentions
// uitest at all, since it's --testapi-only on the from-source path).
func bakeModuleList(lane: int): list of string {
    var mods: list of string

    mods.add("core.cla")
    mods.add("str.cla")
    mods.add("text.cla")
    mods.add("list.cla")
    mods.add("map.cla")
    mods.add("uidesc.cla")
    mods.add("ui.cla")
    mods.add("uiwidgets.cla")
    mods.add("uitext.cla")
    mods.add("uitable.cla")
    mods.add("uiscript.cla")
    mods.add("uidialogs.cla")
    mods.add("uitest.cla")
    mods.add("sortedmap.cla")
    mods.add("datetime.cla")
    if lane == bkLane68k {
        mods.add("datetime_68k.cla")
    } else {
        mods.add("datetime_c.cla")
    }
    mods.add("ser.cla")
    if lane == bkLane68k {
        // native.cla is native-only (Toolbox-trap glue, no C runtime
        // under it at all -- see its own doc comment); driveManifestSplice
        // only ever splices it under want68k, and the bake generator
        // follows the exact same gate.
        mods.add("native.cla")
    }
    return mods
}

// bkGenBaseIrFuncsCount/bkGenBaseIrStrLitsCount (Task 5, inherited-problem
// fix): the irFuncs.count/irStrLits.count boundary bakeGenerateChain
// records right after lowering the BASE runtime chain (every baked module
// except uitest.cla) and before lowering uitest.cla itself -- serialized
// verbatim by bkWriteUitestBounds, consumed by bkInstallArenas to truncate
// a non-testapi install back to exactly what a from-source non-testapi
// compile would have produced. See bkSecUitestBounds' own doc comment.
var bkGenBaseIrFuncsCount: int
var bkGenBaseIrStrLitsCount: int

// bkGenEarlyFuncSigsCount/bkGenEarlySymbolsCount (runtime-ir-bake Task 5,
// fix round 2): funcSigs.count/symbols.count captured right after
// bakeGenerateChain's own checkPhase1 call over the thirteen testapi-
// visible modules (core.cla..uidialogs.cla + uitest.cla), before the
// four manifest-only modules' own checkPhase1 call runs. Consumed by
// bkInstallCheckerSymbolsForTestapi to decide which baked topScope
// bindings are visible to a --testapi compile's own check#1 -- see that
// function's own doc comment.
var bkGenEarlyFuncSigsCount: int
var bkGenEarlySymbolsCount: int

// bkGenEarlyVisibleAsmHeadsBoundary (fallback-trigger-narrowing Task 2):
// bakeGenerateChain's own local earlyVisibleAsmHeadsBoundary, persisted
// -- the asmHeads-index cutoff between the thirteen testapi-visible
// modules (PLUS every file they transitively `include`, e.g. toolbox/
// files.cla via uidialogs.cla) and the four manifest-only modules after
// them. bkWriteManifestHashes reads this to tag each manifest path as
// early-visible or not, matching bkGenEarlyFuncSigsCount/
// bkGenEarlySymbolsCount's own boundary exactly (uitest.cla is the last
// early-visible module in bakeModuleList's fixed order either way).
var bkGenEarlyVisibleAsmHeadsBoundary: int

// bkPathIsUitest reports whether pathIdx (an interned path-pool index,
// resolved via poolGet) names uitest.cla -- a plain basename suffix match
// rather than an exact-string compare against rtModuleKey("uitest.cla"),
// since the RECORDED identity (declFileTab/curPathIdx, drive.cla's
// expand()) is always the DISK path (joinPath(rtDir, "uitest.cla")),
// which only equals the "runtime/clarus/uitest.cla" key when rtDir is
// left at its default -- a --rtdir override still ends in the same
// "uitest.cla" tail either way.
//
// (runtime-ir-bake Task 5 history: this briefly moved to drive.cla in
// fix round 2, when driveManifestSplice ALSO needed it for a decl-node
// partition of `combined`; that partition was replaced, in the SAME fix
// round, by the drvEarlyRtHeadsNoUitest/drvEarlyUitestHeads asmHeads-
// index chains driveEarlySplice now tracks directly, which never needed
// this helper at all -- so as of fix round 3, bakeGenerateChain's own
// base/uitest split (below) is once again the ONLY caller, and this
// moved back here where it started.)
func bkPathIsUitest(pathIdx: int): bool {
    var p: string
    var want: string

    if pathIdx == -1 {
        return false
    }
    p = poolGet(pathIdx)
    want = "uitest.cla"
    return p.length >= want.length and p[p.length - want.length, want.length] == want
}

// ================================================================
// Generator: assemble the runtime chain as the program, check once,
// lower once -- Task 1 Step 3's proven shape, no other accommodation.
// ================================================================

func bakeGenerateChain(lane: int): bool {
    var mods: list of string
    var i: int
    var rtPath: string
    var h: int
    var tail: int
    var uitHead: int
    var uitTail: int
    var baseHead: int
    var baseTail: int
    var earlyVisibleAsmHeadsBoundary: int
    var uitestTailNode: int
    var savedNextAfterUitest: int
    var manifestOnlyHead: int

    mods = bakeModuleList(lane)
    if not haveRtDir {
        rtDir = findRtDir(mods[0])
    }

    earlyVisibleAsmHeadsBoundary = 0
    i = 0
    while i < mods.count {
        rtPath = joinPath(rtDir, mods[i])
        if expand(rtPath, true, rtModuleKey(mods[i])) {
            if haveRtDir {
                abort("clarusc --bake-ir: runtime module " + mods[i] + " not found (searched " + rtDir + "); use --rtdir")
            } else {
                abort("clarusc --bake-ir: runtime module " + mods[i] + " not found (searched runtime/clarus/ from the working directory upward); use --rtdir")
            }
        }
        // runtime-ir-bake Task 5, fix round 2: uitest.cla is always the
        // last of the THIRTEEN "testapi early-visible" modules in
        // bakeModuleList's own fixed order (core.cla..uidialogs.cla,
        // then uitest.cla, THEN the four manifest-only modules --
        // sortedmap.cla/datetime.cla(+lane)/ser.cla/native.cla). Capture
        // the asmHeads boundary right here so the checker-phase split
        // below knows where "testapi-visible" ends -- see this
        // function's own checkPhase1 split, just below.
        if mods[i] == "uitest.cla" {
            earlyVisibleAsmHeadsBoundary = asmHeads.count
        }
        i = i + 1
    }
    // fallback-trigger-narrowing Task 2: persisted past this function's
    // own return (a plain local otherwise) so bkWriteManifestHashes,
    // called later from bakeWriteFile, can classify each manifest path
    // as early-visible (within the testapi preload boundary) without
    // re-deriving the split.
    bkGenEarlyVisibleAsmHeadsBoundary = earlyVisibleAsmHeadsBoundary
    if entryFailed {
        abort("clarusc --bake-ir: cannot open a runtime module")
    }

    // Same post-order assembly driveCompile's own Phase A loop does
    // (drive.cla:1409-1425) -- no hoistDedups/hoisting machinery needed:
    // that exists only to reconcile a runtime splice against an ALREADY-
    // assembled user chain, which the bake generator has none of.
    combined = -1
    tail = -1
    i = 0
    while i < asmHeads.count {
        h = asmHeads[i]
        if h != -1 {
            if combined == -1 {
                combined = h
            } else {
                tail = declListAppend(tail, h)
            }
            tail = lastDecl(h)
        }
        i = i + 1
    }
    if combined == -1 {
        log("clarusc --bake-ir: no declarations found in the runtime chain")
        return false
    }

    // runtime-ir-bake Task 5, fix round 2: split checkProgram's own
    // phase 1 (name declaration) into two calls -- the thirteen
    // testapi-visible modules first, then the four manifest-only ones --
    // so bkGenEarlyFuncSigsCount/bkGenEarlySymbolsCount capture exactly
    // where testapi-visible checker symbols end. Phase 2 (body checking)
    // stays ONE call over the whole `combined` chain, unchanged --
    // bodies can be checked in any order once every top-level name is
    // declared, so this split is invisible to it.
    //
    // The split is done via a temporary sever-and-restore of uitest.cla's
    // own tail node's `.next` field, NOT by building two new chains via
    // declListAppend (this function's own base/uitest split, above,
    // already learned the hard way -- see its own doc comment -- that
    // reusing declListAppend on nodes ALSO reachable through `combined`
    // corrupts `combined` itself, since they are the SAME underlying
    // decl nodes). Sever-and-restore touches exactly one field, once,
    // and puts it back before checkPhase2 ever needs the whole chain
    // intact again.
    checkReset()
    manifestOnlyHead = -1
    if earlyVisibleAsmHeadsBoundary > 0 and earlyVisibleAsmHeadsBoundary < asmHeads.count {
        uitestTailNode = asmTails[earlyVisibleAsmHeadsBoundary - 1]
        savedNextAfterUitest = declNext(uitestTailNode)
        declListAppend(uitestTailNode, -1)
        checkPhase1(combined)
        bkGenEarlyFuncSigsCount = funcSigs.count
        bkGenEarlySymbolsCount = symbols.count
        declListAppend(uitestTailNode, savedNextAfterUitest)
        manifestOnlyHead = asmHeads[earlyVisibleAsmHeadsBoundary]
        if manifestOnlyHead != -1 {
            checkPhase1(manifestOnlyHead)
        }
    } else {
        // Defensive fallback (should never trigger: bakeModuleList always
        // puts uitest.cla before the four manifest-only modules) --
        // behaves like the original single-pass checkProgram, and the
        // installed testapi visibility boundary ends up covering
        // everything (matches the OLD, pre-fix-round-2 behavior rather
        // than silently mis-declaring).
        checkPhase1(combined)
        bkGenEarlyFuncSigsCount = funcSigs.count
        bkGenEarlySymbolsCount = symbols.count
    }
    checkPhase2(combined)
    if diags.count > 0 {
        return false
    }

    // runtime-ir-bake Task 5 (inherited-problem fix): lower the BASE
    // runtime chain (every module except uitest.cla) and uitest.cla
    // itself in two SEPARATE lowerProgram calls, in that order, instead
    // of one combined call over `combined` -- their IR-arena
    // contributions then land in two contiguous ranges (irFuncs/irStrLits
    // only grow, never insert, across a lowerProgram call: the same
    // append-only discipline the bake-install path already relies on for
    // lowResumeFromBake's "append user IR after baked IR" contract), so
    // bkInstallArenas can truncate a non-testapi install back to the base
    // range below. checkProgram above is UNCHANGED -- the checker-symbol
    // block still captures uitest.cla's checked signatures regardless of
    // testapi, exactly as Task 3 built it; only LOWERING splits.
    //
    // asmHeads[i]'s own file identity (declFileTab, set by expand() for
    // every decl, including these runtime ones) is used rather than a
    // fixed position in bakeModuleList's own module-index order: a
    // runtime module that itself `include`s another file would otherwise
    // shift every later module's asmHeads index by one per nested include,
    // silently misclassifying it as "uitest" or vice versa. None of the
    // 17/18 modules here currently nest an include, but this stays
    // correct regardless.
    // Uses asmTails[i] (expand()'s own pre-stitch tail for asmHeads[i],
    // recorded before ANY declListAppend ever touches it) rather than
    // re-deriving via lastDecl(h) here: the combined-building loop just
    // above already stitched every asmHeads[i]'s own tail's `.next` to
    // the NEXT module in bakeModuleList order, so calling lastDecl(h) a
    // second time, now, would walk straight through that stitch into
    // every module AFTER h too -- driveEarlySplice's own rebuild loop
    // (drive.cla) uses this exact same asmTails[idx] idiom for the same
    // reason.
    baseHead = -1
    baseTail = -1
    uitHead = -1
    uitTail = -1
    i = 0
    while i < asmHeads.count {
        h = asmHeads[i]
        if h != -1 {
            if bkPathIsUitest(getDeclFile(h)) {
                if uitHead == -1 {
                    uitHead = h
                } else {
                    uitTail = declListAppend(uitTail, h)
                }
                uitTail = asmTails[i]
            } else {
                if baseHead == -1 {
                    baseHead = h
                } else {
                    baseTail = declListAppend(baseTail, h)
                }
                baseTail = asmTails[i]
            }
        }
        i = i + 1
    }
    // Explicitly terminate each group's own final tail: combined's own
    // stitching (the loop above) already pointed BOTH baseTail's and
    // uitTail's underlying nodes at whatever module followed them in
    // bakeModuleList's FULL order (e.g. uitest.cla's own single entry's
    // tail still points at sortedmap.cla's head) -- a gap between two
    // SAME-group entries gets bridged automatically by the next same-
    // group declListAppend call above, but the LAST entry of a group
    // (uitest.cla is a group of exactly one) never gets a following
    // same-group entry to do that, so its stale tail link must be cut
    // here or lowerProgram would walk straight through it into every
    // module after it, re-lowering them a second time -- driveEarlySplice
    // (drive.cla) terminates its own rebuilt chain the identical way.
    declListAppend(baseTail, -1)
    declListAppend(uitTail, -1)

    irReset()
    lowResumeFromBake = false
    // runtime-ir-bake Task 5, fix round 1: lowSkipUiDispatchers=true for
    // BOTH generator passes -- the baked arenas carry no reverse-waist
    // dispatcher stubs and no early-interned panic-message string
    // literals at all now (lowSkipUiDispatchers' own doc comment, lower.
    // cla). The real per-compile lowerProgram(combined2) call (driveCompile,
    // never sets this true) still always builds them, fresh, against the
    // real program's own state, exactly where a from-source compile's ONE
    // dispatcher-synthesis pass always puts them -- after every runtime
    // AND user literal.
    lowSkipUiDispatchers = true
    if baseHead != -1 {
        lowerProgram(baseHead)
    }
    if diags.count > 0 {
        lowSkipUiDispatchers = false
        return false
    }
    bkGenBaseIrFuncsCount = irFuncs.count
    bkGenBaseIrStrLitsCount = irStrLits.count

    lowResumeFromBake = true
    if uitHead != -1 {
        lowerProgram(uitHead)
    }
    lowResumeFromBake = false
    lowSkipUiDispatchers = false
    if diags.count > 0 {
        return false
    }

    combined2 = combined
    return true
}

// ================================================================
// Section writers -- one per irReset-order arena, field-by-field in
// declaration order (bool = 1 byte, every int = 4 bytes BE, per the
// controller resolution). Enum-typed fields serialize via int(x)
// (Chapter 3: "int(e) yields the member's value").
// ================================================================

func bkWriteIrTypes(): text {
    var sec: text
    var i: int

    bkPutU32(sec, irTypes.count)
    i = 0
    while i < irTypes.count {
        bkPutU32(sec, int(irTypes[i].k))
        bkPutU32(sec, irTypes[i].n)
        bkPutU32(sec, irTypes[i].elem)
        bkPutU32(sec, irTypes[i].name)
        i = i + 1
    }
    return sec
}


var bkLdUilogIrStrLitsStart: int
var bkLdBaseIrArrLitsCount: int

// bkLdEarlyFuncSigsCount/bkLdEarlySymbolsCount (format version 3, Task 5
// fix round 2): the testapi-visible checker-symbol boundary --
// bkInstallCheckerSymbolsForTestapi's own visibility filter. See
// bkSecCheckerVisibility's own doc comment.
var bkLdEarlyFuncSigsCount: int
var bkLdEarlySymbolsCount: int

// bkLdObj* (format version 6, object-code-linker Task 2; v9 SE wave 4
// Task 6): the bkSecObjCode/bkSecObjMeta staging. bkReadObjMeta and
// bkReadObjIndex parse into locals and assign here only at the end of a
// successful parse (the staging convention's timing guarantee). Never
// truncated afterwards: the runtime/testapi boundary is applied as a
// bounds check by cgObjPasteEligible (clir-load-perf Task 7). Codegen
// reads these until the fork is built (spec 4.3).
//
// The object code itself is lazy (format v9): bkReadObjIndex keeps only
// the per-function index -- bkLdObjValid (captured valid, i.e. a non-empty
// record) and bkLdObjOff (record offsets into the section's data, which
// starts at library offset bkObjDataOff, plus a closing sentinel; record
// f is [bkLdObjOff[f], bkLdObjOff[f+1]), bkObjLen). bkLoadObjCode,
// after shake, reads the reachable functions' records into bkObjBuf and
// sets bkLdObjPos[f] to each one's offset there (-1: not read). Paste and
// Measure decode runs and holes straight out of bkObjBuf
// (bkObjHoleAt) -- no per-hole records are built.
//
// Flat `list of int`s rather than nested lists, deliberately: a nested
// list needs a per-element release walk in cg_free_globals, duplicated
// into every segment's glue bundle, and self-compiling clarusc runs close
// to the 32KB single-function ceiling (cprint.cla's cpEmitRelease tipped
// over it once).
var bkLdObjValid: list of bool
var bkLdObjOff: list of int
var bkLdObjPos: list of int
var bkObjDataOff: int
var bkObjBuf: text

// bkObjLim* (format v9): the baked arenas' sizes, saved at the end of
// bkLoadRtbake for bkObjRelocSymValid -- the lazy object read runs after
// install, when the staging lists these came from are empty and the live
// arenas already carry user entries.
var bkObjLimFuncs: int
var bkObjLimCbGlue: int
var bkObjLimPool: int
var bkObjLimStrLits: int
var bkObjLimArrLits: int
var bkObjLimEnums: int
var bkObjLimRecords: int

var bkLdObjFuncSize: list of int
var bkLdObjFuncFrameSize: list of int
// bkLdObjFuncStrLits/EnumTables/Serdescs (per function, a pool-ref index
// SET) are stored FLAT -- First/Count into one shared per-pool array --
// rather than as `list of list of int`: a nested list needs a per-
// element release WALK (cprint.cla's own cpEmitRelease, KRec/KList
// element arms), duplicated into cgGlueBundleSize (cgEmitRcWalks runs
// once per SEGMENT); a flat `list of int` releases in O(1), the same
// shape cgObjRunFirst/cgObjHoleFirst above already uses for exactly this
// reason. Self-compiling clarusc (TestSelfEmit68k) is close enough to
// the 32KB single-function ceiling that three nested-list globals here
// tipped an unrelated, already-near-the-edge cprint.cla function over
// it; this is not a stylistic preference.
// bkLdObjFuncStrLitFirst/Count/Flat are staged and truncated like every
// other field in this section but DELIBERATELY UNCONSUMED by Task 3's
// link pass: cgObjAddFuncStrLits (cg68k.cla) rebuilds a baked
// function's own strlit pool-ref set entirely from that function's own
// hole list instead, in stored order -- the wire array here can't be
// used directly because Amendment A2 filters cgListOobMsgIdx OUT of it
// at write time (its bake-time numeric index isn't valid at compile
// time), which destroys the panic entry's real chronological position
// among the surviving entries; re-deriving from holes reproduces that
// position exactly (see cgObjAddFuncStrLits' own doc comment for the
// full story, including the byte-identity regression this cost before
// the fix). A future reader must not wire these three fields into
// cg68Measure as a shortcut -- they are validated at load time
// (bkObjPoolIdxValid) but their own VALUES are stale for this purpose.
var bkLdObjFuncStrLitFirst: list of int
var bkLdObjFuncStrLitCount: list of int
var bkLdObjFuncStrLitFlat: list of int
var bkLdObjFuncEnumTableFirst: list of int
var bkLdObjFuncEnumTableCount: list of int
var bkLdObjFuncEnumTableFlat: list of int
var bkLdObjFuncSerdescFirst: list of int
var bkLdObjFuncSerdescCount: list of int
var bkLdObjFuncSerdescFlat: list of int
var bkLdObjFuncUsesUiBlob: list of bool
var bkLdObjFuncUsesUiEvents: list of bool

// bkLdObjSeg1ExtraSize/GlueBundleSize/PoolSize/StrLitSize/EnumTableSize/
// SerdescSize/UiBlobSize/UiEventsSize: the once-per-artifact fixed-cost
// buckets and per-pool-entry size tables Task 2's wire format carries
// (bkWriteObjMeta), staged here at load time, and DELIBERATELY
// UNCONSUMED by Task 3's Measure-skip -- see cg68k.cla's own
// cgObjPasteEligible section header (~cg68k.cla:13040-13063) for the
// full reasoning. Short version: these eight values measure the CURRENT
// PROGRAM's universe (cgEmitInitGlobalsStub/cgEmitFreeGlobalsStub walk
// `irGlobals.count`, cgEmitRcWalks walks `irRecords.count`,
// cgEmitPoolsBody measures the live pool) -- the runtime-baked prefix
// PLUS whatever this program's own user globals/records/literals append.
// The artifact only ever captured the bare runtime-only baseline
// (cgObjCaptureRuntime's own doc comment), so substituting these baked
// scalars for a real measurement would silently UNDER-measure
// cgPackProgram's own per-segment budget for any program with even one
// user var/record/literal -- i.e. nearly every real program -- and could
// shift a segment-packing decision away from what a from-source compile
// would choose, breaking byte-identity on segment LAYOUT rather than on
// any one function's own bytes. A future reader tempted to wire these
// into cg68Measure as a further speedup must re-derive them from the
// CURRENT compile's own irGlobals/irRecords/pool state, not from here.
var bkLdObjSeg1ExtraSize: int
var bkLdObjGlueBundleSize: int
var bkLdObjPoolSize: int
var bkLdObjStrLitSize: list of int
var bkLdObjEnumTableSize: list of int
var bkLdObjSerdescSize: list of int
var bkLdObjUiBlobSize: int
var bkLdObjUiEventsSize: int

// bkRuntimeFuncBoundary (object-code-linker Task 2): the installed
// runtime function count -- set in bkInstallArenas, right after irFuncs
// itself is assigned (== irFuncs.count at that point, respecting the
// SAME non-testapi truncation irFuncs just went through).
//
// clir-load-perf Task 7 (design B) PROMOTED it: it is now exactly the
// baked-index predicate cgObjPasteEligible (cg68k.cla) tests against,
// replacing bkInstallObjCode's own in-place truncation of the four
// per-function objcode index arrays (design B's memoized parse could
// not afford that truncation, audit findings F1/F2; SE wave 1 removed
// the memo but kept the bounds check). Two consequences a future reader must
// keep true:
//   - driveReset() now RESETS it to 0 every compile (drive.cla), so it
//     means "this compile installed a baked runtime prefix of N
//     functions", never "the last bake install did." A stale nonzero
//     value on a from-source compile would make cgObjPasteEligible
//     paste baked bytes over user functions.
//   - It must stay <= bkLdObjValid.count for the compiles that set it
//     (bkInstallArenas installs at most the baked function set);
//     cgObjPasteEligible bounds-checks both ways regardless.
var bkRuntimeFuncBoundary: int

// bkLoadedModules (Task 5, deliverable (b)): the bake header's own
// module-key manifest, retained rather than discarded (Task 4's own
// report flagged this as a "reads then discards" gap) -- one
// "runtime/clarus/NAME" key per baked runtime module, in bakeModuleList's
// own order. bkComputeManifestPaths turns this into the disk-path
// identity set expand() dedups a user `include` against.
var bkLoadedModules: list of string

// bkManifestPaths: the CURRENT bake's module disk-path identity set
// (bkComputeManifestPaths' own output), checked by drive.cla's expand()
// -- gated on haveRtbake there, so it is a no-op (empty map, never
// consulted) for every non-bake compile.
var bkManifestPaths: map of bool

// bkManifestHashes/bkManifestEarlyVisible (format version 5, fallback-
// trigger-narrowing Task 2): the drift guard's own baked lookups, keyed
// identically to bkManifestPaths -- bkManifestHashes[path] is the baked
// FNV hash of that manifest path's source (bake.cla's own
// bkWriteManifestHashes); bkManifestEarlyVisible[path] is whether that
// path's checker symbols fall within the testapi preload boundary
// (bkInstallCheckerSymbolsForTestapi's own visibility set). Populated by
// bkReadManifestHashes, once per bkLoadRtbake call; a no-op (empty maps)
// for every non-bake compile, same as bkManifestPaths itself.
var bkManifestHashes: map of int
var bkManifestEarlyVisible: map of bool

// bkManifestDriftPath (fallback-trigger-narrowing Task 2; was
// bkManifestHoistHit, a plain bool -- renamed since the new fallback log
// line needs the actual drifted path): set by expand() the moment a
// user include resolves to a manifest path WHOSE ON-DISK BYTES NO LONGER
// MATCH the baked hash (a genuine drift, not just a collision -- a
// hash-equal collision no longer forces a fallback at all, see expand()
// itself). driveCompile checks this right after Phase A and falls back
// to a full from-source recompile when it's non-empty. Empty ("") means
// no drift; reset before every bake-path Phase A run (driveCompile).
var bkManifestDriftPath: string

// bkManifestCollidedIdx/bkManifestCollidedEarly (fallback-trigger-
// narrowing Task 2): the asmHeads indices of every hash-EQUAL manifest
// collision expand() let parse into the user chain this compile (check-
// only include -- check#1 sees it, attributed to the real file), with a
// parallel early-visibility flag (bkManifestEarlyVisible's own value for
// that collision's path, captured once at collision time). driveCompile
// consumes both: the early ones get severed out of `combined` BEFORE
// checkPhase1 when a --testapi UI compile is about to preload baked
// checker symbols (avoiding the hard double-declare Task 1's own probe
// proved -- "dedup fully, no parse" for that case); ALL of them get
// severed out of the freshly-rebuilt `combined2` before lowering
// (Task 1's own decl-chain-surgery mechanic, generalized from a single
// index to a list) -- the baked IR already carries each one's lowered
// form. Reset before every bake-path Phase A run (driveCompile).
var bkManifestCollidedIdx: list of int
var bkManifestCollidedEarly: list of bool

// ---- Section readers -- mirror bkWrite* field-for-field ----

func bkReadIrTypes(): list of IRType {
    var n: int
    var i: int
    var e: IRType

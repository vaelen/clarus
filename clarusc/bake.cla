func bkReadIrFuncs(): list of IRFunc {
    var n: int
    var i: int
    var e: IRFunc
    var l: list of IRFunc

    n = bkGetU32()
    i = 0
    while i < n {
        e.name = bkGetU32()
        e.paramsHead = bkGetU32()
        e.ret = bkGetU32()
        e.localsHead = bkGetU32()
        e.bodyHead = bkGetU32()
        // attempt-abort phase Task 4 (REQUIRED fix, carried from Task 2's
        // review Important 2): bailHead/fromRuntimeModule are NOT part of
        // the serialized CLIR object-code format (added to IRFunc after
        // bkWriteIrFuncs/bkReadIrFuncs already existed) -- a restored entry
        // must get bailHead's own -1 sentinel (newIRFunc's own convention;
        // the record's plain zero-value default, 0, is a real, wrong arena
        // index) and fromRuntimeModule = true (every baked function is, by
        // construction, runtime-origin -- task-1-report P2's paste-path-
        // safety argument: a bake image is built from a runtime-only
        // universe). Without this, cg68k's/cprint's callee predicate
        // (irFuncIsRuntimeOrigin) would misclassify every restored
        // function as a checkable user function on a --rtbake compile,
        // breaking bake-vs-from-source byte-identity for any abort-enabled
        // program the moment codegen starts reading the tag.
        e.bailHead = -1
        e.fromRuntimeModule = true
        // attempt-abort phase Task 6b: canAbort is ALSO not part of the
        // serialized format (same reason as bailHead/fromRuntimeModule
        // above -- added after this function already existed), following
        // the exact same fix pattern. Unlike those two, false already IS
        // the correct default for a restored/baked entry (a runtime
        // function can never abort -- design doc %3.4, and
        // lowComputeCanAbort/lower.cla never seeds or propagates into a
        // runtime-origin one either), so this line is defensively
        // explicit rather than load-bearing: `var e: IRFunc` above is
        // reused across every loop iteration, and every OTHER field gets
        // a fresh explicit assignment each time, so leaving this one
        // field to "just happen to already be false from construction"
        // would be the odd one out, not a correctness gap.
        e.canAbort = false
        l.add(e)
        i = i + 1
    }
    return l
}


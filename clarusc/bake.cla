// bkReadManifestHashes (format version 5, fallback-trigger-narrowing
// Task 2): mirrors bkWriteManifestHashes field-for-field, populating
// BOTH bkManifestHashes and bkManifestEarlyVisible in one pass (they
// share the same count prefix and per-entry path key).
func bkReadManifestHashes() {
    var n: int
    var i: int
    var p: string
    var hashes: map of int
    var early: map of bool

    n = bkGetU32()
    i = 0
    while i < n {
        p = bkGetStrShort()
        hashes[p] = bkGetU32()
        early[p] = bkGetBool()
        i = i + 1
    }
    bkManifestHashes = hashes
    bkManifestEarlyVisible = early
}

// bkObjRelocSymValid (object-code-linker Task 2) is the lazy object
// read's corruption gate (bkObjCheckFunc): a structurally-valid-but-
// corrupt library (a flipped symIdx byte, say) must be refused before a
// paste ever hands an attacker- or bit-rot-controlled index to
// cgCallFunc/cgJtDisp/cgStrLitLabels and friends. kind/cls per
// bkWriteObjCode's own doc comment (cg68k.cla's cgHole*/cgRelCls*
// constants); the bounds are the baked arenas' own sizes (bkObjLim*).
// cgRelClsPanicMsg carries no numeric index at all (Amendment A2 --
// resolved from the live cgListOobMsgIdx global at link time), so any sym
// is valid there. An unknown kind is refused outright.
func bkObjRelocSymValid(kind: int, cls: int, sym: int): bool {
    if kind == cgHoleCall or kind == cgHoleJtAddr {
        return sym >= 0 and sym < bkObjLimFuncs
    }
    if kind == cgHoleCbGlueAddr {
        return sym >= 0 and sym < bkObjLimCbGlue
    }
    if kind == cgHoleSynthCall {
        // an intern-pool index (the reverse-waist extern's name) -- it
        // must be in the baked pool, or a compile's own later intern()
        // could reuse it.
        return sym >= 0 and sym < bkObjLimPool
    }
    if kind != cgHoleLabel {
        return false
    }
    if cls == cgRelClsPoolStr {
        return sym >= 0 and sym < bkObjLimStrLits
    }
    if cls == cgRelClsPoolArr {
        return sym >= 0 and sym < bkObjLimArrLits
    }
    if cls == cgRelClsPoolEnum {
        return sym >= 0 and sym < bkObjLimEnums
    }
    if cls == cgRelClsPoolSer or cls == cgRelClsRcRetain or cls == cgRelClsRcRelease {
        return sym >= 0 and sym < bkObjLimRecords
    }
    if cls == cgRelClsPoolUiBlob or cls == cgRelClsPoolUiEvt {
        return sym == 0
    }
    if cls == cgRelClsGlue {
        return sym >= 1 and sym <= 4
    }
    if cls == cgRelClsFuncLabel {
        return sym >= 0 and sym < bkObjLimFuncs
    }
    if cls == cgRelClsPanicMsg {
        return true
    }
    return false
}

// bkObjHoleBytes is one hole record's wire size (bkWriteObjCode: kind,
// cls, sym(4), op, size, sm, sr, sv(4), dm, dr, dv(4), srcSlot).
const bkObjHoleBytes: int = 21

// bkObjHoleAt decodes the hole record at bkObjBuf offset p.
func bkObjHoleAt(p: int): CgObjHole {
    var h: CgObjHole

    h.kind = int(bkObjBuf[p])
    h.cls = int(bkObjBuf[p + 1])
    h.sym = bkObjBuf.intAt(p + 2)
    h.op = int(bkObjBuf[p + 6])
    h.size = int(bkObjBuf[p + 7])
    h.sm = int(bkObjBuf[p + 8])
    h.sr = int(bkObjBuf[p + 9])
    h.sv = bkObjBuf.intAt(p + 10)
    h.dm = int(bkObjBuf[p + 14])
    h.dr = int(bkObjBuf[p + 15])
    h.dv = bkObjBuf.intAt(p + 16)
    h.srcSlot = int(bkObjBuf[p + 20]) != 0
    return h
}

// bkObjRunEnd returns the offset just past the run (len(4) + bytes) at
// bkObjBuf offset p -- the next hole, or the record's end after its last
// run.
func bkObjRunEnd(p: int): int {
    return p + 4 + bkObjBuf.intAt(p)
}

// bkObjLen: baked function f's object record length (0: not captured).
func bkObjLen(f: int): int {
    return bkLdObjOff[f + 1] - bkLdObjOff[f]
}

// bkReadObjIndex (format v9) reads just the ObjCode section's index --
// its count and the count + 1 record offsets -- from the section at
// library offset secOff, length secLen, into bkLdObjValid/bkLdObjOff.
// The offsets must run from 0 to the data's length without decreasing,
// and a non-empty record must at least hold its hole count.
func bkReadObjIndex(secOff: int, secLen: int): bool {
    var count: int
    var dataLen: int
    var i: int
    var off: int
    var prev: int
    var lValid: list of bool
    var lOff: list of int

    if secLen < 4 or not bkReadAt(bkSecObjCode, secOff, 4, bkLoadBuf) {
        emitDiag(1, 1, "--rtbake: object-code section: truncated index")
        return false
    }
    count = bkLoadBuf.intAt(0)
    if count < 0 or count > (secLen - 8) / 4 {
        emitDiag(1, 1, "--rtbake: object-code section: bad function count " + numToStr(count))
        return false
    }
    dataLen = secLen - 8 - 4 * count
    if not bkReadAt(bkSecObjCode, secOff + 4, 4 * count + 4, bkLoadBuf) {
        emitDiag(1, 1, "--rtbake: object-code section: truncated index")
        return false
    }
    lValid = driveFreshBoolList()
    lValid.reserve(bkFitCount(count))
    lOff = driveFreshIntList()
    lOff.reserve(bkFitCount(count + 1))
    prev = 0
    i = 0
    while i <= count {
        off = bkLoadBuf.intAt(4 * i)
        if off < prev or off > dataLen or (off > prev and off - prev < 4) or (i == 0 and off != 0) or (i == count and off != dataLen) {
            emitDiag(1, 1, "--rtbake: object-code section: index entry " + numToStr(i) + " out of range")
            return false
        }
        if i > 0 {
            lValid.add(off > prev)
        }
        lOff.add(off)
        prev = off
        i = i + 1
    }
    bkLdObjValid = lValid
    bkLdObjOff = lOff
    bkObjDataOff = secOff + 8 + 4 * count
    return true
}

// bkObjRecPos: where baked function f's object record starts in
// bkObjBuf. Aborts if bkLoadObjCode did not read it -- paste or a hole
// scan on an unread record would decode whatever bytes sit at offset -1.
func bkObjRecPos(f: int): int {
    if f < 0 or f >= bkLdObjPos.count or bkLdObjPos[f] < 0 {
        abort("--rtbake: object code of baked function " + numToStr(f) + " was not read (not reachable at shake?)")
    }
    return bkLdObjPos[f]
}

// bkObjCheckFunc walks baked function f's record in bkObjBuf -- every run
// and hole inside the record, which it must fill exactly -- and checks
// each hole's reloc symbol (bkObjRelocSymValid). Logs why and returns
// false on the first fault.
func bkObjCheckFunc(f: int): bool {
    var p: int
    var e: int
    var nh: int
    var k: int
    var n: int
    var h: CgObjHole

    p = bkObjRecPos(f)
    e = p + bkObjLen(f)
    nh = bkObjBuf.intAt(p)
    p = p + 4
    if nh < 0 or nh > (e - p) / bkObjHoleBytes {
        log("--rtbake: object-code section: bad hole count in function " + numToStr(f))
        return false
    }
    k = 0
    while k <= nh {
        if p > e - 4 {
            log("--rtbake: object-code section: function " + numToStr(f) + " record truncated")
            return false
        }
        n = bkObjBuf.intAt(p)
        if n < 0 or n > e - p - 4 {
            log("--rtbake: object-code section: function " + numToStr(f) + " run out of range")
            return false
        }
        p = p + 4 + n
        if k < nh {
            if p > e - bkObjHoleBytes {
                log("--rtbake: object-code section: function " + numToStr(f) + " record truncated")
                return false
            }
            h = bkObjHoleAt(p)
            if not bkObjRelocSymValid(h.kind, h.cls, h.sym) {
                log("--rtbake: object-code section: reloc symbol " + numToStr(h.sym) + " out of range (kind " + numToStr(h.kind) + ", class " + numToStr(h.cls) + ")")
                return false
            }
            p = p + bkObjHoleBytes
        }
        k = k + 1
    }
    if p != e {
        log("--rtbake: object-code section: function " + numToStr(f) + " record has trailing bytes")
        return false
    }
    return true
}

// bkObjWanted: baked function f's object code is needed this compile --
// captured valid, inside this compile's runtime boundary, and reachable.
func bkObjWanted(f: int): bool {
    return f < bkRuntimeFuncBoundary and bkLdObjValid[f] and shakeReachable(f)
}

// bkLoadObjCode (format v9, spec 3.3) reads the object records of this
// compile's reachable baked functions into bkObjBuf -- called once shake
// has run (driveEmit68kFork), before Measure. Records sit in function
// order, so runs of reachable neighbours are read as one span. A no-op
// when no baked runtime is installed. Drops the loader's reference to
// the library's filehandle when done (the front end closes it).
func bkLoadObjCode(): bool {
    var n: int
    var f: int
    var g: int
    var total: int
    var start: int
    var end: int
    var span: text
    var pos: list of int
    var buf: text
    var ok: bool

    n = bkLdObjValid.count
    if bkRuntimeFuncBoundary == 0 or n == 0 {
        return true
    }
    if n > bkRuntimeFuncBoundary {
        n = bkRuntimeFuncBoundary
    }
    total = 0
    f = 0
    while f < n {
        pos.add(-1)
        if bkObjWanted(f) {
            total = total + bkObjLen(f)
        }
        f = f + 1
    }
    buf.reserve(total)
    f = 0
    while f < n {
        if bkObjWanted(f) {
            start = bkLdObjOff[f]
            end = bkLdObjOff[f + 1]
            pos[f] = buf.length
            g = f + 1
            while g < n and bkObjWanted(g) and bkLdObjOff[g] == end {
                pos[g] = buf.length + end - start
                end = bkLdObjOff[g + 1]
                g = g + 1
            }
            if not bkReadAt(-1, bkObjDataOff + start, end - start, span) {
                log("--rtbake: object-code section: short read (truncated library)")
                bkLibFh = nil
                return false
            }
            buf.append(span)
            f = g
        } else {
            f = f + 1
        }
    }
    span.release()
    bkLibFh = nil
    buf.shrink()
    bkObjBuf = buf
    bkLdObjPos = pos
    ok = true
    f = 0
    while f < n and ok {
        if pos[f] != -1 {
            ok = bkObjCheckFunc(f)
        }
        f = f + 1
    }
    return ok
}

// bkObjPoolIdxValid (object-code-linker Task 2): bkReadObjMeta's own
// lighter-weight defense-in-depth check, symmetric with
// bkObjRelocSymValid but over ONE function's own flat pool-ref index
// slice (bkLdObjFuncStrLitFlat[first, first+count) and friends -- see
// that field's own doc comment for why flat, not `list of list of int`)
// -- never a call target, so no kind/cls switch is needed, just "is this
// index inside the corresponding pool arena".
func bkObjPoolIdxValid(flat: list of int, first: int, count: int, bound: int): bool {
    var i: int
    var v: int

    i = 0
    while i < count {
        v = flat[first + i]
        if v < 0 or v >= bound {
            return false
        }
        i = i + 1
    }
    return true
}

// bkReadObjMeta (format v6, object-code-linker Task 2) mirrors
// bkWriteObjMeta field-for-field into bkLdObj* staging, refusing (same
// message path as bkReadObjIndex) the moment a function's own pool-ref
// index list names something outside that pool's own installed range.
// The wire shape is UNCHANGED (still count-then-elements per pool per
// function, matching bkWriteObjMeta exactly, which reads straight off
// cg68k.cla's own flat cgFuncPoolRefs, one kind at a time) -- only the
// STAGING shape flattens (bkLdObjFuncStrLitFirst/Count into one shared
// bkLdObjFuncStrLitFlat, per pool).
func bkReadObjMeta(): bool {
    var count: int
    var i: int
    var k: int
    var n: int
    var lSize: list of int
    var lFrame: list of int
    var lStrLitFirst: list of int
    var lStrLitCount: list of int
    var lStrLitFlat: list of int
    var lEnumTableFirst: list of int
    var lEnumTableCount: list of int
    var lEnumTableFlat: list of int
    var lSerdescFirst: list of int
    var lSerdescCount: list of int
    var lSerdescFlat: list of int
    var lUsesUiBlob: list of bool
    var lUsesUiEvents: list of bool
    var lSeg1ExtraSize: int
    var lGlueBundleSize: int
    var lPoolSize: int
    var lStrLitSize: list of int
    var lEnumTableSize: list of int
    var lSerdescSize: list of int
    var lUiBlobSize: int
    var lUiEventsSize: int

    count = bkGetU32()
    lSize = driveFreshIntList()
    lSize.reserve(bkFitCount(count))
    lFrame = driveFreshIntList()
    lFrame.reserve(bkFitCount(count))
    lStrLitFirst = driveFreshIntList()
    lStrLitFirst.reserve(bkFitCount(count))
    lStrLitCount = driveFreshIntList()
    lStrLitCount.reserve(bkFitCount(count))
    lStrLitFlat = driveFreshIntList()
    lEnumTableFirst = driveFreshIntList()
    lEnumTableFirst.reserve(bkFitCount(count))
    lEnumTableCount = driveFreshIntList()
    lEnumTableCount.reserve(bkFitCount(count))
    lEnumTableFlat = driveFreshIntList()
    lSerdescFirst = driveFreshIntList()
    lSerdescFirst.reserve(bkFitCount(count))
    lSerdescCount = driveFreshIntList()
    lSerdescCount.reserve(bkFitCount(count))
    lSerdescFlat = driveFreshIntList()
    lUsesUiBlob = driveFreshBoolList()
    lUsesUiBlob.reserve(bkFitCount(count))
    lUsesUiEvents = driveFreshBoolList()
    lUsesUiEvents.reserve(bkFitCount(count))
    i = 0
    while i < count {
        lSize.add(bkGetU32())
        lFrame.add(bkGetU32())

        n = bkGetU32()
        lStrLitFirst.add(lStrLitFlat.count)
        lStrLitCount.add(n)
        k = 0
        while k < n {
            lStrLitFlat.add(bkGetU32())
            k = k + 1
        }
        if not bkObjPoolIdxValid(lStrLitFlat, lStrLitFirst[i], n, bkLdIrStrLits.count) {
            emitDiag(1, 1, "--rtbake: object-meta section: pool-ref index out of range for function " + numToStr(i))
            return false
        }

        n = bkGetU32()
        lEnumTableFirst.add(lEnumTableFlat.count)
        lEnumTableCount.add(n)
        k = 0
        while k < n {
            lEnumTableFlat.add(bkGetU32())
            k = k + 1
        }
        if not bkObjPoolIdxValid(lEnumTableFlat, lEnumTableFirst[i], n, bkLdIrEnums.count) {
            emitDiag(1, 1, "--rtbake: object-meta section: pool-ref index out of range for function " + numToStr(i))
            return false
        }

        n = bkGetU32()
        lSerdescFirst.add(lSerdescFlat.count)
        lSerdescCount.add(n)
        k = 0
        while k < n {
            lSerdescFlat.add(bkGetU32())
            k = k + 1
        }
        if not bkObjPoolIdxValid(lSerdescFlat, lSerdescFirst[i], n, bkLdIrRecords.count) {
            emitDiag(1, 1, "--rtbake: object-meta section: pool-ref index out of range for function " + numToStr(i))
            return false
        }

        lUsesUiBlob.add(bkGetBool())
        lUsesUiEvents.add(bkGetBool())
        i = i + 1
    }
    // fix round 1 (review finding I2): the once-per-artifact fixed
    // buckets below are read into LOCALS too, same as everything above
    // -- a post-dispatch framing refusal (bkLoadSection's own
    // length check, run after this function returns)
    // must never land after a live bkLdObj* global was already written,
    // or a truncated/corrupt section could leave the staging state
    // half-updated even though the load as a whole gets refused.
    // bkReadObjIndex already has this shape (locals throughout, one
    // assignment block at the very end); this mirrors it.
    lSeg1ExtraSize = bkGetU32()
    lGlueBundleSize = bkGetU32()
    lPoolSize = bkGetU32()

    n = bkGetU32()
    lStrLitSize = driveFreshIntList()
    k = 0
    while k < n {
        lStrLitSize.add(bkGetU32())
        k = k + 1
    }
    n = bkGetU32()
    lEnumTableSize = driveFreshIntList()
    k = 0
    while k < n {
        lEnumTableSize.add(bkGetU32())
        k = k + 1
    }
    n = bkGetU32()
    lSerdescSize = driveFreshIntList()
    k = 0
    while k < n {
        lSerdescSize.add(bkGetU32())
        k = k + 1
    }
    lUiBlobSize = bkGetU32()
    lUiEventsSize = bkGetU32()

    bkLdObjFuncSize = lSize
    bkLdObjFuncFrameSize = lFrame
    bkLdObjFuncStrLitFirst = lStrLitFirst
    bkLdObjFuncStrLitCount = lStrLitCount
    bkLdObjFuncStrLitFlat = lStrLitFlat
    bkLdObjFuncEnumTableFirst = lEnumTableFirst
    bkLdObjFuncEnumTableCount = lEnumTableCount
    bkLdObjFuncEnumTableFlat = lEnumTableFlat
    bkLdObjFuncSerdescFirst = lSerdescFirst
    bkLdObjFuncSerdescCount = lSerdescCount
    bkLdObjFuncSerdescFlat = lSerdescFlat
    bkLdObjFuncUsesUiBlob = lUsesUiBlob
    bkLdObjFuncUsesUiEvents = lUsesUiEvents
    bkLdObjSeg1ExtraSize = lSeg1ExtraSize
    bkLdObjGlueBundleSize = lGlueBundleSize
    bkLdObjPoolSize = lPoolSize
    bkLdObjStrLitSize = lStrLitSize
    bkLdObjEnumTableSize = lEnumTableSize
    bkLdObjSerdescSize = lSerdescSize
    bkLdObjUiBlobSize = lUiBlobSize
    bkLdObjUiEventsSize = lUiEventsSize
    return true
}

// bkShakeSummaryValid: the loaded shake summary is structurally sound --
// its start list runs from 0 to the name list's length without
// decreasing, and the function entries fit in it (the rest are global
// entries, so their count is never negative). shake.cla's shakeReplay
// indexes both lists unchecked; a corrupt summary is refused as a
// framing mismatch instead.
func bkShakeSummaryValid(): bool {
    var i: int
    var n: int

    n = bkLdShakeStart.count
    if n == 0 or bkLdShakeStart[0] != 0 or bkLdShakeStart[n - 1] != bkLdShakeNames.count {
        return false
    }
    if bkLdShakeFuncs < 0 or bkLdShakeFuncs > n - 1 {
        return false
    }
    i = 1
    while i < n {
        if bkLdShakeStart[i] < bkLdShakeStart[i - 1] {
            return false
        }
        i = i + 1
    }
    return true
}

// bkLoadSection reads the resident section id (library offset off,
// length len) into bkLoadBuf and dispatches it to its own reader. Every
// reader must consume EXACTLY len bytes without running off the end, or
// the library is corrupt (or this loader has a field-order bug) -- either
// way, a clear diagnostic beats a garbled downstream compile. The ObjCode
// section is not read here: only its index is (bkReadObjIndex), and the
// testapi-only checker symbols are skipped unless testapi.
func bkLoadSection(id: int, off: int, len: int, testapi: bool): bool {
    if id == bkSecObjCode {
        return bkReadObjIndex(off, len)
    }
    if (id == bkSecCheckerSymbols or id == bkSecFieldInfo) and not testapi {
        // Checker-side sections: their only consumers (bkInstallChecker-
        // SymbolsForTestapi, bkInstallFieldInfo) run under --testapi alone.
        return true
    }
    if id == bkSecDeclFileTab {
        // Written, never read: bkComputeManifestPaths takes the same path
        // set from bkSecManifestHashes.
        return true
    }
    if not bkReadAt(id, off, len, bkLoadBuf) {
        emitDiag(1, 1, "--rtbake: section " + numToStr(id) + " short read (truncated library)")
        return false
    }
    bkLoadPos = 0
    bkLoadOverrun = false
    if id == bkSecIrTypes {
        bkLdIrTypes = bkReadIrTypes()
    } else if id == bkSecIrStmts {
        bkLdIrStmts = bkReadIrStmts()
    } else if id == bkSecIrExprs or id == bkSecGlobalInits {
        // bkSecGlobalInits is IrExprs-shaped: it installs as the irExprs
        // prefix (the 68k library carries no other expressions).
        bkLdIrExprs = bkReadIrExprs()
    } else if id == bkSecIrLocals {
        bkLdIrLocals = bkReadIrLocals()
    } else if id == bkSecIrFuncs {
        bkLdIrFuncs = bkReadIrFuncs()
    } else if id == bkSecIrFuncIdxByName {
        bkLdIrFuncIdxByName = bkReadIntIntMap()
    } else if id == bkSecIrCbGlueNames {
        bkLdIrCbGlueNames = bkReadIntList()
    } else if id == bkSecIrGlobals {
        bkLdIrGlobals = bkReadIrGlobals()
    } else if id == bkSecIrFieldSlots {
        bkLdIrFieldSlots = bkReadIrFieldSlots()
    } else if id == bkSecIrRecords {
        bkLdIrRecords = bkReadIrRecords()
    } else if id == bkSecIrEnumMembers {
        bkLdIrEnumMembers = bkReadIrEnumMembers()
    } else if id == bkSecIrEnums {
        bkLdIrEnums = bkReadIrEnums()
    } else if id == bkSecIrWidgetDescs {
        bkLdIrWidgetDescs = bkReadIrWidgetDescs()
    } else if id == bkSecIrColumnDescs {
        bkLdIrColumnDescs = bkReadIrColumnDescs()
    } else if id == bkSecIrBindDescs {
        bkLdIrBindDescs = bkReadIrBindDescs()
    } else if id == bkSecIrWindowDescs {
        bkLdIrWindowDescs = bkReadIrWindowDescs()
    } else if id == bkSecIrMenuItemDescs {
        bkLdIrMenuItemDescs = bkReadIrMenuItemDescs()
    } else if id == bkSecIrMenuDescs {
        bkLdIrMenuDescs = bkReadIrMenuDescs()
    } else if id == bkSecIrWinHandlers {
        bkLdIrWinHandlers = bkReadIrWinHandlers()
    } else if id == bkSecIrWidgetHandlerEntries {
        bkLdIrWidgetHandlerEntries = bkReadIrWidgetHandlerEntries()
    } else if id == bkSecIrMenuHandlerEntries {
        bkLdIrMenuHandlerEntries = bkReadIrMenuHandlerEntries()
    } else if id == bkSecIrEveryEntries {
        bkLdIrEveryEntries = bkReadIrEveryEntries()
    } else if id == bkSecIrStrLits {
        bkLdIrStrLits = bkReadIntList()
    } else if id == bkSecIrArrLits {
        bkReadIrArrLits()
    } else if id == bkSecShakeSummary {
        bkLdShakeFuncs = bkGetU32()
        bkLdShakeStart = bkReadIntList()
        bkLdShakeNames = bkReadIntList()
        if not bkShakeSummaryValid() {
            bkLoadOverrun = true
        }
    } else if id == bkSecIrExternNames {
        bkLdIrExternNames = bkReadIntList()
    } else if id == bkSecIrExternRetTys {
        bkLdIrExternRetTys = bkReadIntList()
    } else if id == bkSecIrExternParamStart {
        bkLdIrExternParamStart = bkReadIntList()
    } else if id == bkSecIrExternParamCountArr {
        bkLdIrExternParamCountArr = bkReadIntList()
    } else if id == bkSecIrExternParamTys {
        bkLdIrExternParamTys = bkReadIntList()
    } else if id == bkSecIrExternTrapWords {
        bkLdIrExternTrapWords = bkReadIntList()
    } else if id == bkSecIrExternConvs {
        bkLdIrExternConvs = bkReadIntList()
    } else if id == bkSecIrExternSels {
        bkLdIrExternSels = bkReadIntList()
    } else if id == bkSecIrExternParamRegs {
        bkLdIrExternParamRegs = bkReadIntList()
    } else if id == bkSecIrExternRetRegs {
        bkLdIrExternRetRegs = bkReadIntList()
    } else if id == bkSecIrLayoutNeededByName {
        bkLdIrLayoutNeededByName = bkReadIntIntMap()
    } else if id == bkSecIrRcWalkNeededByName {
        bkLdIrRcWalkNeededByName = bkReadIntIntMap()
    } else if id == bkSecIrScalars {
        bkReadIrScalars()
    } else if id == bkSecStrPool {
        bkReadStrPool()
    } else if id == bkSecLowCounters {
        bkReadLowCounters()
    } else if id == bkSecCheckerSymbols {
        bkReadCheckerSymbols()
    } else if id == bkSecFieldInfo {
        bkReadFieldInfo()
    } else if id == bkSecUitestBounds {
        bkReadUitestBounds()
    } else if id == bkSecCheckerVisibility {
        bkReadCheckerVisibility()
    } else if id == bkSecManifestHashes {
        bkReadManifestHashes()
    } else if id == bkSecObjMeta {
        if not bkReadObjMeta() {
            return false
        }
    } else {
        emitDiag(1, 1, "--rtbake: unknown section id " + numToStr(id))
        return false
    }
    if bkLoadOverrun or bkLoadPos != len {
        emitDiag(1, 1, "--rtbake: section " + numToStr(id) + " framing mismatch (corrupt library)")
        return false
    }
    return true
}

// feExpectedStamp is a front-end seam (mirrors feReadSource/feHasKey/
// feProgress, drive.cla): "what stamp should a bake generated by THIS
// running compiler build carry?" bkCheckRtbakeHeader calls it instead of
// hashing clarusc/clarusc.c inline, so each front end can answer however
// fits its own filesystem. The host CLI (main.cla, clarusc/test/
// dblcompile*.cla) re-hashes clarusc/clarusc.c off disk (bkFindClarusC/
// bkHashText). macgui.cla has no clarusc/clarusc.c on ClarusC.APPL's own
// boot disk at all -- it reads a tiny 4-byte stamp sidecar baked
// alongside the library instead (computed by the SAME `--bake-ir` run
// that generated the library, so the two always agree by construction;
// see macgui.cla's own feExpectedStamp).
//
// bkCheckRtbakeHeader (format v9: a header-only stamp and version check,
// W6) reads the header, module list and directory in one readAt of at
// most bkHeaderMax bytes at library offset 0 of fh (base: the library's
// offset in that file) and validates magic, format version, lane and
// stamp against wantLane -- WITHOUT reading any section, so a front end
// can cheaply ask "would this library be accepted?" before committing to
// it. On success it leaves the header bytes in bkLoadBuf with the cursor
// just past the stamp (the module list), and bkLibFh/bkLibBase set, for
// bkLoadRtbake to parse on from; on failure it leaves neither behind.
//
// Stamp contract (Task 4's own open question (a)): the stamp is a hash of
// the committed clarusc/clarusc.c snapshot (bkHashText/bkFindClarusC) on
// the host lane; the Mac lane's own sidecar (above) is that SAME value,
// computed once at bake-generation time. Known gap, accepted: a dev
// binary built from EDITED .cla sources still stamps/checks against the
// COMMITTED snapshot, since bkFindClarusC always reads clarusc/clarusc.c
// off disk, never the running binary's own (possibly different) source --
// the generator and every loader share that exact same proxy, so a bake
// generated and loaded by binaries built from the same checkout always
// agree, and the snapshot is regenerated at every phase close (CLAUDE.md).
func bkCheckRtbakeHeader(fh: filehandle, base: int, wantLane: int): bool {
    if bkCheckRtbakeHeaderBody(fh, base, wantLane) {
        return true
    }
    bkLoadBuf.release()
    bkLibFh = nil
    return false
}

func bkCheckRtbakeHeaderBody(fh: filehandle, base: int, wantLane: int): bool {
    var magic: string
    var version: int
    var lane: int
    var stampLen: int
    var stamp: int
    var expectStamp: int

    bkLoadOverrun = false
    bkLibFh = fh
    bkLibBase = base
    // magic(4) + formatVersion(4) + laneTag(1) + stampLen(2) + stamp(4):
    // 15 bytes; a short read past them is fine (the file may be smaller
    // than bkHeaderMax).
    if not fh.readAt(base, bkHeaderMax, bkLoadBuf) or bkLoadBuf.length < 15 {
        emitDiag(1, 1, "--rtbake: file too short to be a CLIR library")
        return false
    }
    BakeReadLog(0, bkLoadBuf.length)
    magic = bkLoadBuf[0, 4]
    if magic != bkMagic {
        emitDiag(1, 1, "--rtbake: bad magic (not a CLIR library)")
        return false
    }
    bkLoadPos = 4
    version = bkGetU32()
    if version != bkFormatVersion {
        emitDiag(1, 1, "--rtbake: format version " + numToStr(version) + " unsupported (want " + numToStr(bkFormatVersion) + ")")
        return false
    }
    lane = bkGetByte()
    if lane != wantLane {
        emitDiag(1, 1, "--rtbake: lane mismatch (bake is " + bkLaneName(lane) + ", this compile wants " + bkLaneName(wantLane) + ")")
        return false
    }
    stampLen = bkGetU16()
    if stampLen != 4 {
        emitDiag(1, 1, "--rtbake: unexpected stamp length " + numToStr(stampLen))
        return false
    }
    stamp = bkGetU32()
    expectStamp = feExpectedStamp()
    if stamp != expectStamp {
        emitDiag(1, 1, "--rtbake: stamp mismatch (bake=" + numToStr(stamp) + ", this compiler=" + numToStr(expectStamp) + "); regenerate with --bake-ir")
        return false
    }
    return true
}

// bkLoadRtbake loads the library at offset base of fh (the front end
// opened it; `--rtbake FILE` is base 0 of FILE) into the bkLd*/bkLoaded*
// pending globals above, validating the header (bkCheckRtbakeHeader)
// against wantLane (bkLane68k for emit68k, bkLaneC for emit) first -- a
// refused header reads and stages nothing. Then the module list and
// directory, then every resident section, one readAt each. Touches no
// live compiler state -- see bkInstallPool/bkInstallArenas for that. The
// object code stays in the file for bkLoadObjCode.
func bkLoadRtbake(fh: filehandle, base: int, wantLane: int, testapi: bool): bool {
    var i: int
    var j: int
    var n: int
    var want: int
    var size: int
    var loadedMods: list of string
    var ids: list of int
    var offs: list of int
    var lens: list of int
    var ok: bool

    // SE wave 1: a compile that failed between this parse and the end of
    // its install sequence (a user-code check error, an abort) left its
    // IR staging behind -- drop it before parsing on top of it.
    bkFreeParseStaging()
    // A refused library must leave no object index behind (driveReset
    // already dropped the previous compile's object code).
    bkLdObjValid = driveFreshBoolList()
    if not bkCheckRtbakeHeader(fh, base, wantLane) {
        return false
    }

    // runtime-ir-bake Task 5 (b): retained (not discarded) into
    // bkLoadedModules -- bkComputeManifestPaths (below) turns these
    // module KEYS (rtModuleKey's "runtime/clarus/NAME" form) into the
    // disk-path identity expand()'s own dedup uses, so a user `include`
    // of one of these SAME files is detected during Phase A instead of
    // silently double-declaring against the baked IR.
    n = bkGetU16()
    i = 0
    while i < n {
        loadedMods.add(bkGetStrShort())
        i = i + 1
    }
    bkLoadedModules = loadedMods

    // The directory: exactly the lane's section set (bkSectionInLane),
    // each id once, every section inside the file.
    want = bkSectionCountC
    if wantLane == bkLane68k {
        want = bkSectionCount68k
    }
    n = bkGetU16()
    size = fh.size() - base
    ok = not bkLoadOverrun and n == want
    i = 0
    while ok and i < n {
        ids.add(bkGetU16())
        offs.add(bkGetU32())
        lens.add(bkGetU32())
        ok = not bkLoadOverrun and offs[i] >= 0 and lens[i] >= 0 and offs[i] <= size - lens[i] and bkSectionInLane(ids[i], wantLane)
        j = 0
        while ok and j < i {
            ok = ids[j] != ids[i]
            j = j + 1
        }
        i = i + 1
    }
    bkLoadBuf.release()
    if not ok {
        bkLibFh = nil
        emitDiag(1, 1, "--rtbake: corrupt header (module list or section directory)")
        return false
    }

    ok = true
    i = 0
    while ok and i < n {
        ok = bkLoadSection(ids[i], offs[i], lens[i], testapi)
        driveProgressTick()
        i = i + 1
    }
    bkLoadBuf.release()
    if not ok {
        bkLibFh = nil
        return false
    }
    // The baked arenas' sizes, for the lazy object read's reloc checks
    // (bkObjLim*'s own doc comment).
    bkObjLimFuncs = bkLdIrFuncs.count
    bkObjLimCbGlue = bkLdIrCbGlueNames.count
    bkObjLimPool = bkLdStrOff.count - 1
    bkObjLimStrLits = bkLdIrStrLits.count
    bkObjLimArrLits = bkLdIrArrLitElemT.count
    bkObjLimEnums = bkLdIrEnums.count
    bkObjLimRecords = bkLdIrRecords.count
    return true
}

// ================================================================
// Install by move (SE wave 1, spec 4.3)
// ================================================================
//
// Every bkInstall* function below MOVES its pending container into the
// live compiler global (plain assignment -- `list`/`map`/`intmap` are
// reference types) and then leaves the pending global as a fresh empty
// container, so the live global is the ONLY reference left. That is
// safe because the parse is no longer memoized: every compile re-parses
// the bake from its front end's fresh bytes (driveCompile), so nothing
// ever needs the pending copy again once it is installed. (clir-load-
// perf Task 7's design B copied instead, to keep a once-per-session
// parse pristine; that memo cost a second full copy of the baked
// runtime for the whole compile.) What a move leaves behind in the
// staging globals -- the parse-only scalars, the testapi-only checker
// state a non-testapi compile never installs -- is dropped by
// bkFreeParseStaging at the end of the install sequence. The bkLdObj*
// tables are NOT staging in this sense: codegen reads them until the
// fork is built (spec 4.3), so nothing here touches them.

// bkInstallPool moves the intern-pool prefix into live strBlob/strOff/strIndex
// -- called by driveCompile BEFORE Phase A (see its own doc comment for
// why: every baked IR arena's string-index fields are absolute pool
// indices captured at bake time, so nothing may intern() a NEW string
// before this runs, or a user identifier could steal one of those low
// indices out from under the baked arenas). Rebuilds strIndex alongside
// (not just the pool) so a user identifier/literal identical to a baked
// one dedups against it via the ordinary intern() path, the same as any
// other repeated string -- a nice-to-have (avoids pool bloat), not
// load-bearing (nothing downstream iterates strBlob/strOff/strIndex; every
// consumer is a by-index poolGet or a by-value map lookup, per this
// task's report).
func bkInstallPool() {
    var freshIndex: map of int
    var i: int
    var e0: text
    var e1: list of int

    strBlob = bkLdStrBlob
    strOff = bkLdStrOff
    // Staging reset after a move -- keep as a reassignment (not
    // .release()): the blob/offsets now belong to strBlob/strOff.
    bkLdStrBlob = e0
    bkLdStrOff = e1
    freshIndex = driveFreshIntMap()
    strIndex = freshIndex
    i = 0
    while i < poolCount() {
        strIndex[poolGet(i)] = i
        i = i + 1
    }
}

// bkInstallTypeArenaPrefix (Task 5, deliverable (a)): testapi-only --
// replaces the just-checkReset()'d typeArena/enumMembers with the baked
// versions (Task 4's retained bkLoadedTypeArena/bkLoadedEnumMembers),
// BEFORE the user program's own checkPhase1 creates any type of its own
// -- the same "install a verbatim-identical prefix, so baked indices
// stay valid, before anything else can intern/allocate on top of it"
// discipline bkInstallPool already uses for the intern pool, applied here to
// typeArena instead.
//
// Why this is needed at all (found the hard way, via a real crash): NOT
// every type is a checkReset()-seeded singleton at a fixed low index --
// typesInit() only pre-seeds ~11 kind-only singletons (int/bool/fixed/
// char/text/void/address/ptr/error/callback + the saveChoice enum);
// TyStr (`string`) is NOT among them (types.cla's typesInit, directly
// read) -- it gets its own fresh typeArena entry on first use, so its
// INDEX depends on how many other types were interned before it in THIS
// PARTICULAR process. UiTestVerb and five of its own siblings take a
// `string` parameter -- their baked FuncSig.params entries are baked-
// PROCESS-specific indices, invalid against a live compile's own
// (much smaller, freshly checkReset()'d) typeArena. bkInstallCheckerSym
// bolsForTestapi's own fresh-FuncSig construction copies those baked
// indices verbatim (by design -- see its own doc comment on why that's
// safe for TRUE singletons), so this install has to run first, or
// typeKind(pt) on a copied-but-invalid index reads out of bounds
// (verified: "runtime error: list index out of range", reproduced with a
// --testapi bake fixture that actually CALLS UiTestVerb, not just
// declares a window -- tickprobe.cla's own fixture never calls any
// UiTest* function, which is why it never tripped this).
//
// Safe by the identical determinism argument bkInstallPool's own doc
// comment already makes for the intern pool: typesInit()'s singleton seeding is
// unconditional and first (typesReset -> typesInit, called at the very
// top of checkReset(), before ANYTHING else in this compile could
// intern/allocate a type) in BOTH the bake generator's own checkReset()
// call and this compile's -- so the baked typeArena's own FIRST ~11
// entries are BYTE-IDENTICAL to what this compile's checkReset() just
// built, and REPLACING (not appending to) the just-built array with the
// baked one is exactly "the singleton prefix, then more" -- never a
// mismatch. enumMembers travels the same way (seedSaveChoice, called
// from the SAME typesInit(), is equally deterministic).
func bkInstallTypeArenaPrefix() {
    var e0: list of TypeInfo
    var e1: list of EnumMemberInfo

    typeArena = bkLoadedTypeArena
    enumMembers = bkLoadedEnumMembers
    // Staging resets after a move -- keep as reassignments.
    bkLoadedTypeArena = e0
    bkLoadedEnumMembers = e1
}

// bkInstallFieldInfo (fallback-trigger-narrowing Task 2): the same
// wholesale-replace argument bkInstallTypeArenaPrefix's own doc comment
// makes, simpler still -- fieldInfos/recFieldsHeadByName have no
// deterministic singleton prefix to preserve (checkReset's own
// fieldInfos.clear() / fresh recFieldsHeadByName map leaves both
// genuinely empty), and nothing between checkReset() and this call (in
// the SAME testapi+UI branch that calls bkInstallTypeArenaPrefix, right
// before it) ever touches either global, so a straight replace is exactly
// "empty, then the baked content." Must run before checkPhase1 for the
// same reason bkInstallTypeArenaPrefix must: check.cla's own field-access
// resolution (and lower.cla's, during lowering) reads these tables
// directly, and a record type made NAMEABLE by the typeArena/checker-
// symbol install without its OWN fields installed here resolves the type
// but not `.fieldName` on it -- see bkSecFieldInfo's own doc comment for
// how this was found.
func bkInstallFieldInfo() {
    var e0: list of FieldInfo
    var e1: intmap of int

    fieldInfos = bkLoadedFieldInfos
    recFieldsHeadByName = bkLoadedRecFieldsHeadByName
    // Staging resets after a move -- keep as reassignments.
    bkLoadedFieldInfos = e0
    bkLoadedRecFieldsHeadByName = e1
}

// bkComputeManifestPaths (Task 5, deliverable (b)) builds bkManifestPaths
// -- the disk-path identity expand()'s own hostPaths branch would compute
// for each baked runtime module (normalizePath(joinPath(rtDir, NAME)),
// bare NAME recovered by stripping rtModuleKey("")'s own fixed prefix off
// each retained "runtime/clarus/NAME" key) -- so a user `include` of one
// of these SAME files collides during Phase A's own expand() calls
// (drive.cla's new haveRtbake-gated check) instead of silently double-
// declaring against the baked IR. Resolves rtDir the same lazy-fill-once
// way bakeGenerateChain/driveManifestSplice already do, so a --rtdir
// override (or its absence) is honored identically. Called once, right
// after bkInstallPool, before Phase A parses any user entries.
func bkComputeManifestPaths() {
    var i: int
    var prefixLen: int
    var bareMod: string
    var p: string
    var junk: int
    var m: map of bool

    if bkLoadedModules.count > 0 {
        prefixLen = rtModuleKey("").length
        if not haveRtDir {
            rtDir = findRtDir(bkLoadedModules[0][prefixLen, bkLoadedModules[0].length - prefixLen])
        }
        i = 0
        while i < bkLoadedModules.count {
            bareMod = bkLoadedModules[i][prefixLen, bkLoadedModules[i].length - prefixLen]
            // filesystem-api Task 3: prelude.cla is deliberately excluded
            // from THIS loop's own contribution to bkManifestPaths (the
            // drift-guard's own gate, `bkManifestPaths.has(path)` in
            // expand()), even though it IS one of bakeModuleList's
            // entries (bkWriteManifestHashes still hashes it into
            // bkManifestHashes like any other module -- this is the ONLY
            // place it's skipped). This narrows the drift guard for
            // prelude.cla, it does NOT disable it: the SECOND loop below
            // (bkManifestHashes' keys) unconditionally re-adds every baked
            // decl's own file path, prelude.cla included, using the
            // disk-path string --bake-ir time itself recorded -- so on an
            // ordinary invocation (use-time's own findRtDir resolution
            // happens to match --bake-ir time's, typically because both
            // ran from the repo root) bkManifestPaths.has(path) is STILL
            // true via that second loop, and expand()'s own drift check
            // still runs and still catches genuine staleness (fix round
            // 1, Task 3 review finding 2; verified by experiment: a
            // deliberately stale bake with a mutated prelude.cla falls
            // back to a from-source recompile and emits the record once,
            // with the correct current layout -- the same outcome as
            // every other bakeModuleList module's own drift case).
            // What this loop's own exclusion changes is narrower: unlike
            // every other bakeModuleList module, prelude.cla is
            // unconditionally re-expanded from source on EVERY compile,
            // --rtbake included (drive.cla's own driveCompile splice, not
            // anchored to any user entry file's own directory the way a
            // nested include would be) -- so on a --rtbake compile whose
            // OWN working directory sits at a different depth than
            // whatever --bake-ir's invocation used, THIS loop's own
            // (unexcluded) entry would have been a FRESH per-compile
            // findRtDir recomputation that could never equal the second
            // loop's own bake-time string either -- a false "drift" (not
            // a real content difference), since the two loops would then
            // disagree about which string identifies prelude.cla. Found
            // via internal/mactest's own DoubleCompileBake leak-gate
            // case, which runs driveCompile from a nested build-run/
            // subdir on purpose -- a false "drifted" report there
            // silently forced a full from-source fallback recompile
            // instead of exercising the real bake-install path the test
            // specifically checks.
            if bareMod != "prelude.cla" {
                p = normalizePath(joinPath(rtDir, bareMod))
                m[p] = true
            }
            i = i + 1
        }
    }
    // runtime-ir-bake Task 5, fix round 2: ALSO cover every file the
    // bake transitively touched, not just bakeModuleList's own top-level
    // 17/18 entries -- found the hard way, building the toolbox suite:
    // uidialogs.cla itself `include`s toolbox/files.cla and toolbox/
    // standardfile.cla (nested, not a top-level bakeModuleList module),
    // and the toolbox suite's OWN gui.cla composition ALSO names toolbox/
    // files.cla directly as one of its own entry files -- from-source
    // handles this the ordinary way (expand()'s own dedup/hoisting
    // recognizes the SAME disk path reached two ways and hoists the
    // user's already-parsed instance into the runtime chain's position
    // instead of re-declaring it); the bake path has no live re-parse of
    // the runtime side to dedup against, so without this, a suite
    // composition that directly names a nested-include file collides
    // (two declarations of the same names) instead of falling back.
    // The paths are bkManifestHashes' keys: bkWriteManifestHashes wrote
    // one entry per distinct file the bake expanded, nested includes
    // included, keyed by the same bake-time disk-path string every baked
    // decl's declFileTab entry names. (It read the checker-side
    // bkSecDeclFileTab until CLIR v9, which reads that section never:
    // spec 3.3 keeps the checker sections off the ordinary compile path.)
    for p, junk in bkManifestHashes {
        m[p] = true
    }
    bkManifestPaths = m
    // SE wave 1: this is the last reader of the module list -- drop it.
    bkLoadedModules.release()
}

// bkInstallArenas is the second install step -- called by driveCompile
// AFTER check#1 (so the retained-but-uninstalled checker-symbol state
// above can never influence check#1's own diagnostics for user code --
// this task's open question (b)) and BEFORE the bake-path lowerProgram
// call, immediately after irReset() has just cleared every arena this
// function is about to overwrite ("install = deserialize into the
// just-reset arenas," the brief's own contract).
//
// The eight reverse-waist dispatcher stubs (clar_ui_fire_winevent and
// its seven siblings, lower.cla's lowSynthUiDispatchers) used to need a
// by-name install-time filter here (Task 4's own original design): the
// runtime-only bake generator built them against an always-empty/false
// irWindowDescs/irMenuDescs/irEveryCount/irHasStartEmpty/
// irHasOpenDocument, so their baked bodies were permanently the
// no-handler stub shape -- never this program's real one -- and had to
// be dropped so the REAL per-compile lowerProgram(combined2) call's own
// (unconditional) dispatcher rebuild could claim their names fresh.
// Task 5 fix round 1 removed the filter instead: bake.cla's own
// generator now sets lower.cla's lowSkipUiDispatchers around both its
// lowerProgram calls, so the baked arenas never contain these eight
// entries (or their panic-message string literals) AT ALL -- there is
// nothing left to filter. Verified nothing else in bkInstallArenas or
// bake.cla depended on the removed skip list before deleting it.
// testapi (Task 5, inherited-problem fix): when false, irFuncs and
// irStrLits are truncated back to the base/uitest boundary
// (bkLdBaseIrFuncsCount/bkLdBaseIrStrLitsCount, bkSecUitestBounds) BEFORE
// the dispatcher-name filter below runs, dropping uitest.cla's own
// functions and string literals entirely -- exactly what a from-source
// non-testapi compile has (it never splices uitest.cla in the first
// place, bakeModuleList's own doc comment), closing the byte-identity gap
// Task 4's report root-caused (cg68k.cla's single-segment shortcut and
// cprint.cla's string-literal-pool printer both walk irStrLits by
// PRESENCE, not shake reachability). testapi=true installs both arenas in
// full, unchanged from Task 4's own behavior -- a from-source --testapi
// build ALSO always carries uitest.cla (driveEarlySplice), so there is no
// gap to close on that path.
func bkInstallArenas(testapi: bool, dropUilog: bool) {
    var i: int
    var filteredIdx: intmap of int
    var nm: int
    var junkFunc: IRFunc
    var junkInt: int
    var nArrLits: int
    var nVals: int
    var startSum: int
    var arrStart: list of int
    var freshArrLitMemo: intmap of int
    var freshStrIdx: map of int
    var strKey: string
    var strVal: int
    var eTypes: list of IRType
    var eStmts: list of IRStmt
    var eExprs: list of IRExpr
    var eLocals: list of IRLocal
    var eFuncs: list of IRFunc
    var eGlobals: list of IRGlobal
    var eFieldSlots: list of IRFieldSlot
    var eRecords: list of IRRecordLayout
    var eEnumMembers: list of IREnumMember
    var eEnums: list of IREnumLayout
    var eWidgetDescs: list of IRWidgetDesc
    var eColumnDescs: list of IRColumnDesc
    var eBindDescs: list of IRBindDesc
    var eWindowDescs: list of IRWindowDesc
    var eMenuItemDescs: list of IRMenuItemDesc
    var eMenuDescs: list of IRMenuDesc
    var eWinHandlers: list of IRWinHandlers
    var eWidgetHandlerEntries: list of IRWidgetHandlerEntry
    var eMenuHandlerEntries: list of IRMenuHandlerEntry
    var eEveryEntries: list of IREveryEntry
    var eLayoutNeeded: intmap of int
    var eRcWalkNeeded: intmap of int

    // Install by MOVE (SE wave 1, spec 4.3 -- see this section's banner
    // above): each pending container becomes the live global, and the
    // pending global is left as a fresh empty container. Every `bkLdX =
    // eX` / `bkLdX = driveFreshIntList()` reset below is a staging reset
    // after a move -- it must stay a REASSIGNMENT (never `.release()`),
    // because the storage now belongs to the live global.
    irTypes = bkLdIrTypes
    bkLdIrTypes = eTypes
    irStmts = bkLdIrStmts
    bkLdIrStmts = eStmts
    irExprs = bkLdIrExprs
    bkLdIrExprs = eExprs
    irLocals = bkLdIrLocals
    bkLdIrLocals = eLocals

    // A non-testapi install truncates irFuncs/irStrLits back to the
    // base/uitest boundary (see this function's own doc comment): move
    // the whole list, then pop the uitest tail off it -- a few dozen
    // entries, once per compile.
    irFuncs = bkLdIrFuncs
    bkLdIrFuncs = eFuncs
    irStrLits = bkLdIrStrLits
    bkLdIrStrLits = driveFreshIntList()
    if not testapi {
        while irFuncs.count > bkLdBaseIrFuncsCount {
            junkFunc = irFuncs.pop()
        }
        while irStrLits.count > bkLdBaseIrStrLitsCount {
            junkInt = irStrLits.pop()
        }
    }

    // Array literals (format version 8, language-runtime-cleanup spec
    // %4.4): the same base/uitest truncation irStrLits just got --
    // uitest.cla's own literals are not part of a non-testapi install.
    // irArrLitStart is rebuilt here as the prefix sum of the surviving
    // lengths rather than baked, so a truncation can never leave a stale
    // offset behind.
    irArrLitElemT = bkLdIrArrLitElemT
    irArrLitN = bkLdIrArrLitN
    irArrLitVals = bkLdIrArrLitVals
    bkLdIrArrLitElemT = driveFreshIntList()
    bkLdIrArrLitN = driveFreshIntList()
    bkLdIrArrLitVals = driveFreshIntList()
    nArrLits = irArrLitElemT.count
    if not testapi {
        if bkLdBaseIrArrLitsCount < nArrLits {
            nArrLits = bkLdBaseIrArrLitsCount
        }
    }
    while irArrLitElemT.count > nArrLits {
        junkInt = irArrLitElemT.pop()
        junkInt = irArrLitN.pop()
    }
    startSum = 0
    i = 0
    while i < nArrLits {
        arrStart.add(startSum)
        startSum = startSum + irArrLitN[i]
        i = i + 1
    }
    irArrLitStart = arrStart
    nVals = startSum
    while irArrLitVals.count > nVals {
        junkInt = irArrLitVals.pop()
    }

    // No by-name filter needed any more (see this function's own doc
    // comment) -- irFuncs (already truncated above for non-testapi)
    // installs verbatim; irFuncIdxByName still needs its own fresh
    // build (not the loaded map) since a non-testapi truncation drops
    // entries the loaded map's own indices would still reference.
    //
    // object-code-linker Task 2: the object-code boundary global, set
    // here so it exists for a future compile's own link pass regardless
    // of whether the artifact carries any object sections at all (lane
    // c, or a pre-Task-2 bake -- format refused outright by version, but
    // defensive regardless). clir-load-perf Task 7: this is now also the
    // paste-eligibility bound itself (see its own doc comment).
    bkRuntimeFuncBoundary = irFuncs.count
    i = 0
    while i < irFuncs.count {
        nm = irFuncs[i].name
        if not filteredIdx.has(nm) {
            filteredIdx[nm] = i
        }
        i = i + 1
    }
    irFuncIdxByName = filteredIdx

    irCbGlueNames = bkLdIrCbGlueNames
    bkLdIrCbGlueNames = driveFreshIntList()
    irGlobals = bkLdIrGlobals
    bkLdIrGlobals = eGlobals
    irFieldSlots = bkLdIrFieldSlots
    bkLdIrFieldSlots = eFieldSlots
    irRecords = bkLdIrRecords
    bkLdIrRecords = eRecords
    irEnumMembers = bkLdIrEnumMembers
    bkLdIrEnumMembers = eEnumMembers
    irEnums = bkLdIrEnums
    bkLdIrEnums = eEnums
    irWidgetDescs = bkLdIrWidgetDescs
    bkLdIrWidgetDescs = eWidgetDescs
    irColumnDescs = bkLdIrColumnDescs
    bkLdIrColumnDescs = eColumnDescs
    irBindDescs = bkLdIrBindDescs
    bkLdIrBindDescs = eBindDescs
    irWindowDescs = bkLdIrWindowDescs
    bkLdIrWindowDescs = eWindowDescs
    irMenuItemDescs = bkLdIrMenuItemDescs
    bkLdIrMenuItemDescs = eMenuItemDescs
    irMenuDescs = bkLdIrMenuDescs
    bkLdIrMenuDescs = eMenuDescs
    irWinHandlers = bkLdIrWinHandlers
    bkLdIrWinHandlers = eWinHandlers
    irWidgetHandlerEntries = bkLdIrWidgetHandlerEntries
    bkLdIrWidgetHandlerEntries = eWidgetHandlerEntries
    irMenuHandlerEntries = bkLdIrMenuHandlerEntries
    bkLdIrMenuHandlerEntries = eMenuHandlerEntries
    irEveryEntries = bkLdIrEveryEntries
    bkLdIrEveryEntries = eEveryEntries
    // Task 7 fix round 1: the install just REPLACED irArrLits, so every
    // IR index lowArrLitIrIdx memoized is now meaningless -- and unlike
    // lowStrIdx (which the bake deliberately saves and RESTORES, so the
    // baked prefix's string dedup continues) there is nothing here to
    // carry over: lowArrLitIrIdx is keyed by the CHECKER literal index,
    // which restarts at 0 every checkReset, so the memo must simply be
    // EMPTY at the start of every compile. lowerProgram's own reset does
    // not cover this path -- drive.cla sets lowResumeFromBake = true for
    // the user-code lowering that follows an install (drive.cla:2390),
    // which is exactly the block that reset lives in. Without this, a
    // ClarusC.APPL session compiling a second program reuses compile #1's
    // irArrLits index against compile #2's freshly installed arena --
    // the same "list index out of range" crash mac-resident-clarusc Task
    // 11 fix round 1 root-caused for lowStrIdx (see its own doc comment,
    // lower.cla).
    lowArrLitIrIdx = freshArrLitMemo
    irExternNames = bkLdIrExternNames
    bkLdIrExternNames = driveFreshIntList()
    irExternRetTys = bkLdIrExternRetTys
    bkLdIrExternRetTys = driveFreshIntList()
    irExternParamStart = bkLdIrExternParamStart
    bkLdIrExternParamStart = driveFreshIntList()
    irExternParamCountArr = bkLdIrExternParamCountArr
    bkLdIrExternParamCountArr = driveFreshIntList()
    irExternParamTys = bkLdIrExternParamTys
    bkLdIrExternParamTys = driveFreshIntList()
    irExternTrapWords = bkLdIrExternTrapWords
    bkLdIrExternTrapWords = driveFreshIntList()
    irExternConvs = bkLdIrExternConvs
    bkLdIrExternConvs = driveFreshIntList()
    irExternSels = bkLdIrExternSels
    bkLdIrExternSels = driveFreshIntList()
    irExternParamRegs = bkLdIrExternParamRegs
    bkLdIrExternParamRegs = driveFreshIntList()
    irExternRetRegs = bkLdIrExternRetRegs
    bkLdIrExternRetRegs = driveFreshIntList()
    irLayoutNeededByName = bkLdIrLayoutNeededByName
    bkLdIrLayoutNeededByName = eLayoutNeeded
    irRcWalkNeededByName = bkLdIrRcWalkNeededByName
    bkLdIrRcWalkNeededByName = eRcWalkNeeded

    // SE wave 4 Task 2: the shake summary, by move. shakeProgram gates it
    // on bkRuntimeFuncBoundary (set above), so a non-testapi truncation
    // needs nothing here: the dropped uitest entries are simply never
    // consulted. Globals are not truncated, so all baked ones use it.
    shakeSumFuncs = bkLdShakeFuncs
    shakeSumGlobals = bkLdShakeStart.count - 1 - bkLdShakeFuncs
    shakeSumStart = bkLdShakeStart
    shakeSumNames = bkLdShakeNames
    bkLdShakeStart = driveFreshIntList()
    bkLdShakeNames = driveFreshIntList()

    irHasLaunch = bkLdIrHasLaunch
    irHasStartEmpty = bkLdIrHasStartEmpty
    irHasStartCLI = bkLdIrHasStartCLI
    irHasOpenDocument = bkLdIrHasOpenDocument
    irAppName = bkLdIrAppName
    irAppVersion = bkLdIrAppVersion
    irAppAuthor = bkLdIrAppAuthor
    irAppAbout = bkLdIrAppAbout
    irAppId = bkLdIrAppId
    irAppDoctype = bkLdIrAppDoctype
    irAppStack = bkLdIrAppStack
    irHasApp = bkLdIrHasApp
    irMenuHandlersHead = bkLdIrMenuHandlersHead
    irMenuHandlersTail = bkLdIrMenuHandlersTail
    irMenuHandlerCount = bkLdIrMenuHandlerCount
    irEveryHead = bkLdIrEveryHead
    irEveryTail = bkLdIrEveryTail
    irEveryCount = bkLdIrEveryCount
    irVoidT = bkLdIrVoidT
    irIntT = bkLdIrIntT
    irBoolT = bkLdIrBoolT
    irFixedT = bkLdIrFixedT
    irCharT = bkLdIrCharT
    irTextT = bkLdIrTextT
    irErrT = bkLdIrErrT
    irPtrT = bkLdIrPtrT
    irWordT = bkLdIrWordT

    lowSwitchN = bkLdLowSwitchN
    uiMenuCount = bkLdUiMenuCount
    lowStoreTempN = bkLdLowStoreTempN
    lowRetTempN = bkLdLowRetTempN
    // NOT a straight copy: a non-testapi install TRUNCATED irStrLits back
    // to the base boundary above, but bkLdLowStrIdx is the GENERATOR's
    // WHOLE by-value dedup map -- so every entry it carries for a
    // uitest.cla literal now points PAST the installed pool. A user
    // program whose source happens to contain that same string then dedups
    // to a dead index and the emitted C references a clar_lit_K nothing
    // defines. (Found by the AppleTalk phase's Task 5:
    // testdata/emitui/every_cli.cla logs "tick ", which uitest.cla also
    // uses, and its --rtbake fork emitted `clar_lit_129` into a pool of
    // 126 -- a full corpus of fixtures had simply never collided before.)
    // Filtered here for exactly the reason irFuncIdxByName is REBUILT
    // rather than copied a few lines above: same truncation, same stale-
    // index hazard, and the two maps are the only by-name/by-value
    // indexes into a truncatable arena. Cheap: one pass over a map with a
    // few hundred entries, once per compile.
    // ui-widgets: dropUilog (a 68k program with no logpanel, whose from-
    // source twin never splices uilog.cla) hides uilog.cla's own literals
    // the same way -- out of the dedup map here, so a user literal equal to
    // one gets a fresh index at the end exactly as from source, and out of
    // cg68Measure's whole pool, both via the hidden range
    // [bkLdUilogIrStrLitsStart, bkLdBaseIrStrLitsCount), emptied here when
    // not dropUilog. Excluded, not truncated: a testapi install keeps
    // uitest.cla's literals after them.
    if not dropUilog {
        bkLdUilogIrStrLitsStart = bkLdBaseIrStrLitsCount
    }
    for strKey, strVal in bkLdLowStrIdx {
        if strVal < irStrLits.count and (strVal < bkLdUilogIrStrLitsStart or strVal >= bkLdBaseIrStrLitsCount) {
            freshStrIdx[strKey] = strVal
        }
    }
    lowStrIdx = freshStrIdx
}

// bkInstallObjCode is GONE (clir-load-perf Task 7, design B). It used to
// truncate the four per-function object-staging arrays (bkLdObjValid/
// RunFirst/HoleFirst/NHoles) down to bkRuntimeFuncBoundary IN PLACE,
// which is exactly the destructive-consume-of-pending-state design B
// could not have (Task 6 audit findings F1/F2): under its memoized
// parse there was no re-parse to rebuild what the truncation ate. The
// truncation is now a BOUNDS CHECK instead -- cgObjPasteEligible
// (cg68k.cla) rejects any index at or past bkRuntimeFuncBoundary, which
// bkInstallArenas recomputes on every compile from that compile's OWN
// testapi split. SE wave 1 removed the memo (every compile re-parses,
// so the arrays are rebuilt fresh each time); the bounds check stays
// because it is cheaper: four copy loops per compile became one
// comparison.

// ================================================================
// --testapi checker-symbol preload (Task 5, deliverables (a)/(c))
// ================================================================

// bkInstallCheckerSymbolsForTestapi (Task 5 deliverable (a); widened in
// fix round 2 from a 16-hardcoded-name lookup to full checker-symbol
// visibility): installs the WHOLE baked funcSigs/symbols/scopes arrays
// verbatim (funcSigs/symbols are append-only arenas -- newFuncSig/
// scopeDeclare, called next by the user's own checkPhase1, just keep
// appending past whatever's already there; scopeNew does the same for
// scopes -- so a wholesale install needs no index surgery: every INDEX
// the baked arrays' own Symbol.sigIdx / Scope.names values reference
// stays valid, since nothing is removed or renumbered, only referenced
// or not), then REPLACES the live topScope's own `names` map with a
// FILTERED copy: only bindings whose symbol index is below
// bkLdEarlySymbolsCount (bkSecCheckerVisibility's own boundary -- the
// thirteen testapi-visible modules: core.cla..uidialogs.cla + uitest.
// cla) survive; the four manifest-only modules' own bindings
// (sortedmap.cla/datetime.cla(+lane)/ser.cla/native.cla -- symbol
// indices >= the boundary) are simply never entered into scope, so
// scopeLookup can never find them -- behavior-identical to from-source
// --testapi's own check#1, which literally never declares those four
// modules at all (driveManifestSplice only splices them for check#2,
// retired on the bake path).
//
// Design choice (fix round 2, replacing round 1's narrower 16-name
// lookup): considered a boundary-TRUNCATION shape mirroring the IR base/
// uitest split (bkInstallArenas) instead -- install only a [0,
// earlyFuncSigsCount)+[uitestStart,uitestEnd) SUBSET of funcSigs/symbols.
// Rejected: Symbol.sigIdx (into funcSigs) and Scope.names values (into
// symbols) would then need REMAPPING wherever a truncated-and-recombined
// range shifted an index, the same class of cross-reference surgery the
// string-literal-pool problem (task-5-report.md's "inherited problem")
// already proved risky under time pressure. The visibility-filter shape
// here needs no remapping at all: nothing is removed, only what's
// LOOKED UP is restricted, so every existing index stays exactly where
// it was baked.
//
// Caller's contract (checkReset already ran, topScope is otherwise still
// empty): call this BEFORE the user program's own checkPhase1 (unlike
// round 1's after-the-fact declare loop) -- scopeDeclare's own "first
// declared, in this scope, wins" rule then means a user top-level decl
// that collides with an installed name is diagnosed by the USER's OWN
// checkFuncSig/scopeDeclare call, during their own checkPhase1,
// attributed to the USER's file via the ordinary setCheckPath(d)
// mechanism -- VERIFIED to be exactly what from-source --testapi's own
// check#1 does for the identical collision (driveEarlySplice declares
// the early-spliced modules FIRST, user code SECOND, so the SAME
// "second declaration loses" rule attributes the diagnostic to the user
// there too, never to the runtime file -- round 1's own
// TestRtbakeTestapiForcedAttribution assumed the opposite attribution
// and was WRONG about from-source's real behavior; fixed to a from-
// source/bake PARITY assertion instead, see task-5-report.md's own fix
// round 2 section).
func bkInstallCheckerSymbolsForTestapi() {
    var filteredTopNames: intmap of int
    var k: int
    var v: int
    var srcNames: intmap of int
    var e0: list of FuncSig
    var e1: list of Symbol
    var e2: list of Scope

    // Install by move (SE wave 1): the three staging resets below are
    // reassignments after a move -- keep them that way.
    funcSigs = bkLoadedFuncSigs
    symbols = bkLoadedSymbols
    scopes = bkLoadedScopes
    bkLoadedFuncSigs = e0
    bkLoadedSymbols = e1
    bkLoadedScopes = e2
    if scopes.count <= topScope {
        return
    }
    srcNames = scopes[topScope].names
    for k, v in srcNames {
        if v < bkLdEarlySymbolsCount {
            filteredTopNames[k] = v
        }
    }
    scopes[topScope].names = filteredTopNames
}

// bkFreeParseStaging (SE wave 1, spec 4.3): drop every pending parse
// container the install sequence did not move out -- the parse-only
// tables no install consumes (bkLdIrFuncIdxByName, bkLdLowStrIdx), the
// testapi-only checker state a non-testapi (or non-UI) compile never
// installs, and, on driveRtbakeFallback's path (taken before
// bkInstallArenas), the whole IR staging. After an ordinary install most
// of these are already empty, so the reset is a no-op for them. The
// scalar bkLd* staging (counts, flags) holds no heap and is left alone.
// Deliberately does NOT touch bkLdObj* or cgObjRunBytes/cgObjRunOff/cgObjHoles: codegen
// reads those until the fork is built. Every line here is a true free,
// hence .release(): nothing else holds these boxes (a bkInstall* move
// re-points its staging name at a fresh box, so the live global never
// shares one of them) -- unlike the staging resets inside the moves,
// which must stay reassignments.
func bkFreeParseStaging() {
    bkLdIrTypes.release()
    bkLdIrStmts.release()
    bkLdIrExprs.release()
    bkLdIrLocals.release()
    bkLdIrFuncs.release()
    bkLdIrGlobals.release()
    bkLdIrFieldSlots.release()
    bkLdIrRecords.release()
    bkLdIrEnumMembers.release()
    bkLdIrEnums.release()
    bkLdIrWidgetDescs.release()
    bkLdIrColumnDescs.release()
    bkLdIrBindDescs.release()
    bkLdIrWindowDescs.release()
    bkLdIrMenuItemDescs.release()
    bkLdIrMenuDescs.release()
    bkLdIrWinHandlers.release()
    bkLdIrWidgetHandlerEntries.release()
    bkLdIrMenuHandlerEntries.release()
    bkLdIrEveryEntries.release()
    bkLdIrCbGlueNames.release()
    bkLdIrStrLits.release()
    bkLdIrArrLitElemT.release()
    bkLdIrArrLitN.release()
    bkLdIrArrLitVals.release()
    bkLdIrExternNames.release()
    bkLdIrExternRetTys.release()
    bkLdIrExternParamStart.release()
    bkLdIrExternParamCountArr.release()
    bkLdIrExternParamTys.release()
    bkLdIrExternTrapWords.release()
    bkLdIrExternConvs.release()
    bkLdIrExternSels.release()
    bkLdIrExternParamRegs.release()
    bkLdIrExternRetRegs.release()
    bkLdIrFuncIdxByName.release()
    bkLdIrLayoutNeededByName.release()
    bkLdIrRcWalkNeededByName.release()
    bkLdLowStrIdx.release()
    bkLdStrBlob.release()
    bkLdStrOff.release()
    bkLoadedFuncSigs.release()
    bkLoadedSymbols.release()
    bkLoadedScopes.release()
    bkLoadedTypeArena.release()
    bkLoadedEnumMembers.release()
    bkLoadedFieldInfos.release()
    bkLoadedRecFieldsHeadByName.release()
    bkLoadedModules.release()
}

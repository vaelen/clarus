// SPDX-License-Identifier: MIT

// shake.cla: whole-program reachability over the arena IR (ir.cla) -- Plan
// native-5d Task 1. shakeProgram() runs once, after lowerProgram and before
// any backend consults irFuncs (main.cla), and fills shakeMarks (parallel to
// the irFuncs arena) with which functions are actually reachable from the
// program's real entry points. Both backends consult it before emitting a
// function: cprint.cla's cpEmitFuncs (Task 1's own consumer, this task) and
// cg68k.cla (later tasks) skip the proto+body of anything shakeReachable(i)
// says is dead.
//
// Roots (worklist seeds): the App entry-point handler(s) selected by
// irHasLaunch/irHasStartEmpty/irHasStartCLI/irHasOpenDocument; every window
// event handler (irWinHandlers) and widget handler (irWidgetHandlerEntries);
// every menu handler (irMenuHandlersHead chain) and every-timer handler
// (irEveryHead chain); every ECallFn found while walking irGlobals' own init
// expressions; and shakeAddRoot's extra names (registered by a caller BEFORE
// shakeProgram runs -- unused on the C path today, but emit68k (Tasks 7/11)
// roots functions cprint never calls directly, e.g. the `nat*` console shim
// and rtEnumCheck).
//
// Walking a marked function's body finds more work two ways: an ECallFn
// node marks+enqueues its own callee by name (ordinary user/runtime calls,
// including a runtime module's OWN internal calls -- str.cla/text.cla/
// list.cla/map.cla/ser.cla are themselves ordinary Clarus source, so once
// one of their entry points is marked, the worklist walks ITS body and
// discovers whatever helpers IT calls automatically, no extra bookkeeping
// needed); an EIntr node consults shakeWalkIntr's table below, mirroring
// cprint.cla's fpIntrCall: every intrinsic that fpIntrCall (or fpStoreStr,
// for the plain-string-assignment SStoreStr statement kind, which calls
// clar_fn_rtStrStore with no EIntr node at all) redirects to a Clarus-ported
// clar_fn_rtXxx function roots that function's name. Over-approximation is
// always safe here (a few extra functions emitted); under-approximation is
// a C link error, caught immediately by the differential gauntlet.
//
// The str.cla/text.cla/list.cla/map.cla "core" (construction, retain,
// release, and their own walk-internal accessors) is rooted unconditionally
// below, rather than traced precisely -- these four runtime modules are
// UNCONDITIONAL entries in main.cla's runtime manifest (cpStrPorted/
// cpTextPorted/cpTextArcPorted/cpListPorted/cpListArcPorted/cpMapPorted/
// cpMapArcPorted are all hardcoded `true` in the emit path, never
// conditional), and cprint.cla's cpDefaultInit/cpEmitGlobalsInit/
// cpEmitRetain/cpEmitRelease call straight into this exact closed set of 17
// names directly from generated C -- driven by a global's or record field's
// TYPE, not by any ECallFn/EIntr call site the walk below could ever find.
// cpEmitDefaultInitFnProtos (cprint.cla) already hardcodes this identical
// 17-name set for its own forward-declare gate; keep the two in sync if
// that set ever changes. Given these four modules are always in the
// program regardless, rooting their small always-needed core costs nothing
// real (they'd be reachable in any nontrivial program anyway) and removes
// an entire class of "found a call cprint makes that isn't an IR node"
// bugs; the data-operation entry points below (rtStrConcat, rtListPush,
// rtMapSet, ...) stay individually gated on their own intrinsic, so a
// program that never touches Map still drops rtMapSet/rtMapGet/.../rtStrCmp
// and the rest of map.cla's own transitive closure.
//
// sortedmap.cla's own ARC/default-init core (map-hashtable phase, Task 2)
// adds 6 more names (rtSortedMapNew/ValAt/Count/Retain/Release/Lastref) to
// this same unconditional block (23 names at the time -- see the Task 7
// paragraph just below for the current 29-name running total) -- UNLIKE
// the original 17, sortedmap.cla is CONDITIONALLY spliced (only when
// usesSortedMap), so these six are no-ops (shakeMarkAndEnqueue's own
// idx==-1 guard) whenever the module isn't in this compile's manifest, but
// stay in the SAME unconditional list rather than a separate usesSortedMap-
// gated one -- cheaper than threading that flag through shake.cla (which
// has no visibility into check.cla today), and harmless either way.
// cpEmitDefaultInitFnProtos's own analogous gate (cprint.cla) mirrors this
// running total; keep both in sync if either set changes.
//
// intmap.cla's own ARC/default-init core (map-hashtable phase, Task 7)
// adds 6 MORE names (rtIntMapNew/ValAt/Count/Retain/Release/Lastref),
// bringing the total to 29 -- UNLIKE sortedmap.cla's six (conditionally
// spliced), these genuinely belong in the unconditional set alongside the
// original 17: intmap.cla lives in the always-spliced map.cla itself, so
// these six always exist in the emit, same as rtMapNew/etc. above.
// cpEmitDefaultInitFnProtos's own analogous gate (cprint.cla) mirrors this
// 29-name total; keep both in sync if either set changes.

include "lib.cla"
include "ir.cla"

// shakeMarks is parallel to the irFuncs arena, rebuilt fresh by every
// shakeProgram call (irFuncs itself is rebuilt fresh per compile by
// irReset/lowerProgram -- a stale shakeMarks from a PRIOR compile would
// misalign against this compile's different index->function mapping, so
// this list, unlike irRcWalkNeededByName/irLayoutNeededByName below, cannot
// just accumulate across compiles).
var shakeMarks: list of bool

// shakeFuncIdxByName maps irFuncName(i) -> i, keyed by interned nameIdx
// directly (map-hashtable phase, Stage B: was poolGet'd through a string
// map) -- O(1) per lookup instead of findIRFuncIdxByName's linear scan,
// since the walk below calls this at every ECallFn/EIntr/handler-name site
// across the whole program. memory-leak-fix Task 7: explicitly `.clear()`'d
// at the top of shakeProgram, below, before the repopulation loop --
// lib.cla's intern pool (strPool/strIndex) is no longer never-reset
// (libReset(), called from driveReset() every compile) -- pool indices
// RECYCLE across compiles now, so a stale entry surviving here past a
// libReset() could silently alias a DIFFERENT string's nameIdx in a later
// compile (the a259d0f staleness class this comment used to warn about as
// a future hazard; libReset() landing is exactly the "future change" it
// meant).
var shakeFuncIdxByName: intmap of int

// shakeWorklist holds irFuncs indices already marked but not yet walked for
// their own callees -- a growing list of int, walked by a plain index loop
// in shakeProgram (appends during the loop are picked up as the bound
// grows, the standard array-backed BFS worklist shape).
var shakeWorklist: list of int

// shakePendingRootNames -- extra roots registered via shakeAddRoot BEFORE
// shakeProgram runs; consumed and cleared at the top of the next
// shakeProgram call. Unused by the C path (this task); emit68k (Tasks 7/11)
// calls shakeAddRoot for functions the C backend never calls directly.
var shakePendingRootNames: list of int

// shakeCurFunc (native-gaps-cleanup Task 4) is the irFuncs index of the
// function whose body the shakeProgram worklist loop is CURRENTLY walking,
// or -1 when no function body is being walked (root registration, the
// globals'-init-expression walk) -- shakeMarkAndEnqueue reads it to
// attribute a caller->callee edge only to a real function body, never to a
// root.
var shakeCurFunc: int

// shakeEdgesFrom/shakeEdgesTo (native-gaps-cleanup Task 4) record one
// caller->callee pair (parallel lists) per shakeMarkAndEnqueue call made
// while shakeCurFunc is set -- the post-shake call graph cg68k.cla's
// cgStackHeuristic walks to find the deepest chain of frame sizes. An edge
// is recorded on EVERY call site, even to an already-marked callee (a
// second call site, or a cycle's back edge) -- shakeMarks alone only
// answers "reachable at all", not "from where", and the heuristic needs
// the graph shape, not just the node set.
var shakeEdgesFrom: list of int
var shakeEdgesTo: list of int

// shakeAddRoot registers an extra root by interned name, consulted the next
// time shakeProgram runs.
func shakeAddRoot(nameIdx: int) {
    shakePendingRootNames.add(nameIdx)
}

// shakeReachable reports whether irFuncs index f was proven reachable by
// the most recent shakeProgram call.
func shakeReachable(f: int): bool {
    return shakeMarks[f]
}

// shakeEdgeCount/shakeEdgeFrom/shakeEdgeTo (native-gaps-cleanup Task 4)
// expose shakeEdgesFrom/shakeEdgesTo to cg68k.cla's cgStackHeuristic.
func shakeEdgeCount(): int {
    return shakeEdgesFrom.count
}

func shakeEdgeFrom(i: int): int {
    return shakeEdgesFrom[i]
}

func shakeEdgeTo(i: int): int {
    return shakeEdgesTo[i]
}

// shakeMarkAndEnqueue marks the function named nameIdx reachable (if it
// names a real irFuncs entry -- a call to an `external func`/builtin has no
// matching entry, silently ignored here) and enqueues it for its own body
// to be walked, unless already marked. Also records a shakeCurFunc->idx
// edge (Task 4) whenever this call happens while a real function body is
// being walked (shakeCurFunc != -1) -- see shakeEdgesFrom/shakeEdgesTo.
func shakeMarkAndEnqueue(nameIdx: int) {
    var idx: int

    idx = shakeFuncIdxByName.get(nameIdx, -1)
    if idx == -1 {
        return
    }
    if shakeCurFunc != -1 {
        shakeEdgesFrom.add(shakeCurFunc)
        shakeEdgesTo.add(idx)
    }
    if shakeMarks[idx] {
        return
    }
    shakeMarks[idx] = true
    shakeWorklist.add(idx)
}

// shakeMarkAndEnqueueIfSet is shakeMarkAndEnqueue guarded for the many
// optional handler-slot fields below whose "unset" sentinel is -1.
func shakeMarkAndEnqueueIfSet(nameIdx: int) {
    if nameIdx != -1 {
        shakeMarkAndEnqueue(nameIdx)
    }
}

// shakeProgram computes reachability over the whole program's irFuncs arena
// (see the file header for the full root/walk description) and leaves the
// result in shakeMarks for shakeReachable to answer.
func shakeProgram() {
    var i: int
    var wi: int
    var fIdx: int

    shakeMarks = shakeFreshBoolList()
    shakeWorklist = shakeFreshIntList()
    shakeEdgesFrom = shakeFreshIntList()
    shakeEdgesTo = shakeFreshIntList()
    shakeCurFunc = -1
    shakeFuncIdxByName.clear()

    i = 0
    while i < irFuncs.count {
        shakeMarks.add(false)
        shakeFuncIdxByName[irFuncName(i)] = i
        i = i + 1
    }

    // ---- App entry point(s) ----
    if irHasLaunch {
        shakeMarkAndEnqueue(intern("handler_App_launch"))
    }
    if irHasStartEmpty {
        shakeMarkAndEnqueue(intern("handler_App_startEmpty"))
    }
    if irHasStartCLI {
        shakeMarkAndEnqueue(intern("handler_App_startCLI"))
    }
    if irHasOpenDocument {
        shakeMarkAndEnqueue(intern("handler_App_openDocument"))
    }

    // ---- connection pump loop (serial-connection phase, Task 5) ----
    // cpEmitMain's non-UI main() calls clar_fn_rtConnPump/rtConnAlive
    // directly as raw text, exactly like the App entry points just
    // above -- neither is reachable through any ECallFn/EIntr node the
    // walk below would ever find, so both are rooted explicitly here.
    // The four clar_conn_fire_* dispatchers rtConnPump calls (as
    // EXTERNS -- see shakeWalkExpr's own ECallExt case, which never
    // discovers a synthesized target the way ECallFn does) self-root
    // instead, via lowSynthConnDispatchers' own shakeAddRoot calls
    // (lower.cla), consumed by the "extra roots" pass below.
    if irUsesConn {
        shakeMarkAndEnqueue(intern("rtConnPump"))
        shakeMarkAndEnqueue(intern("rtConnAlive"))
    }

    // ---- window + widget handlers ----
    i = 0
    while i < irWinHandlers.count {
        shakeMarkAndEnqueueIfSet(irWinHandlersOpenedFn(i))
        shakeMarkAndEnqueueIfSet(irWinHandlersCloseRequestFn(i))
        shakeMarkAndEnqueueIfSet(irWinHandlersClosedFn(i))
        shakeMarkAndEnqueueIfSet(irWinHandlersResizedFn(i))
        shakeMarkAndEnqueueIfSet(irWinHandlersKeyFn(i))
        shakeMarkAndEnqueueIfSet(irWinHandlersAcceptedFn(i))
        shakeMarkAndEnqueueIfSet(irWinHandlersCancelledFn(i))
        wi = irWinHandlersWidgetHead(i)
        while wi != -1 {
            shakeMarkAndEnqueueIfSet(irWidgetHandlerEntryClickFn(wi))
            shakeMarkAndEnqueueIfSet(irWidgetHandlerEntryChangeFn(wi))
            shakeMarkAndEnqueueIfSet(irWidgetHandlerEntryDragFn(wi))
            shakeMarkAndEnqueueIfSet(irWidgetHandlerEntryEnterFn(wi))
            shakeMarkAndEnqueueIfSet(irWidgetHandlerEntrySelectFn(wi))
            shakeMarkAndEnqueueIfSet(irWidgetHandlerEntryDoubleClickFn(wi))
            wi = irWidgetHandlerEntryNext(wi)
        }
        i = i + 1
    }

    // ---- menu handlers ----
    i = irMenuHandlersHead
    while i != -1 {
        shakeMarkAndEnqueueIfSet(irMenuHandlerEntryFuncName(i))
        i = irMenuHandlerEntryNext(i)
    }

    // ---- every-timers ----
    i = irEveryHead
    while i != -1 {
        shakeMarkAndEnqueueIfSet(irEveryEntryFuncName(i))
        i = irEveryEntryNext(i)
    }

    // ---- globals' own init expressions (may embed ECallFn/EIntr) ----
    i = 0
    while i < irGlobals.count {
        shakeWalkExpr(irGlobalInit(i))
        i = i + 1
    }

    // ---- extra roots registered before this call (shakeAddRoot) ----
    i = 0
    while i < shakePendingRootNames.count {
        shakeMarkAndEnqueue(shakePendingRootNames[i])
        i = i + 1
    }
    shakePendingRootNames = shakeFreshIntList()

    // ---- str/text/list/map always-needed core (see file header) ----
    shakeMarkAndEnqueue(intern("rtStrStore"))
    shakeMarkAndEnqueue(intern("rtTextNew"))
    shakeMarkAndEnqueue(intern("rtTextStore"))
    shakeMarkAndEnqueue(intern("rtTextRetain"))
    shakeMarkAndEnqueue(intern("rtTextRelease"))
    shakeMarkAndEnqueue(intern("rtListNew"))
    shakeMarkAndEnqueue(intern("rtListAt"))
    shakeMarkAndEnqueue(intern("rtListCount"))
    shakeMarkAndEnqueue(intern("rtListRetain"))
    shakeMarkAndEnqueue(intern("rtListRelease"))
    shakeMarkAndEnqueue(intern("rtListLastref"))
    shakeMarkAndEnqueue(intern("rtMapNew"))
    shakeMarkAndEnqueue(intern("rtMapValAt"))
    shakeMarkAndEnqueue(intern("rtMapCount"))
    shakeMarkAndEnqueue(intern("rtMapRetain"))
    shakeMarkAndEnqueue(intern("rtMapRelease"))
    shakeMarkAndEnqueue(intern("rtMapLastref"))

    // ---- sortedmap ARC/default-init core (map-hashtable phase, Task 2) --
    // UNLIKE the 17 names just above, sortedmap.cla is CONDITIONALLY
    // spliced (only when usesSortedMap), so these six no-op harmlessly
    // (shakeMarkAndEnqueue's own idx==-1 guard, verified: shakeFuncIdxByName
    // is a plain map.get(name, -1) lookup) whenever the module isn't in
    // this compile's manifest at all -- kept unconditional anyway, same
    // "self-documenting, costs nothing when absent" convention as the
    // rtMap*/rtList*/rtText* core rather than threading a usesSortedMap
    // check through shake.cla, which has no visibility into check.cla's
    // flag today.
    shakeMarkAndEnqueue(intern("rtSortedMapNew"))
    shakeMarkAndEnqueue(intern("rtSortedMapValAt"))
    shakeMarkAndEnqueue(intern("rtSortedMapCount"))
    shakeMarkAndEnqueue(intern("rtSortedMapRetain"))
    shakeMarkAndEnqueue(intern("rtSortedMapRelease"))
    shakeMarkAndEnqueue(intern("rtSortedMapLastref"))

    // ---- intmap ARC/default-init core (map-hashtable phase, Task 7) --
    // UNLIKE sortedmap's own six just above, intmap.cla lives in the
    // always-spliced map.cla, so these six genuinely belong in the SAME
    // unconditional set as the original 17 rtMap*/rtList*/rtText* names --
    // not a "no-op when absent" convenience, they always exist.
    shakeMarkAndEnqueue(intern("rtIntMapNew"))
    shakeMarkAndEnqueue(intern("rtIntMapValAt"))
    shakeMarkAndEnqueue(intern("rtIntMapCount"))
    shakeMarkAndEnqueue(intern("rtIntMapRetain"))
    shakeMarkAndEnqueue(intern("rtIntMapRelease"))
    shakeMarkAndEnqueue(intern("rtIntMapLastref"))

    // ---- worklist: walk every marked function's body, discovering more ----
    wi = 0
    while wi < shakeWorklist.count {
        fIdx = shakeWorklist[wi]
        shakeCurFunc = fIdx
        shakeWalkStmts(irFuncBodyHead(fIdx))
        wi = wi + 1
    }
    shakeCurFunc = -1
}

// shakeFreshBoolList/shakeFreshIntList hand back a genuinely empty list --
// shakeMarks/shakeWorklist are reassigned (not pop-cleared like irReset's
// arenas) at the top of every shakeProgram call because their PREVIOUS
// contents are meaningless once irFuncs itself has been torn down and
// rebuilt by the compile in between (a stale shakeMarks entry would answer
// shakeReachable for the WRONG function this time).
func shakeFreshBoolList(): list of bool {
    var l: list of bool
    return l
}

func shakeFreshIntList(): list of int {
    var l: list of int
    return l
}

// shakeWalkStmts walks a stmt-list chain (its own .next links), recursing
// into every nested block.
func shakeWalkStmts(head: int) {
    var s: int

    s = head
    while s != -1 {
        shakeWalkStmt(s)
        s = irStmtNext(s)
    }
}

func shakeWalkStmt(s: int) {
    var k: IRStmtKind

    k = irStmtKind(s)
    if k == SAssign {
        shakeWalkExpr(irAssignDst(s))
        shakeWalkExpr(irAssignSrc(s))
    } else if k == SStoreStr {
        // fpStoreStr (cprint.cla) always calls clar_fn_rtStrStore directly
        // for this statement kind -- no EIntr node exists to discover it
        // through, so root it here explicitly (also covered by the
        // always-rooted core above; kept for self-documentation).
        shakeMarkAndEnqueue(intern("rtStrStore"))
        shakeWalkExpr(irStoreStrDst(s))
        shakeWalkExpr(irStoreStrSrc(s))
    } else if k == SExprStmt {
        shakeWalkExpr(irExprStmtX(s))
    } else if k == SIf {
        shakeWalkExpr(irIfCond(s))
        shakeWalkStmts(irIfThen(s))
        shakeWalkStmts(irIfElse(s))
    } else if k == SWhile {
        shakeWalkExpr(irWhileCond(s))
        shakeWalkStmts(irWhileBody(s))
    } else if k == SForRange {
        shakeWalkExpr(irForRangeFrom(s))
        shakeWalkExpr(irForRangeTo(s))
        shakeWalkStmts(irForRangeBody(s))
    } else if k == SForList {
        // fpForListStmt (cprint.cla) always calls clar_fn_rtListCount to
        // snapshot the loop bound -- no EIntr node exists to discover it
        // through (also covered by the always-rooted core in shakeProgram;
        // kept for self-documentation).
        shakeMarkAndEnqueue(intern("rtListCount"))
        shakeWalkExpr(irForListListV(s))
        shakeWalkStmts(irForListBody(s))
    } else if k == SForMap {
        // fpForMapStmt (cprint.cla) always calls clar_fn_rtMapCount (loop
        // bound) and clar_fn_rtMapKeyAt (key fetch), plus clar_fn_rtMapValAt
        // when a value variable was declared -- none of these are EIntr
        // nodes. rtMapCount/rtMapValAt are already in the always-rooted
        // core (shakeProgram); rtMapKeyAt is not (it's never needed by
        // cpDefaultInit/cpEmitGlobalsInit/cpEmitRetain/cpEmitRelease, only
        // by this loop), so it's rooted here explicitly.
        //
        // map-hashtable phase Task 2: SForMap is REUSED for a SortedMap
        // receiver too (no new IR stmt kind) -- key off the iterated expr's
        // own IR kind to root the RIGHT family's KeyAt (rtMapKeyAt has no
        // rtSortedMap twin need here since rtSortedMapValAt is already
        // unconditionally rooted above, but rtSortedMapKeyAt is not, same
        // asymmetry as rtMapKeyAt). map-hashtable phase Task 7: SForMap
        // reused a THIRD time for IntMap -- rtIntMapKeyAt joins the same
        // per-kind branch (rtIntMapValAt IS already unconditionally rooted
        // above, alongside its five ARC/default-init siblings, but
        // rtIntMapKeyAt is not, same asymmetry).
        if irtKind(irExprType(irForMapMapV(s))) == KSortedMap {
            shakeMarkAndEnqueue(intern("rtSortedMapKeyAt"))
        } else if irtKind(irExprType(irForMapMapV(s))) == KIntMap {
            shakeMarkAndEnqueue(intern("rtIntMapKeyAt"))
        } else {
            shakeMarkAndEnqueue(intern("rtMapKeyAt"))
        }
        shakeMarkAndEnqueue(intern("rtMapValAt"))
        shakeWalkExpr(irForMapMapV(s))
        shakeWalkStmts(irForMapBody(s))
    } else if k == SReturn {
        shakeWalkExpr(irReturnX(s))
    } else if k == SAttempt {
        // attempt-abort phase Task 3 (found while wiring cprint.cla: a
        // call made ONLY from inside an attempt's body or handler was
        // being pruned as unreachable, producing generated C that called
        // an undeclared/unprinted function -- a hard compile error, not
        // just a missed-shake correctness gap). Task 2 added SAttempt to
        // ir.cla/lower.cla but never touched this file; walking both
        // sub-chains here closes that gap for whichever backend runs
        // shakeProgram (this pass is shared, not cprint-specific). No
        // runtime call needs explicit rooting the way SStoreStr/SForList/
        // SForMap's own arms above do: fpAttemptStmt's own generated C
        // (cprint.cla) never calls a clar_fn_ helper directly outside of
        // ordinary statements this same walk already covers, and IAbort's
        // one direct runtime call (rtStrStore) is already in the
        // always-rooted core above.
        shakeWalkStmts(irAttemptBody(s))
        shakeWalkStmts(irAttemptHandler(s))
    }
    // SBreak/SContinue: no fields to walk.
}

// shakeWalkExprList walks an expr-list chain (an ECallFn/EIntr argument
// list, threaded through each argument's own .next).
func shakeWalkExprList(head: int) {
    var e: int

    e = head
    while e != -1 {
        shakeWalkExpr(e)
        e = irExprNext(e)
    }
}

// shakeWalkExpr recurses into every sub-expression slot an IRExpr kind can
// carry, marking an ECallFn's own callee and consulting shakeWalkIntr for
// an EIntr's runtime redirect target(s). EIntConst/EStrConst/EVarRef/
// ENewRec carry no child expressions.
func shakeWalkExpr(x: int) {
    var k: IRExprKind

    if x == -1 {
        return
    }
    k = irExprKind(x)
    if k == EFieldRef {
        shakeWalkExpr(irFieldRefX(x))
    } else if k == EIndexRef {
        // Plan native-5d Task 3: fpIndexRef's Arr arm (cprint.cla) now
        // calls clar_fn_rtArrCheck under cpCorePorted (unconditionally
        // true) -- no EIntr node exists for a plain a[i] access, so root
        // it here explicitly, mirroring fpIndexRef's own KArr-only
        // condition (the KList arm's rt_list_at stays bare C, already
        // covered by the always-rooted core's rtListAt).
        if irtKind(irExprType(irIndexRefX(x))) == KArr {
            shakeMarkAndEnqueue(intern("rtArrCheck"))
        }
        shakeWalkExpr(irIndexRefX(x))
        shakeWalkExpr(irIndexRefI(x))
    } else if k == EBin {
        shakeWalkExpr(irBinX(x))
        shakeWalkExpr(irBinY(x))
    } else if k == EUn {
        shakeWalkExpr(irUnX(x))
    } else if k == EConv {
        shakeWalkExpr(irConvX(x))
    } else if k == ECallFn {
        shakeMarkAndEnqueue(irCallFnName(x))
        shakeWalkExprList(irCallFnArgsHead(x))
    } else if k == ECallExt {
        // `external func` -- resolves straight to rt_ext_NAME, never an
        // irFuncs entry; only its arguments can hide further calls.
        shakeWalkExprList(irCallExtArgsHead(x))
    } else if k == EIntr {
        shakeWalkIntr(x)
        shakeWalkExprList(irIntrArgsHead(x))
    } else if k == ECbAddr {
        // Task 7 (toolbox-integration Feature C): taking a callback's
        // address is not itself a CALL (unlike ECallFn), so without this
        // arm the callback's own body would never be discovered through
        // the ordinary call-graph walk -- the edge that replaces
        // yesterday's hand-rooting (shakeAddRoot) for the LDEF/scrollbar
        // glue this feature is meant to subsume. A callback whose address
        // is never taken and which is never called directly (no ECallFn
        // to it either) simply never reaches this arm, so it -- and its
        // never-emitted glue (cprint.cla's cpEmitCallbackGlue, gated on
        // irCbGlueNames, populated independently by newIRCbAddr) -- shakes
        // away entirely.
        shakeMarkAndEnqueue(irCbAddrName(x))
    }
}

// shakeWalkIntr roots the Clarus-ported runtime function(s) cprint.cla's
// fpIntrCall would call to emit this intrinsic -- one arm per intrinsic
// that redirects to a clar_fn_rtXxx call (mirrors fpIntrCall's own
// cpStrPorted/cpTextPorted/cpListPorted/cpMapPorted/cpSerPorted/
// cpCorePorted branches, all of which are unconditionally true in the emit
// path -- see the file header). Every intrinsic NOT listed here (peek/
// poke/quit/alert/log/IFileName/every other Ui* op) prints as a raw
// rt_*/rt_ui_* C call with no matching irFuncs entry -- nothing to root.
// IUiEdit is the one Ui* exception (native-5e Task 3): its kind==3 arm now
// calls a ported clar_fn_ function, so it gets its own arm below.
func shakeWalkIntr(x: int) {
    var nm: int

    nm = irIntrName(x)

    // ---- strings ----
    if nm == IStrConcat() {
        shakeMarkAndEnqueue(intern("rtStrConcat"))
    } else if nm == IStrConcatChar() {
        shakeMarkAndEnqueue(intern("rtStrConcatChar"))
    } else if nm == IStrPrependChar() {
        shakeMarkAndEnqueue(intern("rtStrPrependChar"))
    } else if nm == IStrCmp() {
        shakeMarkAndEnqueue(intern("rtStrCmp"))
    } else if nm == IStrLen() {
        shakeMarkAndEnqueue(intern("rtStrLen"))
    } else if nm == IStrIndex() {
        shakeMarkAndEnqueue(intern("rtStrIndex"))
    } else if nm == IStrSetIndex() {
        shakeMarkAndEnqueue(intern("rtStrSetIndex"))
    } else if nm == IStrFromBytes() {
        shakeMarkAndEnqueue(intern("rtStrFromBytes"))
    } else if nm == IStrToBytes() {
        shakeMarkAndEnqueue(intern("rtStrToBytes"))
    } else if nm == IStrCoerce() {
        shakeMarkAndEnqueue(intern("rtStrStore"))
    } else if nm == IStrSlice() {
        shakeMarkAndEnqueue(intern("rtStrSlice"))
    } else if nm == IStrIndexOfStr() {
        shakeMarkAndEnqueue(intern("rtStrIndexOfStr"))
    } else if nm == IStrIndexOfChar() {
        shakeMarkAndEnqueue(intern("rtStrIndexOfChar"))

    // ---- text ----
    } else if nm == ITextStore() {
        shakeMarkAndEnqueue(intern("rtTextStore"))
    } else if nm == ITextConcat() {
        shakeMarkAndEnqueue(intern("rtTextNew"))
        shakeMarkAndEnqueue(intern("rtTextConcat"))
    } else if nm == ITextConcatSL() {
        shakeMarkAndEnqueue(intern("rtTextNew"))
        shakeMarkAndEnqueue(intern("rtTextConcatSl"))
    } else if nm == ITextCmp() {
        // fpTextCmp (cprint.cla) picks rtTextCmp (Text/Text) or rtTextCmpStr
        // (Text/Str, either operand order) at print time -- root both.
        shakeMarkAndEnqueue(intern("rtTextCmp"))
        shakeMarkAndEnqueue(intern("rtTextCmpStr"))
    } else if nm == ITextLen() {
        shakeMarkAndEnqueue(intern("rtTextLen"))
    } else if nm == ITextIndex() {
        shakeMarkAndEnqueue(intern("rtTextIndex"))
    } else if nm == ITextSetIndex() {
        shakeMarkAndEnqueue(intern("rtTextSetIndex"))
    } else if nm == ITextFromBytes() {
        shakeMarkAndEnqueue(intern("rtTextFromBytes"))
    } else if nm == ITextToBytes() {
        shakeMarkAndEnqueue(intern("rtTextToBytes"))
    } else if nm == ITextSlice() {
        shakeMarkAndEnqueue(intern("rtTextSlice"))
    } else if nm == ITextIndexOfStr() {
        shakeMarkAndEnqueue(intern("rtTextIndexOfStr"))
    } else if nm == ITextIndexOfChar() {
        shakeMarkAndEnqueue(intern("rtTextIndexOfChar"))
    } else if nm == ITextAppendStr() {
        shakeMarkAndEnqueue(intern("rtTextAppendStr"))
    } else if nm == ITextAppendChar() {
        shakeMarkAndEnqueue(intern("rtTextAppendChar"))
    } else if nm == ITextAppendText() {
        shakeMarkAndEnqueue(intern("rtTextAppendText"))
    } else if nm == ITextOfStr() {
        shakeMarkAndEnqueue(intern("rtTextNew"))
        shakeMarkAndEnqueue(intern("rtTextStore"))
    } else if nm == ITextFreeVar() {
        shakeMarkAndEnqueue(intern("rtTextRelease"))
    } else if nm == ITextHashStep() {
        shakeMarkAndEnqueue(intern("rtTextHashStep"))
    } else if nm == ITextIntAt() {
        shakeMarkAndEnqueue(intern("rtTextIntAt"))
    } else if nm == ITextStringAt() {
        shakeMarkAndEnqueue(intern("rtTextStringAt"))
    } else if nm == ITextTextAt() {
        shakeMarkAndEnqueue(intern("rtTextNew"))
        shakeMarkAndEnqueue(intern("rtTextTextAt"))

    // ---- list ----
    } else if nm == IListPush() or nm == IListPushRetain() {
        shakeMarkAndEnqueue(intern("rtListPush"))
    } else if nm == IListUnshift() or nm == IListUnshiftRetain() {
        shakeMarkAndEnqueue(intern("rtListUnshift"))
    } else if nm == IListPop() {
        shakeMarkAndEnqueue(intern("rtListPop"))
    } else if nm == IListShift() {
        shakeMarkAndEnqueue(intern("rtListShift"))
    } else if nm == IListFirst() {
        shakeMarkAndEnqueue(intern("rtListFirst"))
    } else if nm == IListLast() {
        shakeMarkAndEnqueue(intern("rtListLast"))
    } else if nm == IListRemove() {
        shakeMarkAndEnqueue(intern("rtListRemove"))
    } else if nm == IListCount() {
        shakeMarkAndEnqueue(intern("rtListCount"))
    } else if nm == IListClear() {
        shakeMarkAndEnqueue(intern("rtListClear"))
    } else if nm == IListClearDeep() {
        // memory-leak-fix phase Task 4: same underlying hard reset as
        // IListClear, plus an element-release walk -- the walk's own
        // rtListAt/rtListCount/rtTextRelease/rtListRelease(nested) calls
        // are already in the always-rooted core above; a record element's
        // own clar_release_X is rooted separately, at cprint time, via
        // cpEmitElemReleaseWalk's irMarkRcWalkNeeded call (same mechanism
        // cpEmitRelease's own record-element branch already uses).
        shakeMarkAndEnqueue(intern("rtListClear"))
    } else if nm == IListFreeVar() {
        shakeMarkAndEnqueue(intern("rtListRelease"))
    } else if nm == IListClone() {
        shakeMarkAndEnqueue(intern("rtListNew"))
        shakeMarkAndEnqueue(intern("rtListClone"))
    // IListSet/IListSetRetain: no clar_fn_ call of their own (a raw
    // rt_list_at write plus fpRetainVal/fpReleaseVal on the old/new
    // element) -- fully covered by the always-rooted core above.

    // ---- map ----
    } else if nm == IMapSet() or nm == IMapSetRetain() {
        shakeMarkAndEnqueue(intern("rtMapSet"))
        // fpMapReleaseGuard (cprint.cla) additionally calls rtMapHas/
        // rtMapGet here, conditionally on the value type needing release --
        // over-approximate unconditionally rather than re-deriving that
        // condition here.
        shakeMarkAndEnqueue(intern("rtMapHas"))
        shakeMarkAndEnqueue(intern("rtMapGet"))
    } else if nm == IMapGet() {
        shakeMarkAndEnqueue(intern("rtMapGet"))
    } else if nm == IMapGetDv() or nm == IMapGetDvBirth() {
        shakeMarkAndEnqueue(intern("rtMapGetDv"))
    } else if nm == IMapHas() {
        shakeMarkAndEnqueue(intern("rtMapHas"))
    } else if nm == IMapRemove() {
        shakeMarkAndEnqueue(intern("rtMapRemove"))
        // fpMapReleaseGuard again -- see IMapSet's own comment above.
        shakeMarkAndEnqueue(intern("rtMapHas"))
        shakeMarkAndEnqueue(intern("rtMapGet"))
    } else if nm == IMapCount() {
        shakeMarkAndEnqueue(intern("rtMapCount"))
    } else if nm == IMapClear() {
        shakeMarkAndEnqueue(intern("rtMapClear"))
    } else if nm == IMapClearDeep() {
        // memory-leak-fix phase Task 4 -- see IListClearDeep's own
        // comment.
        shakeMarkAndEnqueue(intern("rtMapClear"))
    } else if nm == IMapFreeVar() {
        shakeMarkAndEnqueue(intern("rtMapRelease"))

    // ---- sortedmap (map-hashtable phase, Task 2) -- TyMap's twin above,
    // name for name ----
    } else if nm == ISortedMapSet() or nm == ISortedMapSetRetain() {
        shakeMarkAndEnqueue(intern("rtSortedMapSet"))
        // fpMapReleaseGuard again -- see IMapSet's own comment above.
        shakeMarkAndEnqueue(intern("rtSortedMapHas"))
        shakeMarkAndEnqueue(intern("rtSortedMapGet"))
    } else if nm == ISortedMapGet() {
        shakeMarkAndEnqueue(intern("rtSortedMapGet"))
    } else if nm == ISortedMapGetDv() or nm == ISortedMapGetDvBirth() {
        shakeMarkAndEnqueue(intern("rtSortedMapGetDv"))
    } else if nm == ISortedMapHas() {
        shakeMarkAndEnqueue(intern("rtSortedMapHas"))
    } else if nm == ISortedMapRemove() {
        shakeMarkAndEnqueue(intern("rtSortedMapRemove"))
        // fpMapReleaseGuard again -- see IMapSet's own comment above.
        shakeMarkAndEnqueue(intern("rtSortedMapHas"))
        shakeMarkAndEnqueue(intern("rtSortedMapGet"))
    } else if nm == ISortedMapCount() {
        shakeMarkAndEnqueue(intern("rtSortedMapCount"))
    } else if nm == ISortedMapClear() {
        shakeMarkAndEnqueue(intern("rtSortedMapClear"))
    } else if nm == ISortedMapClearDeep() {
        // memory-leak-fix phase Task 4 -- see IListClearDeep's own
        // comment.
        shakeMarkAndEnqueue(intern("rtSortedMapClear"))
    } else if nm == ISortedMapFreeVar() {
        shakeMarkAndEnqueue(intern("rtSortedMapRelease"))

    // ---- intmap (map-hashtable phase, Task 7) -- TyMap's twin above,
    // name for name (all six data-op names -- Set/Get/GetDv/Has/Remove/
    // Count -- still need their own explicit root here despite
    // rtIntMapNew/ValAt/Retain/Release/Lastref already being unconditional:
    // these six are gated on the INTRINSIC actually being used, same as
    // Map/SortedMap's own data ops) ----
    } else if nm == IIntMapSet() or nm == IIntMapSetRetain() {
        shakeMarkAndEnqueue(intern("rtIntMapSet"))
        // fpMapReleaseGuard again -- see IMapSet's own comment above.
        shakeMarkAndEnqueue(intern("rtIntMapHas"))
        shakeMarkAndEnqueue(intern("rtIntMapGet"))
    } else if nm == IIntMapGet() {
        shakeMarkAndEnqueue(intern("rtIntMapGet"))
    } else if nm == IIntMapGetDv() or nm == IIntMapGetDvBirth() {
        shakeMarkAndEnqueue(intern("rtIntMapGetDv"))
    } else if nm == IIntMapHas() {
        shakeMarkAndEnqueue(intern("rtIntMapHas"))
    } else if nm == IIntMapRemove() {
        shakeMarkAndEnqueue(intern("rtIntMapRemove"))
        // fpMapReleaseGuard again -- see IMapSet's own comment above.
        shakeMarkAndEnqueue(intern("rtIntMapHas"))
        shakeMarkAndEnqueue(intern("rtIntMapGet"))
    } else if nm == IIntMapCount() {
        shakeMarkAndEnqueue(intern("rtIntMapCount"))
    } else if nm == IIntMapClear() {
        shakeMarkAndEnqueue(intern("rtIntMapClear"))
    } else if nm == IIntMapClearDeep() {
        // memory-leak-fix phase Task 4 -- see IListClearDeep's own
        // comment.
        shakeMarkAndEnqueue(intern("rtIntMapClear"))
    } else if nm == IIntMapFreeVar() {
        shakeMarkAndEnqueue(intern("rtIntMapRelease"))

    // ---- ui ----
    } else if nm == IUiEdit() {
        // Plan native-5e Task 3: fpUiEditStmt's kind==3 (map-target) arm now
        // prints clar_fn_rtMapGetDv instead of the always-compiled bare C
        // rt_map_get_dv -- root it here (over-approximating regardless of
        // this call site's actual compile-time kind, same convention as
        // IMapSet's rtMapHas/rtMapGet above) since it's the one map op NOT
        // already in the always-rooted core. kind==2's clar_fn_rtListAt
        // needs no root of its own -- rtListAt is already always-rooted.
        shakeMarkAndEnqueue(intern("rtMapGetDv"))

    // ---- retain/release ----
    } else if nm == IRetain() {
        // Dispatches on the OPERAND's own type kind at print time (KText:
        // bare rtTextRetain; KList/KMap: cpEmitRetain's recursive walk;
        // KRec: clar_retain_NAME, generated separately and gated by its own
        // irRcWalkNeeded flag, untouched by shake) -- all of Text/List/Map's
        // own retain entry points are already in the always-rooted core
        // above, so no further table entry is needed here.
    } else if nm == IRelease() {
        // Mirrors IRetain just above (cpEmitRelease); same reasoning.

    // ---- file / serialization ----
    } else if nm == IFileSave() {
        shakeMarkAndEnqueue(intern("rtFileSave"))
    } else if nm == IFileLoad() {
        shakeMarkAndEnqueue(intern("rtFileLoad"))
    // IFileReadText/IFileWriteText/IFileName: no root needed. Plan
    // native-5d Task 3 briefly routed lastError through a Clarus-side
    // global pair (rtLastErrCode/rtLastErrMsg) with a post-call
    // fpEmitCoreLastErrSync fixup rooting rtSetLastErr here explicitly;
    // Task 12.5 reverted lastError storage to platform-owned (see
    // core.cla's file header) -- rtLastErrCode/rtLastErrMsg no longer
    // exist, the fixup is gone, and ILastErrCode/ILastErrMsg/ILastErr read
    // rt_lasterr_code/rt_lasterr_msg directly (no EIntr-shaped call, so no
    // shake root of any kind is needed for that read path either).
    // rtSetLastErr itself stays reachable via the ordinary call graph
    // (str.cla/text.cla/ser.cla all call it directly).

    // ---- core: fixed-point ----
    } else if nm == IFixMul() {
        shakeMarkAndEnqueue(intern("rtFixMul"))
    } else if nm == IFixDiv() {
        shakeMarkAndEnqueue(intern("rtFixDiv"))
    }
}

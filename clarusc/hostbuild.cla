// hostbuild.cla -- `clarusc build`'s C-compiler step (installed-toolchain
// phase). Kept out of App.startCLI (main.cla) for its 32 KB native
// segment budget. Uses hostext.cla's primitives; on the 68k lane those
// are nat_ no-ops, so HostMkTemp fails and nothing is built.

// cliArgvAdd: one NUL-terminated argument onto a HostSpawn argv.
func cliArgvAdd(argv: text, s: string) {
    argv.append(s)
    argv.append(char(0))
}

// cliArgvSplit: appends each space/tab-separated word of s to argv.
// False if a word is over 255 bytes (argv is then incomplete).
func cliArgvSplit(argv: text, s: text): bool {
    var i: int
    var start: int
    var c: char
    start = 0
    i = 0
    while i <= s.length {
        if i < s.length { c = s[i] } else { c = ' ' }
        if c == ' ' or c == char(9) {
            if i - start > 255 { return false }
            if i > start { cliArgvAdd(argv, s[start, i - start]) }
            start = i + 1
        }
        i = i + 1
    }
    return true
}

// cliBuildHost: writes cSrc to a temp .c file and runs
// `<cc words> <cflags...> -I <rtDir>../host -o <outPath> <tmp> <rtDir>../host/rt.c`
// as a direct argv exec. CC (non-empty) beats the built-in default; its
// first word is the program, the rest lead the arguments. CFLAGS (set,
// even empty) is split the same way, else -O1. The temp file is deleted
// unless keepC. Returns the clarusc exit status, 0 or 1.
func cliBuildHost(cSrc: text, outPath: string, keepC: bool): int {
    var t: text
    var tmp: string
    var cc: string
    var argv: text
    var i: int
    var hostDir: string
    var status: int
    var msg: string

    t = ""
    if not HostGetEnv("CC", t) or t.length == 0 {
        HostDefaultCc(t)
    }
    argv = ""
    if not cliArgvSplit(argv, t) {
        log("clarusc build: CC too long")
        return 1
    }
    i = 0
    while i < argv.length and argv[i] != char(0) {
        i = i + 1
    }
    cc = argv[0, i]
    if HostGetEnv("CFLAGS", t) {
        if not cliArgvSplit(argv, t) {
            log("clarusc build: CFLAGS word too long")
            return 1
        }
    } else {
        cliArgvAdd(argv, "-O1")
    }

    t = ""
    if not HostMkTemp(t) {
        log("clarusc build: " + lastError.message)
        return 1
    }
    // HostMkTemp unlinks and refuses a path over 255 bytes, so it fits.
    tmp = t[0, t.length]
    if not file.writeText(tmp, cSrc, app.doctype, app.id) {
        msg = lastError.message
        file.delete(tmp)
        log("clarusc build: cannot write " + tmp + ": " + msg)
        return 1
    }

    hostDir = rtDir + "../host"
    cliArgvAdd(argv, "-I")
    cliArgvAdd(argv, hostDir)
    cliArgvAdd(argv, "-o")
    cliArgvAdd(argv, outPath)
    cliArgvAdd(argv, tmp)
    cliArgvAdd(argv, hostDir + "/rt.c")

    status = HostSpawn(argv)
    msg = lastError.message
    if keepC {
        log("clarusc build: kept " + tmp)
    } else {
        file.delete(tmp)
    }
    if status == -1 {
        log("clarusc build: " + msg)
        return 1
    }
    if status != 0 {
        log("clarusc build: " + cc + " failed (status " + numToStr(status) + ")")
        return 1
    }
    return 0
}

include "../lib.cla"
include "../tok.cla"
include "../lex.cla"
include "../ast.cla"
include "../parse.cla"
include "../types.cla"
include "../check.cla"

// runCase lexes, parses, and (if the parse was clean) type-checks src,
// then alerts either "clean" or every diagnostic -- one line per
// diagnostic family, cross-checked against `clarus check` on the
// identical snippet (see task-9-report.md).
func runCase(label: string, src: text) {
    var head: int
    var d: int

    resetDiags()
    lexAll(src)
    head = parseFile()
    if diags.count == 0 {
        checkProgram(head)
    }
    alert("=== " + label + " ===")
    if diags.count == 0 {
        alert("clean")
    } else {
        d = 0
        while d < diags.count {
            alert(formatDiag("check_test.cla", diags[d]))
            d = d + 1
        }
    }
}

// ln appends one source line plus a newline to the buffer (text is a
// mutable handle, so the caller's buffer is grown in place).
func ln(src: text, s: string) {
    src.append(s)
    src.append(char(10))
}

on App.startEmpty {
    var src: text
    var body: int
    var s: int

    // Case 1: a clean program exercising the whole 9a decl+expr surface --
    // record (with a defaulted field), enum, two consts, two globals (one
    // enum-defaulted via a bare member), mutual recursion between two
    // funcs (forward call resolves via the two-phase walk), and a third
    // func exercising list/map/string/record locals and a record field
    // assignment.
    src = ""
    src.append("record Point {")
    src.append(char(10))
    src.append("    x: int")
    src.append(char(10))
    src.append("    y: int = 1")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("enum Color {")
    src.append(char(10))
    src.append("    Red")
    src.append(char(10))
    src.append("    Green")
    src.append(char(10))
    src.append("    Blue")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("const Pi: int = 3")
    src.append(char(10))
    src.append("const Greeting: string = \"hi\"")
    src.append(char(10))
    src.append("var origin: Point")
    src.append(char(10))
    src.append("var favorite: Color = Blue")
    src.append(char(10))
    src.append("func isEven(n: int): bool {")
    src.append(char(10))
    src.append("    isOdd(n - 1)")
    src.append(char(10))
    src.append("    return true")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("func isOdd(n: int): bool {")
    src.append(char(10))
    src.append("    isEven(n - 1)")
    src.append(char(10))
    src.append("    return true")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("func useStuff() {")
    src.append(char(10))
    src.append("    var names: list of string")
    src.append(char(10))
    src.append("    var scores: map of int")
    src.append(char(10))
    src.append("    var s: string")
    src.append(char(10))
    src.append("    var p: Point")
    src.append(char(10))
    src.append("    var cnt: int")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    names.add(\"a\")")
    src.append(char(10))
    src.append("    scores[\"a\"] = 1")
    src.append(char(10))
    src.append("    s = \"hi\" + \"there\"")
    src.append(char(10))
    src.append("    p = origin")
    src.append(char(10))
    src.append("    p.x = 5")
    src.append(char(10))
    src.append("    cnt = names.count")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("clean", src)

    // Case 2: mixed int/fixed arithmetic.
    src = ""
    src.append("func f() {")
    src.append(char(10))
    src.append("    var a: int")
    src.append(char(10))
    src.append("    var b: fixed")
    src.append(char(10))
    src.append("    var c: fixed")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    a = 1")
    src.append(char(10))
    src.append("    b = 2.0")
    src.append(char(10))
    src.append("    c = a + b")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("mixed-int-fixed", src)

    // Case 3: bitwise operator on a fixed operand.
    src = ""
    src.append("func f() {")
    src.append(char(10))
    src.append("    var a: fixed")
    src.append(char(10))
    src.append("    var b: int")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    a = 1.0")
    src.append(char(10))
    src.append("    b = a & 1")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("bitwise-requires-int", src)

    // Case 4: undefined name (an assignment's RHS, not a `return` --
    // Task 9b, not 9a, checks return statements; see task-9-report.md).
    src = ""
    src.append("func f() {")
    src.append(char(10))
    src.append("    var a: int")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    a = missingName")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("undefined", src)

    // Case 5: redeclaration in the same scope.
    src = ""
    src.append("func f() {")
    src.append(char(10))
    src.append("    var a: int")
    src.append(char(10))
    src.append("    var a: int")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("redeclaration", src)

    // Case 6: cannot-convert (bool has no conversion to char).
    src = ""
    src.append("func f() {")
    src.append(char(10))
    src.append("    var b: bool")
    src.append(char(10))
    src.append("    var c: char")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    b = true")
    src.append(char(10))
    src.append("    c = char(b)")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("cannot-convert", src)

    // Case 7: enums are not ordered (`<` on enum values, via an
    // assignment so 9a's checker -- which doesn't check `return` yet --
    // actually visits the comparison).
    src = ""
    src.append("enum Color {")
    src.append(char(10))
    src.append("    Red")
    src.append(char(10))
    src.append("    Green")
    src.append(char(10))
    src.append("    Blue")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("func f() {")
    src.append(char(10))
    src.append("    var a: Color")
    src.append(char(10))
    src.append("    var b: Color")
    src.append(char(10))
    src.append("    var r: bool")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    a = Red")
    src.append(char(10))
    src.append("    b = Blue")
    src.append(char(10))
    src.append("    r = a < b")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("enums-not-ordered", src)

    // Case 8: duplicate enum value (explicit 0 collides with Red's
    // implicit 0).
    src = ""
    src.append("enum Color {")
    src.append(char(10))
    src.append("    Red")
    src.append(char(10))
    src.append("    Green 0")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("duplicate-enum-value", src)

    // Case 9: const type must be int/fixed/char/bool/enum/string.
    src = ""
    src.append("const Names: list of string = 3")
    src.append(char(10))
    runCase("const-type-must-be", src)

    // Case 10: a function signature naming a record declared later still
    // errors -- phase 1 resolves signatures against the scope built SO
    // FAR, not the complete program (Task 0's forward-type carve-out).
    src = ""
    src.append("func make(): Widget {")
    src.append(char(10))
    src.append("    return new Widget")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("record Widget {")
    src.append(char(10))
    src.append("    x: int")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("forward-type-in-signature-still-errors", src)

    // Case 11: mutual recursion checks clean -- phase 2 sees the complete
    // top-level scope, so isEven calling isOdd (declared AFTER it) and
    // vice versa both resolve.
    src = ""
    src.append("func isEven(n: int): bool {")
    src.append(char(10))
    src.append("    isOdd(n - 1)")
    src.append(char(10))
    src.append("    return true")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("func isOdd(n: int): bool {")
    src.append(char(10))
    src.append("    isEven(n - 1)")
    src.append(char(10))
    src.append("    return true")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("mutual-recursion-clean", src)

    // ---- Task 9b: statements ----

    // Case 12: break outside any loop (loop-depth counter).
    src = ""
    ln(src, "func f() {")
    ln(src, "    break")
    ln(src, "}")
    runCase("break-outside-loop", src)

    // Case 13: cancel outside a closeRequest handler.
    src = ""
    ln(src, "func f() {")
    ln(src, "    cancel")
    ln(src, "}")
    runCase("cancel-outside-closeRequest", src)

    // Case 14: duplicate switch case label (after const/enum resolution).
    src = ""
    ln(src, "func f() {")
    ln(src, "    var x: int")
    ln(src, "    x = 1")
    ln(src, "    switch x {")
    ln(src, "    case 1 { x = 2 }")
    ln(src, "    case 1 { x = 3 }")
    ln(src, "    }")
    ln(src, "}")
    runCase("duplicate-case-label", src)

    // Case 15: switch operand must be int/char/enum/string (fixed rejected).
    src = ""
    ln(src, "func f() {")
    ln(src, "    var x: fixed")
    ln(src, "    x = 1.0")
    ln(src, "    switch x {")
    ln(src, "    case 1 { }")
    ln(src, "    }")
    ln(src, "}")
    runCase("switch-operand", src)

    // Case 16: return type mismatch.
    src = ""
    ln(src, "func f(): int {")
    ln(src, "    return true")
    ln(src, "}")
    runCase("return-mismatch", src)

    // Case 17: quit code must be int.
    src = ""
    ln(src, "func f() {")
    ln(src, "    quit \"no\"")
    ln(src, "}")
    runCase("quit-code-int", src)

    // ---- Task 9b: UI ----

    // Case 18: unknown window property, and unknown widget property.
    src = ""
    ln(src, "window W {")
    ln(src, "    bogus: \"x\"")
    ln(src, "    button B { frobnicate: 1 }")
    ln(src, "}")
    runCase("unknown-property", src)

    // Case 19: binds a field that doesn't exist on the form record.
    src = ""
    ln(src, "record R {")
    ln(src, "    name: string(63)")
    ln(src, "}")
    ln(src, "window W {")
    ln(src, "    form for R")
    ln(src, "    field F { binds: missing; label: \"X:\" }")
    ln(src, "}")
    runCase("bind-no-field", src)

    // Case 20: binds a field of a type incompatible with the widget.
    src = ""
    ln(src, "record R {")
    ln(src, "    flag: bool")
    ln(src, "}")
    ln(src, "window W {")
    ln(src, "    form for R")
    ln(src, "    field F { binds: flag }")
    ln(src, "}")
    runCase("bind-incompatible", src)

    // Case 21: edit into a non-form window.
    src = ""
    ln(src, "record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "window W {")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    edit W, new R")
    ln(src, "}")
    runCase("edit-not-form-window", src)

    // Case 22: duplicate menu item.
    src = ""
    ln(src, "menu M {")
    ln(src, "    item A \"A\"")
    ln(src, "    item A \"B\"")
    ln(src, "}")
    runCase("duplicate-menu-item", src)

    // ---- Task 9b: events ----

    // Case 23: unknown widget event in an extend block.
    src = ""
    ln(src, "window W {")
    ln(src, "    button B { }")
    ln(src, "}")
    ln(src, "extend W {")
    ln(src, "    on B.frob { }")
    ln(src, "}")
    runCase("unknown-event", src)

    // Case 24: handler param signature mismatch (table.select takes i: int).
    src = ""
    ln(src, "window W {")
    ln(src, "    table T { }")
    ln(src, "}")
    ln(src, "extend W {")
    ln(src, "    on T.select(x: string) { }")
    ln(src, "}")
    runCase("handler-takes", src)

    // Case 25: `every N ticks` needs N >= 1.
    src = ""
    ln(src, "every 0 ticks {")
    ln(src, "}")
    runCase("every-tick-min", src)

    // Case 26: a clean window + form + menu + extend program (window-ref
    // value selects, instance-var scope, form-record `accepted` param, the
    // `window` keyword, widget events, and nested window-scoped menu
    // commands all resolve).
    src = ""
    ln(src, "record Doc {")
    ln(src, "    name: string(63)")
    ln(src, "}")
    ln(src, "window Main {")
    ln(src, "    title: \"Main\"")
    ln(src, "    form for Doc")
    ln(src, "    field Name { binds: name }")
    ln(src, "    button Go { caption: \"Go\" }")
    ln(src, "    var count: int = 0")
    ln(src, "}")
    ln(src, "menu File {")
    ln(src, "    item Save \"Save\"")
    ln(src, "}")
    ln(src, "on App.startEmpty {")
    ln(src, "    open Main")
    ln(src, "}")
    ln(src, "extend Main {")
    ln(src, "    on Go.click {")
    ln(src, "        count = count + 1")
    ln(src, "        Name.enabled = false")
    ln(src, "    }")
    ln(src, "    on accepted(d: Doc) {")
    ln(src, "        count = count + 1")
    ln(src, "    }")
    ln(src, "    extend File {")
    ln(src, "        on Save.select { close window }")
    ln(src, "    }")
    ln(src, "}")
    runCase("window-menu-extend-clean", src)

    // ---- Task 1 (app section): application identity ----

    // Case 27: a clean app section -- all six properties, a well-formed
    // four-character id, plus a startCLI handler (app section and app
    // entry points are independent features, so this also confirms the
    // parser doesn't confuse the two).
    src = ""
    ln(src, "app Demo {")
    ln(src, "    name: \"Demo\"")
    ln(src, "    version: \"1.0\"")
    ln(src, "    author: \"Someone\"")
    ln(src, "    about: \"A demo app\"")
    ln(src, "    icon: \"demo.pbm\"")
    ln(src, "    id: \"MNDL\"")
    ln(src, "}")
    ln(src, "on App.startCLI(args: list of string) {")
    ln(src, "}")
    runCase("app-clean", src)

    // Case 28: a second app section is rejected outright, at its own
    // line/col, without re-validating its properties.
    src = ""
    ln(src, "app A {")
    ln(src, "    name: \"A\"")
    ln(src, "}")
    ln(src, "app B {")
    ln(src, "    name: \"B\"")
    ln(src, "}")
    runCase("app-duplicate-section", src)

    // Case 29: the same property declared twice within one app section.
    src = ""
    ln(src, "app A {")
    ln(src, "    name: \"A\"")
    ln(src, "    name: \"B\"")
    ln(src, "}")
    runCase("app-duplicate-key", src)

    // Case 30: a property name the app section doesn't recognize.
    src = ""
    ln(src, "app A {")
    ln(src, "    flavor: \"x\"")
    ln(src, "}")
    runCase("app-unknown-key", src)

    // Case 31: a non-string-literal value.
    src = ""
    ln(src, "app A {")
    ln(src, "    name: 1 + 2")
    ln(src, "}")
    runCase("app-non-literal", src)

    // Case 32: a bare property with no value at all.
    src = ""
    ln(src, "app A {")
    ln(src, "    name")
    ln(src, "}")
    runCase("app-missing-value", src)

    // Case 33: an id that isn't exactly four characters.
    src = ""
    ln(src, "app A {")
    ln(src, "    id: \"TOOLONG\"")
    ln(src, "}")
    runCase("app-bad-id-len", src)

    // Case 34: an id that's four characters but all lowercase (reserved).
    src = ""
    ln(src, "app A {")
    ln(src, "    id: \"mndl\"")
    ln(src, "}")
    runCase("app-bad-id-lower", src)

    // Case 35: icon declared without an id -- reported at the icon
    // property's own line/col, not the app section's.
    src = ""
    ln(src, "app A {")
    ln(src, "    icon: \"x.pbm\"")
    ln(src, "}")
    runCase("app-icon-without-id", src)

    // Case 36: a `column` clause inside an app body -- parseProperty
    // dispatches to parseColumn for the `column` keyword regardless of
    // enclosing decl, so an app section can receive a DkColumn node just
    // like a window can. The column's header ("name") collides with a
    // real app property name, so this also pins that checkAppDecl must
    // recognize the non-DkProperty node before ever treating it as one
    // (previously: propertyValuesHead/exprNext misread DkColumn's other
    // fields as exprs-arena data and crashed with an out-of-range index).
    src = ""
    ln(src, "app A {")
    ln(src, "    column \"name\" shows x width 10")
    ln(src, "}")
    runCase("app-column-item", src)

    // Case 37: an id containing a quote character -- printable ASCII, so
    // it would otherwise sail through checkAppId, but build-mac.sh
    // interpolates the id raw into Rez/CMake source and a quote breaks
    // that generated syntax with a confusing downstream error.
    src = ""
    ln(src, "app A {")
    ln(src, "    id: \"M'DL\"")
    ln(src, "}")
    runCase("app-id-quote", src)

    // Case 38: exprTypeOf pins the checker's resolved type for a known
    // expression's own arena index -- "a + b" (the RHS of c's assignment,
    // the third statement in f's body) -- so lower.cla's mustType can
    // later read it back via exprTypeGet. Reached by walking the parsed
    // AST directly (not via runCase, which only alerts diagnostics),
    // mirroring parse_test.cla's AST-walking convention.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var a: int")
    ln(src, "    var b: int")
    ln(src, "    var c: int")
    ln(src, "")
    ln(src, "    a = 1")
    ln(src, "    b = 2")
    ln(src, "    c = a + b")
    ln(src, "}")
    resetDiags()
    lexAll(src)
    body = parseFile()
    checkProgram(body)
    alert("=== exprtype-pin ===")
    if diags.count != 0 {
        alert("unexpected diagnostics")
    } else {
        body = funcDeclBody(body)
        s = blockStmtsHead(body)
        s = stmtNext(s)
        s = stmtNext(s)
        if exprTypeGet(assignRHS(s)) == IntT {
            alert("a + b : int")
        } else {
            alert("wrong type recorded")
        }
    }

    // ---- Task 2 (native-5a): the `ptr` type ----

    // Case 39: a clean program exercising ptr's whole surface -- var decl,
    // ptr+int/ptr-int, ptr comparisons (== and <), int(p) and ptr(0)
    // conversions, and a record with a ptr field (Ch13: record fields of
    // type ptr are allowed -- only containers reject it).
    src = ""
    ln(src, "record Rec {")
    ln(src, "    p: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var q: ptr")
    ln(src, "    var a: ptr")
    ln(src, "    var i: int")
    ln(src, "    var b: bool")
    ln(src, "")
    ln(src, "    p = ptr(4096)")
    ln(src, "    q = ptr(8192)")
    ln(src, "    a = p + 4")
    ln(src, "    a = p - 2")
    ln(src, "    b = p == q")
    ln(src, "    b = p < q")
    ln(src, "    i = int(p)")
    ln(src, "}")
    runCase("ptr-clean", src)

    // Case 40: ptr + ptr is not a valid operand pair (only ptr + int is).
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var q: ptr")
    ln(src, "    var r: ptr")
    ln(src, "")
    ln(src, "    p = ptr(0)")
    ln(src, "    q = ptr(0)")
    ln(src, "    r = p + q")
    ln(src, "}")
    runCase("ptr-plus-ptr", src)

    // Case 41: ptr + fixed is likewise invalid (only ptr + int).
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var r: ptr")
    ln(src, "")
    ln(src, "    p = ptr(0)")
    ln(src, "    r = p + 1.5")
    ln(src, "}")
    runCase("ptr-plus-fixed", src)

    // Case 42: ptr cannot be a container element.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var xs: list of ptr")
    ln(src, "}")
    runCase("ptr-container-element", src)

    // Case 43: ptr(x) only accepts an int argument.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "")
    ln(src, "    p = ptr(\"x\")")
    ln(src, "}")
    runCase("ptr-from-string", src)

    // ---- Task 3 (native-5a): `external func` decls ----

    // Case 44: a clean external func returning ptr, called and assigned to
    // a ptr local -- proves external decls check (and are callable) like
    // ordinary functions.
    src = ""
    ln(src, "external func NewHandle(size: int): ptr")
    ln(src, "func f() {")
    ln(src, "    var h: ptr")
    ln(src, "")
    ln(src, "    h = NewHandle(16)")
    ln(src, "}")
    runCase("extern-clean", src)

    // Case 45: external func params are restricted to int, ptr, bool,
    // char, str, or text (Plan 5b Task 3 widened this from just int/ptr/
    // bool/char) -- a container type (map of int) is still rejected.
    src = ""
    ln(src, "external func F(m: map of int)")
    runCase("extern-bad-param-type", src)

    // Case 46: an external func has no body -- a stray `{` after the
    // signature is a top-level parse error, not a body.
    src = ""
    ln(src, "external func F(n: int) {")
    ln(src, "}")
    runCase("extern-body-not-allowed", src)

    // Case 47: a call to an external func checks arity exactly like a
    // call to an ordinary function (the generic checkArgsCall path).
    src = ""
    ln(src, "external func NewHandle(size: int): ptr")
    ln(src, "func f() {")
    ln(src, "    var h: ptr")
    ln(src, "")
    ln(src, "    h = NewHandle()")
    ln(src, "}")
    runCase("extern-wrong-arg-count", src)

    // ---- Task 4 (native-5a): peek/poke builtins ----

    // Case 48: peekb(p) assigned to an int -- clean.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var v: int")
    ln(src, "")
    ln(src, "    v = peekb(p)")
    ln(src, "}")
    runCase("peek-clean", src)

    // Case 49: peekb requires a ptr argument -- an int literal is rejected.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var v: int")
    ln(src, "")
    ln(src, "    v = peekb(5)")
    ln(src, "}")
    runCase("peek-bad-arg-type", src)

    // Case 50: pokew requires exactly two arguments.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "")
    ln(src, "    pokew(p)")
    ln(src, "}")
    runCase("poke-wrong-arg-count", src)

    // Case 51: pokeb's second argument must be int -- char is rejected.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var c: char")
    ln(src, "")
    ln(src, "    pokeb(p, c)")
    ln(src, "}")
    runCase("poke-bad-arg-type", src)

    // ---- Task 1 (native-5b): `overlay record` declarations ----

    // Case 52: a clean program exercising overlay records' whole surface --
    // declaration, ptr->overlay and overlay->ptr conversions, field get/set,
    // and an overlay-vs-overlay equality comparison.
    src = ""
    ln(src, "overlay record RtHdr {")
    ln(src, "    rc: int")
    ln(src, "    data: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var h: RtHdr")
    ln(src, "    var n: int")
    ln(src, "    var same: bool")
    ln(src, "")
    ln(src, "    h = RtHdr(p)")
    ln(src, "    n = h.rc")
    ln(src, "    h.rc = 5")
    ln(src, "    h.data = p")
    ln(src, "    p = ptr(h)")
    ln(src, "    same = h == RtHdr(p)")
    ln(src, "}")
    runCase("overlay-clean", src)

    // Case 53: overlay field types are restricted to int/bool/char/fixed/
    // ptr -- string is rejected.
    src = ""
    ln(src, "overlay record Bad {")
    ln(src, "    s: string")
    ln(src, "}")
    runCase("overlay-bad-field-type", src)

    // Case 54: an overlay field may not have a default value.
    src = ""
    ln(src, "overlay record BadD {")
    ln(src, "    n: int = 3")
    ln(src, "}")
    runCase("overlay-field-default", src)

    // Case 55: an overlay record cannot be a container element.
    src = ""
    ln(src, "overlay record RtHdr {")
    ln(src, "    rc: int")
    ln(src, "    data: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var xs: list of RtHdr")
    ln(src, "}")
    runCase("overlay-container-element", src)

    // Case 56: there is no `new` for an overlay record -- it is only
    // obtained by converting an existing ptr.
    src = ""
    ln(src, "overlay record RtHdr {")
    ln(src, "    rc: int")
    ln(src, "    data: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var h: RtHdr")
    ln(src, "")
    ln(src, "    h = new RtHdr")
    ln(src, "}")
    runCase("overlay-new", src)

    // Case 57: selecting an undeclared field on an overlay record uses the
    // same "undefined: X" shape as an ordinary record.
    src = ""
    ln(src, "overlay record RtHdr {")
    ln(src, "    rc: int")
    ln(src, "    data: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var h: RtHdr")
    ln(src, "    var n: int")
    ln(src, "")
    ln(src, "    n = h.nope")
    ln(src, "}")
    runCase("overlay-undefined-field", src)

    // ---- Task 3 (native-5b): str/text external params ----

    // Case 58: string and text are now legal external param types (waist
    // widening) -- clean, alongside the pre-existing int/ptr/bool/char set.
    src = ""
    ln(src, "external func F(s: string, t: text)")
    runCase("extern-str-text-param-clean", src)

    // Case 59: an external return type is still restricted to int, ptr,
    // bool, or char -- text is NOT a legal return type (5a's message,
    // untouched by this task; params and returns now use different
    // diagnostics, so this pins the return one didn't drift).
    src = ""
    ln(src, "external func G(): text")
    runCase("extern-text-return-bad", src)

    // ---- Task 13 (native-5b): 5a leftovers -- container-elem coverage ----

    // Case 60: ptr cannot be a container element, map form (Case 42 already
    // covers the list form).
    src = ""
    ln(src, "func f() {")
    ln(src, "    var m: map of ptr")
    ln(src, "}")
    runCase("ptr-container-element-map", src)

    // Case 61: ptr cannot be a container element, array form.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var a: ptr[4]")
    ln(src, "}")
    runCase("ptr-container-element-array", src)

    // Case 62: overlay records cannot be container elements, map form
    // (Case 55 already covers the list form).
    src = ""
    ln(src, "overlay record RtHdr {")
    ln(src, "    rc: int")
    ln(src, "    data: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var m: map of RtHdr")
    ln(src, "}")
    runCase("overlay-container-element-map", src)

    // Case 63: overlay records cannot be container elements, array form.
    src = ""
    ln(src, "overlay record RtHdr {")
    ln(src, "    rc: int")
    ln(src, "    data: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var a: RtHdr[4]")
    ln(src, "}")
    runCase("overlay-container-element-array", src)

    // Case 64: an overlay record cannot be a field of an ordinary record
    // (deferred minor from Task 1's review -- checkRecordDecl's
    // "overlay records cannot be record fields" path had no direct case).
    src = ""
    ln(src, "overlay record RtHdr {")
    ln(src, "    rc: int")
    ln(src, "    data: ptr")
    ln(src, "}")
    ln(src, "record Wrapper {")
    ln(src, "    h: RtHdr")
    ln(src, "}")
    runCase("overlay-record-field", src)

    // Case 65: a record and an overlay record sharing a name collide via
    // the ordinary top-level redeclaration check -- no overlay-specific
    // handling needed (deferred minor from Task 1's review).
    src = ""
    ln(src, "record Dup {")
    ln(src, "    n: int")
    ln(src, "}")
    ln(src, "overlay record Dup {")
    ln(src, "    rc: int")
    ln(src, "}")
    runCase("record-overlay-name-collision", src)

    // ---- Task 2 (native-5d): `external func` trap/inline clauses ----

    // Case 66: one `external func` per clause form (pascal trap, reg trap,
    // inline deref, inline nop) -- all four clean, proving the grammar
    // parses and the checker accepts every valid shape.
    src = ""
    ln(src, "external func TickCount(): int = trap 0xA975")
    ln(src, "external func BlockMove(src: ptr, dst: ptr, count: int) = trap 0xA02E reg")
    ln(src, "external func HandleToPtr(h: ptr): ptr = inline deref")
    ln(src, "external func DebugBreak() = inline nop")
    runCase("extern-clause-clean", src)

    // Case 67: a trap word outside 0xA000..0xAFFF is rejected (bare trap,
    // pascal convention).
    src = ""
    ln(src, "external func Bad(): int = trap 0x1234")
    runCase("extern-trap-bad-word", src)

    // Case 68: a `reg` trap allows at most 2 ptr parameters -- a third is
    // rejected (the A0/A1 rule).
    src = ""
    ln(src, "external func F(a: ptr, b: ptr, c: ptr) = trap 0xA000 reg")
    runCase("extern-trap-reg-too-many-ptr", src)

    // Case 69: `inline deref` requires exactly one ptr parameter and a ptr
    // return -- two params is rejected even though both are ptr.
    src = ""
    ln(src, "external func Bad(p: ptr, q: ptr): ptr = inline deref")
    runCase("extern-inline-deref-bad-sig", src)

    // Case 70: a `reg` trap rejects a str/text param outright -- neither
    // has a register slot, so it falls into checkExternFunc's regBad path
    // (the same diagnostic a 3rd ptr/scalar param gets) rather than the
    // ordinary param-type diagnostic (string IS an otherwise-legal extern
    // param type -- Case 58 -- so this pins that `reg` narrows the set
    // further).
    src = ""
    ln(src, "external func F(s: string) = trap 0xA000 reg")
    runCase("extern-trap-reg-str-param", src)

    // Case 71: a `reg` trap allows at most 2 int/bool/char parameters -- a
    // 3rd is rejected (the D0/D1 rule, the scalarCount sibling of Case
    // 68's ptrCount check).
    src = ""
    ln(src, "external func F(a: int, b: int, c: int) = trap 0xA000 reg")
    runCase("extern-trap-reg-too-many-scalar", src)

    // Case 72: `inline nop` requires no return type -- a non-void return
    // is rejected.
    src = ""
    ln(src, "external func Bad(): int = inline nop")
    runCase("extern-inline-nop-bad-return", src)

    // ---- Task 4 (native-5e): `word` extern param/return type ----

    // Case 73: a clean external func using `word` in both a param
    // position (UiMoveTo, both params) and a return position
    // (UiFindWindow) -- proves the grammar parses and the checker accepts
    // it exactly like int (real Toolbox trap words: MoveTo 0xA893,
    // FindWindow 0xA92C).
    src = ""
    ln(src, "external func UiMoveTo(h: word, v: word) = trap 0xA893")
    ln(src, "external func UiFindWindow(pt: int, wpOut: ptr): word = trap 0xA92C")
    runCase("extern-word-clean", src)

    // Case 74: `word` means nothing outside an extern signature -- a plain
    // var decl naming it as a type resolves through the ordinary TxNamed/
    // resolveType path and fails "undefined", the same diagnostic any
    // other unknown type name gets.
    src = ""
    ln(src, "var x: word")
    runCase("word-not-a-type-outside-extern", src)

    // Case 75: `word` as a non-extern func's parameter type is likewise
    // just an unknown type name -- parseParam/parseType (not
    // parseExternParam/parseExternType) handle it, so it never becomes a
    // TxWord node here.
    src = ""
    ln(src, "func F(w: word): int {")
    ln(src, "    return 1")
    ln(src, "}")
    runCase("word-param-non-extern", src)

    // Case 76: `word` remains a perfectly ordinary identifier everywhere
    // else -- a variable literally named `word` (int-typed) is clean, the
    // non-regression the brief calls out by name.
    src = ""
    ln(src, "func F(): int {")
    ln(src, "    var word: int")
    ln(src, "    word = 5")
    ln(src, "    return word")
    ln(src, "}")
    runCase("word-as-ordinary-identifier", src)

    // ---- Task 1 (toolbox-integration Feature A): named reg(...) clause ----
    //
    // regnamed_decl.cla (this directory) is the accept fixture proper --
    // a standalone declaration-only program run via scripts/clarus-run.sh
    // (Step 3/5 of the brief), since it needs a real App.startCLI handler
    // clarus-run.sh can execute. Case 77 below is a lighter clean case
    // exercising the SAME named-clause resolution path inside this
    // harness, alongside its error siblings.

    // Case 77: a named reg(...) clause with two binds (one D-register, one
    // A-register) plus an explicit `ret` -- proves the happy path: every
    // param bound exactly once, no register reused, a declared return
    // type satisfies `ret`.
    src = ""
    ln(src, "external func F(a: int, b: ptr): int = trap 0xA000 reg(d0: a, a0: b) ret d0")
    runCase("extern-reg-named-clean", src)

    // Case 78: a regBind names an identifier that isn't a declared
    // parameter at all.
    src = ""
    ln(src, "external func F(response: ptr) = trap 0xA000 reg(a1: x)")
    runCase("extern-reg-named-unknown-param", src)

    // Case 79: two regBinds claim the same register -- the named form's
    // dup-register rule (no positional 2+2 count limit applies here, but
    // no register may serve two masters either).
    src = ""
    ln(src, "external func F(a: int, b: int) = trap 0xA000 reg(d0: a, d0: b)")
    runCase("extern-reg-named-dup-register", src)

    // Case 80: a declared parameter with no regBind at all -- every param
    // must be bound exactly once under the named form.
    src = ""
    ln(src, "external func F(selector: int, response: ptr) = trap 0xA000 reg(d0: selector)")
    runCase("extern-reg-named-unbound-param", src)

    // Case 81: `ret` on a void extern (no declared return type) -- `ret`
    // only names WHERE a result lives, it can't conjure one.
    src = ""
    ln(src, "external func F(a: int) = trap 0xA000 reg(d0: a) ret d0")
    runCase("extern-reg-ret-requires-return-type", src)

    // Case 82: `memerr` and `ret` are mutually exclusive -- `memerr`
    // already names the result's source (the MemErr global, not a
    // register), so naming a result register too is a contradiction.
    src = ""
    ln(src, "external func F(a: int): int = trap 0xA000 reg(d0: a) memerr ret d0")
    runCase("extern-reg-memerr-ret-exclusive", src)

    // Case 83: an unrecognized register spelling (`a5` -- the globals-base
    // register, never valid here) is a PARSE error, not a checker one --
    // parseRegName rejects it the same way an unrecognized `inline`
    // sub-keyword is rejected, before any param-name resolution happens.
    src = ""
    ln(src, "external func F(x: int) = trap 0xA000 reg(a5: x)")
    runCase("extern-reg-named-bad-register", src)

    // Case 84: a `str` parameter under the named form is rejected with the
    // SAME diagnostic the positional form's regBad path already gives
    // (Case 70's sibling) -- str/text still have no register slot,
    // regardless of which form of `reg` is used, and the named form
    // doesn't get a second message for the same underlying rule.
    src = ""
    ln(src, "external func F(s: string) = trap 0xA000 reg(a0: s)")
    runCase("extern-reg-named-str-param", src)

    // Case 85 (task review fix): the SAME parameter bound to two
    // DIFFERENT registers -- regUsed alone only catches a register reused
    // across params, not a param claimed twice, so this used to compile
    // clean (Task 1's `d0: a` bind landed, then `d1: a` silently
    // overwrote it). Exactly one diagnostic, naming the param.
    src = ""
    ln(src, "external func F(a: int): int = trap 0xA000 reg(d0: a, d1: a) ret d0")
    runCase("extern-reg-named-param-bound-twice", src)

    // Case 86 (task review fix): a void extern with BOTH `memerr` and
    // `ret` used to trip "ret clause requires a return type" AND "memerr
    // and ret are mutually exclusive" together -- two diagnostics for one
    // malformed clause. Only the mutual-exclusion message should fire;
    // it already covers the void case (memerr's own result source makes
    // a declared return type moot either way).
    src = ""
    ln(src, "external func F() = trap 0xA000 reg memerr ret d0")
    runCase("extern-reg-memerr-ret-void", src)

    // Case 87 (task review fix): `ret` with a bad register spelling --
    // parseRegName covers the `ret REG` half exactly the same way it
    // covers a regBind's REG half (Case 83's sibling).
    src = ""
    ln(src, "external func F(a: int): int = trap 0xA000 reg(d0: a) ret d3")
    runCase("extern-reg-ret-bad-register", src)

    // ---- Task 3 (toolbox-integration): identical-signature extern dedup ----
    //
    // testdata/lowlevel/externdedup.cla is the accept fixture proper (a
    // standalone runnable program, host-built+run under the strict/
    // paranoid leak gate by internal/lowlevel's TestLowlevel). Cases 88-93
    // below exercise the checker's merge/conflict decision directly.

    // Case 88: two byte-identical `external func` decls -- the merge's
    // happy path. Second decl gets no scope entry of its own; no
    // diagnostic either.
    src = ""
    ln(src, "external func F(a: int): int = trap 0xA000")
    ln(src, "external func F(a: int): int = trap 0xA000")
    runCase("extern-dedup-identical-clean", src)

    // Case 89: same name, same param/return types, DIFFERENT trap word --
    // the clause comparison's trap-word dimension catches it. Both
    // diagnostics cite the other decl's line:col (lib.cla's Diag carries
    // one position, so "both source positions" means two diagnostics).
    src = ""
    ln(src, "external func F(): int = trap 0xA000")
    ln(src, "external func F(): int = trap 0xA001")
    runCase("extern-dedup-conflicting-trap", src)

    // Case 90: same name+trap, DIFFERENT param type (int vs. ptr, both
    // independently legal extern-param types -- only the identity check
    // between the two decls catches this, not the ordinary per-param
    // type-legality rule).
    src = ""
    ln(src, "external func F(a: int) = trap 0xA000")
    ln(src, "external func F(a: ptr) = trap 0xA000")
    runCase("extern-dedup-conflicting-param-type", src)

    // Case 91 (self-review probe): same name/types/trap/conv, DIFFERENT
    // `ret` register -- proves the merge compares the ret-register
    // dimension too, not just param/return types and trap/conv/sel.
    src = ""
    ln(src, "external func F(a: int): int = trap 0xA000 reg ret d0")
    ln(src, "external func F(a: int): int = trap 0xA000 reg ret d1")
    runCase("extern-dedup-conflicting-ret-reg", src)

    // Case 92 (self-review): an ORDINARY func declared first, then an
    // extern of the same name -- the dedup merge path never engages (it
    // only ever compares extern against extern), so this stays the
    // ordinary generic "redeclaration of X", not the new conflicting-
    // extern message.
    src = ""
    ln(src, "func F(a: int): int { return a }")
    ln(src, "external func F(a: int): int = trap 0xA000")
    runCase("extern-dedup-func-then-extern-generic", src)

    // Case 93 (self-review): the reverse order -- extern first, ordinary
    // func second -- same generic message.
    src = ""
    ln(src, "external func F(a: int): int = trap 0xA000")
    ln(src, "func F(a: int): int { return a }")
    runCase("extern-dedup-extern-then-func-generic", src)

    // ---- Task 4 (toolbox-integration Feature B): `extern record` ----
    //
    // xrec_accept.cla (this directory) is the standalone check-only accept
    // fixture proper (Point/EventRecord/SFReply -- the spec's own worked
    // example -- plus field reads/writes and a decay-less field-arithmetic
    // sanity). Cases 94-111 below exercise the same declaration/field/
    // usage surface, plus every required error diagnostic, inside this
    // harness.

    // Case 94: a light clean case -- word/int/ptr/nested-xrec/str[N] fields,
    // a plain field read/write, arithmetic on a field read, and a nested
    // field read/write -- the same happy path xrec_accept.cla proves at
    // greater length.
    src = ""
    ln(src, "extern record Point {")
    ln(src, "    v: word")
    ln(src, "    h: word")
    ln(src, "}")
    ln(src, "extern record EventRecord {")
    ln(src, "    what: word")
    ln(src, "    where: Point")
    ln(src, "}")
    ln(src, "func F(): int {")
    ln(src, "    var ev: EventRecord")
    ln(src, "    var n: int")
    ln(src, "    ev.what = 5")
    ln(src, "    n = ev.what + 1")
    ln(src, "    ev.where.v = 10")
    ln(src, "    n = ev.where.v")
    ln(src, "    return n")
    ln(src, "}")
    runCase("extern-xrec-clean", src)

    // Case 95: a field type outside the Ch13 palette (`text` -- also not
    // bool/byte/word/int/ptr/str[N]/pad[N]/a nested extern record).
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: text")
    ln(src, "}")
    runCase("extern-xrec-bad-field-type", src)

    // Case 96: whole-record assignment -- no whole-record operations
    // exist for an extern record (Ch13).
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "func F() {")
    ln(src, "    var a: R")
    ln(src, "    var b: R")
    ln(src, "    a = b")
    ln(src, "}")
    runCase("extern-xrec-whole-assign", src)

    // Case 97: an extern record used as an ordinary record's field.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "record Wrapper {")
    ln(src, "    r: R")
    ln(src, "}")
    runCase("extern-xrec-as-record-field", src)

    // Case 98: an extern record used as a container element.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "func F() {")
    ln(src, "    var xs: list of R")
    ln(src, "}")
    runCase("extern-xrec-as-container-element", src)

    // Case 99: an extern record used as an ordinary func's parameter.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "func F(a: R) {")
    ln(src, "}")
    runCase("extern-xrec-as-func-param", src)

    // Case 100: an extern record used as an ordinary func's RETURN type
    // (the func-param/result ban's other half).
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "func F(): R {")
    ln(src, "    var r: R")
    ln(src, "    return r")
    ln(src, "}")
    runCase("extern-xrec-as-func-return", src)

    // Case 101: decay attempted OUTSIDE an extern call -- a `ptr` param on
    // an ORDINARY (non-extern) func, per Ch13: "the one way to take an
    // extern record's address is decay at an external func call site".
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "func G(p: ptr) {")
    ln(src, "}")
    ln(src, "func F() {")
    ln(src, "    var a: R")
    ln(src, "    G(a)")
    ln(src, "}")
    runCase("extern-xrec-decay-outside-extern", src)

    // Case 102: a NON-4-byte extern record (two int fields, 8 bytes)
    // passed where an extern parameter is declared `int` -- only a
    // 4-byte extern record may use the Point-by-value coercion.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "    y: int")
    ln(src, "}")
    ln(src, "external func G(n: int) = trap 0xA000 reg")
    ln(src, "func F() {")
    ln(src, "    var a: R")
    ln(src, "    G(a)")
    ln(src, "}")
    runCase("extern-xrec-int-coercion-wrong-size", src)

    // Case 103: str[0] -- below the 1..255 range.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: str[0]")
    ln(src, "}")
    runCase("extern-xrec-str-len-too-small", src)

    // Case 104: str[256] -- above the 1..255 range.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: str[256]")
    ln(src, "}")
    runCase("extern-xrec-str-len-too-large", src)

    // Case 105: a NAMED `pad` field (`x: pad[4]`) -- Ch13's grammar
    // forbids naming a pad run at all; "pad" is recognized ONLY as a bare
    // field line's own leading token (parseXRecFieldDecl), never after a
    // `name:`. `name: pad[4]` instead falls through to plain parseType,
    // which builds an ARRAY-of-named-type("pad") TypeExpr (parseType's own
    // ordinary `[N]` array-length sugar) -- not itself in the palette, so
    // this lands on the SAME catch-all "field type must be..." message
    // every other non-palette shape gets (not a one-off "undefined: pad"),
    // per Ch13's own extern-record section note on this corner case.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: pad[4]")
    ln(src, "}")
    runCase("extern-xrec-named-pad-field", src)

    // Case 106: decay through a NESTED xrec field lvalue (`ev.where`),
    // clean -- the ptr-decay half of Ch13's "extern-record variable, or a
    // nested extern-record field lvalue" rule.
    src = ""
    ln(src, "extern record Point {")
    ln(src, "    v: word")
    ln(src, "    h: word")
    ln(src, "}")
    ln(src, "extern record EventRecord {")
    ln(src, "    what: word")
    ln(src, "    where: Point")
    ln(src, "}")
    ln(src, "external func F(p: ptr) = trap 0xA000 reg")
    ln(src, "func G() {")
    ln(src, "    var ev: EventRecord")
    ln(src, "    F(ev.where)")
    ln(src, "}")
    runCase("extern-xrec-nested-decay-clean", src)

    // Case 107: Point-by-value coercion through a NESTED xrec field
    // lvalue (`ev.where`, a 4-byte Point), clean -- the IM FindWindow
    // idiom this rule exists for.
    src = ""
    ln(src, "extern record Point {")
    ln(src, "    v: word")
    ln(src, "    h: word")
    ln(src, "}")
    ln(src, "extern record EventRecord {")
    ln(src, "    what: word")
    ln(src, "    where: Point")
    ln(src, "}")
    ln(src, "external func F(n: int) = trap 0xA000 reg")
    ln(src, "func G() {")
    ln(src, "    var ev: EventRecord")
    ln(src, "    F(ev.where)")
    ln(src, "}")
    runCase("extern-xrec-nested-int-coercion-clean", src)

    // ---- Task 4 dedup: identical-signature merge (Extern dedup section's
    // "same rule covers duplicate extern record declarations") ----

    // Case 108: two byte-identical `extern record` decls -- the merge's
    // happy path. Second decl gets no scope entry of its own; no
    // diagnostic either.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "    y: word")
    ln(src, "}")
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "    y: word")
    ln(src, "}")
    runCase("extern-xrec-dedup-identical-clean", src)

    // Case 109: same field NAMES, DIFFERENT field TYPE at one position --
    // only the identity check between the two decls catches this.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "extern record R {")
    ln(src, "    x: ptr")
    ln(src, "}")
    runCase("extern-xrec-dedup-conflicting-field-type", src)

    // Case 110: same field TYPES/order, DIFFERENT field NAME -- unlike
    // extern func's param-name exemption, an xrec's field names must
    // match too (Extern dedup section's own "unlike func-param name
    // exemption" note).
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "extern record R {")
    ln(src, "    y: int")
    ln(src, "}")
    runCase("extern-xrec-dedup-conflicting-field-name", src)

    // Case 111: `byte` fields plus a bare `pad[N]` field (no name, layout
    // only) alongside ordinary int fields -- clean, with a field
    // read/write on the `byte` field (reads/writes as `int`, Ch13).
    src = ""
    ln(src, "extern record R {")
    ln(src, "    a: byte")
    ln(src, "    pad[3]")
    ln(src, "    b: int")
    ln(src, "}")
    ln(src, "func F(): int {")
    ln(src, "    var r: R")
    ln(src, "    r.a = 5")
    ln(src, "    r.b = 100")
    ln(src, "    return r.a + r.b")
    ln(src, "}")
    runCase("extern-xrec-pad-bare-clean", src)

    // ---- Task 4 task-review fix round: 1 Critical + 2 Important + 2
    // Minor findings, each pinned by its own case below ----

    // Case 112 (Critical 1): whole-record COMPARISON -- Ch13 explicitly
    // bans this alongside assignment ("no whole-record operations ...
    // no comparison"), but checkComparison had no TyXRec branch and
    // assignable's own TyXRec case (added for typesEqual/exhaustive-switch
    // parity, never meant to reach a real comparison) made two same-named
    // xrec operands look "compatible" -- `a == b` checked clean and would
    // have emitted broken C.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "func F(): bool {")
    ln(src, "    var a: R")
    ln(src, "    var b: R")
    ln(src, "    return a == b")
    ln(src, "}")
    runCase("extern-xrec-compare-banned", src)

    // Case 113 (Minor 5): whole-assign ban, RHS direction, into an
    // UNRELATED type (`ptr`) -- pins the "xrec as RHS into anything" half
    // of the both-directions rule with a real corpus case (previously
    // only probe-verified, not corpus-locked).
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "func F() {")
    ln(src, "    var a: R")
    ln(src, "    var p: ptr")
    ln(src, "    p = a")
    ln(src, "}")
    runCase("extern-xrec-assign-rhs-into-ptr", src)

    // Case 114 (Minor 5): whole-assign ban via a `var` initializer, RHS
    // direction, into an unrelated type (`int`) -- the checkVarDecl
    // counterpart to Case 113's checkAssignStmt case.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "func F() {")
    ln(src, "    var a: R")
    ln(src, "    var n: int = a")
    ln(src, "}")
    runCase("extern-xrec-var-init-rhs-into-int", src)

    // Case 115 (Critical 1 follow-up): the SAME whole-assign leak Case 113/
    // 114 pin for checkVarDecl/checkAssignStmt also existed in
    // checkWindowVar (a window's per-instance `var` is a separate DeclNode
    // path, not checkVarDecl) -- `var ev: R = otherEv` inside a window
    // body silently passed compatible()'s same-name-xrec case with no
    // guard of its own. (A window var's own initializer can't reference a
    // SIBLING window var by bare name -- checkWindowVar doesn't chain
    // window vars into scope incrementally as they're declared, a
    // pre-existing, unrelated characteristic -- so this reaches an xrec
    // value via a GLOBAL instead.)
    src = ""
    ln(src, "extern record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "var g: R")
    ln(src, "window W {")
    ln(src, "    var b: R = g")
    ln(src, "}")
    runCase("extern-xrec-window-var-whole-assign", src)

    // Case 116 (Minor 4): `pad[0]` -- below Ch13's documented `pad[N]
    // (N >= 1)` minimum.
    src = ""
    ln(src, "extern record R {")
    ln(src, "    pad[0]")
    ln(src, "}")
    runCase("extern-xrec-pad-len-too-small", src)

    // ---- Task 7 (toolbox-integration Feature C: `callback func`) ----

    // Case 117: clean -- declare a callback, decay it to an extern func's
    // ptr parameter, and call it directly (both legal per Ch13).
    src = ""
    ln(src, "external func CbInvoke(fn: ptr, a: int): int")
    ln(src, "callback func doubleIt(a: int): int {")
    ln(src, "    return a * 2")
    ln(src, "}")
    ln(src, "func F(): int {")
    ln(src, "    var r: int = CbInvoke(doubleIt, 21)")
    ln(src, "    return r + doubleIt(1)")
    ln(src, "}")
    runCase("callback-decay-and-direct-call-clean", src)

    // Case 118: a callback PARAMETER type outside the palette (`text` --
    // not bool/char/word/int/ptr).
    src = ""
    ln(src, "callback func F(a: text): int {")
    ln(src, "    return 1")
    ln(src, "}")
    runCase("callback-param-type-not-in-palette", src)

    // Case 119: a callback RETURN type outside the palette (`string`).
    src = ""
    ln(src, "callback func F(a: int): string {")
    ln(src, "    return \"x\"")
    ln(src, "}")
    runCase("callback-return-type-not-in-palette", src)

    // Case 120: a callback name used as a variable initializer -- the
    // decay rule's misuse diagnostic, since the one legal position is an
    // extern call's ptr argument, not a `var` initializer.
    src = ""
    ln(src, "callback func doubleIt(a: int): int {")
    ln(src, "    return a * 2")
    ln(src, "}")
    ln(src, "func F() {")
    ln(src, "    var f: ptr = doubleIt")
    ln(src, "}")
    runCase("callback-name-as-var-init", src)

    // Case 121: a callback name used as a function's return value.
    src = ""
    ln(src, "callback func doubleIt(a: int): int {")
    ln(src, "    return a * 2")
    ln(src, "}")
    ln(src, "func G(): ptr {")
    ln(src, "    return doubleIt")
    ln(src, "}")
    runCase("callback-name-as-return-value", src)

    // Case 122: a callback name passed as an argument to an ORDINARY
    // (non-extern) function -- decay is legal only at an extern call.
    src = ""
    ln(src, "callback func doubleIt(a: int): int {")
    ln(src, "    return a * 2")
    ln(src, "}")
    ln(src, "func Take(p: ptr) {")
    ln(src, "}")
    ln(src, "func F() {")
    ln(src, "    Take(doubleIt)")
    ln(src, "}")
    runCase("callback-name-as-non-extern-call-arg", src)

    // Case 123: a callback name passed to an extern call's NON-ptr
    // parameter (int here) -- decay is legal only at a ptr parameter.
    src = ""
    ln(src, "external func CbInvoke(fn: ptr, a: int): int")
    ln(src, "callback func doubleIt(a: int): int {")
    ln(src, "    return a * 2")
    ln(src, "}")
    ln(src, "func F(): int {")
    ln(src, "    return CbInvoke(ptr(0), doubleIt)")
    ln(src, "}")
    runCase("callback-name-as-extern-nonptr-arg", src)

    // Case 124: a NESTED `callback func` (inside a function body) -- top
    // level only; the statement parser has no idea what to do with a bare
    // `func` token after an ordinary identifier-led expression statement.
    src = ""
    ln(src, "func F() {")
    ln(src, "    callback func G(a: int): int {")
    ln(src, "        return a")
    ln(src, "    }")
    ln(src, "}")
    runCase("callback-nested-parse-error", src)

    // Case 125: callback-vs-callback redeclaration -- callbacks have
    // bodies and are never eligible for Task 3's identical-signature
    // extern merge, so a repeated name is an ordinary redeclaration error
    // even when the two decls are byte-for-byte identical otherwise.
    src = ""
    ln(src, "callback func doubleIt(a: int): int {")
    ln(src, "    return a * 2")
    ln(src, "}")
    ln(src, "callback func doubleIt(a: int): int {")
    ln(src, "    return a * 3")
    ln(src, "}")
    runCase("callback-vs-callback-redeclaration", src)

    // Case 126: callback-vs-extern-func name collision -- a callback
    // sharing a name with an existing `external func` redeclaration-errors
    // too (the dedup rule Task 3 added is signature-only-extern-vs-extern,
    // never extern-vs-callback).
    src = ""
    ln(src, "external func doubleIt(a: int): int")
    ln(src, "callback func doubleIt(a: int): int {")
    ln(src, "    return a * 2")
    ln(src, "}")
    runCase("callback-vs-extern-name-collision", src)

    // Case 127 (final-review fix wave): two byte-identical `external func`
    // decls with a `string` param -- strT(n) (types.cla) allocates a FRESH
    // arena entry per resolveType call, so the raw arena-index comparison
    // externClauseMatches used to use spuriously treated these as
    // conflicting despite being the same type. Must merge clean.
    src = ""
    ln(src, "external func UiStrAddr(s: string): ptr")
    ln(src, "external func UiStrAddr(s: string): ptr")
    runCase("extern-dedup-str-param-clean", src)

    // Case 128: same as above but with a `word` param -- the other
    // extern-param kind whose resolveType call could plausibly allocate a
    // non-singleton arena entry per call. Must also merge clean.
    src = ""
    ln(src, "external func UiWordAddr(w: word): ptr")
    ln(src, "external func UiWordAddr(w: word): ptr")
    runCase("extern-dedup-word-param-clean", src)

    // Case 129: two `string`-param externs differing in DECLARED WIDTH
    // (string(63) vs. bare `string`, i.e. string(255)) -- typesEqual
    // compares TyStr by typeN (width) too, so this must still CONFLICT,
    // proving the Case 127 fix didn't overcorrect into ignoring width.
    src = ""
    ln(src, "external func UiStrAddr2(s: string(63)): ptr")
    ln(src, "external func UiStrAddr2(s: string): ptr")
    runCase("extern-dedup-str-param-width-conflict", src)
}

include "../lib.cla"
include "../tok.cla"
include "../lex.cla"
include "../ast.cla"
include "../parse.cla"
include "../types.cla"
include "../check.cla"

// runCase lexes, parses, and (if the parse was clean) type-checks src,
// then alerts either "clean" or every diagnostic -- one line per
// diagnostic family, cross-checked against `clarus check` on the
// identical snippet (see task-9-report.md).
func runCase(label: string, src: text) {
    var head: int
    var d: int

    resetDiags()
    lexAll(src)
    head = parseFile()
    if diags.count == 0 {
        checkProgram(head)
    }
    alert("=== " + label + " ===")
    if diags.count == 0 {
        alert("clean")
    } else {
        d = 0
        while d < diags.count {
            alert(formatDiag("check_test.cla", diags[d]))
            d = d + 1
        }
    }
}

// ln appends one source line plus a newline to the buffer (text is a
// mutable handle, so the caller's buffer is grown in place).
func ln(src: text, s: string) {
    src.append(s)
    src.append(char(10))
}

on App.startEmpty {
    var src: text
    var body: int
    var s: int

    // Case 1: a clean program exercising the whole 9a decl+expr surface --
    // record (with a defaulted field), enum, two consts, two globals (one
    // enum-defaulted via a bare member), mutual recursion between two
    // funcs (forward call resolves via the two-phase walk), and a third
    // func exercising list/map/string/record locals and a record field
    // assignment.
    src = ""
    src.append("record Point {")
    src.append(char(10))
    src.append("    x: int")
    src.append(char(10))
    src.append("    y: int = 1")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("enum Color {")
    src.append(char(10))
    src.append("    Red")
    src.append(char(10))
    src.append("    Green")
    src.append(char(10))
    src.append("    Blue")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("const Pi: int = 3")
    src.append(char(10))
    src.append("const Greeting: string = \"hi\"")
    src.append(char(10))
    src.append("var origin: Point")
    src.append(char(10))
    src.append("var favorite: Color = Blue")
    src.append(char(10))
    src.append("func isEven(n: int): bool {")
    src.append(char(10))
    src.append("    isOdd(n - 1)")
    src.append(char(10))
    src.append("    return true")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("func isOdd(n: int): bool {")
    src.append(char(10))
    src.append("    isEven(n - 1)")
    src.append(char(10))
    src.append("    return true")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("func useStuff() {")
    src.append(char(10))
    src.append("    var names: list of string")
    src.append(char(10))
    src.append("    var scores: map of int")
    src.append(char(10))
    src.append("    var s: string")
    src.append(char(10))
    src.append("    var p: Point")
    src.append(char(10))
    src.append("    var cnt: int")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    names.add(\"a\")")
    src.append(char(10))
    src.append("    scores[\"a\"] = 1")
    src.append(char(10))
    src.append("    s = \"hi\" + \"there\"")
    src.append(char(10))
    src.append("    p = origin")
    src.append(char(10))
    src.append("    p.x = 5")
    src.append(char(10))
    src.append("    cnt = names.count")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("clean", src)

    // Case 2: mixed int/fixed arithmetic.
    src = ""
    src.append("func f() {")
    src.append(char(10))
    src.append("    var a: int")
    src.append(char(10))
    src.append("    var b: fixed")
    src.append(char(10))
    src.append("    var c: fixed")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    a = 1")
    src.append(char(10))
    src.append("    b = 2.0")
    src.append(char(10))
    src.append("    c = a + b")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("mixed-int-fixed", src)

    // Case 3: bitwise operator on a fixed operand.
    src = ""
    src.append("func f() {")
    src.append(char(10))
    src.append("    var a: fixed")
    src.append(char(10))
    src.append("    var b: int")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    a = 1.0")
    src.append(char(10))
    src.append("    b = a & 1")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("bitwise-requires-int", src)

    // Case 4: undefined name (an assignment's RHS, not a `return` --
    // Task 9b, not 9a, checks return statements; see task-9-report.md).
    src = ""
    src.append("func f() {")
    src.append(char(10))
    src.append("    var a: int")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    a = missingName")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("undefined", src)

    // Case 5: redeclaration in the same scope.
    src = ""
    src.append("func f() {")
    src.append(char(10))
    src.append("    var a: int")
    src.append(char(10))
    src.append("    var a: int")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("redeclaration", src)

    // Case 6: cannot-convert (bool has no conversion to char).
    src = ""
    src.append("func f() {")
    src.append(char(10))
    src.append("    var b: bool")
    src.append(char(10))
    src.append("    var c: char")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    b = true")
    src.append(char(10))
    src.append("    c = char(b)")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("cannot-convert", src)

    // Case 7: enums are not ordered (`<` on enum values, via an
    // assignment so 9a's checker -- which doesn't check `return` yet --
    // actually visits the comparison).
    src = ""
    src.append("enum Color {")
    src.append(char(10))
    src.append("    Red")
    src.append(char(10))
    src.append("    Green")
    src.append(char(10))
    src.append("    Blue")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("func f() {")
    src.append(char(10))
    src.append("    var a: Color")
    src.append(char(10))
    src.append("    var b: Color")
    src.append(char(10))
    src.append("    var r: bool")
    src.append(char(10))
    src.append("")
    src.append(char(10))
    src.append("    a = Red")
    src.append(char(10))
    src.append("    b = Blue")
    src.append(char(10))
    src.append("    r = a < b")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("enums-not-ordered", src)

    // Case 8: duplicate enum value (explicit 0 collides with Red's
    // implicit 0).
    src = ""
    src.append("enum Color {")
    src.append(char(10))
    src.append("    Red")
    src.append(char(10))
    src.append("    Green 0")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("duplicate-enum-value", src)

    // Case 9: const type must be int/fixed/char/bool/enum/string.
    src = ""
    src.append("const Names: list of string = 3")
    src.append(char(10))
    runCase("const-type-must-be", src)

    // Case 10: a function signature naming a record declared later still
    // errors -- phase 1 resolves signatures against the scope built SO
    // FAR, not the complete program (Task 0's forward-type carve-out).
    src = ""
    src.append("func make(): Widget {")
    src.append(char(10))
    src.append("    return new Widget")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("record Widget {")
    src.append(char(10))
    src.append("    x: int")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("forward-type-in-signature-still-errors", src)

    // Case 11: mutual recursion checks clean -- phase 2 sees the complete
    // top-level scope, so isEven calling isOdd (declared AFTER it) and
    // vice versa both resolve.
    src = ""
    src.append("func isEven(n: int): bool {")
    src.append(char(10))
    src.append("    isOdd(n - 1)")
    src.append(char(10))
    src.append("    return true")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    src.append("func isOdd(n: int): bool {")
    src.append(char(10))
    src.append("    isEven(n - 1)")
    src.append(char(10))
    src.append("    return true")
    src.append(char(10))
    src.append("}")
    src.append(char(10))
    runCase("mutual-recursion-clean", src)

    // ---- Task 9b: statements ----

    // Case 12: break outside any loop (loop-depth counter).
    src = ""
    ln(src, "func f() {")
    ln(src, "    break")
    ln(src, "}")
    runCase("break-outside-loop", src)

    // Case 13: cancel outside a closeRequest handler.
    src = ""
    ln(src, "func f() {")
    ln(src, "    cancel")
    ln(src, "}")
    runCase("cancel-outside-closeRequest", src)

    // Case 14: duplicate switch case label (after const/enum resolution).
    src = ""
    ln(src, "func f() {")
    ln(src, "    var x: int")
    ln(src, "    x = 1")
    ln(src, "    switch x {")
    ln(src, "    case 1 { x = 2 }")
    ln(src, "    case 1 { x = 3 }")
    ln(src, "    }")
    ln(src, "}")
    runCase("duplicate-case-label", src)

    // Case 15: switch operand must be int/char/enum/string (fixed rejected).
    src = ""
    ln(src, "func f() {")
    ln(src, "    var x: fixed")
    ln(src, "    x = 1.0")
    ln(src, "    switch x {")
    ln(src, "    case 1 { }")
    ln(src, "    }")
    ln(src, "}")
    runCase("switch-operand", src)

    // Case 16: return type mismatch.
    src = ""
    ln(src, "func f(): int {")
    ln(src, "    return true")
    ln(src, "}")
    runCase("return-mismatch", src)

    // Case 17: quit code must be int.
    src = ""
    ln(src, "func f() {")
    ln(src, "    quit \"no\"")
    ln(src, "}")
    runCase("quit-code-int", src)

    // ---- Task 9b: UI ----

    // Case 18: unknown window property, and unknown widget property.
    src = ""
    ln(src, "window W {")
    ln(src, "    bogus: \"x\"")
    ln(src, "    button B { frobnicate: 1 }")
    ln(src, "}")
    runCase("unknown-property", src)

    // Case 19: binds a field that doesn't exist on the form record.
    src = ""
    ln(src, "record R {")
    ln(src, "    name: string(63)")
    ln(src, "}")
    ln(src, "window W {")
    ln(src, "    form for R")
    ln(src, "    field F { binds: missing; label: \"X:\" }")
    ln(src, "}")
    runCase("bind-no-field", src)

    // Case 20: binds a field of a type incompatible with the widget.
    src = ""
    ln(src, "record R {")
    ln(src, "    flag: bool")
    ln(src, "}")
    ln(src, "window W {")
    ln(src, "    form for R")
    ln(src, "    field F { binds: flag }")
    ln(src, "}")
    runCase("bind-incompatible", src)

    // Case 21: edit into a non-form window.
    src = ""
    ln(src, "record R {")
    ln(src, "    x: int")
    ln(src, "}")
    ln(src, "window W {")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    edit W, new R")
    ln(src, "}")
    runCase("edit-not-form-window", src)

    // Case 22: duplicate menu item.
    src = ""
    ln(src, "menu M {")
    ln(src, "    item A \"A\"")
    ln(src, "    item A \"B\"")
    ln(src, "}")
    runCase("duplicate-menu-item", src)

    // ---- Task 9b: events ----

    // Case 23: unknown widget event in an extend block.
    src = ""
    ln(src, "window W {")
    ln(src, "    button B { }")
    ln(src, "}")
    ln(src, "extend W {")
    ln(src, "    on B.frob { }")
    ln(src, "}")
    runCase("unknown-event", src)

    // Case 24: handler param signature mismatch (table.select takes i: int).
    src = ""
    ln(src, "window W {")
    ln(src, "    table T { }")
    ln(src, "}")
    ln(src, "extend W {")
    ln(src, "    on T.select(x: string) { }")
    ln(src, "}")
    runCase("handler-takes", src)

    // Case 25: `every N ticks` needs N >= 1.
    src = ""
    ln(src, "every 0 ticks {")
    ln(src, "}")
    runCase("every-tick-min", src)

    // Case 26: a clean window + form + menu + extend program (window-ref
    // value selects, instance-var scope, form-record `accepted` param, the
    // `window` keyword, widget events, and nested window-scoped menu
    // commands all resolve).
    src = ""
    ln(src, "record Doc {")
    ln(src, "    name: string(63)")
    ln(src, "}")
    ln(src, "window Main {")
    ln(src, "    title: \"Main\"")
    ln(src, "    form for Doc")
    ln(src, "    field Name { binds: name }")
    ln(src, "    button Go { caption: \"Go\" }")
    ln(src, "    var count: int = 0")
    ln(src, "}")
    ln(src, "menu File {")
    ln(src, "    item Save \"Save\"")
    ln(src, "}")
    ln(src, "on App.startEmpty {")
    ln(src, "    open Main")
    ln(src, "}")
    ln(src, "extend Main {")
    ln(src, "    on Go.click {")
    ln(src, "        count = count + 1")
    ln(src, "        Name.enabled = false")
    ln(src, "    }")
    ln(src, "    on accepted(d: Doc) {")
    ln(src, "        count = count + 1")
    ln(src, "    }")
    ln(src, "    extend File {")
    ln(src, "        on Save.select { close window }")
    ln(src, "    }")
    ln(src, "}")
    runCase("window-menu-extend-clean", src)

    // ---- Task 1 (app section): application identity ----

    // Case 27: a clean app section -- all six properties, a well-formed
    // four-character id, plus a startCLI handler (app section and app
    // entry points are independent features, so this also confirms the
    // parser doesn't confuse the two).
    src = ""
    ln(src, "app Demo {")
    ln(src, "    name: \"Demo\"")
    ln(src, "    version: \"1.0\"")
    ln(src, "    author: \"Someone\"")
    ln(src, "    about: \"A demo app\"")
    ln(src, "    icon: \"demo.pbm\"")
    ln(src, "    id: \"MNDL\"")
    ln(src, "}")
    ln(src, "on App.startCLI(args: list of string) {")
    ln(src, "}")
    runCase("app-clean", src)

    // Case 28: a second app section is rejected outright, at its own
    // line/col, without re-validating its properties.
    src = ""
    ln(src, "app A {")
    ln(src, "    name: \"A\"")
    ln(src, "}")
    ln(src, "app B {")
    ln(src, "    name: \"B\"")
    ln(src, "}")
    runCase("app-duplicate-section", src)

    // Case 29: the same property declared twice within one app section.
    src = ""
    ln(src, "app A {")
    ln(src, "    name: \"A\"")
    ln(src, "    name: \"B\"")
    ln(src, "}")
    runCase("app-duplicate-key", src)

    // Case 30: a property name the app section doesn't recognize.
    src = ""
    ln(src, "app A {")
    ln(src, "    flavor: \"x\"")
    ln(src, "}")
    runCase("app-unknown-key", src)

    // Case 31: a non-string-literal value.
    src = ""
    ln(src, "app A {")
    ln(src, "    name: 1 + 2")
    ln(src, "}")
    runCase("app-non-literal", src)

    // Case 32: a bare property with no value at all.
    src = ""
    ln(src, "app A {")
    ln(src, "    name")
    ln(src, "}")
    runCase("app-missing-value", src)

    // Case 33: an id that isn't exactly four characters.
    src = ""
    ln(src, "app A {")
    ln(src, "    id: \"TOOLONG\"")
    ln(src, "}")
    runCase("app-bad-id-len", src)

    // Case 34: an id that's four characters but all lowercase (reserved).
    src = ""
    ln(src, "app A {")
    ln(src, "    id: \"mndl\"")
    ln(src, "}")
    runCase("app-bad-id-lower", src)

    // Case 35: icon declared without an id -- reported at the icon
    // property's own line/col, not the app section's.
    src = ""
    ln(src, "app A {")
    ln(src, "    icon: \"x.pbm\"")
    ln(src, "}")
    runCase("app-icon-without-id", src)

    // Case 36: a `column` clause inside an app body -- parseProperty
    // dispatches to parseColumn for the `column` keyword regardless of
    // enclosing decl, so an app section can receive a DkColumn node just
    // like a window can. The column's header ("name") collides with a
    // real app property name, so this also pins that checkAppDecl must
    // recognize the non-DkProperty node before ever treating it as one
    // (previously: propertyValuesHead/exprNext misread DkColumn's other
    // fields as exprs-arena data and crashed with an out-of-range index).
    src = ""
    ln(src, "app A {")
    ln(src, "    column \"name\" shows x width 10")
    ln(src, "}")
    runCase("app-column-item", src)

    // Case 37: an id containing a quote character -- printable ASCII, so
    // it would otherwise sail through checkAppId, but build-mac.sh
    // interpolates the id raw into Rez/CMake source and a quote breaks
    // that generated syntax with a confusing downstream error.
    src = ""
    ln(src, "app A {")
    ln(src, "    id: \"M'DL\"")
    ln(src, "}")
    runCase("app-id-quote", src)

    // Case 38: exprTypeOf pins the checker's resolved type for a known
    // expression's own arena index -- "a + b" (the RHS of c's assignment,
    // the third statement in f's body) -- so lower.cla's mustType can
    // later read it back via exprTypeGet. Reached by walking the parsed
    // AST directly (not via runCase, which only alerts diagnostics),
    // mirroring parse_test.cla's AST-walking convention.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var a: int")
    ln(src, "    var b: int")
    ln(src, "    var c: int")
    ln(src, "")
    ln(src, "    a = 1")
    ln(src, "    b = 2")
    ln(src, "    c = a + b")
    ln(src, "}")
    resetDiags()
    lexAll(src)
    body = parseFile()
    checkProgram(body)
    alert("=== exprtype-pin ===")
    if diags.count != 0 {
        alert("unexpected diagnostics")
    } else {
        body = funcDeclBody(body)
        s = blockStmtsHead(body)
        s = stmtNext(s)
        s = stmtNext(s)
        if exprTypeGet(assignRHS(s)) == IntT {
            alert("a + b : int")
        } else {
            alert("wrong type recorded")
        }
    }

    // ---- Task 2 (native-5a): the `ptr` type ----

    // Case 39: a clean program exercising ptr's whole surface -- var decl,
    // ptr+int/ptr-int, ptr comparisons (== and <), int(p) and ptr(0)
    // conversions, and a record with a ptr field (Ch13: record fields of
    // type ptr are allowed -- only containers reject it).
    src = ""
    ln(src, "record Rec {")
    ln(src, "    p: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var q: ptr")
    ln(src, "    var a: ptr")
    ln(src, "    var i: int")
    ln(src, "    var b: bool")
    ln(src, "")
    ln(src, "    p = ptr(4096)")
    ln(src, "    q = ptr(8192)")
    ln(src, "    a = p + 4")
    ln(src, "    a = p - 2")
    ln(src, "    b = p == q")
    ln(src, "    b = p < q")
    ln(src, "    i = int(p)")
    ln(src, "}")
    runCase("ptr-clean", src)

    // Case 40: ptr + ptr is not a valid operand pair (only ptr + int is).
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var q: ptr")
    ln(src, "    var r: ptr")
    ln(src, "")
    ln(src, "    p = ptr(0)")
    ln(src, "    q = ptr(0)")
    ln(src, "    r = p + q")
    ln(src, "}")
    runCase("ptr-plus-ptr", src)

    // Case 41: ptr + fixed is likewise invalid (only ptr + int).
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var r: ptr")
    ln(src, "")
    ln(src, "    p = ptr(0)")
    ln(src, "    r = p + 1.5")
    ln(src, "}")
    runCase("ptr-plus-fixed", src)

    // Case 42: ptr cannot be a container element.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var xs: list of ptr")
    ln(src, "}")
    runCase("ptr-container-element", src)

    // Case 43: ptr(x) only accepts an int argument.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "")
    ln(src, "    p = ptr(\"x\")")
    ln(src, "}")
    runCase("ptr-from-string", src)

    // ---- Task 3 (native-5a): `external func` decls ----

    // Case 44: a clean external func returning ptr, called and assigned to
    // a ptr local -- proves external decls check (and are callable) like
    // ordinary functions.
    src = ""
    ln(src, "external func NewHandle(size: int): ptr")
    ln(src, "func f() {")
    ln(src, "    var h: ptr")
    ln(src, "")
    ln(src, "    h = NewHandle(16)")
    ln(src, "}")
    runCase("extern-clean", src)

    // Case 45: external func params/return are restricted to int, ptr,
    // bool, or char -- string is rejected.
    src = ""
    ln(src, "external func F(s: string)")
    runCase("extern-bad-param-type", src)

    // Case 46: an external func has no body -- a stray `{` after the
    // signature is a top-level parse error, not a body.
    src = ""
    ln(src, "external func F(n: int) {")
    ln(src, "}")
    runCase("extern-body-not-allowed", src)

    // Case 47: a call to an external func checks arity exactly like a
    // call to an ordinary function (the generic checkArgsCall path).
    src = ""
    ln(src, "external func NewHandle(size: int): ptr")
    ln(src, "func f() {")
    ln(src, "    var h: ptr")
    ln(src, "")
    ln(src, "    h = NewHandle()")
    ln(src, "}")
    runCase("extern-wrong-arg-count", src)

    // ---- Task 4 (native-5a): peek/poke builtins ----

    // Case 48: peekb(p) assigned to an int -- clean.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var v: int")
    ln(src, "")
    ln(src, "    v = peekb(p)")
    ln(src, "}")
    runCase("peek-clean", src)

    // Case 49: peekb requires a ptr argument -- an int literal is rejected.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var v: int")
    ln(src, "")
    ln(src, "    v = peekb(5)")
    ln(src, "}")
    runCase("peek-bad-arg-type", src)

    // Case 50: pokew requires exactly two arguments.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "")
    ln(src, "    pokew(p)")
    ln(src, "}")
    runCase("poke-wrong-arg-count", src)

    // Case 51: pokeb's second argument must be int -- char is rejected.
    src = ""
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var c: char")
    ln(src, "")
    ln(src, "    pokeb(p, c)")
    ln(src, "}")
    runCase("poke-bad-arg-type", src)

    // ---- Task 1 (native-5b): `overlay record` declarations ----

    // Case 52: a clean program exercising overlay records' whole surface --
    // declaration, ptr->overlay and overlay->ptr conversions, field get/set,
    // and an overlay-vs-overlay equality comparison.
    src = ""
    ln(src, "overlay record RtHdr {")
    ln(src, "    rc: int")
    ln(src, "    data: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var p: ptr")
    ln(src, "    var h: RtHdr")
    ln(src, "    var n: int")
    ln(src, "    var same: bool")
    ln(src, "")
    ln(src, "    h = RtHdr(p)")
    ln(src, "    n = h.rc")
    ln(src, "    h.rc = 5")
    ln(src, "    h.data = p")
    ln(src, "    p = ptr(h)")
    ln(src, "    same = h == RtHdr(p)")
    ln(src, "}")
    runCase("overlay-clean", src)

    // Case 53: overlay field types are restricted to int/bool/char/fixed/
    // ptr -- string is rejected.
    src = ""
    ln(src, "overlay record Bad {")
    ln(src, "    s: string")
    ln(src, "}")
    runCase("overlay-bad-field-type", src)

    // Case 54: an overlay field may not have a default value.
    src = ""
    ln(src, "overlay record BadD {")
    ln(src, "    n: int = 3")
    ln(src, "}")
    runCase("overlay-field-default", src)

    // Case 55: an overlay record cannot be a container element.
    src = ""
    ln(src, "overlay record RtHdr {")
    ln(src, "    rc: int")
    ln(src, "    data: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var xs: list of RtHdr")
    ln(src, "}")
    runCase("overlay-container-element", src)

    // Case 56: there is no `new` for an overlay record -- it is only
    // obtained by converting an existing ptr.
    src = ""
    ln(src, "overlay record RtHdr {")
    ln(src, "    rc: int")
    ln(src, "    data: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var h: RtHdr")
    ln(src, "")
    ln(src, "    h = new RtHdr")
    ln(src, "}")
    runCase("overlay-new", src)

    // Case 57: selecting an undeclared field on an overlay record uses the
    // same "undefined: X" shape as an ordinary record.
    src = ""
    ln(src, "overlay record RtHdr {")
    ln(src, "    rc: int")
    ln(src, "    data: ptr")
    ln(src, "}")
    ln(src, "func f() {")
    ln(src, "    var h: RtHdr")
    ln(src, "    var n: int")
    ln(src, "")
    ln(src, "    n = h.nope")
    ln(src, "}")
    runCase("overlay-undefined-field", src)
}

// dblcompile_bake.cla: cross-compile leak-gate harness for the --rtbake
// path (runtime-ir-bake Task 4) -- the bake-path twin of dblcompile.cla
// (memory-leak-fix Task 1's own harness), same per-compile sequence
// (driveReset/resetDiags/astReset -> driveCompile -> driveEmit68kFork)
// repeated in ONE host process, once per entry, but with haveRtbake/
// rtbakeBytes set so every compile installs the SAME baked runtime image
// instead of splicing/checking/lowering runtime source. Proves the
// install path itself doesn't leak (0 block growth across repeats) and
// doesn't leave stale state a DIFFERENT entry's compile could observe
// (the alternating-fixture oracle internal/mactest/leakgate_test.go's
// DoubleCompile subtest already applies to dblcompile.cla).
//
// clir-load-perf Task 7 (design B) makes this the phase's PRIMARY
// behavioral proof, because it is the only host front end that drives
// driveCompile more than once in one process -- i.e. the only place
// outside ClarusC.APPL where the parse memo (bkParsedValid) and
// copy-on-install can be observed at all. Two things changed here:
//
//   - This harness now mirrors macgui.cla's real gcCompile sequence and
//     FREES rtbakeBytes once bkParsedValid holds. That is not decoration:
//     if compile #2 ever re-entered bkLoadRtbake it would parse an empty
//     buffer and fail loudly, so the free is itself the assertion that
//     the parse is memoized (Go-side (ii)).
//   - It logs a BAKESTATE line per compile carrying the design-B
//     observables the Go test asserts on: whether the parse was already
//     memoized when the compile started, the pending object-code staging
//     count (which must stay full-length and pristine forever now), this
//     compile's own bkRuntimeFuncBoundary, and the number of functions
//     cgObjPasteEligible actually accepts -- audit finding F1's own
//     regression assertion, since a paste that silently switches off
//     produces byte-IDENTICAL output and would otherwise go unnoticed.
//
// Usage: scripts/clarus-run.sh clarusc/test/dblcompile_bake.cla -- \
//            /path/to/rt68k.clir testdata/cg68k/tickprobe.cla ...

include "../lib.cla"
include "../tok.cla"
include "../lex.cla"
include "../ast.cla"
include "../parse.cla"
include "../types.cla"
include "../check.cla"
include "../ir.cla"
include "../lower.cla"
include "../shake.cla"
include "../asm68k.cla"
include "../peep68k.cla"
include "../app68k.cla"
include "../res68k.cla"
include "../cprint.cla"
include "../cg68k.cla"
include "../uiblob.cla"
include "../drive.cla"
include "../bake.cla"

// Front-end seam: same as main.cla's host CLI (disk reads, no resources).
func feReadSource(path: string, key: string, out: text): bool {
    return file.readText(path, out)
}

func feHasKey(key: string): bool {
    return false
}

func feProgress(line: string) {
    log(line)
}

func feProgressStep(cur: int, total: int, label: string) {
}

func feProgressTick() {
}

// feExpectedStamp (bake.cla's front-end seam, runtime-ir-bake Task 6):
// same as main.cla's host CLI (disk read + hash) -- this harness DOES
// set haveRtbake for real (below), so bkCheckRtbakeHeader's stamp check
// genuinely runs; must match whatever produced the bake file passed on
// argv, exactly like main.cla's own --rtbake consumer.
func feExpectedStamp(): int {
    var compilerSrc: text
    compilerSrc = ""
    if bkFindClarusC(compilerSrc) {
        return bkHashText(compilerSrc)
    }
    return 0
}

on App.startCLI(args: list of string) {
    var i: int
    var entries: list of string
    var ok: bool
    var built: bool
    var t0: int
    var t1: int
    var fork: text
    var wrote: bool
    var di: int
    var bakeBytes: text
    var parsedBefore: int
    var elig: int
    var f: int

    hostPaths = true
    rtDir = ""
    haveRtDir = false

    if args.count < 2 {
        log("usage: dblcompile_bake BAKE_FILE ENTRY...")
        quit 2
    }
    bakeBytes = ""
    if not file.readText(args[0], bakeBytes) {
        log("dblcompile_bake: cannot read bake file: " + args[0])
        quit 2
    }
    // Set once, kept for the whole process: rtbakeBytes doesn't change
    // between compiles (mirrors rtDir/haveRtDir's own "resolved once,
    // preserved across compiles" convention, drive.cla's driveReset doc
    // comment). Since clir-load-perf Task 7 the BYTES are parsed once
    // (bkParsedValid) and the buffer is released below, exactly as
    // macgui.cla does; every compile's own INSTALL still runs fresh,
    // copying the pending parse into the live arenas.
    rtbakeBytes = bakeBytes
    haveRtbake = true

    i = 1
    while i < args.count {
        t0 = TickCount()
        parsedBefore = 0
        if bkParsedValid {
            parsedBefore = 1
        }
        driveReset()
        resetDiags()
        astReset()
        wantEmit = true
        want68k = true
        entries = cgFreshStringList()
        entries.add(args[i])
        ok = driveCompile(entries, false)
        // macgui.cla's gcCompile does exactly this, in exactly this
        // position (clir-load-perf Task 7) -- see this file's own header
        // comment for why the free doubles as the memo assertion.
        if bkParsedValid {
            rtbakeBytes = ""
        }
        if entryFailed {
            log("dblcompile_bake: cannot open entry file: " + args[i])
            quit 2
        }
        if not ok {
            log("dblcompile_bake: compile FAILED: " + args[i])
            di = 0
            while di < diags.count {
                log(formatDiag(poolGet(diagPaths[di]), diags[di]))
                di = di + 1
            }
            quit 1
        }
        built = driveEmit68kFork("", false, 0, false)
        if not built {
            log("dblcompile_bake: emit68k failed: " + args[i])
            quit 1
        }
        fork = driveLastFork()
        wrote = file.writeText("leakfork_" + numToStr(i - 1) + ".bin", fork, fileTypeText, "????")
        if not wrote {
            log("dblcompile_bake: fork write failed")
            quit 1
        }
        t1 = TickCount()
        log("COMPILE " + numToStr(i - 1) + " " + args[i] + " ticks=" + numToStr(t1 - t0) + " fork=" + numToStr(fork.length))
        // Design-B observables (read AFTER driveEmit68kFork, so
        // bkRuntimeFuncBoundary/bkLdObjValid are exactly what this
        // compile's own codegen just consulted).
        elig = 0
        f = 0
        while f < bkRuntimeFuncBoundary {
            if cgObjPasteEligible(f) {
                elig = elig + 1
            }
            f = f + 1
        }
        log("BAKESTATE " + numToStr(i - 1) + " parsedBefore=" + numToStr(parsedBefore) + " objvalid=" + numToStr(bkLdObjValid.count) + " boundary=" + numToStr(bkRuntimeFuncBoundary) + " eligible=" + numToStr(elig))
        i = i + 1
    }
    quit 0
}

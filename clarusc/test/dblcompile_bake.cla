// dblcompile_bake.cla: cross-compile leak-gate harness for the --rtbake
// path (runtime-ir-bake Task 4) -- the bake-path twin of dblcompile.cla
// (memory-leak-fix Task 1's own harness), same per-compile sequence
// (driveReset/resetDiags/astReset -> driveCompile -> driveEmit68kFork)
// repeated in ONE host process, once per entry, but with haveRtbake/
// rtbakeBytes set so every compile installs the SAME baked runtime image
// instead of splicing/checking/lowering runtime source. Proves the
// install path itself doesn't leak (0 block growth across repeats) and
// doesn't leave stale state a DIFFERENT entry's compile could observe
// (the alternating-fixture oracle internal/mactest/leakgate_test.go's
// DoubleCompile subtest already applies to dblcompile.cla).
//
// clir-load-perf Task 7 made this the only host front end that drives
// driveCompile more than once in one process, i.e. the host stand-in for
// ClarusC.APPL's multi-compile session. SE wave 1 removed that phase's
// parse memo (bkParsedValid): driveCompile now CONSUMES rtbakeBytes (a
// successful parse frees it), so this harness -- like macgui.cla's
// gcResolveBakePath -- hands driveCompile a fresh copy of the bake
// bytes before EVERY compile. It logs a BAKESTATE line per compile:
// parsedBefore (always 0 now -- kept so the log shape is stable; the
// memo it used to observe no longer exists), the pending object-code
// staging count, this compile's own bkRuntimeFuncBoundary, and the
// number of functions cgObjPasteEligible actually accepts -- audit
// finding F1's own regression assertion, since a paste that silently
// switches off produces byte-IDENTICAL output and would otherwise go
// unnoticed.
//
// Usage: scripts/clarus-run.sh clarusc/test/dblcompile_bake.cla -- \
//            /path/to/rt68k.clir testdata/cg68k/tickprobe.cla ...

include "../lib.cla"
include "../tok.cla"
include "../lex.cla"
include "../ast.cla"
include "../parse.cla"
include "../types.cla"
include "../check.cla"
include "../ir.cla"
include "../lower.cla"
include "../shake.cla"
include "../asm68k.cla"
include "../peep68k.cla"
include "../app68k.cla"
include "../res68k.cla"
include "../cprint.cla"
include "../cg68k.cla"
include "../uiblob.cla"
include "../drive.cla"
include "../bake.cla"

// Front-end seam: same as main.cla's host CLI (disk reads, no resources).
func feReadSource(path: string, key: string, out: text): bool {
    return file.readText(path, out)
}

func feHasKey(key: string): bool {
    return false
}

func feProgress(line: string) {
    log(line)
}

func feProgressStep(cur: int, total: int, label: string) {
}

func feProgressTick() {
}

func feMemProbe(phase: string) {
}

// feExpectedStamp (bake.cla's front-end seam, runtime-ir-bake Task 6):
// same as main.cla's host CLI (disk read + hash) -- this harness DOES
// set haveRtbake for real (below), so bkCheckRtbakeHeader's stamp check
// genuinely runs; must match whatever produced the bake file passed on
// argv, exactly like main.cla's own --rtbake consumer.
func feExpectedStamp(): int {
    var compilerSrc: text
    compilerSrc = ""
    if bkFindClarusC(compilerSrc) {
        return bkHashText(compilerSrc)
    }
    return 0
}

on App.startCLI(args: list of string) {
    var i: int
    var entries: list of string
    var ok: bool
    var built: bool
    var t0: int
    var t1: int
    var fork: text
    var wrote: bool
    var di: int
    var bakeBytes: text
    var parsedBefore: int
    var elig: int
    var f: int
    var bakeLen: int

    hostPaths = true
    rtDir = ""
    haveRtDir = false

    if args.count < 2 {
        log("usage: dblcompile_bake BAKE_FILE ENTRY...")
        quit 2
    }
    bakeBytes = ""
    if not file.readText(args[0], bakeBytes) {
        log("dblcompile_bake: cannot read bake file: " + args[0])
        quit 2
    }
    bakeLen = bakeBytes.length
    i = 1
    while i < args.count {
        t0 = TickCount()
        parsedBefore = 0
        // SE wave 1: driveCompile frees rtbakeBytes after its parse, so
        // re-arm it every compile -- with a COPY: driveCompile's
        // rtbakeBytes.release() empties the box itself, so a shared
        // reference would empty bakeBytes for the next compile too.
        rtbakeBytes = bakeBytes.textAt(0, bakeBytes.length)
        haveRtbake = true
        driveReset()
        resetDiags()
        astReset()
        // SE wave 2: every second compile takes macgui.cla's shape
        // (gcResolveBakePath: the front end verifies the header itself,
        // then driveCompile parses under bkHeaderVerified), so the
        // progressive free (bkLoadSections' removeFirst on the shared
        // box) runs on both entry paths within one process.
        if (i & 1) == 0 {
            if not bkCheckRtbakeHeader(rtbakeBytes, bkLane68k) {
                log("dblcompile_bake: header refused (macgui shape): " + args[i])
                quit 1
            }
            resetDiags()
            bkHeaderVerified = true
        }
        wantEmit = true
        want68k = true
        entries = cgFreshStringList()
        entries.add(args[i])
        ok = driveCompile(entries, false)
        if entryFailed {
            log("dblcompile_bake: cannot open entry file: " + args[i])
            quit 2
        }
        if not ok {
            log("dblcompile_bake: compile FAILED: " + args[i])
            di = 0
            while di < diags.count {
                log(formatDiag(poolGet(diagPaths[di]), diags[di]))
                di = di + 1
            }
            quit 1
        }
        // SE wave 1 (spec L6): a successful bake-path compile consumed
        // the bytes.
        if rtbakeBytes.length != 0 {
            log("dblcompile_bake: rtbakeBytes still held after compile: " + args[i])
            quit 1
        }
        // SE wave 2: the parse's removeFirst consumed only the copy.
        if bakeBytes.length != bakeLen {
            log("dblcompile_bake: source bake bytes shrank to " + numToStr(bakeBytes.length) + " (want " + numToStr(bakeLen) + "): " + args[i])
            quit 1
        }
        built = driveEmit68kFork("", false, 0, false)
        if not built {
            log("dblcompile_bake: emit68k failed: " + args[i])
            quit 1
        }
        fork = driveLastFork()
        wrote = file.writeText("leakfork_" + numToStr(i - 1) + ".bin", fork, fileTypeText, "????")
        if not wrote {
            log("dblcompile_bake: fork write failed")
            quit 1
        }
        t1 = TickCount()
        log("COMPILE " + numToStr(i - 1) + " " + args[i] + " ticks=" + numToStr(t1 - t0) + " fork=" + numToStr(fork.length))
        // Design-B observables (read AFTER driveEmit68kFork, so
        // bkRuntimeFuncBoundary/bkLdObjValid are exactly what this
        // compile's own codegen just consulted).
        elig = 0
        f = 0
        while f < bkRuntimeFuncBoundary {
            if cgObjPasteEligible(f) {
                elig = elig + 1
            }
            f = f + 1
        }
        log("BAKESTATE " + numToStr(i - 1) + " parsedBefore=" + numToStr(parsedBefore) + " objvalid=" + numToStr(bkLdObjValid.count) + " boundary=" + numToStr(bkRuntimeFuncBoundary) + " eligible=" + numToStr(elig))
        i = i + 1
    }
    quit 0
}

// serial-connection phase, Task 5: a listen-mode-only variant of echo.cla.
//
// Controller ruling (task-5-report.md's fix-round writeup has the full
// text): `opened` firing at successful bind IS correct -- open success is
// transport-invisible, and a raw serial line has no peer-arrival signal
// either (carrier detect is out of scope this phase; the future MacTCP
// `listener.accepted(c)` is the real peer signal). The ORIGINAL defect
// this file's own history flagged was host-glue-only: `rt_ext_ConnHWrite`
// (runtime/host/rt_serial.inc) used to FAIL a write to a still-listening
// slot; it now mirrors an unattached real serial line instead (discard
// the bytes, report success) -- so `on conn.opened { conn.send(...) }` is
// safe again, exactly like echo.cla's own connect-mode fixture.
//
// The `on conn.opened` handler is restored below. Its "READY\n" greeting
// is sent (and, in listen mode, silently discarded) BEFORE any peer has
// connected -- by design, same as a real serial greeting sent down an
// unplugged cable. This fixture's own test (TestListenMode,
// conntest_test.go) deliberately does NOT assert on that discarded
// greeting; it dials AFTER the greeting has already gone out, then
// proves the discard was harmless -- the post-peer sweep still
// round-trips byte-exact.
var conn: connection

on App.startCLI(args: list of string) {
    conn.open(serial "modem:9600")
}

on conn.opened {
    conn.send("READY\n")
}

on conn.received(data: text) {
    var i: int = 0
    var quit3: int = 0
    conn.send(data)
    while i < data.length {
        if data[i] == 'Q' { quit3 = quit3 + 1 } else { quit3 = 0 }
        if quit3 == 3 { conn.close() }
        i = i + 1
    }
}

on conn.closed {
    log("peer gone")
}

on conn.failed(err: error) {
    log("failed: " + err.message)
    quit 1
}

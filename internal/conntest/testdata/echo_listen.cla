// serial-connection phase, Task 5: a listen-mode-only variant of echo.cla,
// deliberately WITHOUT an `on conn.opened` handler.
//
// Finding (recorded in task-5-report.md, "Concerns"): conn.cla's
// rtConnPump (Task 4, already landed -- not this task's file) fires
// `opened` for a `listen:` slot as soon as `rt_ext_ConnHOpen`'s bind+
// listen() succeeds, BEFORE any peer has been accepted -- `opened` does
// not mean "a peer is present" for listen mode, only "the socket is
// bound". echo.cla's own `on conn.opened { conn.send("READY\n") }`
// therefore always calls rtConnSendText against a still-listening (no
// peer, ConnHWrite's own `listening` guard) slot on the very FIRST pump
// pass, staging a "write failed" `failed` event that fires unconditionally
// on the NEXT pump pass regardless of whether a peer connects in between
// -- confirmed via direct measurement (an aggressive from-t=0 connect
// retry loop still lost) that this is a deterministic sequencing bug, not
// a race a faster/slower test dial could ever win. Fixing it needs a new
// lane-neutral "has a peer" query threaded through conn.cla + conn_c.cla
// + Task 6's not-yet-written conn_68k.cla -- a real interface change, out
// of this task's scope (lower.cla/cprint.cla only) and this task's Files
// list, so NOT fixed here.
//
// This fixture sidesteps the exact broken combination (no `on opened`
// handler at all -- lowSynthConnFireOpened's arm for this slot is a
// plain no-op, matching the brief's own "a slot with no handler for an
// event is a no-op" rule) while still exercising everything Task 5 IS
// responsible for on the listen: transport path: lowering, the host pump
// loop, byte-exact received/send round-tripping, and the close-driven
// lifetime rule.
var conn: connection

on App.startCLI(args: list of string) {
    conn.open(serial "modem:9600")
}

on conn.received(data: text) {
    var i: int = 0
    var quit3: int = 0
    conn.send(data)
    while i < data.length {
        if data[i] == 'Q' { quit3 = quit3 + 1 } else { quit3 = 0 }
        if quit3 == 3 { conn.close() }
        i = i + 1
    }
}

on conn.closed {
    log("peer gone")
}

on conn.failed(err: error) {
    log("failed: " + err.message)
    quit 1
}

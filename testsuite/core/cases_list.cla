// cases_list.cla: the core suite's list-family test cases (test-suite-
// review Task 9). Case -> source:
//   ListPushCountFirstLast <- emit_list.cla ("push/count/first/last ok")
//   ListReassignRelease    <- arc_fixwave_containers.cla ("list-reassign-ok")
//   ListGlobalAliasNested  <- arc_global_alias.cla ("nested-list-ok")
//   ListForLoopVarAlias    <- for_loop_var_alias.cla (task-5b regression:
//                              a for-loop element var name that ALIASES an
//                              outer `var` must not double-release; all
//                              three sibling shapes -- map-of-text,
//                              list-of-text, map-of-list-of-text -- ported
//                              as one aggregate pass/fail, same shape as
//                              the source fixture's own `pass` flag)
//
// ClearBasics (layer1-compiler-perf phase, Task 8) is new -- proves
// `.clear()` (count -> 0, capacity retained, re-add works) across all
// four container families in one case: list, map, intmap, sortedmap.
//
// ReleaseShrink (SE wave 1, Task 1) is new -- proves `.release()` and
// `.shrink()` across list/map/intmap/sortedmap/text (see its own comment).
//
// ReserveRemoveFirst (SE wave 2, Task 1) is new -- proves list
// `.reserve(n)` and text `.removeFirst(n)` (see its own comment).

func caseListPushCountFirstLast(): TestResult {
    var l: list of int

    l.push(10)
    l.push(20)
    l.push(30)
    if l.count != 3 {
        return tkFail("ListPushCountFirstLast", "count wrong")
    }
    if l.first() != 10 {
        return tkFail("ListPushCountFirstLast", "first wrong")
    }
    if l.last() != 30 {
        return tkFail("ListPushCountFirstLast", "last wrong")
    }
    return tkPass("ListPushCountFirstLast")
}

func caseListReassignMakeList(): list of text {
    var l: list of text
    l.push("fresh")
    return l
}

func caseListReassignRelease(): TestResult {
    var a: list of text

    a.push("old1")
    a.push("old2")
    a = caseListReassignMakeList()
    if a.count != 1 {
        return tkFail("ListReassignRelease", "reassigned count wrong")
    }
    if a.first() != "fresh" {
        return tkFail("ListReassignRelease", "reassigned content wrong")
    }
    return tkPass("ListReassignRelease")
}

func caseListGlobalAliasNested(): TestResult {
    var inner: list of text
    var outer: list of list of text

    inner.add("nested")
    outer.add(inner)
    if outer.count != 1 {
        return tkFail("ListGlobalAliasNested", "outer count wrong")
    }
    if outer[0].count != 1 {
        return tkFail("ListGlobalAliasNested", "inner count wrong")
    }
    if outer[0][0] != "nested" {
        return tkFail("ListGlobalAliasNested", "inner content wrong")
    }
    return tkPass("ListGlobalAliasNested")
}

func caseListForLoopVarAlias(): TestResult {
    var m1: map of text
    var k1: string
    var v1: text
    var found1: text
    var l2: list of text
    var x2: text
    var found2: text
    var m3: map of list of text
    var k3: string
    var v3: list of text
    var l3a: list of text
    var l3b: list of text
    var found3: list of text
    var found3Total: int

    m1["a"] = "apple"
    m1["b"] = "banana"
    m1["a"] = "avocado"
    m1.remove("b")
    for k1, v1 in m1 {
        found1 = v1
    }
    if found1 != "avocado" {
        return tkFail("ListForLoopVarAlias", "map-of-text shape wrong")
    }

    l2.add("alpha")
    l2.add("beta")
    for x2 in l2 {
        found2 = x2
    }
    if found2 != "beta" {
        return tkFail("ListForLoopVarAlias", "list-of-text shape wrong")
    }

    l3a.add("one")
    l3b.add("two")
    l3b.add("three")
    m3["a"] = l3a
    m3["b"] = l3b
    // `map of T`'s iteration order is unspecified, so this can't rely on
    // "last iteration is b" (last-write-wins into found3) -- sum v3.count
    // across all iterations instead, order-agnostic (l3a=1 + l3b=2 = 3).
    found3Total = 0
    for k3, v3 in m3 {
        found3 = v3
        found3Total = found3Total + v3.count
    }
    if found3Total != 3 {
        return tkFail("ListForLoopVarAlias", "nested-container shape wrong")
    }

    return tkPass("ListForLoopVarAlias")
}

func caseClearBasics(): TestResult {
    var l: list of int
    var m: map of int
    var im: intmap of int
    var sm: sortedmap of int

    l.push(1)
    l.push(2)
    l.clear()
    if l.count != 0 {
        return tkFail("ClearBasics", "list count wrong")
    }
    l.push(3)
    if l.count != 1 {
        return tkFail("ClearBasics", "list re-add count wrong")
    }
    if l.first() != 3 {
        return tkFail("ClearBasics", "list re-add content wrong")
    }

    m["a"] = 1
    m["b"] = 2
    m.clear()
    if m.count != 0 {
        return tkFail("ClearBasics", "map count wrong")
    }
    if m.has("a") {
        return tkFail("ClearBasics", "map has wrong")
    }
    m["c"] = 3
    if m.count != 1 or m.get("c", -1) != 3 {
        return tkFail("ClearBasics", "map re-add wrong")
    }

    im[1] = 10
    im[2] = 20
    im.clear()
    if im.count != 0 {
        return tkFail("ClearBasics", "intmap count wrong")
    }
    if im.has(1) {
        return tkFail("ClearBasics", "intmap has wrong")
    }
    im[3] = 30
    if im.count != 1 or im.get(3, -1) != 30 {
        return tkFail("ClearBasics", "intmap re-add wrong")
    }

    sm["x"] = 1
    sm["y"] = 2
    sm.clear()
    if sm.count != 0 {
        return tkFail("ClearBasics", "sortedmap count wrong")
    }
    if sm.has("x") {
        return tkFail("ClearBasics", "sortedmap has wrong")
    }
    sm["z"] = 9
    if sm.count != 1 or sm.get("z", -1) != 9 {
        return tkFail("ClearBasics", "sortedmap re-add wrong")
    }

    return tkPass("ClearBasics")
}

// ReleaseShrink (SE wave 1, Task 1): `.release()` drops a container's
// storage (count 0, then usable again; aliases see it, since containers
// are shared by reference) and `.shrink()` trims capacity while keeping
// contents and order -- list, map, intmap, sortedmap and text, plus the
// element-bearing release paths (list of string, map of records).
record caseRsItem {
    name: text
    n: int
}

func caseReleaseShrink(): TestResult {
    var l: list of int
    var b: list of int
    var ls: list of string
    var m: map of int
    var im: intmap of int
    var sm: sortedmap of int
    var mr: map of caseRsItem
    var item: caseRsItem
    var t: text
    var i: int
    var before: string
    var after: string

    // list: release empties, stays usable
    i = 0
    while i < 100 {
        l.push(i)
        i = i + 1
    }
    l.release()
    if l.count != 0 {
        return tkFail("ReleaseShrink", "list release count")
    }
    l.push(7)
    if l.count != 1 or l.first() != 7 {
        return tkFail("ReleaseShrink", "list reuse after release")
    }

    // aliasing: release through one name is seen through the other
    b = l
    l.release()
    if b.count != 0 {
        return tkFail("ReleaseShrink", "alias did not see release")
    }
    b.push(9)
    if l.count != 1 or l.first() != 9 {
        return tkFail("ReleaseShrink", "alias reuse after release")
    }

    // shrink keeps contents
    i = 0
    while i < 50 {
        l.push(i)
        i = i + 1
    }
    l.shrink()
    if l.count != 51 or l.first() != 9 {
        return tkFail("ReleaseShrink", "list shrink contents")
    }
    l.push(99)
    if l.count != 52 {
        return tkFail("ReleaseShrink", "list push after shrink")
    }

    // element-bearing list
    ls.push("alpha")
    ls.push("beta")
    ls.release()
    if ls.count != 0 {
        return tkFail("ReleaseShrink", "list of string release")
    }
    ls.push("gamma")
    if ls.first() != "gamma" {
        return tkFail("ReleaseShrink", "list of string reuse")
    }

    // map: delete, shrink, every survivor still found, order kept
    m["a"] = 1
    m["b"] = 2
    m["c"] = 3
    m["d"] = 4
    m.remove("b")
    for k, v in m {
        before = before + k
    }
    m.shrink()
    for k, v in m {
        after = after + k
    }
    if before != after {
        return tkFail("ReleaseShrink", "map shrink order")
    }
    if m.count != 3 or m.get("a", -1) != 1 or m.get("c", -1) != 3 or m.get("d", -1) != 4 or m.has("b") {
        return tkFail("ReleaseShrink", "map shrink lookups")
    }
    m.release()
    if m.count != 0 or m.has("a") {
        return tkFail("ReleaseShrink", "map release")
    }
    m["z"] = 26
    if m.get("z", -1) != 26 {
        return tkFail("ReleaseShrink", "map reuse after release")
    }

    // remove first, so shrink compacts past a hole (4-byte-stride keys)
    im[1] = 10
    im[2] = 20
    im[3] = 30
    im[4] = 40
    im.remove(2)
    im.shrink()
    if im.count != 3 or im.get(1, -1) != 10 or im.get(3, -1) != 30 or im.get(4, -1) != 40 or im.has(2) {
        return tkFail("ReleaseShrink", "intmap shrink")
    }
    im.release()
    if im.count != 0 or im.has(1) {
        return tkFail("ReleaseShrink", "intmap release")
    }
    im[5] = 50
    if im.get(5, -1) != 50 {
        return tkFail("ReleaseShrink", "intmap reuse")
    }

    sm["y"] = 2
    sm["x"] = 1
    sm.shrink()
    if sm.get("x", -1) != 1 or sm.get("y", -1) != 2 {
        return tkFail("ReleaseShrink", "sortedmap shrink")
    }
    sm.release()
    if sm.count != 0 or sm.has("x") {
        return tkFail("ReleaseShrink", "sortedmap release")
    }
    sm["w"] = 3
    if sm.get("w", -1) != 3 {
        return tkFail("ReleaseShrink", "sortedmap reuse")
    }

    // element-bearing map: records owning a text field
    item.name = "first"
    item.n = 1
    mr["p"] = item
    item.name = "second"
    item.n = 2
    mr["q"] = item
    mr.release()
    if mr.count != 0 or mr.has("p") {
        return tkFail("ReleaseShrink", "map of records release")
    }
    item.name = "third"
    item.n = 3
    mr["r"] = item
    if mr.count != 1 or not mr.has("r") {
        return tkFail("ReleaseShrink", "map of records reuse")
    }

    // text
    t.append("hello world")
    t.shrink()
    if t.length != 11 {
        return tkFail("ReleaseShrink", "text shrink length")
    }
    t.release()
    if t.length != 0 {
        return tkFail("ReleaseShrink", "text release")
    }
    t.append("again")
    if t.length != 5 {
        return tkFail("ReleaseShrink", "text reuse")
    }
    return tkPass("ReleaseShrink")
}

// ReserveRemoveFirst (SE wave 2, Task 1): list `.reserve(n)` keeps count
// and contents, later pushes still work, a smaller/zero/negative n is a
// no-op, and an alias sees it (same box); text `.removeFirst(n)` at 0, in
// the middle, at len and past len (clamped), seen through an alias, then
// append/reuse after it.
func caseReserveRemoveFirst(): TestResult {
    var l: list of int
    var b: list of int
    var t: text
    var u: text
    var i: int

    // reserve: contents unchanged, pushes still work, smaller n is a no-op
    l.push(1)
    l.push(2)
    l.reserve(100)
    if l.count != 2 or l.first() != 1 {
        return tkFail("ReserveRemoveFirst", "reserve changed contents")
    }
    i = 0
    while i < 98 {
        l.push(i)
        i = i + 1
    }
    if l.count != 100 {
        return tkFail("ReserveRemoveFirst", "push after reserve")
    }
    l.reserve(5)
    l.reserve(0)
    l.reserve(-3)
    if l.count != 100 or l.first() != 1 {
        return tkFail("ReserveRemoveFirst", "small reserve not a no-op")
    }
    // alias sees reserve (same box)
    b = l
    b.reserve(500)
    b.push(7)
    if l.count != 101 {
        return tkFail("ReserveRemoveFirst", "alias after reserve")
    }

    // removeFirst: 0, middle, all, past the end
    t.append("hello world")
    t.removeFirst(0)
    if t.length != 11 {
        return tkFail("ReserveRemoveFirst", "removeFirst(0)")
    }
    t.removeFirst(6)
    if t.length != 5 or t[0] != 'w' or t[4] != 'd' {
        return tkFail("ReserveRemoveFirst", "removeFirst middle")
    }
    u = t
    u.removeFirst(2)
    if t.length != 3 or t[0] != 'r' {
        return tkFail("ReserveRemoveFirst", "alias did not see removeFirst")
    }
    t.append("XY")
    if t.length != 5 or t[3] != 'X' {
        return tkFail("ReserveRemoveFirst", "append after removeFirst")
    }
    t.removeFirst(5)
    if t.length != 0 {
        return tkFail("ReserveRemoveFirst", "removeFirst all")
    }
    t.append("abc")
    t.removeFirst(99)
    if t.length != 0 {
        return tkFail("ReserveRemoveFirst", "removeFirst past end")
    }
    t.append("z")
    if t.length != 1 or t[0] != 'z' {
        return tkFail("ReserveRemoveFirst", "reuse after removeFirst")
    }
    return tkPass("ReserveRemoveFirst")
}

// cases_str.cla: the core suite's string-family test cases
// (test-suite-review Task 8 seed; Task 9 adds the rest of the string
// family alongside every other family). Each case's check body is
// lifted verbatim from its testdata/run/lib source (same condition, same
// values), only the reporting is different: the original alert()s
// "... ok" / "... FAIL" pairs, these return a TestResult.
//
// Task 9 additions: StrCompare (testdata/run/lib/strings.cla's concat +
// index-write + lexicographic compare) and ErrVarIsolation
// (testdata/run/lib/errvar.cla's ordinary-error-var-untouched-by-
// truncation check, the errvar.cla sibling of caseStrConcatClamp's
// emit_record.cla version of the same lastError shape).

// caseStrConcatClamp is testdata/run/lib/emit_record.cla's "lastError
// code/message after truncation" check: a string+string concat result
// wider than the target's string(3) capacity clamps on store and sets
// lastError (language reference Ch4, "String Concatenation and
// Truncation").
func caseStrConcatClamp(): TestResult {
    var cap3: string(3)
    var detail: string

    cap3 = "ab" + "cdef" // overflows string(3)'s capacity -> sets lastError

    if cap3 != "abc" {
        detail = "store = " + cap3 + ", want abc"
        return tkFail("StrConcatClamp", detail)
    }
    if lastError.code != 1 {
        detail = "lastError.code = " + tkIntToStr(lastError.code) + ", want 1"
        return tkFail("StrConcatClamp", detail)
    }
    if lastError.message != "string truncated" {
        detail = "lastError.message = " + lastError.message + ", want string truncated"
        return tkFail("StrConcatClamp", detail)
    }
    return tkPass("StrConcatClamp")
}

// caseStrIndexing is testdata/run/lib/emit_strings.cla's "index
// read/set" check: s[i] write, then read back via comparison.
func caseStrIndexing(): TestResult {
    var c: string = "hello world"

    c[0] = 'H'
    if c[0] != 'H' {
        return tkFail("StrIndexing", "c[0] wrong after write")
    }
    return tkPass("StrIndexing")
}

// caseStrCompare is testdata/run/lib/strings.cla's "matches" / "a < b"
// checks: str+str concat, index-write, full-string equality, and a
// lexicographic comparison branch.
func caseStrCompare(): TestResult {
    var a: string = "hello"
    var b: string = " world"
    var c: string
    var detail: string

    c = a + b
    c[0] = 'H'
    if c != "Hello world" {
        detail = "c = " + c + ", want Hello world"
        return tkFail("StrCompare", detail)
    }
    if a < b {
        return tkFail("StrCompare", "a < b unexpectedly true")
    }
    return tkPass("StrCompare")
}

// caseErrVarIsolation is testdata/run/lib/errvar.cla's check: an ordinary
// `error` local stays untouched by a capacity-overflow store that sets
// only the GLOBAL lastError (the errvar.cla sibling of
// caseStrConcatClamp's emit_record.cla version of this shape).
func caseErrVarIsolation(): TestResult {
    var e: error
    var g: string(3)
    var detail: string

    g = "ab" + "cdef" // overflows g's capacity -> sets the GLOBAL lastError only

    if e.code != 0 {
        detail = "ordinary error var e.code = " + tkIntToStr(e.code) + ", want 0"
        return tkFail("ErrVarIsolation", detail)
    }
    if lastError.code != 1 {
        detail = "lastError.code = " + tkIntToStr(lastError.code) + ", want 1"
        return tkFail("ErrVarIsolation", detail)
    }
    return tkPass("ErrVarIsolation")
}

// caseStrPerf (string-perf phase, 2026-09-02): pins the phase's
// observable semantics. (1) A string local read before any assignment
// is the empty string -- the same zero value the pre-phase
// full-capacity zero-init produced, now guaranteed by the length-byte-
// only default-init (cgDefaultInitStrLenOnlyAt, cg68k.cla). (2) The
// inline s[i]/s.length codegen (cgIntrStrIndexInline/cgIntrStrLenInline)
// produces the same values the out-of-line rtStrIndex/rtStrLen path
// did, across a loop. (3) text.clear() resets length and the buffer
// appends again correctly. (4) text.reserve(n) is semantically
// invisible (capacity-only). The out-of-range s[i] panic path is NOT
// pinned here: rtPanic is terminal (not attempt-catchable), and the
// inline codegen delegates its cold path to the unchanged rtStrIndex,
// whose panic behavior is unchanged by the phase.
func caseStrPerf(): TestResult {
    var probe: string
    var s: string
    var t: text
    var acc: int
    var i: int

    if probe != "" {
        return tkFail("StrPerf", "unassigned string local not empty")
    }
    if probe.length != 0 {
        return tkFail("StrPerf", "unassigned local length " + tkIntToStr(probe.length))
    }
    s = "AZaz"
    acc = 0
    i = 0
    while i < s.length {
        acc = acc + int(s[i])
        i = i + 1
    }
    if acc != 374 {
        return tkFail("StrPerf", "s[i] sum " + tkIntToStr(acc) + ", want 374")
    }
    t = "hello"
    t.clear()
    if t.length != 0 {
        return tkFail("StrPerf", "clear left length " + tkIntToStr(t.length))
    }
    t.append("abc")
    if t != "abc" {
        return tkFail("StrPerf", "append after clear mismatch")
    }
    t.reserve(1)
    t.reserve(2000)
    t.append('d')
    if t != "abcd" {
        return tkFail("StrPerf", "append after reserve mismatch")
    }
    return tkPass("StrPerf")
}

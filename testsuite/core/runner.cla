// runner.cla: the core suite's enum, dispatch, and self-check
// (test-suite-review Task 8, grown to full parity by Task 9). Task 8
// seeded two real string cases (StrConcatClamp, StrIndexing); Task 9 adds
// the remaining 37 -- one per testdata/run/lib fixture that carries a real
// self-verifying `if` check (per the migration table in
// .superpowers/sdd/2026-08-03-test-suite-review/task-9-report.md), for 39
// real cases total, grouped by family into cases_str.cla, cases_text.cla,
// cases_list.cla, cases_map.cla, cases_rec.cla, cases_arr.cla,
// cases_enumfix.cla, cases_ser.cla, and cases_misc.cla. This file's shape
// (All first, dedupe + All-collapse, wantAll + per-case branches, SelfCheck
// last) does not change.
//
// XRecFieldsRoundtrip (cases_xrec.cla, task-6-review Important 3) is the
// 40th real case: extern-record bool-field (CvIntNonZero) and str[N]-
// field native runtime proof, added here rather than to the toolbox suite
// because it needs no real Toolbox trap (peek/poke and the address-of-my-
// own-argument `XRecAddr` decay are trap-free), so it rides the existing
// core boots for free.

enum CoreTest {
    All
    StrConcatClamp
    StrIndexing
    StrCompare
    ErrVarIsolation
    TextAppendStr
    TextWidenAssignability
    TextRealiasLocal
    TextSlicesIndexOfMiss
    TextAssignCompare
    TextAppendPerf
    ListPushCountFirstLast
    ListReassignRelease
    ListGlobalAliasNested
    ListForLoopVarAlias
    MapSetCount
    MapHasRemove
    MapOfListUpsert
    RecCopyIndependence
    RecFieldGlobalAlias
    ArrHolderElementStore
    EnumIntRoundTrip
    EnumSaveChoiceValue
    FixedMathOps
    ConstCaseLabel
    SwitchIntRange
    SwitchIntMultiLabel
    SerBinRoundtrip
    SerFileRoundtrip
    SerFileNameRoundtrip
    SerMixedScalarRec
    MiscArithBasic
    MiscBreakContWhile
    MiscCrc8Smbus
    MiscEmitArithAddMul
    MiscEmitControlForRange
    MiscEmitFuncRecursion
    MiscMutRecEvenOdd
    MiscWhileCondText
    MiscWideProtoSumBoxMetrics
    MiscLongCondChain
    XRecFieldsRoundtrip
    SelfCheck
}

// nCoreCases is CoreTest's member count minus All: the 41 real cases plus
// SelfCheck itself. SelfCheck's own branch does not increment casesRun for
// itself (it is checking that the OTHER branches ran) -- so on a clean
// run, casesRun has reached nCoreCases - 1 by the time SelfCheck's own
// check runs. A forgotten branch leaves casesRun short and SelfCheck
// fails, instead of the suite silently shrinking.
const nCoreCases: int = 42

// coreCaseName maps a CoreTest member to its programmatic name, used
// both for CLI arg matching (cli.cla) and as a TestResult's name.
func coreCaseName(t: CoreTest): string {
    switch t {
    case All {
        return "All"
    }
    case StrConcatClamp {
        return "StrConcatClamp"
    }
    case StrIndexing {
        return "StrIndexing"
    }
    case StrCompare {
        return "StrCompare"
    }
    case ErrVarIsolation {
        return "ErrVarIsolation"
    }
    case TextAppendStr {
        return "TextAppendStr"
    }
    case TextWidenAssignability {
        return "TextWidenAssignability"
    }
    case TextRealiasLocal {
        return "TextRealiasLocal"
    }
    case TextSlicesIndexOfMiss {
        return "TextSlicesIndexOfMiss"
    }
    case TextAssignCompare {
        return "TextAssignCompare"
    }
    case TextAppendPerf {
        return "TextAppendPerf"
    }
    case ListPushCountFirstLast {
        return "ListPushCountFirstLast"
    }
    case ListReassignRelease {
        return "ListReassignRelease"
    }
    case ListGlobalAliasNested {
        return "ListGlobalAliasNested"
    }
    case ListForLoopVarAlias {
        return "ListForLoopVarAlias"
    }
    case MapSetCount {
        return "MapSetCount"
    }
    case MapHasRemove {
        return "MapHasRemove"
    }
    case MapOfListUpsert {
        return "MapOfListUpsert"
    }
    case RecCopyIndependence {
        return "RecCopyIndependence"
    }
    case RecFieldGlobalAlias {
        return "RecFieldGlobalAlias"
    }
    case ArrHolderElementStore {
        return "ArrHolderElementStore"
    }
    case EnumIntRoundTrip {
        return "EnumIntRoundTrip"
    }
    case EnumSaveChoiceValue {
        return "EnumSaveChoiceValue"
    }
    case FixedMathOps {
        return "FixedMathOps"
    }
    case ConstCaseLabel {
        return "ConstCaseLabel"
    }
    case SwitchIntRange {
        return "SwitchIntRange"
    }
    case SwitchIntMultiLabel {
        return "SwitchIntMultiLabel"
    }
    case SerBinRoundtrip {
        return "SerBinRoundtrip"
    }
    case SerFileRoundtrip {
        return "SerFileRoundtrip"
    }
    case SerFileNameRoundtrip {
        return "SerFileNameRoundtrip"
    }
    case SerMixedScalarRec {
        return "SerMixedScalarRec"
    }
    case MiscArithBasic {
        return "MiscArithBasic"
    }
    case MiscBreakContWhile {
        return "MiscBreakContWhile"
    }
    case MiscCrc8Smbus {
        return "MiscCrc8Smbus"
    }
    case MiscEmitArithAddMul {
        return "MiscEmitArithAddMul"
    }
    case MiscEmitControlForRange {
        return "MiscEmitControlForRange"
    }
    case MiscEmitFuncRecursion {
        return "MiscEmitFuncRecursion"
    }
    case MiscMutRecEvenOdd {
        return "MiscMutRecEvenOdd"
    }
    case MiscWhileCondText {
        return "MiscWhileCondText"
    }
    case MiscWideProtoSumBoxMetrics {
        return "MiscWideProtoSumBoxMetrics"
    }
    case MiscLongCondChain {
        return "MiscLongCondChain"
    }
    case XRecFieldsRoundtrip {
        return "XRecFieldsRoundtrip"
    }
    case SelfCheck {
        return "SelfCheck"
    }
    }
    return "?"
}

// coreAllCases lists every real case (All excluded -- it's the "run
// everything" keyword, handled separately by its caller; SelfCheck IS
// included, so it stays addressable by name through this list same as
// every other case -- see :250). Used by
// cli.cla's arg parser: a `for t in coreAllCases() { if a ==
// coreCaseName(t) ... }` loop, one small comparison per iteration,
// instead of one giant 40-branch if/else-if chain -- native 68k codegen
// (cg68k) has a per-statement string/record temp-slot budget that a
// single chain that long exceeds ("too many str/rec temps needed in one
// statement"); a loop's per-iteration temps don't accumulate the same
// way.
func coreAllCases(): list of CoreTest {
    var l: list of CoreTest
    l.add(StrConcatClamp)
    l.add(StrIndexing)
    l.add(StrCompare)
    l.add(ErrVarIsolation)
    l.add(TextAppendStr)
    l.add(TextWidenAssignability)
    l.add(TextRealiasLocal)
    l.add(TextSlicesIndexOfMiss)
    l.add(TextAssignCompare)
    l.add(TextAppendPerf)
    l.add(ListPushCountFirstLast)
    l.add(ListReassignRelease)
    l.add(ListGlobalAliasNested)
    l.add(ListForLoopVarAlias)
    l.add(MapSetCount)
    l.add(MapHasRemove)
    l.add(MapOfListUpsert)
    l.add(RecCopyIndependence)
    l.add(RecFieldGlobalAlias)
    l.add(ArrHolderElementStore)
    l.add(EnumIntRoundTrip)
    l.add(EnumSaveChoiceValue)
    l.add(FixedMathOps)
    l.add(ConstCaseLabel)
    l.add(SwitchIntRange)
    l.add(SwitchIntMultiLabel)
    l.add(SerBinRoundtrip)
    l.add(SerFileRoundtrip)
    l.add(SerFileNameRoundtrip)
    l.add(SerMixedScalarRec)
    l.add(MiscArithBasic)
    l.add(MiscBreakContWhile)
    l.add(MiscCrc8Smbus)
    l.add(MiscEmitArithAddMul)
    l.add(MiscEmitControlForRange)
    l.add(MiscEmitFuncRecursion)
    l.add(MiscMutRecEvenOdd)
    l.add(MiscWhileCondText)
    l.add(MiscWideProtoSumBoxMetrics)
    l.add(MiscLongCondChain)
    l.add(XRecFieldsRoundtrip)
    l.add(SelfCheck)
    return l
}

// coreHas reports whether l contains want.
func coreHas(l: list of CoreTest, want: CoreTest): bool {
    var t: CoreTest
    for t in l {
        if t == want {
            return true
        }
    }
    return false
}

// runCoreTests dedupes sel (order-preserving, nested-loop membership
// test), then runs every selected case's branch. If the deduped
// selection contains All, every case runs (the "collapse to [All]" rule
// -- expressed here as a wantAll flag rather than literally truncating
// the list, since nothing downstream inspects the deduped list itself,
// only case membership). Branch shape is `wantAll or coreHas(deduped,
// CoreTest.X)` per the runner contract. The last result is always
// SelfCheck's own meta-case.
func runCoreTests(sel: list of CoreTest): list of TestResult {
    var deduped: list of CoreTest
    var t: CoreTest
    var results: list of TestResult
    var wantAll: bool
    var casesRun: int = 0
    var selfDetail: string

    for t in sel {
        if not coreHas(deduped, t) {
            deduped.add(t)
        }
    }
    wantAll = coreHas(deduped, All)

    if wantAll or coreHas(deduped, StrConcatClamp) {
        results.add(caseStrConcatClamp())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, StrIndexing) {
        results.add(caseStrIndexing())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, StrCompare) {
        results.add(caseStrCompare())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, ErrVarIsolation) {
        results.add(caseErrVarIsolation())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, TextAppendStr) {
        results.add(caseTextAppendStr())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, TextWidenAssignability) {
        results.add(caseTextWidenAssignability())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, TextRealiasLocal) {
        results.add(caseTextRealiasLocal())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, TextSlicesIndexOfMiss) {
        results.add(caseTextSlicesIndexOfMiss())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, TextAssignCompare) {
        results.add(caseTextAssignCompare())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, TextAppendPerf) {
        results.add(caseTextAppendPerf())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, ListPushCountFirstLast) {
        results.add(caseListPushCountFirstLast())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, ListReassignRelease) {
        results.add(caseListReassignRelease())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, ListGlobalAliasNested) {
        results.add(caseListGlobalAliasNested())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, ListForLoopVarAlias) {
        results.add(caseListForLoopVarAlias())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MapSetCount) {
        results.add(caseMapSetCount())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MapHasRemove) {
        results.add(caseMapHasRemove())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MapOfListUpsert) {
        results.add(caseMapOfListUpsert())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, RecCopyIndependence) {
        results.add(caseRecCopyIndependence())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, RecFieldGlobalAlias) {
        results.add(caseRecFieldGlobalAlias())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, ArrHolderElementStore) {
        results.add(caseArrHolderElementStore())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, EnumIntRoundTrip) {
        results.add(caseEnumIntRoundTrip())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, EnumSaveChoiceValue) {
        results.add(caseEnumSaveChoiceValue())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, FixedMathOps) {
        results.add(caseFixedMathOps())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, ConstCaseLabel) {
        results.add(caseConstCaseLabel())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, SwitchIntRange) {
        results.add(caseSwitchIntRange())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, SwitchIntMultiLabel) {
        results.add(caseSwitchIntMultiLabel())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, SerBinRoundtrip) {
        results.add(caseSerBinRoundtrip())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, SerFileRoundtrip) {
        results.add(caseSerFileRoundtrip())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, SerFileNameRoundtrip) {
        results.add(caseSerFileNameRoundtrip())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, SerMixedScalarRec) {
        results.add(caseSerMixedScalarRec())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MiscArithBasic) {
        results.add(caseMiscArithBasic())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MiscBreakContWhile) {
        results.add(caseMiscBreakContWhile())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MiscCrc8Smbus) {
        results.add(caseMiscCrc8Smbus())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MiscEmitArithAddMul) {
        results.add(caseMiscEmitArithAddMul())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MiscEmitControlForRange) {
        results.add(caseMiscEmitControlForRange())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MiscEmitFuncRecursion) {
        results.add(caseMiscEmitFuncRecursion())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MiscMutRecEvenOdd) {
        results.add(caseMiscMutRecEvenOdd())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MiscWhileCondText) {
        results.add(caseMiscWhileCondText())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MiscWideProtoSumBoxMetrics) {
        results.add(caseMiscWideProtoSumBoxMetrics())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, MiscLongCondChain) {
        results.add(caseMiscLongCondChain())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, XRecFieldsRoundtrip) {
        results.add(caseXRecFieldsRoundtrip())
        casesRun = casesRun + 1
    }
    if wantAll or coreHas(deduped, SelfCheck) {
        if casesRun == nCoreCases - 1 {
            results.add(tkPass(coreCaseName(SelfCheck)))
        } else {
            selfDetail = "casesRun " + tkIntToStr(casesRun) + " != " + tkIntToStr(nCoreCases - 1)
            results.add(tkFail(coreCaseName(SelfCheck), selfDetail))
        }
    }

    return results
}

// coreCliRunAndReport runs sel through runCoreTests, prints the PASS/
// FAIL/TOTAL log via tkReport, and quits 1 on any fail -- the shared tail
// every front-end (testsuite/core/cli.cla's host `App.startCLI`,
// testsuite/core/cli_mac.cla's native/Mac `App.launch`) funnels into.
// Lives here, not in a front-end file, so it's usable by both without
// either front-end file including the other.
func coreCliRunAndReport(sel: list of CoreTest, results: list of TestResult) {
    var coreResults: list of TestResult
    var r: TestResult
    var fails: int

    coreResults = runCoreTests(sel)
    for r in coreResults {
        results.add(r)
    }

    fails = tkReport(results)
    if fails > 0 {
        quit 1
    }
}

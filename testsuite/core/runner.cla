// runner.cla: the core suite's enum, dispatch, and self-check
// (test-suite-review Task 8, grown to full parity by Task 9). Task 8
// seeded two real string cases (StrConcatClamp, StrIndexing); Task 9 adds
// the remaining 37 -- one per testdata/run/lib fixture that carries a real
// self-verifying `if` check (per the migration table in
// .superpowers/sdd/2026-08-03-test-suite-review/task-9-report.md), for 39
// real cases total, grouped by family into cases_str.cla, cases_text.cla,
// cases_list.cla, cases_map.cla, cases_rec.cla, cases_arr.cla,
// cases_enumfix.cla, cases_ser.cla, and cases_misc.cla. This file's shape
// (All first, dedupe + All-collapse, wantAll + per-case branches, SelfCheck
// last) does not change.
//
// XRecFieldsRoundtrip (cases_xrec.cla, task-6-review Important 3) is the
// 40th real case: extern-record bool-field (CvIntNonZero) and str[N]-
// field native runtime proof, added here rather than to the toolbox suite
// because it needs no real Toolbox trap (peek/poke and the address-of-my-
// own-argument `XRecAddr` decay are trap-free), so it rides the existing
// core boots for free.
//
// SortedMapSetCount/SortedMapHasRemove/SortedMapOfListUpsert/
// SortedMapIterOrder (cases_sortedmap.cla, map-hashtable phase Task 3) are
// the 41st-44th real cases: the first three mirror cases_map.cla's own
// three cases verbatim against `sortedmap of T` instead of `map of T`;
// SortedMapIterOrder is new -- it proves the ascending-key iteration
// order contract that belongs to sortedmap alone (plain `map` makes no
// such promise).
//
// MapGrowRehash/MapRemoveSwap/MapIterComplete/MapLongKeys (cases_map.cla,
// map-hashtable phase Task 5) are the 45th-48th real cases: a hashtable-
// stress safety net for plain `map of T`'s rewrite from a sorted array to
// a hashtable -- written and proven green against the OLD sorted-array
// implementation first (every check is order-agnostic), then kept
// unchanged through the rewrite itself.
//
// IntMapSetCount/IntMapHasRemove/IntMapOfListUpsert/IntMapGrowIter
// (cases_intmap.cla, map-hashtable phase Task 8) are the 49th-52nd real
// cases: the first three mirror cases_map.cla's own three cases verbatim
// against `intmap of T` instead of `map of T`, keyed by int; IntMapGrowIter
// is new -- 200-key growth/rehash plus order-agnostic iteration and
// negative-key coverage, intmap's own contract.
//
// DurationStrShapes/DateTimeStrVectors/NowSanity (cases_datetime.cla,
// datetime-instrumentation phase Task 6) are the 53rd-55th real cases:
// fixed-vector coverage for durationStr()/dateTimeStr() (a shared
// lane-identity pin -- the same literals must pass on both the host and
// native 68k lanes) plus a monotonicity/range sanity check on now().
//
// ClearBasics (cases_list.cla, layer1-compiler-perf phase Task 8) is the
// 56th real case: `.clear()` (count -> 0, capacity retained, re-add
// works) across list/map/intmap/sortedmap in one aggregate case.
//
// ParamAliasGlobal/ParamAliasHandle/ParamBorrowChain (cases_param.cla,
// param-abi phase Task 4) are the 57th-59th real cases: by-value
// parameter semantics under aliasing, written against TODAY'S full-copy
// convention so they stay green across the coming borrow/copy ABI flip
// (Tasks 5-7) as a live semantic guard. ParamNestedCallArg (same file,
// Task 5 fix round 1) is the 60th real case: a handle-bearing record
// built by a nested call or inline `new T`, passed DIRECTLY as a by-ref
// argument -- the leak-gate regression the other three cases didn't
// cover (see cases_param.cla's own doc comment). ParamContainerElemArg
// (same file, final-review fix wave) is the 61st real case: a
// map-of-record element (`gm["k"]`) passed DIRECTLY as a by-ref argument,
// with the callee removing that key mid-call -- the use-after-free the
// whole-branch final review found (see cases_param.cla's own doc
// comment).
//
// AbortCatch/AbortDeep/AbortNested/AbortReabort/AbortRelease
// (cases_abort.cla, attempt-abort phase Task 5) are the 64th-68th real
// cases (corrected from an earlier off-by-two "62nd-66th"): catch-one-
// frame-down, 3-frame propagation, nesting, re-abort from a handler, and
// release-on-unwind of a retained local, for the new
// `attempt`/`aborted`/`abort(msg)` feature. Adding this file makes the
// WHOLE core suite abort-enabled (see cases_abort.cla's own doc comment).
//
// TextRange (cases_textrange.cla, clir-load-perf phase Task 2) is the
// 69th real case (corrected from an earlier off-by-two "67th"): known-
// answer + edge-case coverage for the four new bulk text range-read
// methods (hashStep/intAt/stringAt/textAt).
//
// ListClone (cases_textrange.cla, clir-load-perf phase, field-measured
// follow-on) is the 70th real case: `l.clone()`, the bulk block-copy
// `list of T` method through the same intrinsic pipeline -- a `list of
// int` (values + independence), an empty list, and a `list of` flat
// record type.
//
// OnLog (cases_misc.cla, onlog phase) is the 71st real case: the
// `on App.log(line: string)` handler -- ordering, the re-entrancy guard,
// and (by running on both lanes) the fact that the dispatcher clarusc
// synthesizes for it needs no backend-specific arm. Its handler is the
// suite's only `on App.log`, and nothing else in the suite calls log().
//
// ErrReturn (cases_errret.cla, correctness-cleanup Task 6) is the 72nd
// real case: the KErr hidden-result-pointer RETURN ABI (`func f():
// error`), both the discard-dispatch and store-dispatch call-site paths,
// in-process on whichever lane compiles this suite.
//
// EvalOrder (cases_evalorder.cla, correctness-cleanup Task 7) is the 73rd
// real case: `get(k, dv)`'s three arguments evaluate left to right (m, k,
// dv) on both lanes -- native (cg68k.cla's cgIntrMapGetDv) used to
// evaluate m, dv, k instead, observable only with side-effecting
// arguments.
//
// TextBinary/Crc16/IntToStr (cases_textbinary.cla, binary-files phase
// Task 3) are the 74th-76th real cases: the LE/word/setter text
// accessors (intAtLE/wordAt/wordAtLE/setIntAt/setIntAtLE/setWordAt/
// setWordAtLE) plus CRC-16/KERMIT (crc16), and `string(n)` (Ch3: Numeric
// Conversions) -- known-answer coverage for a vDB database engine's
// binary-format helpers, hardware-proved on the native lane the same way
// TextRange proved the original bulk text range-read methods. Crc16
// grew (transfer-crcs phase, Task 2) to also cover CRC-16/XMODEM
// (crc16x) and CRC-32 (crc32), one-shot, chunked, n == 0, and (crc32
// only) table reuse across calls.
//
// FileHandleRW (cases_fileh.cla, binary-files phase Task 5) is the 77th
// real case: create/writeAt/readAt/append/size/setSize/flush/close/
// reopen, a record owning two handles, a handle passed to a function, and
// stale-after-close -- the same fixture-shaped assertions as
// testdata/run/fileh_basic.cla, minus the host-only zero-fill-on-grow
// assertion (spec %3.1: unspecified on the Mac), since this case ALSO
// runs on the native lane (Task 6).
//
// DirOps (cases_dirops.cla, filesystem-api phase Task 4) is the 78th real
// case: the directory/catalog surface end to end on the host lane --
// makeDir, list, exists/info, setInfo, rename, move, delete -- in one
// case so the folder it makes is torn down by the same steps it proves.
// Host lane only in this task; Task 5 wires up the native lane (the
// fileh_68k.cla rtFhDev* stubs added here all fail, by design).
//
// PtrCall (cases_ptrcall.cla, extern-ptr-call phase Task 4) is the 79th
// real case: the new `= ptr` extern clause (conv 10) round-tripped
// through a callback's own decayed glue address -- a word-returning
// call proving signed-word/ptr/int marshalling both directions, plus a
// bool-returning call proving the RESULT readback's bool/char arm
// (unexercised by the word-returning call alone).

enum CoreTest {
    All
    StrConcatClamp
    StrIndexing
    StrCompare
    ErrVarIsolation
    TextAppendStr
    TextWidenAssignability
    TextRealiasLocal
    TextSlicesIndexOfMiss
    TextAssignCompare
    TextAppendPerf
    ListPushCountFirstLast
    ListReassignRelease
    ListGlobalAliasNested
    ListForLoopVarAlias
    MapSetCount
    MapHasRemove
    MapOfListUpsert
    RecCopyIndependence
    RecFieldGlobalAlias
    ArrHolderElementStore
    ArrReturn
    EnumIntRoundTrip
    EnumSaveChoiceValue
    FixedMathOps
    ConstCaseLabel
    SwitchIntRange
    SwitchIntMultiLabel
    SerBinRoundtrip
    SerFileRoundtrip
    SerFileNameRoundtrip
    SerMixedScalarRec
    MiscArithBasic
    MiscBreakContWhile
    MiscCrc8Smbus
    MiscEmitArithAddMul
    MiscArithWrap32
    MiscEmitControlForRange
    MiscEmitFuncRecursion
    MiscMutRecEvenOdd
    MiscWhileCondText
    MiscWideProtoSumBoxMetrics
    MiscLongCondChain
    XRecFieldsRoundtrip
    SortedMapSetCount
    SortedMapHasRemove
    SortedMapOfListUpsert
    SortedMapIterOrder
    MapGrowRehash
    MapRemoveSwap
    MapIterComplete
    MapLongKeys
    IntMapSetCount
    IntMapHasRemove
    IntMapOfListUpsert
    IntMapGrowIter
    DurationStrShapes
    DateTimeStrVectors
    NowSanity
    ClearBasics
    ParamAliasGlobal
    ParamAliasHandle
    ParamBorrowChain
    ParamNestedCallArg
    ParamContainerElemArg
    AbortCatch
    AbortDeep
    AbortNested
    AbortReabort
    AbortRelease
    TextRange
    ListClone
    OnLog
    ErrReturn
    EvalOrder
    TextBinary
    Crc16
    IntToStr
    FileHandleRW
    DirOps
    PtrCall
    StrPerf
    OpenRF
    SelfCheck
}

// nCoreCases is CoreTest's member count minus All: the 82 real cases plus
// SelfCheck itself. SelfCheck's own branch does not increment casesRun for
// itself (it is checking that the OTHER branches ran) -- so on a clean
// run, casesRun has reached nCoreCases - 1 by the time SelfCheck's own
// check runs. A forgotten branch leaves casesRun short and SelfCheck
// fails, instead of the suite silently shrinking.
const nCoreCases: int = 83


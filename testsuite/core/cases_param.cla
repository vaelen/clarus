// cases_param.cla: by-value parameter semantics under aliasing
// (param-abi phase, Task 4). These cases guard the borrow/copy
// classification the ABI flip (Tasks 5-7) will introduce: each one
// must pass IDENTICALLY under TODAY'S full-copy-by-value convention and
// under the future by-address + call-site-copy convention. If one of
// these fails today, that is a bug in the case, not the compiler --
// nothing has flipped yet.
//
// Case -> what it pins:
//   ParamAliasGlobal  <- a string param must keep its value after the
//                        callee reassigns a same-named global mid-call
//                        (the caller passed the global's value in,
//                        not a live view of the global itself).
//   ParamAliasHandle  <- a record param carrying a text field must keep
//                        that field's content readable after the
//                        callee drops the global holding the original
//                        record (the param owns/borrows its own handle,
//                        not the global's).
//   ParamBorrowChain  <- a string value threaded through two levels of
//                        param passing comes back unchanged.
//   ParamNestedCallArg <- a handle-bearing record built by a NESTED call
//                        (`f(g())`) or an inline `new T` literal, passed
//                        DIRECTLY as a by-ref record argument (no local
//                        var in between), reads back correctly. Task 5
//                        fix round 1: this exact shape leaked the
//                        callee's/constructor's owned text handle every
//                        call -- `fpAddrable`'s rvalue fallback
//                        (`fpCopyToTemp`) untracked the call result's
//                        already-tracked release before shallow-copying
//                        it, orphaning the +1 permanently. No existing
//                        case caught it because every other case borrows
//                        a NAMED var/global, never a bare nested call or
//                        `new` result.
//   ParamContainerElemArg <- final-review fix wave (UAF fix): a
//                        map-of-record-with-text-field ELEMENT (`gm["k"]`,
//                        a bare EIntr map_get root, not a named var) passed
//                        DIRECTLY as a by-ref record argument, where the
//                        callee removes that very key MID-CALL, then reads
//                        the param's text field -- the OLD content must
//                        still be readable. Before the fix, `gm["k"]`
//                        classified as borrow: the materialized temp was
//                        an UNRETAINED shallow copy whose text handle was
//                        kept alive only by the map's own element, which
//                        the callee's `remove` just released -- a real
//                        use-after-free (`runtime error: slice out of
//                        range` on host, reproduced before this fix).
//                        Plus a list.pop()-as-arg subcase: an OWNING
//                        container read (ownership already transferred out
//                        of the list) used directly as a call argument --
//                        asserts no crash and correct content (the
//                        release-only-scheduling half of this same fix is
//                        proven by the leak gate, not assertable in-case).
//
// Params are immutable (Task 2): none of these helpers assign to or
// store through a parameter -- caseParamAliasHandle's global doc/`d`
// pair mirrors the plain-value copy pattern proven in cases_rec.cla's
// caseRecFieldGlobalAlias.

record PParamDoc {
    title: string
    body:  text
}

var pgParamName: string
var pgParamDoc: PParamDoc

func paramAliasGlobalHelper(s: string): string {
    var out: string
    pgParamName = "MUTATED"   // reassign the global mid-call
    out = s                   // param must still hold the OLD value
    return out
}

func caseParamAliasGlobal(): TestResult {
    pgParamName = "original"
    if paramAliasGlobalHelper(pgParamName) != "original" {
        return tkFail("ParamAliasGlobal", "param aliased global write")
    }
    return tkPass("ParamAliasGlobal")
}

func paramAliasHandleHelper(d: PParamDoc): text {
    var fresh: PParamDoc
    pgParamDoc = fresh   // releases the global's old handles
    return d.body        // param's own handle must still be alive
}

func caseParamAliasHandle(): TestResult {
    pgParamDoc.title = "t"
    pgParamDoc.body = "alive"
    if paramAliasHandleHelper(pgParamDoc) != "alive" {
        return tkFail("ParamAliasHandle", "handle died under aliasing")
    }
    return tkPass("ParamAliasHandle")
}

func paramBorrowChain2(s: string): string {
    return s
}

func paramBorrowChain1(s: string): string {
    return paramBorrowChain2(s)
}

func caseParamBorrowChain(): TestResult {
    var loc: string
    loc = "chained"
    if paramBorrowChain1(loc) != "chained" {
        return tkFail("ParamBorrowChain", "borrow chain corrupted value")
    }
    return tkPass("ParamBorrowChain")
}

func makeNestedDoc(): PParamDoc {
    var d: PParamDoc
    d.title = "t2"
    d.body = "nested"
    return d
}

func readParamDocBody(d: PParamDoc): text {
    return d.body
}

func caseParamNestedCallArg(): TestResult {
    if readParamDocBody(makeNestedDoc()) != "nested" {
        return tkFail("ParamNestedCallArg", "nested call-result arg corrupted")
    }
    if readParamDocBody(new PParamDoc) != "" {
        return tkFail("ParamNestedCallArg", "inline new-record arg corrupted")
    }
    return tkPass("ParamNestedCallArg")
}

var pgParamMap: map of PParamDoc
var pgParamList: list of PParamDoc

// paramMapElemHelper removes gm's own "k" entry BEFORE reading its record
// param d -- the exact final-review UAF repro shape: `gm["k"]` (a bare
// EIntr map_get root) borrowed as a call argument, with the callee
// re-entering the very container the arg was read from, past the call,
// removing the aliased element mid-call. pgParamMap must be the record's
// SOLE owner at call time (no separate named local duplicating the
// reference) for a stale borrow to actually dangle -- caseParamContainerElemArg
// below stores a bare makeNestedDoc() birth directly into the map, never
// through a named var.
func paramMapElemHelper(d: PParamDoc): text {
    pgParamMap.remove("k")
    return d.body
}

func caseParamContainerElemArg(): TestResult {
    pgParamMap.clear()
    pgParamMap["k"] = makeNestedDoc()
    if paramMapElemHelper(pgParamMap["k"]) != "nested" {
        return tkFail("ParamContainerElemArg", "map-element arg died on mid-call remove")
    }
    // Owning-read subcase: list.pop() transfers the element's ownership
    // OUT of the list -- passed directly as a call argument, it must
    // neither crash nor corrupt content (the release-only-scheduling half
    // of this fix -- no leak -- is proven by the leak gate, not
    // assertable here).
    pgParamList.clear()
    pgParamList.add(makeNestedDoc())
    if readParamDocBody(pgParamList.pop()) != "nested" {
        return tkFail("ParamContainerElemArg", "list-pop arg corrupted")
    }
    return tkPass("ParamContainerElemArg")
}

// cases_leak.cla: LeakCheck (68k-call-result-release phase, Task 4;
// widened by the final-review fix wave) --
// hardware-proves that a user function's text result consumed DIRECTLY
// (argument / operand / receiver / builtin-method-argument / and-right-
// operand, plus a textview `.text` getter box read as a concat operand --
// the
// ../68kbbs/docs/memory-leak.md shapes, also pinned at the listing level
// by internal/cg68k/callresult_release_test.go) is released by the
// emit68k codegen fix (commits 49e1999..cbc1949: cgTmpSlots 14->24,
// fpIntrCall12 split, cgCallFnScalar producer-side tracking,
// IUiGetTextviewText tracking). Pre-fix, each loop iteration below leaked
// one text box+handle per direct-consumption call site, so thousands of
// iterations leak well over 100KB; FreeMem sampled before/after must stay
// flat to within an allocator-jitter slack -- in BOTH directions, since
// the final-review short-circuit shape's own pre-fix symptom is the
// opposite of a leak (a double release of a still-live box: memory freed
// early, then freed again -- heap corruption, and a net FreeMem GAIN if
// it survives at all). TbFreeMem is declared
// LOCALLY, same user-code-extern precedent as cases_gestalt.cla's own
// TbGestaltErr/TbGestaltValue (the curated twin lives in
// toolbox/memory.cla's FreeMem).
external func TbFreeMem(): int = trap 0xA01C reg

// tlkMake returns a fresh text result -- the "g()" of every shape below.
func tlkMake(): text {
    var t: text
    t.append("0123456789abcdef")
    return t
}

// tlkLen consumes its text argument by value -- the "f(t)" of the
// argument-position shape below.
func tlkLen(t: text): int {
    return t.length
}

// tlkRec/tlkMakeRec: a handle-bearing record returned BY VALUE and
// consumed as a RECEIVER (`tlkMakeRec().body`) -- the makeRec().field
// shape cgMaterializeToTemp now tracks (compiler-cleanup item a). Pre-fix
// the materialized record's `body` handle was never released: one leaked
// text block per evaluation.
record TlkRec {
    n: int
    body: text
}

func tlkMakeRec(): TlkRec {
    var r: TlkRec

    r.n = 1
    r.body = "rec body"
    return r
}

// tlkLenRec consumes a handle-bearing record BY VALUE -- the argument
// position of the pop/shift shape. cgPushArgs used to schedule its own
// release for that arg because the materialized copy was untracked; the
// copy is tracked now and that scheduling is gone, so a regression here is
// a DOUBLE release (a FreeMem gain / heap corruption), not a leak.
func tlkLenRec(r: TlkRec): int {
    return r.body.length
}

// caseLeakCheck: 1500 iterations of every direct-consumption shape plus
// 300 of the textview-getter shape, FreeMem sampled before and after. `n`
// is checked nonzero (kept observably live) so nothing above can be
// shaken out as dead code.
//
// compiler-cleanup widened the loop with three more shapes -- a
// handle-bearing record call result used as a receiver, and a list pop
// used as a receiver and as an operand -- each of which leaked one text
// block per iteration before that phase (~3 x 1500 blocks, far outside the
// 8KB slack below).
func caseLeakCheck(): TestResult {
    var before: int
    var after: int
    var i: int
    var n: int
    var acc: text
    var s: text
    var flag: bool
    var w: LogWin
    var pool: list of text
    var recs: list of TlkRec
    var detail: string

    // The getter shape needs a real textview; LogWin is the harness's own
    // Add-button/Body fixture (also used by caseWinvar). Opened BEFORE and
    // closed AFTER the FreeMem bracket, so only the loops are measured.
    w = open LogWin

    before = TbFreeMem()
    i = 0
    while i < 1500 {
        // argument position: f(g())
        n = n + tlkLen(tlkMake())
        // receiver position: g().length
        n = n + tlkMake().length
        // operand position: g() + g() (both operands consumed too)
        n = n + (tlkMake() + tlkMake()).length
        // builtin-method argument: acc.append(g())
        acc.append(tlkMake())
        acc = ""
        // and-short-circuit right operand (final-review Critical 1): the
        // right operand's own temp slot is the SAME frame slot `s`'s
        // handed-off birth just used (the per-statement pool resets), and
        // `flag` is always false, so the right operand never runs. Pre-fix
        // the end-of-statement flush released that slot anyway -- dropping
        // `s`'s still-live box, then dropping it AGAIN at the next
        // iteration's assignment. `flag` is derived from the loop counter
        // rather than written as a literal so nothing can fold the branch
        // away; `s` is read after the `if` to keep it observably live
        // across the statement.
        flag = i < 0
        s = tlkMake()
        if flag and tlkMake().length > 99 {
            n = n + 1
        }
        n = n + s.length
        // handle-bearing record call result as receiver (compiler-cleanup
        // item a): the record is materialized into a scratch temp by
        // cgExprAddr's generic fallback, and its `body` handle is released
        // at end of statement only because that temp is now tracked.
        n = n + tlkMakeRec().body.length
        // pop/shift as receiver and as operand (compiler-cleanup item b):
        // each iteration pushes one fresh text and pops it back in a
        // NON-argument position, where pop's transferred +1 used to be
        // claimed by nothing at all.
        pool.push(tlkMake())
        n = n + pool.pop().length
        pool.push(tlkMake())
        n = n + (pool.pop() + "x").length
        // pop()/shift() of a handle-bearing RECORD in receiver and operand
        // position (language-runtime-cleanup, spec 3.1): pop/shift
        // deliberately leave their KRec scratch untracked (every other
        // consumer block-copies the bytes out into a destination that then
        // owns them), so native leaked one text block per evaluation until
        // cgMaterializeToTemp's tracked-temp gate covered the copy it
        // allocates for a receiver/operand use.
        recs.push(tlkMakeRec())
        n = n + recs.pop().body.length
        recs.push(tlkMakeRec())
        n = n + recs.pop().n
        recs.push(tlkMakeRec())
        n = n + recs.shift().body.length
        recs.push(tlkMakeRec())
        n = n + tlkLenRec(recs.pop())
        i = i + 1
    }
    // textview `.text` getter box consumed as a concat operand -- the one
    // other untracked +1 producer this phase fixed (cgIntrUi's
    // IUiGetTextviewText). Body is empty, so each read is a fresh
    // constant-size box; only the count of un-released boxes can move
    // FreeMem.
    i = 0
    while i < 300 {
        acc = w.Body.text + "x"
        i = i + 1
    }
    after = TbFreeMem()
    close w

    // Slack: Memory Manager fragmentation/rounding jitter, NOT leak
    // headroom -- pre-fix these loops leak well over 100KB, so 8KB
    // cleanly separates pass from fail.
    if n > 0 and after > before - 8192 and after < before + 8192 {
        return tkPass("LeakCheck")
    }
    detail = "before " + tkIntToStr(before) + " after " + tkIntToStr(after) + " n " + tkIntToStr(n)
    return tkFail("LeakCheck", detail)
}

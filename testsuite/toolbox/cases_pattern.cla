// cases_pattern.cla: Pattern (Task 4, ui-scenario-retirement pilot) --
// the migrated replacement for the retired testdata/ui/pattern.cla golden
// UI scenario. That scenario opened a buffered canvas, painted the nine
// dither levels (0..8) as a swatch row, two out-of-range clamp swatches
// (-3 -> level 0, 99 -> level 8), a mid-gray FillOval, and a frame op
// (proving frames ignore the fill pattern), then snapped the whole window
// once and quit -- the golden PBM itself WAS the assertion (no Go-side
// invariant beyond the snap; confirmed against internal/mactest/
// ui_test.go's own TestPatternUIScenario before this file was written).
//
// This case reproduces the exact same five visual features against
// harness.cla's PatBoard window (see PatBoard's own comment for the
// re-laid-out geometry and its 8px-alignment derivation), replacing the
// single whole-window pixel-exact snap with five independent
// UiTestChecksum regions, one per feature -- the task-4-report.md
// assertion-mapping table lines these up 1:1 against what the retired
// golden PBM pinned.
//
// Every tbPatXxxExpected constant below was recorded via the documented
// FAIL-then-copy procedure (CLAUDE.md's toolbox-suite section): build
// with the constant left at 0, boot the suite, read the reported actual
// sum out of the FAIL detail line, then pin it here. NEVER computed by
// hand -- see task-4-report.md for the capture transcript.

// tbPatBoardX0/tbPatBoardY0: PatBoard's content top-left in GLOBAL screen
// coordinates -- (144, 44), same derivation as harness.cla's own
// tbPokeCenterX/tbPokeCenterY comment and PatBoard's own header comment.
const tbPatBoardX0: int = 144
const tbPatBoardY0: int = 44

// Ramp: the 9-level dither swatch row, bounding box (8,8)-(216,24) in
// PatBoard-local coordinates -> GLOBAL (152,52)-(360,68) -- one checksum
// over the WHOLE row rather than nine separate ones (each swatch's fixed
// 8x8 tile pattern already makes the row-wide sum fully deterministic and
// level-sensitive; a changed level anywhere in the ramp changes this
// sum). x/w are literals, not `tbPatBoardX0 + 8`/etc -- Clarus `const`
// initializers are restricted to a literal or a bare IDENT (language
// reference's constDecl grammar), no constant-folded arithmetic.
const tbPatRampX0: int = 152
const tbPatRampY0: int = 52
const tbPatRampW: int = 208
const tbPatRampH: int = 16
const tbPatRampExpected: int = 36720

// tbPatRow2Y0/tbPatRow2W/tbPatRow2H: the second row's shared 16x16
// swatch size and GLOBAL y (44 + 32 local = 76) -- ClampLow, ClampHigh,
// Oval, and Frame all sit in this same row (local y=32..48), each 16px
// wide.
const tbPatRow2Y0: int = 76
const tbPatRow2W: int = 16
const tbPatRow2H: int = 16

// ClampLow: pattern(-3), clamped to level 0 (white) -- local (8,32)-
// (24,48) -> GLOBAL x 152.
const tbPatClampLowX0: int = 152
const tbPatClampLowExpected: int = 0

// ClampHigh: pattern(99), clamped to level 8 (black) -- local (32,32)-
// (48,48) -> GLOBAL x 176.
const tbPatClampHighX0: int = 176
const tbPatClampHighExpected: int = 8160

// Oval: pattern(4) (mid-gray), fillCircle bounding box local (64,32)-
// (80,48) -> GLOBAL x 208 -- the UiFillOval path (rtUiCanvasFillCircle).
const tbPatOvalX0: int = 208
const tbPatOvalExpected: int = 3117

// Frame: rect (frame, not fill) at local (88,32)-(104,48) -> GLOBAL x
// 232 -- proves UiFrameRect ignores the current fill pattern (still set
// to level 4 from the oval draw immediately before it).
const tbPatFrameX0: int = 232
const tbPatFrameExpected: int = 2826

func casePattern(): TestResult {
    var w: PatBoard
    var rampSum: int
    var clampLowSum: int
    var clampHighSum: int
    var ovalSum: int
    var frameSum: int
    var ok: bool
    var detail: string

    w = open PatBoard
    UiTestTick(1)

    rampSum = UiTestChecksum(tbPatRampX0, tbPatRampY0, tbPatRampW, tbPatRampH)
    clampLowSum = UiTestChecksum(tbPatClampLowX0, tbPatRow2Y0, tbPatRow2W, tbPatRow2H)
    clampHighSum = UiTestChecksum(tbPatClampHighX0, tbPatRow2Y0, tbPatRow2W, tbPatRow2H)
    ovalSum = UiTestChecksum(tbPatOvalX0, tbPatRow2Y0, tbPatRow2W, tbPatRow2H)
    frameSum = UiTestChecksum(tbPatFrameX0, tbPatRow2Y0, tbPatRow2W, tbPatRow2H)

    ok = rampSum == tbPatRampExpected
    ok = ok and clampLowSum == tbPatClampLowExpected
    ok = ok and clampHighSum == tbPatClampHighExpected
    ok = ok and ovalSum == tbPatOvalExpected
    ok = ok and frameSum == tbPatFrameExpected

    close w

    if ok {
        return tkPass("Pattern")
    }
    // Built up piecewise into `detail`, same native-68k per-statement
    // str/rec temp-slot budget reason as cases_draw.cla's own case.
    detail = "ramp " + tkIntToStr(rampSum)
    detail = detail + " != " + tkIntToStr(tbPatRampExpected)
    detail = detail + "; clampLow " + tkIntToStr(clampLowSum)
    detail = detail + " != " + tkIntToStr(tbPatClampLowExpected)
    detail = detail + "; clampHigh " + tkIntToStr(clampHighSum)
    detail = detail + " != " + tkIntToStr(tbPatClampHighExpected)
    detail = detail + "; oval " + tkIntToStr(ovalSum)
    detail = detail + " != " + tkIntToStr(tbPatOvalExpected)
    detail = detail + "; frame " + tkIntToStr(frameSum)
    detail = detail + " != " + tkIntToStr(tbPatFrameExpected)
    return tkFail("Pattern", detail)
}

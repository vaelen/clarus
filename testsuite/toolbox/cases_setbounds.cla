// cases_setbounds.cla: SetBounds (ui-widgets Task 6, spec 3.1/4.2).
// Code placement through `setBounds`: the properties read back the new
// rect at once, the deferred apply paints the window once, a resize keeps
// code-placed widgets where code put them while a `width: fill` widget
// that is not code-placed tracks the new width, an auto-placed widget
// after a code-placed one measures from its rect, and a zero-size widget
// takes no clicks.
//
// Geometry: `size: 304, 224` centers the content at ((512-304)/2, 44) =
// (104, 44); 104 is a multiple of 8, so every local x that is a multiple
// of 8 is byte-aligned for UiTestChecksum. Body (the textview) sits at the
// bottom (local y 186+): its caret blinks on ticks, so the one-paint band
// (local rows 0..159) stays above it.
//
// TbFrontWindow is declared LOCALLY (the TbFreeMem precedent in
// cases_leak.cla): the toolbox/ catalog has no Window Manager file yet.
// portRect is GrafPort offset 16 (top/left/bottom/right shorts).
external func TbFrontWindow(): ptr = trap 0xA924

const tbSbOrgX: int = 104
const tbSbOrgY: int = 44

record TbSbRow {
    name: string(31)
}

var tbSbRows: list of TbSbRow

// tbSbMode: 0 = `resized` does nothing; 1 = `resized` re-places every
// widget (FillCP included, which only then becomes code-placed).
var tbSbMode: int
var tbSbClicks: int
var tbSbBClicks: int

window SetBoundsWin {
    title: "SetBounds"
    size: 304, 224
    resizable: min(200, 200)

    label L      { at: 200, 200; text: "Label" }
    button B     { at: 200, 200; caption: "B" }
    canvas C     { at: 200, 200; buffered }
    table Tb {
        at: 200, 200
        rows: tbSbRows
        column "Name" shows name width fill
    }
    divider D    { }
    label Fill   { at: 8, 120; width: fill; text: "Fill" }
    label FillCP { at: 8, 140; width: fill; text: "FillCP" }
    label After  { at: next, bottom; text: "After" }
    textview Body { at: 200, 200 }
}

func tbSbPlace(m: SetBoundsWin) {
    m.L.setBounds(8, 8, 96, 16)
    m.B.setBounds(112, 8, 64, 40)
    if tbSbMode == 0 {
        m.C.setBounds(8, 32, 96, 48)
    } else {
        m.C.setBounds(8, 32, m.contentWidth / 5, 48)
        m.FillCP.setBounds(8, 140, 100, 16)
    }
    m.Tb.setBounds(112, 40, 176, 64)
    m.D.setBounds(8, 112, 280, 3)
    m.Body.setBounds(8, 186, 280, 30)
    m.C.clear()
    m.C.fillRect(4, 4, 20, 20)
}

extend SetBoundsWin {
    on opened {
        tbSbPlace(window)
    }
    on resized {
        if tbSbMode == 1 {
            tbSbPlace(window)
        }
    }
    on C.click(x: int, y: int) {
        tbSbClicks = tbSbClicks + 1
    }
    on B.click {
        tbSbBClicks = tbSbBClicks + 1
    }
}

func tbSbRect(nm: string, x: int, y: int, ww: int, hh: int, ex: int, ey: int, ew: int, eh: int): string {
    var s: string

    if x == ex and y == ey and ww == ew and hh == eh {
        return ""
    }
    s = nm + " " + tkIntToStr(x)
    s = s + "," + tkIntToStr(y)
    s = s + "," + tkIntToStr(ww)
    s = s + "," + tkIntToStr(hh)
    return s + "; "
}

// tbSbFixed: every widget tbSbPlace puts at a constant rect.
func tbSbFixed(w: SetBoundsWin): string {
    var d: string

    d = tbSbRect("L", w.L.x, w.L.y, w.L.width, w.L.height, 8, 8, 96, 16)
    d = d + tbSbRect("B", w.B.x, w.B.y, w.B.width, w.B.height, 112, 8, 64, 20)
    d = d + tbSbRect("Tb", w.Tb.x, w.Tb.y, w.Tb.width, w.Tb.height, 112, 40, 176, 64)
    d = d + tbSbRect("D", w.D.x, w.D.y, w.D.width, w.D.height, 8, 112, 280, 3)
    d = d + tbSbRect("Body", w.Body.x, w.Body.y, w.Body.width, w.Body.height, 8, 186, 280, 30)
    return d
}

func caseSetBounds(): TestResult {
    var w: SetBoundsWin
    var r: TbSbRow
    var d: string
    var c1: int
    var c2: int
    var b0: int
    var b1: int
    var wp: ptr
    var pw: int
    var ph: int

    tbSbMode = 0
    tbSbClicks = 0
    tbSbBClicks = 0
    tbSbRows.clear()
    r.name = "one"
    tbSbRows.add(r)
    r.name = "two"
    tbSbRows.add(r)

    w = open SetBoundsWin
    // Read back before any apply: the pending rect is what reads see.
    d = tbSbFixed(w)
    d = d + tbSbRect("C", w.C.x, w.C.y, w.C.width, w.C.height, 8, 32, 96, 48)

    // One paint: the first update, then nothing more.
    UiTestTick(1)
    c1 = UiTestChecksum(tbSbOrgX, tbSbOrgY, 304, 160)
    UiTestTick(1)
    c2 = UiTestChecksum(tbSbOrgX, tbSbOrgY, 304, 160)
    if c1 != c2 {
        d = d + "repaint " + tkIntToStr(c1) + "->" + tkIntToStr(c2) + "; "
    }
    // The canvas drawing done right after setBounds survived its realloc.
    if UiTestChecksum(tbSbOrgX + 8, tbSbOrgY + 36, 32, 20) == 0 {
        d = d + "canvas blank; "
    }

    // Resize, `resized` idle: code-placed widgets stay, fill widgets track.
    UiTestResize(400, 280)
    d = d + tbSbFixed(w)
    d = d + tbSbRect("C", w.C.x, w.C.y, w.C.width, w.C.height, 8, 32, 96, 48)
    d = d + tbSbRect("Fill", w.Fill.x, w.Fill.y, w.Fill.width, w.Fill.height, 8, 120, 384, 16)
    d = d + tbSbRect("FillCP", w.FillCP.x, w.FillCP.y, w.FillCP.width, w.FillCP.height, 8, 140, 384, 16)

    // Resize with `resized` re-placing everything: the canvas changes size,
    // and still blits at most once.
    tbSbMode = 1
    UiTestTick(1)
    b0 = UiTestCanvasBlits(2)
    UiTestResize(420, 280)
    UiTestTick(1)
    b1 = UiTestCanvasBlits(2)
    if b1 < b0 or b1 - b0 > 1 {
        d = d + "blits " + tkIntToStr(b0) + "->" + tkIntToStr(b1) + "; "
    }
    d = d + tbSbRect("C", w.C.x, w.C.y, w.C.width, w.C.height, 8, 32, 84, 48)
    d = d + tbSbRect("FillCP", w.FillCP.x, w.FillCP.y, w.FillCP.width, w.FillCP.height, 8, 140, 100, 16)
    d = d + tbSbRect("After", w.After.x, w.After.y, w.After.width, w.After.height, 8, 164, 150, 16)

    // A second resize: the code-placed fill widget and the auto-placed
    // widget after it do not jump.
    UiTestResize(380, 260)
    d = d + tbSbFixed(w)
    d = d + tbSbRect("FillCP", w.FillCP.x, w.FillCP.y, w.FillCP.width, w.FillCP.height, 8, 140, 100, 16)
    d = d + tbSbRect("After", w.After.x, w.After.y, w.After.width, w.After.height, 8, 164, 150, 16)
    d = d + tbSbRect("Fill", w.Fill.x, w.Fill.y, w.Fill.width, w.Fill.height, 8, 120, 364, 16)

    // contentWidth/contentHeight are the front window's portRect size.
    wp = TbFrontWindow()
    pw = peekw(wp + 22) - peekw(wp + 18)
    ph = peekw(wp + 20) - peekw(wp + 16)
    if w.contentWidth != pw or w.contentHeight != ph or pw != 380 or ph != 260 {
        d = d + "content " + tkIntToStr(w.contentWidth) + "x" + tkIntToStr(w.contentHeight)
        d = d + " port " + tkIntToStr(pw) + "x" + tkIntToStr(ph) + "; "
    }

    // Zero size: a click on the canvas fires before, nothing fires after.
    UiTestClick(tbSbOrgX + 20, tbSbOrgY + 50)
    w.C.setBounds(10, 10, 0, 0)
    if w.C.width != 0 or w.C.height != 0 {
        d = d + "zero " + tkIntToStr(w.C.width) + "x" + tkIntToStr(w.C.height) + "; "
    }
    UiTestTick(1)
    UiTestClick(tbSbOrgX + 10, tbSbOrgY + 10)
    UiTestClick(tbSbOrgX + 20, tbSbOrgY + 50)
    if tbSbClicks != 1 {
        d = d + "clicks " + tkIntToStr(tbSbClicks) + "; "
    }

    // A zero-size control is hidden (contrlVis): its old spot takes no
    // click. B is at local (112,8)-(176,28), center (144,18).
    UiTestClick(tbSbOrgX + 144, tbSbOrgY + 18)
    w.B.setBounds(112, 8, 0, 0)
    UiTestTick(1)
    UiTestClick(tbSbOrgX + 144, tbSbOrgY + 18)
    if tbSbBClicks != 1 {
        d = d + "button clicks " + tkIntToStr(tbSbBClicks) + "; "
    }

    close w
    tbSbRows.clear()
    if d == "" {
        return tkPass("SetBounds")
    }
    return tkFail("SetBounds", d)
}

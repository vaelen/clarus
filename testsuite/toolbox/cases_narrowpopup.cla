// cases_narrowpopup.cla: NarrowPopup (correctness-cleanup Task 2) --
// hardware-proves the labeled-popup layout fix (uiwidgets.cla's new
// rtUiKindPopup-with-label arm + rtUiPopupBoxInto's defensive floor,
// uitable.cla). Before the fix, a labeled popup's declared `width:` was
// NOT the box width the way a labeled field's already is: layout gave
// the widget only its raw declared width with no label lane added on
// top, so rtUiPopupBoxInto's later "narrow by the label lane" step
// subtracted 70px (rtUiFieldLabelW) straight off a width that never
// included it -- `width: 60` produced a (60-70) = -10px box. The fix
// makes a popup's `width:` mean what a field's already means: the BOX
// width, with the label lane added on top at layout time, so the
// narrowed box comes out exactly the declared 60px.
//
// harness.cla's NarrowPopupWin declares `Pick` (the popup under test) as
// its first widget, so its widget index in RtUiWinst's own per-window
// arrays is 0 -- UiTestPopupBoxLeft(0)/UiTestPopupBoxRight(0)
// (runtime/clarus/uitest.cla) read that index off the real front window,
// through the very rtUiPopupBoxInto this task changed.
//
// Click coordinate (Cancel): NarrowPopupWin's `size: 200, 100` centers
// its content top-left at ((512-200)/2, 44) = (156, 44) (rt_ui_open's
// screen-centering rule, cases_formedit.cla's own header comment derives
// the same way). Cancel is `at: 100, 50` with the default rtUiButtonW/H
// (80x20, uiwidgets.cla) -> local (100,50)-(180,70) -> global
// (256,94)-(336,114), center (296,104).
const tbNpCancelX: int = 296
const tbNpCancelY: int = 104

// tbNpContentW: NarrowPopupWin's own declared content width -- `size:`
// gives content dimensions directly (unaffected by the screen-centering
// position math above), so the popup box's right edge must never exceed
// it.
const tbNpContentW: int = 200

func caseNarrowPopup(): TestResult {
    var left: int
    var right: int
    var detail: string

    edit NarrowPopupWin, new TbNpRec

    left = UiTestPopupBoxLeft(0)
    right = UiTestPopupBoxRight(0)

    UiTestClick(tbNpCancelX, tbNpCancelY)

    if right - left >= 16 and left >= 0 and right <= tbNpContentW {
        return tkPass("NarrowPopup")
    }
    detail = "left " + tkIntToStr(left) + " right " + tkIntToStr(right)
    return tkFail("NarrowPopup", detail)
}

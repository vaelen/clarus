// cases_catalog.cla: Catalog (toolbox-cookbook Task 2) -- hardware-proves
// the shipped toolbox/ extern catalog (memory/events/osutils/scrap) by
// calling it against real ROM, in-process. Unlike every other case file,
// the externs here are NOT declared locally: the whole point is that the
// toolbox/*.cla files in the build supply them. Task 4 extends this case
// with a TE<->desk-scrap bridge roundtrip (see the section markers).

// tbCatEditBar/tbCatEditCopy/tbCatEditPaste: Edit menu bar position and
// std-edit item numbers -- same values cases_editmenu.cla's own
// tbEditBar/tbEditCopy/tbEditPaste derive (see that file's header
// comment for the whole-program declaration-order/std-edit-item
// derivation); redeclared here under tbCat* names since consts are
// file-local and this is a separate module.
const tbCatEditBar: int = 3
const tbCatEditCopy: int = 4
const tbCatEditPaste: int = 5

// tbCatAX/tbCatAY/tbCatADragX/tbCatDragToX: EditMain's field-A click/
// drag geometry, reused verbatim from cases_editmenu.cla's own
// tbEditAX/tbEditAY/tbEditADragX/tbEditDragToX -- EditMain's own layout
// is unchanged, so the same points land the same way: tbCatAX/AY places
// the caret inside the (empty) field before typing; tbCatADragX is ~the
// field's own text-start x (proven by cases_editmenu.cla's own Cut
// result, which selected from there); tbCatDragToX is comfortably past
// a 6-char word's own pixel width (already proven past a 9-char word's
// own width in that file), so a click+drag from ADragX to DragToX
// selects the ENTIRE typed word, not a mid-word slice.
const tbCatAX: int = 200
const tbCatAY: int = 72
const tbCatADragX: int = 133
const tbCatDragToX: int = 190

func caseCatalog(): TestResult {
    var detail: string
    var p1: ptr
    var p2: ptr
    var h: ptr
    var off: ptr
    var mp: ptr
    var ev: EventRecord
    var err: int
    var n: int
    var i: int
    var ok: bool

    // TE <-> desk-scrap bridge section's own locals (kept separate from
    // the plain-catalog vars above, which this section also reuses for
    // its own NewPtr/NewHandle/GetScrap/PutScrap/ZeroScrap calls). Driven
    // flat, one combined `ok` assertion at the end (cases_editmenu.cla's
    // own style), not a branch-per-step early return.
    //
    // A note this file used to carry here -- that reshaping this section
    // "reproducibly broke the plain-catalog Gestalt check above it" and
    // that even a same-length comment edit flipped pass/fail, blamed on
    // "a latent cg68k codegen bug ... never fully isolated" -- was a
    // MISDIAGNOSIS, resolved by pack3-standardfile Task 5a. Nothing here
    // ever perturbed codegen: the Gestalt check above simply read a
    // response slot the trap never wrote (wrong register binding, see
    // that check's own comment), so it asserted `!= 0` against
    // uninitialized heap garbage and any edit that moved the heap around
    // flipped the coin. That check is deterministic now. The flat style
    // stays because it matches cases_editmenu.cla, not because
    // reordering is dangerous.
    var w: EditMain
    var verbLine: string
    var clickAOk: bool
    var typeOk: bool
    var dragClickOk: bool
    var dragOk: bool
    var copyOk: bool
    var getLen: int
    var b0: int
    var b5: int
    var zeroErr: int
    var putErr: int
    var dragClick2Ok: bool
    var drag2Ok: bool
    var pasteOk: bool
    var closedOk: bool
    var aTextAfterPaste: text

    // -- osutils: Gestalt, same selector rtUiStartup proves on every boot.
    // TWO calls, one per result register: the raw trap answers with the
    // OSErr in D0 and the response VALUE in A0, and a `reg` extern names
    // only one `ret` register (toolbox/osutils.cla's own header comment has
    // the full decode of Gestalt.h's TWOWORDINLINE glue). The assertion is
    // a plausible BCD system-version RANGE, not `!= 0`: until
    // pack3-standardfile Task 5a this read a NewPtr'd response slot the
    // trap never actually wrote, so `!= 0` was really an assertion about
    // uninitialized heap garbage and flipped with any layout change.
    err = GestaltErr(gestaltSystemVersion)
    n = GestaltValue(gestaltSystemVersion)
    if err != 0 or n < 0x0400 or n >= 0x1000 {
        detail = "gestalt err " + tkIntToStr(err)
        detail = detail + " resp " + tkIntToStr(n)
        return tkFail("Catalog", detail)
    }

    // -- memory: NewPtr/BlockMoveData/DisposePtr roundtrip.
    p1 = NewPtr(16)
    p2 = NewPtr(16)
    i = 0
    while i < 16 {
        pokeb(p1 + i, 0x40 + i)
        pokeb(p2 + i, 0)
        i = i + 1
    }
    BlockMoveData(p1, p2, 16)
    ok = true
    i = 0
    while i < 16 {
        if peekb(p2 + i) != 0x40 + i {
            ok = false
        }
        i = i + 1
    }
    DisposePtr(p1)
    DisposePtr(p2)
    if not ok {
        return tkFail("Catalog", "blockmove mismatch")
    }

    // -- memory: handle sizing.
    h = NewHandle(8)
    if GetHandleSize(h) != 8 {
        DisposeHandle(h)
        return tkFail("Catalog", "newhandle size")
    }
    err = SetHandleSize(h, 32)
    n = GetHandleSize(h)
    DisposeHandle(h)
    if err != 0 or n != 32 {
        detail = "sethandlesize err " + tkIntToStr(err)
        detail = detail + " size " + tkIntToStr(n)
        return tkFail("Catalog", detail)
    }

    // -- events: EventAvail through the catalog's EventRecord (extern
    // record decay at the ptr parameter). Result is environment-dependent
    // (usually no event pending); calling it without crashing and getting
    // a sane what-code IS the assertion.
    ok = EventAvail(everyEvent, ev)
    if ok and (ev.what < nullEvent or ev.what > osEvt) {
        detail = "eventavail what " + tkIntToStr(ev.what)
        return tkFail("Catalog", detail)
    }

    // -- events: TickCount sanity (nonzero on a booted system).
    if TickCount() == 0 {
        return tkFail("Catalog", "tickcount zero")
    }

    // -- scrap: ZeroScrap/PutScrap/GetScrap roundtrip ('TEXT' flavor).
    err = ZeroScrap()
    if err != 0 {
        detail = "zeroscrap err " + tkIntToStr(err)
        return tkFail("Catalog", detail)
    }
    p1 = NewPtr(8)
    pokeb(p1, 0x43)     // C
    pokeb(p1 + 1, 0x41) // A
    pokeb(p1 + 2, 0x54) // T
    pokeb(p1 + 3, 0x4C) // L
    pokeb(p1 + 4, 0x47) // G
    err = PutScrap(5, 0x54455854, p1)
    DisposePtr(p1)
    if err != 0 {
        detail = "putscrap err " + tkIntToStr(err)
        return tkFail("Catalog", detail)
    }
    h = NewHandle(0)
    off = NewPtr(4)
    n = GetScrap(h, 0x54455854, off)
    DisposePtr(off)
    if n != 5 {
        DisposeHandle(h)
        detail = "getscrap len " + tkIntToStr(n)
        return tkFail("Catalog", detail)
    }
    HLock(h)
    mp = ptr(peekl(h))
    ok = peekb(mp) == 0x43 and peekb(mp + 4) == 0x47
    HUnlock(h)
    DisposeHandle(h)
    if not ok {
        return tkFail("Catalog", "getscrap content")
    }

    // -- scrap: InfoScrap peek-offset read (scrapSize just written).
    mp = InfoScrap()
    if mp == ptr(0) or peekl(mp) < 5 {
        return tkFail("Catalog", "infoscrap")
    }

    // -- TE <-> desk-scrap bridge (toolbox-cookbook rider 2): Copy a real
    // TE via the std Edit menu, then read the DESK scrap back through the
    // catalog's own GetScrap -- proves nat_UiTEToScrap publishes (native
    // lane) / TEToScrap publishes (cprint lane). Then the reverse:
    // PutScrap fresh text, Paste it into the TE, read the widget back --
    // proves nat_UiTEFromScrap fills the TE scrap. Drive pattern (open/
    // click/type/drag-select/menu/readback/close) copied from
    // cases_editmenu.cla; see this file's own tbCat* const comments above
    // for the geometry/menu-position derivations reused here.
    w = open EditMain
    clickAOk = UiTestClick(tbCatAX, tbCatAY)
    typeOk = UiTestType("BRIDGE")
    dragClickOk = UiTestClick(tbCatADragX, tbCatAY)
    verbLine = "drag " + tkIntToStr(tbCatDragToX)
    verbLine = verbLine + " " + tkIntToStr(tbCatAY)
    dragOk = UiTestVerb(verbLine)
    copyOk = UiTestMenu(tbCatEditBar, tbCatEditCopy)

    // GetScrap should now see the 6 bytes of "BRIDGE" that
    // nat_UiTEToScrap (native) / TEToScrap (cprint) just published. Only
    // deref the handle's own content when the length actually came back
    // 6 -- a short/empty scrap still leaves b0/b5 at their 0 default,
    // which the combined `ok` check below catches same as a content
    // mismatch would.
    h = NewHandle(0)
    off = NewPtr(4)
    getLen = GetScrap(h, 0x54455854, off)
    DisposePtr(off)
    b0 = 0
    b5 = 0
    if getLen == 6 {
        HLock(h)
        mp = ptr(peekl(h))
        b0 = peekb(mp)     // 'B' == 0x42
        b5 = peekb(mp + 5) // 'E' == 0x45
        HUnlock(h)
    }
    DisposeHandle(h)

    // Publish fresh desk-scrap text ("XYZ"), then Paste it into A --
    // proves nat_UiTEFromScrap (native) / TEFromScrap (cprint) fills the
    // TE scrap from the desk scrap.
    zeroErr = ZeroScrap()
    p1 = NewPtr(3)
    pokeb(p1, 0x58)     // X
    pokeb(p1 + 1, 0x59) // Y
    pokeb(p1 + 2, 0x5A) // Z
    putErr = PutScrap(3, 0x54455854, p1)
    DisposePtr(p1)

    dragClick2Ok = UiTestClick(tbCatADragX, tbCatAY)
    verbLine = "drag " + tkIntToStr(tbCatDragToX)
    verbLine = verbLine + " " + tkIntToStr(tbCatAY)
    drag2Ok = UiTestVerb(verbLine)
    pasteOk = UiTestMenu(tbCatEditBar, tbCatEditPaste)

    aTextAfterPaste = w.A.text
    closedOk = UiTestClose()

    ok = clickAOk and typeOk and dragClickOk and dragOk and copyOk
    ok = ok and getLen == 6 and b0 == 0x42 and b5 == 0x45
    ok = ok and zeroErr == 0 and putErr == 0
    ok = ok and dragClick2Ok and drag2Ok and pasteOk and closedOk
    ok = ok and aTextAfterPaste == "XYZ"

    if ok {
        return tkPass("Catalog")
    }
    detail = "te bridge len " + tkIntToStr(getLen)
    detail = detail + " b0 " + tkIntToStr(b0)
    detail = detail + " b5 " + tkIntToStr(b5)
    detail = detail + " zeroErr " + tkIntToStr(zeroErr)
    detail = detail + " putErr " + tkIntToStr(putErr)
    detail = detail + " paste " + tkIntToStr(aTextAfterPaste.length)
    return tkFail("Catalog", detail)
}

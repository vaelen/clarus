// cases_canvasidle.cla: CanvasIdle (language-runtime-cleanup, spec 2.1).
// A buffered canvas drawn once must blit exactly once and then cost
// nothing per event-loop pass: 200 idle ticks may not advance its blit
// counter, and FreeMem stays exactly flat (no CopyBits scratch churn).
//
// TbFreeMem is declared LOCALLY, the same user-code-extern precedent
// cases_leak.cla and cases_gestalt.cla set (an identical `external func`
// redeclaration is legal; the curated twin lives in toolbox/memory.cla).
external func TbFreeMem(): int = trap 0xA01C reg

func caseCanvasIdle(): TestResult {
    var w: IdleCanvasWin
    var b0: int
    var b1: int
    var m0: int
    var m1: int
    var i: int

    w = open IdleCanvasWin
    // Warm-up before ANY sample: opening a window for the first time in a
    // run leaves a small Toolbox allocation transient that takes a few
    // event-loop passes to settle, and this case is the only exact-FreeMem
    // case in the suite that brackets a window open (LeakCheck carries 8 KB
    // of slack; ClearWarm opens no window). Measured per pass with
    // TbFreeMem, first open vs second, language-runtime-cleanup Task 15:
    //
    //   first open   0 +2 +2 +2  0  0 ...   settles on pass 4
    //   second open  0 +34 -4  0  0  0 ...  settles on pass 2
    //
    // The settle POINT moves with heap layout, so any code-size change
    // anywhere relocates it -- which is exactly how this case went red
    // during that phase (`9fa5134`, a menu-bar fix whose SEMANTIC half,
    // reverted on its own, left the failure byte-identical). Sampling
    // inside the settle made the case a heap-layout tripwire rather than
    // the steady-state assertion it is meant to be: once settled, FreeMem
    // is EXACTLY flat across the 200 idle ticks below, which is the
    // contract -- a clean buffered canvas costs no blit and no Memory
    // Manager traffic per event-loop pass.
    //
    // ponytail: 12 passes is ~3x the largest settle measured. If this ever
    // goes red again by a handful of bytes, re-measure per pass before
    // touching the number -- a real regression moves it every pass, not
    // once.
    i = 0
    while i < 12 {
        UiTestTick(1)
        i = i + 1
    }
    b0 = UiTestCanvasBlits(0)
    if b0 < 1 {
        close w
        return tkFail("CanvasIdle", "no initial blit (got " + tkIntToStr(b0) + ")")
    }
    m0 = TbFreeMem()
    UiTestTick(200)
    m1 = TbFreeMem()
    b1 = UiTestCanvasBlits(0)
    close w
    if b1 != b0 {
        return tkFail("CanvasIdle", "idle ticks blitted: " + tkIntToStr(b0) + " -> " + tkIntToStr(b1))
    }
    if m1 != m0 {
        return tkFail("CanvasIdle", "FreeMem moved: " + tkIntToStr(m0) + " -> " + tkIntToStr(m1))
    }
    return tkPass("CanvasIdle")
}

// cases_event.cla: EventXRec (Task 6, toolbox-integration Feature B) --
// exercises `extern record` native storage/decay (EXRecAddr, CvSExt16)
// against a REAL Toolbox trap, inside a booted program: cg68k's own
// listing golden (testdata/cg68k/xrec.cla) proves the emitted instructions
// look right; this case proves the SAME codegen dispatches correctly
// against real ROM, the same "user-code externs are the proven pattern"
// precedent cases_events.cla/cases_gestalt.cla/cases_a5.cla already
// establish. Point/EventRecord are declared LOCALLY (not reused from
// runtime/clarus/ui.cla) for the identical reason.
//
// OSEventAvail convention (verified against Inside Macintosh, NOT the
// brief's own draft -- see below): the OS Event Manager's trap-word
// sequence is contiguous and ALL Pascal-convention on this ROM --
// _PostEvent=0xA02F, _OSEventAvail=0xA030, _GetOSEvent=0xA031,
// _FlushEvents=0xA032. runtime/clarus/ui.cla ALREADY declares
// UiFlushEvents (0xA032, OSEventAvail's own next-door neighbor in this
// same OS Event Manager trap family) as a plain `= trap 0xA032` (Pascal,
// no `reg`) -- and every other real event trap that file declares
// (UiWaitNextEvent = trap 0xA860, UiGetNextEvent = trap 0xA970) is
// likewise plain Pascal, never `reg`. OSEventAvail's real Pascal
// signature (Inside Macintosh, Event Manager) is
// `FUNCTION OSEventAvail (eventMask: INTEGER; VAR theEvent: EventRecord):
// BOOLEAN;` -- an INTEGER (word) value param, a VAR (pointer) param, a
// BOOLEAN result, the EXACT shape UiGetNextEvent already declares
// (`eventMask: word, theEvent: ptr): bool = trap 0xA970`, no `reg`). The
// brief's own draft clause (`reg(d0: mask, a0: ev) ret d0`) does NOT match
// this trap family on this ROM -- declared here as plain Pascal instead,
// matching its own neighbors.
external func TbOSEventAvail(mask: word, ev: ptr): bool = trap 0xA030

// TbXRecAddr: clause-less extern -> nat_TbXRecAddr fallback (verified
// against testdata/cg68k/traps.cla's own TCustomOp/nat_TCustomOp pair,
// the established "no trap clause -> nat_<Name> Clarus function"
// convention, cgCallExtNatFallback/cg68k.cla) -- the native-lane sibling
// of Task 5's own rt_ext_XRecAddr host-lane identity shim: "the address of
// my own argument" has no real Toolbox trap behind it, so both lanes
// resolve it as a plain identity instead.
external func TbXRecAddr(p: ptr): ptr

func nat_TbXRecAddr(p: ptr): ptr {
    return p
}

extern record Point {
    v: word
    h: word
}

extern record EventRecord {
    what: word
    message: int
    when: int
    where: Point
    modifiers: word
}

// caseEventXRec: fills ev with a nonzero sentinel (so a marshaling bug
// that leaves ev untouched fails closed, not a false pass from an
// already-zero record), calls the real OSEventAvail trap (an empty
// scripted boot has no pending application event, so `what` should come
// back 0 -- nullEvent), then cross-checks TWO independent read paths of
// the SAME resulting bytes: a raw peek through TbXRecAddr(ev)'s own
// computed address (offsets 0/2/6/10 -- what/message/when/where.v, Task
// 4's own verified packing anchors) against the corresponding ordinary
// field read (`ev.what`/`ev.message`/`ev.when`/`ev.where.v`, which routes
// through CvSExt16 for the two word fields). message/when are full
// 32-bit fields (peekl and a field read are numerically identical,
// sign irrelevant); what/where.v are word fields but both expected values
// stay well under the 16-bit sign boundary here (what == 0 for a null
// event; where.v is the screen's own V coordinate, 0-342, never near
// 32768) so a raw zero-extending peekw and a sign-extending field read
// agree numerically either way. A wrong TbXRecAddr/EXRecAddr offset
// computation would read from the wrong address and almost certainly
// disagree with the field read of the SAME logical field.
func caseEventXRec(): TestResult {
    var ev: EventRecord
    var got: bool
    var base: ptr
    var w0: int
    var l2: int
    var l6: int
    var w10: int
    var detail: string

    ev.what = -1
    ev.message = -1
    ev.when = -1
    ev.where.v = -1
    ev.where.h = -1
    ev.modifiers = -1

    got = TbOSEventAvail(0xFFFF, ev)

    base = TbXRecAddr(ev)
    w0 = peekw(base + 0)
    l2 = peekl(base + 2)
    l6 = peekl(base + 6)
    w10 = peekw(base + 10)

    if ev.what == 0 and w0 == ev.what and l2 == ev.message and l6 == ev.when and w10 == ev.where.v {
        return tkPass("EventXRec")
    }
    // Built up piecewise into `detail`, same native-68k temp-slot-budget
    // reason as cases_events.cla's own cases.
    if got {
        detail = "got true"
    } else {
        detail = "got false"
    }
    detail = detail + " what " + tkIntToStr(ev.what)
    detail = detail + " w0 " + tkIntToStr(w0)
    detail = detail + " message " + tkIntToStr(ev.message)
    detail = detail + " l2 " + tkIntToStr(l2)
    detail = detail + " when " + tkIntToStr(ev.when)
    detail = detail + " l6 " + tkIntToStr(l6)
    detail = detail + " where.v " + tkIntToStr(ev.where.v)
    detail = detail + " w10 " + tkIntToStr(w10)
    return tkFail("EventXRec", detail)
}

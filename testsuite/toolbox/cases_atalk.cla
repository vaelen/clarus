// cases_atalk.cla: AtalkSelf (AppleTalk phase Task 6) and AdspLeak
// (Task 13b, at the foot of this file -- see its own header comment).
//
// AtalkSelf hardware-proves
// the shipped toolbox/appletalk.cla catalog against real ROM AppleTalk,
// in-process, the same "the catalog files supply the externs, this case
// only calls them" discipline cases_catalog.cla and cases_serial.cla
// already establish. It opens the real .MPP and .ATP drivers, registers
// an NBP name with verification on, reads its own net/node back out of
// the Names Table Entry, looks up a type nothing has registered, removes
// the name, then opens and closes a dynamic ATP socket.
//
// WHAT THIS CASE DELIBERATELY DOES NOT DO, and why. The design spec's
// original sketch was a self-lookup (find our own registered name) and
// an ATP self-transaction (async getRequest + sync sendRequest to our
// own address). Task 1's probe wave (task-1-report.md P3, Amendment 3)
// proved all three legs of that unavailable on the Mac Plus ROM .MPP,
// which is what this suite boots:
//   - `setSelfSend` (csCode 256) returns -17 (controlErr): the ROM .MPP
//     does not implement it, and the AppleTalk 58 System file whose
//     .MPP would is not on LaunchAPPL's stripped boot disk (P1).
//   - a self-lookup therefore returns err 0 with numGotten 0, before and
//     after that call.
//   - a self-directed ATP sendRequest fails -1096 (reqFailed) after its
//     full retry budget, and the paired async getRequest never
//     completes.
// So the assertions below are exactly Amendment 3's table -- every row
// of it, and nothing that was not observed on real hardware. Note in
// particular that the node number is NOT asserted against a fixed value:
// it is acquired by LLAP at boot and differs run to run (106 and 18 were
// both seen). AtalkSelf itself opens neither .XPP nor .DSP -- it needs
// neither, and when it was written both answered -43 (fnfErr) on
// LaunchAPPL's stripped boot disk. That harness gap is now fixed (Task
// 13a), which is what lets AdspLeak below open .DSP for real.
//
// Runtime cost: about 6.5 seconds. `registerName` with verifyFlag on
// broadcasts `count` lookups at `interval` before returning, and
// `lookupName` runs its full retry budget even when an answer arrives
// early (task-1-report.md P2) -- ~3.2 s each at interval 8 / count 3.
//
// Every parameter block below is a FRESH extern-record local, one per
// call, never reused: toolbox/appletalk.cla's Rule 2, which cost Task 1
// three hard hangs of the emulated Mac before it was understood. An
// extern record local is zero-initialized on declaration (language
// reference, "extern record"), so this shape satisfies the rule by
// construction.

// atPStr writes `s` as a Pascal string at `p` and returns the address
// one byte past its end -- so three back-to-back calls build the PACKED
// object/type/zone entity NBP actually wants (toolbox/appletalk.cla's
// own NTE note: `struct EntityName`'s three Str32Field slots are a
// Pascal/C interface fiction, per AppleTalk.h's own comment). Same
// NewPtr+pokeb technique toolbox/devices.cla documents for ioNamePtr and
// cases_serial.cla's `serPName` demonstrates; kept local to this file
// rather than shared, so each case file stands on its own.
func atPStr(p: ptr, s: string): ptr {
    var i: int
    pokeb(p, s.length)
    i = 0
    while i < s.length {
        pokeb(p + 1 + i, int(s[i]))
        i = i + 1
    }
    return p + 1 + s.length
}

func caseAtalkSelf(): TestResult {
    var mppPb: IOParam
    var atpPb: IOParam
    var regPb: NBPRegParam
    var lkPb: NBPLookupParam
    var rmPb: NBPParam
    var skOpenPb: ATPParam
    var skClosePb: ATPParam
    var nm: ptr
    var end: ptr
    var nte: ptr
    var lkEntity: ptr
    var lkBuf: ptr
    var err: int
    var mppRef: int
    var atpRef: int
    var net: int
    var node: int
    var sock: int
    var detail: string

    // -- 1. Open .MPP. It lives in the Mac Plus ROM, so this works with
    // no AppleTalk System file present, and the OS hands back the
    // documented static refNum.
    nm = NewPtrClear(8)
    end = atPStr(nm, ".MPP")
    mppPb.ioNamePtr = nm
    err = PBOpenSync(mppPb)
    mppRef = mppPb.ioRefNum
    if err != 0 or mppRef != mppRefNum {
        detail = "open .MPP err " + tkIntToStr(err)
        detail = detail + " refNum " + tkIntToStr(mppRef)
        return tkFail("AtalkSelf", detail)
    }

    // -- 2. Register "AtalkSelf:ClarusSuite@*" with verification on.
    // The NTE is 108 bytes: qNext(4) nteAddress(4) filler(1) then the
    // packed entity at +9. Rule 3 of toolbox/appletalk.cla says a real
    // service must poke its own listening socket into NTE+7
    // (nteAddress + 3) BEFORE this call, because NBP copies that byte
    // through verbatim. This case leaves it 0 on purpose: the name
    // exists only long enough to prove register/lookup/remove, and
    // nothing ever connects to it.
    // The object name carries a TickCount suffix (toolbox/events.cla's
    // TickCount, the same trap cases_catalog.cla uses). A fixed name
    // only collides if two suite boots share one LocalTalk net at the
    // same moment -- which Task 11's two-emulator harness is about to
    // make possible -- and a collision would fail registerName with
    // nbpDuplicate, since verifyFlag is on.
    nte = NewPtrClear(nteSize)
    end = atPStr(nte + nteEntity, "AtalkSelf-" + string(TickCount() mod 10000))
    end = atPStr(end, "ClarusSuite")
    end = atPStr(end, "*")
    regPb.ioRefNum = mppRef
    regPb.csCode = registerName
    regPb.interval = 8
    regPb.count = 3
    regPb.ntQElPtr = nte
    regPb.verifyFlag = 1
    err = PBControlSync(regPb)
    if err != 0 {
        detail = "registerName err " + tkIntToStr(err)
        return tkFail("AtalkSelf", detail)
    }

    // -- 3. registerName filled our own address into the NTE
    // (task-1-report.md Amendment 4 -- the cheapest way to learn it, no
    // GetNodeAddress glue and no low-memory poking). Net is 0 on a
    // routerless LocalTalk net, which is what the emulator lane is; the
    // node is acquired per boot, so only its legal range is asserted.
    net = peekw(nte + nteAddress)
    node = peekb(nte + nteAddress + 2)
    if net != 0 or node < 1 or node > 254 {
        detail = "nteAddress net " + tkIntToStr(net)
        detail = detail + " node " + tkIntToStr(node)
        return tkFail("AtalkSelf", detail)
    }

    // -- 4. Look up a type nothing has registered. This is the honest
    // no-peer NBP proof available on this ROM: the CALL succeeds (err 0)
    // and finds nothing (numGotten 0). A lookup of our OWN type would
    // also return 0 gotten here -- the ROM never answers its own
    // lookups -- so it would prove nothing this does not.
    lkEntity = NewPtrClear(64)
    end = atPStr(lkEntity, "=")
    end = atPStr(end, "ClarusNoSuch")
    end = atPStr(end, "*")
    // 8, not 16: a reply tuple is AddrBlock(4) + enumerator(1) + three
    // packed Pascal strings, at most 104 bytes, so maxToGet and
    // retBuffSize have to agree -- 8 x 104 = 832 fits in 1024, 16 would
    // not (1664) and NBP would answer nbpBuffOvr instead of 0 gotten.
    lkBuf = NewPtrClear(1024)
    lkPb.ioRefNum = mppRef
    lkPb.csCode = lookupName
    lkPb.interval = 8
    lkPb.count = 3
    lkPb.entityPtr = lkEntity
    lkPb.retBuffPtr = lkBuf
    lkPb.retBuffSize = 1024
    lkPb.maxToGet = 8
    err = PBControlSync(lkPb)
    if err != 0 or lkPb.numGotten != 0 {
        detail = "lookupName err " + tkIntToStr(err)
        detail = detail + " numGotten " + tkIntToStr(lkPb.numGotten)
        return tkFail("AtalkSelf", detail)
    }

    // -- 5. Remove the name. RemoveName takes the ENTITY (the packed
    // object/type/zone at NTE+9), not the NTE itself -- the other arm of
    // AppleTalk.h's `union NBPPtrs` at the same offset 30.
    rmPb.ioRefNum = mppRef
    rmPb.csCode = removeName
    rmPb.entityPtr = nte + nteEntity
    err = PBControlSync(rmPb)
    if err != 0 {
        detail = "removeName err " + tkIntToStr(err)
        return tkFail("AtalkSelf", detail)
    }

    // -- 6. Open .ATP -- also ROM-resident, also a static refNum.
    nm = NewPtrClear(8)
    end = atPStr(nm, ".ATP")
    atpPb.ioNamePtr = nm
    err = PBOpenSync(atpPb)
    atpRef = atpPb.ioRefNum
    if err != 0 or atpRef != atpRefNum {
        detail = "open .ATP err " + tkIntToStr(err)
        detail = detail + " refNum " + tkIntToStr(atpRef)
        return tkFail("AtalkSelf", detail)
    }

    // -- 7. openATPSkt with atpSocket 0 asks for any free dynamic
    // socket; DDP's dynamic range is 128..254 (Inside Macintosh II
    // ch. 10). Task 1 saw 202.
    skOpenPb.ioRefNum = atpRef
    skOpenPb.csCode = openATPSkt
    skOpenPb.atpSocket = 0
    err = PBControlSync(skOpenPb)
    sock = skOpenPb.atpSocket
    if err != 0 or sock < 128 or sock > 254 {
        detail = "openATPSkt err " + tkIntToStr(err)
        detail = detail + " socket " + tkIntToStr(sock)
        return tkFail("AtalkSelf", detail)
    }

    // -- 8. Close it again, from a FRESH block (Rule 2). The suite boot
    // must leave no ATP socket behind for later cases.
    skClosePb.ioRefNum = atpRef
    skClosePb.csCode = closeATPSkt
    skClosePb.atpSocket = sock
    err = PBControlSync(skClosePb)
    if err != 0 {
        detail = "closeATPSkt err " + tkIntToStr(err)
        return tkFail("AtalkSelf", detail)
    }

    return tkPass("AtalkSelf")
}

// ---- AdspLeak (AppleTalk phase Task 13b) ----

// What AdspLeak proves: the ROM's .DSP driver retains NOTHING across an
// init/remove pair -- for a connection end (dspInit/dspRemove) and for a
// connection listener (dspCLInit/dspCLRemove) -- at the exact block sizes
// runtime/clarus/atalk_68k.cla hands it, and that pairing those calls
// with matching DisposePtrs leaves FreeMem EXACTLY where it started.
// That is the half of the ADSP lifecycle nobody can settle by reading
// source: whether the driver keeps a per-connection-end allocation of its
// own that dspRemove does not give back.
//
// WHAT IT DELIBERATELY DOES NOT PROVE: rtAt68DspFree's own bookkeeping.
// The blocks below are allocated and disposed by THIS case, not by
// rtAt68CcbEnsure/rtAt68DspFree, so a future runtime edit that dropped
// one of those DisposePtr calls would not be caught here. That is not a
// design preference: a suite case CANNOT name rtAt68DspInitEnd /
// rtAdspDevClose / rtAtEnsureUp at all, because `--testapi` early-splices
// a FIXED thirteen-module list (core/str/text/list/map + the ui* family +
// uitest.cla -- clarusc/drive.cla's driveEarlySplice, clarusc/bake.cla's
// bakeModuleList) and the AppleTalk modules are not in it; they are
// manifest-spliced AFTER the checker's first pass, so their names are
// invisible to user code. Widening that set is a compiler change that
// moves the bake manifest and the golden corpus -- recorded in
// docs/TODO.md, scheduled with the next phase that reblesses goldens.
//
// The sizes below MIRROR the runtime's (rtAt68DspPbSz 68 = sizeof
// DSPParamBlock, ADSP.h:193-216; rtAt68QSz 1024; ccbSize 242 and
// attnBufSize 570 come straight from toolbox/appletalk.cla). Mirroring
// is the point -- a leak the driver only exhibits at some other queue
// size would not be the one the runtime can hit.
//
// Rule 2 (toolbox/appletalk.cla): every call below gets its OWN freshly
// cleared parameter block -- dspInit and dspRemove never share one, the
// same separation rtAt68DspAux exists for in the runtime.
//
// Exact equality, not slack: unlike cases_leak.cla's LeakCheck (which
// brackets Memory-Manager-heavy handle traffic and needs jitter
// headroom), every cycle here is a strict NewPtrClear/DisposePtr pair in
// the application zone, so a single retained byte is a real finding.
const tbAdspPbSz: int = 68     // sizeof(DSPParamBlock) -- runtime rtAt68DspPbSz
const tbAdspQSz: int = 1024    // ADSP send/receive queue -- runtime rtAt68QSz
const tbAdspCycles: int = 20

// tbAdspMemFullErr: memFullErr. Named locally rather than reusing the
// runtime's rtAtErrMemFull for the same reason every extern in this file
// is local -- runtime names are not in scope for a suite case (see
// AdspLeak's header comment).
const tbAdspMemFullErr: int = -108

// tbAdspFreeIf: DisposePtr unless the allocation failed. A partial
// allocation still has to give back what it got, or the FreeMem bracket
// would report the shortfall as a driver leak.
func tbAdspFreeIf(p: ptr) {
    if p != ptr(0) {
        DisposePtr(p)
    }
}

// tbAdspEndCycle: one full connection-end lifecycle -- the five blocks
// rtAt68CcbEnsure allocates (CCB, send queue, receive queue, attention
// buffer, parameter block) plus the separate remove block, dspInit,
// dspRemove with the abort flag set, and every block back once the
// driver has given it up. Returns the OSErr; 0 on success.
func tbAdspEndCycle(dspRef: int): int {
    var ccb: ptr
    var sendQ: ptr
    var recvQ: ptr
    var attn: ptr
    var pbInit: ptr
    var pbRem: ptr
    var e: int
    var driverHolds: bool

    driverHolds = false
    ccb = NewPtrClear(ccbSize)
    sendQ = NewPtrClear(tbAdspQSz)
    recvQ = NewPtrClear(tbAdspQSz)
    attn = NewPtrClear(attnBufSize)
    pbInit = NewPtrClear(tbAdspPbSz)
    pbRem = NewPtrClear(tbAdspPbSz)
    e = tbAdspMemFullErr
    if ccb != ptr(0) and sendQ != ptr(0) and recvQ != ptr(0) and attn != ptr(0) and pbInit != ptr(0) and pbRem != ptr(0) {
        pokew(pbInit + dspIoCRefNum, dspRef)
        pokew(pbInit + pbCsCode, dspInit)
        pokel(pbInit + dspInitCcbPtr, int(ccb))
        pokel(pbInit + dspInitUserRoutine, 0)
        pokew(pbInit + dspInitSendQSize, tbAdspQSz)
        pokel(pbInit + dspInitSendQueue, int(sendQ))
        pokew(pbInit + dspInitRecvQSize, tbAdspQSz)
        pokel(pbInit + dspInitRecvQueue, int(recvQ))
        pokel(pbInit + dspInitAttnPtr, int(attn))
        pokeb(pbInit + dspInitLocalSocket, 0)
        e = PBControlSync(pbInit)
        if e == 0 {
            // The CCB, the two queues and the attention buffer are
            // ADSP's from here until dspRemove returns, so a dspRemove
            // that FAILS leaves the driver still referencing all four:
            // they are deliberately not disposed below, because handing
            // them back to the Memory Manager while the driver may still
            // write into them is a use-after-free. The FreeMem bracket
            // then reports the shortfall, but the case has already
            // FAILed with this OSErr -- tbAdspEndCycle returns it and
            // caseAdspLeak puts it in the detail with the cycle index.
            driverHolds = true
            pokew(pbRem + dspIoCRefNum, dspRef)
            pokew(pbRem + pbCsCode, dspRemove)
            pokew(pbRem + dspCcbRefNum, peekw(pbInit + dspCcbRefNum))
            pokeb(pbRem + dspCloseAbort, 1)
            e = PBControlSync(pbRem)
            if e == 0 {
                driverHolds = false
            }
        }
    }
    if not driverHolds {
        tbAdspFreeIf(ccb)
        tbAdspFreeIf(sendQ)
        tbAdspFreeIf(recvQ)
        tbAdspFreeIf(attn)
    }
    // The parameter blocks are the caller's throughout: PBControlSync is
    // synchronous, so neither is queued once it has returned.
    tbAdspFreeIf(pbInit)
    tbAdspFreeIf(pbRem)
    return e
}

// tbAdspLsnCycle: the connection-LISTENER twin. dspCLInit takes only a
// CCB and a local socket -- no queues, no attention buffer (ADSP.h's
// TRinitParams; rtLsnDevInit sets exactly these two fields too) -- and
// localSocket 0 asks DDP for a dynamic socket, which dspCLRemove has to
// give back or twenty cycles would run the node out of them.
func tbAdspLsnCycle(dspRef: int): int {
    var ccb: ptr
    var pbInit: ptr
    var pbRem: ptr
    var e: int
    var driverHolds: bool

    driverHolds = false
    ccb = NewPtrClear(ccbSize)
    pbInit = NewPtrClear(tbAdspPbSz)
    pbRem = NewPtrClear(tbAdspPbSz)
    e = tbAdspMemFullErr
    if ccb != ptr(0) and pbInit != ptr(0) and pbRem != ptr(0) {
        pokew(pbInit + dspIoCRefNum, dspRef)
        pokew(pbInit + pbCsCode, dspCLInit)
        pokel(pbInit + dspInitCcbPtr, int(ccb))
        pokeb(pbInit + dspInitLocalSocket, 0)
        e = PBControlSync(pbInit)
        if e == 0 {
            // Same rule as tbAdspEndCycle: the CCB is ADSP's until
            // dspCLRemove returns, so a failed remove leaves it with the
            // driver and it is not disposed.
            driverHolds = true
            pokew(pbRem + dspIoCRefNum, dspRef)
            pokew(pbRem + pbCsCode, dspCLRemove)
            pokew(pbRem + dspCcbRefNum, peekw(pbInit + dspCcbRefNum))
            pokeb(pbRem + dspCloseAbort, 1)
            e = PBControlSync(pbRem)
            if e == 0 {
                driverHolds = false
            }
        }
    }
    if not driverHolds {
        tbAdspFreeIf(ccb)
    }
    tbAdspFreeIf(pbInit)
    tbAdspFreeIf(pbRem)
    return e
}

func caseAdspLeak(): TestResult {
    var openPb: IOParam
    var nm: ptr
    var end: ptr
    var dspRef: int
    var err: int
    var before: int
    var after: int
    var i: int
    var ran: int
    var detail: string

    // -- 1. Open .DSP. Unlike .MPP/.ATP this one is NOT in the Mac Plus
    // ROM: it lives in the AppleTalk system file, so this is also the
    // case's own environment gate. A failure FAILs with the OSErr (-43
    // when the file is absent) rather than passing vacuously -- there is
    // no "skip" verdict in this suite, and a silently-skipped leak check
    // is worse than a red one.
    nm = NewPtrClear(8)
    if nm == ptr(0) {
        return tkFail("AdspLeak", "NewPtrClear failed")
    }
    end = atPStr(nm, ".DSP")
    openPb.ioNamePtr = nm
    err = PBOpenSync(openPb)
    dspRef = openPb.ioRefNum
    DisposePtr(nm)
    if err != 0 or dspRef == 0 {
        detail = "open .DSP err " + tkIntToStr(err)
        detail = detail + " refNum " + tkIntToStr(dspRef)
        return tkFail("AdspLeak", detail)
    }

    // -- 2. Connection ends. One warm-up cycle OUTSIDE the bracket: the
    // first dspInit on a freshly opened .DSP is what makes the driver
    // build whatever per-driver state it keeps (and the Memory Manager
    // grow the zone for our own first six blocks), and that one-time cost
    // is not a leak. Everything after it must be free.
    err = tbAdspEndCycle(dspRef)
    if err != 0 {
        detail = "end warmup err " + tkIntToStr(err)
        return tkFail("AdspLeak", detail)
    }
    before = FreeMem()
    i = 0
    while i < tbAdspCycles {
        err = tbAdspEndCycle(dspRef)
        if err != 0 {
            detail = "end cycle " + tkIntToStr(i) + " err " + tkIntToStr(err)
            return tkFail("AdspLeak", detail)
        }
        ran = ran + 1
        i = i + 1
    }
    after = FreeMem()
    if after != before or ran != tbAdspCycles {
        detail = "end before " + tkIntToStr(before) + " after " + tkIntToStr(after)
        detail = detail + " cycles " + tkIntToStr(ran)
        return tkFail("AdspLeak", detail)
    }

    // -- 3. Connection listeners, same shape, own warm-up.
    err = tbAdspLsnCycle(dspRef)
    if err != 0 {
        detail = "listener warmup err " + tkIntToStr(err)
        return tkFail("AdspLeak", detail)
    }
    before = FreeMem()
    ran = 0
    i = 0
    while i < tbAdspCycles {
        err = tbAdspLsnCycle(dspRef)
        if err != 0 {
            detail = "listener cycle " + tkIntToStr(i) + " err " + tkIntToStr(err)
            return tkFail("AdspLeak", detail)
        }
        ran = ran + 1
        i = i + 1
    }
    after = FreeMem()
    if after != before or ran != tbAdspCycles {
        detail = "listener before " + tkIntToStr(before) + " after " + tkIntToStr(after)
        detail = detail + " cycles " + tkIntToStr(ran)
        return tkFail("AdspLeak", detail)
    }

    return tkPass("AdspLeak")
}

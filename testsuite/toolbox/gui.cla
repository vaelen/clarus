// gui.cla: the toolbox suite's Mac GUI front-end, and its ONLY front-end
// (test-suite-review Task 11) -- unlike the core suite, there is no CLI:
// every real case here needs a live window (MenuKeyMatches needs the
// installed File menu; CanvasChecksum needs the Board canvas), so a
// front-end without a window makes no sense for this suite. Mirrors
// testsuite/core/gui.cla's own shape (table of case names, Run All / Run
// Selected buttons, status pane, tkReport-funneled log, TestLog.txt)
// with `tb`-prefixed identifiers, plus one extra widget core's gui.cla
// doesn't need: the Board canvas CanvasChecksum draws into.
//
// Live progress (ui-widgets Task 12): Run All / Run Selected only queue
// the selection; the `every 1 ticks` timer below runs ONE case per tick,
// so the window repaints between cases, and the Status logpanel shows
// each PASS/FAIL line as its case finishes. The tkReport alerts and
// TestLog.txt still come out once, at the end, in the same order and
// bytes as when every case ran inside the click handler. In a scripted
// boot a timer fires only on a `tick` line, so toolboxsuite.events (and
// its jiggle twin) carry one `tick 1` per case after the click, plus
// slack: a script with fewer ticks than cases quits mid-run, and the
// gate's TOTAL check fails loudly.
//
// Every widget uses an explicit, fixed `at:` (no `right`/`next` relative
// placement), same convention and same derivation as
// testsuite/core/gui.cla's own header comment: for a window that fits on
// screen without any clamp (44 + 280 + 2 <= 342, true here), content
// top-left = ((512 - width) / 2, 44) (ui.cla's rtUiOpen). This window's
// `size: 440, 280` -> content top-left ((512-440)/2, 44) = (36, 44).
//
//   table Cases  local (10,10)-(310,130)  [default 300x120]
//   button RunAll        local (10,140)-(90,160)
//   button RunSelected   local (100,140)-(180,160)
//   canvas Board local (12,170)-(212,270) [default 200x100]
//   logpanel Status      local (222,170)-(422,270) [default 200x100]
//
// -> global:
//   RunAll      (46,184)-(126,204), center (86,194)  -- toolboxsuite.events' `click 86 194`
//   RunSelected (136,184)-(216,204), center (176,194)
//   Board       (48,214)-(248,314) -- cases_draw.cla's tbCanvasX0/tbCanvasY0
//     hard-codes Board's top-left (48,214); Board's own local `at: 12,
//     170` was chosen so 36+12=48 is a multiple of 8 (see cases_draw.cla's
//     header comment for why that matters to the checksum).
//   Status      (258,214)-(458,314)
//
// Nothing overlaps: Board and Status sit side by side with a 10px gap
// (212 to 222 locally), and both sit well below the table+buttons and
// well clear of the window's own title bar / the screen's menu bar (both
// entirely outside the content area this math describes) -- so
// CanvasChecksum's read-back region can never be clobbered by any other
// widget's own drawing.

record TbCaseRow {
    name: string(63)
}

var caseRows: list of TbCaseRow
var caseOrder: list of ToolboxTest

window Suite {
    title: "Toolbox Suite"
    size: 440, 280

    table Cases {
        at: 10, 10
        rows: caseRows
        column "Name" shows name width fill
    }
    button RunAll      { at: 10, 140;  caption: "Run All" }
    button RunSelected { at: 100, 140; caption: "Run Selected" }
    canvas Board       { at: 12, 170 }
    logpanel Status    { at: 222, 170; scrollbar: both }
}

menu File {
    item Quit "Quit" key "Q"
}

// The run queue: tbQueue[tbQPos..] are still to run, tbQResults holds
// what has run, in order. tbQBusy keeps a case's own UiTestTick (which
// pumps timers in a scripted boot) from re-entering the timer.
var tbQueue: list of ToolboxTest
var tbQResults: list of TestResult
var tbQPos: int
var tbQBusy: bool

// tbQueueRun starts a run of sel, unless one is still going. tbCasesRun
// (runner.cla) counts across the run's single-case calls, for SelfCheck.
func tbQueueRun(w: Suite, sel: list of ToolboxTest) {
    var t: ToolboxTest

    if tbQPos < tbQueue.count {
        return
    }
    tbQueue.clear()
    tbQResults.clear()
    for t in sel {
        tbQueue.add(t)
    }
    tbQPos = 0
    tbCasesRun = 0
    w.Status.clear()
}

// The queue's timer runs the next queued case and shows its line; after
// the last one, tbFinish reports the whole run.
every 1 ticks {
    var w: Suite = Suite.front
    var one: list of ToolboxTest
    var r: TestResult

    if tbQBusy or tbQPos >= tbQueue.count {
        return
    }
    tbQBusy = true
    one.add(tbQueue[tbQPos])
    tbQPos = tbQPos + 1
    for r in runToolboxTests(one) {
        tbQResults.add(r)
        if w != nil {
            w.Status.appendLine(tbResultLine(r))
        }
    }
    if tbQPos >= tbQueue.count {
        tbFinish(w)
    }
    tbQBusy = false
}

func tbResultLine(r: TestResult): string {
    if r.passed {
        return "PASS " + r.name
    }
    return "FAIL " + r.name + ": " + r.detail
}

// tbFinish: the TOTAL line on the Status panel AND in TestLog.txt, with
// every PASS/FAIL line before it, and the same results funneled through
// kit.cla's tkReport so every line ALSO alert()s (the scripted boot's
// captured console, which tests/mactest/toolbox_68k.sh parses). Does NOT
// quit on a fail -- interactive GUI, a fail should show in the log, not
// end the session.
func tbFinish(w: Suite) {
    var r: TestResult
    var log: text
    var fails: int
    var total: int
    var line: string
    var ok: bool

    for r in tbQResults {
        log.append(tbResultLine(r))
        log.append("\n")
    }
    fails = tkReport(tbQResults)
    total = tbQResults.count
    line = "TOTAL " + tkIntToStr(total)
    line = line + " PASS " + tkIntToStr(total - fails)
    line = line + " FAIL " + tkIntToStr(fails)
    log.append(line)
    if w != nil {
        w.Status.appendLine(line)
    }
    ok = file.writeText("TestLog.txt", log, app.doctype, app.id)
}

on App.startEmpty {
    var t: ToolboxTest
    var row: TbCaseRow

    for t in tbAllCases() {
        row.name = tbCaseName(t)
        caseRows.add(row)
        caseOrder.add(t)
    }
    open Suite
}

extend Suite {
    on RunAll.click {
        tbQueueRun(window, tbAllCases())
    }
    on RunSelected.click {
        var sel: list of ToolboxTest
        var idx: int

        idx = Cases.selected
        if idx >= 0 {
            sel.add(caseOrder[idx])
            tbQueueRun(window, sel)
        }
    }
}

extend File {
    on Quit.select { quit }
}

// harness.cla: UiProbe (Task 3, ui-scenario-retirement) -- a minimal
// probe window cases_uitest.cla's own UiTestVerbSmoke/PostEventClick
// cases open, click, and close, exercising the `UiTest*` driver surface
// (runtime/clarus/uitest.cla, Task 2) and a REAL PostEvent-delivered
// click against a real widget inside a booted program -- the same "real
// Toolbox trap or real framebuffer read" bar every other case in this
// suite already clears (runner.cla's own header comment). PatBoard
// (Task 4, ui-scenario-retirement pilot) is this file's second window: a
// transcription of the retired testdata/ui/pattern.cla fixture's canvas +
// `on opened` drawing, re-laid-out so every checksummed region (cases_
// pattern.cla) sits on an 8px-aligned local x/width -- see PatBoard's own
// comment below for the geometry derivation. Its own tb-prefixed
// geometry/expected-checksum constants live in cases_pattern.cla, same
// split as cases_draw.cla's tbCanvasX0/tbCanvasY0 (gui.cla's Board is
// declared with no case-owned constants of its own either).
//
// tbPokeCenterX/tbPokeCenterY: Poke's GLOBAL screen center, worked the
// same way testsuite/toolbox/gui.cla's own header comment derives
// RunAll's (46,184)-(126,204), center (86,194): windows only ever CENTER
// (no window `at:` position property; Chapter 8), so for this window's
// fixed `size: 300, 120` the content top-left is ((512-300)/2, 44) =
// (106, 44) (ui.cla's rtUiOpen). Poke's own `at: 10, 10` with the button
// widget's default size (rtUiButtonW/H = 80x20,
// runtime/clarus/uiwidgets.cla) gives a LOCAL rect (10,10)-(90,30) ->
// GLOBAL (116,54)-(196,74), center (156,64).
const tbPokeCenterX: int = 156
const tbPokeCenterY: int = 64

window UiProbe {
    title: "UiProbe"
    size: 300, 120

    button Poke { at: 10, 10; caption: "Poke" }

    var pokes: int = 0
}

extend UiProbe {
    on Poke.click {
        // Bare name, not `window.pokes = ...` -- a per-instance var's
        // ONLY assignable form inside `extend` is the bare (implicit)
        // name (Ch8: "bare names resolve first against the firing
        // instance's properties, fields, and widgets"); `window` itself
        // is its own expression kind (ExWindowSelf, parse.cla's own
        // isLvalue doc comment), readable but never an assignment target
        // -- see testdata/emitui/handlers.cla's own header comment for
        // this exact gap.
        pokes = pokes + 1
    }
}

// PatBoard (Task 4, ui-scenario-retirement pilot): transcribed from the
// retired testdata/ui/pattern.cla, same buffered-canvas-painted-once-
// from-`opened` shape, re-laid-out on an 8px grid so cases_pattern.cla's
// checksummed regions land byte-aligned (UiTestChecksum's x/w-multiple-
// of-8 contract) WITHOUT any partial-byte masking. `size: 224, 64` ->
// content top-left ((512-224)/2, 44) = (144, 44) (ui.cla's rtUiOpen, same
// derivation as tbPokeCenterX/tbPokeCenterY above) -- 144 is itself a
// multiple of 8, so every LOCAL x below (already a multiple of 8) stays
// aligned once translated to GLOBAL screen coordinates, with no further
// arithmetic needed at the call site.
//
// Local layout (Canvas is `at: 0, 0; fill: both`, so local == content
// coordinates):
//   ramp:       9 levels (0..8), each a 16x16 swatch at x = 8 + lvl*24,
//               y = 8 -- bounding box (8,8)-(216,24), width 208 (8 + 8
//               swatches * 24 spacing + 16 swatch width - 8 start = 208).
//   clampLow:   pattern(-3) (clamps to 0, matching ramp level 0) filled
//               at (8,32)-(24,48).
//   clampHigh:  pattern(99) (clamps to 8, matching ramp level 8) filled
//               at (32,32)-(48,48).
//   oval:       pattern(4) (mid-gray) fillCircle centered (72,40) radius
//               8 -- bounding box (64,32)-(80,48) (UiFillOval path).
//   frame:       rect (frame, not fill) at (88,32)-(104,48) -- UiFrameRect
//               ignores the current fill pattern entirely (rtUiCanvasRect,
//               runtime/clarus/uiwidgets.cla), proving frames stay a
//               plain black outline regardless of `pattern`.
// None of the five regions overlap; each sits in its own 24px (ramp) or
// 24px (row two) column.
window PatBoard {
    title: "PatBoard"
    size: 224, 64

    canvas Canvas { at: 0, 0; fill: both; buffered }
}

extend PatBoard {
    on opened {
        var lvl: int
        lvl = 0
        while lvl <= 8 {
            Canvas.pattern(lvl)
            Canvas.fillRect(8 + lvl * 24, 8, 16, 16)
            lvl = lvl + 1
        }
        Canvas.pattern(-3)
        Canvas.fillRect(8, 32, 16, 16)
        Canvas.pattern(99)
        Canvas.fillRect(32, 32, 16, 16)
        Canvas.pattern(4)
        Canvas.fillCircle(72, 40, 8)
        Canvas.rect(88, 32, 16, 16)
    }
}

// ButtonsPanel (Task 5, ui-scenario-retirement batch): byte-safe
// transcription of the retired testdata/ui/buttons.cla's Panel window --
// same widgets, same `Go.click`/`key` handler bodies -- plus
// INSTRUMENTATION-ONLY additions (the global `tbButtonsLog` string this
// file's tail declares below, appended to from here and from the
// closeRequest/closed handlers cases_buttons.cla's own header comment
// explains) needed because the retired scenario's assertion was an
// external trace log (`T FIRE Panel.Go.click` etc.), and nothing in the
// `UiTest*` surface can read that log back from inside a running program
// -- a case has to build its own record of what fired, in what order,
// instead. closeRequest/closed are ADDED here (the original buttons.cla
// declares neither) purely to log "close cascade reached here"; declaring
// them changes no observable behavior (neither calls `cancel`, so the
// close proceeds exactly as it would with no handler at all -- Ch5's own
// `cancel`-is-the-only-way-to-alter-a-closeRequest's-outcome rule).
// size: 300, 160 -> content top-left ((512-300)/2, 44) = (106, 44), same
// derivation as tbPokeCenterX/tbPokeCenterY above. Go/Status's own
// geometry constants live in cases_buttons.cla (same file split as
// PatBoard's own tb-prefixed constants in cases_pattern.cla, per this
// file's own header comment). Status's own SET assertion (the retired
// trace's "T SET Panel.Status.text Clicked" line) is read back via a
// UiTestChecksum before/after inequality, not a direct `Status.text`
// read: clarusc's own `lowWidgetPropGet` (clarusc/lower.cla) has no
// get_str path for `label` yet ("read of label.text (not yet
// implemented)", confirmed by trying it) -- only field.text/
// textview.text reads are wired up so far.
window ButtonsPanel {
    title: "Panel"
    size: 300, 160
    resizable: min(220, 120)

    button Go    { at: 20, 20; caption: "Go"; width: 80 }
    check On     { at: right, 22; caption: "On" }
    label Status { at: next, bottom; text: "Off" }
}

extend ButtonsPanel {
    on Go.click {
        On.checked = true
        Status.text = "Clicked"
        tbButtonsLog = tbButtonsLog + "G"
    }
    on key(k: char) {
        title = "Typed"
        tbButtonsLog = tbButtonsLog + "K"
    }
    on resized {
        tbButtonsLog = tbButtonsLog + "R"
    }
    on closeRequest {
        tbButtonsLog = tbButtonsLog + "Q"
    }
    on closed {
        tbButtonsLog = tbButtonsLog + "D"
    }
}

// LogWin (Task 5, ui-scenario-retirement batch): byte-safe transcription
// of the retired testdata/ui/winvar.cla -- SAME window-scope `var log:
// text` with no initializer and, critically, NO `on opened` handler at
// all (the whole point of the retired scenario: `log`'s rt_text handle is
// constructed solely by clarusc's fabricated `opened` glue, not the
// explicit-`on opened` path -- see winvar.cla's own retired header
// comment for the full pre-fix NULL-dereference regression this pins).
// Nothing added here beyond the original fixture's own two widgets/one
// handler -- no instrumentation needed, since caseWinvar's own assertion
// (cases_winvar.cla) reads Body.text and a framebuffer checksum directly,
// both already reachable from outside the window without extra logging.
// size: 300, 200 -> content top-left (106, 44), same derivation as
// ButtonsPanel above (same window width).
window LogWin {
    title: "Log"
    size: 300, 200

    button Add    { at: 20, 20; caption: "Add"; width: 80 }
    textview Body { at: 20, bottom; fill: both }

    var log: text
}

extend LogWin {
    on Add.click {
        log.append("clicked")
        Body.text = log
    }
}

// TextWin (Task 5, ui-scenario-retirement batch): byte-safe transcription
// of the retired testdata/ui/textwidgets.cla -- same four widgets, same
// four original handler bodies (Name.change/Name.enter/Body.change/
// Fill32000.click/Fill32001.click, all UNCHANGED), plus two
// INSTRUMENTATION-ONLY counters (`nameChanges`/`bodyChanges`, same
// rationale as ButtonsPanel's `tbButtonsLog` above) since the retired
// scenario's golden trace asserted an EXACT fire count for
// Name.change (5, one per typed letter of "Hello") and Body.change (9:
// 8 typed letters of "Hi there" plus one CR insertion), and nothing in
// the `UiTest*` surface can read a fire count back other than a
// case-added counter. size: 400, 280 -> content top-left
// ((512-400)/2, 44) = (56, 44).
window TextWin {
    title: "Text"
    size: 400, 280

    field Name       { label: "Name:"; at: 20, 20; width: 140 }
    button Fill32000 { at: right, 20; caption: "32000" }
    button Fill32001 { at: right, 20; caption: "32001" }
    textview Body    { at: 20, bottom; fill: both; scrollbar: vertical }

    var nameStr: string
    var bodyText: text
    var nameChanges: int = 0
    var bodyChanges: int = 0
}

extend TextWin {
    on Name.change {
        nameStr = Name.text
        nameChanges = nameChanges + 1
    }
    on Name.enter {
        Name.text = nameStr
        title = "Entered"
    }
    on Body.change {
        bodyText = Body.text
        bodyChanges = bodyChanges + 1
    }
    on Fill32000.click {
        var t: text
        var got: text
        var i: int

        // A space every 8th byte, not one giant 32,000-byte word: classic
        // TextEdit's line-wrap hunts backward for a break point, and a
        // single pathologically long word (no whitespace at all) makes
        // that hunt effectively quadratic -- observed hanging TECalText
        // for minutes on real m68k hardware during this task's own
        // development. The byte count (what the clamp test cares about)
        // is unaffected by content shape.
        i = 0
        while i < 32000 {
            if i mod 8 == 7 {
                t.append(' ')
            } else {
                t.append('x')
            }
            i = i + 1
        }
        Body.text = t
        got = Body.text
        if got.length == 32000 and lastError.code == 0 {
            title = "ok:32000"
        } else {
            title = "FAIL:32000"
        }
    }
    on Fill32001.click {
        var t: text
        var got: text
        var i: int

        // Same spaced-content shape as Fill32000.click above (see its
        // comment) -- one byte over the clamp.
        i = 0
        while i < 32001 {
            if i mod 8 == 7 {
                t.append(' ')
            } else {
                t.append('x')
            }
            i = i + 1
        }
        Body.text = t
        got = Body.text
        if got.length == 32000 and lastError.code != 0 {
            title = lastError.message
        } else {
            title = "FAIL:32001"
        }
    }
}

// MenuMain/MenuAux/Ops (Task 6, ui-scenario-retirement batch): transcribed
// from the retired testdata/ui/menus.cla -- Main/Aux renamed MenuMain/
// MenuAux (every window/menu name in this suite's ONE compiled program
// must be globally unique, Ch1's declare-before-use rule; "Main"/"Aux"
// were free in that scenario's own standalone build but collide with
// nothing here only because they're renamed). Ops's three real items
// (NewAux/Toggle/Scoped) are unchanged. Two deliberate DROPS from the
// retired fixture, both disclosed in task-6-report.md:
//   - The Quit item (`item Quit "Quit" key "Q"`) and its `on Quit.select
//     { quit }` handler: firing a real `quit` STATEMENT mid-case would
//     tear down the whole toolbox suite process before later cases and
//     the final report run -- UiTestVerb only rejects the literal script
//     control-verb string "quit" (uitest.cla's own header comment), not
//     an app handler that happens to execute one when dispatched via
//     `menu`. The retired fixture's own cancel-then-succeed quit-cascade
//     semantics stay covered by testdata/ui/texteditor.events' own
//     quit-cascade tail (audit row N15 MERGE->N14, test-consolidation
//     2026-08-06), so nothing is left unverified.
//   - Toggle's own widget mutation (Main.On.checked/Main.Status.text):
//     ButtonsPanel/cases_buttons.cla already cover check/label mutation
//     end to end; this window's job is purely menu dispatch + scope
//     dimming (cases_menus.cla's own global counters below).
// No widgets, so no geometry constants -- cases_menus.cla asserts purely
// through UiTestMenu's own return value and the dispatch counters.
window MenuMain {
    title: "MenuMain"
    size: 200, 100
}

window MenuAux {
    title: "MenuAux"
    size: 200, 100
}

// Ops is declared here (harness.cla), the file list's own position
// (internal/mactest/coresuite_test.go's toolboxFiles) BEFORE gui.cla's
// `menu File` -- rt_ui_build_menus (ui.cla) inserts every declared menu
// into the real bar in whole-program declaration order, so Ops lands at
// bar position 2 (Apple is always 1), Edit (below) at 3, File at 4 --
// see cases_menus.cla's own header comment for the full derivation and
// why Quit's key equivalent had to be dropped above to avoid colliding
// with File's own `key "Q"` under cases_events.cla's real-hardware
// TbMenuKey probe.
menu Ops {
    item NewAux "New Aux" key "N"
    item Toggle "Toggle"  key "T"
    item Scoped "Scoped"  key "S"
}

extend Ops {
    on NewAux.select {
        open MenuAux
        tbMenuNewAuxCount = tbMenuNewAuxCount + 1
    }
    on Toggle.select {
        tbMenuToggleCount = tbMenuToggleCount + 1
    }
}

extend MenuAux {
    extend Ops {
        on Scoped.select {
            tbMenuScopedCount = tbMenuScopedCount + 1
        }
    }
}

// EditMain/Edit (Task 6, ui-scenario-retirement batch): transcribed from
// the retired testdata/ui/editmenu.cla -- Main renamed EditMain (same
// global-uniqueness reason as MenuMain/MenuAux above), same two
// textviews (A above B), same `menu Edit { standard edit }`. `size: 300,
// 260` is UNCHANGED from the retired fixture's own standalone build, so
// its content top-left stays ((512-300)/2, 44) = (106, 44) -- rt_ui_open
// centers purely on a window's own width, independent of whatever else
// is compiled alongside it -- meaning editmenu.events' own click/drag
// coordinates carry over VERBATIM into cases_editmenu.cla with no
// re-derivation. aChanges/bChanges are ADDED instrumentation (same
// nameChanges/bodyChanges convention as TextWin above): the retired
// scenario's assertion needs both an exact fire count (typing "Hello
// World" fires A.change 11 times) and a NO-fire pin (Copy must not
// increment either counter), neither observable any other way.
window EditMain {
    title: "Edit Demo"
    size: 300, 260

    textview A { at: 20, 20 }
    textview B { at: 20, bottom }

    var aChanges: int = 0
    var bChanges: int = 0
}

menu Edit {
    standard edit
}

extend EditMain {
    on A.change {
        aChanges = aChanges + 1
    }
    on B.change {
        bChanges = bChanges + 1
    }
}

// CanvasWin (Task 7, ui-scenario-retirement batch): byte-safe
// transcription of the retired testdata/ui/canvas.cla -- Anim renamed
// CanvasWin (same global-uniqueness reason as MenuMain/EditMain above),
// same buffered canvas, same `every 4 ticks` step (dx=3), same bounce
// clamp at either edge (unreachable by cases_canvas.cla's own case, which
// never ticks far enough to reach it, but kept unchanged from the retired
// fixture rather than trimmed). Unlike the retired fixture (`on
// App.launch { open Anim }`, opened once at boot), CanvasWin is opened
// MID-CASE by caseCanvas -- see cases_canvas.cla's own header comment for
// why the every-block still fires correctly regardless of when the window
// opens or which window is actually frontmost on screen.
window CanvasWin {
    title: "Canvas"
    size: 160, 160

    canvas Board { at: 0, 0; fill: both; buffered }

    var x: int
    var dx: int
}

extend CanvasWin {
    on opened {
        x = 10
        dx = 3
    }
}

every 4 ticks {
    var g: CanvasWin = CanvasWin.front
    if g != nil {
        g.x = g.x + g.dx
        if g.x < 0 {
            g.x = 0
            g.dx = -g.dx
        } else if g.x + 20 > g.Board.width {
            g.x = g.Board.width - 20
            g.dx = -g.dx
        }
        g.Board.clear()
        g.Board.fillRect(g.x, 60, 20, 20)
    }
}

// ZoomWin (Task 7, ui-scenario-retirement batch): transcription of the
// retired testdata/ui/zoomwin.cla -- Panel renamed ZoomWin (same
// global-uniqueness reason as above), same single `textview Body { ...
// scrollbar: vertical }`. ONE deliberate departure from a byte-safe
// transcription, disclosed here: the retired fixture left Body's text
// empty (its own S1!=S2/S1==S3 assertion came from a whole-window pixel
// snap, sensitive to ANY geometry change, however small). This case's own
// checksum needs a substantial, reliably-placed region -- an EMPTY
// textview's vertical scrollbar renders "thumbless" (confirmed against a
// real interactive boot + screenshot before writing this: the track is
// flat white, only the two tiny arrow glyphs are non-blank), which is too
// sparse a signal for a robust checksum region. `on opened` here sets a
// multi-sentence paragraph instead, so word wrap (Chapter 8: `scrollbar:
// vertical` wraps at the view's width) reflows completely differently
// between the narrow (300px) and zoomed-out (near full screen) widths --
// see cases_zoomwin.cla's own header comment for the checksum-region
// derivation against this text.
window ZoomWin {
    title: "Zoom"
    size: 300, 200
    resizable: min(200, 120)

    textview Body { at: 10, 10; fill: both; scrollbar: vertical }
}

extend ZoomWin {
    on opened {
        Body.text = "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs. How vexingly quick daft zebras jump. The five boxing wizards jump quickly."
    }
}

// HScrollWin/HFitWin (Task 7, ui-scenario-retirement batch): HScrollWin is
// a byte-safe transcription of the retired testdata/ui/hscroll.cla --
// HWin renamed HScrollWin (same global-uniqueness reason as above), same
// `textview Body { ... scrollbar: both }` (Chapter 8: `scrollbar: both`
// turns word wrap off), same `opened` literal (unchanged, no longer needs
// routing through a handler-local `text` var -- see the retired fixture's
// own header comment on the two clarusc-ui-gaps this literal assignment
// pins, both fixed before this branch). HFitWin is a NEW second window
// (not a transcription of anything retired), added per the task brief's
// own "thumbless-when-fits" sub-assertion -- same shape as HScrollWin, but
// `opened` sets a short line that fits entirely inside the view with
// nothing to scroll. See cases_hscroll.cla's own header comment for the
// full three-sub-test assertion mapping.
window HScrollWin {
    title: "HScroll"
    size: 300, 200
    resizable: min(200, 120)

    textview Body { at: 10, 10; fill: both; scrollbar: both }
}

extend HScrollWin {
    on opened {
        Body.text = "The quick brown fox jumps over the lazy dog and keeps running well past the right edge of the view rectangle"
    }
}

window HFitWin {
    title: "HFit"
    size: 300, 200
    resizable: min(200, 120)

    textview Body { at: 10, 10; fill: both; scrollbar: both }
}

extend HFitWin {
    on opened {
        Body.text = "Fits."
    }
}

// PopupTableWin (Task 8, ui-scenario-retirement batch): byte-safe
// transcription of the retired testdata/ui/popuptable.cla's Main window --
// Main renamed PopupTableWin (same global-uniqueness reason as MenuMain/
// EditMain above), same table/four buttons, same Marks.select/
// doubleClick/Add.click/Remove.click/SetSel.click/ReadSel.click bodies.
// ONE deliberate departure, disclosed here: `Result` is a `field`, not the
// retired fixture's own `label` -- clarusc's lowWidgetPropGet (Task 5's
// own cases_buttons.cla comment, still true) has no get_str path for
// `label`, only `field`/`textview`; a `field`'s own text is directly
// readable (IUiGetFieldText), letting cases_popuptable.cla assert the
// EXACT bookmark name a click resolved to instead of a mere checksum
// inequality (weaker: would only prove SOMETHING changed, not that the
// right row was picked). `tbPtLog` (cases_popuptable.cla's own global, not
// a window-scope var -- same "read after the window that recorded it may
// already be gone" reasoning as cases_buttons.cla's tbButtonsLog) is
// INSTRUMENTATION ONLY, appended to from Marks.select/doubleClick so the
// case can prove select-then-doubleClick ordering (and SetSel's own
// silent-write contract) the same way GKRQD proved Buttons' full handler
// order.
//
// `size: 420, 290` and `table Marks { at: 10, 10; ... }` are UNCHANGED
// from the retired fixture -- rt_ui_open's screen-centering depends only
// on a window's own size (ui.cla's rtUiOpen: `left = (screenW-reqW)/2`,
// `top` is the FIXED constant 44, never height-dependent -- confirmed by
// reading rtUiOpen directly), so PopupTableWin's content top-left is
// ((512-420)/2, 44) = (46, 44), and the table's own natural (no `size:`
// given) 300x120 box sits at LOCAL (10,10)-(310,130) -> GLOBAL
// (56,54)-(356,174) -- byte-identical to the retired popuptable.cla's own
// geometry. That means every row-click coordinate the retired
// popuptable.events already proved correct (row i's click center =
// tableGlobalTop(54) + headerH(20) + i*rowH(16) + rowH/2(8) = 82 + i*16 --
// row0=82, row1=98, row3=130) carries over verbatim into
// cases_popuptable.cla with no re-derivation, same reuse precedent as
// formedit.cla's own retired header comment already established for its
// own Main. Add/Remove/SetSel/ReadSel are given fresh EXPLICIT `at:`
// coordinates (unlike the retired fixture's own `at: 10, bottom`/`at:
// next, bottom` auto-layout chain) so every button click below is
// arithmetic from known constants, not a re-derivation of that chain's
// own semantics -- see cases_popuptable.cla's own header comment for the
// button-center math.
//
// TbPtBookmark/tbPtBookmarks (the record/global list `table Marks` binds
// to) MUST be declared here, ahead of the window -- `rows:` is a
// type-layout position (Ch1's declare-before-use: "a top-level
// variable's declared type ... may only name types declared textually
// before them" extends to a table's own row-type binding), unlike an
// ordinary handler-body reference like tbPtLog below (cases_popuptable.
// cla), which is body-scope and whole-program-visible regardless of file
// order. Same shape as the retired fixture's own record/var, renamed to
// this suite's `tb`-prefixed convention.
record TbPtBookmark {
    name:     string(63)
    url:      string(255)
    favorite: bool
}

var tbPtBookmarks: list of TbPtBookmark

window PopupTableWin {
    title: "PopupTable"
    size: 420, 290

    table Marks {
        at: 10, 10
        rows: tbPtBookmarks
        column "Name" shows name     width 140
        column "URL"  shows url      width fill
        column "Fav"  shows favorite width 30
    }
    button Add     { at: 10, 145;  caption: "Add" }
    button Remove  { at: 98, 145;  caption: "Remove" }
    button SetSel  { at: 186, 145; caption: "SetSel" }
    button ReadSel { at: 274, 145; caption: "ReadSel" }
    field Result   { at: 10, 175; label: "Result:"; width: 200 }
}

extend PopupTableWin {
    on Marks.select(i: int) {
        tbPtLog = tbPtLog + "s"
        Result.text = tbPtBookmarks[i].name
    }
    on Marks.doubleClick(i: int) {
        tbPtLog = tbPtLog + "d"
        Result.text = "dbl:" + tbPtBookmarks[i].name
    }
    on Add.click {
        var b: TbPtBookmark

        b.name = "Delta"
        b.url = "delta.com"
        b.favorite = true
        tbPtBookmarks.add(b)
    }
    on Remove.click {
        tbPtBookmarks.remove(Marks.selected)
    }
    on SetSel.click {
        Marks.selected = 1
    }
    on ReadSel.click {
        var s: int

        s = Marks.selected
        if s == 0 {
            title = "sel0"
        } else if s == 1 {
            title = "sel1"
        } else if s == 2 {
            title = "sel2"
        } else if s == 3 {
            title = "sel3"
        } else {
            title = "selNone"
        }
    }
}

// DialogsWin (Task 9, ui-scenario-retirement batch): byte-safe
// transcription of the retired testdata/ui/dialogs.cla -- Doc renamed
// DialogsWin (same global-uniqueness reason as MenuMain/EditMain/
// PopupTableWin above), same four buttons + Body textview + `path`
// per-instance var, same OpenBtn.click/SaveBtn.click/AskBtn.click/
// ClearBtn.click bodies verbatim (askOpen/askSave/askSaveChanges end to
// end; SaveBtn.click's `title = path` then bare `title` READ-back is the
// retired fixture's own "Task 4b breadcrumb" -- see its header comment --
// kept unchanged here). ONE deliberate departure, disclosed here: `Status`
// is a `field`, not the retired fixture's own `label` -- same
// `lowWidgetPropGet` gap PopupTableWin's own Result field already
// disclosed (Task 8, this file's own PopupTableWin comment above): no
// get_str path for `label`, only `field`/`textview`. Status cycles
// through SEVEN distinct strings across this scenario's own walkthrough
// (below) -- a `field`'s directly-readable `.text` lets cases_dialogs.cla
// assert each one by exact equality instead of Task 5's own
// checksum-inequality workaround (cases_buttons.cla's tbButtonsStatus
// pattern), which only proves SOMETHING changed, not which of seven
// possible strings landed.
//
// Unlike the retired fixture (`on App.launch { open Doc }`, opened once
// at boot), DialogsWin is opened MID-CASE by caseDialogs -- same
// "opened on demand, not at App.launch" convention as every other
// harness.cla window (CanvasWin's own comment above). `size: 400, 260`
// and every widget's `at:` are UNCHANGED from the retired fixture, so
// OpenBtn/SaveBtn/AskBtn/ClearBtn's global click centers (already proven
// correct by that fixture's own passing history: (116,74)/(204,74)/
// (292,74)/(380,74)) carry over verbatim into cases_dialogs.cla. Body's
// own click point (100,150) also carries over: Status's +4px height
// (field's rtUiFieldH=20 vs label's rtUiLabelH=16, uiwidgets.cla) shifts
// Body's own top edge down by the same 4px (GLOBAL (76,120)-(448,296)
// instead of (76,116)-(448,296)), but (100,150) sits comfortably inside
// either box, so the retired click point still lands inside Body's own
// text area unchanged -- see cases_dialogs.cla's own header comment for
// the full assertion-mapping table.
window DialogsWin {
    title: "Dialogs"
    size: 400, 260

    button OpenBtn  { at: 20, 20; caption: "Open" }
    button SaveBtn  { at: right, 20; caption: "Save" }
    button AskBtn   { at: right, 20; caption: "Ask" }
    button ClearBtn { at: right, 20; caption: "Clear" }
    field Status    { at: 20, bottom }
    textview Body   { at: 20, bottom; fill: both }

    var path: string(255)
}

extend DialogsWin {
    on OpenBtn.click {
        var t: text
        if askOpen(path, app.doctype) {
            file.readText(path, t)
            Body.text = t
            Status.text = "opened"
        } else {
            Status.text = "open-cancel"
        }
    }
    on SaveBtn.click {
        if askSave(path, "untitled.txt") {
            file.writeText(path, Body.text, app.doctype, app.id)
            title = path
            // Task 4b breadcrumb, kept verbatim from the retired fixture:
            // bare `title` READ right after the write above, through a
            // REAL GetWTitle call (rt_ui_get_title), not a cached copy.
            Status.text = "saved: " + title
        } else {
            Status.text = "save-cancel"
        }
    }
    on AskBtn.click {
        var c: saveChoice
        c = askSaveChanges("Doc")
        if c == Save {
            Status.text = "changes-save"
        } else if c == Discard {
            Status.text = "changes-discard"
        } else {
            Status.text = "changes-cancel"
        }
    }
    on ClearBtn.click {
        Body.text = ""
    }
}

// DimWin (Task 9, ui-scenario-retirement batch): byte-safe transcription
// of the retired testdata/ui/hdim.cla (fix-hbar) -- no rename needed (no
// existing DimWin in this file). Same single `textview Body { at: 10,
// 10; fill: both; scrollbar: both }`, same deliberately-empty
// `on opened { }` -- an empty textview's V bar has always had maxScroll
// 0 (nothing to scroll); the H bar now matches it (content-based range,
// rt_ui_te_widest_line returns 0 for an empty TE), so BOTH bars must
// render thumbless (the standard scrollbar CDEF's inactive state,
// maxScroll == minScroll == 0) -- this scenario asserts exactly that
// rendering, not a behavior change. DimWin's `size: 300, 200` plus
// Body's own `at:`/`fill:`/`scrollbar:` triple are BYTE-IDENTICAL to
// Task 7's own HScrollWin (this file's own HScrollWin/HFitWin comment
// above), so its content top-left ((512-300)/2, 44) = (106, 44)) and its
// scrollbar-lane geometry (rtUiTeRelayout, runtime/clarus/uitext.cla)
// are the SAME already-derived numbers -- see cases_hdim.cla's own
// header comment for the reused derivation and the pinned checksum
// constants.
window DimWin {
    title: "Dim"
    size: 300, 200

    textview Body { at: 10, 10; fill: both; scrollbar: both }
}

extend DimWin {
    on opened { }
}

// FormEditWin (Task 3, test-consolidation): the migrated replacement for
// the retired testdata/ui/formedit.cla golden UI scenario -- form
// windows, `binds:`, and the `edit`/`accepted(rec)` round trip end to
// end, all five bound-widget kinds a form supports (field/string,
// field/int, popup/enum, check/bool). Only formedit.cla's OWN EditForm
// window is transcribed here (title/size/every widget's `at:` BYTE-
// IDENTICAL, see cases_formedit.cla's own header comment for the reused
// click-coordinate derivation) -- its sibling Main (a table + Add button
// driving `edit EditForm, new Bookmark` / `edit EditForm, bookmarks[i]`
// from two different handlers) is deliberately NOT ported: table/list
// widget mechanics (select, doubleClick, add, remove) already have
// dedicated, thorough coverage in this suite's own PopupTableWin/
// casePopuptable (Task 8, above) -- porting a second table here would
// duplicate that coverage, not add to it. cases_formedit.cla drives
// FormEditWin directly via `edit FormEditWin, new TbFeBookmark` and `edit
// FormEditWin, <local var>` calls made straight from its own case
// function (same "edit/open callable from an ordinary function, not only
// from an `on` handler" precedent casePopuptable's own `w = open
// PopupTableWin` already established for `open`).
//
// TbFeProtocol/TbFeBookmark: renamed from formedit.cla's own
// Protocol/Bookmark -- enum members share this whole composed program's
// global namespace (testsuite/core/cases_enumfix.cla's own
// caseEnumGopher/caseEnumHTTP/caseEnumTelnet already establish the
// "enum members need the file's own tb/case prefix, not just the enum
// type name" convention), so bare Gopher/HTTP/Telnet would risk a
// same-suite collision even though nothing collides with them today.
// TbFeBookmark's own `favorite: bool` is declared LAST, unchanged from
// formedit.cla's own field order -- this is the trailing-bool field the
// audit's N13/R1 rows exist to keep pinned (see cases_formedit.cla's own
// header comment for the full bug history).
//
// `tbFeAccepted*`/`tbFeCancelled*`: instrumentation-only globals (same
// "read after the window that recorded it may already be gone" reasoning
// as cases_popuptable.cla's own tbPtLog comment) -- a form window closes
// ITSELF immediately after `accepted`/`cancelled` fires (confirmed by
// task-2-report.md's own capture: `FIRE Editor.accepted` / `CLOSE Editor
// 1` back to back, no separate close call), so the case function cannot
// read anything back through a `w = edit ...` handle (edit is a
// statement, not an expression -- Ch5's own grammar has no assignment
// form) once the modal returns; these globals are the only way
// cases_formedit.cla's own case function observes what the two handlers
// below saw.
enum TbFeProtocol {
    TbFeGopher
    TbFeHttp
    TbFeTelnet
}

record TbFeBookmark {
    name:     string(63)
    url:      string(255)
    port:     int = 80
    protocol: TbFeProtocol
    favorite: bool
}

var tbFeAccepted: TbFeBookmark
var tbFeAcceptedFired: bool
var tbFeAcceptedIsNew: bool
var tbFeCancelledFired: bool

window FormEditWin {
    title: "Edit Bookmark"
    size: 300, 200
    form for TbFeBookmark

    field Name  { binds: name;     label: "Name:";     at: 10, 10; width: 180 }
    field Url   { binds: url;      label: "URL:";      at: 10, 35; width: 180 }
    field Port  { binds: port;     label: "Port:";      at: 10, 60; width: 120 }
    popup Proto { binds: protocol; label: "Protocol:";  at: 10, 85 }
    check Fav   { binds: favorite; caption: "Favorite"; at: 10, 110 }

    button OK     { at: 10, 150;  default }
    button Cancel { at: 110, 150; cancel }
}

extend FormEditWin {
    on accepted(b: TbFeBookmark) {
        tbFeAccepted = b
        tbFeAcceptedIsNew = b.isNew
        tbFeAcceptedFired = true
    }
    on cancelled {
        tbFeCancelledFired = true
    }
}

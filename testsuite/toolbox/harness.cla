// harness.cla: UiProbe (Task 3, ui-scenario-retirement) -- a minimal
// probe window cases_uitest.cla's own UiTestVerbSmoke/PostEventClick
// cases open, click, and close, exercising the `UiTest*` driver surface
// (runtime/clarus/uitest.cla, Task 2) and a REAL PostEvent-delivered
// click against a real widget inside a booted program -- the same "real
// Toolbox trap or real framebuffer read" bar every other case in this
// suite already clears (runner.cla's own header comment). PatBoard
// (Task 4, ui-scenario-retirement pilot) is this file's second window: a
// transcription of the retired testdata/ui/pattern.cla fixture's canvas +
// `on opened` drawing, re-laid-out so every checksummed region (cases_
// pattern.cla) sits on an 8px-aligned local x/width -- see PatBoard's own
// comment below for the geometry derivation. Its own tb-prefixed
// geometry/expected-checksum constants live in cases_pattern.cla, same
// split as cases_draw.cla's tbCanvasX0/tbCanvasY0 (gui.cla's Board is
// declared with no case-owned constants of its own either).
//
// tbPokeCenterX/tbPokeCenterY: Poke's GLOBAL screen center, worked the
// same way testsuite/toolbox/gui.cla's own header comment derives
// RunAll's (46,184)-(126,204), center (86,194): windows only ever CENTER
// (no window `at:` position property; Chapter 8), so for this window's
// fixed `size: 300, 120` the content top-left is ((512-300)/2, 44) =
// (106, 44) (ui.cla's rtUiOpen). Poke's own `at: 10, 10` with the button
// widget's default size (rtUiButtonW/H = 80x20,
// runtime/clarus/uiwidgets.cla) gives a LOCAL rect (10,10)-(90,30) ->
// GLOBAL (116,54)-(196,74), center (156,64).
const tbPokeCenterX: int = 156
const tbPokeCenterY: int = 64

window UiProbe {
    title: "UiProbe"
    size: 300, 120

    button Poke { at: 10, 10; caption: "Poke" }

    var pokes: int = 0
}

extend UiProbe {
    on Poke.click {
        // Bare name, not `window.pokes = ...` -- a per-instance var's
        // ONLY assignable form inside `extend` is the bare (implicit)
        // name (Ch8: "bare names resolve first against the firing
        // instance's properties, fields, and widgets"); `window` itself
        // is its own expression kind (ExWindowSelf, parse.cla's own
        // isLvalue doc comment), readable but never an assignment target
        // -- see testdata/emitui/handlers.cla's own header comment for
        // this exact gap.
        pokes = pokes + 1
    }
}

// PatBoard (Task 4, ui-scenario-retirement pilot): transcribed from the
// retired testdata/ui/pattern.cla, same buffered-canvas-painted-once-
// from-`opened` shape, re-laid-out on an 8px grid so cases_pattern.cla's
// checksummed regions land byte-aligned (UiTestChecksum's x/w-multiple-
// of-8 contract) WITHOUT any partial-byte masking. `size: 224, 64` ->
// content top-left ((512-224)/2, 44) = (144, 44) (ui.cla's rtUiOpen, same
// derivation as tbPokeCenterX/tbPokeCenterY above) -- 144 is itself a
// multiple of 8, so every LOCAL x below (already a multiple of 8) stays
// aligned once translated to GLOBAL screen coordinates, with no further
// arithmetic needed at the call site.
//
// Local layout (Canvas is `at: 0, 0; fill: both`, so local == content
// coordinates):
//   ramp:       9 levels (0..8), each a 16x16 swatch at x = 8 + lvl*24,
//               y = 8 -- bounding box (8,8)-(216,24), width 208 (8 + 8
//               swatches * 24 spacing + 16 swatch width - 8 start = 208).
//   clampLow:   pattern(-3) (clamps to 0, matching ramp level 0) filled
//               at (8,32)-(24,48).
//   clampHigh:  pattern(99) (clamps to 8, matching ramp level 8) filled
//               at (32,32)-(48,48).
//   oval:       pattern(4) (mid-gray) fillCircle centered (72,40) radius
//               8 -- bounding box (64,32)-(80,48) (UiFillOval path).
//   frame:       rect (frame, not fill) at (88,32)-(104,48) -- UiFrameRect
//               ignores the current fill pattern entirely (rtUiCanvasRect,
//               runtime/clarus/uiwidgets.cla), proving frames stay a
//               plain black outline regardless of `pattern`.
// None of the five regions overlap; each sits in its own 24px (ramp) or
// 24px (row two) column.
window PatBoard {
    title: "PatBoard"
    size: 224, 64

    canvas Canvas { at: 0, 0; fill: both; buffered }
}

extend PatBoard {
    on opened {
        var lvl: int
        lvl = 0
        while lvl <= 8 {
            Canvas.pattern(lvl)
            Canvas.fillRect(8 + lvl * 24, 8, 16, 16)
            lvl = lvl + 1
        }
        Canvas.pattern(-3)
        Canvas.fillRect(8, 32, 16, 16)
        Canvas.pattern(99)
        Canvas.fillRect(32, 32, 16, 16)
        Canvas.pattern(4)
        Canvas.fillCircle(72, 40, 8)
        Canvas.rect(88, 32, 16, 16)
    }
}

// ButtonsPanel (Task 5, ui-scenario-retirement batch): byte-safe
// transcription of the retired testdata/ui/buttons.cla's Panel window --
// same widgets, same `Go.click`/`key` handler bodies -- plus
// INSTRUMENTATION-ONLY additions (the global `tbButtonsLog` string this
// file's tail declares below, appended to from here and from the
// closeRequest/closed handlers cases_buttons.cla's own header comment
// explains) needed because the retired scenario's assertion was an
// external trace log (`T FIRE Panel.Go.click` etc.), and nothing in the
// `UiTest*` surface can read that log back from inside a running program
// -- a case has to build its own record of what fired, in what order,
// instead. closeRequest/closed are ADDED here (the original buttons.cla
// declares neither) purely to log "close cascade reached here"; declaring
// them changes no observable behavior (neither calls `cancel`, so the
// close proceeds exactly as it would with no handler at all -- Ch5's own
// `cancel`-is-the-only-way-to-alter-a-closeRequest's-outcome rule).
// size: 300, 160 -> content top-left ((512-300)/2, 44) = (106, 44), same
// derivation as tbPokeCenterX/tbPokeCenterY above. Go/Status's own
// geometry constants live in cases_buttons.cla (same file split as
// PatBoard's own tb-prefixed constants in cases_pattern.cla, per this
// file's own header comment). Status's own SET assertion (the retired
// trace's "T SET Panel.Status.text Clicked" line) is read back via a
// UiTestChecksum before/after inequality, not a direct `Status.text`
// read: clarusc's own `lowWidgetPropGet` (clarusc/lower.cla) has no
// get_str path for `label` yet ("read of label.text (not yet
// implemented)", confirmed by trying it) -- only field.text/
// textview.text reads are wired up so far.
window ButtonsPanel {
    title: "Panel"
    size: 300, 160
    resizable: min(220, 120)

    button Go    { at: 20, 20; caption: "Go"; width: 80 }
    check On     { at: right, 22; caption: "On" }
    label Status { at: next, bottom; text: "Off" }
}

extend ButtonsPanel {
    on Go.click {
        On.checked = true
        Status.text = "Clicked"
        tbButtonsLog = tbButtonsLog + "G"
    }
    on key(k: char) {
        title = "Typed"
        tbButtonsLog = tbButtonsLog + "K"
    }
    on resized {
        tbButtonsLog = tbButtonsLog + "R"
    }
    on closeRequest {
        tbButtonsLog = tbButtonsLog + "Q"
    }
    on closed {
        tbButtonsLog = tbButtonsLog + "D"
    }
}

// LogWin (Task 5, ui-scenario-retirement batch): byte-safe transcription
// of the retired testdata/ui/winvar.cla -- SAME window-scope `var log:
// text` with no initializer and, critically, NO `on opened` handler at
// all (the whole point of the retired scenario: `log`'s rt_text handle is
// constructed solely by clarusc's fabricated `opened` glue, not the
// explicit-`on opened` path -- see winvar.cla's own retired header
// comment for the full pre-fix NULL-dereference regression this pins).
// Nothing added here beyond the original fixture's own two widgets/one
// handler -- no instrumentation needed, since caseWinvar's own assertion
// (cases_winvar.cla) reads Body.text and a framebuffer checksum directly,
// both already reachable from outside the window without extra logging.
// size: 300, 200 -> content top-left (106, 44), same derivation as
// ButtonsPanel above (same window width).
window LogWin {
    title: "Log"
    size: 300, 200

    button Add    { at: 20, 20; caption: "Add"; width: 80 }
    textview Body { at: 20, bottom; fill: both }

    var log: text
}

extend LogWin {
    on Add.click {
        log.append("clicked")
        Body.text = log
    }
}

// TextWin (Task 5, ui-scenario-retirement batch): byte-safe transcription
// of the retired testdata/ui/textwidgets.cla -- same four widgets, same
// four original handler bodies (Name.change/Name.enter/Body.change/
// Fill32000.click/Fill32001.click, all UNCHANGED), plus two
// INSTRUMENTATION-ONLY counters (`nameChanges`/`bodyChanges`, same
// rationale as ButtonsPanel's `tbButtonsLog` above) since the retired
// scenario's golden trace asserted an EXACT fire count for
// Name.change (5, one per typed letter of "Hello") and Body.change (9:
// 8 typed letters of "Hi there" plus one CR insertion), and nothing in
// the `UiTest*` surface can read a fire count back other than a
// case-added counter. size: 400, 280 -> content top-left
// ((512-400)/2, 44) = (56, 44).
window TextWin {
    title: "Text"
    size: 400, 280

    field Name       { label: "Name:"; at: 20, 20; width: 140 }
    button Fill32000 { at: right, 20; caption: "32000" }
    button Fill32001 { at: right, 20; caption: "32001" }
    textview Body    { at: 20, bottom; fill: both; scrollbar: vertical }

    var nameStr: string
    var bodyText: text
    var nameChanges: int = 0
    var bodyChanges: int = 0
}

extend TextWin {
    on Name.change {
        nameStr = Name.text
        nameChanges = nameChanges + 1
    }
    on Name.enter {
        Name.text = nameStr
        title = "Entered"
    }
    on Body.change {
        bodyText = Body.text
        bodyChanges = bodyChanges + 1
    }
    on Fill32000.click {
        var t: text
        var got: text
        var i: int

        // A space every 8th byte, not one giant 32,000-byte word: classic
        // TextEdit's line-wrap hunts backward for a break point, and a
        // single pathologically long word (no whitespace at all) makes
        // that hunt effectively quadratic -- observed hanging TECalText
        // for minutes on real m68k hardware during this task's own
        // development. The byte count (what the clamp test cares about)
        // is unaffected by content shape.
        i = 0
        while i < 32000 {
            if i mod 8 == 7 {
                t.append(' ')
            } else {
                t.append('x')
            }
            i = i + 1
        }
        Body.text = t
        got = Body.text
        if got.length == 32000 and lastError.code == 0 {
            title = "ok:32000"
        } else {
            title = "FAIL:32000"
        }
    }
    on Fill32001.click {
        var t: text
        var got: text
        var i: int

        // Same spaced-content shape as Fill32000.click above (see its
        // comment) -- one byte over the clamp.
        i = 0
        while i < 32001 {
            if i mod 8 == 7 {
                t.append(' ')
            } else {
                t.append('x')
            }
            i = i + 1
        }
        Body.text = t
        got = Body.text
        if got.length == 32000 and lastError.code != 0 {
            title = lastError.message
        } else {
            title = "FAIL:32001"
        }
    }
}

// MenuMain/MenuAux/Ops (Task 6, ui-scenario-retirement batch): transcribed
// from the retired testdata/ui/menus.cla -- Main/Aux renamed MenuMain/
// MenuAux (every window/menu name in this suite's ONE compiled program
// must be globally unique, Ch1's declare-before-use rule; "Main"/"Aux"
// were free in that scenario's own standalone build but collide with
// nothing here only because they're renamed). Ops's three real items
// (NewAux/Toggle/Scoped) are unchanged. Two deliberate DROPS from the
// retired fixture, both disclosed in task-6-report.md:
//   - The Quit item (`item Quit "Quit" key "Q"`) and its `on Quit.select
//     { quit }` handler: firing a real `quit` STATEMENT mid-case would
//     tear down the whole toolbox suite process before later cases and
//     the final report run -- UiTestVerb only rejects the literal script
//     control-verb string "quit" (uitest.cla's own header comment), not
//     an app handler that happens to execute one when dispatched via
//     `menu`. The retired fixture's own cancel-then-succeed quit-cascade
//     semantics stay covered forever by testdata/ui/texteditor_quit.cla
//     (docs/superpowers/plans/2026-08-05-ui-scenario-retirement.md's own
//     "kept forever" list), so nothing is left unverified.
//   - Toggle's own widget mutation (Main.On.checked/Main.Status.text):
//     ButtonsPanel/cases_buttons.cla already cover check/label mutation
//     end to end; this window's job is purely menu dispatch + scope
//     dimming (cases_menus.cla's own global counters below).
// No widgets, so no geometry constants -- cases_menus.cla asserts purely
// through UiTestMenu's own return value and the dispatch counters.
window MenuMain {
    title: "MenuMain"
    size: 200, 100
}

window MenuAux {
    title: "MenuAux"
    size: 200, 100
}

// Ops is declared here (harness.cla), the file list's own position
// (internal/mactest/coresuite_test.go's toolboxFiles) BEFORE gui.cla's
// `menu File` -- rt_ui_build_menus (ui.cla) inserts every declared menu
// into the real bar in whole-program declaration order, so Ops lands at
// bar position 2 (Apple is always 1), Edit (below) at 3, File at 4 --
// see cases_menus.cla's own header comment for the full derivation and
// why Quit's key equivalent had to be dropped above to avoid colliding
// with File's own `key "Q"` under cases_events.cla's real-hardware
// TbMenuKey probe.
menu Ops {
    item NewAux "New Aux" key "N"
    item Toggle "Toggle"  key "T"
    item Scoped "Scoped"  key "S"
}

extend Ops {
    on NewAux.select {
        open MenuAux
        tbMenuNewAuxCount = tbMenuNewAuxCount + 1
    }
    on Toggle.select {
        tbMenuToggleCount = tbMenuToggleCount + 1
    }
}

extend MenuAux {
    extend Ops {
        on Scoped.select {
            tbMenuScopedCount = tbMenuScopedCount + 1
        }
    }
}

// EditMain/Edit (Task 6, ui-scenario-retirement batch): transcribed from
// the retired testdata/ui/editmenu.cla -- Main renamed EditMain (same
// global-uniqueness reason as MenuMain/MenuAux above), same two
// textviews (A above B), same `menu Edit { standard edit }`. `size: 300,
// 260` is UNCHANGED from the retired fixture's own standalone build, so
// its content top-left stays ((512-300)/2, 44) = (106, 44) -- rt_ui_open
// centers purely on a window's own width, independent of whatever else
// is compiled alongside it -- meaning editmenu.events' own click/drag
// coordinates carry over VERBATIM into cases_editmenu.cla with no
// re-derivation. aChanges/bChanges are ADDED instrumentation (same
// nameChanges/bodyChanges convention as TextWin above): the retired
// scenario's assertion needs both an exact fire count (typing "Hello
// World" fires A.change 11 times) and a NO-fire pin (Copy must not
// increment either counter), neither observable any other way.
window EditMain {
    title: "Edit Demo"
    size: 300, 260

    textview A { at: 20, 20 }
    textview B { at: 20, bottom }

    var aChanges: int = 0
    var bChanges: int = 0
}

menu Edit {
    standard edit
}

extend EditMain {
    on A.change {
        aChanges = aChanges + 1
    }
    on B.change {
        bChanges = bChanges + 1
    }
}

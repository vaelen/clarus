// kit.cla: shared testsuite kit (test-suite-review Task 8) -- the
// TestResult record and the PASS/FAIL/TOTAL report formatting every suite
// (core, and later toolbox) builds on. See the plan's "Normative: the
// testsuite runner contract" section
// (docs/superpowers/plans/2026-08-03-test-suite-review.md) for the full
// contract this implements. Pure ASCII, no lowlevel/extern surface --
// this file is meant to be shared by every suite, including ones that
// never touch Ch13.

record TestResult {
    name:   string(63)
    passed: bool
    detail: string(255)
}

// tkPass builds a passing TestResult (empty detail).
func tkPass(name: string): TestResult {
    var r: TestResult
    r.name = name
    r.passed = true
    return r
}

// tkFail builds a failing TestResult carrying a detail message.
func tkFail(name: string, detail: string): TestResult {
    var r: TestResult
    r.name = name
    r.passed = false
    r.detail = detail
    return r
}

// tkIntToStr renders n in decimal, negative included -- kept as its own
// name/signature (callers throughout the suites use it), but the body is
// now just `string(n)` (binary-files phase, Task 3: Ch3's own int->string
// numeric conversion, no longer a gap ordinary Clarus programs have to
// work around by hand).
func tkIntToStr(n: int): string {
    return string(n)
}

// tkReport prints one line per result -- `PASS <name>` or
// `FAIL <name>: <detail>` -- then a `TOTAL <n> PASS <p> FAIL <f>`
// summary line, and returns the fail count. This log format is an API:
// the host harness (internal/testsuite) and, later, the Mac GUI (goal
// 4's on-disk TestLog.txt) both parse it. Lines go through alert(),
// which is already the host-stdout / Mac-capture-console channel the
// core suite's own CLI front-end (testsuite/core/cli.cla) routes its
// output through.
func tkReport(results: list of TestResult): int {
    var r: TestResult
    var fails: int = 0
    var total: int = 0
    var line: string

    for r in results {
        total = total + 1
        if r.passed {
            line = "PASS " + r.name
            alert(line)
        } else {
            line = "FAIL " + r.name + ": " + r.detail
            alert(line)
            fails = fails + 1
        }
    }
    // Built up piecewise into `line` rather than one long chained-`+`
    // alert() argument: native 68k codegen (cg68k) has a per-statement
    // string/record temp-slot budget, and this many concatenations (three
    // tkIntToStr() calls included) in one expression exceeds it ("too many
    // str/rec temps needed in one statement") -- a real gap Task 8 never
    // caught since nothing built kit.cla via emit68k before test-suite-
    // review Task 9's Mac-gate swap.
    line = "TOTAL " + tkIntToStr(total)
    line = line + " PASS " + tkIntToStr(total - fails)
    line = line + " FAIL " + tkIntToStr(fails)
    alert(line)
    return fails
}

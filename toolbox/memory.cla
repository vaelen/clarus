// toolbox/memory.cla: curated Memory Manager declarations (Inside
// Macintosh II, "The Memory Manager"), toolbox-cookbook phase. Register
// (OS) convention throughout -- bit 11 clear on every trap word below
// (trap & 0x0800 == 0), per the Ch13 trap-table reading rule. Safe to
// redeclare identically in user code (Ch13 dedup rule).
//
// Provenance: NewPtr/DisposePtr (0xA11E/0xA01F), NewHandle/DisposeHandle
// (0xA122/0xA023), SetHandleSize (0xA024), BlockMoveData (0xA22E) --
// proven verbatim against runtime/clarus/list.cla's ListNewPtr family
// (ListNewPtr/ListDisposePtr/ListNewHandle/ListDisposeHandle/
// ListSetHandleSize/ListBlockMoveData) and testsuite/toolbox/
// cases_gestalt.cla's TbNewPtr/TbDisposePtr, both already-shipped `reg`
// declarations with the same trap words. HLock/HUnlock (0xA029/0xA02A)
// proven verbatim against runtime/clarus/native.cla's NatHLock/
// NatHUnlock. GetHandleSize (0xA025) verified against Retro68
// multiversal/defs/MemoryMgr.yaml: `h` register A0 in, return register
// D0 -- an OS/reg trap, matching the `reg` binding below. MoreMasters
// (0xA036) verified against the same MemoryMgr.yaml (trap 0xA036, no
// args) and proven trap-word-identical to runtime/clarus/native.cla's
// NatMoreMasters (declared there as plain pascal, harmless for a
// zero-arg void trap where reg/pascal calling convention is
// indistinguishable at the call site); this catalog uses `reg` per the
// bit-11 rule.

external func NewPtr(byteCount: int): ptr = trap 0xA11E reg
external func DisposePtr(p: ptr) = trap 0xA01F reg
external func NewHandle(byteCount: int): ptr = trap 0xA122 reg
external func DisposeHandle(h: ptr) = trap 0xA023 reg
external func GetHandleSize(h: ptr): int = trap 0xA025 reg
external func SetHandleSize(h: ptr, newSize: int): int = trap 0xA024 reg memerr
external func HLock(h: ptr) = trap 0xA029 reg
external func HUnlock(h: ptr) = trap 0xA02A reg
external func BlockMoveData(srcPtr: ptr, destPtr: ptr, byteCount: int) = trap 0xA22E reg
external func MoreMasters() = trap 0xA036 reg

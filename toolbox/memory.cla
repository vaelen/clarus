// toolbox/memory.cla: curated Memory Manager declarations (Inside
// Macintosh II, "The Memory Manager"), toolbox-cookbook phase. Register
// (OS) convention throughout -- bit 11 clear on every trap word below
// (trap & 0x0800 == 0), per the Ch13 trap-table reading rule. Safe to
// redeclare identically in user code (Ch13 dedup rule).
//
// Provenance: NewPtr/DisposePtr (0xA11E/0xA01F), NewHandle/DisposeHandle
// (0xA122/0xA023), SetHandleSize (0xA024), BlockMoveData (0xA22E) --
// proven verbatim against runtime/clarus/list.cla's ListNewPtr family
// (ListNewPtr/ListDisposePtr/ListNewHandle/ListDisposeHandle/
// ListSetHandleSize/ListBlockMoveData), already-shipped `reg`
// declarations with the same trap words. (This citation also named
// testsuite/toolbox/cases_gestalt.cla's TbNewPtr/TbDisposePtr until
// pack3-standardfile Task 5a deleted them; the Apple-interfaces
// re-verification below is the authoritative evidence regardless.)
// HLock/HUnlock (0xA029/0xA02A)
// proven verbatim against runtime/clarus/native.cla's NatHLock/
// NatHUnlock. GetHandleSize (0xA025) and MoreMasters (0xA036) were
// originally checked only against Retro68 multiversal/defs/MemoryMgr.yaml.
//
// Apple-interfaces re-verification (toolbox-cookbook phase, 2026-08-07):
// every trap word and register binding below is now confirmed directly
// against Apple's own Universal Interfaces 3.4
// (Retro68/InterfacesAndLibraries/Interfaces), the authoritative source --
// multiversal/defs/*.yaml is a third-party reconstruction of those same
// tables and is UNTRUSTED WHEN CITED ALONE: a citation it is the SOLE
// source for has never been checked against Apple at all. (The anecdote
// that used to justify this rule here -- that multiversal put Gestalt's
// response register in the wrong place -- was itself wrong, and
// pack3-standardfile Task 5a retired it: multiversal's `Out<A0>` was
// RIGHT, and our A1 reading came from taking `Gestalt.h`'s `#pragma
// parameter` line as the trap's contract when it describes the INLINE
// GLUE. The sharper rule that survives: decode the inline words -- a
// `TWOWORDINLINE` routine's second word is glue you must reproduce or
// route around. See toolbox/osutils.cla.) Any multiversal citation above
// should be read as secondary corroboration only, superseded by the
// citations below.
//
//   NewPtrClear   CIncludes/MacMemory.h:580-583 `#pragma parameter
//                 __A0 NewPtrClear(__D0)` ... `NewPtrClear(Size
//                 byteCount) ONEWORDINLINE(0xA31E);`;
//                 AIncludes/MacMemory.a:561 `_NewPtrClear: OPWORD
//                 $A31E`. Same D0-in/A0-out shape as NewPtr, with
//                 the Memory Manager's clear bit set -- the block
//                 comes back zeroed. Added by the AppleTalk phase
//                 (Task 6): every AppleTalk parameter block, Names
//                 Table Entry and ADSP control block must be fully
//                 zeroed before use (toolbox/appletalk.cla's Rule 2),
//                 and a NewPtr+manual-clear loop is strictly worse.
//   NewPtr        CIncludes/MacMemory.h:547 `#pragma parameter __A0
//                 NewPtr(__D0)`; AIncludes/MacMemory.a:515 `_NewPtr:
//                 OPWORD $A11E`. byteCount in D0, ptr result in A0 --
//                 matches `reg` (no explicit ret: default result
//                 register for a ptr return is A0).
//   DisposePtr    CIncludes/MacMemory.h:1066 `#pragma parameter
//                 DisposePtr(__A0)`; AIncludes/MacMemory.a:1209 OPWORD
//                 $A01F. p in A0, void result.
//   NewHandle     CIncludes/MacMemory.h:433 `#pragma parameter __A0
//                 NewHandle(__D0)`; AIncludes/MacMemory.a:355 OPWORD
//                 $A122. byteCount in D0, ptr result in A0.
//   DisposeHandle CIncludes/MacMemory.h:1110 `#pragma parameter
//                 DisposeHandle(__A0)`; AIncludes/MacMemory.a:1270 OPWORD
//                 $A023. h in A0, void result.
//   GetHandleSize CIncludes/MacMemory.h:1162 `#pragma parameter __D0
//                 InlineGetHandleSize(__A0)`; AIncludes/MacMemory.a:1342
//                 OPWORD $A025 (Apple's real GetHandleSize is a full CFM
//                 call; InlineGetHandleSize is its 68k-direct inline
//                 twin, same trap word). h in A0, result in D0 -- matches
//                 `reg` exactly; the multiversal-only citation above is
//                 now redundant, not wrong.
//   SetHandleSize CIncludes/MacMemory.h:1125 `#pragma parameter
//                 SetHandleSize(__A0, __D0)`; AIncludes/MacMemory.a:1291
//                 OPWORD $A024. h in A0, newSize in D0, matches `reg`
//                 positionally. The `memerr` clause is independently
//                 confirmed by AIncludes/Memory.a:402's own MemError():
//                 `TWOWORDINLINE(0x3EB8, 0x0220)` is literally `MOVE.W
//                 $0220,D0` -- MemError is nothing but a direct read of
//                 the low-memory MemErr global at $0220, exactly the
//                 mechanism `reg memerr` models. CIncludes/MacMemory.h's
//                 own comment above SetHandleSize/GetHandleSize confirms
//                 the shape too: "the traps actually return an error
//                 code in D0 ... the glue sets D0 to 0 if an error
//                 occurred" for the reads; SetHandleSize itself is a true
//                 void PROCEDURE trap (no result register at all in its
//                 pragma) whose real error status is MemErr-only, per
//                 Inside Macintosh's own Memory Manager chapter.
//   HLock         CIncludes/MacMemory.h:709 `#pragma parameter
//                 HLock(__A0)`; AIncludes/MacMemory.a:731 OPWORD $A029.
//   HUnlock       CIncludes/MacMemory.h:724 `#pragma parameter
//                 HUnlock(__A0)`; AIncludes/MacMemory.a:751 OPWORD $A02A.
//   BlockMoveData CIncludes/MacMemory.h:1408 `#pragma parameter
//                 BlockMoveData(__A0, __A1, __D0)`; AIncludes/
//                 MacMemory.a:1658 OPWORD $A22E. srcPtr/destPtr/
//                 byteCount in A0/A1/D0 -- matches `reg`'s positional
//                 rule (two ptr params get A0 then A1 in declaration
//                 order, the one int param gets D0) exactly.
//   MoreMasters   CIncludes/MacMemory.h:1515 `MoreMasters(void)
//                 ONEWORDINLINE(0xA036)` (no register pragma -- zero
//                 args, void result); AIncludes/MacMemory.a:1781 OPWORD
//                 $A036.
//
// All ten trap words above are bit-11-clear (`trap & 0x0800 == 0`, per
// the Ch13 reading rule), confirming the `reg` convention this whole
// file uses.
//
// heap-jiggle-stress-mode phase (correctness-cleanup Task 3): five more
// Memory Manager routines -- CompactMem/PurgeMem/MoveHHi/FreeMem/MaxMem.
// None of the five appear in Retro68's Universal Interfaces 3.4 headers
// at all (confirmed by direct grep of both CIncludes/MacMemory.h and
// AIncludes/MacMemory.a -- zero matches for any of the five names, in
// contrast to every routine cited above), so the usual "decode the
// Apple pragma" path is unavailable; Apple's own C/asm interfaces
// simply don't expose these (heap-compaction control was never part of
// the sanctioned app-facing surface, though the traps themselves are
// real and documented). Verified instead against two independent
// sources that agree: Inside Macintosh Volume II's Memory Manager
// chapter (`inside-macintosh-v1/Inside Macintosh Volume II.pdf`, the
// Pascal signature + "On entry/On exit" register table for each
// routine, pp. II-38-46) for existence/register-shape, cross-checked
// against Retro68/multiversal/defs/MemoryMgr.yaml for the trap word
// itself -- multiversal is normally untrusted when cited ALONE, but is
// independently corroborated here by IM's own register table, and its
// entries for the traps already verified above (HLock 0xA029/HUnlock
// 0xA02A) match Apple's real headers exactly, giving no reason to
// distrust adjacent entries in the same file. This combination caught a
// real bug in this task's own starting plan: it guessed PurgeMem =
// 0xA049, but multiversal's own table shows 0xA049 is HPurge (a
// different, already-real routine a few lines away in the same trap
// range) and PurgeMem is actually 0xA04D -- exactly the kind of
// transposed-adjacent-trap-word error the verify-before-trusting rule
// exists to catch.
//
//   CompactMem  IM-II p.II-38: `FUNCTION CompactMem (cbNeeded: Size):
//               Size`. "On entry D0: cbNeeded (long word); On exit D0:
//               function result (long word)" -- a true function, D0 in
//               and D0 out, matches `reg` exactly (one int param -> D0,
//               int return -> D0). multiversal: trap 0xA04C, no
//               ReturnMemErr extras (agrees -- real D0 result, not an
//               error code).
//   PurgeMem    IM-II p.II-39: `PROCEDURE PurgeMem (cbNeeded: Size)`.
//               "On entry D0: cbNeeded (long word); On exit D0: result
//               code (word)" -- a void PROCEDURE whose D0 exit value is
//               an error code, the same shape as SetHandleSize above:
//               `reg memerr`. multiversal: trap 0xA04D, `executor_extras:
//               ReturnMemErr<D0>` (confirms the memerr shape).
//   MoveHHi     IM-II p.II-44: `PROCEDURE MoveHHi (h: Handle) [Not in
//               ROM]`, with its own "Result codes" list (noErr/
//               nilHandleErr/memLockedErr) -- another void-PROCEDURE/
//               memerr shape, h in A0 (one ptr param -> A0, matches
//               HLock's positional rule). multiversal: trap 0xA064,
//               `executor_extras: ReturnMemErr<D0>` (confirms).
//   FreeMem     IM-II p.II-38: `FUNCTION FreeMem: LONGINT`, no params,
//               D0 out only. multiversal: trap 0xA01C, `returnreg: D0`,
//               no memerr extras -- matches `reg` with zero args.
//   MaxMem      IM-II p.II-38: `FUNCTION MaxMem: LONGINT`, "On exit D0:
//               function result (long); A0: grow (long)" -- TWO output
//               registers (multiversal: trap 0xA11D, `returnreg: D0`
//               PLUS a separate `growp` arg bound `Out<A0>`). This
//               file's `reg` extern form has no way to express a second
//               output register, and the runtime only ever needs the D0
//               result (the largest contiguous free block size after
//               growing the heap zone to its limit -- the common way
//               MaxMem is called in practice), so it's declared narrowly
//               below: D0 result only, A0 left unbound/unread. Do not
//               rely on A0 after calling this declaration.
//
// All five new trap words are also bit-11-clear.
//
// SE-memory program Wave 0 (measurement infrastructure, 2026-09-28):
// MaxBlock/StackSpace/MaxApplZone plus nine siblings. Every trap word
// below is confirmed against Apple's own Universal Interfaces 3.4 --
// CIncludes/MacMemory.h (read through `tr '\r' '\n'`) for the
// `#pragma parameter` registers, and
// Retro68/InterfacesAndLibraries/Interfaces/AIncludes/MacMemory.a for the
// OPWORD -- and every register shape against Inside Macintosh's own
// "On entry/On exit" tables (IM-II pp. II-29-50, IM-IV pp. IV-77-80).
// Only the plain application-heap forms are declared (no ,SYS variants:
// MaxBlockSys 0xA461, NewEmptyHandleSys 0xA566, ReserveMemSys 0xA440).
// (Note for the heap-jiggle entries above: CompactMem/PurgeMem/FreeMem/
// MaxMem DO appear in CIncludes/MacMemory.h -- l.859/892/925/991 -- so
// their "zero matches" remark was mistaken; MoveHHi is at l.1051 too.)
//
//   MaxBlock      MacMemory.h:628-631 `#pragma parameter __D0 MaxBlock`
//                 ... `long MaxBlock(void) ONEWORDINLINE(0xA061)`;
//                 MacMemory.a:627 `_MaxBlock: OPWORD $A061`. No args, D0
//                 result. (IM-IV p.IV-77's "function result (word)" is an
//                 IM typo; the header says `long`, and it is a byte
//                 count.)
//   StackSpace    MacMemory.h:661-664 `#pragma parameter __D0 StackSpace`
//                 ... `long StackSpace(void) ONEWORDINLINE(0xA065)`;
//                 MacMemory.a:669 OPWORD $A065. No args, D0 result (same
//                 IM-IV "(word)" typo as MaxBlock).
//   MaxApplZone   MacMemory.h:1486 `void MaxApplZone(void)
//                 ONEWORDINLINE(0xA063)` (no pragma -- zero args);
//                 MacMemory.a:1742 OPWORD $A063. IM-IV p.IV-76: "On exit
//                 D0: result code (word)"; declared void (the only result
//                 code is noErr). In ROM from the 128K ROM on (IM-II marks
//                 it [Not in ROM] for the 64K ROM only). clarusc/
//                 cg68k.cla's startup stub already emits this trap word.
//   NewEmptyHandle MacMemory.h:676-679 `#pragma parameter __A0
//                 NewEmptyHandle` ... `ONEWORDINLINE(0xA166)`;
//                 MacMemory.a:689 OPWORD $A166. No args, handle in A0
//                 (`reg`'s default result register for a ptr).
//   HPurge        MacMemory.h:739-742 `#pragma parameter HPurge(__A0)`
//                 ... `ONEWORDINLINE(0xA049)`; MacMemory.a:771 OPWORD
//                 $A049. h in A0; void like HLock (its only errors,
//                 nilHandleErr/memWZErr, are caller bugs).
//   HNoPurge      MacMemory.h:754-757 `#pragma parameter HNoPurge(__A0)`
//                 ... `ONEWORDINLINE(0xA04A)`; MacMemory.a:791 OPWORD
//                 $A04A. h in A0, void (as HPurge).
//   EmptyHandle   MacMemory.h:1216-1219 `#pragma parameter
//                 EmptyHandle(__A0)` ... `ONEWORDINLINE(0xA02B)`;
//                 MacMemory.a:1407 OPWORD $A02B. h in A0, void (as
//                 HPurge; IM-II p.II-40 also returns h in A0, unread).
//   GetPtrSize    MacMemory.h:1081 declares only a CFM/glue prototype
//                 (no pragma, no inline); MacMemory.a:1228 `_GetPtrSize:
//                 OPWORD $A021`. Registers from IM-II p.II-37 / II-50:
//                 "On entry A0: p; On exit D0: if >= 0, function result
//                 (long word); if < 0, result code (word)" -- the same
//                 shape as InlineGetHandleSize above. CAUTION: this is
//                 the raw trap, so on error it returns a NEGATIVE OSErr,
//                 not the 0 Apple's glue returns (MacMemory.h:1136 NOTE).
//   HGetState     MacMemory.h:1261-1264 `#pragma parameter __D0
//                 HGetState(__A0)` ... `SInt8 HGetState(Handle h)
//                 ONEWORDINLINE(0xA069)`; MacMemory.a:1469 OPWORD $A069.
//                 h in A0, flags byte in D0 -- declared `char` so only
//                 the low byte is read (zero-extended); IM-IV p.IV-79 "On
//                 exit D0: flags (byte)". Masks: MacMemory.h:81-86
//                 (locked 0x80, purgeable 0x40, resource 0x20).
//                 runtime/clarus/uitext.cla's UiHGetState is the same trap
//                 declared `: int` for a pure save/restore round trip.
//   HSetState     MacMemory.h:1276-1281 `#pragma parameter HSetState(__A0,
//                 __D0)` ... `HSetState(Handle h, SInt8 flags)
//                 ONEWORDINLINE(0xA06A)`; MacMemory.a:1490 OPWORD $A06A.
//                 h in A0, flags in D0 (`char`, pairs with HGetState).
//   ReserveMem    MacMemory.h:958-961 `#pragma parameter ReserveMem(__D0)`
//                 ... `void ReserveMem(Size cbNeeded) ONEWORDINLINE(0xA040)`;
//                 MacMemory.a:1073 OPWORD $A040 (IM-II's `ResrvMem`).
//                 cbNeeded in D0; IM-II p.II-39 "On exit D0: result code
//                 (word)", result memFullErr -- a void PROCEDURE with a real
//                 failure mode, so `reg memerr` (as PurgeMem).
//   SetApplLimit  MacMemory.h:1540-1543 `#pragma parameter
//                 SetApplLimit(__A0)` ... `ONEWORDINLINE(0xA02D)`;
//                 MacMemory.a:1818 OPWORD $A02D. zoneLimit (an ADDRESS,
//                 not a byte count) in A0; IM-II p.II-29 "On exit D0:
//                 result code (word)", result memFullErr -> `reg memerr`.
//
//   Skipped: PurgeSpace (IM-IV p.IV-77: "On exit A0: contig; D0: total"
//   -- two outputs, and MacMemory.h:1293 gives it no inline at all);
//   PurgeSpaceTotal/PurgeSpaceContiguous (MacMemory.h:1313/1328 -- the
//   same 0xA062 split by result register; not needed yet); SetPtrSize,
//   SetApplBase, HSetRBit/HClrRBit, the ,SYS variants -- outside this
//   wave's measurement needs.
//
// All twelve new trap words are bit-11-clear.

external func NewPtr(byteCount: int): ptr = trap 0xA11E reg
external func NewPtrClear(byteCount: int): ptr = trap 0xA31E reg
external func DisposePtr(p: ptr) = trap 0xA01F reg
external func NewHandle(byteCount: int): ptr = trap 0xA122 reg
external func DisposeHandle(h: ptr) = trap 0xA023 reg
external func GetHandleSize(h: ptr): int = trap 0xA025 reg
external func SetHandleSize(h: ptr, newSize: int): int = trap 0xA024 reg memerr
external func HLock(h: ptr) = trap 0xA029 reg
external func HUnlock(h: ptr) = trap 0xA02A reg
external func BlockMoveData(srcPtr: ptr, destPtr: ptr, byteCount: int) = trap 0xA22E reg
external func MoreMasters() = trap 0xA036 reg
external func CompactMem(cbNeeded: int): int = trap 0xA04C reg
external func PurgeMem(cbNeeded: int): int = trap 0xA04D reg memerr
external func MoveHHi(h: ptr): int = trap 0xA064 reg memerr
external func FreeMem(): int = trap 0xA01C reg
external func MaxMem(): int = trap 0xA11D reg
external func MaxBlock(): int = trap 0xA061 reg
external func StackSpace(): int = trap 0xA065 reg
external func MaxApplZone() = trap 0xA063 reg
external func NewEmptyHandle(): ptr = trap 0xA166 reg
external func HPurge(h: ptr) = trap 0xA049 reg
external func HNoPurge(h: ptr) = trap 0xA04A reg
external func EmptyHandle(h: ptr) = trap 0xA02B reg
external func GetPtrSize(p: ptr): int = trap 0xA021 reg
external func HGetState(h: ptr): char = trap 0xA069 reg
external func HSetState(h: ptr, flags: char) = trap 0xA06A reg
external func ReserveMem(cbNeeded: int): int = trap 0xA040 reg memerr
external func SetApplLimit(zoneLimit: ptr): int = trap 0xA02D reg memerr

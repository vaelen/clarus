static void clar_fn_handler_App_startEmpty(void) {
    rt_ui_open(&clar_ui_window_Main);
}

static void clar_fn_ui_Main_Add_click(void * cv_window) {
    clar_rec_Bookmark t1;
    t1 = clar_new_Bookmark();
    rt_ui_edit(&clar_ui_window_EditForm, (const void *)&t1, 1, RT_UI_WB_NONE, 0, 0, 0, 0, 0);
}

static void clar_fn_ui_Main_Marks_doubleClick(void * cv_window, int32_t cv_i) {
    int32_t t1;
    t1 = (int32_t)(cv_i);
    rt_ui_edit(&clar_ui_window_EditForm, (const void *)rt_list_at(cv_bookmarks, t1), 0, RT_UI_WB_LIST, 0, cv_bookmarks, (long)(t1), 0, 0);
}

static void clar_fn_ui_Main_Remove_click(void * cv_window) {
    clar_fn_rtListRemove((void*)cv_bookmarks, (int32_t)(rt_ui_widget_get_int(cv_window, 0, RTUI_PROP_SELECTED)));
}

static void clar_fn_ui_Main_EditCur_click(void * cv_window) {
    rt_ui_edit(&clar_ui_window_EditForm, (const void *)&(cv_current), 0, RT_UI_WB_ADDR, (void *)&(cv_current), 0, 0, 0, 0);
}

static void clar_fn_ui_Main_EditMap_click(void * cv_window) {
    clar_str_255 t1;
    clar_fn_rtStrStore((void*)&t1, 255, (void*)(const uint8_t*)&(clar_lit_11));
    clar_rec_Bookmark t2;
    t2 = clar_new_Bookmark();
    rt_map_get_dv(cv_byName, (const uint8_t*)&t1, &t2);
    rt_ui_edit(&clar_ui_window_EditForm, (const void *)&t2, 0, RT_UI_WB_MAP, 0, 0, 0, cv_byName, (const unsigned char*)&t1);
}

static void clar_fn_ui_EditForm_accepted(void * cv_window, clar_rec_Bookmark cv_b) {
    if (rt_ui_form_is_new()) {
        clar_rec_Bookmark t1;
        t1 = cv_b;
        clar_fn_rtListPush((void*)cv_bookmarks, (void*)&(t1));
    }
    cv_current = cv_b;
    clar_rec_Bookmark t2;
    t2 = cv_b;
    clar_fn_rtMapSet((void*)cv_byName, (void*)(const uint8_t*)&((cv_b).cv_name), (void*)&(t2));
}

static void clar_fn_ui_EditForm_cancelled(void * cv_window) {
    rt_log((const uint8_t*)&(clar_lit_12));
}

static void clar_ui_widget_Main(void *inst, short widgetIndex, short event, long a, long b) {
    switch (widgetIndex) {
    case 1:
        if (event == RTUI_WEV_CLICK) clar_fn_ui_Main_Add_click(inst);
        break;
    case 0:
        if (event == RTUI_WEV_DBLCLICK) clar_fn_ui_Main_Marks_doubleClick(inst, (int32_t)a);
        break;
    case 2:
        if (event == RTUI_WEV_CLICK) clar_fn_ui_Main_Remove_click(inst);
        break;
    case 3:
        if (event == RTUI_WEV_CLICK) clar_fn_ui_Main_EditCur_click(inst);
        break;
    case 4:
        if (event == RTUI_WEV_CLICK) clar_fn_ui_Main_EditMap_click(inst);
        break;
    default: break;
    }
}

static void clar_ui_winevent_EditForm(void *inst, short event, long a, long b) {
    switch (event) {
    case RTUI_EV_ACCEPTED: clar_fn_ui_EditForm_accepted(inst, *(clar_rec_Bookmark *)a); break;
    case RTUI_EV_CANCELLED: clar_fn_ui_EditForm_cancelled(inst); break;
    default: break;
    }
}

static const rt_ui_window_desc *clar_ui_windows[] = {
    &clar_ui_window_Main,
    &clar_ui_window_EditForm,
};

int main(int argc, char **argv) {
    clar_init_globals();
    rt_register_cleanup(cl_free_globals);
    rt_args_init(argc, argv);
    rt_ui_startup(clar_ui_windows, 2, 0, 0, 0, 0, 0, 0);
    rt_ui_launch(0, clar_fn_handler_App_startEmpty);
    rt_ui_run();
    return 0;
}

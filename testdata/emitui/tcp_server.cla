// tcp_server.cla (MacTCP phase, Task 6): pins `l.listen(tcp port)` --
// lowering's rtLsnListen arm, which retired lowListenerMethod's MacTCP
// fence -- plus `accepted(c: connection)` handing over an already-open
// connection and `l.stop()` dispatching through atalk.cla's shared
// rtLsnStop to tcp.cla's rtTcpLsnStop.
var lsn: listener
var client: connection

on App.startCLI(args: list of string) {
    lsn.listen(tcp 6502)
    log("listening")
}

on lsn.accepted(c: connection) {
    client = c
    client.send("READY\n")
}

on lsn.failed(err: error) {
    log("lfailed " + string(err.code) + " " + err.message)
}

on client.received(data: text) {
    client.send(data)
}

on client.closed {
    lsn.stop()
}

    rt_register_cleanup(cl_free_globals);
    rt_args_init(argc, argv);
    clar_fn_handler_App_startCLI(rt_args_list());
    while (clar_fn_rtConnAlive() || clar_fn_rtAtalkAlive()) {
        clar_fn_rtConnPump();
        clar_fn_rtAtalkPump();
        rt_ext_ConnHIdle(20);
    }
    return 0;
}

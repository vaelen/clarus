// dialogs.cla: emitui golden fixture -- the three Ch12 dialog builtins
// (Task 4, mac-target-4c): askOpen(p, types) and askSave(p, suggested)
// (both fill their path argument IN PLACE and return bool; rt_ui_ask_open/
// rt_ui_ask_save), a file round-trip through the filled path
// (file.readText/file.writeText, reusing IFileReadText/IFileWriteText
// unchanged, writeText now carrying native-gaps-cleanup Task 2's
// mandatory type/creator args), and askSaveChanges(name), whose
// saveChoice result is
// compared against all three built-in enum members (Save/Discard/Cancel).
// Compile-check only (m68k, via internal/emitui's own gate) -- the real
// scripted behavior (both cancels, all three saveChoice branches, the
// on-disk file round-trip) is testdata/ui/dialogs.cla instead.
//
// SaveBtn.click's `askSave(path, "Untitled")` is the coverage Task 6's
// Text Editor depends on: `path` is a per-instance window var (not a
// local), so its fill-in-place argument must resolve through IUiState
// (rt_ui_state) to the REAL clar_uistate_DocWin storage -- fpAddrable's
// EFieldRef case -- not a throwaway copy that would silently discard the
// picked path once the handler returns.

window DocWin {
    title: "Doc"
    size: 320, 240

    button SaveBtn { at: 20, 20; caption: "Save" }
    textview Body  { at: 20, bottom; fill: both }

    var path: string(255)
}

extend DocWin {
    on SaveBtn.click {
        var c: saveChoice
        askSave(path, "Untitled")
        // Task 4b: bare `title` READ (Appendix C's `askSaveChanges(title)`
        // shape) -- window-scoped handler, resolves against the firing
        // instance same as any other bare per-instance name.
        c = askSaveChanges(title)
    }
}

on App.launch {
    var p: string(255)
    var suggested: string(255)
    var ok: bool
    var choice: saveChoice
    var t: text
    var w: DocWin
    var wt: string(255)

    w = open DocWin
    // Task 4b: explicit `w.title` READ off a window-instance value.
    wt = w.title

    ok = askOpen(p, app.doctype)
    if ok {
        file.readText(p, t)
        w.Body.text = t
    }

    suggested = "untitled.txt"
    ok = askSave(p, suggested)
    if ok {
        t = w.Body.text
        file.writeText(p, t, app.doctype, app.id)
    }

    choice = askSaveChanges("Doc")
    if choice == Save {
        file.writeText(p, t, app.doctype, app.id)
    } else if choice == Discard {
        alert("discarded")
    } else {
        alert("cancelled")
    }
}

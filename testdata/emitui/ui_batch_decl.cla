// ui_batch_decl.cla (ui-widgets Task 1): the declaration surface of the
// 68kBBS UI batch -- one of every new widget attribute (height, width on
// textview/canvas/table, font, style, align, maxLines, scrollbar on a
// logpanel), both new kinds (logpanel, divider), a formatted + aligned
// table column, a `checked` menu item and a submenu. Pins the blob v2
// bytes through emitui/goldens.sh. ui-widgets Task 2 added the `opened`
// handler and layoutMain, which use every new runtime member once.
// ui-widgets Task 3 added the two element stores (counts[0], callers[0].secs)
// tests/emitui/colfmt.sh expects an rtListNoteSet call after.

record Caller {
    name: string(31)
    secs: int
}

var callers: list of Caller
var counts: list of int

func durationStr(s: int): string {
    return string(s / 60) + "m"
}

window Main {
    title: "BBS"
    size: 480, 320
    resizable

    label Status { at: 10, 10; text: "Idle"; height: 20; font: "Monaco", 9; style: bold, underline; align: right }
    field Who { label: "Who:"; height: 30; font: "Geneva", 12; style: italic }
    textview Notes { width: 200; height: 60; font: "Monaco", 9; style: plain }
    canvas Meter { width: 120; height: 40; font: "Chicago", 12 }
    table Callers {
        rows: callers
        width: 300
        height: 120
        font: "Geneva", 9
        column "Name" shows name width 120
        column "Time" shows durationStr(secs) width fill align right
    }
    divider TopRule { style: double; height: 3; width: fill }
    divider SideRule { }
    logpanel Log { maxLines: 100; font: "Monaco", 9; style: bold; scrollbar: both; fill: both }
}

menu Speed {
    item S2400 "2400"
    item S9600 "9600" checked
}

menu Modem {
    item Init "Init" key "I" checked
    item Port "Port Speed" submenu Speed
}

on App.launch {
    open Main
}

func layoutMain(m: Main) {
    var w: int = m.contentWidth
    var h: int = m.contentHeight
    var n: int
    var s: string
    var flag: bool

    m.Callers.setBounds(161, 0, w - 161, h / 2)
    m.TopRule.setBounds(0, h / 2, w, 3)
    m.SideRule.setBounds(160, 0, 1, h / 2)
    m.Log.setBounds(0, h / 2 + 3, w, h - h / 2 - 3)
    n = m.Status.x + m.Status.y + m.Status.width + m.Status.height
    n = n + m.TopRule.x + m.Who.y + m.Notes.width + m.Meter.height
    m.Status.setFont("Monaco", 9)
    m.Status.setStyle(bold, italic, underline)
    m.Who.setStyle(plain)
    m.Notes.setFont("Geneva", 10)
    m.Callers.setStyle(bold)
    m.Callers.scrollTo(0)
    m.Meter.setFont("Chicago", 12)
    n = n + m.Meter.textWidth("abc") + m.Meter.lineHeight + m.Meter.ascent
    m.Log.setFont("Monaco", 9)
    m.Log.setStyle(italic)
    m.Log.appendLine("hello")
    n = n + m.Log.lineCount
    s = m.Log.line(0)
    m.Log.scrollToEnd()
    m.Log.clear()
    Speed.S9600.checked = true
    flag = Speed.S2400.checked or Modem.Init.enabled
    counts[0] = n
    callers[0].secs = n
    m.Status.text = s + string(n)
}

extend Main {
    on opened {
        layoutMain(window)
        Status.setBounds(contentWidth - 100, 0, 100, 20)
        Log.appendLine(string(contentHeight))
    }
}

extend Speed {
    on S9600.select {
        quit
    }
}

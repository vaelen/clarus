// every.cla: emitui golden fixture -- two top-level `every N ticks { }`
// blocks (Ch7/Ch11), in declaration order (rt_ui_every_desc[]'s array
// position, and the ledger's `T FIRE every.<n>` trace index, both key off
// this same order). The first mirrors the reference's own Ch11 bounce idiom
// (`Game.front`, per-instance fixed-point state, canvas redraw -- see
// testdata/valid/bounce.cla); the second touches only a global, proving an
// every-block needs no window reference at all.

window Game {
    title: "Ticker"
    size: 200, 200
    canvas Board { at: 0, 0; fill: both; buffered }

    var x: fixed = 10.0
    var dx: fixed = 2.0
}

var ticks: int = 0

every 1 ticks {
    var g: Game = Game.front
    if g != nil {
        g.x = g.x + g.dx
        if g.x > 190.0 or g.x < 0.0 {
            g.dx = -g.dx
        }
        g.Board.clear()
        g.Board.fillCircle(int(g.x), 100, 8)
    }
}

every 60 ticks {
    ticks = ticks + 1
}

// textwidgets.cla: emitui golden fixture -- field/textview widgets
// (mac-target-4c Task 2): descriptor rows (RTUI_FIELD/RTUI_TEXTVIEW, the
// scrollbar flag), field.text read/write (rt_ui_widget_get_str/set_str,
// reusing IUiSetText's exact call shape on the write side -- see
// lower.cla's lowWidgetSetAssign), textview.text read/write
// (rt_ui_widget_get_text/set_text against an rt_text handle), and
// field.enter (RTUI_WEV_ENTER, zero-arg like every other widget event
// besides canvas's).
//
// `log` (bare, uninitialized) and `note` (declared default "hi") are
// clarusc-ui-gaps Task 2's own fixture: a window with a handle-backed
// per-instance var must get it constructed (rt_text_new()) before ANY
// in-place use, even one that never assigns a value at all -- and a
// declared default must apply AFTER construction, never before (see
// IUiStateDefaults' cprint case). `log.append` in Name.enter exercises the
// bare, no-default var's in-place mutation. This is the SYNTHESIZED-opened
// path (no explicit `on opened` handler above).
//
// NoteWin (below) covers the OTHER glue path (Fix round 1, item 3):
// lowPrependWinVarDefaults, construction prepended onto an EXPLICIT `on
// opened` -- ctor -> declared defaults -> the handler's own user statement,
// same ordering. Its `buf: text[2]` also locks Fix round 1 item 1: an
// array of handle-backed elements needs the same construction as a bare
// scalar handle-backed var (irtNeedsCtor recurses into KArr's element
// type), and cpDefaultInit's existing Arr branch already emits the correct
// per-element construction loop with no printer change needed.
//
// `Body.scrollToEnd()` (bare, in-handler) and `w.Body.scrollToEnd()`
// (explicit instance) are the textview-scroll-to-end phase's fixture for
// the textview's one method: lower.cla's lowTextviewMethod -> the
// ui_scroll_to_end intrinsic -> clar_fn_rtUiWidgetScrollToEnd(inst, 1)
// (Body is TextWin's widget index 1).

window TextWin {
    title: "Text"
    size: 320, 260

    field Name    { label: "Name:"; at: 20, 20; width: 200 }
    textview Body { at: 20, 50; fill: both; scrollbar: vertical }

    var nameStr: string
    var bodyText: text
    var log: text
    var note: text = "hi"
}

window NoteWin {
    title: "Notes"
    size: 200, 160

    var scratch: text
    var greeting: text = "hi2"
    var buf: text[2]
}

on App.launch {
    var w: TextWin
    w = open TextWin
    w.Body.scrollToEnd()
    open NoteWin
}

extend TextWin {
    on Name.change {
        nameStr = Name.text
    }
    on Name.enter {
        Name.text = nameStr
        title = "Entered"
        log.append("x")
    }
    on Body.change {
        bodyText = Body.text
        Body.text = bodyText
        Body.text = "from literal"
        Body.scrollToEnd()
    }
}

extend NoteWin {
    on opened {
        title = "Notes Ready"
    }
}

// app_nonui.cla: emitui golden fixture -- an `app` section with NO window,
// menu, or `every` block: a plain command-line program. Exercises the
// include-gate widening (Task 2's emitProgram change): rt_ui_app_desc's
// typedef needs `#include "rt_ui.h"`, but irIsUiProgram() stays false, so
// main() must stay the ordinary CLI main (no rt_ui_startup/rt_ui_run).

app CountLines {
    name: "CountLines"
    version: "2.0"
}

on App.startCLI(args: list of string) {
    quit 0
}

// formedit.cla: gated UI scenario (mac-target-4d Task 7) -- form windows,
// binds, the `edit` statement, and accepted/cancelled end to end on real
// m68k hardware (Mini vMac): Main's table over a global list, Add opening
// EditForm on `new Bookmark` (all four widget kinds bound: field(str),
// field(int), popup(enum), check(bool)), an invalid Port value beeping and
// re-focusing (OK validation, RTUI_FIELD_INT's real-time digit-only
// filter -- see rt_ui_form_char_ok -- means a bad INT value has to be an
// OVERFLOW, not a stray letter: typing enough extra digits to blow past
// int32 range is the only way to make a real-time-filtered field
// invalid), a fix + successful OK firing `accepted` (isNew -> add), the
// table showing the new row, a dblclick-to-edit round on that row
// (lvalue target) changing the name and re-accepting (writeback, table
// redraws), then a second edit on the same row cancelled via Escape
// (row unchanged).
//
// Main mirrors popuptable.cla's own window size/table position EXACTLY
// (420x290, table at 10,10) so its already-verified row-click coordinates
// (rt_ui_open's screen-centering math: screenW=512 -> left=46, top=44;
// table header 20px + half a 16px row = 28px offset, 16px/row) are reused
// verbatim here -- see that fixture's own header comment for the
// derivation. EditForm is given an explicit `size:` (deliberately unlike
// the language reference's own appendix example) and explicit `at:` on
// every widget (also unlike the appendix) so every click coordinate below
// is arithmetic from known constants (RTUI_BUTTON_W/H etc., runtime/mac/
// rt_ui.c), not guessed -- see the task report's own concerns section on
// the sizeless/unpositioned form question this sidesteps.
enum Protocol {
    Gopher
    HTTP
    Telnet
}

record Bookmark {
    name:     string(63)
    url:      string(255)
    port:     int = 80
    protocol: Protocol
    favorite: bool
}

var bookmarks: list of Bookmark

window Main {
    title: "Bookmarks"
    size: 420, 290

    table Marks {
        at: 10, 10
        rows: bookmarks
        column "Name" shows name     width 140
        column "URL"  shows url      width fill
        column "Fav"  shows favorite width 30
    }
    button Add { at: 10, 150; caption: "Add" }
}

window EditForm {
    title: "Edit Bookmark"
    size: 300, 200
    form for Bookmark

    field Name  { binds: name;     label: "Name:";     at: 10, 10; width: 180 }
    field Url   { binds: url;      label: "URL:";      at: 10, 35; width: 180 }
    field Port  { binds: port;     label: "Port:";      at: 10, 60; width: 120 }
    popup Proto { binds: protocol; label: "Protocol:";  at: 10, 85 }
    check Fav   { binds: favorite; caption: "Favorite"; at: 10, 110 }

    button OK     { at: 10, 150;  default }
    button Cancel { at: 110, 150; cancel }
}

on App.startEmpty {
    open Main
}

extend Main {
    on Add.click {
        edit EditForm, new Bookmark
    }

    on Marks.doubleClick(i: int) {
        edit EditForm, bookmarks[i]
    }
}

extend EditForm {
    on accepted(b: Bookmark) {
        if b.isNew {
            bookmarks.add(b)
        }
    }
}

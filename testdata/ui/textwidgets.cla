// textwidgets.cla: gated UI scenario (Task 2, mac-target-4c) -- field and
// textview widgets end to end on real m68k hardware: field.change/enter,
// textview.change, field.text/textview.text read+write, and the carried
// review requirement from Task 1 -- the RTUI_TE_MAX (32,000-byte) clamp
// boundary on textview.text set, BOTH sides independently observable.
// Fill32000/Fill32001 each build a `text` value in a loop (exactly at, and
// one past, the clamp) and assign it to Body.text; the outcome (ok vs.
// truncated + lastError) is round-tripped into the window title --
// rt_ui_set_title has no RT_MAC_TEST trace line of its own, so this is
// verified via a snap's title bar, not a trace line -- and each click gets
// its OWN snap (immediately after, before the other button's click
// clobbers the title/content) so an off-by-one clamp regression in either
// direction fails a specific golden rather than being masked by the other
// click's title/content overwriting it. Scripted by textwidgets.events
// (`key 13`, not
// an embedded raw CR byte in a `type` line -- scripts/build-mac.sh's
// --events pipeline C-escapes a script FILE's raw bytes into a string
// literal, and a literal CR byte there is mis-lexed as a source line
// ending by the C compiler; `key`'s all-digit-arg1 convention, added
// alongside this task, is the only way this pipeline can name byte 13 at
// all -- see rt_ui.c's rt_ui_script_key_arg):
//
//   click <Name field>      -- focuses Name (TEActivate/TEClick)
//   type Hello               -- "Hello" via TEKey (each char fires
//                                Name.change)
//   key 13                   -- fires Name.enter (no insertion -- Name is
//                                a FIELD)
//   click <Body textview>    -- focus switches to Body
//   type Hi there            -- "Hi there" via TEKey (each char fires
//                                Body.change)
//   key 13                   -- Body is a TEXTVIEW: inserts a CR (fires
//                                Body.change again) rather than an enter
//   click <Fill32000 button> -- appends exactly 32,000 bytes and sets
//                                Body.text; no truncation, title becomes
//                                "ok:32000"
//   snap ok32000              -- title/content prove the exact-clamp,
//                                no-truncation path
//   click <Fill32001 button> -- appends 32,001 bytes and sets Body.text;
//                                truncated to 32,000 + lastError set,
//                                title becomes lastError.message
//   snap trunc32001            -- title proves the one-past-clamp,
//                                truncated+lastError path
//   quit

window TextWin {
    title: "Text"
    size: 400, 280

    field Name       { label: "Name:"; at: 20, 20; width: 140 }
    button Fill32000 { at: right, 20; caption: "32000" }
    button Fill32001 { at: right, 20; caption: "32001" }
    textview Body    { at: 20, bottom; fill: both; scrollbar: vertical }

    var nameStr: string
    var bodyText: text
}

on App.launch {
    open TextWin
}

extend TextWin {
    on Name.change {
        nameStr = Name.text
    }
    on Name.enter {
        Name.text = nameStr
        title = "Entered"
    }
    on Body.change {
        bodyText = Body.text
    }
    on Fill32000.click {
        var t: text
        var got: text
        var i: int

        // A space every 8th byte, not one giant 32,000-byte word: classic
        // TextEdit's line-wrap hunts backward for a break point, and a
        // single pathologically long word (no whitespace at all) makes
        // that hunt effectively quadratic -- observed hanging TECalText
        // for minutes on real m68k hardware during this task's own
        // development. The byte count (what the clamp test cares about)
        // is unaffected by content shape.
        i = 0
        while i < 32000 {
            if i mod 8 == 7 {
                t.append(' ')
            } else {
                t.append('x')
            }
            i = i + 1
        }
        Body.text = t
        got = Body.text
        if got.length == 32000 and lastError.code == 0 {
            title = "ok:32000"
        } else {
            title = "FAIL:32000"
        }
    }
    on Fill32001.click {
        var t: text
        var got: text
        var i: int

        // Same spaced-content shape as Fill32000.click above (see its
        // comment) -- one byte over the clamp.
        i = 0
        while i < 32001 {
            if i mod 8 == 7 {
                t.append(' ')
            } else {
                t.append('x')
            }
            i = i + 1
        }
        Body.text = t
        got = Body.text
        if got.length == 32000 and lastError.code != 0 {
            title = lastError.message
        } else {
            title = "FAIL:32001"
        }
    }
}

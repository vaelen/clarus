// popuptable.cla: gated UI scenario (mac-target-4d Task 5) -- the table
// widget end to end on real m68k hardware (Mini vMac, List Manager):
// `rows:` bound to a global `list of` record seeded in App.startEmpty,
// select/doubleClick dispatch (each writing the clicked row's own name
// into a label, proving the row index the runtime handed back is correct
// -- not just that SOME event fired), live add/remove (Add pushes a 4th
// row with no table-specific call; Remove reads `Marks.selected` back and
// removes that row), and both directions of the `selected` runtime
// property (SetSel writes it programmatically -- `T SET` trace, no change
// event, matching every other runtime-property setter's "programmatic
// writes are silent" rule -- and ReadSel reads it back into the window
// title, since `title` has no trace line of its own; see
// testdata/ui/textwidgets.cla's own comment on the same point). Popup
// itself has no coverage here -- see the task report on why (a form
// window still aborts, Task 7).
//
// Domain mirrors the reference's own Appendix C Bookmark Manager (Main
// window, Marks table, Add/Remove) as closely as this task's scope allows
// (no form/edit yet); SetSel/ReadSel are this scenario's own addition.
//
// Scripted by popuptable.events -- see that file's own header comment for
// the coordinate derivation (rt_ui_open's exact screen-centering math plus
// the table's own header/row-height formula, both read directly from
// runtime/mac/rt_ui.c, not guessed).

record Bookmark {
    name:     string(63)
    url:      string(255)
    favorite: bool
}

var bookmarks: list of Bookmark

window Main {
    title: "Bookmarks"
    size: 420, 290

    table Marks {
        at: 10, 10
        rows: bookmarks
        column "Name" shows name     width 140
        column "URL"  shows url      width fill
        column "Fav"  shows favorite width 30
    }
    button Add     { at: 10, bottom;   caption: "Add" }
    button Remove  { at: next, bottom; caption: "Remove" }
    button SetSel  { at: next, bottom; caption: "SetSel" }
    button ReadSel { at: next, bottom; caption: "ReadSel" }
    label Result   { at: next, bottom; text: "" }
}

on App.startEmpty {
    var b: Bookmark

    b.name = "Alpha"
    b.url = "alpha.com"
    b.favorite = false
    bookmarks.add(b)

    b.name = "Beta"
    b.url = "beta.com"
    b.favorite = true
    bookmarks.add(b)

    b.name = "Gamma"
    b.url = "gamma.com"
    b.favorite = false
    bookmarks.add(b)

    open Main
}

extend Main {
    on Marks.select(i: int) {
        Result.text = bookmarks[i].name
    }
    on Marks.doubleClick(i: int) {
        Result.text = "dbl:" + bookmarks[i].name
    }
    on Add.click {
        var b: Bookmark

        b.name = "Delta"
        b.url = "delta.com"
        b.favorite = true
        bookmarks.add(b)
    }
    on Remove.click {
        bookmarks.remove(Marks.selected)
    }
    on SetSel.click {
        Marks.selected = 1
    }
    on ReadSel.click {
        var s: int

        s = Marks.selected
        if s == 0 {
            title = "sel0"
        } else if s == 1 {
            title = "sel1"
        } else if s == 2 {
            title = "sel2"
        } else if s == 3 {
            title = "sel3"
        } else {
            title = "selNone"
        }
    }
}

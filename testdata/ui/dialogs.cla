// dialogs.cla: gated UI scenario (Task 4, mac-target-4c) -- askOpen,
// askSave, and askSaveChanges end to end, scripted by dialogs.events via
// the RT_MAC_TEST answer queue (answer-open/answer-save/answer-changes/
// answer-cancel), plus a REAL file round-trip through the boot volume
// (askSave -> file.writeText -> Clear -> askOpen the SAME path ->
// file.readText -> Body.text, proven by a snap showing the content came
// back from disk, not just from memory).
//
// `path` is a PER-INSTANCE window var (clar_uistate_Doc.cv_path, not a
// handler-local) -- both askOpen and askSave fill it in place through
// rt_ui_state, the same shape review flagged as Task 6's Text Editor
// dependency (`d.path` there). SaveBtn.click's `title = path` right after
// a successful askSave is a breadcrumb proving the fill actually landed in
// the real per-instance field rather than a throwaway copy: the
// "saved-title" snap shows the window's title bar has become the picked
// filename, not the constant "Doc" it opened with. The very next line,
// `Status.text = "saved: " + title` (Task 4b), READS that same bare
// `title` back through a REAL GetWTitle call (rt_ui_get_title) -- the
// "saved-title" snap's Status label shows the filename a second time,
// proving the read round-trips through the Toolbox window record rather
// than echoing a cached value.
//
//   click <Body>          -- focuses Body (TEActivate/TEClick)
//   type Hello file        -- types content via TEKey (each char fires
//                             Body.change)
//   answer-save DialogsTest.txt
//   click <SaveBtn>        -- askSave fills the STATE var `path`,
//                             file.writeText writes it, `title = path`,
//                             then Status.text reads `title` back;
//                             T ASKSAVE DialogsTest.txt
//   snap saved-title        -- title bar AND Status label both now read
//                             "DialogsTest.txt" -- proves the state-var
//                             fill-in-place AND the title read both stuck
//   click <ClearBtn>       -- Body.text = "" (empty text), proves the
//                             content that comes back next is really read
//                             off disk, not left over from the click above
//   answer-open DialogsTest.txt
//   click <OpenBtn>        -- askOpen refills the SAME state var `path`,
//                             file.readText refills Body.text;
//                             T ASKOPEN DialogsTest.txt
//   snap roundtrip          -- Body shows "Hello file" again
//   answer-cancel
//   click <OpenBtn>        -- T ASKOPEN cancel; Body/path untouched
//   answer-cancel
//   click <SaveBtn>        -- T ASKSAVE cancel; no file write, no title set
//   answer-changes save
//   click <AskBtn>         -- T ASKCHANGES save; T SET Doc.Status.text
//                             changes-save
//   answer-changes discard
//   click <AskBtn>         -- T ASKCHANGES discard; ...changes-discard
//   answer-changes cancel
//   click <AskBtn>         -- T ASKCHANGES cancel; ...changes-cancel
//   quit

window Doc {
    title: "Doc"
    size: 400, 260

    button OpenBtn  { at: 20, 20; caption: "Open" }
    button SaveBtn  { at: right, 20; caption: "Save" }
    button AskBtn   { at: right, 20; caption: "Ask" }
    button ClearBtn { at: right, 20; caption: "Clear" }
    label Status    { at: 20, bottom; text: "" }
    textview Body   { at: 20, bottom; fill: both }

    var path: string(255)
}

on App.launch {
    open Doc
}

extend Doc {
    on OpenBtn.click {
        var t: text
        if askOpen(path) {
            file.readText(path, t)
            Body.text = t
            Status.text = "opened"
        } else {
            Status.text = "open-cancel"
        }
    }
    on SaveBtn.click {
        if askSave(path, "untitled.txt") {
            file.writeText(path, Body.text)
            title = path
            // Task 4b: bare `title` READ right after the write above --
            // proves the read comes back through rt_ui_get_title (a REAL
            // GetWTitle call), not just the local `path` value.
            Status.text = "saved: " + title
        } else {
            Status.text = "save-cancel"
        }
    }
    on AskBtn.click {
        var c: saveChoice
        c = askSaveChanges("Doc")
        if c == Save {
            Status.text = "changes-save"
        } else if c == Discard {
            Status.text = "changes-discard"
        } else {
            Status.text = "changes-cancel"
        }
    }
    on ClearBtn.click {
        Body.text = ""
    }
}

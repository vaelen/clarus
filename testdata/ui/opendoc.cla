// opendoc.cla: gated UI scenario (mac-target-4c Task 5) -- App.
// openDocument vs App.startEmpty, driven by RT_MAC_TEST's `launchdoc`
// script verb (rt_ui_launch's own pre-scan, runtime/mac/rt_ui.c). Shared
// by TWO scenario names (internal/mactest/ui_test.go): "opendoc" (its own
// .events lists two `launchdoc` lines, one with a space in the path,
// proving both the per-document dispatch order and the "rest of line can
// contain spaces" parsing) and "opendoc_empty" (its own .events lists
// none at all, proving the startEmpty fallback still fires when the
// script names no document). Every open window shows the received path
// directly (rather than a real file read) so both scenarios stay fully
// deterministic regardless of what does or doesn't exist on the boot
// volume -- the `T OPENDOC <path>` trace line + this label are the two
// independent proofs a document actually arrived with the right bytes.

window Reader {
    title: "Reader"
    size: 320, 120

    label Path { at: 20, 20; text: "" }

    var docPath: string
}

on App.startEmpty {
    var w: Reader

    w = open Reader
    w.Path.text = "(empty launch)"
}

on App.openDocument(p: string) {
    var w: Reader

    w = open Reader
    w.docPath = p
    w.Path.text = p
}

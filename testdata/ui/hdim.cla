// hdim.cla: gated UI scenario (fix-hbar) -- "dimmed when not needed": an
// empty textview's V bar has always had maxScroll 0 (nothing to scroll);
// the H bar now matches it (content-based range, rt_ui_te_widest_line
// returns 0 for an empty TE). `on opened { }` deliberately sets no text --
// S1's single snap is the whole point: BOTH scrollbars must render
// thumbless (the standard scrollbar CDEF's inactive state, maxScroll ==
// minScroll == 0) rather than a full-range thumb sitting over empty
// content.
//
// hdim.events primes with `menu 0 0` before the first `snap`, same fix and
// same reason as zoomwin.events/hscroll.events (see either file's own
// comment): a `snap` as the literal first scripted verb captures the
// screen before the first update pump, so S1 would otherwise show a blank
// content area.

window DimWin {
    title: "Dim"
    size: 300, 200

    textview Body { at: 10, 10; fill: both; scrollbar: both }
}

on App.launch {
    open DimWin
}

extend DimWin {
    on opened { }
}

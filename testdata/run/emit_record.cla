// emit_record.cla: Task 8 coverage slice for clarusc emit -- record layout
// emission (clar_rec_NAME struct + clar_new_NAME ctor), NewRec, FieldRef
// read/write (including a nested record), copy-by-value semantics, a
// scalar/string/enum field mix with defaults (an explicit int default, an
// enum field's implicit first-member default -- Active's value is 5, a
// NON-zero explicit value, pinning a bug where the default path assumed
// member 0 always means value 0 -- and a nested record's own zero default),
// a record-typed GLOBAL var, and a `text` global initialized from a string
// literal (the Text-from-Str global-init path, cprint.cla's
// cpEmitGlobalsInit). Self-verifying via `if cond { alert("... ok") } else
// { alert("... FAIL") }`, same convention as emit_arith.cla. No user funcs
// (Task 9) -- just the handler-body + global-var subset this task supports.
enum Status {
    Active 5 "Active"
    Done   6 "Done"
}

record Address {
    city: string(31)
    zip:  int
}

record Person {
    name:   string(31)
    age:    int = 18
    status: Status
    home:   Address
}

var gPerson: Person
var gGreeting: text = "hello globals"

on App.startCLI(args: list of string) {
    var p: Person
    var q: Person
    var ok: bool
    var e: error
    var cap3: string(3)

    p = new Person

    // ---- defaults ----
    if p.age == 18 {
        alert("default scalar field ok")
    } else {
        alert("default scalar field FAIL")
    }
    if p.status == Active {
        alert("default enum field (non-zero first member) ok")
    } else {
        alert("default enum field FAIL")
    }
    if p.home.zip == 0 and p.home.city == "" {
        alert("default nested record ok")
    } else {
        alert("default nested record FAIL")
    }

    // ---- field read/write, including through a nested record ----
    p.name = "Original"
    p.home.city = "Springfield"
    p.home.zip = 90210
    p.status = Done
    // Split across several statements, not one long `and` chain: cprint's
    // buffers are `list of string` (255-byte capacity, per cprint.cla's own
    // header comment), and this many nested FieldRef/rt_str_cmp calls on
    // one C line would silently clamp mid-expression.
    ok = p.name == "Original"
    ok = ok and p.home.city == "Springfield"
    ok = ok and p.home.zip == 90210
    ok = ok and p.status == Done
    if ok {
        alert("field write/read ok")
    } else {
        alert("field write/read FAIL")
    }

    // ---- copy by value: q gets an independent snapshot of p, including
    // the nested record; mutating q must not touch p. ----
    q = p
    q.age = 99
    q.home.zip = 11111
    q.name = "Copy"
    if p.name == "Original" and p.age == 18 and p.home.zip == 90210 {
        alert("copy independence (p unchanged) ok")
    } else {
        alert("copy independence (p unchanged) FAIL")
    }
    if q.name == "Copy" and q.age == 99 and q.home.zip == 11111 {
        alert("copy independence (q changed) ok")
    } else {
        alert("copy independence (q changed) FAIL")
    }

    // ---- record-typed global var: same default-init path as a local,
    // driven from clar_init_globals instead of a function's locals loop ----
    if gPerson.age == 18 and gPerson.status == Active {
        alert("global record default ok")
    } else {
        alert("global record default FAIL")
    }
    gPerson.name = "GlobalName"
    if gPerson.name == "GlobalName" {
        alert("global record write ok")
    } else {
        alert("global record write FAIL")
    }

    // ---- text global initialized from a string literal: rt_text_new()
    // then rt_text_store(...), not a plain `=` (a Text handle and a Str
    // value have no common C representation) ----
    if gGreeting == "hello globals" {
        alert("text global from string literal ok")
    } else {
        alert("text global from string literal FAIL")
    }

    // ---- Err / lastError intrinsics: an ordinary `error` var's .code/
    // .message are a plain FieldRef into its clar_rec_Err value (no cv_
    // prefix on code/message, unlike a user record's fields); the bare
    // global `lastError` reads/writes the runtime's rt_lasterr_* globals
    // instead, and materializes into an ordinary error var via a plain
    // Assign (ILastErr). ----
    ok = e.code == 0
    ok = ok and lastError.code == 0
    if ok {
        alert("error/lastError code before ok")
    } else {
        alert("error/lastError code before FAIL")
    }

    cap3 = "ab" + "cdef" // overflows string(3)'s capacity -> sets lastError

    if e.code == 0 {
        alert("ordinary error var untouched by truncation ok")
    } else {
        alert("ordinary error var untouched by truncation FAIL")
    }
    ok = lastError.code == 1
    ok = ok and lastError.message == "string truncated"
    if ok {
        alert("lastError code/message after truncation ok")
    } else {
        alert("lastError code/message after truncation FAIL")
    }

    e = lastError
    ok = e.code == 1
    ok = ok and e.message == "string truncated"
    if ok {
        alert("lastError materialized into ordinary error var ok")
    } else {
        alert("lastError materialized into ordinary error var FAIL")
    }

    quit 0
}

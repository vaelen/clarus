func show(label: string, n: int) {
    var digits: char[12]
    var count: int = 0
    var v: int = n
    var s: string
    var i: int

    while v > 0 {
        digits[count] = char(v mod 10 + int('0'))
        v = v / 10
        count = count + 1
    }
    if count == 0 {
        digits[0] = '0'
        count = 1
    }
    s = label
    i = count - 1
    while i >= 0 {
        s = s + digits[i]
        i = i - 1
    }
    alert(s)
}

on App.launch {
    show("3 + 4*5 = ", 3 + 4*5)
    show("0xFF & 0x0F = ", 0xFF & 0x0F)
    show("1 << 10 = ", 1 << 10)
    show("int('A') = ", int('A'))
}

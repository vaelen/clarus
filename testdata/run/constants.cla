enum Level { Low, Mid, High }

const maxHits: int = 3
const tag: string = "v1"
const startLevel: Level = Mid
const bump: int = 1

func show(label: string, n: int) {
    var digits: char[12]
    var count: int = 0
    var v: int = n
    var s: string
    var i: int

    while v > 0 {
        digits[count] = char(v mod 10 + int('0'))
        v = v / 10
        count = count + 1
    }
    if count == 0 {
        digits[0] = '0'
        count = 1
    }
    s = label
    i = count - 1
    while i >= 0 {
        s = s + digits[i]
        i = i - 1
    }
    alert(s)
}

on App.launch {
    var n: int
    var lvl: Level
    var count: int

    // const in an expression
    n = maxHits + bump
    show("maxHits + bump = ", n)

    // const as an int case label
    count = 0
    for i in 0 to 5 {
        switch i {
        case maxHits {
            count = count + 1
        }
        }
    }
    show("count at maxHits = ", count)

    // const as an enum case label
    lvl = Mid
    switch lvl {
    case startLevel {
        alert("matched startLevel")
    }
    else {
        alert("no match")
    }
    }

    // const string in an expression
    alert(tag + " ready")
}

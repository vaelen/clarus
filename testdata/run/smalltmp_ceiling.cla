// smalltmp_ceiling.cla: the RUN-lane (behavior-oracle) twin of
// testdata/cg68k/smalltmp_ceiling.cla -- 14 concurrently-live small
// (<=4-byte) statement temps in ONE statement, a call whose OWN 14
// arguments are each an `l.pop()` (cgIntrListPopLike's out-param scratch,
// cgAllocTmpOff), all evaluated left-to-right and held until the call
// itself fires (cgFreeStmtTmps only runs at end-of-statement -- Task 13's
// per-statement, not per-flush, lifetime).
//
// mac-resident-clarusc Task 3 wrote this to pin the then-flat pool const
// at the exact need clarusc's own self-emit had found. compiler-cleanup
// sized that pool PER FUNCTION, so there is no const left to shrink; the
// "no ceiling at all" pin lives in the cg68k twin, which was widened to 30
// temps. This one stays at 14 as a plain cross-lane behavior oracle.
func sum14(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: int, j: int, k: int, l: int, m: int, n: int): int {
    return a + b + c + d + e + f + g + h + i + j + k + l + m + n
}
on App.startCLI(args: list of string) {
    var nums: list of int
    var i: int
    var total: int

    i = 1
    while i <= 14 {
        nums.push(i)
        i = i + 1
    }
    total = sum14(nums.pop(), nums.pop(), nums.pop(), nums.pop(), nums.pop(), nums.pop(), nums.pop(), nums.pop(), nums.pop(), nums.pop(), nums.pop(), nums.pop(), nums.pop(), nums.pop())
    if total == 105 {
        alert("smalltmp ceiling ok")
    } else {
        alert("smalltmp ceiling FAIL")
    }
    quit 0
}

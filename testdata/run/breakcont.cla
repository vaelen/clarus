func show(label: string, n: int) {
    var digits: char[12]
    var count: int = 0
    var v: int = n
    var s: string
    var i: int

    while v > 0 {
        digits[count] = char(v mod 10 + int('0'))
        v = v / 10
        count = count + 1
    }
    if count == 0 {
        digits[0] = '0'
        count = 1
    }
    s = label
    i = count - 1
    while i >= 0 {
        s = s + digits[i]
        i = i - 1
    }
    alert(s)
}

on App.launch {
    var i: int
    var sum: int
    var total: int
    var l: list of int
    var m: map of int
    var seen: string

    // while: break
    i = 0
    sum = 0
    while i < 10 {
        if i == 5 { break }
        sum = sum + i
        i = i + 1
    }
    show("while break sum = ", sum)
    show("while break i = ", i)

    // while: continue
    i = 0
    sum = 0
    while i < 5 {
        i = i + 1
        if i mod 2 == 0 { continue }
        sum = sum + i
    }
    show("while continue sum = ", sum)

    // for over a range: break
    total = 0
    for x in 0 to 9 {
        if x == 4 { break }
        total = total + x
    }
    show("for range break total = ", total)

    // for over a range: continue
    total = 0
    for x in 0 to 5 {
        if x mod 2 == 0 { continue }
        total = total + x
    }
    show("for range continue total = ", total)

    // for over a list: break
    l.push(10)
    l.push(20)
    l.push(30)
    l.push(40)
    total = 0
    for x in l {
        if x == 30 { break }
        total = total + x
    }
    show("for list break total = ", total)

    // for over a list: continue
    total = 0
    for x in l {
        if x == 20 { continue }
        total = total + x
    }
    show("for list continue total = ", total)

    // for over a map: break (keys visited in ascending order: a, b, c)
    m["a"] = 1
    m["b"] = 2
    m["c"] = 3
    total = 0
    seen = ""
    for k, v in m {
        if k == "c" { break }
        total = total + v
        seen = seen + k
    }
    show("for map break total = ", total)
    alert(seen)

    // for over a map: continue
    total = 0
    seen = ""
    for k, v in m {
        if k == "b" { continue }
        total = total + v
        seen = seen + k
    }
    show("for map continue total = ", total)
    alert(seen)
}

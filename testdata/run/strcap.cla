func f(s: string): string {
    return s
}

func h(): string(8) {
    var big: string = "truncateme"
    return big
}

on App.launch {
    var x: string(8) = "hi"
    var y: string = f(x)
    var z: string(8)
    var lst: list of string(8)
    var m: map of string(8)
    var mv: string(8)

    alert(y)

    z = h()
    alert(z)
    alert(lastError.message)

    lst.push("this is over eight bytes")
    alert(lst.first())
    alert(lastError.message)

    mv = m.get("missing", y)
    alert(mv)
}

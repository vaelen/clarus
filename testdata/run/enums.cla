enum Protocol {
    Gopher 0x01 "Gopher"
    HTTP   0x50 "Web (HTTP)"
    Telnet 0x17 "Telnet"
}

func show(label: string, n: int) {
    var digits: char[12]
    var count: int = 0
    var v: int = n
    var s: string
    var i: int

    while v > 0 {
        digits[count] = char(v mod 10 + int('0'))
        v = v / 10
        count = count + 1
    }
    if count == 0 {
        digits[0] = '0'
        count = 1
    }
    s = label
    i = count - 1
    while i >= 0 {
        s = s + digits[i]
        i = i - 1
    }
    alert(s)
}

on App.launch {
    var g: Protocol = Gopher
    var h: Protocol = HTTP
    var t: Protocol = Telnet
    var back: Protocol = Protocol(0x50)

    show("int(Gopher) = ", int(g))
    show("int(HTTP) = ", int(h))
    show("int(Telnet) = ", int(t))
    show("int(Protocol(0x50)) = ", int(back))

    if back == HTTP {
        alert("round trip ok")
    } else {
        alert("round trip FAILED")
    }
}

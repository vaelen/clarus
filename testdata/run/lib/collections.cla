// ARC regression proof (live=0): same shape as breakcont.cla -- runCollections'
// `l: list of int` and `m: map of int` are both read by element (`for x in
// l`, `for k, v in m`), which used to disqualify them from the
// non-escaping-local free clarusc emitted (4e's escape walker). Every
// scope-exit candidate releases unconditionally now (ARC Task 4/8), so both
// `l` and `m` release regardless. `.leaks` absent (0) -- the corpus gate
// (`go test ./internal/selfhost -run TestEmitDifferential`) enforces this
// permanently.

func collectionsShow(label: string, n: int) {
    var digits: char[12]
    var count: int = 0
    var v: int = n
    var s: string
    var i: int

    while v > 0 {
        digits[count] = char(v mod 10 + int('0'))
        v = v / 10
        count = count + 1
    }
    if count == 0 {
        digits[0] = '0'
        count = 1
    }
    s = label
    i = count - 1
    while i >= 0 {
        s = s + digits[i]
        i = i - 1
    }
    alert(s)
}

func runCollections() {
    var l: list of int
    var m: map of int
    var popped: int
    var shifted: int

    // list: push/pop/shift/unshift/first/last/count
    l.push(10)
    l.push(20)
    l.push(30)
    collectionsShow("count after 3 pushes = ", l.count)
    collectionsShow("first = ", l.first())
    collectionsShow("last = ", l.last())

    l.unshift(5)
    collectionsShow("count after unshift = ", l.count)
    collectionsShow("first after unshift = ", l.first())

    popped = l.pop()
    collectionsShow("popped = ", popped)
    collectionsShow("count after pop = ", l.count)

    shifted = l.shift()
    collectionsShow("shifted = ", shifted)
    collectionsShow("count after shift = ", l.count)

    for x in l {
        collectionsShow("list item = ", x)
    }

    // map: set/get/get-with-default/has/remove/count
    // inserted deliberately out of order: `map of T`'s iteration order is
    // unspecified (hashtable-backed)
    m["c"] = 3
    m["b"] = 2
    m["a"] = 1
    collectionsShow("map count = ", m.count)
    collectionsShow("get a = ", m.get("a", 0))
    collectionsShow("get missing dv = ", m.get("missing", 99))
    if m.has("a") {
        alert("has a")
    } else {
        alert("no a")
    }
    collectionsShow("m[a] = ", m["a"])
    m.remove("b")
    collectionsShow("map count after remove = ", m.count)
    if m.has("b") {
        alert("has b")
    } else {
        alert("no b")
    }

    // for over a map: order is unspecified for `map of T` since the
    // hashtable switch -- look up the known remaining keys explicitly in
    // a fixed order we choose (inserted c,b,a; b removed; a,c remain)
    // instead of relying on iteration order
    if m.has("a") {
        alert("a")
        collectionsShow("  value = ", m["a"])
    }
    if m.has("c") {
        alert("c")
        collectionsShow("  value = ", m["c"])
    }

    // for over an inclusive range
    for i in 1 to 3 {
        collectionsShow("range i = ", i)
    }
}

// Standing regression fixture for ARC Task 6 review, rounds 2 and 3.
//
// Round 2 (reviewer Critical): a global's OWN Init expression never routed
// through lowCountedStore's retain-on-store -- cpEmitGlobalsInit's
// Init-emission path plain-assigned a bare-alias Init's handle with NO
// retain (`cv_g2 = cv_g1;`), so Task 6's new unconditional cl_free_globals
// double-released an rc==1 handle: reviewer-reproduced `rt_rc:
// over-release`, exit 134, under CLARUS_MEM_STRICT+CLARUS_MEM_PARANOID.
// Fixed by giving the Init path its own birth-vs-retain classification
// (irGlobalInitBirth, set by lowGlobalVarDecl using the SAME
// lowStoreIsBirth/lowStoreIntrOwnsResult rule a runtime store uses) and
// retaining a non-birth Init's value right after the plain-assign --
// cpEmitGlobalsInit's own comment (cprint.cla) has the full account.
//
// gaT1/gaT2 pin the reviewer's exact TEXT repro (`var g2: text = g1`).
// gaL1/gaL2 pin the LIST-OF-TEXT variant -- the retain lands on the LIST
// CONTAINER's own handle (cpEmitRetain's KList branch), not its elements.
//
// Round 3 (reviewer Critical, found during round 2's own verification and
// escalated back into this task rather than deferred): cpEmitRelease's
// element-release walk (list/map deep release) ran UNCONDITIONALLY on
// every release call-site, before the container's own release -- so once
// gaL1/gaL2 shared one list handle (round 2's fix), a list WITH an element
// present at exit crashed anyway: the first release site walked and freed
// the element, the second site walked the SAME (already-freed) element
// again. Fixed by gating the element walk on rt_list_lastref/
// rt_map_lastref (internal/build/rt/rt_core.inc) -- a NULL-safe "is this
// the box's only live reference" (rc==1) check read BEFORE either site's
// own release call decrements it. gaL1/gaL2 below now push an element and
// leave it in place at exit (round 2's version popped it back out first,
// working around round 3's bug without saying so out loud in the code --
// no longer necessary). gaM1/gaM2 pin the MAP-OF-TEXT variant of the same
// shape. gaL3/local2 (inside the func body) pin a local aliasing a global
// container WITH an element present -- confirmed (by reading the emitted
// C, not just assumed) this shape was NEVER actually vulnerable: Task 4's
// per-function escape pass (lowFreeUnsafe) already disqualifies an ALIASED
// local from a DEEP scope-exit release (shallow `rt_list_release` only, no
// element walk) precisely because its value isn't provably unshared -- so
// only ONE release site (the global's own, in cl_free_globals) ever walks
// gaL3's elements, guard or no guard. Kept as a fixture anyway: it pins
// that disposition permanently, not just as of this commit.
//
// Expected strict-mode leak count: 0 (see ../arc_global_alias.leaks --
// absent, defaults to want-0) for all three pairs plus the local case.

var gaT1: text = "hello"
var gaT2: text = gaT1

var gaL1: list of text
var gaL2: list of text = gaL1

var gaM1: map of text
var gaM2: map of text = gaM1

var gaL3: list of text

func runArcGlobalAlias() {
    var buf: char[64]
    var n: int
    var s: string
    var local2: list of text

    n = gaT1.toBytes(buf)
    s.fromBytes(buf, n)
    alert(s)

    n = gaT2.toBytes(buf)
    s.fromBytes(buf, n)
    alert(s)

    gaL1.push("shared")
    if gaL2.count == 1 and gaL2.first() == "shared" {
        alert("list-alias-ok")
    } else {
        alert("list-alias-bad")
    }

    gaM1["k"] = "v"
    if gaM2.has("k") and gaM2["k"] == "v" {
        alert("map-alias-ok")
    } else {
        alert("map-alias-bad")
    }

    gaL3.push("loc")
    local2 = gaL3
    if local2.count == 1 and local2.first() == "loc" {
        alert("local-alias-ok")
    } else {
        alert("local-alias-bad")
    }
}

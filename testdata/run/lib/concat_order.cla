// ARC regression proof (live=0): `t: text = ""` default-inits to a fresh
// empty handle; `t = "x" + t` then replaces it via pointer-swap (the concat
// result is a new text object assigned straight into `t`, not stored
// byte-for-byte into the existing handle) -- under 4e, this orphaned the
// original empty handle with nothing left to free it (a local pointer-swap-
// init orphan). ARC Task 4's `lowCountedStore` gives every named-slot store
// release-old-then-store discipline regardless of the store's own
// freshness, so `t`'s original empty handle is now properly released the
// moment the concat store overwrites it. `.leaks` absent (0) -- the corpus
// gate (`go test ./internal/selfhost -run TestEmitDifferential`) enforces
// this permanently.

func runConcatOrder() {
    var s: string = "bc"
    var t: text = ""
    var buf: char[64]
    var out: string
    var n: int

    // char + string -> string(255), prepend
    s = 'a' + s
    alert(s)

    // string + text -> text
    t = "x" + t
    t.append("yz")
    n = t.toBytes(buf)
    out.fromBytes(buf, n)
    alert(out)
}

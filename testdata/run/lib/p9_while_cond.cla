// Regression fixture pinning a Minor finding from the memory-audit-4e final
// whole-branch review (probe P9): `clarusc/cprint.cla`'s `fpWhileStmt` used
// to free a text-producing while-condition's per-iteration temp AFTER the
// `if (!(cond)) break;` check, so the FINAL (false) evaluation's temp was
// never reached by any per-iteration free -- one text object leaked once
// per loop EXECUTION (not per iteration; struct box + data handle).
//
// ARC Task 8 regression proof: FIXED. `fpWhileStmt` now prints the SAME
// per-iteration temp-release lines into the break branch too, whenever the
// condition tracked at least one temp (mutually exclusive with the
// loop-continues path's own release, so never a double-free) -- see
// `fpWhileStmt`'s own doc comment for the exact shape. Pinned at 0 leaks
// (live=0); `.leaks` absent now (was 2) -- the corpus gate (`go test
// ./internal/selfhost -run TestEmitDifferential`) enforces this permanently.

func runP9WhileCond() {
    var p9T: text = "a"
    var p9N: int = 0
    while p9T + "b" == "ab" {
        p9N = p9N + 1
        if p9N > 0 { p9T.append("x") }
    }
    alert("p9 done")
}

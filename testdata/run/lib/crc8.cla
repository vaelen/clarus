func crc8Show(label: string, n: int) {
    var digits: char[12]
    var count: int = 0
    var v: int = n
    var s: string
    var i: int

    while v > 0 {
        digits[count] = char(v mod 10 + int('0'))
        v = v / 10
        count = count + 1
    }
    if count == 0 {
        digits[0] = '0'
        count = 1
    }
    s = label
    i = count - 1
    while i >= 0 {
        s = s + digits[i]
        i = i - 1
    }
    alert(s)
}

// CRC-8/SMBUS: polynomial 0x07, init 0, no input/output reflection, no xorout.
func crc8(s: string): int {
    var crc: int
    var i: int
    var j: int
    var b: int

    crc = 0
    i = 0
    while i < s.length {
        b = int(s[i])
        crc = crc ^ b
        j = 0
        while j < 8 {
            if crc & 0x80 != 0 {
                crc = (crc << 1) ^ 0x07
            } else {
                crc = crc << 1
            }
            crc = crc & 0xFF
            j = j + 1
        }
        i = i + 1
    }
    return crc
}

func runCrc8() {
    crc8Show("CRC-8 = ", crc8("123456789"))
}

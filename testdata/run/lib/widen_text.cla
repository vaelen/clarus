// Exercises string -> text widening at every assignability position (Ch3:
// Text -- "a string may be used wherever a text is expected"): a call
// argument, a return value, a list element (push), a map element
// (index-assign), and a map.get default -- plus the fresh-copy guarantee
// (mutating the resulting text never affects the original string).

func widenTextAcceptText(t: text): text {
    t.append("!")
    return t
}

func widenTextMakeText(s: string): text {
    return s
}

func widenTextGetStr(): string {
    return "delta"
}

// Originally (4e, pre-ARC): expected leak count 23 (every heap object this
// function's body allocated, since it emitted zero release calls at all).
// ARC Tasks 4-5 closed 16 of those 23 (named-slot stores, unconditional
// local release, and the ONE compiler-synthesized string->text widening
// temp that happened to land in a counted container element -- the
// list-push site) -- see git history for the full block-by-block accounting
// prior to this task. Five sites remained leaked after Task 5, all
// genuinely out of that task's own container-element scope:
//   - two call-argument widenings (`widenTextAcceptText(s)` and
//     `widenTextAcceptText(widenTextGetStr())`) -- ARC Task 8 regression
//     proof: FIXED. `fpCallFn` (cprint.cla) no longer hands off a
//     tracked-temp call argument (memory-audit Task 6's original handoff
//     predates ARC's retain-on-store guarantee and is unsound to keep now
//     -- see `fpCallFn`'s own doc comment); the ordinary end-of-statement
//     flush releases these widening temps like any other unclaimed tracked
//     temp.
//   - the RETURN-value widening inside `widenTextMakeText`'s own
//     `return s` -- ARC Task 8 regression proof: FIXED. `lowReturn`
//     (lower.cla) now gates its return-value retain on the SAME
//     birth-vs-retain rule every other counted store site uses (an
//     already-fresh widened value needs no second retain) -- see
//     `lowReturn`'s own doc comment.
//   - the map-set value's container (`m`, via `m.get("missing", "gamma")`'s
//     receiver) -- ARC Task 8 regression proof: FIXED as a direct
//     consequence of deleting the 4e escape-walk apparatus: `m`'s own
//     scope-exit release is unconditionally deep now (no more
//     get/first/last/pop/shift receiver-disqualification rule to gate it),
//     so it reaches and releases the "beta" element too.
//   - the map-get default (`"gamma"`, key absent) -- ARC Task 8 regression
//     proof: FIXED (known open leak bug 2, `IMapGetDvBirth` -- see
//     `IMapGetDvBirth`'s own ir.cla doc comment).
// Pinned at 0 leaks (live=0); `.leaks` absent now (was 10) -- the corpus
// gate (`go test ./internal/selfhost -run TestEmitDifferential`) enforces
// this permanently.
func runWidenText() {
    var pass: bool
    var s: string
    var t1: text
    var t2: text
    var lst: list of text
    var m: map of text
    var dv: text

    pass = true

    // call argument: a string arg to a text param, plus the fresh-copy
    // guarantee -- appending to the received text must not affect s.
    s = "hello"
    t1 = widenTextAcceptText(s)
    if s != "hello" { pass = false }
    if t1 != "hello!" { pass = false }

    // return value: a string returned from a text-returning function
    t2 = widenTextMakeText("world")
    if t2 != "world" { pass = false }

    // list element: a string pushed to a `list of text`
    lst.add("alpha")
    if lst[0] != "alpha" { pass = false }

    // map element: a string set into a `map of text` via index-assign
    m["k"] = "beta"
    if m["k"] != "beta" { pass = false }

    // map.get default: a string as the default-value argument
    dv = m.get("missing", "gamma")
    if dv != "gamma" { pass = false }

    // call argument, non-addressable string source: a function-call result
    // (routes through strAddr -> addrable -> copyToTemp, emitting its own
    // temp+statement) widened to a text param.
    t1 = widenTextAcceptText(widenTextGetStr())
    if t1 != "delta!" { pass = false }

    if pass {
        alert("ok")
    } else {
        alert("FAIL")
    }
}

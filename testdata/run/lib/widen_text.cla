// Exercises string -> text widening at every assignability position (Ch3:
// Text -- "a string may be used wherever a text is expected"): a call
// argument, a return value, a list element (push), a map element
// (index-assign), and a map.get default -- plus the fresh-copy guarantee
// (mutating the resulting text never affects the original string).

func widenTextAcceptText(t: text): text {
    t.append("!")
    return t
}

func widenTextMakeText(s: string): text {
    return s
}

func widenTextGetStr(): string {
    return "delta"
}

// Expected strict-mode leak count: 23 (see ../widen_text.leaks; verified
// against the emitted C -- this function's body emits zero rt_text_free/
// rt_list_free/rt_map_free calls at all, so every heap object it allocates
// leaks: 9 `rt_text_new()` calls (2 blocks each = 18) + 1 `rt_list_new()`
// (2 blocks) + 1 `rt_map_new()` (3 blocks) = 23). Every local here hits one
// of the two documented clarusc Task 7 pre-pass gaps (memory-audit-4e), by
// design of what this fixture is exercising:
//   - `t1`/`t2`/`dv` are all reassigned from a non-fresh source (a
//     user-call result for t1/t2, a bare alias of another local for dv --
//     lower.cla's `lowEscapeFreshInit` rule 2/4), so none ever qualifies
//     for a scope-exit free.
//   - `lst`/`m` are both read by element (`rt_list_at`/`rt_map_get`/
//     `rt_map_get_dv`), the documented element-read-disqualified-container
//     class.
//   - Every compiler-synthesized string-to-text widening temp (one per
//     call argument, per list-push value, per map-set value, per
//     map-get-default value) is the documented escaping-local class: Task
//     5's temp-freeing machinery deliberately skips temps that hand off
//     into a call/push/map-set/get-default, since ownership passes to the
//     callee/container and freeing here would double-free or UAF.
// Legitimate, not a bug.
func runWidenText() {
    var pass: bool
    var s: string
    var t1: text
    var t2: text
    var lst: list of text
    var m: map of text
    var dv: text

    pass = true

    // call argument: a string arg to a text param, plus the fresh-copy
    // guarantee -- appending to the received text must not affect s.
    s = "hello"
    t1 = widenTextAcceptText(s)
    if s != "hello" { pass = false }
    if t1 != "hello!" { pass = false }

    // return value: a string returned from a text-returning function
    t2 = widenTextMakeText("world")
    if t2 != "world" { pass = false }

    // list element: a string pushed to a `list of text`
    lst.add("alpha")
    if lst[0] != "alpha" { pass = false }

    // map element: a string set into a `map of text` via index-assign
    m["k"] = "beta"
    if m["k"] != "beta" { pass = false }

    // map.get default: a string as the default-value argument
    dv = m.get("missing", "gamma")
    if dv != "gamma" { pass = false }

    // call argument, non-addressable string source: a function-call result
    // (routes through strAddr -> addrable -> copyToTemp, emitting its own
    // temp+statement) widened to a text param.
    t1 = widenTextAcceptText(widenTextGetStr())
    if t1 != "delta!" { pass = false }

    if pass {
        alert("ok")
    } else {
        alert("FAIL")
    }
}

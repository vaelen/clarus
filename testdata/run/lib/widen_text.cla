// Exercises string -> text widening at every assignability position (Ch3:
// Text -- "a string may be used wherever a text is expected"): a call
// argument, a return value, a list element (push), a map element
// (index-assign), and a map.get default -- plus the fresh-copy guarantee
// (mutating the resulting text never affects the original string).

func widenTextAcceptText(t: text): text {
    t.append("!")
    return t
}

func widenTextMakeText(s: string): text {
    return s
}

func widenTextGetStr(): string {
    return "delta"
}

// Originally (4e, pre-ARC): expected leak count 23 -- this function's body
// emitted zero rt_text_free/rt_list_free/rt_map_free calls at all, so
// every heap object it allocated leaked: 9 `rt_text_new()` calls (2 blocks
// each = 18: `t1`/`t2`/`dv`'s own prologue defaults, plus one
// compiler-synthesized string->text widening temp per assignability
// position -- a call argument x2, a list-push value, a map-set value, and
// a map.get default) + 1 `rt_list_new()` (`lst`, 2 blocks) + 1
// `rt_map_new()` (`m`, 3 blocks) = 23.
//
// ARC Task 4 (counted named-slot stores + unconditional local release)
// closed 11 of those 23 blocks -- everything that was a NAMED-SLOT store
// or a plain local's own scope-exit release, confirmed against the
// emitted C:
//   - `t1`/`t2`/`dv`'s own prologue-default boxes are released the
//     instant each is first (re)assigned (`t1 = widenTextAcceptText(s)`,
//     `t2 = widenTextMakeText(...)`, `dv = m.get(...)` are all named-slot
//     stores now -- release-old-then-store, regardless of the store's own
//     freshness; the old per-store freshness GATE on candidacy is gone).
//     3 x 2 blocks = 6.
//   - `lst`/`m` themselves (their own list/map handle, not their
//     elements) get a genuine, unconditional SHALLOW scope-exit release
//     now (`rt_list_release(cv_lst); rt_map_release(cv_m);`, no element
//     loop -- deep release stays gated on the same still-unmigrated
//     container-element proof as before, Task 5). 2 + 3 = 5 blocks.
//
// Of the 12 blocks remaining after ARC Task 4 (see ../widen_text.leaks'
// pre-Task-5 value), SIX distinct compiler-synthesized string->text
// widening temps (one per call argument x2, one inside `widenTextMakeText`'s
// own `return s`, one per list-push value, map-set value, and map-get-
// default value -- 6 sites x 2 blocks = 12) were never a NAMED slot at
// all: each is an anonymous, untracked scratch value born inside argument/
// return/element-store lowering (`lowCoerceStr`, embedded directly in the
// call/return/push/index-assign's own printing).
//
// ARC Task 5 (counted container element slots) closes exactly ONE of the
// six -- the list-push site (`lst.add("alpha")`) -- because that widening
// temp is birth (the KStr override `lowElemIsBirth` shares with
// `lowCountedStore`: a Str->Text coercion is always a fresh construction,
// so `lowListMethod` picks the plain `IListPush`, no retain needed) AND
// because Task 5 deleted the "index-read/non-fresh-push disqualifies the
// container" consults, so `lst` itself now qualifies for a real DEEP
// scope-exit release, walking and releasing its one "alpha" element
// (confirmed against the emitted C: `t4 = rt_text_new(); rt_text_store(t4,
// "alpha"); t5 = t4; rt_list_push(cv_lst, &t5);` at the push site, THEN `{
// int32_t i; for (...) rt_text_release(*(rt_text **)rt_list_at(cv_lst,
// i)); } rt_list_release(cv_lst);` at scope exit -- `t4`/`t5` were never
// separately released, but `lst`'s own walk now reaches and releases the
// SAME box they named).
//
// The other FIVE stay leaked, genuinely out of Task 5's scope:
//   - Both call-argument widenings (`widenTextAcceptText(s)` and
//     `widenTextAcceptText(widenTextGetStr())`) and the RETURN-value
//     widening inside `widenTextMakeText`'s own `return s` are a
//     user-function parameter-passing / return-value shape, not a
//     container element at all -- untouched by this task either way (the
//     RETURN case is a genuine, separately-confirmed pre-existing leak in
//     `lowReturn`'s own Str->Text handling -- it unconditionally retains a
//     `return`'s operand without ARC Task 4's own isBirth check, so an
//     ALREADY-fresh widened value gets retained a second time with nothing
//     to balance it; reproduced in isolation, with no push/list/map
//     involved at all -- flagged in the whole-branch report as a
//     discovered-but-out-of-scope finding, not fixed here).
//   - The map-set value (`m["k"] = "beta"`) IS a container element store
//     Task 5 covers (same birth classification as the list-push site,
//     `IMapSet`, no retain needed) -- but `m` (a LOCAL) itself stays
//     disqualified from its own DEEP scope-exit release, for a reason Task
//     5 deliberately leaves standing: `m.get("missing", "gamma")`'s
//     RECEIVER disqualifies
//     `m` via `lowEscapeWalkMethodCall`'s get/first/last/pop/shift-as-
//     alias rule (the "coordinator's ruling is maximally conservative on
//     purpose" consult -- see that function's own doc comment for why this
//     is NOT one of the two consults Task 5 was asked to delete) --
//     confirmed against the emitted C: `rt_map_release(cv_m);` at scope
//     exit, no element loop, so the "beta" element's own box is never
//     reached.
//   - The map-get default (`"gamma"`) is `.get()`'s own default-value
//     argument, still routed through `lowEscapeWalkArgsHandoff`
//     (`lowFreeUnsafe`) unchanged -- see `lowFreeUnsafe`'s own doc comment
//     for why that's a separate, pre-existing conservatism this task
//     doesn't touch.
// Expected strict-mode leak count: 10 (see ../widen_text.leaks, dropped
// from 12) -- the five remaining sites above, 2 blocks each. Not a bug --
// four of the five are explicitly out of Task 5's own container-element
// scope; the fifth (the `return s` widening) is a genuine, separately-
// confirmed pre-existing bug outside this task's brief, flagged not fixed.
func runWidenText() {
    var pass: bool
    var s: string
    var t1: text
    var t2: text
    var lst: list of text
    var m: map of text
    var dv: text

    pass = true

    // call argument: a string arg to a text param, plus the fresh-copy
    // guarantee -- appending to the received text must not affect s.
    s = "hello"
    t1 = widenTextAcceptText(s)
    if s != "hello" { pass = false }
    if t1 != "hello!" { pass = false }

    // return value: a string returned from a text-returning function
    t2 = widenTextMakeText("world")
    if t2 != "world" { pass = false }

    // list element: a string pushed to a `list of text`
    lst.add("alpha")
    if lst[0] != "alpha" { pass = false }

    // map element: a string set into a `map of text` via index-assign
    m["k"] = "beta"
    if m["k"] != "beta" { pass = false }

    // map.get default: a string as the default-value argument
    dv = m.get("missing", "gamma")
    if dv != "gamma" { pass = false }

    // call argument, non-addressable string source: a function-call result
    // (routes through strAddr -> addrable -> copyToTemp, emitting its own
    // temp+statement) widened to a text param.
    t1 = widenTextAcceptText(widenTextGetStr())
    if t1 != "delta!" { pass = false }

    if pass {
        alert("ok")
    } else {
        alert("FAIL")
    }
}

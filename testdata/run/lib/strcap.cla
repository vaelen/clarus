// Expected strict-mode leak count: 5 (see ../strcap.leaks). runStrcap's
// `lst: list of string(8)` is read by element (`lst.first()`) and `m: map
// of string(8)` is read by element (`m.get(...)`) -- both are the
// documented element-read-disqualified-container class (memory-audit-4e
// Task 6/7), so neither is freed at scope exit: `lst` leaks 2 blocks
// (struct box + data handle), `m` leaks 3 (struct box + keys + vals
// handles, all zero-length since no entries were ever set). Legitimate,
// not a bug.

func strcapF(s: string): string {
    return s
}

func strcapH(): string(8) {
    var big: string = "truncateme"
    return big
}

func runStrcap() {
    var x: string(8) = "hi"
    var y: string = strcapF(x)
    var z: string(8)
    var lst: list of string(8)
    var m: map of string(8)
    var mv: string(8)

    alert(y)

    z = strcapH()
    alert(z)
    alert(lastError.message)

    lst.push("this is over eight bytes")
    alert(lst.first())
    alert(lastError.message)

    mv = m.get("missing", y)
    alert(mv)
}

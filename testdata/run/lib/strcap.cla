// ARC regression proof (live=0): runStrcap's `lst: list of string(8)` is
// read by element (`lst.first()`) and `m: map of string(8)` is read by
// element (`m.get(...)`) -- both used to be the element-read-disqualified-
// container class (4e's escape walker), so neither was freed at scope
// exit. Every scope-exit candidate releases unconditionally now (ARC Task
// 4/8), so both `lst` and `m` release regardless of having been read by
// element. `.leaks` absent (0) -- the corpus gate (`go test
// ./internal/selfhost -run TestEmitDifferential`) enforces this
// permanently.

func strcapF(s: string): string {
    return s
}

func strcapH(): string(8) {
    var big: string = "truncateme"
    return big
}

func runStrcap() {
    var x: string(8) = "hi"
    var y: string = strcapF(x)
    var z: string(8)
    var lst: list of string(8)
    var m: map of string(8)
    var mv: string(8)

    alert(y)

    z = strcapH()
    alert(z)
    alert(lastError.message)

    lst.push("this is over eight bytes")
    alert(lst.first())
    alert(lastError.message)

    mv = m.get("missing", y)
    alert(mv)
}

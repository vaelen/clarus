var textassignGt: text = "global"

record textassignNote {
    body: text = "hi"
}

// Originally (4e, pre-ARC): expected leak count 6 -- three leaked `text`
// objects (2 blocks each), all pre-existing gaps in clarusc's escape
// pre-pass: `t2`'s `= "x" + "y"` initializer checked-types as a STRING
// concat (only widened to `text` at the assignment), which
// `lowEscapeFreshInit` didn't recognize as fresh, so `t2` never qualified
// for a scope-exit free at all; `t = t + " world"` pointer-swapped `t`'s
// handle without freeing the PREVIOUS one (freeing only `t`'s FINAL
// value); `note.body` (a record field) was never tracked by the
// locals-only pre-pass regardless.
//
// ARC Task 4 (counted named-slot stores + unconditional local release)
// closed the first two entirely: `t`'s every reassignment (the `t + "
// world"` concat, the `"goodbye"` literal, both go through
// `lowCountedStore`) now releases the OLD handle before storing the new
// one, and `t`/`t2` both get a genuine, unconditional scope-exit release
// regardless of their own declared-initializer's freshness (the OLD
// candidacy gate is gone -- see `lowEscapeCollectCandidates`'s own
// comment). Confirmed against the emitted C: every one of `t`'s
// reassignments is release-then-store, and the function ends with
// `rt_text_free(cv_t); rt_text_release(cv_t2);` (deep and shallow release
// are identical for a plain Text local -- no elements to walk).
// ARC Task 7 (record retain/release walks at every copy site, site 5)
// closes the last gap: `note` (a body-top record local) is now a
// scope-exit-release candidate too (lowEscapeCollectCandidates' own
// lowIsRecBearing branch), released via a plain IRelease that walks into
// `clar_release_textassignNote`, which releases `body`'s default `"hi"`
// handle. Confirmed against the emitted C: `clar_release_textassignNote(&(cv_note));`
// now appears at the function's end, alongside `t`/`t2`'s own releases.
// Expected strict-mode leak count: 0 (../textassign.leaks deleted, was 2).
func runTextassign() {
    var t: text = "hello"
    var t2: text = "x" + "y"
    var buf: char[64]
    var n: int
    var s: string
    var note: textassignNote

    n = textassignGt.toBytes(buf)
    s.fromBytes(buf, n)
    alert(s)

    n = note.body.toBytes(buf)
    s.fromBytes(buf, n)
    alert(s)

    n = t.toBytes(buf)
    s.fromBytes(buf, n)
    alert(s)

    t = t + " world"
    n = t.toBytes(buf)
    s.fromBytes(buf, n)
    alert(s)

    n = t2.toBytes(buf)
    s.fromBytes(buf, n)
    alert(s)

    t = "goodbye"
    n = t.toBytes(buf)
    s.fromBytes(buf, n)
    alert(s)

    t[0] = 'G'
    n = t.toBytes(buf)
    s.fromBytes(buf, n)
    alert(s)

    if "Goodbya" < t {
        alert("str-lt-text")
    } else {
        alert("str-ge-text")
    }
    if t < "Goodbya" {
        alert("text-lt-str")
    } else {
        alert("text-ge-str")
    }
}

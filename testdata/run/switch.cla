enum Color { Red, Green, Blue }

func show(label: string, n: int) {
    var digits: char[12]
    var count: int = 0
    var v: int = n
    var s: string
    var i: int

    while v > 0 {
        digits[count] = char(v mod 10 + int('0'))
        v = v / 10
        count = count + 1
    }
    if count == 0 {
        digits[0] = '0'
        count = 1
    }
    s = label
    i = count - 1
    while i >= 0 {
        s = s + digits[i]
        i = i - 1
    }
    alert(s)
}

on App.launch {
    var c: Color
    var s: string
    var loopI: int
    var hits: int

    // int subject: multi-label case, single-label case, else
    for i in 0 to 4 {
        switch i {
        case 0, 1 {
            alert("low")
        }
        case 2 {
            alert("mid")
        }
        else {
            alert("high")
        }
        }
    }

    // enum subject: multi-label case
    c = Green
    switch c {
    case Red {
        alert("red")
    }
    case Green, Blue {
        alert("green-or-blue")
    }
    }

    // string subject: no match, no else -> statement does nothing
    s = "zzz"
    switch s {
    case "a" {
        alert("a")
    }
    case "b" {
        alert("b")
    }
    }
    alert("after no-match")

    // break inside a case body binds the enclosing LOOP, not the switch
    // (Ch5: switch desugars to if/else, so break has nothing else to bind
    // to). If it were swallowed instead, this loop would run all 5
    // iterations (hits = 4, loopI = 5) instead of stopping at loopI = 2.
    loopI = 0
    hits = 0
    while loopI < 5 {
        switch loopI {
        case 2 {
            break
        }
        else {
            hits = hits + 1
        }
        }
        loopI = loopI + 1
    }
    show("hits = ", hits)
    show("loopI after break = ", loopI)
}

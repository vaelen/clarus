func deep(): int {
    var x: int = ((((((((1 + 2) * 3) - 4) + 5) * 6) - 7) + 8) * 9)
    if x > 0 {
        while x > 0 {
            if x > 100 {
                if x > 200 {
                    for i in 0 to 3 {
                        if i > 1 {
                            switch i {
                            case 2 {
                                x = x - 1
                            }
                            else {
                                x = x - 2
                            }
                            }
                        }
                    }
                }
            }
            x = x - 1
        }
    }
    return x
}

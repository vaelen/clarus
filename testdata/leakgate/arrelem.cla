// arrelem.cla: memory-leak-fix phase Task 5 fix rounds 1+2 regression --
// round 1's review finding: cgContainerElemNeedsWalk/cgContainerElemRelease
// (native) and cpEmitRelease/cpEmitElemReleaseWalk's per-kind branches
// (host) had no KArr arm. `list of Item[3]` (and the map/sortedmap/intmap
// value-type equivalent) is legal Clarus -- check.cla only bans
// ptr/overlay/xrec as array ELEMENT types, not KArr as a container
// element/value type -- and BOTH the `.clear()` Deep walk (Task 4/5) and
// the pre-existing scope-exit teardown walk (cgDeepReleaseContainer/
// cpEmitRelease, predating this phase) silently skipped releasing the
// text handles packed inside each array-typed slot/value. Round 1 fixed
// this (cg68k.cla/cprint.cla's own KArr walk arms).
//
// Round 1 used Item[3] (array-of-handle-bearing-record), NOT text[3]
// (array-of-text), because populating a container element/value with a
// whole array-of-TEXT VALUE (`l.push(arrOfText)`/`m[k] = arrOfText`) hit a
// SEPARATE, pre-existing gap: lowListMethod's push/unshift and
// lowIndexAssign's List/Map/SortedMap/IntMap branches decided the *Retain
// intrinsic variant via `lowEscapeTrackableKind(irtKind(elemT)) or
// lowIsRecBearing(elemT)`, never lowArrHeapScalarBearing, so a whole
// array-of-Text/List/Map VALUE handed to push/unshift/index-assign was
// never retained -- round 1's OWN (correct) release walk then
// double-released it against the source array's own scope-exit release
// (confirmed: `rt_rc: over-release`). Round 2 fixes THIS gap (lower.cla's
// six retain-selection sites now also check lowArrHeapScalarBearing,
// sharing lowIsRecBearing's own lowRecStoreIsBirth birth check -- the two
// predicates are mutually exclusive at the innermost element, so
// combining them with `or` can never double-retain the record-array
// case). listPushWholeArrCase/mapPushWholeArrCase below are the
// round-2-review's own exact repro shape (text[3], NOT Item[3]) --
// confirmed to ABORT (`rt_rc: over-release at rt_ext_host.inc:183`,
// exit 134) before round 2's lower.cla fix, live=0 after.
record Item {
    name: text
}

func makeArrItem(n: string): Item {
    var it: Item
    it.name = n
    return it
}

// The work happens in these helpers, NOT in App.startCLI: `quit`
// deliberately skips the quitting handler's own scope-exit frees
// (clearprobe.cla's own doc comment) -- each RETURNS so its own release
// path (either `.clear()`'s Deep walk or the natural end-of-scope
// teardown walk) actually runs before this fixture's single live=0
// assertion at exit.
func listClearCase() {
    var l: list of Item[3]
    var a: Item[3]

    a[0] = makeArrItem("one")
    a[1] = makeArrItem("two")
    a[2] = makeArrItem("three")
    l.push(a)
    // .clear() Deep walk: must release all 3 record-held text handles
    // before the O(1) hard reset.
    l.clear()
}

func listTeardownCase() {
    var l: list of Item[3]
    var a: Item[3]

    a[0] = makeArrItem("four")
    a[1] = makeArrItem("five")
    a[2] = makeArrItem("six")
    l.push(a)
    // l goes out of scope here (function returns, no .clear()) -- pins
    // cgDeepReleaseContainer's/cpEmitRelease's own pre-existing
    // container-teardown walk over an array-of-record element.
}

func mapClearCase() {
    var m: map of Item[3]
    var a: Item[3]

    a[0] = makeArrItem("seven")
    a[1] = makeArrItem("eight")
    a[2] = makeArrItem("nine")
    m["k"] = a
    m.clear()
}

func mapTeardownCase() {
    var m: map of Item[3]
    var a: Item[3]

    a[0] = makeArrItem("ten")
    a[1] = makeArrItem("eleven")
    a[2] = makeArrItem("twelve")
    m["k"] = a
}

func sortedMapClearCase() {
    var sm: sortedmap of Item[3]
    var a: Item[3]

    a[0] = makeArrItem("t1")
    a[1] = makeArrItem("t2")
    a[2] = makeArrItem("t3")
    sm["k"] = a
    sm.clear()
}

func intMapTeardownCase() {
    var im: intmap of Item[3]
    var a: Item[3]

    a[0] = makeArrItem("i1")
    a[1] = makeArrItem("i2")
    a[2] = makeArrItem("i3")
    im[1] = a
}

// listPushWholeArrCase/mapPushWholeArrCase: fix round 2's own repro --
// `list of text[3]`/`map of text[3]`, a whole array VALUE pushed/set (not
// built in place via `l[i][j] = ...`), function RETURNS (no `.clear()`) so
// both `a`'s own scope-exit release AND the container's teardown walk run.
// Pre-round-2-fix: `a`'s release drops the text handles to rc 0 (push/set
// never retained them), then the container's (round-1-correct) teardown
// walk tries to release the SAME already-freed handles again --
// `rt_rc: over-release`. Post-fix: push/set retains, so both releases are
// balanced.
func listPushWholeArrCase() {
    var l: list of text[3]
    var a: text[3]

    a[0] = "eleven"
    a[1] = "twelve"
    a[2] = "thirteen"
    l.push(a)
}

func mapPushWholeArrCase() {
    var m: map of text[3]
    var a: text[3]

    a[0] = "fourteen"
    a[1] = "fifteen"
    a[2] = "sixteen"
    m["k"] = a
}

on App.startCLI(args: list of string) {
    listClearCase()
    listTeardownCase()
    mapClearCase()
    mapTeardownCase()
    sortedMapClearCase()
    intMapTeardownCase()
    listPushWholeArrCase()
    mapPushWholeArrCase()
    quit 0
}

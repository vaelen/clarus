// AppleTalk phase, Task 3: service.reply(code: int, data: text) -- the
// code comes first and the payload second, so the swapped call below is
// two argument-type errors, one per parameter.
var svc: service

on svc.request(op: int, req: text, from: address) {
    svc.reply("x", 1)
}

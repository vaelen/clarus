// control.cla: native-5d Task 8 cg68k golden fixture -- if/else-if/else
// chains, a while loop with break and continue, and nested for-range
// loops. Exercises cgIfStmt/cgWhileStmt/cgForRangeStmt/cgBreakStmt/
// cgContinueStmt.

func classify(n: int): int {
    var result: int
    if n < 0 {
        result = -1
    } else if n == 0 {
        result = 0
    } else {
        result = 1
    }
    return result
}

func sumEvens(limit: int): int {
    var i: int
    var total: int

    total = 0
    i = 0
    while i <= limit {
        if i mod 2 != 0 {
            i = i + 1
            continue
        }
        if i > 100 {
            break
        }
        total = total + i
        i = i + 1
    }
    return total
}

func nestedRange(): int {
    var i: int
    var j: int
    var total: int

    total = 0
    for i in 1 to 3 {
        for j in 1 to 2 {
            total = total + i * j
        }
    }
    return total
}

on App.launch {
    var a: int
    var b: int
    var c: int

    a = classify(-5)
    b = sumEvens(10)
    c = nestedRange()
    return
}

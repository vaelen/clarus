// control.cla: native-5d Task 8 cg68k golden fixture -- if/else-if/else
// chains, a while loop with break and continue, and nested for-range
// loops. Exercises cgIfStmt/cgWhileStmt/cgForRangeStmt/cgBreakStmt/
// cgContinueStmt.
//
// task-8-review round 1 fix, Minor: guardedRatio/eitherPositive pin
// and/or SHORT-CIRCUIT branch structure (cgAndOr) -- guardedRatio's
// `a > 0 and b / a > 1` is the classic div-by-zero-guarding shape that
// REQUIRES short-circuit (evaluating `b/a` when `a<=0` would be a
// div-by-zero, or at minimum a needless/wrong divide); the golden pins
// that `b/a` is only ever reached on the branch where `a>0` already
// tested true.

func guardedRatio(a: int, b: int): bool {
    var ok: bool
    ok = a > 0 and b / a > 1
    return ok
}

func eitherPositive(a: int, b: int): bool {
    var ok: bool
    ok = a > 0 or b > 0
    return ok
}

func classify(n: int): int {
    var result: int
    if n < 0 {
        result = -1
    } else if n == 0 {
        result = 0
    } else {
        result = 1
    }
    return result
}

func sumEvens(limit: int): int {
    var i: int
    var total: int

    total = 0
    i = 0
    while i <= limit {
        if i mod 2 != 0 {
            i = i + 1
            continue
        }
        if i > 100 {
            break
        }
        total = total + i
        i = i + 1
    }
    return total
}

func nestedRange(): int {
    var i: int
    var j: int
    var total: int

    total = 0
    for i in 1 to 3 {
        for j in 1 to 2 {
            total = total + i * j
        }
    }
    return total
}

on App.launch {
    var a: int
    var b: int
    var c: int
    var g: bool
    var e: bool

    a = classify(-5)
    b = sumEvens(10)
    c = nestedRange()
    g = guardedRatio(0, 5)
    e = eitherPositive(-1, 2)
    return
}

// bigtmp16.cla (renamed from bigtmp_ceiling.cla, binary-files phase
// Task 10 -- the name-cleanup deferral its own review left open):
// originally a mac-resident-clarusc Task 3 regression
// pin for the OLD flat cgBigTmpSlots ceiling -- clarusc's own self-emit
// (compiling itself through `clarusc emit68k`) needs 16 concurrently-live
// big (str/rec) temps within ONE statement (a call whose OWN 16 arguments
// each need the generic materialize-to-temp fallback, so
// cgStmtBigTmpNext's per-statement bump allocator never gets to reuse a
// slot before the call itself fires), which is what drove the const to
// 16 back then. binary-files phase Task 8 replaced that flat per-program
// const with a per-function pool sized from a measure pass (see
// clarusc/cg68k.cla's own cgBigTmpFloor/cgAllocBigTmpOff doc comments),
// so there is no longer a ceiling for this fixture to pin -- it now just
// serves as a cg68k emit golden proving a 16-big-temp function's frame
// layout (LINK immediate, pool offsets) stays correct.
func take16(a: string, b: string, c: string, d: string, e: string, f: string, g: string, h: string, i: string, j: string, k: string, l: string, m: string, n: string, o: string, p: string): int {
    return a.length + b.length + c.length + d.length + e.length + f.length + g.length + h.length + i.length + j.length + k.length + l.length + m.length + n.length + o.length + p.length
}
on App.startCLI(args: list of string) {
    var n: int
    n = take16("a" + "1", "a" + "2", "a" + "3", "a" + "4", "a" + "5", "a" + "6", "a" + "7", "a" + "8", "a" + "9", "a" + "10", "a" + "11", "a" + "12", "a" + "13", "a" + "14", "a" + "15", "a" + "16")
    if n == 39 {
        alert("bigtmp ceiling ok")
    } else {
        alert("bigtmp ceiling FAIL")
    }
    quit 0
}

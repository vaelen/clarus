// arr_whole_assign.cla: native-5e Task 2 (5d final-review C1) native boot
// gate -- TestNativeArrWholeAssign (internal/mactest/native_test.go) builds
// this BOTH ways via runNativeHostCompare: the host expectation via
// build.Build (the Go compiler -- this fixture is deliberately
// Go-compiler-compatible, no Ch13 surface, same discipline as smoke.cla's
// own header comment), and the native image via `clarusc emit68k`, then
// requires the emulator's captured output to be byte-identical to the
// host's stdout. Content is the same regression matrix as
// testdata/lowlevel/arr_whole_assign.cla (that copy is the host-lane
// cprint-vs-host-cc/strict-leak-gate oracle under internal/lowlevel; this
// one is the Go-compiler-vs-native-boot oracle under internal/mactest --
// two different toolchains/oracles per the existing testdata/cg68k vs
// testdata/lowlevel split, same fixture shape, deliberately kept as two
// physical files rather than an include so each corpus stays self-
// contained per its own harness's glob/build conventions).
//
// Each case: build a source array/record, whole-assign it into a
// destination, then MUTATE the source afterward and assert the destination
// kept the original values (Ch3 copy-by-value, not aliasing). `Pt[3]` (arr
// N of Rec) is deliberately scalar-only (no text/list/map field) -- a
// whole-array block copy of a HANDLE-bearing element fails closed instead
// (cg68k.cla's cgNeedsRelease guard, testdata/lowlevel/arr_whole_assign.cla's
// own header comment has the full rationale; not exercised here since this
// fixture is asserting the SUCCESS path).

record Box {
    ints: int[4]
}

record Pt {
    x: int
    y: int
}

on App.startCLI(args: list of string) {
    var a: int[4]
    var b: int[4]
    var c: char[3]
    var d: char[3]
    var r: Box
    var pa: Pt[3]
    var pb: Pt[3]
    var m: int[3][2]
    var row: int[3]

    // int[4] whole assign, then mutate the source.
    a[0] = 10
    a[1] = 20
    a[2] = 30
    a[3] = 40
    b = a
    a[0] = 999
    a[1] = 999
    a[2] = 999
    a[3] = 999
    if b[0] == 10 and b[1] == 20 and b[2] == 30 and b[3] == 40 {
        alert("int-copy-ok")
    } else {
        alert("int-copy-FAIL")
    }

    // char[3] whole assign, then mutate the source.
    c[0] = 'x'
    c[1] = 'y'
    c[2] = 'z'
    d = c
    c[0] = 'q'
    c[1] = 'q'
    c[2] = 'q'
    if d[0] == 'x' and d[1] == 'y' and d[2] == 'z' {
        alert("char-copy-ok")
    } else {
        alert("char-copy-FAIL")
    }

    // r.field = arrVar (EFieldRef dst), then mutate the source and confirm
    // the record field's copy is independent.
    r.ints = b
    if r.ints[0] == 10 and r.ints[1] == 20 and r.ints[2] == 30 and r.ints[3] == 40 {
        alert("field-copy-ok")
    } else {
        alert("field-copy-FAIL")
    }
    b[0] = 555
    if r.ints[0] == 10 {
        alert("field-copy-independent-ok")
    } else {
        alert("field-copy-independent-FAIL")
    }

    // Pt[3] (arr N of Rec, scalar-only element) whole assign, then mutate
    // the source.
    pa[0].x = 1
    pa[0].y = 2
    pa[1].x = 3
    pa[1].y = 4
    pa[2].x = 5
    pa[2].y = 6
    pb = pa
    pa[0].x = 999
    pa[1].y = 999
    if pb[0].x == 1 and pb[0].y == 2 and pb[1].x == 3 and pb[1].y == 4 and pb[2].x == 5 and pb[2].y == 6 {
        alert("rec-arr-copy-ok")
    } else {
        alert("rec-arr-copy-FAIL")
    }

    // m[1] = row (EIndexRef dst, a fixed-array element of the nested
    // `int[3][2]` -- 2 outer elements, each an int[3]), then mutate the
    // source and confirm the outer array's element copy is independent --
    // exercises cgIndexRefAddr's Arr lane (bounds-checked, unlike the
    // List lane) for a KArr dst, the one addressing shape the other cases
    // above don't reach. (Not `list of int[3]`: pushing a fixed-array
    // VALUE onto a list hits a separate, pre-existing cg68k gap --
    // cgExpr's own "EVarRef non-scalar reached in value context" guard,
    // cgPushArgs' arg-dispatch never learned a KArr-by-value shape --
    // unrelated to this task's whole-array-ASSIGNMENT fix.)
    m[0][0] = 11
    m[0][1] = 22
    m[0][2] = 33
    row[0] = 100
    row[1] = 200
    row[2] = 300
    m[1] = row
    row[0] = 999
    if m[0][0] == 11 and m[1][0] == 100 and m[1][1] == 200 and m[1][2] == 300 {
        alert("nested-elem-copy-ok")
    } else {
        alert("nested-elem-copy-FAIL")
    }
}

// traps.cla: native-5d Task 9 cg68k golden fixture -- ECallExt codegen.
// One extern per clause form (Task 2's registry), plus a clause-less
// extern resolved through its own nat_ fallback (defined right here, so
// the fallback path is self-contained and doesn't depend on any other
// module's nat_ functions):
//
//   TNewHandle       = trap 0xA122 reg    (real _NewHandle -- see the
//                                          Task 9 report's trap-word
//                                          verification table)
//   NewPtr/DisposePtr = trap 0xA11E/0xA01F reg (real _NewPtr/_DisposePtr,
//                                          for the peekb/pokeb exercise
//                                          below)
//   FixtureMixedTrap = trap 0xA9C8        (SYNTHETIC signature riding the
//                                          real _SysBeep trap word, purely
//                                          to exercise every PASCAL push
//                                          shape -- ptr/int/bool/char/str
//                                          -- in one call; NOT a faithful
//                                          _SysBeep reproduction, see the
//                                          report)
//   THandleDeref     = inline deref
//   TRcCheck         = inline nop
//   TCustomOp        = no clause -> nat_TCustomOp (defined below)
//   TMoveTo          = trap 0xA893        (real _MoveTo -- Task 4, native-5e:
//                                          `word` PASCAL arg push, both
//                                          params, no return)
//   TFindWindow      = trap 0xA92C        (real _FindWindow -- Task 4:
//                                          `word` PASCAL RESULT, sign-
//                                          extended via EXT.L)
//   TSetHandleSize   = trap 0xA024 reg memerr (real _SetHandleSize --
//                                          Task 14, native-5e: a `reg`
//                                          Toolbox call whose real Pascal
//                                          signature is `void` -- the
//                                          result comes from the MemErr
//                                          low-memory global ($0220)
//                                          instead of D0; see
//                                          cgCallExtRegMemErr's own doc
//                                          comment, cg68k.cla)

external func TNewHandle(n: int): ptr = trap 0xA122 reg
external func NewPtr(size: int): ptr = trap 0xA11E reg
external func DisposePtr(p: ptr) = trap 0xA01F reg
external func FixtureMixedTrap(p: ptr, n: int, f: bool, c: char, s: string): int = trap 0xA9C8
external func THandleDeref(h: ptr): ptr = inline deref
external func TRcCheck(box: ptr, rc: int) = inline nop
external func TCustomOp(x: int): int
external func TMoveTo(h: word, v: word) = trap 0xA893
external func TFindWindow(pt: int, wpOut: ptr): word = trap 0xA92C
external func TSetHandleSize(h: ptr, n: int): int = trap 0xA024 reg memerr

func nat_TCustomOp(x: int): int {
    return x + 1
}

on App.launch {
    var h: ptr
    var d: ptr
    var buf: ptr
    var r: int
    var s: string(255)
    var custom: int

    h = TNewHandle(64)
    d = THandleDeref(h)
    TRcCheck(h, 1)

    s = "hi"
    r = FixtureMixedTrap(d, 5, true, 'A', s)

    custom = TCustomOp(10)

    TMoveTo(10, 20)
    r = TFindWindow(0, d)

    buf = NewPtr(8)
    pokeb(buf, 65)
    pokew(buf + 2, 4660)
    pokel(buf + 4, 305419896)
    r = peekb(buf)
    r = peekw(buf + 2)
    r = peekl(buf + 4)
    // A poke whose VALUE operand is itself a peek: both need A0, so the
    // destination address must survive across the value expression (it is
    // spilled to the stack, see cgIntrPoke). Parking it in A0 instead
    // stores through the SOURCE address -- native.cla's natItoa digit copy
    // hit exactly this, and it is the only shape that catches it.
    pokeb(buf + 1, peekb(buf))
    r = TSetHandleSize(h, 128)
    DisposePtr(buf)

    return
}

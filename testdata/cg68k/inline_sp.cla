// inline_sp.cla (SE wave 0): pins cgCallExtSp's own encoding
// (`MOVE.L A7,D0`) for `= inline sp` in isolation -- the twin of
// inline_a5.cla. A local test-only extern: the golden harness runs a bare
// `emit68k --listing` with no runtime-module linkage.
external func TestSp(): ptr = inline sp

on App.startCLI(args: list of string) {
    var p: ptr
    p = TestSp()
}

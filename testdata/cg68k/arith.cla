// arith.cla: native-5d Task 7's cg68k golden fixture, extended by Task 8
// with real arithmetic/comparison/unary/conversion codegen. label()/
// App.launch still pin the original frame-layout shapes (hidden result
// pointer, local str slot); arithDemo() is the Task 8 addition -- mixed-
// sign +,-,*,/,mod, all six comparisons, unary -/not/~, bitwise &,|,^,
// <<,>>, and every EConv this backend implements except CvIntToEnum
// (needs an enum pool table, Task 12) and the two overlay conversions
// (need a declared overlay record type -- out of scope for a pure
// arithmetic fixture; their codegen is the same identity-passthrough
// code path CvPtrToInt/CvIntToPtr already exercise here).
//
// task-8-review round 1 fix, Critical 2: `fneg`/`backNeg` pin
// CvFixedToInt on a NEGATIVE FRACTIONAL fixed value (-1.5) -- the case a
// plain ASR.L floors instead of truncating toward zero (arithDemo's
// other fixed conversion, `f = fixed(a)` with `a=7`, is always
// non-negative, so it never exercised this).

func label(n: int): string(255) {
    var s: string(255)
    s = "x"
    return s
}

func arithDemo(a: int, b: int): int {
    var sum: int
    var diff: int
    var prod: int
    var q: int
    var r: int
    var negA: int
    var eqFlag: bool
    var ltFlag: bool
    var notFlag: bool
    var bitAnd: int
    var bitOr: int
    var bitXor: int
    var bitNot: int
    var shl: int
    var shr: int
    var f: fixed
    var backToInt: int
    var c: char
    var backToInt2: int
    var p: ptr
    var backToInt3: int
    var fneg: fixed
    var backNeg: int

    sum = a + b
    diff = a - b
    prod = a * b
    q = a / b
    r = a mod b
    negA = -a
    eqFlag = a == b
    ltFlag = a < b
    notFlag = not eqFlag
    bitAnd = a & b
    bitOr = a | b
    bitXor = a ^ b
    bitNot = ~a
    shl = a << 2
    shr = a >> 2
    f = fixed(a)
    backToInt = int(f)
    c = char(a)
    backToInt2 = int(c)
    p = ptr(a)
    backToInt3 = int(p)
    fneg = -1.5
    backNeg = int(fneg)
    return sum + diff + prod + q + r + negA + bitAnd + bitOr + bitXor + bitNot + shl + shr + backToInt + backToInt2 + backToInt3 + backNeg
}

on App.launch {
    var a: int
    var b: int
    var s: string(255)
    var ax: int

    a = 1
    b = 2
    a = a + b
    s = label(a)
    ax = arithDemo(7, -3)
    return
}

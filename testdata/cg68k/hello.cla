// hello.cla: native-5d Task 11's walking-skeleton fixture -- the first
// program ever booted on real (emulated) 68k hardware through emit68k.
// Deliberately minimal: one alert() call, nothing else, so a boot failure
// has the smallest possible amount of generated code to suspect.

on App.launch {
    alert("hello, 68k")
}

// multiseg.cla (SE wave 5, tests/cg68k/freeglobals.sh): big enough to
// pack into several CODE segments (forty padding functions, each a few
// hundred bytes of straight-line code), with `quit` executed from
// fgQuitter, which the packer places past segment 1. Every segment
// carries its own table-driven cg_free_globals; the quit site must reach
// its OWN segment's copy. Globals: a text, a record with a walk, a list
// of text and an array of text.

record Pair {
    a: text
    b: text
}

var title: text
var pair: Pair
var lines: list of text
var cols: text[2]

func fgPad1(n: int): int {
    var s: int
    s = n * 1
    s = s + (n / 3) * (n mod 7) + 1
    s = s - (s / 5) + (n * n) mod 11
    s = s + (s mod 13) * (n + 1) / 2
    s = s * 3 + (s / 7) - (n mod 5) * 1
    s = s + (s mod 17) + (n * 19) / 3
    s = s - (s / 9) + (n mod 23) * 2
    s = s + (s * 5) mod 29 + (n / 2)
    return s
}


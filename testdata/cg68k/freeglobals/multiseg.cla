func fgQuitter(total: int) {
    title = "multiseg"
    pair.a = "left"
    lines.push("one")
    cols[1] = "col"
    log("multiseg " + string(total) + " " + string(title.length + lines.count))
    quit 0
}

on App.launch {
    var t: int
    t = 0
    t = t + fgPad1(1) mod 1000
    t = t + fgPad2(2) mod 1000
    t = t + fgPad3(3) mod 1000
    t = t + fgPad4(4) mod 1000
    t = t + fgPad5(5) mod 1000
    t = t + fgPad6(6) mod 1000
    t = t + fgPad7(7) mod 1000
    t = t + fgPad8(8) mod 1000
    t = t + fgPad9(9) mod 1000
    t = t + fgPad10(10) mod 1000
    t = t + fgPad11(11) mod 1000

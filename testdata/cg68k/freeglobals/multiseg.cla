    t = t + fgPad16(16) mod 1000
    t = t + fgPad17(17) mod 1000
    t = t + fgPad18(18) mod 1000
    t = t + fgPad19(19) mod 1000
    t = t + fgPad20(20) mod 1000
    t = t + fgPad21(21) mod 1000
    t = t + fgPad22(22) mod 1000
    t = t + fgPad23(23) mod 1000
    t = t + fgPad24(24) mod 1000
    t = t + fgPad25(25) mod 1000
    t = t + fgPad26(26) mod 1000
    t = t + fgPad27(27) mod 1000
    t = t + fgPad28(28) mod 1000
    t = t + fgPad29(29) mod 1000
    t = t + fgPad30(30) mod 1000
    t = t + fgPad31(31) mod 1000
    t = t + fgPad32(32) mod 1000
    t = t + fgPad33(33) mod 1000
    t = t + fgPad34(34) mod 1000
    t = t + fgPad35(35) mod 1000
    t = t + fgPad36(36) mod 1000
    t = t + fgPad37(37) mod 1000
    t = t + fgPad38(38) mod 1000
    t = t + fgPad39(39) mod 1000
    t = t + fgPad40(40) mod 1000
    fgQuitter(t)
}

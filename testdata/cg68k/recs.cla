// recs.cla: native-5d Task 12's cg68k golden fixture -- records. Pins:
// ENewRec/field-default construction (a nested record, a non-zero scalar
// default, an enum-typed field defaulting to its enum's first member, a
// str field with no explicit default), field get/set (top-level and
// nested), record-to-record assign-copy, record params, record returns
// (the hidden-result-pointer convention), and a handle-bearing record
// (a `text` field) so cg_retain_recsBox/cg_release_recsBox actually get
// generated and exercised via a real copy site -- compile-only coverage
// (this file is never booted; smoke.cla stays handle-free so the boot
// test's host-vs-native byte-compare never depends on ARC's runtime
// correctness, see the Task 12 report).
//
// task-12-review's Important finding (fixed, cgPushArgs/cgExprAddr):
// `recsSum(recsMake(555))` -- a KRec argument that is itself a nested
// ECallFn result -- used to silently miscompile (the inner call dropped
// entirely, the outer call reading garbage from address 0). `total = ...`
// below pins the fixed sequence: the inner call now constructs directly
// into the argument's own reserved stack slot via the hidden-pointer
// convention, no separate temp+copy. `recsMakeBox("first")` pins the
// SAME class of bug for a capacity-coerced str literal argument
// (`IStrCoerce`, lower.cla's `lowCoerceStr` -- "first" is str(255),
// `label` is str(31)), found while fixing the ECallFn case (cgExprAddr's
// hard-error would otherwise break this line's own compile).
// `recsSum(new recsPerson)` pins the fix's third materializable shape,
// ENewRec-as-a-bare-call-argument -- previously documented as an
// unsupported limitation (Task 12 report Concern #4), now handled by the
// same reserved-slot-construction mechanism.
//
// Fix round 2's re-review finding (fixed, cgEmitPtrRcCall/
// cgEmitRecWalkCall/cgDefaultInitStrAt): a SECOND A0/A1-drift bug, in the
// cg_retain_/cg_release_ walk itself rather than the ctor -- a
// handle-bearing NESTED-RECORD field that is NOT a record's own last
// field clobbers A1 (the reg=0 walk's base stash) via the nested record's
// own JSR'd cg_retain_/cg_release_ call, corrupting every field
// processed afterward. `recsInner`/`recsOuter` below are the SMALLEST
// shape that proves it: `recsOuter.a` (handle-bearing, via
// `recsInner.note: text`) sits between `pad` and `b`, so `cg_retain_
// recsOuter`/`cg_release_recsOuter`'s own field walk must correctly
// restore its base before touching `b` -- see `o2 = o1` below and the
// Task 12 report's fix-round-2 section for the hand-verified listing.

enum recsStatus {
    Active 5 "Active"
    Done   6 "Done"
}

record recsAddr {
    city: string(31)
    zip:  int
}

record recsPerson {
    name:   string(31)
    age:    int = 18
    status: recsStatus
    home:   recsAddr
}

record recsBox {
    label: string(31)
    note:  text
}

// recsInner/recsOuter: fix round 2's proven shape -- a handle-bearing
// nested-record field (`a`) that is NOT `recsOuter`'s own last field,
// with a plain scalar field before it (`pad`) and another handle-bearing
// field after it (`b`), so `cg_retain_recsOuter`/`cg_release_recsOuter`'s
// own walk must correctly restore its base between `a` and `b`.
record recsInner {
    tag:  int
    note: text
}

record recsOuter {
    pad: int
    a:   recsInner
    b:   text
}

func recsMake(zip: int): recsPerson {
    var p: recsPerson = new recsPerson
    p.home.zip = zip
    return p
}

func recsSum(p: recsPerson): int {
    return p.age + p.home.zip
}

func recsMakeBox(label: string(31)): recsBox {
    var b: recsBox = new recsBox
    b.label = label
    return b
}

on App.launch {
    var p: recsPerson = new recsPerson
    var q: recsPerson
    var b1: recsBox
    var b2: recsBox
    var total: int
    var o1: recsOuter
    var o2: recsOuter

    p.name = "Original"
    p.home.city = "Springfield"
    p.home.zip = 90210

    q = p
    q.age = 99
    q.home.zip = 11111

    total = recsSum(recsMake(555))
    total = recsSum(new recsPerson)

    b1 = recsMakeBox("first")
    b2 = b1

    o2 = o1
}

// roundtrip.cla: Task 4's Snow-harness self-test fixture -- the smallest
// UI program that proves the host<->Snow file round trip: reads a marker
// file the harness planted on the boot image, writes its contents back
// out under a different name (proving file.writeText actually landed
// bytes on the real HFS volume, not just a host-side illusion), then
// quits. Modeled on testdata/cg68k/tickprobe.cla's app/window shape and
// testdata/ui/texteditor_opendoc_setup.cla's file.writeText usage.
// internal/mactest/snow_test.go rebuilds this via scripts/build-68k.sh.
//
// Path convention (Linux emulator port, 2026-09-27): the harness plants
// input/output files on the scratch "Clarus" volume (SCSI 1), never next
// to this app -- on System 7 it self-launches from ":System Folder:
// Startup Items:" (the Finder would auto-open a document there too and
// throw a blocking dialog), on System 6 from ":System Folder:" as the
// boot blocks' startup program. "Clarus:NAME" is an absolute HFS pathname,
// so it reaches the same file from either launch directory.
app SnowRoundTrip {
    name: "SnowRoundTrip"
    version: "1.0"
    author: "Andrew C. Young <andrew@vaelen.org>"
    about: "Snow harness round-trip fixture."
    id: "SNRT"
}

window Main {
    title: "SnowRoundTrip"
    size: 200, 100
}

var tries: int = 0

on App.launch {
    open Main
}

// The file round trip runs from the event loop, not App.launch: on System 6
// this app is the boot blocks' startup program, launched BEFORE anything
// has pulled the SCSI "Clarus" volume's disk-inserted event, and that
// volume is only mounted once the app's own event loop runs (measured,
// 2026-09-27: "could not open file" from App.launch). So retry the read
// once a second for up to 20 s, then write and quit either way.
every 60 ticks {
    var t: text
    var ok1: bool
    var ok2: bool
    tries = tries + 1
    ok1 = file.readText("Clarus:Marker.txt", t)
    if not ok1 and tries < 20 {
        return
    }
    ok2 = file.writeText("Clarus:Copy.txt", t, app.doctype, app.id)
    // log() on the native (emit68k) lane is a capture-only stub (native.cla's
    // natLog) buffered into the "out" file by natQuit's own trailer, so
    // these are cheap extra signal for the harness to assert on. NOT alert():
    // since the attempt-abort phase (be75375, 2026-08-14) a UI program's
    // alert() shows a REAL modal dialog on an unscripted native build,
    // and this fixture is never scripted -- the first alert would block
    // forever on its OK button (that was the 2026-09-05 "roundtrip red").
    if ok1 {
        log("read ok")
    } else {
        log("read FAILED: " + lastError.message)
    }
    if ok2 {
        log("write ok")
    } else {
        log("write FAILED: " + lastError.message)
    }
    quit
}

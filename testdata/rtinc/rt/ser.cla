// Fake runtime module for the inclusion-machinery test (Task 4). Includes
// helper.cla so the test also covers a multi-file runtime module: expand's
// recursion into rtPath's own includes must have ALL of its heads spliced
// into the combined program, not just rtPath's own trailing head.
include "helper.cla"

func rtIncProbe(): int {
    return rtIncHelper() + 4242
}

// prog.cla: implicit runtime-module inclusion fixture (Task 4). Exercises
// file.save so checkMethodCall's `file` arm sets usesFileSaveLoad, which
// main.cla's hardcoded manifest maps to the stand-in runtime module
// testdata/rtinc/rt/ser.cla (--rtdir testdata/rtinc/rt).
record Note { n: int }
on App.startCLI(args: list of string) {
    var x: Note
    x.n = 7
    file.save("t.dat", x, app.doctype, app.id)
}

// test_suite.cla: monolithic pure-Clarus test suite (Task 6). Includes
// every logic file under testdata/run/lib/ (all 41, alphabetical by file
// name) and calls each one's entry func(s) in a single App.launch handler,
// alerting a "=== <lib file name> ===" delimiter before each. Multi-entry
// libs (clifallback, launchorder) call their entry funcs in original
// handler order (launch before start).
//
// cli.cla's runCli(args: list of string) gets a synthetic two-element arg
// list ("alpha", "beta"). emit_strings/emit_switch/emit_text also declare
// an `args: list of string` parameter (carried over from their original
// startCLI-driven wrapper programs) but never read it, so the same
// cliArgs list is reused for them and for every other emit_*(args) entry
// func below -- any fixed args are fine since host stdout is the
// expectation this suite exists to capture, not args-dependent behavior.
//
// This program's stdout, run on the host toolchain, is the byte-exact
// expectation for the Mac run (see internal/mactest).
//
// emit_array and emit_enum are excluded entirely, not just uncalled: each
// one's final section deliberately triggers a runtime panic (rt_arr_check
// / rt_enum_from_int -> rt_panic, exit 3) to prove out-of-range array
// access and an invalid checked int->enum conversion abort the process
// instead of producing a bogus value. Calling either entry func to
// completion here would terminate this whole suite process before "===
// suite done ===" -- incompatible with a single monolithic run covering
// the rest of the 41 lib files, and not a contract violation to work
// around by editing the lib file. A delimiter with no entry-func call
// would read as fake coverage, so both the `include` and the delimiter
// alert are dropped for these two names, not just the call.
//
// These abort-by-design tests (emit_array, emit_enum, and all of
// testdata/runerr/) are NOT dropped from coverage -- they run as
// STANDALONE apps under the Mac harness (internal/mactest, plan Task 11),
// which builds and runs each one on its own and checks its pre-abort
// stdout, panic message, and exit code against its existing goldens
// (testdata/run/<name>.{out,exit} for emit_array/emit_enum;
// testdata/runerr/<name>.err for the runerr set). internal/mactest's
// suite_host_test.go tracks the exclusion explicitly (suiteExcluded) so a
// future lib file silently dropped from this suite still fails that test.

include "../run/lib/appendperf.cla"
include "../run/lib/arith.cla"
include "../run/lib/binroundtrip.cla"
include "../run/lib/breakcont.cla"
include "../run/lib/cli.cla"
include "../run/lib/clifallback.cla"
include "../run/lib/collections.cla"
include "../run/lib/concat_order.cla"
include "../run/lib/constants.cla"
include "../run/lib/crc8.cla"
include "../run/lib/emit_arith.cla"
include "../run/lib/emit_control.cla"
include "../run/lib/emit_file.cla"
include "../run/lib/emit_func.cla"
include "../run/lib/emit_hello.cla"
include "../run/lib/emit_list.cla"
include "../run/lib/emit_longline.cla"
include "../run/lib/emit_map.cla"
include "../run/lib/emit_record.cla"
include "../run/lib/emit_strings.cla"
include "../run/lib/emit_switch.cla"
include "../run/lib/emit_text.cla"
include "../run/lib/emit_wideproto.cla"
include "../run/lib/enums.cla"
include "../run/lib/errvar.cla"
include "../run/lib/files.cla"
include "../run/lib/fixedmath.cla"
include "../run/lib/hello.cla"
include "../run/lib/launchorder.cla"
include "../run/lib/mutrec.cla"
include "../run/lib/records.cla"
include "../run/lib/savechoice.cla"
include "../run/lib/slices.cla"
include "../run/lib/strcap.cla"
include "../run/lib/strings.cla"
include "../run/lib/switch.cla"
include "../run/lib/textassign.cla"
include "../run/lib/truncate.cla"
include "../run/lib/widen_text.cla"

on App.launch {
    var cliArgs: list of string

    cliArgs.push("alpha")
    cliArgs.push("beta")

    alert("=== appendperf ===")
    runAppendperf()
    alert("=== arith ===")
    runArith()
    alert("=== binroundtrip ===")
    runBinroundtrip()
    alert("=== breakcont ===")
    runBreakcont()
    alert("=== cli ===")
    runCli(cliArgs)
    alert("=== clifallback ===")
    runClifallbackLaunch()
    runClifallbackStartEmpty()
    alert("=== collections ===")
    runCollections()
    alert("=== concat_order ===")
    runConcatOrder()
    alert("=== constants ===")
    runConstants()
    alert("=== crc8 ===")
    runCrc8()
    alert("=== emit_arith ===")
    runEmitArith(cliArgs)
    alert("=== emit_control ===")
    runEmitControl(cliArgs)
    alert("=== emit_file ===")
    runEmitFile()
    alert("=== emit_func ===")
    runEmitFunc()
    alert("=== emit_hello ===")
    runEmitHello(cliArgs)
    alert("=== emit_list ===")
    runEmitList(cliArgs)
    alert("=== emit_longline ===")
    runEmitLongline(cliArgs)
    alert("=== emit_map ===")
    runEmitMap(cliArgs)
    alert("=== emit_record ===")
    runEmitRecord(cliArgs)
    alert("=== emit_strings ===")
    runEmitStrings(cliArgs)
    alert("=== emit_switch ===")
    runEmitSwitch(cliArgs)
    alert("=== emit_text ===")
    runEmitText(cliArgs)
    alert("=== emit_wideproto ===")
    runEmitWideproto()
    alert("=== enums ===")
    runEnums()
    alert("=== errvar ===")
    runErrvar()
    alert("=== files ===")
    runFiles()
    alert("=== fixedmath ===")
    runFixedmath()
    alert("=== hello ===")
    runHello()
    alert("=== launchorder ===")
    runLaunchorderLaunch()
    runLaunchorderStart()
    alert("=== mutrec ===")
    runMutrec()
    alert("=== records ===")
    runRecords()
    alert("=== savechoice ===")
    runSavechoice()
    alert("=== slices ===")
    runSlices()
    alert("=== strcap ===")
    runStrcap()
    alert("=== strings ===")
    runStrings()
    alert("=== switch ===")
    runSwitch()
    alert("=== textassign ===")
    runTextassign()
    alert("=== truncate ===")
    runTruncate()
    alert("=== widen_text ===")
    runWidenText()

    alert("=== suite done ===")
}

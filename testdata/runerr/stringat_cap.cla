// stringat_cap.cla (clir-load-perf Task 2): stringAt's "string too long"
// panic -- a 4-byte BE length prefix of 256 exceeds Str255's own
// 255-byte cap. Host-only fixture, same precedent as textrange_oor.cla.
on App.launch {
    var t: text
    var s: string

    t.append(char(0))
    t.append(char(0))
    t.append(char(1))
    t.append(char(0))
    s = t.stringAt(0)
    alert("unreachable")
}

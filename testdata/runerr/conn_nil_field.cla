// conn_nil_field.cla (Task 4, binary-files phase): a `connection` FIELD
// (never assigned, so nil -- zero, like any other never-assigned int
// field) is a legal method-call receiver now (lowConnMethod lowers ANY
// receiver expression via lowExpr, lower.cla) but sending on it is a
// runtime contract violation, exactly like sending on a never-assigned
// local/global connection -- runtime/clarus/conn.cla's `h == 0` guard
// panics "use of nil connection" before ever touching rtConnState.
//
// `conn` below is otherwise unused -- it exists only so usesConn
// (check.cla, GLOBAL-var-only by design) is true and the host build
// splices conn.cla in at all; without it `rtConnSendText` (the runtime
// call r.c.send lowers to) would be an unresolved symbol, a link error
// instead of the intended runtime panic.
//
// Host-only pinning, same layout convention as conn_send_closed.cla
// (.cla + .err + .behavior; discovered by internal/selfhost/
// behavior_test.go's testdata/runerr glob). NOT yet exercised by T1
// (behavior_test.go lives in internal/selfhost, which
// scripts/test-task.sh explicitly excludes).
var conn: connection

record R { c: connection }

var r: R

on App.startCLI(args: list of string) {
    r.c.send("x")
}

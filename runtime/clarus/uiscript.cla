// uiscript.cla (native-5e Task 7 Step 5, ported directly by the
// controlling session -- see task-7-report.md's Step 2 dispatch-log
// entry): trace helpers (rt_ui.c:373-673) + the scripted-event
// interpreter + snap (rt_ui.c:4043-4464). Task 10 (slice D) completes the
// dialog answer-queue's own path/str payload (rtUiAnswerStrs/
// rtUiAnswerPushPath) and the invalid/askOpen/askSave trace helpers,
// consumed by uidialogs.cla.
//
// Trace vocabulary is byte-exact golden vocabulary (rt_ui.c:373-382's
// own comment, quoted in this task's brief) -- every verb string below is
// transcribed character-for-character from the C reference; do not
// reword.
//
// UiStrAddr (below) is this file's own small, load-bearing addition: the
// ONLY way to get a `ptr` from a Clarus STRING LITERAL (needed for every
// fixed trace-vocabulary fragment -- "T ", "OPEN", "FIRE", ".", " ", ...)
// is to round-trip it through an `external func` parameter typed
// `string` -- extern `string`/`str` params auto-marshal the address of
// the caller's value (Task 7 report log entry #6's own finding,
// confirmed again here: `docs/clarus-language-reference.md`'s "a str
// parameter is marshalled as the address of the caller's Str255" applies
// to ANY string-typed caller expression, including a literal, not just a
// blob-computed one) -- an ordinary (non-extern) Clarus function has no
// such marshaling, so `rtTextAppendStr`'s own `s: ptr` parameter
// (text.cla) could never accept a literal directly. `UiStrAddr` is a
// trivial C-level identity function (`rt_ext_UiStrAddr`, rt_ext_mac.inc)
// that just returns the address the marshaling already produced.
external func UiStrAddr(s: string): ptr

// UiTestEmit (plan's own reverse-waist glue-extern table): capture-line
// hook. Declared `ptr` -- every trace line this file builds is a fresh
// `rt_text*` (text.cla's own `ptr`-typed box handle), and every call
// site here already treats it as `ptr` throughout (rtTextNew/
// rtTextAppendStr/etc. are all `ptr`-typed), so a plain `ptr` param is
// the natural match -- no Str255/`string` round-trip needed. cprint shim
// -> rt_ext_UiTestEmit (rt_ext_mac.inc): no-ops unless RT_MAC_TEST
// (mirrors rt_mac.c's own pattern -- this task's own brief).
external func UiTestEmit(s: ptr)

// UiCurrentA5 (plan's own reverse-waist glue-extern table): the A5 world
// base, needed by rtUiTestSnap (below) to walk qd.screenBits without a
// hand-derived offset. cprint shim -> `(void *)SetCurrentA5()`-equivalent
// (Task 7's own brief: "UiCurrentA5 (cprint shim only this task)"). Task
// 12 (native-5e) gives it its own `= inline a5` clause: cg68k.cla's
// cgCallExtA5 emits the one-instruction `MOVE.L A5,D0` directly, no trap
// or nat_ fallback needed -- A5 is this backend's own fixed world-pointer
// register for the whole program's run. cprint ignores the clause
// entirely (irExternConv is a native-only concern -- fpCallExt always
// resolves to rt_ext_UiCurrentA5 regardless), so this is a no-op change on
// that lane.
external func UiCurrentA5(): ptr = inline a5

// ================================================================
// Scripted-mode flags (rt_ui.c:569-584).
// ================================================================
var rtUiScripted: bool = false
var rtUiScriptDbl: bool = false

// ================================================================
// Scripted dialog/popup answer queue (rt_ui.c:586-658). askOpen/askSave/
// askSaveChanges (uidialogs.cla, Task 10) consume this queue instead of a
// real Standard File dialog or Alert(130). Task 9 wired the POPUP kind
// only (`answer-popup`, consumed by uitable.cla's rtUiPopupClick, gated on
// rtUiScripted rather than unconditionally -- a popup click is a real
// widget interaction, not a modal dialog). Fixed 8-slot ring buffer (7
// usable -- the full/empty ambiguity of a head==tail ring is broken by
// never letting tail catch up to head, the usual one-slot-sacrificed
// idiom): no script ever queues more than a couple of dialogs ahead of
// where it consumes them, and a script that DOES overflow this gets a
// loud rtPanic rather than silently clobbering an unconsumed entry.
//
// Each slot is (kind, val, str) -- `str` (Task 10) is a 256-byte Str255
// slot, the answer-open/answer-save path payload (rt_ui_answer_push_path's
// own addition, rt_ui.c:627-640); only OPEN/SAVE-kind entries ever
// populate it, and only askOpen/askSave ever read it (uidialogs.cla).
const rtUiAnsOpen: int = 0
const rtUiAnsSave: int = 1
const rtUiAnsChanges: int = 2
const rtUiAnsCancel: int = 3
const rtUiAnsPopup: int = 4

var rtUiAnswerKinds: ptr = ptr(0)
var rtUiAnswerVals: ptr = ptr(0)
var rtUiAnswerStrs: ptr = ptr(0)
var rtUiAnswerHead: int = 0
var rtUiAnswerTail: int = 0

func rtUiAnswerInit() {
    if rtUiAnswerKinds == ptr(0) {
        rtUiAnswerKinds = UiNewPtr(32) // 8 slots * 4 bytes
        rtUiAnswerVals = UiNewPtr(32)
        rtUiAnswerStrs = UiNewPtr(2048) // 8 slots * 256-byte Str255
    }
}

func rtUiAnswerCheckRoom() {
    rtUiAnswerInit()
    if (rtUiAnswerTail + 1) mod 8 == rtUiAnswerHead {
        rtPanic("scripted dialog answer queue overflow")
    }
}

// rtUiAnswerPushVal (rt_ui_answer_push_val, rt_ui.c:642-648).
func rtUiAnswerPushVal(kind: int, val: int) {
    rtUiAnswerCheckRoom()
    pokel(rtUiAnswerKinds + rtUiAnswerTail * 4, kind)
    pokel(rtUiAnswerVals + rtUiAnswerTail * 4, val)
    rtUiAnswerTail = (rtUiAnswerTail + 1) mod 8
}

// rtUiAnswerPushPath (rt_ui_answer_push_path, rt_ui.c:627-640, Task 10):
// `srcC` is a NUL-terminated C-string-shaped buffer (a scripted verb's own
// rest-of-line argument, rtUiScriptRestOfLine below) -- copied into the
// ring's own Str255 slot, capped at 255 bytes (Str255's own structural
// limit), same silent clamp every other Pascal-string fill in this port
// applies.
func rtUiAnswerPushPath(kind: int, srcC: ptr) {
    var n: int
    var dst: ptr
    var i: int

    rtUiAnswerCheckRoom()
    n = 0
    while peekb(srcC + n) != 0 {
        n = n + 1
    }
    if n > 255 {
        n = 255
    }
    pokel(rtUiAnswerKinds + rtUiAnswerTail * 4, kind)
    dst = rtUiAnswerStrs + rtUiAnswerTail * 256
    pokeb(dst, n)
    i = 0
    while i < n {
        pokeb(dst + 1 + i, peekb(srcC + i))
        i = i + 1
    }
    rtUiAnswerTail = (rtUiAnswerTail + 1) mod 8
}

// rtUiAnswerPopIdx (rt_ui_answer_pop, rt_ui.c:650-658): validates an
// answer is actually queued (panics otherwise, same "no queued answer"
// contract), advances the ring, and returns the JUST-CONSUMED slot's own
// index -- the shared primitive rtUiAnswerPop (below, kind+val only, used
// by uitable.cla's popup click) and uidialogs.cla's own askOpen/askSave/
// askSaveChanges (which also need the str slot, and must NOT touch it at
// all on a CANCEL-kind entry -- rt_ui_ask_open/save never read path255 on
// their own cancel path either) both build on.
func rtUiAnswerPopIdx(): int {
    var idx: int

    rtUiAnswerInit()
    if rtUiAnswerHead == rtUiAnswerTail {
        rtPanic("scripted dialog with no queued answer")
    }
    idx = rtUiAnswerHead
    rtUiAnswerHead = (rtUiAnswerHead + 1) mod 8
    return idx
}

// rtUiAnswerPop: out-param shape (outKind/outVal, both already-allocated
// 4-byte scratch) since Clarus functions can't return a small record the
// way rt_ui_answer_pop returns `const rt_ui_answer *` -- every call site
// here already owns scratch slots it can pass in (same convention as
// rtUiCanvasHit's own outIdx).
func rtUiAnswerPop(outKind: ptr, outVal: ptr) {
    var idx: int

    idx = rtUiAnswerPopIdx()
    pokel(outKind, peekl(rtUiAnswerKinds + idx * 4))
    pokel(outVal, peekl(rtUiAnswerVals + idx * 4))
}

// ================================================================
// Small text-building helpers.
// ================================================================

// rtUiTextAppendStrSafe: text.cla's rtTextAppendStr assumes a non-null
// Str255 source; several blob-sourced fields here (App section strings)
// are legitimately `ptr(0)` (absent) via uidesc.cla's own `-1 -> ptr(0)`
// convention -- treat that as "append nothing", matching the C
// reference's own `fields[f] ? fields[f][0] : 0` null-safety
// (rt_ui_trace_about, rt_ui.c:455-464).
func rtUiTextAppendStrSafe(t: ptr, s: ptr) {
    if s != ptr(0) {
        rtTextAppendStr(t, s)
    }
}

// rtUiIntToText: no numeric-formatting builtin exists for ordinary
// Clarus programs (`numToStr` is clarusc's OWN compiler-internal helper,
// confirmed unavailable to a plain program by direct test: `undefined:
// numToStr` from the Go reference's own checker) -- standard
// divide-by-10 decimal conversion, building digits into a scratch
// buffer in reverse then appending them back-to-front. Returns a fresh
// owned Text (caller's job to rtTextAppendText + rtTextRelease it, or
// just rtTextRelease it directly if it's the whole result).
func rtUiIntToText(v: int): ptr {
    var t: ptr
    var n: int
    var neg: bool
    var digits: ptr
    var i: int
    var d: int

    t = rtTextNew()
    n = v
    neg = n < 0
    if neg {
        n = -n
    }
    digits = UiNewPtr(16)
    i = 0
    if n == 0 {
        pokeb(digits, int('0'))
        i = 1
    } else {
        while n > 0 {
            d = n mod 10
            pokeb(digits + i, int('0') + d)
            n = n / 10
            i = i + 1
        }
    }
    if neg {
        rtTextAppendChar(t, int('-'))
    }
    while i > 0 {
        i = i - 1
        rtTextAppendChar(t, peekb(digits + i))
    }
    UiDisposePtr(digits)
    return t
}

// rtUiTextAppendInt: convenience -- append v's decimal text directly
// into t (the common case; avoids every call site repeating the
// build-then-append-then-release dance rtUiIntToText alone would need).
func rtUiTextAppendInt(t: ptr, v: int) {
    var nt: ptr

    nt = rtUiIntToText(v)
    rtTextAppendText(t, nt)
    rtTextRelease(nt)
}

// rtUiTraceSuppressed (clir-load-perf trace-noise phase): every "T ..."
// trace helper in this file funnels through rtUiEmitLine, so gating here
// is the one choke point that covers all of them. Default false (normal
// tracing, unchanged for every existing caller); a --testapi program may
// name this var directly (whole-program visibility, main.cla's early
// splice) to bracket a call it wants painted but NOT captured -- e.g.
// ClarusC.APPL's own Status-bar spinner/bar-growth repaints
// (clarusc/macgui.cla's feProgressTick), which repeat the SAME stage's
// widget-set path (rtUiWidgetSetStr, unconditionally traced) many times a
// second and would otherwise flood the trace with near-identical lines.
// Still releases `t` when suppressed -- only the emit call is skipped, so
// nothing leaks.
//
// WARNING for the next person adding a runtime-module global: this file
// (and every runtime/clarus/*.cla module) is always spliced BEFORE user
// code in the whole program's declaration order, so ANY new top-level
// `var` here shifts the declaration-order index of every global declared
// after it -- including every user program's own globals. clarusc/
// uiblob.cla's uibGlobalIndex bakes exactly that index into a `table`
// widget's Table.rowsIdx blob field, so a new runtime global here
// silently renumbers Table.rowsIdx for EVERY UI program with a table
// bound to a global (proven when this var was added: it shifted
// testdata/emitui/uiblob_probe.blob.golden by one byte at offset 959,
// 43->44, and renumbered ~250 `cv_rowsIdx == N` dispatch arms in
// clarusc/clarusc.c's own self-hosted snapshot -- see
// .superpowers/sdd/2026-08-15-clir-load-perf/trace-noise-report.md's
// "Where it breaks" section for the full bisect). The renumbering itself
// is harmless (encode and decode both walk the same irGlobals order, so
// the shifted index still resolves to the right global) but it DOES
// churn any golden that pins raw blob/emitted-C bytes -- rebless
// deliberately, don't be surprised by it.
var rtUiTraceSuppressed: bool = false

func rtUiEmitLine(t: ptr) {
    if not rtUiTraceSuppressed {
        UiTestEmit(t)
    }
    rtTextRelease(t)
}

// ================================================================
// Trace helpers (rt_ui.c:373-673). Each mirrors its own C function 1:1;
// the per-WinType instance counter (rt_ui_trace_next_id's own linear
// scan, rt_ui.c:526-536) collapses to a direct `winIdx`-indexed array
// read (Task 7 report log entry #5's own redesign already makes this
// possible -- no descriptor-pointer scan needed).
// ================================================================

var rtUiTraceWinCounts: ptr = ptr(0)
var rtUiTraceLastFront: ptr = ptr(0)
var rtUiDimPrevArr: ptr = ptr(0)
var rtUiDimFirst: bool = true
var rtUiStdEditDimPrev: bool = false

// rtUiTraceInit: rt_ui_startup's own trace-bookkeeping setup
// (rt_ui.c:3742-3748), ported here (uiscript.cla owns every trace-only
// global) rather than inline in ui.cla's rtUiStartup.
func rtUiTraceInit() {
    var nWins: int
    var nMh: int

    nWins = uidNWins()
    if nWins > 0 {
        rtUiTraceWinCounts = UiNewPtrClear(nWins * 4)
    } else {
        rtUiTraceWinCounts = ptr(0)
    }
    nMh = uidNMenuHandlers()
    if nMh > 0 {
        rtUiDimPrevArr = UiNewPtrClear(nMh)
    } else {
        rtUiDimPrevArr = ptr(0)
    }
    rtUiDimFirst = true
    rtUiStdEditDimPrev = false
    rtUiTraceLastFront = ptr(0)
}

// rtUiTraceNextId (rt_ui.c:526-536): 1-based per-WinType instance
// counter for T OPEN/CLOSE/FRONT ids.
func rtUiTraceNextId(winIdx: int): int {
    var v: int

    if rtUiTraceWinCounts == ptr(0) {
        return 0
    }
    v = peekl(rtUiTraceWinCounts + winIdx * 4) + 1
    pokel(rtUiTraceWinCounts + winIdx * 4, v)
    return v
}

// rtUiTraceOpen/rtUiTraceClose: `T OPEN <name> <id>` / `T CLOSE <name>
// <id>` (rt_ui_trace_id, rt_ui.c:384-389) -- id is computed here
// (rtUiTraceNextId) and stashed nowhere else the C reference's own
// `inst->traceId` field would have cached it; RtUiWinst.traceId (kept
// for struct-layout parity, uidesc.cla's own header comment) is written
// here too so a later read (none exists this slice) would still see it.
func rtUiTraceOpen(winIdx: int, inst: ptr) {
    var id: int
    var t: ptr
    var w: RtUiWinst

    id = rtUiTraceNextId(winIdx)
    w = RtUiWinst(inst)
    w.traceId = id
    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T OPEN "))
    rtUiTextAppendStrSafe(t, uidWinName(winIdx))
    rtTextAppendStr(t, UiStrAddr(" "))
    rtUiTextAppendInt(t, id)
    rtUiEmitLine(t)
}

func rtUiTraceClose(winIdx: int, inst: ptr) {
    var t: ptr

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T CLOSE "))
    rtUiTextAppendStrSafe(t, uidWinName(winIdx))
    rtTextAppendStr(t, UiStrAddr(" "))
    rtUiTextAppendInt(t, RtUiWinst(inst).traceId)
    rtUiEmitLine(t)
}

// rtUiTraceFire1/rtUiTraceFire2 (rt_ui.c:391-403): `T FIRE <name>.<event>`
// / `T FIRE <name>.<wname>.<event>`.
func rtUiTraceFire1(namePtr: ptr, event: string) {
    var t: ptr

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T FIRE "))
    rtUiTextAppendStrSafe(t, namePtr)
    rtTextAppendStr(t, UiStrAddr("."))
    rtTextAppendStr(t, UiStrAddr(event))

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T FIRE "))
    rtUiTextAppendStrSafe(t, namePtr)
    rtTextAppendStr(t, UiStrAddr("."))
    rtUiTextAppendStrSafe(t, wnamePtr)
    rtTextAppendStr(t, UiStrAddr("."))
    rtTextAppendStr(t, UiStrAddr(event))
    rtUiEmitLine(t)
}

// rtUiTraceMenuSelectFor (rt_ui.c:419-424): `T FIRE <menu>.<item>.select`
// -- looks the names up itself (menu/item name blob offsets, via k) so
// ui.cla's own rtUiMenuDispatch doesn't need to.
func rtUiTraceMenuSelectFor(k: int) {
    var t: ptr

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T FIRE "))
    rtUiTextAppendStrSafe(t, uidMenuHandlerMenuName(k))
    rtTextAppendStr(t, UiStrAddr("."))
    rtUiTextAppendStrSafe(t, uidMenuHandlerItemName(k))
    rtTextAppendStr(t, UiStrAddr(".select"))
    rtUiEmitLine(t)
}

// rtUiTraceEveryFire (rt_ui.c:426-431): `T FIRE every.<n>`.
func rtUiTraceEveryFire(n: int) {
    var t: ptr

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T FIRE every."))
    rtUiTextAppendInt(t, n)
    rtUiEmitLine(t)
}

// rtUiTraceDimCheck/rtUiTraceStdEditDim/rtUiTraceDimFirstDone (rt_ui.c:
// 433-448, 556-567): `T DIM <menu>.<item> <0/1>` -- only on a CHANGE from
// the last computed state, and never on rt_ui_startup's own first
// (pre-any-window) computation (rtUiDimFirst).
func rtUiTraceDimCheck(k: int, enable: bool) {
    var prev: int
    var enableInt: int
    var t: ptr

    if enable {
        enableInt = 1
    } else {
        enableInt = 0
    }
    if rtUiDimPrevArr == ptr(0) {
        return
    }
    prev = peekb(rtUiDimPrevArr + k)
    if not rtUiDimFirst and prev != enableInt {
        t = rtTextNew()
        rtTextAppendStr(t, UiStrAddr("T DIM "))
        rtUiTextAppendStrSafe(t, uidMenuHandlerMenuName(k))
        rtTextAppendStr(t, UiStrAddr("."))
        rtUiTextAppendStrSafe(t, uidMenuHandlerItemName(k))
        rtTextAppendStr(t, UiStrAddr(" "))
        rtUiTextAppendInt(t, enableInt)
        rtUiEmitLine(t)
    }
    pokeb(rtUiDimPrevArr + k, enableInt)
}

// rtUiTraceStdEditDim: same change-detection contract as
// rtUiTraceDimCheck, but for the 4 fixed Cut/Copy/Paste/Clear items
// (rt_ui.c:2513-2518) -- traced as a group of 4 T DIM lines.
func rtUiTraceStdEditDim(enable: bool) {
    var enableInt: int
    var t: ptr

    if enable {
        enableInt = 1
    } else {
        enableInt = 0
    }
    if rtUiDimFirst or rtUiStdEditDimPrev == enable {
        rtUiStdEditDimPrev = enable
        return
    }
    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T DIM "))
    rtUiTextAppendStrSafe(t, uidMenuTitle(rtUiStdEditMenuIdx))
    rtTextAppendStr(t, UiStrAddr(".Cut "))
    rtUiTextAppendInt(t, enableInt)
    rtUiEmitLine(t)
    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T DIM "))
    rtUiTextAppendStrSafe(t, uidMenuTitle(rtUiStdEditMenuIdx))
    rtTextAppendStr(t, UiStrAddr(".Copy "))
    rtUiTextAppendInt(t, enableInt)
    rtUiEmitLine(t)
    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T DIM "))
    rtUiTextAppendStrSafe(t, uidMenuTitle(rtUiStdEditMenuIdx))
    rtTextAppendStr(t, UiStrAddr(".Paste "))
    rtUiTextAppendInt(t, enableInt)
    rtUiEmitLine(t)
    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T DIM "))
    rtUiTextAppendStrSafe(t, uidMenuTitle(rtUiStdEditMenuIdx))
    rtTextAppendStr(t, UiStrAddr(".Clear "))
    rtUiTextAppendInt(t, enableInt)
    rtUiEmitLine(t)
    rtUiStdEditDimPrev = enable
}

func rtUiTraceDimFirstDone() {
    rtUiDimFirst = false
}

// rtUiTraceFrontCheck (rt_ui.c:544-554): `T FRONT <name> <id>`, only
// when the frontmost-of-ours WINDOW actually changed.
func rtUiTraceFrontCheck() {
    var wp: ptr
    var cur: ptr
    var t: ptr

    wp = UiFrontWindow()
    if rtUiIsOurs(wp) {
        cur = ptr(UiGetWRefCon(wp))
    } else {
        cur = ptr(0)
    }
    if cur == rtUiTraceLastFront {
        return
    }
    rtUiTraceLastFront = cur
    if cur != ptr(0) {
        t = rtTextNew()
        rtTextAppendStr(t, UiStrAddr("T FRONT "))
        rtUiTextAppendStrSafe(t, uidWinName(RtUiWinst(cur).winIdx))
        rtTextAppendStr(t, UiStrAddr(" "))
        rtUiTextAppendInt(t, RtUiWinst(cur).traceId)
        rtUiEmitLine(t)
    }
}

// rtUiTraceAbout (rt_ui.c:449-467): `T ABOUT <name>|<version>|<author>|
// <about>`.
func rtUiTraceAbout() {
    var t: ptr

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T ABOUT "))
    rtUiTextAppendStrSafe(t, uidAppName())
    rtTextAppendStr(t, UiStrAddr("|"))
    rtUiTextAppendStrSafe(t, uidAppVersion())
    rtTextAppendStr(t, UiStrAddr("|"))
    rtUiTextAppendStrSafe(t, uidAppAuthor())
    rtTextAppendStr(t, UiStrAddr("|"))
    rtUiTextAppendStrSafe(t, uidAppAbout())
    rtUiEmitLine(t)
}

// rtUiPropName (rt_ui.c:469-485): Ch8's own runtime-property names.
func rtUiPropNamePtr(prop: int): ptr {
    if prop == rtUiPropCaption {
        return UiStrAddr("caption")
    }
    if prop == rtUiPropText {
        return UiStrAddr("text")
    }
    if prop == rtUiPropEnabled {
        return UiStrAddr("enabled")
    }
    if prop == rtUiPropChecked {
        return UiStrAddr("checked")
    }
    if prop == rtUiPropSelected {
        return UiStrAddr("selected")
    }
    if prop == rtUiPropWidth {
        return UiStrAddr("width")
    }
    if prop == rtUiPropHeight {
        return UiStrAddr("height")
    }
    return UiStrAddr("?")
}

// rtUiTraceSetStr/SetBool/SetInt (rt_ui.c:487-517): `T SET
// <name>.<wname>.<prop> <value>`.
func rtUiTraceSetStr(namePtr: ptr, wnamePtr: ptr, prop: int, s: ptr) {
    var t: ptr

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T SET "))
    rtUiTextAppendStrSafe(t, namePtr)
    rtTextAppendStr(t, UiStrAddr("."))
    rtUiTextAppendStrSafe(t, wnamePtr)
    rtTextAppendStr(t, UiStrAddr("."))
    rtTextAppendStr(t, rtUiPropNamePtr(prop))
    rtTextAppendStr(t, UiStrAddr(" "))
    rtUiTextAppendStrSafe(t, s)
    rtUiEmitLine(t)
}

func rtUiTraceSetBool(namePtr: ptr, wnamePtr: ptr, prop: int, v: bool) {
    var t: ptr
    var vi: int

    if v {
        vi = 1
    } else {
        vi = 0
    }
    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T SET "))
    rtUiTextAppendStrSafe(t, namePtr)
    rtTextAppendStr(t, UiStrAddr("."))
    rtUiTextAppendStrSafe(t, wnamePtr)
    rtTextAppendStr(t, UiStrAddr("."))
    rtTextAppendStr(t, rtUiPropNamePtr(prop))
    rtTextAppendStr(t, UiStrAddr(" "))
    rtUiTextAppendInt(t, vi)
    rtUiEmitLine(t)
}

func rtUiTraceSetInt(namePtr: ptr, wnamePtr: ptr, prop: int, v: int) {
    var t: ptr

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T SET "))
    rtUiTextAppendStrSafe(t, namePtr)
    rtTextAppendStr(t, UiStrAddr("."))
    rtUiTextAppendStrSafe(t, wnamePtr)
    rtTextAppendStr(t, UiStrAddr("."))
    rtTextAppendStr(t, rtUiPropNamePtr(prop))
    rtTextAppendStr(t, UiStrAddr(" "))
    rtUiTextAppendInt(t, v)
    rtUiEmitLine(t)
}

// rtUiTraceInvalid (rt_ui.c:405-417, Task 10): `T FIRE <name>.invalid.
// <wname>` -- deliberately NOT rtUiTraceFire2's usual <name>.<wname>.
// <event> order (rt_field_desc carries no field name of its own, only the
// BOUND WIDGET's, which is what's passed here as `wnamePtr`).
func rtUiTraceInvalid(namePtr: ptr, wnamePtr: ptr) {
    var t: ptr

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T FIRE "))
    rtUiTextAppendStrSafe(t, namePtr)
    rtTextAppendStr(t, UiStrAddr(".invalid."))
    rtUiTextAppendStrSafe(t, wnamePtr)
    rtUiEmitLine(t)
}

// rtUiTraceAskPath (rt_ui.c:663-673, Task 10): `T ASKOPEN <path>` / `T
// ASKSAVE <path>` -- pathPStr is a Pascal string (the queued answer,
// already copied out of the ring by the caller).
func rtUiTraceAskPath(verb: string, pathPStr: ptr) {
    var t: ptr

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T "))
    rtTextAppendStr(t, UiStrAddr(verb))
    rtTextAppendStr(t, UiStrAddr(" "))
    rtUiTextAppendStrSafe(t, pathPStr)
    rtUiEmitLine(t)
}

// rtUiTraceOpenDoc (rt_ui.c:3956-3958's own inline `T OPENDOC %s`):
// pathPtr/pathLen name a RAW byte range (NOT Str255 -- rtUiLaunch's own
// script-scan already has the path as [ptr, len) straight out of the
// script text, no Pascal length byte).
func rtUiTraceOpenDoc(pathPtr: ptr, pathLen: int) {
    var t: ptr
    var pathText: ptr

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr("T OPENDOC "))
    pathText = rtTextNew()
    rtTextFromBytes(pathText, pathPtr, pathLen, pathLen)
    rtTextAppendText(t, pathText)
    rtTextRelease(pathText)
    rtUiEmitLine(t)
}

// ================================================================
// UiScreenBits: a pragmatic, deliberately narrower alternative to
// hand-deriving qd's A5-relative offset in Clarus for rtUiTestSnap's own
// data needs (screenBits.baseAddr/rowBytes/bounds) -- `UiCurrentA5` is
// still declared+implemented above per this task's own required
// contract (a later task's native-lane qd-globals access will need it
// for real), but getting screen-framebuffer bytes wrong here would
// silently corrupt every scenario's own snap/PBM comparison, the
// highest-stakes byte-exact surface this whole port has -- a thin,
// unambiguous C-side accessor removes all A5-arithmetic risk from the
// one call site that matters most. ponytail: narrower than the plan's
// own "UiCurrentA5 for qd-globals access" phrasing suggests, but correct
// and safe; revisit if a later task's native-lane snap path needs
// rtUiTestSnap itself to go through `UiCurrentA5` specifically.
// ================================================================
external func UiScreenBits(baseAddrOut: ptr, rowBytesOut: ptr, boundsOut: ptr)

// nat_UiScreenBits's own nat_ fallback body lives in native.cla (Task 12,
// native-5e review fix), same cross-lane-global-leak reason as
// nat_UiMacInitToolbox/nat_UiScreenBounds (ui.cla).

// ================================================================
// Small string/number utilities the scripted interpreter needs (no
// libc-style helpers exist for ordinary Clarus programs -- str/int
// parsing and comparison are hand-rolled here, same spirit as
// rtUiIntToText above).
// ================================================================

// rtUiStrEq: compares `a`, a NUL-terminated C-string-shaped scratch buffer
// (every scripted-verb token this file builds via rtUiScriptTokenize
// below), against `b`, a Str255/Pascal buffer -- EVERY call site passes
// `UiStrAddr(<literal>)` for `b`, and `string` literals/params are always
// Str255-shaped in this codebase (`UiStrAddr`'s own header comment;
// rtTextAppendStr's identical `peekb(s)`-as-length-then-`s+1`-as-data
// convention, text.cla), NOT NUL-terminated at byte 0. Task 7 Step 7
// review fix: the original version compared both sides as NUL-terminated
// C strings, so `peekb(b+0)` read `b`'s Pascal LENGTH byte (e.g. 5 for
// "click") instead of its first character -- every verb comparison failed
// on the very first byte, always falling through to the fail-closed
// unknown-verb arm.
func rtUiStrEq(a: ptr, b: ptr): bool {
    var i: int
    var n: int

    n = peekb(b)
    i = 0
    while i < n {
        if peekb(a + i) != peekb(b + 1 + i) {
            return false
        }
        i = i + 1
    }
    return peekb(a + i) == 0
}

// rtUiAtoi: decimal (optionally negative) parse of a NUL-terminated
// buffer, stopping at the first non-digit -- same tolerant behavior C's
// own `atoi` has (rt_ui_script_click/_menu/_resize/_tick all use atoi on
// unvalidated script args).
func rtUiAtoi(s: ptr): int {
    var i: int
    var neg: bool
    var v: int
    var c: int

    i = 0
    neg = false
    if peekb(s) == int('-') {
        neg = true
        i = 1
    }
    v = 0
    while true {
        c = peekb(s + i)
        if c < int('0') or c > int('9') {
            break
        }
        v = v * 10 + (c - int('0'))
        i = i + 1
    }
    if neg {
        v = -v
    }
    return v
}

// rtUiScriptKeyArg (rt_ui.c:4201-4213): an all-digit arg1 is a decimal
// byte CODE (`key 13` sends Return); otherwise the literal first
// character (`key x` sends 'x').
func rtUiScriptKeyArg(s: ptr): int {
    var i: int
    var allDigits: bool
    var c: int

    if peekb(s) == 0 {
        return 0
    }
    allDigits = true
    i = 0
    while peekb(s + i) != 0 {
        c = peekb(s + i)
        if c < int('0') or c > int('9') {
            allDigits = false
        }
        i = i + 1
    }
    if allDigits {
        return rtUiAtoi(s)
    }
    return peekb(s)
}

// rtUiTextAppendCStr: append a NUL-terminated (not Str255) buffer's
// bytes -- used for scripted-verb args (rtUiScriptTokenize's own output
// buffers), which carry no Pascal length prefix.
func rtUiTextAppendCStr(t: ptr, s: ptr) {
    var n: int
    var scratch: ptr

    n = 0
    while peekb(s + n) != 0 {
        n = n + 1
    }
    scratch = rtTextNew()
    rtTextFromBytes(scratch, s, n, n)
    rtTextAppendText(t, scratch)
    rtTextRelease(scratch)
}

// ================================================================
// Script line reading + tokenizing (rt_ui_script_next_line, rt_ui.c:
// 4053-4068; the verb/arg1/arg2 sscanf split, rt_ui_run_scripted's own
// `sscanf(line, "%31s %63s %63s", ...)`, rt_ui.c:4380).
// ================================================================

var rtUiScriptCursor: ptr = ptr(0)
var rtUiScriptCursorInit: bool = false
var rtUiScriptLineBuf: ptr = ptr(0)
var rtUiScriptLineLen: int = 0
var rtUiVerbBuf: ptr = ptr(0)
var rtUiArg1Buf: ptr = ptr(0)
var rtUiArg2Buf: ptr = ptr(0)
var rtUiVirtualTicks: int = 0

func rtUiScriptNextLine(): bool {
    var n: int

    if not rtUiScriptCursorInit {
        rtUiScriptCursor = UiTestScript()
        rtUiScriptCursorInit = true
    }
    if rtUiScriptLineBuf == ptr(0) {
        rtUiScriptLineBuf = UiNewPtr(256)
    }
    while true {
        if peekb(rtUiScriptCursor) == 0 {
            return false
        }
        n = 0
        while peekb(rtUiScriptCursor) != 0 and peekb(rtUiScriptCursor) != 10 {
            if n < 255 {
                pokeb(rtUiScriptLineBuf + n, peekb(rtUiScriptCursor))
                n = n + 1
            }
            rtUiScriptCursor = rtUiScriptCursor + 1
        }
        if peekb(rtUiScriptCursor) == 10 {
            rtUiScriptCursor = rtUiScriptCursor + 1
        }
        pokeb(rtUiScriptLineBuf + n, 0)
        rtUiScriptLineLen = n
        if n > 0 {
            return true
        }
    }
    return false
}

// rtUiScriptSetLine (ui-scenario-retirement Task 2): injects a line
// straight into the script line buffer, bypassing rtUiScriptNextLine's own
// script-cursor read -- uitest.cla's UiTestVerb uses this to feed a
// runtime-built verb line through the same tokenize/dispatch path a
// compiled-in `.events` script line takes. Lazily allocates
// rtUiScriptLineBuf the same way rtUiScriptNextLine does (a caller may
// inject a line before ever calling rtUiScriptNextLine), clamped to the
// same 255-byte buffer capacity. rtUiScriptTokenize and
// rtUiScriptRestOfLine both read rtUiScriptLineBuf/rtUiScriptLineLen only,
// so they work unmodified on an injected line.
func rtUiScriptSetLine(line: string) {
    var n: int
    var i: int

    if rtUiScriptLineBuf == ptr(0) {
        rtUiScriptLineBuf = UiNewPtr(256)
    }
    n = line.length
    if n > 255 {
        n = 255
    }
    i = 0
    while i < n {
        pokeb(rtUiScriptLineBuf + i, int(line[i]))
        i = i + 1
    }
    pokeb(rtUiScriptLineBuf + n, 0)
    rtUiScriptLineLen = n
}

func rtUiSkipSpaces(p: int): int {
    var q: int

    q = p
    while q < rtUiScriptLineLen and peekb(rtUiScriptLineBuf + q) == int(' ') {
        q = q + 1
    }
    return q
}

func rtUiCopyToken(p: int, dst: ptr, maxLen: int): int {
    var q: int
    var n: int

    q = p
    n = 0
    while q < rtUiScriptLineLen and peekb(rtUiScriptLineBuf + q) != int(' ') {
        if n < maxLen {
            pokeb(dst + n, peekb(rtUiScriptLineBuf + q))
            n = n + 1
        }
        q = q + 1
    }
    pokeb(dst + n, 0)
    return q
}

func rtUiScriptTokenize() {
    var p: int

    if rtUiVerbBuf == ptr(0) {
        rtUiVerbBuf = UiNewPtr(64)
        rtUiArg1Buf = UiNewPtr(64)
        rtUiArg2Buf = UiNewPtr(64)
    }
    p = rtUiSkipSpaces(0)
    p = rtUiCopyToken(p, rtUiVerbBuf, 63)
    p = rtUiSkipSpaces(p)
    p = rtUiCopyToken(p, rtUiArg1Buf, 63)
    p = rtUiSkipSpaces(p)
    p = rtUiCopyToken(p, rtUiArg2Buf, 63)
}

// ================================================================
// Scripted verb actions (rt_ui.c:4092-4365). Each fires through the
// EXACT SAME dispatch a real event would (rtUiHandleMouseDown/
// rtUiHandleKey/rtUiMenuDispatch/rtUiApplyResize/rtUiApplyZoom/
// rtUiClose, all ui.cla), same as the C reference's own design intent
// (its own comments on each function, quoted per-function below only
// where the port diverges).
// ================================================================

func rtUiScriptClick(x: int, y: int, dbl: bool) {
    var ev: ptr

    ev = UiNewPtr(16)
    pokew(ev + 0, 1) // mouseDown
    pokel(ev + 2, 0)
    pokel(ev + 6, 0)
    pokew(ev + 10, y) // where.v
    pokew(ev + 12, x) // where.h
    pokew(ev + 14, 0)
    rtUiScriptDbl = dbl
    rtUiHandleMouseDown(ev)
    rtUiScriptDbl = false
    UiDisposePtr(ev)
}

// rtUiScriptDrag (rt_ui.c:4144-4167). Task 8 adds the TE-hit/focused-
// field-extend branch (rt_ui.c:4164-4166, previously omitted as dead --
// no field/textview could exist before this task): a scripted `drag`
// extends the CURRENTLY-focused TE's selection to (x,y), via TEClick's own
// `extend` flag (the exact mechanism a real click already uses for
// shift-extend -- TE's own selection math only depends on the anchor and
// the final point, never the path between them, so this reproduces the
// identical final selection a real click-hold-drag-release would).
// Deliberately does NOT start a new TE's focus on a drag (only extends
// the already-focused one, gated on tIdx == inst->focusIdx) -- "drag" is
// a continuation of a prior click, not an independent click of its own.
func rtUiScriptDrag(x: int, y: int) {
    var wherePt: int
    var wpSlot: ptr
    var part: int
    var wp: ptr
    var inst: ptr
    var localPt: int
    var cIdxSlot: ptr
    var cIdx: int
    var tIdxSlot: ptr
    var tIdx: int

    wherePt = (y << 16) | (x & 0xFFFF)
    wpSlot = UiNewPtr(4)
    part = UiFindWindow(wherePt, wpSlot)
    wp = ptr(peekl(wpSlot))
    UiDisposePtr(wpSlot)
    if part != 3 or wp != UiFrontWindow() {
        return
    }
    inst = rtUiWinstOf(wp)
    if inst == ptr(0) {
        return
    }
    UiSetPort(wp)
    localPt = rtUiGlobalToLocalPt(wherePt)
    cIdxSlot = UiNewPtr(4)
    if rtUiCanvasHit(inst, localPt, cIdxSlot) {
        cIdx = peekl(cIdxSlot)
        UiDisposePtr(cIdxSlot)
        rtUiFireCanvasXY(inst, cIdx, rtUiWevDrag, localPt)
        return
    }
    UiDisposePtr(cIdxSlot)

    tIdxSlot = UiNewPtr(4)
    if rtUiTeHit(inst, localPt, tIdxSlot) {
        tIdx = peekl(tIdxSlot)
        UiDisposePtr(tIdxSlot)
        if tIdx == RtUiWinst(inst).focusIdx and rtUiTeAt(RtUiWinst(inst), tIdx) != ptr(0) {
            UiTEClick(localPt, true, rtUiTeAt(RtUiWinst(inst), tIdx))
        }
        return
    }
    UiDisposePtr(tIdxSlot)
}

func rtUiScriptKey(ch: int) {
    var ev: ptr

    ev = UiNewPtr(16)
    pokew(ev + 0, 3) // keyDown
    pokel(ev + 2, ch)
    pokel(ev + 6, 0)
    pokel(ev + 10, 0)
    pokew(ev + 14, 0)
    rtUiHandleKey(ev)
    UiDisposePtr(ev)
}

// rtUiScriptType (rt_ui.c:4390-4403): the rest-of-line after "type "
// (can contain spaces, so it bypasses rtUiScriptTokenize's own
// space-delimited args entirely, reading straight off
// rtUiScriptLineBuf).
func rtUiScriptType() {
    var p: int

    p = 4 // strlen("type")
    if peekb(rtUiScriptLineBuf + p) == int(' ') {
        p = p + 1
    }
    while p < rtUiScriptLineLen {
        rtUiScriptKey(peekb(rtUiScriptLineBuf + p))
        p = p + 1
    }
}

// rtUiScriptRestOfLine (rt_ui.c:4427-4428/4431-4432's own `line + 11; if
// (*p == ' ') p++;`, Task 10): returns a pointer PAST `verbLen` bytes and
// one separating space (if present) into rtUiScriptLineBuf -- same
// rest-of-line convention rtUiScriptType uses for `type`'s own C-string,
// but returning the pointer (into the shared line buffer, valid only
// until the next rtUiScriptNextLine) instead of walking it directly:
// answer-open/answer-save's path argument, unlike `type`'s keystrokes,
// is handed straight to rtUiAnswerPushPath, which copies it out
// immediately.
func rtUiScriptRestOfLine(verbLen: int): ptr {
    var p: int

    p = verbLen
    if peekb(rtUiScriptLineBuf + p) == int(' ') {
        p = p + 1
    }
    return rtUiScriptLineBuf + p
}

// rtUiScriptAnswerChanges (rt_ui.c:4434-4440, Task 10): `answer-changes
// <save|discard|cancel>` -- queues the 0/1/2 saveChoice askSaveChanges
// returns next.
func rtUiScriptAnswerChanges() {
    var v: int

    if rtUiStrEq(rtUiArg1Buf, UiStrAddr("save")) {
        v = 0
    } else if rtUiStrEq(rtUiArg1Buf, UiStrAddr("discard")) {
        v = 1
    } else if rtUiStrEq(rtUiArg1Buf, UiStrAddr("cancel")) {
        v = 2
    } else {
        rtPanic("answer-changes: bad argument (want save|discard|cancel)")
        v = 0
    }
    rtUiAnswerPushVal(rtUiAnsChanges, v)
}

func rtUiScriptClose() {
    var wp: ptr
    var inst: ptr

    wp = UiFrontWindow()
    if wp == ptr(0) {
        return
    }
    inst = rtUiWinstOf(wp)
    if inst != ptr(0) {
        rtUiClose(inst)
    }
}

func rtUiScriptResize(w: int, h: int) {
    var wp: ptr
    var inst: ptr

    wp = UiFrontWindow()
    if wp == ptr(0) {
        return
    }
    inst = rtUiWinstOf(wp)
    if inst != ptr(0) and uidWinResizable(RtUiWinst(inst).winIdx) {
        rtUiApplyResize(wp, inst, w, h)
    }
}

// rtUiScriptZoom (rt_ui.c:4255-4274): direction chosen by comparing the
// window's CURRENT content bounds against the standard zoom rect.
func rtUiScriptZoom() {
    var wp: ptr
    var inst: ptr
    var screenBoundsSlot: ptr
    var screenW: int
    var screenH: int
    var std: ptr
    var contRgnH: ptr
    var contRgnMp: ptr
    var content: ptr
    var part: int
    var eq: bool

    wp = UiFrontWindow()
    if wp == ptr(0) {
        return
    }
    inst = rtUiWinstOf(wp)
    if inst == ptr(0) or not uidWinResizable(RtUiWinst(inst).winIdx) {
        return
    }
    screenBoundsSlot = UiNewPtr(rtUiRectSize)
    UiScreenBounds(screenBoundsSlot)
    screenW = peekw(screenBoundsSlot + 6) - peekw(screenBoundsSlot + 2)
    screenH = peekw(screenBoundsSlot + 4) - peekw(screenBoundsSlot + 0)
    UiDisposePtr(screenBoundsSlot)
    std = UiNewPtr(rtUiRectSize)
    UiSetRect(std, 4, rtUiMenubarH + rtUiTitlebarH, screenW - rtUiScreenMargin, screenH - rtUiScreenMargin)

    contRgnH = ptr(peekl(wp + 118))
    contRgnMp = ptr(peekl(contRgnH))
    content = UiNewPtr(rtUiRectSize)
    UiBlockMoveData(contRgnMp + 2, content, rtUiRectSize)

    eq = UiEqualRect(content, std)
    UiDisposePtr(content)
    UiDisposePtr(std)
    if eq {
        part = 7 // inZoomIn
    } else {
        part = 8 // inZoomOut
    }
    rtUiApplyZoom(wp, inst, part)
}

// rtUiScriptEveryPump/rtUiScriptTick (rt_ui.c:4283-4301): `tick N`
// advances a VIRTUAL tick counter (real TickCount is never consulted in
// scripted mode) -- same reschedule-from-now policy as rtUiEveryPump
// (ui.cla), just against rtUiVirtualTicks. rtUiTeIdleFront (rt_ui.c:4299,
// uitext.cla) blinks the frontmost window's focused TE caret, same as a
// real event-loop iteration (Task 8: live as of this task).
func rtUiScriptEveryPump() {
    var i: int
    var due: int

    if rtUiEveryDueArr == ptr(0) {
        return
    }
    i = 0
    while i < rtUiNEveryVal {
        due = peekl(rtUiEveryDueArr + i * 4)
        if rtUiVirtualTicks - due >= 0 {
            pokel(rtUiEveryDueArr + i * 4, rtUiVirtualTicks + uidEveryTicks(i))
            rtUiTraceEveryFire(i)
            UiFireEvery(i)
        }
        i = i + 1
    }
}

func rtUiScriptTick(n: int) {
    rtUiVirtualTicks = rtUiVirtualTicks + n
    rtUiScriptEveryPump()
    rtUiTeIdleFront()
    rtUiFlushAllBuffered()
}

// rtUiScriptMenu (rt_ui.c:4346-4365): bar position M / 1-based item I ->
// native (menuID, itemNum) is the IDENTITY mapping (see the C reference's
// own extensive comment on why) -- `menu 2 1` is the first declared
// menu's first item.
func rtUiScriptMenu(m: int, itemNum: int) {
    rtUiMenuDispatch((m << 16) | (itemNum & 0xFFFF))
}

// ================================================================
// rtUiPumpPassive (rt_ui.c:4077-4090): drains queued update/activate
// events after every scripted action, so InvalRect'd content actually
// reaches the screen bits before the next action or a `snap` -- same as
// what a real WaitNextEvent-driven loop would have processed by now.
// rtUiTablesSync (uitable.cla) now runs FIRST (Task 9, rt_ui.c:4080-4085):
// a row-count change LAddRow/LDelRow just InvalRect'd needs to already be
// queued as an updateEvt by the time the loop below drains it, matching
// what a real WaitNextEvent-driven pass would have processed by now.
// ================================================================

func rtUiPumpPassive() {
    var ev: ptr
    var what: int
    var gotEvent: bool

    rtUiTablesSync()
    ev = UiNewPtr(16)
    gotEvent = UiGetNextEvent(0x0140, ev) // updateMask|activMask
    while gotEvent {
        what = peekw(ev + 0)
        if what == 6 {
            rtUiHandleUpdate(ptr(peekl(ev + 2)))
        } else if what == 8 {
            rtUiHandleActivate(ptr(peekl(ev + 2)), (peekw(ev + 14) & 0x1) != 0)
        }
        gotEvent = UiGetNextEvent(0x0140, ev)
    }
    UiDisposePtr(ev)
}

// ================================================================
// Snap (rt_ui.c:4303-4344): hex-dumps the FULL screen framebuffer
// between `##CLARUS-SNAP## <name>`/`##CLARUS-SNAP-END##` sentinels, 128
// uppercase hex chars (64 source bytes) per line. rowBytes is asserted
// (not just assumed) to be 64, matching the C reference's own contract.
// ================================================================

func rtUiHexDigit(d: int): int {
    if d < 10 {
        return int('0') + d
    }
    return int('A') + (d - 10)
}

func rtUiHexLineText(src: ptr): ptr {
    var t: ptr
    var i: int
    var b: int

    t = rtTextNew()
    i = 0
    while i < 64 {
        b = peekb(src + i)
        rtTextAppendChar(t, rtUiHexDigit((b >> 4) & 0xF))
        rtTextAppendChar(t, rtUiHexDigit(b & 0xF))
        i = i + 1
    }
    return t
}

func rtUiTestSnap(namePtr: ptr) {
    var baseAddrSlot: ptr
    var rowBytesSlot: ptr
    var boundsSlot: ptr
    var baseAddr: ptr
    var rowBytes: int
    var rows: int
    var total: int
    var off: int
    var hdr: ptr

    baseAddrSlot = UiNewPtr(4)
    rowBytesSlot = UiNewPtr(4)
    boundsSlot = UiNewPtr(rtUiRectSize)
    UiScreenBits(baseAddrSlot, rowBytesSlot, boundsSlot)
    baseAddr = ptr(peekl(baseAddrSlot))
    rowBytes = peekl(rowBytesSlot)
    if rowBytes != 64 {
        rtPanic("snap: screenBits.rowBytes is not 64")
    }
    rows = peekw(boundsSlot + 4) - peekw(boundsSlot + 0)
    UiDisposePtr(baseAddrSlot)
    UiDisposePtr(rowBytesSlot)
    UiDisposePtr(boundsSlot)

    total = rows * rowBytes

    hdr = rtTextNew()
    rtTextAppendStr(hdr, UiStrAddr("##CLARUS-SNAP## "))
    rtUiTextAppendCStr(hdr, namePtr)
    rtUiEmitLine(hdr)

    off = 0
    while off < total {
        rtUiEmitLine(rtUiHexLineText(baseAddr + off))
        off = off + 64
    }

    rtUiEmitLine(rtUiLitLine("##CLARUS-SNAP-END##"))
}

// rtUiLitLine: build a fresh Text from a single string literal --
// convenience for a "whole line is one fixed literal" emit (used above;
// every OTHER trace helper interleaves literals with blob/computed data
// so builds its own Text piecemeal instead).
func rtUiLitLine(s: string): ptr {
    var t: ptr

    t = rtTextNew()
    rtTextAppendStr(t, UiStrAddr(s))
    return t
}

// ================================================================
// rtUiRunScripted (rt_ui.c:4367-4464): the main scripted-event loop.
// `answer-popup` (Task 9, rt_ui.c:4447-4454) pushes onto the answer queue
// above -- consumed by uitable.cla's rtUiPopupClick. `answer-open`/
// `answer-save`/`answer-changes`/`answer-cancel` (the dialog side of the
// SAME queue, rt_ui.c:4421-4446, Task 10) are consumed by uidialogs.cla's
// rtUiAskOpen/rtUiAskSave/rtUiAskSaveChanges. `launchdoc` is a real,
// explicit no-op (already consumed once by rtUiLaunch's own pre-scan,
// rt_ui.c:4455-4461's own comment) -- NOT fail-closed.
// ================================================================

func rtUiRunScripted() {
    rtUiScripted = true
    UiHideCursor()
    while true {
        if not rtUiScriptNextLine() {
            rtUiQuit()
            return
        }
        rtUiScriptTokenize()
        if not rtUiScriptDispatchLine() {
            log("uiport: unknown or unsupported scripted verb")
            quit 1
        }
        rtUiPumpPassive()
        UiConnPump()
    }
}

// rtUiScriptDispatchLine dispatches the already-tokenized verb buffers
// (rtUiVerbBuf/rtUiArg1Buf/rtUiArg2Buf, plus rest-of-line reads for
// path-bearing verbs) for one scripted-event line. Returns false for an
// unknown verb; true otherwise (including blank lines and the launchdoc
// no-op). Does no line-reading, no pumping, and no quit-on-unknown --
// those stay with the caller.
func rtUiScriptDispatchLine(): bool {
    if rtUiStrEq(rtUiVerbBuf, UiStrAddr("click")) {
        rtUiScriptClick(rtUiAtoi(rtUiArg1Buf), rtUiAtoi(rtUiArg2Buf), false)
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("dblclick")) {
        rtUiScriptClick(rtUiAtoi(rtUiArg1Buf), rtUiAtoi(rtUiArg2Buf), true)
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("drag")) {
        rtUiScriptDrag(rtUiAtoi(rtUiArg1Buf), rtUiAtoi(rtUiArg2Buf))
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("key")) {
        rtUiScriptKey(rtUiScriptKeyArg(rtUiArg1Buf))
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("type")) {
        rtUiScriptType()
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("menu")) {
        rtUiScriptMenu(rtUiAtoi(rtUiArg1Buf), rtUiAtoi(rtUiArg2Buf))
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("close")) {
        rtUiScriptClose()
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("resize")) {
        rtUiScriptResize(rtUiAtoi(rtUiArg1Buf), rtUiAtoi(rtUiArg2Buf))
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("zoom")) {
        rtUiScriptZoom()
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("tick")) {
        rtUiScriptTick(rtUiAtoi(rtUiArg1Buf))
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("snap")) {
        rtUiTestSnap(rtUiArg1Buf)
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("quit")) {
        rtUiQuit()
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("launchdoc")) {
        // no-op: consumed once, up front, by rtUiLaunch's own
        // pre-scan -- must not fire a second time here.
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("answer-popup")) {
        // `answer-popup N` (rt_ui.c:4447-4454): queues the 0-based item
        // index a scripted popup click picks next -- arg1 is already a
        // plain numeric token (no embedded spaces, unlike `type`/
        // `answer-open`'s rest-of-line parsing), so rtUiScriptTokenize's
        // own whitespace split already isolated it.
        rtUiAnswerPushVal(rtUiAnsPopup, rtUiAtoi(rtUiArg1Buf))
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("answer-open")) {
        // `answer-open <rest-of-line path>` (Task 10, rt_ui.c:4421-4429):
        // a path can contain spaces, so it's read past the verb and one
        // separating space, not via rtUiArg1Buf's own whitespace-split
        // token. strlen("answer-open") == 11.
        rtUiAnswerPushPath(rtUiAnsOpen, rtUiScriptRestOfLine(11))
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("answer-save")) {
        // strlen("answer-save") == 11.
        rtUiAnswerPushPath(rtUiAnsSave, rtUiScriptRestOfLine(11))
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("answer-changes")) {
        rtUiScriptAnswerChanges()
    } else if rtUiStrEq(rtUiVerbBuf, UiStrAddr("answer-cancel")) {
        // Queues a cancel for whichever of askOpen/askSave consumes it
        // next -- rtUiAskOpen/rtUiAskSave both recognize
        // rtUiAnsCancel; rtUiAskSaveChanges does not (its own
        // three-way cancel is `answer-changes cancel` instead).
        rtUiAnswerPushVal(rtUiAnsCancel, 0)
    } else if peekb(rtUiVerbBuf) == 0 {
        // blank/whitespace-only line (sscanf found no tokens in the
        // C reference): nothing to dispatch.
    } else {
        return false
    }
    return true
}

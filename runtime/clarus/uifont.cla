// uifont.cla: per-widget fonts (ui-widgets spec 3.2), label drawing (spec
// 3.3) and canvas text measurement (spec 3.8).
//
// Storage: RtUiWinst.fonts holds one 4-byte slot per widget -- the font
// number + 1 (word @0; 0 = none set), size (byte @2; 0 = none set) and
// face (byte @3, the rtUiFace* bits). It is allocated at window open only
// when some widget declares `font:` or `style:`, or later by the first
// setFont/setStyle; while it is nil, and for whatever a slot leaves unset,
// a widget draws in its port's defaults (a window port starts in the
// application font, a canvas buffer in the system font).
//
// Every non-TE draw site (label, field label lane, table header and LDEF
// rows, canvas text and metrics) brackets its drawing with rtUiFontApply,
// which saves the port's font first, and rtUiFontRestore, which puts it
// back. A canvas measures and draws in its own port (its buffer when
// buffered), the others in their window's.
// TE widgets keep their font in the TERec instead: TENew picks it up from
// the port at creation, setFont pokes it afterwards.
//
// A canvas reads its font from the same slot at every text op, so a
// buffered canvas keeps its font across rtUiCanvasMake (OpenPort resets a
// port's font) without a copy in its RtUiCanvasBuf.
//
// Most of this file is reached only through synthesized dispatchers
// (UiFontsInit, UiDrawLabel, UiLabelSetText, UiCanvasMetric, declared in
// uiwidgets.cla) or by name from setFont/setStyle/textWidth lowering, and
// is shaken out of a program that does not use it; rtUiFontApply/Restore
// and the scratch are called directly by ui.cla/uitable.cla/uitext.cla's
// draw sites. The module is spliced unconditionally (whole-program
// visibility makes its place after uitable.cla irrelevant).

// rtUiFontInfo: GetFontInfo in widget wIdx's font, measured in its
// window's port, into the scratch FontInfo (returned).
func rtUiFontInfo(instV: ptr, wIdx: int): ptr {
    var savedPort: ptr
    var fi: ptr

    fi = rtUiFontScratchGet()
    savedPort = rtUiGetPortSaved()
    UiSetPort(RtUiWinst(instV).wp)
    rtUiFontApply(instV, wIdx)
    UiGetFontInfo(fi)
    rtUiFontRestore()
    UiSetPort(savedPort)
    return fi
}

// rtUiWidgetSetFont: `w.X.setFont(name, size)`, name a Str255.
func rtUiWidgetSetFont(instV: ptr, wIdx: int, name: ptr, size: int) {
    var p: ptr
    var num: int
    var sz: int

    num = rtUiFontNum(name)
    p = rtUiFontSlot(instV, wIdx)
    pokew(p, num + 1)
    // The declared range, 1..127 (the slot holds one byte).
    sz = size
    if sz < 1 {
        sz = 1
    } else if sz > 127 {
        sz = 127
    }
    pokeb(p + 2, sz)
    rtUiFontChanged(instV, wIdx)
}

// rtUiWidgetSetStyle: `w.X.setStyle(...)`, face the folded rtUiFace* bits.
func rtUiWidgetSetStyle(instV: ptr, wIdx: int, face: int) {
    pokeb(rtUiFontSlot(instV, wIdx) + 3, face)
    rtUiFontChanged(instV, wIdx)
}

// rtUiFontSlot: widget wIdx's font slot, allocating the window's table
// first when no widget declared a font.
func rtUiFontSlot(instV: ptr, wIdx: int): ptr {
    var w: RtUiWinst

    w = RtUiWinst(instV)
    if w.fonts == ptr(0) {
        rtUiFontsInit(instV, true)
    }
    return w.fonts + wIdx * 4
}

// rtUiFontChanged redraws widget wIdx in its new font: a logpanel through
// its own SetFont op; a field/textview through its TERec (font, line
// height and ascent, then TECalText); a table gets the new row height
// (and, in rtUiTableRelayout, header height); every kind is invalidated.
func rtUiFontChanged(instV: ptr, wIdx: int) {
    var w: RtUiWinst
    var savedPort: ptr
    var p: ptr
    var fi: ptr
    var te: ptr
    var teMp: ptr
    var lh: ptr
    var f: int

    w = RtUiWinst(instV)
    p = w.fonts + wIdx * 4
    if uidWidgetKind(w.winIdx, wIdx) == rtUiKindLogpanel {
        // No font set (a setStyle alone): the panel's own default, 0/0.
        f = peekw(p) - 1
        if f < 0 {
            f = 0
        }
        UiLogOp(rtUiLogOpSetFont, instV, wIdx, f, (peekb(p + 2) << 8) | peekb(p + 3))
        return
    }
    fi = rtUiFontInfo(instV, wIdx)
    savedPort = rtUiGetPortSaved()
    UiSetPort(w.wp)
    te = rtUiTeAt(w, wIdx)
    lh = rtUiListAt(w, wIdx)
    if te != ptr(0) {
        // Font and size only when set: otherwise the TERec keeps the
        // window's, which TENew gave it (and which fi was measured in).
        teMp = UiHandleDeref(te)
        if peekw(p) != 0 {
            pokew(teMp + 74, peekw(p) - 1) // txFont
        }
        if peekb(p + 2) != 0 {
            pokew(teMp + 80, peekb(p + 2)) // txSize
        }
        pokeb(teMp + 76, peekb(p + 3))     // txFace
        pokew(teMp + rtUiTeLineHeight, rtUiFontLineH(fi))
        pokew(teMp + 26, peekw(fi + 0))   // fontAscent
        UiTECalText(te)
        rtUiTeScrollSync(instV, wIdx)
    } else if lh != ptr(0) {
        UiLCellSize((rtUiFontLineH(fi) << 16) | peekw(UiHandleDeref(lh) + rtUiListCellSizeH), lh)
        rtUiTableRelayout(instV, wIdx)
    }
    UiInvalRect(rtUiRectAt(w, wIdx))
    UiSetPort(savedPort)
}

// rtUiCanvasTextWidth: `c.textWidth(s)` in the canvas's font, s a Str255.
// Measured in the port the canvas draws on (its buffer when buffered).
func rtUiCanvasTextWidth(instV: ptr, wIdx: int, s: ptr): int {
    var t: RtUiCanvasTarget
    var tw: int

    t = rtUiCanvasBegin(instV, wIdx)
    rtUiFontApply(instV, wIdx)
    tw = UiTextWidth(s + 1, 0, peekb(s))
    rtUiFontRestore()
    rtUiCanvasEnd(t)
    return tw
}

// ================================================================
// Fonts and labels (ui-widgets Task 10, spec 3.2/3.3): the slot table
// fill, apply/save/restore, label drawing and canvas metrics.
// ================================================================

external func UiGetFNum(name: ptr, familyID: ptr) = trap 0xA900
external func UiGetFontName(familyID: int16, name: ptr) = trap 0xA8FF

// rtUiFontScratch: 24 bytes, allocated once -- a FontInfo (ascent @0,
// descent @2, widMax @4, leading @6); @8 the RgnHandle rtUiDrawLabel saves
// the clip in; @12 a GetPort slot; @16/@18/@20 the txFont/txFace/txSize
// rtUiFontSave took from the port, which rtUiFontRestore puts back.
// ponytail: one save slot, so apply/restore pairs must not nest; a
// formatted table column whose function draws text inside the LDEF's pair
// would leave the table's font in the port. A save stack if that bites.
var rtUiFontScratch: ptr = ptr(0)

func rtUiFontScratchGet(): ptr {
    var rgn: ptr

    if rtUiFontScratch == ptr(0) {
        rgn = UiNewRgn()
        rtUiFontScratch = UiNewPtr(24)
        pokel(rtUiFontScratch + 8, int(rgn))
    }
    return rtUiFontScratch
}

// rtUiFontSave records the current port's font, face and size (GrafPort
// txFont @68, txFace @70, txSize @74) for rtUiFontRestore. A window port
// starts in the application font (NewWindow sets it), an OpenPort'd
// canvas buffer in the system font, so "the default" is whatever the
// port has.
func rtUiFontSave() {
    var sc: ptr
    var port: ptr

    sc = rtUiFontScratchGet()
    UiGetPort(sc + 12)
    port = ptr(peekl(sc + 12))
    pokew(sc + 16, peekw(port + 68))
    pokew(sc + 18, peekb(port + 70))
    pokew(sc + 20, peekw(port + 74))
}

func rtUiPstrEq(a: ptr, b: ptr): bool {
    var k: int

    k = 0
    while k <= peekb(a) {
        if peekb(a + k) != peekb(b + k) {
            return false
        }
        k = k + 1
    }
    return true
}

// rtUiFontNum: GetFNum, falling back to applFont (1) when the name is
// unknown (GetFNum's 0, unless the name really is the system font's).
func rtUiFontNum(name: ptr): int {
    var slot: ptr
    var num: int
    var nm: ptr

    slot = UiNewPtr(2)
    pokew(slot, 0)
    UiGetFNum(name, slot)
    num = peekw(slot)
    UiDisposePtr(slot)
    if num == 0 {
        nm = UiNewPtr(256)
        UiGetFontName(0, nm)
        if not rtUiPstrEq(nm, name) {
            num = 1
        }
        UiDisposePtr(nm)
    }
    return num
}

// rtUiFontsInit fills w.fonts from the blob, declared fonts resolved with
// rtUiFontNum and stored + 1 (0 = no font set: keep the port's). It
// allocates the table at the first widget that declares a font or a style
// (a widget that declares neither keeps its zeroed slot, the port's
// defaults), or at once when `force`.
func rtUiFontsInit(inst: ptr, force: bool) {
    var w: RtUiWinst
    var n: int
    var i: int
    var flags: int
    var face: int
    var p: ptr

    w = RtUiWinst(inst)
    n = uidWinNWidgets(w.winIdx)
    if force {
        w.fontsH = rtUiAllocLocked(n * 4)
        w.fonts = UiHandleDeref(w.fontsH)
    }
    i = 0
    while i < n {
        flags = uidWidgetFlags(w.winIdx, i) & rtUiFlagFontSet
        face = uidWidgetFace(w.winIdx, i)
        if flags != 0 or face != 0 {
            if w.fonts == ptr(0) {
                w.fontsH = rtUiAllocLocked(n * 4)
                w.fonts = UiHandleDeref(w.fontsH)
            }
            p = w.fonts + i * 4
            if flags != 0 {
                pokew(p, rtUiFontNum(uidWidgetFontName(w.winIdx, i)) + 1)
                pokeb(p + 2, uidWidgetFontSize(w.winIdx, i))
            }
            pokeb(p + 3, face)
        }
        i = i + 1
    }
}

// rtUiFontApply saves the current port's font, then sets widget wIdx's:
// its font and size when set, and its face (nothing when the window has
// no font table).
func rtUiFontApply(instV: ptr, wIdx: int) {
    var w: RtUiWinst
    var p: ptr

    rtUiFontSave()
    w = RtUiWinst(instV)
    if w.fonts == ptr(0) {
        return
    }
    p = w.fonts + wIdx * 4
    if peekw(p) != 0 {
        UiTextFont(peekw(p) - 1)
    }
    if peekb(p + 2) != 0 {
        UiTextSize(peekb(p + 2))
    }
    UiTextFace(peekb(p + 3))
}

func rtUiFontRestore() {
    var sc: ptr

    sc = rtUiFontScratch
    UiTextFont(peekw(sc + 16))
    UiTextFace(peekw(sc + 18))
    UiTextSize(peekw(sc + 20))
}

// rtUiFontLineH: ascent + descent + leading, at least 1.
func rtUiFontLineH(fi: ptr): int {
    var h: int

    h = peekw(fi + 0) + peekw(fi + 2) + peekw(fi + 6)
    if h < 1 {
        return 1
    }
    return h
}

// rtUiDrawLabel draws label i in the current port (its window's): erase
// the rect, then one DrawText line clipped to it, aligned per the blob,
// with its baseline at top + ascent -- centered when the rect is taller
// than one line.
func rtUiDrawLabel(instV: ptr, i: int) {
    var w: RtUiWinst
    var r: ptr
    var s: ptr
    var fi: ptr
    var clip: ptr
    var lh: int
    var x: int
    var y: int
    var hh: int
    var dx: int
    var align: int

    w = RtUiWinst(instV)
    fi = rtUiFontScratchGet()
    r = rtUiRectAt(w, i)
    s = rtUiLabelAt(w, i)
    rtUiFontApply(instV, i)
    UiGetFontInfo(fi)
    lh = rtUiFontLineH(fi)
    y = peekw(r + 0) + peekw(fi + 0)
    hh = peekw(r + 4) - peekw(r + 0)
    if hh > lh {
        y = y + (hh - lh) / 2
    }
    x = peekw(r + 2)
    align = uidWidgetAlign(w.winIdx, i)
    if align != rtUiAlignLeft {
        dx = peekw(r + 6) - x - UiTextWidth(s + 1, 0, peekb(s))
        if align == rtUiAlignCenter {
            dx = dx / 2
        }
        x = x + dx
    }
    UiEraseRect(r)
    clip = ptr(peekl(fi + 8))
    UiGetClip(clip)
    UiClipRect(r)
    UiMoveTo(x, y)
    UiDrawText(s + 1, 0, peekb(s))
    UiSetClip(clip)
    rtUiFontRestore()
}

// rtUiLabelSetText: `w.L.text = s` (port = the label's window). The text
// it already shows is a no-op -- no trace, no erase, no draw (spec 3.3).
// New text is traced, stored and painted at once (live-log phase: drawn
// mid-handler the way the update path draws it -- ClarusC.APPL's status
// line and the toolbox LivePaint case need it before any update event),
// with no InvalRect (the paint is done) and no ValidRect (that would
// cancel other pending updates under the label).
func rtUiLabelSetText(instV: ptr, wIdx: int, s: ptr) {
    var w: RtUiWinst

    w = RtUiWinst(instV)
    if rtUiPstrEq(rtUiLabelAt(w, wIdx), s) {
        return
    }
    rtUiTraceSetStr(uidWinName(w.winIdx), uidWidgetName(w.winIdx, wIdx), rtUiPropText, s)
    rtUiPstrcpy(rtUiLabelAt(w, wIdx), s)
    if not rtUiRectIsEmpty(rtUiRectAt(w, wIdx)) {
        rtUiDrawLabel(instV, wIdx)
    }
}

// rtUiCanvasMetric: a canvas's lineHeight (ascent + descent + leading) or
// ascent, measured in the port it draws on (a buffered canvas's own
// buffer, in the system font unless it has one) in its font.
func rtUiCanvasMetric(instV: ptr, wIdx: int, prop: int): int {
    var t: RtUiCanvasTarget
    var fi: ptr

    fi = rtUiFontScratchGet()
    t = rtUiCanvasBegin(instV, wIdx)
    rtUiFontApply(instV, wIdx)
    UiGetFontInfo(fi)
    rtUiFontRestore()
    rtUiCanvasEnd(t)
    if prop == rtUiPropAscent {
        return peekw(fi + 0)
    }
    return rtUiFontLineH(fi)
}

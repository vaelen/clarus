// UiTestTick: see this file's own header comment for the scripted-vs-real
// split's full rationale.
func UiTestTick(n: int): bool {
    var verbLine: string
    var i: int
    var start: int
    var cur: int

    if rtUiScripted {
        verbLine = "tick "
        verbLine = verbLine + rtUiTestIntToStr(n)
        return UiTestVerb(verbLine)
    }
    i = 0
    while i < n {
        start = UiTickCount()
        cur = start
        while cur == start {
            cur = UiTickCount()
        }
        rtUiEveryPump()
        UiConnPump()
        rtUiTeIdleFront()
        rtUiFlushAllBuffered()
        rtUiTablesSync()
        i = i + 1
    }
    return true
}

// UiTestChecksum: see this file's own header comment for the
// alignment/size contract. Generalizes testsuite/toolbox/cases_draw.cla's
// own CanvasChecksum (a hard-coded region) to an arbitrary caller-supplied
// rectangle.
func UiTestChecksum(x: int, y: int, w: int, h: int): int {
    var base: ptr
    var sum: int
    var row: int
    var col: int
    var rowAddr: ptr
    var xByte: int
    var wByte: int

    if x mod 8 != 0 or w mod 8 != 0 {
        return -1
    }
    xByte = x / 8
    wByte = w / 8
    // ScrnBase ($824, a fixed low-memory global) is the current screen
    // buffer's base address -- read directly via peekl, same as
    // cases_draw.cla's own caseCanvasChecksum. rowBytes is hard-coded to
    // 64 (512/8), same fixed-target reasoning as tbRowBytes there.
    base = ptr(peekl(ptr(0x824)))
    sum = 0
    row = 0
    while row < h {
        rowAddr = base + (y + row) * 64 + xByte
        col = 0
        while col < wByte {
            sum = sum + peekb(rowAddr + col)
            col = col + 1
        }
        row = row + 1
    }
    return sum
}

// UiTestPopupBoxLeft/UiTestPopupBoxRight (correctness-cleanup Task 2):
// expose rtUiPopupBoxInto's (uitable.cla) label-lane-narrowed popup box,
// in the FRONT window's own local coords, for widget index i -- Ch8's
// popup only has a `selected` runtime property
// (docs/clarus-language-reference.md:1055), no rect accessor at the
// user-facing level, so a geometry regression test (NarrowPopup,
// testsuite/toolbox/cases_narrowpopup.cla) needs this internal-only
// bridge. rtUiWinstOf(UiFrontWindow()) (ui.cla) is the same
// WindowPtr->instance lookup rtUiEveryPump's own front-window idle work
// already uses, not new plumbing. Two int-returning calls rather than
// one struct-returning call: there is no user-facing Rect type to
// marshal a ptr out-param through from a --testapi-spliced function.
func UiTestPopupBoxLeft(i: int): int {
    var out: ptr
    var v: int

    out = UiNewPtr(rtUiRectSize)
    rtUiPopupBoxInto(rtUiWinstOf(UiFrontWindow()), i, out)
    v = peekw(out + 2)
    UiDisposePtr(out)
    return v
}

func UiTestPopupBoxRight(i: int): int {
    var out: ptr
    var v: int

    out = UiNewPtr(rtUiRectSize)
    rtUiPopupBoxInto(rtUiWinstOf(UiFrontWindow()), i, out)
    v = peekw(out + 6)
    UiDisposePtr(out)
    return v
}

// fileh_c.cla: the C-lane rtFhDev* waist (2026-08-22 binary-files spec,
// Task 5). Nine thin wrappers over the FhH*-prefixed externs (the
// family-prefix convention ser.cla's own header comment explains -- see
// conn_c.cla's identical rationale for its own ConnH* family) rendering
// as rt_ext_FhH* in runtime/host/rt_fileh.inc: plain pread/pwrite over an
// fd, handle = fd + 1. fileh_68k.cla (Task 6) is this file's native twin,
// same nine function names, real File Manager calls instead.
//
// Never spliced onto the native lane (drive.cla adds this module only for
// non-68k builds), so it can freely assume a host fd-backed handle.
//
// rtFhDevReadAt owns the ONE piece of `text` awareness this lane needs:
// growing `out`'s storage (a raw box `ptr`, see fileh.cla's own header
// comment for why) to `count` bytes and setting its length to the actual
// byte count read, via rtTextGrow/TextHandleDeref/the RtText overlay --
// text.cla's own established idiom (rtTextTextAt is the template; text.cla
// is always spliced, so calling straight into its already-declared
// functions here needs no re-declaration, the same "plain intra-Clarus
// call to another module's already-spliced" move conn.cla's own header
// comment documents for SerNewPtr). FhHReadAt itself stays dumb -- a raw
// pread into the already-grown buffer, no rt_text struct awareness in C
// at all, matching FhHWriteAt's own raw-buffer shape.
//
// Every rtFhDev* body just narrows/renames onto its FhH* extern; rtFhDevCreate
// drops ftype/fcreator (host filesystem has no type/creator concept, same
// as file.writeText's own C-lane behavior).

external func FhHOpen(path: string): int
external func FhHCreate(path: string): int
external func FhHReadAt(h: int, pos: int, p: ptr, n: int): int
external func FhHWriteAt(h: int, pos: int, p: ptr, n: int): int
external func FhHSize(h: int): int
external func FhHSetSize(h: int, n: int): int
external func FhHFlush(h: int): int
external func FhHClose(h: int)
external func FhHErrno(): int

// FhHStat/FhHStatField (filesystem-api Task 3): FhHStat does one stat(2)
// call and caches the result; FhHStatField reads one field back out of
// that cached result (0 size, 1 rsrcSize -- unused on the host, always 0
// via rtFhDevStatRsrcSize below -- 2 created, 3 modified, 4 isDir), so a
// single rtFhDevStat call backs all seven rtFhDevStat* getters below
// without re-statting.
external func FhHStat(path: string): int
external func FhHStatField(which: int): int

func rtFhDevOpen(path: string): int {
    return FhHOpen(path)
}

func rtFhDevCreate(path: string, ftype: string, fcreator: string): int {
    return FhHCreate(path)
}

// rtFhDevReadAt: grows `out` to `count` bytes (rtTextGrow can relocate its
// Handle, so the master pointer is re-derived AFTER growing, THEN passed
// to FhHReadAt -- on the host a text's storage does not move during a
// plain C call, so no second re-derive is needed after that call
// returns). A negative FhHReadAt result is an I/O error; on success `len`
// is set to however many bytes actually came back, which may be less than
// `count` (a short read at EOF, not an error -- rtFhReadAt's own caller
// treats any got >= 0 as success).
func rtFhDevReadAt(h: int, pos: int, out: ptr, count: int): int {
    var rt: RtText
    var mp: ptr
    var got: int

    rtTextGrow(out, count)
    rt = RtText(out)
    mp = TextHandleDeref(rt.h)
    got = FhHReadAt(h, pos, mp, count)
    if got < 0 {
        rt.len = 0
        return -1
    }
    rt.len = got
    return got
}

func rtFhDevWriteAt(h: int, pos: int, p: ptr, n: int): int {
    return FhHWriteAt(h, pos, p, n)
}

func rtFhDevSize(h: int): int {
    return FhHSize(h)
}

func rtFhDevSetSize(h: int, n: int): int {
    return FhHSetSize(h, n)
}

func rtFhDevFlush(h: int): int {
    return FhHFlush(h)
}

func rtFhDevClose(h: int) {
    FhHClose(h)
}

func rtFhDevLastOSErr(): int {
    return FhHErrno()
}

// rtFhDevStat/rtFhDevStat*: the host lane's own contract for the seven
// FileInfo scalars (spec %3, "Host behaviour") -- rsrcSize/type/creator
// have no host filesystem concept, so they're the documented zero/empty
// defaults; size/created/modified/isDir come straight from FhHStatField.
func rtFhDevStat(path: string): bool {
    return FhHStat(path) == 0
}

func rtFhDevStatSize(): int {
    return FhHStatField(0)
}

func rtFhDevStatRsrcSize(): int {
    return 0
}

func rtFhDevStatType(): string {
    return ""
}

func rtFhDevStatCreator(): string {
    return ""
}

func rtFhDevStatCreated(): int {
    return FhHStatField(2)
}

func rtFhDevStatModified(): int {
    return FhHStatField(3)
}

func rtFhDevStatIsDir(): bool {
    return FhHStatField(4) != 0
}

// rtFhListBuf: the file.list(path, names) cursor's scratch buffer -- one
// SerNewPtr(256) allocated in rtFhDevListBegin, read by rtFhDevListNext,
// freed by rtFhDevListEnd. Host lane only (this module is never spliced
// onto the native lane -- see the header comment above), so a
// module-level var here never touches a native golden.
var rtFhListBuf: ptr = ptr(0)

// FhHMakeDir/Delete/ListBegin/ListNext/ListEnd/SetTimes/Rename/Move
// (filesystem-api Task 4): the directory/catalog surface's host lane,
// runtime/host/rt_fileh.inc's own rt_ext_FhH* bodies. FhHListNext writes
// a Pascal-string name into a caller-supplied 256-byte buffer (0 = got
// one, 1 = done, -1 = error); rtFhDevListNext below reads it back into a
// `string` byte by byte via peekb, the same Pascal-buffer-to-string idiom
// rtFh68kName (fileh_68k.cla) uses in reverse.
external func FhHMakeDir(path: string): int
external func FhHDelete(path: string): int
external func FhHListBegin(path: string): int
external func FhHListNext(buf: ptr): int
external func FhHListEnd()
external func FhHSetTimes(path: string, created: int, modified: int): int
external func FhHRename(path: string, newName: string): int
external func FhHMove(path: string, dirPath: string): int

func rtFhDevMakeDir(path: string): int {
    return FhHMakeDir(path)
}

func rtFhDevDelete(path: string): int {
    return FhHDelete(path)
}

func rtFhDevListBegin(path: string): bool {
    if FhHListBegin(path) != 0 {
        return false
    }
    rtFhListBuf = SerNewPtr(256)
    return true
}

func rtFhDevListNext(): string {
    var s: string
    var n: int
    var i: int

    if FhHListNext(rtFhListBuf) != 0 {
        return ""
    }
    n = peekb(rtFhListBuf)
    i = 0
    while i < n {
        s = s + char(peekb(rtFhListBuf + 1 + i))
        i = i + 1
    }
    return s
}

func rtFhDevListEnd() {
    FhHListEnd()
    SerDisposePtr(rtFhListBuf)
    rtFhListBuf = ptr(0)
}

func rtFhDevSetInfo(path: string, ftype: string, fcreator: string, created: int, modified: int): int {
    return FhHSetTimes(path, created, modified)
}

func rtFhDevRename(path: string, newName: string): int {
    return FhHRename(path, newName)
}

func rtFhDevMove(path: string, dirPath: string): int {
    return FhHMove(path, dirPath)
}

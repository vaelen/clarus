// rtTextCrc16 (Task 3): CRC-16/KERMIT over bytes [pos, pos+n), starting
// from seed h (masked to 16 bits, so chunked calls can feed a prior
// return value straight back in as the next h). n == 0 is a no-op
// identity, same convention rtTextHashStep uses, and STILL bounds-checks
// pos against rt.len first (same `pos > rt.len - n` shape with n == 0
// reducing to `pos > rt.len`). Table-driven off rtCrc16KTab above (the
// language-runtime-cleanup phase replaced the 8-step per-bit loop);
// `>>` is arithmetic in Clarus, but crc never leaves 0-0xFFFF so the
// sign bit is never in play, and the result is masked anyway.
// Published check value: "123456789" -> 0x2189.
func rtTextCrc16(t: ptr, h: int, pos: int, n: int): int {
    var rt: RtText
    var mp: ptr
    var crc: int
    var i: int
    var b: int

    rt = RtText(t)
    if pos < 0 or n < 0 or pos > rt.len - n {
        rtPanic("text index out of range")
    }
    crc = h & 0xFFFF
    if n == 0 {
        return crc
    }
    mp = TextHandleDeref(rt.h)
    i = 0
    while i < n {
        b = peekb(mp + pos + i)
        crc = (rtCrc16KTab[(crc ^ b) & 0xFF] ^ (crc >> 8)) & 0xFFFF
        i = i + 1
    }
    return crc
}

// rtTextCrc16X (transfer-crcs phase): CRC-16/XMODEM over bytes
// [pos, pos+n) -- poly 0x1021 FORWARD (MSB-first, no reflection), seed h
// masked to 16 bits, no final XOR. Same skeleton and chunking contract as
// rtTextCrc16 above (which is the REFLECTED CRC-16/KERMIT); only the
// table and the index differ: the byte is xored into the HIGH half and
// the register shifts LEFT, masked to 16 bits after every step so the
// value never reaches bit 31.
// Published check value: "123456789" -> 0x31C3.
func rtTextCrc16X(t: ptr, h: int, pos: int, n: int): int {
    var rt: RtText
    var mp: ptr
    var crc: int
    var i: int
    var b: int

    rt = RtText(t)
    if pos < 0 or n < 0 or pos > rt.len - n {
        rtPanic("text index out of range")
    }
    crc = h & 0xFFFF
    if n == 0 {
        return crc
    }
    mp = TextHandleDeref(rt.h)
    i = 0
    while i < n {
        b = peekb(mp + pos + i)
        crc = (rtCrc16XTab[((crc >> 8) ^ b) & 0xFF] ^ ((crc << 8) & 0xFFFF)) & 0xFFFF
        i = i + 1
    }
    return crc
}

// rtTextCrc32 (transfer-crcs phase): CRC-32 (IEEE / ZMODEM / zip,
// reflected poly 0xEDB88320) over bytes [pos, pos+n), table-driven off
// rtCrc32Tab above. h is the RAW 32-bit register in and out -- no
// masking (all 32 bits are significant), no init, no final XOR: the
// caller seeds 0xFFFFFFFF and xors the result with 0xFFFFFFFF, which
// keeps chunked calls composable exactly like rtTextCrc16's seed-carry.
// Published check: crc32(0xFFFFFFFF, "123456789") ^ 0xFFFFFFFF ==
// 0xCBF43926. The & 0x00FFFFFF after `>> 8` is load-bearing (arithmetic
// shift, bit 31 routinely set).
func rtTextCrc32(t: ptr, h: int, pos: int, n: int): int {
    var rt: RtText
    var mp: ptr
    var crc: int
    var i: int
    var b: int

    rt = RtText(t)
    if pos < 0 or n < 0 or pos > rt.len - n {
        rtPanic("text index out of range")
    }
    if n == 0 {
        return h
    }
    crc = h
    mp = TextHandleDeref(rt.h)
    i = 0
    while i < n {
        b = peekb(mp + pos + i)
        crc = rtCrc32Tab[(crc ^ b) & 0xFF] ^ ((crc >> 8) & 0x00FFFFFF)
        i = i + 1
    }
    return crc
}

// rtTextStringAt: reads a 1-byte Pascal-style length prefix at pos (the
// same Str255 shape `string` itself uses -- length byte then payload),
// then that many bytes. Str255 is a plain value type (no ARC birth
// needed), so this is an ordinary Clarus function returning `string` by
// value -- copy through a char[255] buffer, then s.fromBytes -- rather
// than rtTextSlice's raw out-ptr convention (which exists only because
// that function is itself an ARC-adjacent waist primitive; a plain
// by-value return is simpler here and the generated C already returns
// clar_str_255 by value for any function declared `: string`, so
// cprint.cla's ITextStringAt arm below needs no out-param dance
// either). The length byte is 0-255 by construction (peekb's own
// range), so the old `l < 0 or l > 255` cap check and its "string too
// long" panic are impossible-by-construction and have been removed --
// STRICT bounds are the only checks left. Caller advances by
// `1 + result.length`.
func rtTextStringAt(t: ptr, pos: int): string {
    var rt: RtText
    var mp: ptr
    var l: int
    var buf: char[255]
    var i: int
    var s: string

    rt = RtText(t)
    if pos < 0 or pos > rt.len - 1 {
        rtPanic("text index out of range")
    }
    mp = TextHandleDeref(rt.h)
    l = peekb(mp + pos)
    // l is 0..255 by construction (peekb's own range) -- no negative-
    // length or >255-cap case is reachable here, unlike the old 4-byte
    // BE-composed length, so only the payload bound needs checking.
    if pos > rt.len - 1 - l {
        rtPanic("text index out of range")
    }
    i = 0
    while i < l {
        buf[i] = char(peekb(mp + pos + 1 + i))
        i = i + 1
    }
    s.fromBytes(buf, l)
    return s
}

// rtTextTextAt: a fresh `text` copy of bytes [pos, pos+n) -- text is a
// reference type (handle + rc), so unlike stringAt this needs the same
// dst-out-param ARC convention rtTextConcat/rtTextAppendText use: dst
// is grown to hold n bytes, BOTH master pointers are re-derived AFTER
// the grow (relocation discipline -- growing dst's own handle can move
// ANY relocatable block, including t's), then one bulk
// TextBlockMoveData (never a per-byte append loop -- that's the whole
// point of this method existing). cprint.cla's ITextTextAt arm mirrors
// fpTextConcat/ITextConcatSL's own dst-allocation dance (rtTextNew()
// first, then this call) -- copy that convention exactly, not
// improvised: dst is caller-allocated, this function never calls
// rtTextNew itself, same shape rtTextConcat/rtTextConcatSl declare.
func rtTextTextAt(dst: ptr, t: ptr, pos: int, n: int) {
    var rt: RtText
    var rd: RtText
    var srcmp: ptr
    var dstmp: ptr

    rt = RtText(t)
    if pos < 0 or n < 0 or pos > rt.len - n {
        rtPanic("text index out of range")
    }
    rtTextGrow(dst, n)
    rt = RtText(t)
    rd = RtText(dst)
    srcmp = TextHandleDeref(rt.h)
    dstmp = TextHandleDeref(rd.h)
    TextBlockMoveData(srcmp + pos, dstmp, n)
    rd.len = n
}

// rtTextIndexOfStr (rt_core.inc:405-419): empty needle convention (Ch3) --
// an empty needle is found at index 0, same as rtStrIndexOfStr.
func rtTextIndexOfStr(t: ptr, needle: ptr): int {
    var rt: RtText
    var tlen: int
    var nlen: int
    var i: int
    var j: int
    var match: bool
    var mp: ptr

    rt = RtText(t)
    tlen = rt.len
    nlen = peekb(needle)
    if nlen == 0 {
        return 0
    }
    if nlen > tlen {
        return -1
    }
    mp = TextHandleDeref(rt.h)
    i = 0
    while i <= tlen - nlen {
        match = true
        j = 0
        while j < nlen {
            if peekb(mp + i + j) != peekb(needle + 1 + j) {
                match = false
                break
            }
            j = j + 1
        }
        if match {
            return i
        }
        i = i + 1
    }
    return -1
}

// rtTextIndexOfChar (rt_core.inc:421-430).
func rtTextIndexOfChar(t: ptr, c: int): int {
    var rt: RtText
    var i: int
    var mp: ptr

    rt = RtText(t)
    mp = TextHandleDeref(rt.h)
    i = 0
    while i < rt.len {
        if peekb(mp + i) == c {
            return i
        }
        i = i + 1
    }
    return -1
}

// rtTextAppendStr (rt_core.inc:432-441): amortized growth (rtTextGrow
// doubles capacity, so a loop of N appends costs O(N) total, not O(N^2)).
// len0 is captured before rtTextGrow (which never touches .len itself, but
// CAN move the block) -- mp is re-derived after.
func rtTextAppendStr(t: ptr, s: ptr) {
    var n: int
    var rt: RtText
    var len0: int
    var mp: ptr

    n = peekb(s)
    rt = RtText(t)
    len0 = rt.len
    rtTextGrow(t, len0 + n)
    rt = RtText(t)
    mp = TextHandleDeref(rt.h)
    TextBlockMoveData(s + 1, mp + len0, n)
    rt.len = len0 + n
}

// rtTextAppendChar (rt_core.inc:443-450): same re-derive-after-grow
// discipline as rtTextAppendStr.
func rtTextAppendChar(t: ptr, c: int) {
    var rt: RtText
    var len0: int
    var mp: ptr

    rt = RtText(t)
    len0 = rt.len
    rtTextGrow(t, len0 + 1)
    rt = RtText(t)
    mp = TextHandleDeref(rt.h)
    pokeb(mp + len0, c)
    rt.len = len0 + 1
}

// rtTextClear (string-perf phase, text.clear()): len = 0; capacity and
// handle untouched -- no traps, so a warm reused buffer resets for
// free (the clear()+reuse idiom removes both birth/death and growth
// traps from a hot per-line/per-draw loop). The bytes beyond len are
// dead by the same length-bounded contract every text read path in
// this module already honors.
func rtTextClear(t: ptr) {
    var rt: RtText

    rt = RtText(t)
    rt.len = 0
}

// rtTextReserve (string-perf phase, text.reserve(n)): pre-grow to at
// least n bytes of capacity -- at most one SetHandleSize trap, vs. one
// per doubling boundary when a per-char producer grows implicitly
// (measured ~6 traps filling 0->128 one char at a time). No-op when
// capacity already suffices; never shrinks; panics "out of memory" on
// failure exactly like implicit growth (rtTextGrow above).
func rtTextReserve(t: ptr, n: int) {
    if n > 0 {
        rtTextGrow(t, n)
    }
}

// rtTextAppendText (rt_core.inc:452-464): src may alias t (self-append
// doubles) -- n is captured before rtTextGrow can move t's block (which is
// src's block too, when src == t); both master pointers are re-derived
// AFTER rtTextGrow regardless of aliasing (paranoid-safe either way). For
// self-append, the destination range (len0, len0+n) never overlaps the
// source (0, n) because len0 == n when src == t -- no separate self-append
// branch needed, same as the C reference's own comment.
func rtTextAppendText(t: ptr, src: ptr) {
    var rs: RtText
    var rt: RtText
    var n: int
    var len0: int
    var srcmp: ptr
    var dstmp: ptr

    rs = RtText(src)
    n = rs.len
    rt = RtText(t)
    len0 = rt.len
    rtTextGrow(t, len0 + n)
    rs = RtText(src)
    rt = RtText(t)
    srcmp = TextHandleDeref(rs.h)
    dstmp = TextHandleDeref(rt.h)
    TextBlockMoveData(srcmp, dstmp + len0, n)
    rt.len = len0 + n
}

// fileh_68k.cla: the native-68k rtFhDev* waist (2026-08-22 binary-files
// spec, Task 6) -- fileh_c.cla's twin, same nine function names, real
// File Manager positioned-I/O calls (toolbox/files.cla + toolbox/
// devices.cla) instead of host pread/pwrite. Spliced (with fileh.cla)
// into EVERY want68k build now, unconditionally -- the same full-lane-
// superset treatment conn.cla/conn_68k.cla got in Task 6 of the serial-
// connection phase (drive.cla's own header comment on that splice site):
// fileh.cla's own rtFh* entry points must resolve in every native build
// once the checker's usesFileh hook can fire from ANY type position
// (Task 5's own check.cla note), so fileh_68k.cla must always be there
// to answer them, dormant or not. The host lane's fileh.cla+fileh_c.cla
// pair stays usesFileh-gated (drive.cla), unlike this pair.
//
// Pulls the real File Manager/Device Manager declarations from
// toolbox/devices.cla (PBOpenSync/PBReadSync) + toolbox/files.cla
// (IOParam, FileParam, PBCreateSync/PBWriteSync/PBCloseSync/
// PBSetFInfoSync/PBGetEOFSync/PBSetEOFSync/PBFlushFileSync/
// PBFlushVolSync, fsRdWrPerm/fsFromStart/fsFromLEOF) + toolbox/
// memory.cla (HLock/HUnlock) -- the same "runtime modules include
// toolbox catalog files" idiom conn_68k.cla already establishes; Task 1's
// normalized include-once identity dedups conn_68k.cla's own identical
// includes of devices.cla/files.cla (both modules are always spliced
// together under want68k -- see drive.cla), so composing all three here
// costs nothing extra.
include "../../toolbox/devices.cla"
include "../../toolbox/files.cla"
include "../../toolbox/memory.cla"

// rtFh68kLastErr: this lane's own "last OS error" storage, read back by
// rtFhDevLastOSErr -- every rtFhDev* entry below that calls a PBxxxSync
// trap stashes that trap's own OSErr result here, whether zero or not
// (fileh.cla only ever reads it immediately after a call it already knows
// failed, so an overwritten-but-unread zero from an unrelated successful
// call in between is never observed).
var rtFh68kLastErr: int

// rtFh68kName: the NewPtr+pokeb Pascal-string pattern conn_68k.cla's own
// rtConn68kName already establishes for ioNamePtr (toolbox/devices.cla's
// own header comment: extern record has no address-of operator, so a
// name that must exist BEFORE a PB call needs its own hand-built buffer).
// Reuses ser.cla's already-spliced SerNewPtr/SerDisposePtr (ser.cla always
// precedes this module in the splice order -- see drive.cla) rather than
// declaring a redundant unprefixed NewPtr/DisposePtr pair of its own.
//
// UNLIKE rtConn68kName's own buffer (opened at most twice per whole
// program run, for the two fixed serial ports, and never disposed --
// that function's own header comment calls this out explicitly): every
// rtFhDevOpen/rtFhDevCreate call below builds and DISPOSES one of these
// buffers per call, since a program can open/create arbitrarily many
// filehandles over its run (cases_fileh.cla's own reopen step is one
// concrete example) -- leaving the conn precedent's "never freed" choice
// in place here would be an unbounded per-open leak, not a one-time cost.
// PBOpenSync/PBCreateSync are synchronous and copy the name out of this
// buffer before returning, so disposing it immediately after each call
// is safe.
func rtFh68kName(s: string): ptr {
    var p: ptr
    var i: int

    p = SerNewPtr(s.length + 1)
    pokeb(p, s.length)
    i = 0
    while i < s.length {
        pokeb(p + 1 + i, int(s[i]))
        i = i + 1
    }
    return p
}

// rtFh68kPack4CC: rtFourCC(UiStrAddr(s)) -- rtFourCC (core.cla:130)
// returns -1 for a non-literal type/creator string longer than 4 bytes
// (its own "overlong" sentinel); rtFhDevCreate and rtFhDevSetInfo both
// pack a type and a creator this exact way, so the pack call itself
// lives here once. The -1 CHECK stays at each call site (final-review
// wave, Minor 6) since the two callers need different buffer-disposal
// handling on that path.
func rtFh68kPack4CC(s: string): int {
    return rtFourCC(UiStrAddr(s))
}

// rtFhDevOpen: ioPermssn = fsRdWrPerm (positioned read/write access),
// PBOpenSync, handle = ioRefNum (never 0 on success, per Task 1's own
// probe -- refNum 472 in that report's trace). A nonzero OSErr stashes
// itself in rtFh68kLastErr and returns 0, fileh.cla's own nil-on-failure
// contract.
func rtFhDevOpen(path: string): int {
    var pb: IOParam
    var namePtr: ptr

    namePtr = rtFh68kName(path)
    pb.ioNamePtr = namePtr
    pb.ioVRefNum = 0
    pb.ioPermssn = fsRdWrPerm
    rtFh68kLastErr = PBOpenSync(pb)
    SerDisposePtr(namePtr)

    if rtFh68kLastErr != 0 {
        return 0
    }
    return pb.ioRefNum
}

// rtFhDevOpenRF (language-runtime-cleanup, spec %6): rtFhDevOpen verbatim
// with PBOpenRFSync (_OpenRF, trap 0xA00A -- toolbox/files.cla, already
// declared there since the filesystem-api phase) in place of PBOpenSync.
// Same IOParam, same fsRdWrPerm; the refNum it hands back feeds the
// existing positioned read/write/flush/close path with no fork-specific
// code below this point -- to the File Manager a resource-fork refNum is
// just another open file.
func rtFhDevOpenRF(path: string): int {
    var pb: IOParam
    var namePtr: ptr

    namePtr = rtFh68kName(path)
    pb.ioNamePtr = namePtr
    pb.ioVRefNum = 0
    pb.ioPermssn = fsRdWrPerm
    rtFh68kLastErr = PBOpenRFSync(pb)
    SerDisposePtr(namePtr)

    if rtFh68kLastErr != 0 {
        return 0
    }
    return pb.ioRefNum
}

// rtFhDevCreate: PBCreateSync's own result is deliberately ignored for
// the dupFNErr case (the file already existing, the one error
// filehandle.create treats as fine) -- the PBOpenSync below is the
// actual open success/failure gate, exactly native.cla's own
// natFileWriteText precedent ("dupFNErr ignored either way -- Open just
// below is the real success/failure gate", native.cla:809-812).
//
// Type/creator are stamped via a DIRECT PBSetFInfoSync on a FileParam
// (ioFDirIndex = 0, fdType/fdCreator packed by rtFourCC) -- the no-Get
// discipline native.cla:824-852 documents in full: never call
// PBGetFInfoSync first, since a File Manager QUERY trap under a heap
// busy with live UI/List/Map/Text traffic is the exact class of hang
// that function's own header comment root-causes (and Task 1's probe
// wave, task-1-report.md (c), independently re-confirms the caution is
// still warranted for this phase's own GetEOF call below).
//
// FIX ROUND 1 (review finding): the stamp is GATED on PBCreateSync's
// own result being 0 (a genuinely FRESH file) -- exactly
// native.cla:847-852's own ioResult-gated discipline, NOT the
// unconditional stamp this function shipped with originally. A zeroed
// `fp` (Clarus local semantics) written UNCONDITIONALLY would zero a
// PRE-EXISTING file's real fdFlags/fdLocation/fdFldr (the pad[40] bytes
// after fdCreator in FileParam) on every dupFNErr'd re-create -- wiping
// that file's real Finder flags/icon position/folder, not just its
// type/creator. `filehandle.create`'s "always resets" contract (Task 5's
// host lane unconditionally O_TRUNCs) only covers the file's DATA
// (truncated unconditionally below via PBSetEOFSync 0, independent of
// this gate) -- spec %3.1 itself says create "stamps type/creator
// EXACTLY as file.writeText does", and writeText's own precedent
// (native.cla:824-852) is this exact ioResult gate. PBSetFInfoSync's own
// OSErr is captured into rtFh68kLastErr and treated as a create failure
// (return 0, matching every other trap call in this function -- the
// PBSetEOFSync check just below is the direct template) rather than
// silently ignored the way PBCreateSync's own dupFNErr is: an InfoSync
// failure on an otherwise-fresh file is real weather (disk full, locked
// volume), not the one specific "already exists" case this function
// already knows how to shrug off.
//
// ftype/fcreator arrive as plain `string` values, already Str255-shaped
// in memory (uiscript.cla's own UiStrAddr header comment) -- UiStrAddr
// (uiscript.cla, always spliced ahead of this module -- see drive.cla)
// hands back that Str255 buffer's own address with no extra copy, exactly
// what rtFourCC (core.cla:130, always spliced) wants.
//
// PBSetEOFSync 0 truncates the just-opened file to empty (filehandle.
// create's own "always resets" contract, restated above) UNCONDITIONALLY
// -- independent of whether the FInfo stamp above ran; a failure here
// closes the just-opened refNum before returning 0 rather than leaking
// an open, half-truncated handle back to a caller who thinks create()
// failed outright.
func rtFhDevCreate(path: string, ftype: string, fcreator: string): int {
    var pb: IOParam
    var fp: FileParam
    var eofPb: IOParam
    var namePtr: ptr
    var packedType: int
    var packedCreator: int
    var h: int
    var err: int
    var createErr: int

    packedType = rtFh68kPack4CC(ftype)
    packedCreator = rtFh68kPack4CC(fcreator)

    // final-review wave, Minor 6: an overlong (>4-byte) non-literal
    // ftype/fcreator packs to rtFourCC's own -1 sentinel -- fail the
    // create outright instead of stamping the file with 0xFFFFFFFF.
    // -37 is bdNamErr (MacErrors.h: "Bad name"), the closest of the
    // catalogued OSErrs to "the caller's type/creator string was
    // rejected" -- no namePtr/buffer exists yet at this point, so there
    // is nothing to dispose before returning.
    if packedType == -1 or packedCreator == -1 {
        rtFh68kLastErr = -37
        return 0
    }

    namePtr = rtFh68kName(path)

    pb.ioNamePtr = namePtr
    pb.ioVRefNum = 0
    createErr = PBCreateSync(pb)

    // final-review wave, M4: dupFNErr (-48, "file already exists") is the
    // ONE PBCreateSync failure this function tolerates -- a re-create of
    // an existing file falls through to the open below, same as
    // natFileWriteText's own precedent just above. Any OTHER non-zero
    // result (disk full, bad name, locked volume, ...) is a real create
    // failure; previously this fell through anyway and PBOpenSync below
    // almost always succeeds against the pre-existing file, so the
    // caller only ever saw the OPEN error, never the real cause. Stash it
    // and bail here instead.
    if createErr != 0 and createErr != -48 {
        rtFh68kLastErr = createErr
        SerDisposePtr(namePtr)
        return 0
    }

    if createErr == 0 {
        fp.ioNamePtr = namePtr
        fp.ioVRefNum = 0
        fp.ioFDirIndex = 0
        fp.fdType = packedType
        fp.fdCreator = packedCreator
        err = PBSetFInfoSync(fp)
        if err != 0 {
            rtFh68kLastErr = err
            SerDisposePtr(namePtr)
            return 0
        }
    }

    SerDisposePtr(namePtr)

    h = rtFhDevOpen(path)
    if h == 0 {
        return 0
    }

    eofPb.ioRefNum = h
    eofPb.ioMisc = ptr(0)
    err = PBSetEOFSync(eofPb)
    if err != 0 {
        rtFh68kLastErr = err
        rtFhDevClose(h)
        return 0
    }

    return h
}

// rtFhDevReadAt: grows `out` to `count` bytes (rtTextGrow, text.cla,
// always spliced ahead of this module), then HLocks the Handle and
// re-derives the master pointer AFTER the lock -- native.cla's own
// natFileWriteText:865-893 discipline for the identical hazard on the
// WRITE side (PBWriteSync's underlying _Write trap can itself allocate a
// disk driver/cache buffer, triggering Memory Manager compaction
// mid-call; an unlocked Handle is fair game to relocate during that
// compaction, stranding a pointer captured before the call). PBReadSync's
// underlying _Read trap shares the identical hazard (Inside Macintosh:
// both traps can allocate a buffer-cache block), so the same lock
// discipline applies symmetrically here. Chosen over the brief's other
// offered option (a NewPtrCLEAR bounce buffer + BlockMove, natFileReadText's
// own discipline) because rtTextGrow already sizes `out` to exactly the
// `count` bytes this call needs -- reading straight into the locked
// Handle needs no second buffer or copy; a chunked/unbounded read (which
// is what drove natFileReadText to a bounce buffer in the first place,
// per that function's own header) is not this waist's shape at all.
//
// ioPosMode = fsFromStart / ioPosOffset = pos / ioReqCount = count.
// eofErr (-39) with ioActCount >= 0 is SUCCESS (short read at/past EOF,
// Task 1's probe (d)) -- any OTHER nonzero OSErr is a hard I/O error.
func rtFhDevReadAt(h: int, pos: int, out: ptr, count: int): int {
    var pb: IOParam
    var rt: RtText
    var mp: ptr
    var got: int

    rtTextGrow(out, count)
    rt = RtText(out)

    HLock(rt.h)
    mp = TextHandleDeref(rt.h)

    pb.ioRefNum = h
    pb.ioBuffer = mp
    pb.ioReqCount = count
    pb.ioPosMode = fsFromStart
    pb.ioPosOffset = pos
    rtFh68kLastErr = PBReadSync(pb)
    got = pb.ioActCount

    HUnlock(rt.h)

    if rtFh68kLastErr != 0 and rtFh68kLastErr != -39 {
        rt.len = 0
        return -1
    }
    rt.len = got
    return got
}

// rtFhDevWriteAt: `p` is already a raw, non-relocatable NewPtr'd scratch
// buffer (fileh.cla's own rtFhWriteRaw marshals every write/append call
// into one before ever reaching this lane) -- never Handle-backed, so no
// HLock/HUnlock bracket is needed here (unlike rtFhDevReadAt's `out`
// above, which fills the caller's own Handle-backed text in place).
// pos == -1 is rtFhWriteRaw's own "at current EOF" sentinel (rtFhAppend):
// fsFromLEOF/0 positions there without a separate size() query; any other
// pos writes fsFromStart/pos, extending the file past its current EOF
// exactly the way Task 1's probe (d) proved (a "hole" between old EOF and
// the new write's start reads back however the Mac OS itself fills it --
// unspecified per the spec, not this lane's concern).
func rtFhDevWriteAt(h: int, pos: int, p: ptr, n: int): int {
    var pb: IOParam

    pb.ioBuffer = p
    pb.ioReqCount = n
    if pos == -1 {
        pb.ioPosMode = fsFromLEOF
        pb.ioPosOffset = 0
    } else {
        pb.ioPosMode = fsFromStart
        pb.ioPosOffset = pos
    }
    pb.ioRefNum = h
    rtFh68kLastErr = PBWriteSync(pb)
    return rtFh68kLastErr
}

// rtFhDevSize: PBGetEOFSync via ioMisc, a plain per-call LOCAL param
// block -- Task 1's own probe wave (task-1-report.md (c)) is this
// function's entire justification: it proved PBGetEOFSync survives the
// busiest heap this repo can currently produce (three separate calls,
// immediately after 31 real toolbox-suite cases' worth of live traffic)
// with a FRESH local `extern record` pb each time, correct results every
// time -- but does NOT positively prove safety against a long-lived,
// heap-resident, REUSED pb the way native.cla's own natFilePb caused the
// original documented hang. This function therefore never reuses a pb
// across calls (no module-global param block anywhere in this file), per
// that report's own explicit Task 6 recommendation.
func rtFhDevSize(h: int): int {
    var pb: IOParam

    pb.ioRefNum = h
    rtFh68kLastErr = PBGetEOFSync(pb)
    if rtFh68kLastErr != 0 {
        return -1
    }
    return int(pb.ioMisc)
}

// rtFhDevSetSize: PBSetEOFSync with ioMisc = n (the truncate/grow target
// -- IOParam's own header comment in toolbox/files.cla: "ioMisc carries
// GetEOF's result AND SetEOF's input"). Growing the file this way is
// unspecified-fill on the Mac (spec %3.1, not guarded here -- fileh.cla's
// own rtFhSetSize doc comment already states the host/Mac split).
func rtFhDevSetSize(h: int, n: int): int {
    var pb: IOParam

    pb.ioRefNum = h
    pb.ioMisc = ptr(n)
    rtFh68kLastErr = PBSetEOFSync(pb)
    return rtFh68kLastErr
}

// rtFhDevFlush: PBFlushFileSync(ioRefNum) then PBFlushVolSync with
// ioNamePtr = 0 / ioVRefNum = 0 (default volume) -- native.cla's own
// natFileFlush precedent (native.cla:753-764). A file-flush failure is
// reported over a vol-flush failure when both occur (the more specific,
// more actionable of the two); either alone still surfaces.
func rtFhDevFlush(h: int): int {
    var filePb: IOParam
    var volPb: IOParam
    var fileErr: int
    var volErr: int

    filePb.ioRefNum = h
    fileErr = PBFlushFileSync(filePb)

    volPb.ioNamePtr = ptr(0)
    volPb.ioVRefNum = 0
    volErr = PBFlushVolSync(volPb)

    if fileErr != 0 {
        rtFh68kLastErr = fileErr
        return fileErr
    }
    rtFh68kLastErr = volErr
    return volErr
}

// rtFhDevClose: PBCloseSync. fileh.cla's own rtFhClose already treats
// h == 0 as a no-op before ever reaching this lane, so no nil check is
// needed here.
func rtFhDevClose(h: int) {
    var pb: IOParam

    pb.ioRefNum = h
    PBCloseSync(pb)
}

// rtFhDevLastOSErr: this lane's own last-OSErr storage (rtFh68kLastErr,
// this file's header comment above).
func rtFhDevLastOSErr(): int {
    return rtFh68kLastErr
}

// rtFh68kState (filesystem-api Task 5, spec %4.3/%6): the ONE new
// module-level global this task adds (Global Constraints -- every other
// entry point below reuses local `extern record` vars, per the
// controller ruling in task-1-report.md section (d): "Only `var x:
// CInfoPBRec`-style locals exist. There is no `CInfoPBRec(ptr(...))`-
// style overlay/conversion for `extern record`." A local goes out of
// scope at the end of its call, so the seven rtFhDevStat* getters below
// (each its OWN function, called well after rtFhDevStat returns) and
// rtFhDevListNext's cursor (dirID/index, alive across many calls) both
// need somewhere durable to live -- one lazily-allocated heap block,
// SerNewPtr'd on first use, holds both. Layout (ints throughout, 4-byte
// slots, no packing surprises):
//   +0  stat size            +4  stat rsrcSize
//   +8  stat type (raw 4CC)  +12 stat creator (raw 4CC)
//   +16 stat created         +20 stat modified
//   +24 stat isDir (0/1)     +28 stat dirID (the hit's OWN DirID, valid
//                                 only when isDir -- ioDirID's folder-hit
//                                 meaning, task-1-report.md section (c)
//                                 step 6/(a)'s DirInfo overlap)
//   +32 list dirID            +36 list index (ioFDirIndex, next call)
//   +40 list name buffer ptr (256-byte scratch, PBGetCatInfoSync writes
//                                 the Pascal leaf name here)
//   +44 stat parent DirID    (ioFlParID@100 / DirInfo's ioDrParID, the
//                                 SAME field for both hit kinds -- set on
//                                 EVERY successful stat, file or folder,
//                                 and read by rtFhDevRename below)
// 48 bytes total.
var rtFh68kState: ptr

// rtFh68kEnsureState: allocate the state block plus its persistent
// 256-byte name scratch on first use. BOTH SerNewPtr calls are checked:
// on either failure the block is released again and rtFh68kState is left
// nil with rtFh68kLastErr = memFullErr (-108), so the single
// `rtFh68kState == ptr(0)` bail in rtFhDevStat below -- this function's
// only caller, and the gate every other state reader sits behind --
// covers both failures, and no half-built block with a garbage +40 name
// pointer can ever be observed.
func rtFh68kEnsureState() {
    var buf: ptr

    if rtFh68kState == ptr(0) {
        rtFh68kState = SerNewPtr(48)
        if rtFh68kState == ptr(0) {
            rtFh68kLastErr = -108
            return
        }
        buf = SerNewPtr(256)
        if buf == ptr(0) {
            SerDisposePtr(rtFh68kState)
            rtFh68kState = ptr(0)
            rtFh68kLastErr = -108
            return
        }
        pokel(rtFh68kState + 40, int(buf))
    }
}

// rtFh68kFourCCToStr: the reverse of rtFourCC/rtPack4CCRange (core.cla) --
// unpacks a big-endian 4CC int into its 4-char string, ser.cla's own
// rtSerPutI32 byte-order (>>24/>>16/>>8/&255). 0 (this task's own
// "no type/creator" sentinel for a directory hit or the "" default
// folder) maps to "", matching fileh_c.cla's host-lane empty default --
// DirOps' own new type/creator assertions (cases_dirops.cla, Step 1)
// are written lane-neutral on exactly this "" convention.
// A zero fdType (an untyped file) and a folder both read back as "" --
// isDir is the discriminator; documented in the reference's file.info
// entry.
func rtFh68kFourCCToStr(v: int): string {
    var s: string

    if v == 0 {
        return s
    }
    s = s + char((v >> 24) & 255)
    s = s + char((v >> 16) & 255)
    s = s + char((v >> 8) & 255)
    s = s + char(v & 255)
    return s
}

// rtFh68kLeafName: the text after the last ':' in `path` (the whole
// string if there is none) -- PBHRenameSync's own required addressing
// mode (task-1-report.md section (c) step 7/7d: "ioNamePtr must be JUST
// the item's own leaf name (no colons at all)"), used only by
// rtFhDevRename below.
func rtFh68kLeafName(path: string): string {
    var i: int
    var last: int
    var s: string

    last = -1
    i = 0
    while i < path.length {
        if path[i] == ':' {
            last = i
        }
        i = i + 1
    }
    if last == -1 {
        return path
    }
    i = last + 1
    while i < path.length {
        s = s + path[i]
        i = i + 1
    }
    return s
}

// rtFhDevStat: PBGetCatInfoSync by name (ioFDirIndex = 0 = get info by
// name, ioDirID = 0 = search starts at the default folder, ioVRefNum = 0
// = default volume, ioACUser cleared per Files.a's own warning) --
// this addressing convention is task-1-report.md's own trace, confirmed
// live throughout that probe's steps 1/2/5/7/8/9 (section (c)). `path ==
// ""` is DESIGNED as a synthetic default-folder directory hit (DirID 0,
// no by-name call at all) rather than routed through PBGetCatInfoSync --
// a by-name GetCatInfo on an empty name was never itself probed; this
// instead reuses Task 1's own DirID-0 enumeration finding (trace step 6,
// section (c): "ioDirID = 0 ... DOES enumerate the default folder") plus
// the controller's dispatch amendment for Task 5, which extends that
// same "" = default-folder convention from `list` to `exists`/`info`
// too (spec %3's lane-parity rule, fix round 1).
// A `var ci: CInfoPBRec` local is fresh zero-initialized on every call
// (docs/clarus-language-reference.md:1662, reconfirmed live in
// task-1-report.md section (d): "declaring one as a local ... reserves
// the record's packed size in bytes, directly, zero-initialized"), so no
// manual zeroing is needed before filling in the fields this call sets.
// The seven scalars + the folder's own DirID are copied out of `ci` into
// the state block right after a successful call, exactly the fallback
// the brief's Step 3 code names for when no address-of-a-local form
// exists. `CInfoPBRec`'s `ioFlAttrib & ioDirMask` bit tells a folder hit
// from a file hit (task-1-report.md section (a)); a folder hit zeros
// size/rsrcSize/type/creator (spec %4.1's own dir defaults) and stashes
// its own DirID at +28 for rtFhDevListBegin below -- a file hit fills
// them from `ioFlLgLen`/`ioFlRLgLen`/`fdType`/`fdCreator` and leaves +28
// unused (rtFhDevListBegin only reads it after asserting isDir first).
// `ioFlCrDat`/`ioFlMdDat` are read unconditionally for both variants:
// toolbox/files.cla's own CInfoPBRec header comment confirms
// `ioDrCrDat`/`ioDrMdDat` (DirInfo) physically overlap the SAME bytes as
// `ioFlCrDat`@72/`ioFlMdDat`@76 (HFileInfo) -- no isDir branch needed for
// the two date fields, unlike size/rsrcSize/type/creator above.
func rtFhDevStat(path: string): bool {
    var ci: CInfoPBRec
    var namePtr: ptr

    rtFh68kEnsureState()
    if rtFh68kState == ptr(0) {
        return false
    }

    if path == "" {
        pokel(rtFh68kState, 0)
        pokel(rtFh68kState + 4, 0)
        pokel(rtFh68kState + 8, 0)
        pokel(rtFh68kState + 12, 0)
        pokel(rtFh68kState + 16, 0)
        pokel(rtFh68kState + 20, 0)
        pokel(rtFh68kState + 24, 1)
        pokel(rtFh68kState + 28, 0)
        pokel(rtFh68kState + 44, 0)
        rtFh68kLastErr = 0
        return true
    }

    namePtr = rtFh68kName(path)
    ci.ioNamePtr = namePtr
    ci.ioVRefNum = 0
    ci.ioFDirIndex = 0
    ci.ioDirID = 0
    ci.ioACUser = 0
    rtFh68kLastErr = PBGetCatInfoSync(ci, hfsSelGetCatInfo)
    SerDisposePtr(namePtr)
    if rtFh68kLastErr != 0 {
        return false
    }

    if (ci.ioFlAttrib & ioDirMask) != 0 {
        pokel(rtFh68kState, 0)
        pokel(rtFh68kState + 4, 0)
        pokel(rtFh68kState + 8, 0)
        pokel(rtFh68kState + 12, 0)
        pokel(rtFh68kState + 24, 1)
        pokel(rtFh68kState + 28, ci.ioDirID)
    } else {
        pokel(rtFh68kState, ci.ioFlLgLen)
        pokel(rtFh68kState + 4, ci.ioFlRLgLen)
        pokel(rtFh68kState + 8, ci.fdType)
        pokel(rtFh68kState + 12, ci.fdCreator)
        pokel(rtFh68kState + 24, 0)
    }
    pokel(rtFh68kState + 16, ci.ioFlCrDat)
    pokel(rtFh68kState + 20, ci.ioFlMdDat)
    // +44 on BOTH branches: ioFlParID@100 (HFileInfo) and ioDrParID@100
    // (DirInfo) are the same physical field and both mean "the hit's
    // parent DirID", so this needs no isDir branch -- rtFhDevRename below
    // reads it back instead of repeating this whole lookup.
    pokel(rtFh68kState + 44, ci.ioFlParID)
    return true
}

func rtFhDevStatSize(): int {
    return peekl(rtFh68kState)
}

func rtFhDevStatRsrcSize(): int {
    return peekl(rtFh68kState + 4)
}

func rtFhDevStatType(): string {
    return rtFh68kFourCCToStr(peekl(rtFh68kState + 8))
}

func rtFhDevStatCreator(): string {
    return rtFh68kFourCCToStr(peekl(rtFh68kState + 12))
}

func rtFhDevStatCreated(): int {
    return peekl(rtFh68kState + 16)
}

func rtFhDevStatModified(): int {
    return peekl(rtFh68kState + 20)
}

func rtFhDevStatIsDir(): bool {
    return peekl(rtFh68kState + 24) != 0
}

// rtFhDevMakeDir: PBDirCreateSync, ioDirID = 0 + a (possibly nested)
// partial path in ioNamePtr -- task-1-report.md section (c) step 1/2,
// confirmed working for both a fresh folder (OSErr 0) and a duplicate
// name (dupFNErr, -48).
func rtFhDevMakeDir(path: string): int {
    var hp: HFileParam
    var namePtr: ptr

    namePtr = rtFh68kName(path)
    hp.ioNamePtr = namePtr
    hp.ioVRefNum = 0
    hp.ioDirID = 0
    rtFh68kLastErr = PBDirCreateSync(hp, hfsSelDirCreate)
    SerDisposePtr(namePtr)
    return rtFh68kLastErr
}

// rtFhDevDelete: PBHDeleteSync, same ioDirID = 0 + partial-path
// addressing as MakeDir/GetCatInfo -- task-1-report.md section (c) step
// 9, confirmed for both a clean delete (0) and a non-empty folder
// (fBsyErr, -47).
func rtFhDevDelete(path: string): int {
    var hp: HFileParam
    var namePtr: ptr

    namePtr = rtFh68kName(path)
    hp.ioNamePtr = namePtr
    hp.ioVRefNum = 0
    hp.ioDirID = 0
    rtFh68kLastErr = PBHDeleteSync(hp)
    SerDisposePtr(namePtr)
    return rtFh68kLastErr
}

// rtFhDevListBegin: rtFhDevStat by path first ("" resolves to the
// default folder per Task 1's trace step 6/section (c) plus the
// controller's dispatch amendment for Task 5, flowing through
// unchanged), reject a
// file hit with dirNFErr (-120, "directory not found or incomplete
// pathname" -- the same OSErr the probe's own 7b diagnostic saw for a
// wrong-mode addressing attempt, reused here since Inside Macintosh has
// no more specific "not a directory" code for this call), then seed the
// cursor at the state block's list slots (+32 dirID from the stat hit's
// own +28, +36 index starting at 1 -- PBGetCatInfoSync's ioFDirIndex is
// 1-based).
func rtFhDevListBegin(path: string): bool {
    if not rtFhDevStat(path) {
        return false
    }
    if not rtFhDevStatIsDir() {
        rtFh68kLastErr = dirNFErr
        return false
    }
    pokel(rtFh68kState + 32, peekl(rtFh68kState + 28))
    pokel(rtFh68kState + 36, 1)
    return true
}

// rtFhDevListNext: PBGetCatInfoSync by index (ioDirID = the listing's
// folder, ioFDirIndex = the next 1-based slot, ioNamePtr = the state
// block's persistent 256-byte scratch buffer the trap WRITES the leaf
// Pascal name into) -- task-1-report.md section (c) step 6, confirmed
// for both a real folder's own DirID and DirID 0 (the default folder).
// `fnfErr` (-43) ends the listing (rtFh68kLastErr is left holding it, so
// rtFhDevListFailed below can tell a clean end from a real failure); any
// OTHER nonzero OSErr is a genuine failure, also left in rtFh68kLastErr,
// both cases returning "" the same way fileh.cla's rtFhList loop already
// expects. The Pascal-buffer-to-string unpack is fileh_c.cla's own
// rtFhDevListNext idiom (`s = s + char(peekb(...))`), copied verbatim so
// both lanes build a listed name identically.
func rtFhDevListNext(): string {
    var ci: CInfoPBRec
    var buf: ptr
    var s: string
    var n: int
    var i: int

    buf = ptr(peekl(rtFh68kState + 40))
    ci.ioNamePtr = buf
    ci.ioVRefNum = 0
    ci.ioDirID = peekl(rtFh68kState + 32)
    ci.ioFDirIndex = peekl(rtFh68kState + 36)
    ci.ioACUser = 0
    rtFh68kLastErr = PBGetCatInfoSync(ci, hfsSelGetCatInfo)
    if rtFh68kLastErr != 0 {
        return s
    }
    pokel(rtFh68kState + 36, peekl(rtFh68kState + 36) + 1)
    n = peekb(buf)
    i = 0
    while i < n {
        s = s + char(peekb(buf + 1 + i))
        i = i + 1
    }
    return s
}

// rtFhDevListEnd: no-op -- unlike fileh_c.cla's own ListEnd (which frees
// a per-listing SerNewPtr'd buffer), this lane's 256-byte scratch buffer
// lives in the state block for the whole program run (allocated once by
// rtFh68kEnsureState, reused by every listing), so there is nothing here
// the getters still need freed out from under them.
func rtFhDevListEnd() {
}

// rtFhDevListFailed: true iff the loop's last ListNext call ended on a
// real OSErr rather than a clean end-of-directory -- rtFh68kLastErr
// still holds whatever ended the loop (ListEnd above touches nothing),
// so this is exactly "nonzero and not fnfErr", matching fileh_c.cla's
// own rc<0-vs-rc==1 distinction on this lane's own OSErr vocabulary.
func rtFhDevListFailed(): bool {
    return rtFh68kLastErr != 0 and rtFh68kLastErr != fnfErr
}

// rtFhDevSetInfo: PBHGetFInfoSync (ioFDirIndex = 0, ioDirID = 0,
// ioVRefNum = 0, ioNamePtr = path) to read the file's current FInfo,
// patch fdType/fdCreator (rtFourCC(UiStrAddr(...)), core.cla's own
// packing, uiscript.cla's own Str255 address helper) and ioFlCrDat/
// ioFlMdDat only when the caller passed a nonzero value (spec %3's own
// "0 = leave unchanged" convention), then PBHSetFInfoSync. GetFInfo
// re-reads ioDirID as an OUTPUT (the file's real parent DirID, the
// controller's dispatch amendment for Task 5) -- the ioDirID = 0
// reset right before Set undoes that so Set is given the same "search
// from default folder + partial path" addressing GetFInfo itself
// accepted, rather than whatever GetFInfo happened to leave behind.
func rtFhDevSetInfo(path: string, ftype: string, fcreator: string, created: int, modified: int): int {
    var hp: HFileParam
    var namePtr: ptr

    namePtr = rtFh68kName(path)
    hp.ioNamePtr = namePtr
    hp.ioVRefNum = 0
    hp.ioFDirIndex = 0
    hp.ioDirID = 0
    rtFh68kLastErr = PBHGetFInfoSync(hp)
    if rtFh68kLastErr != 0 {
        SerDisposePtr(namePtr)
        return rtFh68kLastErr
    }
    hp.fdType = rtFh68kPack4CC(ftype)
    hp.fdCreator = rtFh68kPack4CC(fcreator)
    // final-review wave, Minor 6: same overlong-FourCC guard as
    // rtFhDevCreate above -- fail rather than stamp 0xFFFFFFFF; namePtr
    // is already allocated at this point (rtFh68kName above), so it
    // must be disposed on this path too.
    if hp.fdType == -1 or hp.fdCreator == -1 {
        rtFh68kLastErr = -37
        SerDisposePtr(namePtr)
        return rtFh68kLastErr
    }
    if created != 0 {
        hp.ioFlCrDat = created
    }
    if modified != 0 {
        hp.ioFlMdDat = modified
    }
    hp.ioDirID = 0
    rtFh68kLastErr = PBHSetFInfoSync(hp)
    SerDisposePtr(namePtr)
    return rtFh68kLastErr
}

// rtFhDevRename: PBHRenameSync's own quirk (task-1-report.md section (c)
// step 7/7b/7d) -- it does NOT accept ioDirID = 0 + a partial pathname
// the way every other rtFhDev* call above does (bdNamErr/dirNFErr); it
// needs ioNamePtr = the item's BARE LEAF NAME (no colons) and ioDirID =
// the item's REAL containing-folder DirID. That DirID is exactly what
// rtFhDevStat's own PBGetCatInfoSync already fetched and stashed at
// +44, so this reuses the stat (which also leaves rtFh68kLastErr set on
// failure, the value returned here) rather than repeating the lookup.
// The leaf name is rtFh68kLeafName(path) (everything after the last
// ':', or the whole string if none).
func rtFhDevRename(path: string, newName: string): int {
    var hp: HIOParamRename
    var leafPtr: ptr
    var newPtr: ptr

    if not rtFhDevStat(path) {
        return rtFh68kLastErr
    }

    leafPtr = rtFh68kName(rtFh68kLeafName(path))
    newPtr = rtFh68kName(newName)
    hp.ioNamePtr = leafPtr
    hp.ioVRefNum = 0
    hp.ioMisc = newPtr
    hp.ioDirID = peekl(rtFh68kState + 44)
    rtFh68kLastErr = PBHRenameSync(hp)
    SerDisposePtr(newPtr)
    SerDisposePtr(leafPtr)
    return rtFh68kLastErr
}

// rtFhDevMove: PBCatMoveSync, ioDirID = 0 + partial path in ioNamePtr,
// ioNewName = the destination folder's own (possibly partial) path,
// ioNewDirID = 0 -- task-1-report.md section (c) step 8, confirmed
// working with the ordinary ioDirID = 0 convention (unlike Rename).
func rtFhDevMove(path: string, dirPath: string): int {
    var cm: CMovePBRec
    var namePtr: ptr
    var dirPtr: ptr

    namePtr = rtFh68kName(path)
    dirPtr = rtFh68kName(dirPath)
    cm.ioNamePtr = namePtr
    cm.ioVRefNum = 0
    cm.ioNewName = dirPtr
    cm.ioNewDirID = 0
    cm.ioDirID = 0
    rtFh68kLastErr = PBCatMoveSync(cm, hfsSelCatMove)
    SerDisposePtr(dirPtr)
    SerDisposePtr(namePtr)
    return rtFh68kLastErr
}

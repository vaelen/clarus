external func UiFrontWindow(): ptr = trap 0xA924
external func UiNewWindow(wStorage: ptr, boundsRect: ptr, title: ptr, visible: bool, procId: word, behind: ptr, goAwayFlag: bool, refCon: int): ptr = trap 0xA913
external func UiShowWindow(theWindow: ptr) = trap 0xA915
external func UiDisposeWindow(theWindow: ptr) = trap 0xA914
external func UiSetWRefCon(theWindow: ptr, data: int) = trap 0xA918
external func UiGetWRefCon(theWindow: ptr): int = trap 0xA917
external func UiSetWTitle(theWindow: ptr, title: ptr) = trap 0xA91A
external func UiGetWTitle(theWindow: ptr, title: ptr) = trap 0xA919
external func UiSelectWindow(theWindow: ptr) = trap 0xA91F
external func UiDragWindow(theWindow: ptr, startPt: int, boundsRect: ptr) = trap 0xA925
external func UiGrowWindow(theWindow: ptr, startPt: int, bBox: ptr): int = trap 0xA92B
external func UiSizeWindow(theWindow: ptr, w: word, h: word, fUpdate: bool) = trap 0xA91D
external func UiZoomWindow(theWindow: ptr, partCode: word, front: bool) = trap 0xA83A
external func UiTrackBox(theWindow: ptr, thePt: int, partCode: word): bool = trap 0xA83B
external func UiTrackGoAway(theWindow: ptr, thePt: int): bool = trap 0xA91E

// apply_zoom (:2991-3096, SetRect/EraseRect/InvalRect/EqualRect), rt_ui_
// handle_update (:2760-2937, BeginUpdate/EndUpdate/DrawGrowIcon/ClipRect/
// SetClip/GetClip/NewRgn/DisposeRgn/FrameRect -- the RTUI_BUTTON default-
// outline arm only; RTUI_LABEL/FIELD/TEXTVIEW/POPUP/TABLE arms are TE/List
// Manager or out-of-scope-kind territory, excluded per ui.cla's rule),
// rt_ui_canvas_* ops (:5596-5723, MoveTo/LineTo/SetRect/EraseRect/
// FrameRect/FillRect/FrameOval/FillOval/DrawString/PtInRect via rt_ui_
// canvas_hit :3099-3110), rt_ui_flush_buffered_canvases (:2177-2196,
// CopyBits). InsetRect backs rt_ui_draw_default_outline (:2754) and rt_ui_
// handle_mouse_down's drag-bounds inset (:3467).
external func UiMoveTo(h: word, v: word) = trap 0xA893
external func UiLineTo(h: word, v: word) = trap 0xA891
external func UiSetRect(r: ptr, left: word, top: word, right: word, bottom: word) = trap 0xA8A7
external func UiInsetRect(r: ptr, dh: word, dv: word) = trap 0xA8A9
external func UiEqualRect(rect1: ptr, rect2: ptr): bool = trap 0xA8A6
external func UiEraseRect(r: ptr) = trap 0xA8A3
external func UiFrameRect(r: ptr) = trap 0xA8A1
external func UiFillRect(r: ptr, pat: ptr) = trap 0xA8A5
external func UiInvalRect(badRect: ptr) = trap 0xA928
external func UiValidRect(goodRect: ptr) = trap 0xA92A
external func UiPtInRect(pt: int, r: ptr): bool = trap 0xA8AD
external func UiFrameOval(r: ptr) = trap 0xA8B7
external func UiFillOval(r: ptr, pat: ptr) = trap 0xA8BB
external func UiPenSize(width: word, height: word) = trap 0xA89B
external func UiPenNormal() = trap 0xA89E
external func UiFrameRoundRect(r: ptr, ovalWidth: word, ovalHeight: word) = trap 0xA8B0
external func UiDrawString(s: ptr) = trap 0xA884
external func UiCopyBits(srcBits: ptr, dstBits: ptr, srcRect: ptr, dstRect: ptr, mode: word, maskRgn: ptr) = trap 0xA8EC
external func UiNewRgn(): ptr = trap 0xA8D8
external func UiDisposeRgn(rgn: ptr) = trap 0xA8D9
external func UiClipRect(r: ptr) = trap 0xA87B
external func UiSetClip(rgn: ptr) = trap 0xA879
external func UiGetClip(rgn: ptr) = trap 0xA87A
external func UiDrawGrowIcon(theWindow: ptr) = trap 0xA904
external func UiBeginUpdate(theWindow: ptr) = trap 0xA922
external func UiEndUpdate(theWindow: ptr) = trap 0xA923
// UiTextBox (TextEdit.h's classic `TextBox(const void *text, long length,
// const Rect *box, short just)`, trap 0xA9CE, PASCAL convention -- Task 7
// Step 1 review fix): despite living in TextEdit.h and sharing the
// TETextBox alias, this is a STATELESS static text-layout-and-draw
// primitive -- it takes raw bytes+length+rect+justification directly, with
// NO TEHandle/live TE object involved at all, unlike every other TE call
// this module's header comment excludes (TEDispose/TEActivate/TEKey/...,
// which all operate on a live TEHandle a field/textview widget owns).
// rt_ui_handle_update's RTUI_LABEL draw branch (rt_ui.c:2787-2790) calls it
// exactly this way: `TETextBox(s + 1, s[0], &inst->rects[i], teJustLeft)`
// to draw a LABEL's own caption text -- LABEL is one of this slice's four
// in-scope widget kinds, so this call is genuinely in-scope even though it
// was mistakenly swept into Step 1's original TE-Manager exclusion list
// (caught during Step 2's dispatch prep, added directly rather than via a
// second Step-1 round-trip since it's a pure addition to an otherwise-
// unmodified file). Justification constants (TextEdit.h): teJustLeft=0,
// teJustCenter=1, teJustRight=-1 -- rt_ui.c always passes teJustLeft; no
// Clarus `const` declared here, callers pass the literal `0`.
external func UiTextBox(text: ptr, length: int, box: ptr, just: word) = trap 0xA9CE

// ---- Canvas offscreen GrafPort management (Ch11) ----
// rt_ui_canvas_make/rt_ui_canvas_dispose (:2122-2159): a canvas's own
// off-screen GrafPort (RTUI_BUFFERED flag) is OpenPort'd/ClosePort'd, sized
// and re-origined once at creation -- distinct from ui.cla's UiSetPort/
// UiGetPort save/restore pattern, which every drawing entry point uses to
// self-assert the CURRENT port per rt_ui.h's PORT DISCIPLINE RULE.
external func UiOpenPort(port: ptr) = trap 0xA86F
external func UiClosePort(port: ptr) = trap 0xA87D
external func UiPortSize(width: word, height: word) = trap 0xA876
external func UiSetOrigin(h: word, v: word) = trap 0xA878
external func UiSetPortBits(bm: ptr) = trap 0xA875

// ================================================================
// Task 7 Step 3: function bodies. Ported directly by the controlling
// session (not a further-dispatched subagent -- see task-7-report.md's
// Step 2 entry for why). Everything below reads/writes RtUiWinst/
// RtUiCanvasBuf (runtime/clarus/uidesc.cla, Step 2) exclusively through
// that file's own accessors/constants -- never a raw C struct, since none
// exists (rt_ui.c is dropped from the build under --uiport).
// ================================================================

// ---- rt_ui.h's RTUI_* constants this slice's code needs (mirrored here
// since rt_ui.h is a C header, never included by Clarus source; every
// value cited to its own #define). FIELD=4/TEXTVIEW=5/POPUP=6/TABLE=7
// have no `const` here -- rtUiMakeWidgets' fail-closed gate (below) is the
// ONE place that would need them, and it never needs to name them
// individually (its `else` arm already catches "anything not
// button/check/label/canvas"). ----
const rtUiKindButton: int = 0
const rtUiKindCheck: int = 1
const rtUiKindCanvas: int = 2
const rtUiKindLabel: int = 3
// FIELD/TEXTVIEW (Task 8): the two kinds this slice's fail-closed gate
// (rtUiMakeWidgets, below) now creates for real.
const rtUiKindField: int = 4
const rtUiKindTextview: int = 5
// rtUiKindPopup=6/rtUiKindTable=7 (Task 9): declared in uitable.cla, not
// here -- whole-program visibility (docs/clarus-language-reference.md:736)
// makes the splice order irrelevant; this file's own rtUiKindHeight/
// rtUiKindWidth/rtUiLayout/rtUiMakeWidgets bodies below reference them by
// name.

const rtUiAtXY: int = 0
const rtUiAtNext: int = 1
const rtUiAtRight: int = 2
const rtUiAtAuto: int = 3

const rtUiFillBoth: int = 1

const rtUiFlagDefault: int = 1
const rtUiFlagCancel: int = 2
const rtUiFlagBuffered: int = 4
// SCROLL_V/SCROLL_H (rt_ui.h): textview-only -- live as of Task 8.
const rtUiFlagScrollV: int = 8
const rtUiFlagScrollH: int = 16

const rtUiPropCaption: int = 0
const rtUiPropText: int = 1
const rtUiPropEnabled: int = 2
const rtUiPropChecked: int = 3
const rtUiPropSelected: int = 4
const rtUiPropWidth: int = 5
const rtUiPropHeight: int = 6

const rtUiWevClick: int = 0
const rtUiWevChange: int = 1
const rtUiWevDrag: int = 2
// RTUI_WEV_ENTER (rt_ui.h): field-only, Return/Enter pressed while focused
// -- no character is inserted (Task 8).
const rtUiWevEnter: int = 3

// Layout/size constants (rt_ui.c:144-219, the button/check/label/canvas
// subset -- field/textview/popup/table's own H/W constants have no
// `const` here for the same reason as the kind constants above).
const rtUiGap: int = 8
const rtUiAutoMargin: int = 12
const rtUiScreenMargin: int = 2
const rtUiButtonH: int = 20
const rtUiCheckH: int = 16
const rtUiLabelH: int = 16
const rtUiCanvasH: int = 100
const rtUiButtonW: int = 80
const rtUiCheckW: int = 90
const rtUiLabelW: int = 150
const rtUiCanvasW: int = 200
const rtUiScrollbarW: int = 15

// field/textview natural size + labeled-field lane width (rt_ui.c:180-195,
// Task 8). RTUI_FIELD_BOX_W = RTUI_FIELD_W - RTUI_FIELD_LABEL_W = 130.
const rtUiFieldH: int = 20
const rtUiFieldW: int = 200
const rtUiTextviewH: int = 100
const rtUiTextviewW: int = 200
const rtUiFieldLabelW: int = 70
const rtUiFieldBoxW: int = 130
const rtUiTeFrameInset: int = 3
const rtUiTeNowrapW: int = 2000
const rtUiHscrollStep: int = 8
const rtUiFieldTextMax: int = 255
const rtUiTeMax: int = 32000

// pushButProc/checkBoxProc (Universal Interfaces' ControlDefinitions.h --
// standard Control Manager procID constants, Inside Macintosh I): the
// `procId` NewControl argument selecting a button vs. a checkbox CDEF.
const rtUiProcIdPushButton: int = 0
const rtUiProcIdCheckBox: int = 1
// scrollBarProc (ControlDefinitions.h/Multiverse.h:12048, Task 8): the
// standard scrollbar CDEF's procID -- a textview's own V/H scrollbar
// controls (rtUiMakeWidgets, below).
const rtUiProcIdScrollBar: int = 16

// ================================================================
// Per-instance array-slot accessors (RtUiWinst's ctrls/rects/labels/
// canvases/logicalEnabled fields are raw base ADDRESSES, one array per
// window instance sized to that window's own nWidgets -- not overlay
// records themselves, since overlay records are a FIXED field set, not a
// dynamically-sized array; plain peekl/pokel indexing, same idiom
// RtList's own element access uses internally). Centralized here so every
// caller below spells "the button control for widget i" the same way.
// ================================================================

func rtUiCtrlAt(w: RtUiWinst, i: int): ptr {
    return ptr(peekl(w.ctrls + i * 4))
}

func rtUiSetCtrlAt(w: RtUiWinst, i: int, v: ptr) {
    pokel(w.ctrls + i * 4, int(v))
}

func rtUiRectAt(w: RtUiWinst, i: int): ptr {
    return w.rects + i * rtUiRectSize
}

func rtUiLabelAt(w: RtUiWinst, i: int): ptr {
    return w.labels + i * rtUiLabelSlotSize
}

func rtUiCanvasBufAt(w: RtUiWinst, i: int): ptr {
    return w.canvases + i * rtUiCanvasBufSize
}

// rtUiTeAt/rtUiSetTeAt/rtUiHbarAt/rtUiSetHbarAt (Task 8): same
// per-instance array-slot idiom as rtUiCtrlAt/rtUiSetCtrlAt above, over the
// tes/hbars arrays uidesc.cla's RtUiWinst gained this task.
func rtUiTeAt(w: RtUiWinst, i: int): ptr {
    return ptr(peekl(w.tes + i * 4))
}

func rtUiSetTeAt(w: RtUiWinst, i: int, v: ptr) {
    pokel(w.tes + i * 4, int(v))
}

func rtUiHbarAt(w: RtUiWinst, i: int): ptr {
    return ptr(peekl(w.hbars + i * 4))
}

func rtUiSetHbarAt(w: RtUiWinst, i: int, v: ptr) {
    pokel(w.hbars + i * 4, int(v))
}

func rtUiEnabledAt(w: RtUiWinst, i: int): bool {
    return peekb(w.logicalEnabled + i) != 0
}

func rtUiSetEnabledAt(w: RtUiWinst, i: int, v: bool) {
    if v {
        pokeb(w.logicalEnabled + i, 1)
    } else {
        pokeb(w.logicalEnabled + i, 0)
    }
}

// ================================================================
// Port save/restore scratch (PORT DISCIPLINE RULE, rt_ui.h -- quoted in
// full in ui.cla's own header comment). UiGetPort's real Toolbox
// signature is an OUT-parameter (`pascal void GetPort(GrafPtr *port)`),
// needing the ADDRESS of a ptr-sized slot to write into -- Clarus has no
// address-of operator for a local variable (same restriction Task 7
// report log entry #6 already worked out for `str`), so a genuinely
// fresh scratch slot is allocated, read back, and freed on EVERY call --
// never a shared/global slot, which would break the moment one
// port-save/restore bracket calls another function that ALSO does its
// own port save/restore before the outer one restores (this happens
// constantly here: rtUiOpen's own bracket, a later step, calls
// rtUiMakeWidgets/rtUiLayout, each of which brackets its OWN port
// save/restore around its body).
// rtUiGetPortSaved ALLOCATES: its 4-byte GetPort scratch slot is a real
// UiNewPtr, which is the heap-jiggle waist (uiscript.cla's
// rtUiJiggleTick) and a Memory Manager allocation in any case. Never
// call it while holding a master pointer -- re-derive after, or save the
// port first. (uitext.cla's rtUiTeWidestLine got this wrong; see there.)
func rtUiGetPortSaved(): ptr {
    var slot: ptr
    var p: ptr

    slot = UiNewPtr(4)
    UiGetPort(slot)
    p = ptr(peekl(slot))
    UiDisposePtr(slot)
    return p
}

// ================================================================
// rt_ui_kind_height/rt_ui_kind_width (rt_ui.c:725-756) -- every widget
// kind now has a real case (Task 9 adds POPUP/TABLE, uitable.cla's own
// rtUiKindPopup/rtUiKindTable/rtUiPopupH/rtUiPopupW/rtUiTableH/rtUiTableW);
// the `else` fallback mirrors the C reference's own `default: return
// RTUI_CHECK_H/W` exactly -- truly unreachable now (every widgetKind the
// grammar allows has its own case), kept for fidelity.
// ================================================================

func rtUiKindHeight(kind: int): int {
    switch kind {
    case rtUiKindButton {
        return rtUiButtonH
    }
    case rtUiKindCheck {
        return rtUiCheckH
    }
    case rtUiKindLabel {
        return rtUiLabelH
    }
    case rtUiKindCanvas {
        return rtUiCanvasH
    }
    case rtUiKindField {
        return rtUiFieldH
    }
    case rtUiKindTextview {
        return rtUiTextviewH
    }
    case rtUiKindPopup {
        return rtUiPopupH
    }
    case rtUiKindTable {
        return rtUiTableH
    }
    else {
        return rtUiCheckH
    }
    }
    return rtUiCheckH
}

func rtUiKindWidth(kind: int): int {
    switch kind {
    case rtUiKindButton {
        return rtUiButtonW
    }
    case rtUiKindCheck {
        return rtUiCheckW
    }
    case rtUiKindLabel {
        return rtUiLabelW
    }
    case rtUiKindCanvas {
        return rtUiCanvasW
    }
    case rtUiKindField {
        return rtUiFieldW
    }
    case rtUiKindTextview {
        return rtUiTextviewW
    }
    case rtUiKindPopup {
        return rtUiPopupW
    }
    case rtUiKindTable {
        return rtUiTableW
    }
    else {
        return rtUiCheckW
    }
    }
    return rtUiCheckW
}

// ================================================================
// rt_ui_pstrcpy (rt_ui.c:918-925): copies src's Pascal-string bytes into
// dst (assumed to have room -- every caller targets a 256-byte labels[]
// slot). src == ptr(0) copies a zero-length string, matching the C
// reference's own `n = src ? src[0] : 0` null-safety (rt_ui.c's own
// `kEmptyPStr` fallback becomes unnecessary here for exactly this reason
// -- this function already treats an absent caption as empty).
// ================================================================

func rtUiPstrcpy(dst: ptr, src: ptr) {
    var n: int

    if src == ptr(0) {
        pokeb(dst, 0)
        return
    }
    n = peekb(src)
    UiBlockMoveData(src + 1, dst + 1, n)
    pokeb(dst, n)
}

// ================================================================
// rt_ui_layout (rt_ui.c:789-926) -> rtUiLayout. Task 8 added the RTUI_
// FIELD/RTUI_TEXTVIEW branch (labeled-field width calc, flushR/flushB
// fill-edge adjustment, rtUiTeRelayout call, uitext.cla). Task 9 adds the
// RTUI_TABLE branch (rtUiTableRelayout call, uitable.cla) -- POPUP needs no
// branch of its own here: it has no Control Manager backing (ctrls[i]
// stays ptr(0), the RTUI_POPUP_CDEF gate, uitable.cla's own header note),
// so it falls through to the plain `else if ctrl != ptr(0)` tail below and
// that guard simply never fires for it, exactly like the C reference's own
// rt_ui_layout (no `wd->kind == RTUI_POPUP` case exists there either --
// checked directly, rt_ui.c:892-907). PORT DISCIPLINE RULE: GetPort/SetPort
// self-assert + restore around the whole function body.
// ================================================================

func rtUiLayout(inst: ptr) {
    var w: RtUiWinst
    var winIdx: int
    var savedPort: ptr
    var contentW: int
    var contentH: int
    var prevLeft: int
    var prevRight: int
    var prevBottom: int
    var n: int
    var i: int
    var kind: int
    var atKind: int
    var flags: int
    var x: int
    var y: int
    var ww: int
    var hh: int
    var widthIsFill: bool
    var fillBoth: bool
    var flushR: bool
    var flushB: bool
    var ctrl: ptr
    var ctrlMp: ptr

    w = RtUiWinst(inst)
    winIdx = w.winIdx

    savedPort = rtUiGetPortSaved()
    UiSetPort(w.wp)

    // wp_content_width/wp_content_height (rt_ui.c:775-787): a WindowPtr's
    // own embedded GrafPort.portRect IS the window's content rect in
    // classic Mac OS (content-local coords always start at (0,0)) -- read
    // directly (Task 7 report log entry #7: portRect at GrafPort offset
    // 16, fields top/left/bottom/right at +0/+2/+4/+6 within it, so
    // absolute offsets 16/18/20/22 off the WindowPtr itself, which IS a
    // GrafPtr since GrafPort is WindowRecord's first field at offset 0).
    contentW = peekw(w.wp + 22) - peekw(w.wp + 18)
    contentH = peekw(w.wp + 20) - peekw(w.wp + 16)
    prevLeft = 0
    prevRight = 0
    prevBottom = 0

    n = uidWinNWidgets(winIdx)
    i = 0
    while i < n {
        kind = uidWidgetKind(winIdx, i)
        atKind = uidWidgetAtKind(winIdx, i)
        hh = rtUiKindHeight(kind)

        switch atKind {
        case rtUiAtRight {
            x = prevRight + rtUiGap
        }
        case rtUiAtNext {
            x = prevLeft
        }
        case rtUiAtAuto {
            x = rtUiAutoMargin
        }
        else {
            x = uidWidgetX(winIdx, i)
        }
        }

        if uidWidgetYIsBottom(winIdx, i) or atKind == rtUiAtAuto {
            y = prevBottom + rtUiGap
        } else {
            y = uidWidgetY(winIdx, i)
        }

        flags = uidWidgetFlags(winIdx, i)
        widthIsFill = uidWidgetWidthIsFill(winIdx, i)
        fillBoth = uidWidgetFillBoth(winIdx, i)
        // Classic flush scrollbars (rt_ui.c:863-873, Task 8): a fill-to-
        // edge textview with a scrollbar on that edge puts the bar IN the
        // window frame rather than floating RTUI_GAP px inside it.
        flushR = false
        if kind == rtUiKindTextview and (flags & rtUiFlagScrollV) != 0 and (widthIsFill or fillBoth) {
            flushR = true
        }
        flushB = false
        if kind == rtUiKindTextview and (flags & rtUiFlagScrollH) != 0 and fillBoth {
            flushB = true
        }
        if widthIsFill or fillBoth {
            if flushR {
                ww = contentW - x + 1
            } else {
                ww = contentW - x - rtUiGap
            }
        } else if kind == rtUiKindField and peekb(rtUiLabelAt(w, i)) > 0 {
            // Labeled field: `width:` is the EDIT BOX; the label lane is
            // added on top (rt_ui.c:876-880).
            if uidWidgetWidth(winIdx, i) == 0 {
                ww = rtUiFieldBoxW + rtUiFieldLabelW
            } else {
                ww = uidWidgetWidth(winIdx, i) + rtUiFieldLabelW
            }
        } else if kind == rtUiKindPopup and peekb(rtUiLabelAt(w, i)) > 0 {
            // Labeled popup: mirrors the labeled-field arm above -- `width:`
            // is the POPUP BOX; the label lane is added on top, so
            // rtUiPopupBoxInto's later label-lane subtraction (uitable.cla)
            // can't go negative. No separate box-only default exists for
            // popup (unlike rtUiFieldBoxW/rtUiFieldW), so the zero-width
            // fallback reuses the same kind-width default as the unlabeled
            // case below.
            if uidWidgetWidth(winIdx, i) == 0 {
                ww = rtUiKindWidth(kind)
            } else {
                ww = uidWidgetWidth(winIdx, i) + rtUiFieldLabelW
            }
        } else if uidWidgetWidth(winIdx, i) == 0 {
            ww = rtUiKindWidth(kind)
        } else {
            ww = uidWidgetWidth(winIdx, i)
        }
        if ww < 0 {
            ww = 0
        }
        if fillBoth {
            if flushB {
                hh = contentH - y + 1
            } else {
                hh = contentH - y - rtUiGap
            }
            if hh < 0 {
                hh = 0
            }
        }

        UiSetRect(rtUiRectAt(w, i), x, y, x + ww, y + hh)

        if kind == rtUiKindField or kind == rtUiKindTextview {
            // Derives the TE view/dest rect (and, for a textview, moves/
            // sizes its own scrollbar control(s)) from the rect just SetRect
            // above -- covers both the initial layout and any later resize
            // re-layout (uitext.cla).
            rtUiTeRelayout(inst, i)
        } else if kind == rtUiKindTable {
            // Same "derive from the rect just SetRect above" pattern as the
            // TE branch just above (Task 9, uitable.cla).
            rtUiTableRelayout(inst, i)
        } else {
            ctrl = rtUiCtrlAt(w, i)
            if ctrl != ptr(0) {
                ctrlMp = UiHandleDeref(ctrl)
                UiMoveControl(ctrl, x, y)
                UiSizeControl(ctrl, ww, hh)
            }
        }

        prevLeft = x
        prevRight = x + ww
        prevBottom = y + hh
        i = i + 1
    }

    UiSetPort(savedPort)
}

// ================================================================
// rt_ui_make_widgets (rt_ui.c:1175-1421, IN-SCOPE PORTION: BUTTON/CHECK/
// LABEL/CANVAS from Task 7, FIELD/TEXTVIEW added Task 8, POPUP/TABLE added
// Task 9) -> rtUiMakeWidgets. THE fail-closed gate lives here (Task 7
// report log entry #2): every widget kind the language grammar allows now
// has an explicit case (docs/clarus-language-reference.md:1489-1490's own
// widgetKind production: button/field/textview/check/popup/table/canvas/
// label, all eight); the `else` arm is defensive only (matching
// rtUiKindHeight/rtUiKindWidth's own now-unreachable fallback, above) --
// nothing downstream of this gate (layout, property get/set, click/update
// dispatch) needs its own fail-closed arm, since no OTHER kind can ever
// reach an opened window.
// POPUP (rt_ui.c:1248-1354, RTUI_POPUP_CDEF branch excluded -- see
// uitable.cla's own header note): a System 6 manual popup, never inserted
// into the bar -- items are the bound enum's labels (uidWinFormOff +
// uidFormFindFieldIndex, uidesc.cla), read off the window's own `form`; no
// form, or no matching bind, leaves the menu (and this popup) empty rather
// than crashing (rt_ui.h's defensive contract; the language reference's own
// build-time check, "a popup declared without binds: is rejected", is what
// actually prevents an unbound popup from being declared).
// TABLE (rt_ui.c:1356-1404): created against the same zero placeholder
// rect every other widget kind uses here -- rtUiLayout's very next pass
// (rtUiTableRelayout) gives it its real view rect/cell width; row COUNT
// starts at 0 too, populated once layout has run (rtUiOpen's own
// rtUiTableSyncOne loop, right after its own rtUiLayout call) rather than
// here. cellSize.h is 1, NOT 0 (LNew's own internal geometry setup divides
// BY it immediately, at creation time -- a 0 crashes before relayout ever
// gets a chance to fix it up). drawIt (5th bool) is FALSE, same
// "don't draw yet" reasoning as every other widget's placeholder creation
// -- but List Manager's drawIt ALSO sets the list's persistent
// lDrawingModeOff flag, which stays off permanently (LUpdate never calls
// the LDEF again for content OR the hilite toggle) until UiLSetDrawingMode
// turns it back on, right after creation (manual-gate finding, ported
// verbatim from the C reference's own comment).
// contrlRfCon poke (rt_ui.c:1409's `(*ctrl)->contrlRfCon = i`): Task 7
// report log entry #8, ControlRecord.contrlRfCon at offset 36, a plain
// native-order 4-byte store (`pokel`) -- this is real Toolbox struct
// memory (not blob data), so native order is correct, not uidesc.cla's
// big-endian `uidI32` (which is only for the blob's own portable bytes).
// Task 8: the generic poke is now guarded `kind != rtUiKindTextview`
// (rt_ui.c:1410's own `wd->kind != RTUI_TEXTVIEW` guard) -- a textview's
// OWN ctrls[i] (its vertical scrollbar) already got its own tagged
// contrlRfCon (0x8000|i) directly inside the TEXTVIEW case, below; letting
// the generic poke run afterward would stomp that tag back to a plain `i`.
// PORT DISCIPLINE RULE: GetPort/SetPort self-assert + restore.
// ================================================================

func rtUiMakeWidgets(inst: ptr) {
    var w: RtUiWinst
    var winIdx: int
    var savedPort: ptr
    var placeholder: ptr
    var emptyStr: ptr
    var n: int
    var i: int
    var kind: int
    var cap: ptr
    var ctrl: ptr
    var ctrlMp: ptr
    var teH: ptr
    var teMp: ptr
    var hb: ptr
    var hbMp: ptr
    var flags: int
    var mh: ptr
    var formOff: int
    var fieldIndex: int
    var layoutOff: int
    var enumCount: int
    var enumLabelsOff: int
    var b: int
    var lh: ptr
    var dataBoundsRect: ptr
    var rowH: int
    var cellSizePacked: int
    var stubH: ptr
    var tableOff: int

    w = RtUiWinst(inst)
    winIdx = w.winIdx

    savedPort = rtUiGetPortSaved()
    UiSetPort(w.wp)

    placeholder = UiNewPtr(rtUiRectSize)
    UiSetRect(placeholder, 0, 0, 0, 0)
    emptyStr = UiNewPtr(1)
    pokeb(emptyStr, 0)

    n = uidWinNWidgets(winIdx)
    i = 0
    while i < n {
        kind = uidWidgetKind(winIdx, i)
        cap = uidWidgetCaption(winIdx, i)
        if cap == ptr(0) {
            cap = emptyStr
        }

        switch kind {
        case rtUiKindButton {
            ctrl = UiNewControl(w.wp, placeholder, cap, true, 0, 0, 1, rtUiProcIdPushButton, 0)
            rtUiSetCtrlAt(w, i, ctrl)
        }
        case rtUiKindCheck {
            ctrl = UiNewControl(w.wp, placeholder, cap, true, 0, 0, 1, rtUiProcIdCheckBox, 0)
            rtUiSetCtrlAt(w, i, ctrl)
        }
        case rtUiKindLabel, rtUiKindCanvas {
            rtUiSetCtrlAt(w, i, ptr(0))
            rtUiPstrcpy(rtUiLabelAt(w, i), uidWidgetCaption(winIdx, i))
        }
        case rtUiKindField {
            // `label:` reuses the labels[]/TETextBox lane RTUI_LABEL
            // already has (rt_ui.c:1211-1218); the field itself is a TE,
            // not a Control Manager widget.
            rtUiSetCtrlAt(w, i, ptr(0))
            rtUiPstrcpy(rtUiLabelAt(w, i), uidWidgetCaption(winIdx, i))
            teH = UiTENew(placeholder, placeholder)
            rtUiSetTeAt(w, i, teH)
        }
        case rtUiKindTextview {
            teH = UiTENew(placeholder, placeholder)
            rtUiSetTeAt(w, i, teH)
            // fix-hbar: keep the caret visible on typing/arrow-keys/
            // clicks, both axes (rt_ui.c:1221-1225).
            UiTEAutoView(true, teH)
            flags = uidWidgetFlags(winIdx, i)
            if (flags & rtUiFlagScrollV) != 0 {
                ctrl = UiNewControl(w.wp, placeholder, emptyStr, true, 0, 0, 0, rtUiProcIdScrollBar, 0)
                rtUiSetCtrlAt(w, i, ctrl)
                // High bit tags this control as a textview's scrollbar (not
                // a plain widget index), rt_ui.c:1229-1235 -- set directly
                // here, bypassing the generic poke below (guarded off for
                // TEXTVIEW).
                ctrlMp = UiHandleDeref(ctrl)
                pokel(ctrlMp + 36, 0x8000 | i)
            } else {
                rtUiSetCtrlAt(w, i, ptr(0))
            }
            if (flags & rtUiFlagScrollH) != 0 {
                // crOnly = -1: no word wrap, lines break only at CR
                // (rt_ui.c:1240, TERec.crOnly @ offset 72 -- see uitext.cla
                // header comment for the full TERec offset derivation).
                teMp = UiHandleDeref(teH)
                pokew(teMp + rtUiTeCrOnly, -1)
                hb = UiNewControl(w.wp, placeholder, emptyStr, true, 0, 0, 0, rtUiProcIdScrollBar, 0)
                rtUiSetHbarAt(w, i, hb)
                hbMp = UiHandleDeref(hb)
                pokel(hbMp + 36, 0xC000 | i)
            } else {
                rtUiSetHbarAt(w, i, ptr(0))
            }
        }
        case rtUiKindPopup {
            rtUiSetCtrlAt(w, i, ptr(0))
            rtUiPstrcpy(rtUiLabelAt(w, i), uidWidgetCaption(winIdx, i))
            rtUiSetPopupSelAt(w, i, 0)
            mh = UiNewMenu(rtUiPopupMenuIdBase + i, rtUiEmptyPStrGet())
            formOff = uidWinFormOff(winIdx)
            fieldIndex = uidFormFindFieldIndex(formOff, i)
            if fieldIndex != -1 {
                layoutOff = uidFormLayoutOff(formOff)
                enumCount = uidFieldEnumCount(layoutOff, fieldIndex)
                enumLabelsOff = uidFieldEnumLabelsOff(layoutOff, fieldIndex)
                b = 0
                while b < enumCount {
                    // AppendMenu a one-char placeholder item, then overwrite
                    // its text with SetMenuItemText -- an enum label's own
                    // bytes might contain an AppendMenu metacharacter with
                    // no escaping intended (rt_ui.c:1280-1293).
                    UiAppendMenuStr(mh, "x")
                    UiSetMenuItemText(mh, b + 1, uidEnumLabel(enumLabelsOff, b))
                    b = b + 1
                }
            }
            UiInsertMenu(mh, -1) // NEVER 0 (the bar) -- rt_ui.c:1300's own header note
            rtUiSetPopupAt(w, i, mh)
        }
        case rtUiKindTable {
            rtUiSetCtrlAt(w, i, ptr(0))
            rowH = rtUiTableRowH()
            cellSizePacked = (rowH << 16) | 1
            dataBoundsRect = UiNewPtr(rtUiRectSize)
            UiSetRect(dataBoundsRect, 0, 0, 1, 0) // 1 LM column (see uitable.cla's LDEF header note), 0 rows
            lh = UiLNew(placeholder, dataBoundsRect, cellSizePacked, 0, w.wp, false, false, false, true)
            UiDisposePtr(dataBoundsRect)
            if lh == ptr(0) {
                rtPanic("out of memory")
            }
            rtUiSetListAt(w, i, lh)
            pokeb(UiHandleDeref(lh) + rtUiListSelFlags, rtUiLOnlyOne) // single-selection table
            tableOff = uidWidgetTableOff(winIdx, i)
            pokel(UiHandleDeref(lh) + rtUiListRefCon, tableOff) // the LDEF's only state -- see rtUiLdefDraw
            stubH = rtUiMakeLdefStub()
            pokel(UiHandleDeref(lh) + rtUiListDefProc, int(stubH))
            UiLSetDrawingMode(true, lh) // see this function's own header note
        }
        else {
            log("uiport: unrecognized widget kind")
            quit 1
        }
        }

        ctrl = rtUiCtrlAt(w, i)
        if ctrl != ptr(0) and kind != rtUiKindTextview {
            ctrlMp = UiHandleDeref(ctrl)
            pokel(ctrlMp + 36, i)
        }
        i = i + 1
    }

    UiDisposePtr(emptyStr)
    UiDisposePtr(placeholder)
    UiSetPort(savedPort)
}

// ================================================================
// Widget property get/set surface (rt_ui.c:5339-5581). Every Str255
// in/out parameter is `ptr`, never `str` (Task 7 report log entry #6).
// FIELD+TEXT (rtUiWidgetSetStr/GetStr) and TEXTVIEW (rtUiWidgetGetText/
// SetText) are live as of Task 8 (rt_ui.c:5364-5454). rtUiWidgetSetInt/
// GetInt's popup/table SELECTED cases stay OMITTED (Task 9) -- the C
// reference's own kind checks would simply never match, since neither
// kind can exist post-gate yet. Trace calls (rtUiTraceSetStr/SetBool/
// SetInt) are uiscript.cla's -- called here by name per the whole-
// program-visibility rule (docs/clarus-language-reference.md:736); TE
// field/text calls (UiTESetText/UiTECalText/...) are declared in
// uitext.cla, same rule.
// ================================================================

func rtUiWidgetSetStr(instV: ptr, wIdx: int, prop: int, s: ptr) {
    var w: RtUiWinst
    var winIdx: int
    var savedPort: ptr
    var kind: int
    var ctrl: ptr
    var te: ptr
    var len: int

    w = RtUiWinst(instV)
    winIdx = w.winIdx
    savedPort = rtUiGetPortSaved()
    UiSetPort(w.wp)
    kind = uidWidgetKind(winIdx, wIdx)
    rtUiTraceSetStr(uidWinName(winIdx), uidWidgetName(winIdx, wIdx), prop, s)
    ctrl = rtUiCtrlAt(w, wIdx)
    te = rtUiTeAt(w, wIdx)
    if kind == rtUiKindLabel and prop == rtUiPropText {
        rtUiPstrcpy(rtUiLabelAt(w, wIdx), s)
        UiInvalRect(rtUiRectAt(w, wIdx))
        // Live paint (live-log phase): same sync draw as
        // rtUiWidgetSetText's, in the update path's own TextBox form
        // (TETextBox erases the rect first, so shorter text leaves no
        // residue). Draw the STORED pstring, not `s` -- identical
        // bytes, but it is what the update path itself would draw.
        UiTextBox(rtUiLabelAt(w, wIdx) + 1, peekb(rtUiLabelAt(w, wIdx)), rtUiRectAt(w, wIdx), 0)
        UiValidRect(rtUiRectAt(w, wIdx))
    } else if kind == rtUiKindButton and prop == rtUiPropCaption and ctrl != ptr(0) {
        UiSetControlTitle(ctrl, s)
    } else if kind == rtUiKindField and prop == rtUiPropText and te != ptr(0) {
        // Str255 is already capped at 255 bytes structurally, so
        // rtUiTeMutated's own clamp is a no-op safety net here, not a
        // real truncation path (rt_ui.c:5364-5374).
        if s != ptr(0) {
            len = peekb(s)
        } else {
            len = 0
        }
        UiTESetText(s + 1, len, te)
        UiTECalText(te)
        UiInvalRect(UiHandleDeref(te) + rtUiTeViewRect)
        rtUiTeMutated(instV, wIdx, false) // PROGRAMMATIC set -- no trace/event
    }
    UiSetPort(savedPort)
}

// rtUiWidgetGetStr (rt_ui.c:5381-5399): fill-in-place read; a non-matching
// kind/prop writes a length-0 Pascal string. The RTUI_LABEL arm
// (native-gaps-cleanup Task 5) reads the SAME labels[] slot
// rtUiWidgetSetStr's RTUI_LABEL arm writes (rtUiPstrcpy(rtUiLabelAt(w,
// wIdx), s), above) -- a label has no TE handle/control title storage of
// its own, just this per-instance Pascal-string slot, so the get mirrors
// the set exactly via the same rtUiPstrcpy helper, copied the other way.
func rtUiWidgetGetStr(instV: ptr, wIdx: int, prop: int, dst255: ptr) {
    var w: RtUiWinst
    var kind: int
    var te: ptr
    var teMp: ptr
    var len: int
    var hText: ptr

    w = RtUiWinst(instV)
    kind = uidWidgetKind(w.winIdx, wIdx)
    pokeb(dst255, 0)
    if kind == rtUiKindLabel and prop == rtUiPropText {
        rtUiPstrcpy(dst255, rtUiLabelAt(w, wIdx))
    } else if kind == rtUiKindField and prop == rtUiPropText {
        te = rtUiTeAt(w, wIdx)
        if te != ptr(0) {
            teMp = UiHandleDeref(te)
            len = peekw(teMp + rtUiTeTeLength)
            if len > 255 {
                len = 255 // defensive only -- rtUiTeMutated already keeps a field's own content <=255
            }
            hText = ptr(peekl(teMp + rtUiTeHText))
            UiBlockMoveData(UiHandleDeref(hText), dst255 + 1, len)
            pokeb(dst255, len)
        }
    }
}

// rtUiWidgetGetText/rtUiWidgetSetText (rt_ui.c:5401-5454): TEXTVIEW's
// RTUI_PROP_TEXT, bridged via text.cla's rtTextFromBytes/rtTextToBytes.
// No RT_MAC_TEST trace line (see the C reference's own comment: no `T SET`
// entry exists for an rt_text value; SetText's own mutation-funnel call
// already traces `change` when it fires).
func rtUiWidgetGetText(instV: ptr, wIdx: int, out: ptr) {
    var w: RtUiWinst
    var kind: int
    var te: ptr
    var teMp: ptr
    var len: int
    var hText: ptr

    w = RtUiWinst(instV)
    kind = uidWidgetKind(w.winIdx, wIdx)
    te = rtUiTeAt(w, wIdx)
    if kind != rtUiKindTextview or te == ptr(0) {
        rtTextFromBytes(out, ptr(0), 0, 0)
        return
    }
    teMp = UiHandleDeref(te)
    len = peekw(teMp + rtUiTeTeLength)
    hText = ptr(peekl(teMp + rtUiTeHText))
    UiHLock(hText)
    rtTextFromBytes(out, UiHandleDeref(hText), len, len)
    UiHUnlock(hText)
}

func rtUiWidgetSetText(instV: ptr, wIdx: int, t: ptr) {
    var w: RtUiWinst
    var kind: int
    var te: ptr
    var teMp: ptr
    var savedPort: ptr
    var buf: ptr
    var copied: int
    var contentBottom: int
    var viewTop: int
    var viewBottom: int
    var eraseRect: ptr

    w = RtUiWinst(instV)
    kind = uidWidgetKind(w.winIdx, wIdx)
    te = rtUiTeAt(w, wIdx)
    if kind != rtUiKindTextview or te == ptr(0) {
        return
    }
    savedPort = rtUiGetPortSaved()
    UiSetPort(w.wp)
    // A heap scratch buffer, not a stack one (rt_ui.c:5439-5444): RTUI_
    // TE_MAX (32000) bytes would blow a 68k app's small default stack.
    // rtTextToBytes itself clamps to bufcap and calls rtSetLastErr on
    // overflow -- no separate clamp/lasterr call needed here.
    buf = UiNewPtr(rtUiTeMax)
    if buf == ptr(0) {
        rtPanic("out of memory")
    }
    copied = rtTextToBytes(t, buf, rtUiTeMax)
    UiTESetText(buf, copied, te)
    UiDisposePtr(buf)
    UiTECalText(te)
    UiInvalRect(UiHandleDeref(te) + rtUiTeViewRect)
    rtUiTeMutated(instV, wIdx, false) // PROGRAMMATIC set -- no trace/event
    // Live paint (live-log phase): draw the fresh content NOW. The
    // update event UiInvalRect just queued cannot arrive while a user
    // handler is still running (ClarusC.APPL compiles synchronously
    // inside one), so TEUpdate here -- after rtUiTeMutated's own
    // clamp/scroll-sync settles the final state -- then ValidRect to
    // cancel the now-redundant queued repaint. A hidden or covered
    // window clips to the port's visRgn, making this a safe no-op.
    //
    // live-log phase bugfix: a SET that REPLACES longer content with
    // shorter content left the old text's pixels visible below the new
    // content -- TEUpdate below draws only the new text's own lines, it
    // never erases the rest of the view rect, and the ValidRect right
    // after it cancels the queued update event that would otherwise have
    // repainted (and thus erased) that remainder. Erase the below-content
    // strip ourselves first: content bottom = dest top + nLines *
    // lineHeight (the same teMp fields rtUiTeScrollSync reads, uitext.cla
    // rtUiTeScrollSync), clamped into the view rect; skip the erase
    // entirely when content already fills the view (nothing stale to
    // clear, and it avoids a whole-view flicker on every ticker repaint).
    teMp = UiHandleDeref(te)
    viewTop = peekw(teMp + rtUiTeViewRect + 0)
    viewBottom = peekw(teMp + rtUiTeViewRect + 4)
    contentBottom = rtUiPeekSw(teMp + rtUiTeDestRect + 0) + peekw(teMp + rtUiTeNLines) * peekw(teMp + rtUiTeLineHeight)
    if contentBottom < viewTop {
        contentBottom = viewTop
    }
    if contentBottom < viewBottom {
        eraseRect = UiNewPtr(rtUiRectSize)
        teMp = UiHandleDeref(te) // AFTER the NewPtr -- it can relocate te
        UiSetRect(eraseRect, peekw(teMp + rtUiTeViewRect + 2), contentBottom, peekw(teMp + rtUiTeViewRect + 6), viewBottom)
        UiEraseRect(eraseRect)
        UiDisposePtr(eraseRect)
    }
    UiTEUpdate(teMp + rtUiTeViewRect, te)
    UiValidRect(teMp + rtUiTeViewRect)
    UiSetPort(savedPort)
}

// rtUiPeekSw: a SIGNED 16-bit read -- peekw zero-extends (Ch12's
// peek/poke table), but QuickDraw Rect fields are signed INTEGERs and a
// scrolled TE's destRect.top goes negative, so a plain
// peekw(viewRect.top) - peekw(destRect.top) is off by 65536 there.
func rtUiPeekSw(p: ptr): int {
    var v: int

    v = peekw(p)
    if v >= 32768 {
        v = v - 65536
    }
    return v
}

// rtUiWidgetScrollToEnd (textview-scroll-to-end phase): `Widget.
// scrollToEnd()` for a TEXTVIEW -- scrolls the view so its last line is
// visible and pins the vertical scrollbar (if any) to the same offset.
// Horizontal offset untouched; a no-op when the content already fits
// (maxScroll == 0) or the view is already at the end; a programmatic
// action, so no trace/`change` event, same as rtUiWidgetSetText. Runs
// rtUiTeScrollSync first so the control's maximum and the TE's own
// offset are consistent before the end offset is computed from the same
// viewRect/destRect/nLines/lineHeight fields the sync reads. TEScroll
// redraws the view itself (the thumb handlers in uitext.cla rely on the
// same), so no TEUpdate/InvalRect is needed here.
func rtUiWidgetScrollToEnd(instV: ptr, wIdx: int) {
    var w: RtUiWinst
    var te: ptr
    var teMp: ptr
    var sb: ptr
    var savedPort: ptr
    var viewH: int
    var contentH: int
    var maxScroll: int
    var offset: int

    w = RtUiWinst(instV)
    te = rtUiTeAt(w, wIdx)
    if uidWidgetKind(w.winIdx, wIdx) != rtUiKindTextview or te == ptr(0) {
        return
    }
    savedPort = rtUiGetPortSaved()
    UiSetPort(w.wp)
    rtUiTeScrollSync(instV, wIdx)
    teMp = UiHandleDeref(te) // AFTER the sync -- its Toolbox calls can move memory
    viewH = rtUiPeekSw(teMp + rtUiTeViewRect + 4) - rtUiPeekSw(teMp + rtUiTeViewRect + 0)
    contentH = peekw(teMp + rtUiTeNLines) * peekw(teMp + rtUiTeLineHeight)
    maxScroll = contentH - viewH
    if maxScroll < 0 {
        maxScroll = 0
    }
    // compiler-cleanup: same 16-bit ceiling as rtUiTeScrollSync's own
    // clamp (uitext.cla) -- this function re-derives maxScroll itself
    // instead of reading the synced value, so it needs its own copy.
    if maxScroll > 32767 {
        maxScroll = 32767
    }
    offset = rtUiPeekSw(teMp + rtUiTeViewRect + 0) - rtUiPeekSw(teMp + rtUiTeDestRect + 0)
    if offset < maxScroll {
        UiTEScroll(0, offset - maxScroll, te) // negative dv: content moves up
        sb = rtUiCtrlAt(w, wIdx)
        if sb != ptr(0) {
            UiSetControlValue(sb, maxScroll)
        }
    }
    UiSetPort(savedPort)
}

func rtUiWidgetSetBool(instV: ptr, wIdx: int, prop: int, v: bool) {
    var w: RtUiWinst
    var winIdx: int
    var savedPort: ptr
    var kind: int
    var ctrl: ptr

    w = RtUiWinst(instV)
    winIdx = w.winIdx
    savedPort = rtUiGetPortSaved()
    UiSetPort(w.wp)
    kind = uidWidgetKind(winIdx, wIdx)
    rtUiTraceSetBool(uidWinName(winIdx), uidWidgetName(winIdx, wIdx), prop, v)
    ctrl = rtUiCtrlAt(w, wIdx)
    if kind == rtUiKindCheck and prop == rtUiPropChecked and ctrl != ptr(0) {
        if v {
            UiSetControlValue(ctrl, 1)
        } else {
            UiSetControlValue(ctrl, 0)
        }
    } else if kind == rtUiKindButton and prop == rtUiPropEnabled and ctrl != ptr(0) {
        // logicalEnabled (rt_ui.c:5471-5486): remembers the PROGRAM's own
        // enabled/disabled choice independent of window active/inactive
        // dimming; only visibly undims right now if this window is
        // currently frontmost (deferred to the next activate otherwise).
        rtUiSetEnabledAt(w, wIdx, v)
        if w.wp == UiFrontWindow() {
            if v {
                UiHiliteControl(ctrl, 0)
            } else {
                UiHiliteControl(ctrl, 255)
            }
        }
    }
    UiSetPort(savedPort)
}

// rtUiWidgetSetInt (rt_ui.c:5495-5541, Task 9): popup SELECTED and table
// SELECTED are the C reference's only two cases -- both live now. The
// System 7 CDEF's own `if (inst->ctrls[wIdx]) SetControlValue(...)` line is
// omitted: ctrls[wIdx] always stays ptr(0) for a popup this port (the
// RTUI_POPUP_CDEF gate, uitable.cla's own header note), so that branch
// could never fire. Table's row clamp is upper-bound ONLY (no lower clamp
// against 0) -- a negative `v` passes straight through to
// rtUiTableSelectExclusive, whose own "unless negative, meaning deselect
// only" contract is exactly what a negative `selected` write is supposed
// to do (verbatim from the C reference).
func rtUiWidgetSetInt(instV: ptr, wIdx: int, prop: int, v: int) {
    var w: RtUiWinst
    var winIdx: int
    var savedPort: ptr
    var kind: int
    var count: int
    var sel: int
    var lh: ptr
    var tableOff: int
    var rowsIdx: int
    var rowsAddr: ptr
    var rows: ptr
    var row: int

    w = RtUiWinst(instV)
    winIdx = w.winIdx
    savedPort = rtUiGetPortSaved()
    UiSetPort(w.wp)
    kind = uidWidgetKind(winIdx, wIdx)
    if kind == rtUiKindPopup and prop == rtUiPropSelected {
        if rtUiPopupAt(w, wIdx) != ptr(0) {
            count = UiCountMItems(rtUiPopupAt(w, wIdx))
        } else {
            count = 0
        }
        sel = v
        if sel < 0 {
            sel = 0
        }
        if count > 0 and sel > count - 1 {
            sel = count - 1
        }
        if count == 0 {
            sel = 0
        }
        rtUiSetPopupSelAt(w, wIdx, sel)
        UiInvalRect(rtUiRectAt(w, wIdx))
        rtUiTraceSetInt(uidWinName(winIdx), uidWidgetName(winIdx, wIdx), prop, sel)
    }
    if kind == rtUiKindTable and prop == rtUiPropSelected {
        lh = rtUiListAt(w, wIdx)
        tableOff = uidWidgetTableOff(winIdx, wIdx)
        rowsIdx = uidTableRowsIdx(tableOff)
        rowsAddr = UiTableRows(rowsIdx)
        rows = ptr(peekl(rowsAddr))
        count = rtListCount(rows)
        row = v
        if row >= count {
            row = count - 1
        }
        rtUiTableSelectExclusive(lh, row)
        UiInvalRect(UiHandleDeref(lh) + rtUiListRView)
        rtUiTraceSetInt(uidWinName(winIdx), uidWidgetName(winIdx, wIdx), prop, row)
    }
    UiSetPort(savedPort)
}

func rtUiWidgetGetBool(instV: ptr, wIdx: int, prop: int): bool {
    var w: RtUiWinst
    var winIdx: int
    var kind: int
    var ctrl: ptr

    w = RtUiWinst(instV)
    winIdx = w.winIdx
    kind = uidWidgetKind(winIdx, wIdx)
    ctrl = rtUiCtrlAt(w, wIdx)
    if kind == rtUiKindCheck and prop == rtUiPropChecked and ctrl != ptr(0) {
        return UiGetControlValue(ctrl) != 0
    }
    if kind == rtUiKindButton and prop == rtUiPropEnabled and ctrl != ptr(0) {
        return rtUiEnabledAt(w, wIdx)
    }
    return false
}

// rtUiWidgetGetInt (rt_ui.c:5563-5580, Task 9): WIDTH/HEIGHT (from the
// widget's own laid-out rect) are live since Task 7; popup/table SELECTED
// are live now too. Popup's own `if (inst->ctrls[wIdx]) return
// GetControlValue(...) - 1` line is omitted -- same RTUI_POPUP_CDEF
// reasoning as rtUiWidgetSetInt's own comment (ctrls[wIdx] always ptr(0)
// this port), so popupSel[wIdx] is the ONLY source of truth here.
func rtUiWidgetGetInt(instV: ptr, wIdx: int, prop: int): int {
    var w: RtUiWinst
    var r: ptr
    var kind: int

    w = RtUiWinst(instV)
    r = rtUiRectAt(w, wIdx)
    if prop == rtUiPropHeight {
        return peekw(r + 4) - peekw(r + 0)
    }
    kind = uidWidgetKind(w.winIdx, wIdx)
    if prop == rtUiPropSelected and kind == rtUiKindPopup {
        return rtUiPopupSelAt(w, wIdx)
    }
    if prop == rtUiPropSelected and kind == rtUiKindTable {
        return rtUiTableGetSelected(rtUiListAt(w, wIdx))
    }
    return peekw(r + 6) - peekw(r + 2)
}

// ================================================================
// Canvas offscreen buffer management (rt_ui.c:2122-2196; per the brief's
// own file split -- "uiwidgets.cla: layout engine + button/check/label/
// canvas" -- canvas buffer lifecycle lives here, alongside canvas
// creation/layout; only the "walk every open window" umbrella
// (rt_ui_flush_all_buffered) moves to ui.cla, Step 4, since it needs the
// same window-list-walking primitives (windowKind/nextWindow offsets)
// rtUiQuit/rtUiFront use there).
// ================================================================

// rtUiScratchBitMap: a single reusable 14-byte scratch Toolbox BitMap
// (Task 7 report log entry #7's own "RECT / BITMAP HANDLING" recipe,
// uidesc.cla's header comment) -- lazily allocated once, reused for every
// SetPortBits/CopyBits call this module makes. Safe to share (unlike
// rtUiGetPortSaved's OWN necessarily-fresh-per-call scratch): nothing
// here holds a canvas-drawing call open across ANOTHER canvas-drawing
// call the way port-save/restore brackets nest around arbitrary callees.
var rtUiScratchBitMap: ptr = ptr(0)

func rtUiScratchBitMapGet(): ptr {
    if rtUiScratchBitMap == ptr(0) {
        rtUiScratchBitMap = UiNewPtr(14)
    }
    return rtUiScratchBitMap
}

// rtUiBitMapFill pokes cb's scattered fields into the shared scratch
// BitMap at its own real Toolbox layout (baseAddr@0 ptr/4, rowBytes@4
// short/2, bounds@6 Rect/8 -- Task 7 report log entry #7).
func rtUiBitMapFill(cb: RtUiCanvasBuf): ptr {
    var bm: ptr

    bm = rtUiScratchBitMapGet()
    pokel(bm + 0, int(cb.bitsBaseAddr))
    pokew(bm + 4, cb.bitsRowBytes)
    pokew(bm + 6, cb.bitsBoundsTop)
    pokew(bm + 8, cb.bitsBoundsLeft)
    pokew(bm + 10, cb.bitsBoundsBottom)
    pokew(bm + 12, cb.bitsBoundsRight)
    return bm
}

func rtUiCanvasDispose(cb: ptr) {
    var buf: RtUiCanvasBuf

    buf = RtUiCanvasBuf(cb)
    if buf.port == ptr(0) {
        return
    }
    UiClosePort(buf.port)
    UiDisposePtr(buf.port)
    UiDisposePtr(buf.pixels)
    buf.port = ptr(0)
    buf.pixels = ptr(0)
}

func rtUiCanvasMake(cb: ptr, ww: int, hh: int) {
    var buf: RtUiCanvasBuf
    var rowBytes: int
    var bm: ptr
    var w2: int
    var h2: int

    w2 = ww
    h2 = hh
    if w2 < 1 {
        w2 = 1
    }
    if h2 < 1 {
        h2 = 1
    }
    buf = RtUiCanvasBuf(cb)
    buf.port = UiNewPtrClear(108) // sizeof(GrafPort) -- Task 7 report log #4
    if buf.port == ptr(0) {
        rtPanic("out of memory")
    }
    rowBytes = ((w2 + 15) / 16) * 2
    buf.pixels = UiNewPtrClear(rowBytes * h2)
    if buf.pixels == ptr(0) {
        rtPanic("out of memory")
    }
    UiOpenPort(buf.port)
    buf.bitsBaseAddr = buf.pixels
    buf.bitsRowBytes = rowBytes
    buf.bitsBoundsTop = 0
    buf.bitsBoundsLeft = 0
    buf.bitsBoundsBottom = h2
    buf.bitsBoundsRight = w2
    bm = rtUiBitMapFill(buf)
    UiSetPortBits(bm)
    UiPortSize(w2, h2)
    UiSetOrigin(0, 0)
}

func rtUiCanvasReallocAll(inst: ptr) {
    var w: RtUiWinst
    var winIdx: int
    var n: int
    var i: int
    var kind: int
    var flags: int
    var r: ptr

    w = RtUiWinst(inst)
    winIdx = w.winIdx
    n = uidWinNWidgets(winIdx)
    i = 0
    while i < n {
        kind = uidWidgetKind(winIdx, i)
        flags = uidWidgetFlags(winIdx, i)
        if kind == rtUiKindCanvas and (flags & rtUiFlagBuffered) != 0 {
            r = rtUiRectAt(w, i)
            rtUiCanvasDispose(rtUiCanvasBufAt(w, i))
            rtUiCanvasMake(rtUiCanvasBufAt(w, i), peekw(r + 6) - peekw(r + 2), peekw(r + 4) - peekw(r + 0))
        }
        i = i + 1
    }
}

// rtUiFlushBufferedCanvases (rt_ui.c:2172-2187): blits every buffered
// canvas's offscreen content to its window, once per rtUiRun iteration
// (Ch11's "single copy when the current handler or timer returns to the
// event loop") and also covers redrawing after an updateEvt.
func rtUiFlushBufferedCanvases(inst: ptr) {
    var w: RtUiWinst
    var winIdx: int
    var n: int
    var i: int
    var buf: RtUiCanvasBuf
    var bm: ptr

    if inst == ptr(0) {
        return
    }
    w = RtUiWinst(inst)
    winIdx = w.winIdx
    n = uidWinNWidgets(winIdx)
    i = 0
    while i < n {
        buf = RtUiCanvasBuf(rtUiCanvasBufAt(w, i))
        if buf.port != ptr(0) {
            UiSetPort(w.wp)
            bm = rtUiBitMapFill(buf)
            // dstBits = &((GrafPtr)wp)->portBits -- portBits is GrafPort's
            // own second field, right after `device` (short, 2 bytes), so
            // offset 2 off the WindowPtr itself (WindowRecord's embedded
            // GrafPort starts at offset 0 -- Task 7 report log entry #7).
            // srcRect = &cb->bits.bounds = the scratch BitMap's own
            // bounds sub-field, offset 6 within its 14-byte layout.
            UiCopyBits(bm, w.wp + 2, bm + 6, rtUiRectAt(w, i), 0, ptr(0))
        }
        i = i + 1
    }
}

// ================================================================
// Canvas drawing ops (rt_ui.c:5583-5723, Ch11) + the 9-entry gray
// pattern table.
// ================================================================

record RtUiCanvasTarget {
    port: ptr
    dx: int
    dy: int
    savedPort: ptr
}

// rtUiCanvasBegin/rtUiCanvasEnd (rt_ui.c:5596-5619): self-assert/restore
// the port (PORT DISCIPLINE RULE) around every canvas op, targeting the
// canvas's own offscreen port (buffered) or the window's port at an
// offset (unbuffered) either way.
func rtUiCanvasBegin(instV: ptr, wIdx: int): RtUiCanvasTarget {
    var w: RtUiWinst
    var buf: RtUiCanvasBuf
    var t: RtUiCanvasTarget
    var r: ptr

    w = RtUiWinst(instV)
    buf = RtUiCanvasBuf(rtUiCanvasBufAt(w, wIdx))
    if buf.port != ptr(0) {
        t.port = buf.port
        t.dx = 0
        t.dy = 0
    } else {
        t.port = w.wp
        r = rtUiRectAt(w, wIdx)
        t.dx = peekw(r + 2)
        t.dy = peekw(r + 0)
    }
    t.savedPort = rtUiGetPortSaved()
    UiSetPort(t.port)
    return t
}

func rtUiCanvasEnd(t: RtUiCanvasTarget) {
    UiSetPort(t.savedPort)
}

// rtUiGrayPats (rt_ui.c:5621-5635): nine 8x8 fill patterns, level 0
// (white) .. 8 (black), an ordered-dither density ramp -- transcribed
// byte-for-byte from the C reference's own array, lazily allocated once.
var rtUiGrayPats: ptr = ptr(0)

func rtUiGrayPatsGet(): ptr {
    var p: ptr

    if rtUiGrayPats != ptr(0) {
        return rtUiGrayPats
    }
    p = UiNewPtr(72)
    pokeb(p + 0, 0x00)
    pokeb(p + 1, 0x00)
    pokeb(p + 2, 0x00)
    pokeb(p + 3, 0x00)
    pokeb(p + 4, 0x00)
    pokeb(p + 5, 0x00)
    pokeb(p + 6, 0x00)
    pokeb(p + 7, 0x00)
    pokeb(p + 8, 0x88)
    pokeb(p + 9, 0x00)
    pokeb(p + 10, 0x22)
    pokeb(p + 11, 0x00)
    pokeb(p + 12, 0x88)
    pokeb(p + 13, 0x00)
    pokeb(p + 14, 0x22)
    pokeb(p + 15, 0x00)
    pokeb(p + 16, 0x88)
    pokeb(p + 17, 0x22)
    pokeb(p + 18, 0x88)
    pokeb(p + 19, 0x22)
    pokeb(p + 20, 0x88)
    pokeb(p + 21, 0x22)
    pokeb(p + 22, 0x88)
    pokeb(p + 23, 0x22)
    pokeb(p + 24, 0xAA)
    pokeb(p + 25, 0x22)
    pokeb(p + 26, 0xAA)
    pokeb(p + 27, 0x88)
    pokeb(p + 28, 0xAA)
    pokeb(p + 29, 0x22)
    pokeb(p + 30, 0xAA)
    pokeb(p + 31, 0x88)
    pokeb(p + 32, 0xAA)
    pokeb(p + 33, 0x55)
    pokeb(p + 34, 0xAA)
    pokeb(p + 35, 0x55)
    pokeb(p + 36, 0xAA)
    pokeb(p + 37, 0x55)
    pokeb(p + 38, 0xAA)
    pokeb(p + 39, 0x55)
    pokeb(p + 40, 0x55)
    pokeb(p + 41, 0xDD)
    pokeb(p + 42, 0x55)
    pokeb(p + 43, 0x77)
    pokeb(p + 44, 0x55)
    pokeb(p + 45, 0xDD)
    pokeb(p + 46, 0x55)
    pokeb(p + 47, 0x77)
    pokeb(p + 48, 0x77)
    pokeb(p + 49, 0xDD)
    pokeb(p + 50, 0x77)
    pokeb(p + 51, 0xDD)
    pokeb(p + 52, 0x77)
    pokeb(p + 53, 0xDD)
    pokeb(p + 54, 0x77)
    pokeb(p + 55, 0xDD)
    pokeb(p + 56, 0x77)
    pokeb(p + 57, 0xFF)
    pokeb(p + 58, 0xDD)
    pokeb(p + 59, 0xFF)
    pokeb(p + 60, 0x77)
    pokeb(p + 61, 0xFF)
    pokeb(p + 62, 0xDD)
    pokeb(p + 63, 0xFF)
    pokeb(p + 64, 0xFF)
    pokeb(p + 65, 0xFF)
    pokeb(p + 66, 0xFF)
    pokeb(p + 67, 0xFF)
    pokeb(p + 68, 0xFF)
    pokeb(p + 69, 0xFF)
    pokeb(p + 70, 0xFF)
    pokeb(p + 71, 0xFF)
    rtUiGrayPats = p
    return p
}

func rtUiCanvasPattern(instV: ptr, wIdx: int, level: int) {
    var w: RtUiWinst
    var buf: RtUiCanvasBuf
    var lv: int

    lv = level
    if lv < 0 {
        lv = 0
    }
    if lv > 8 {
        lv = 8
    }
    w = RtUiWinst(instV)
    buf = RtUiCanvasBuf(rtUiCanvasBufAt(w, wIdx))
    buf.patLevel = lv
}

func rtUiCanvasClear(instV: ptr, wIdx: int) {
    var t: RtUiCanvasTarget
    var w: RtUiWinst
    var buf: RtUiCanvasBuf
    var scratch: ptr

    w = RtUiWinst(instV)
    t = rtUiCanvasBegin(instV, wIdx)
    buf = RtUiCanvasBuf(rtUiCanvasBufAt(w, wIdx))
    if buf.port != ptr(0) {
        scratch = UiNewPtr(rtUiRectSize)
        UiSetRect(scratch, buf.bitsBoundsLeft, buf.bitsBoundsTop, buf.bitsBoundsRight, buf.bitsBoundsBottom)
        UiEraseRect(scratch)
        UiDisposePtr(scratch)
    } else {
        UiEraseRect(rtUiRectAt(w, wIdx))
    }
    rtUiCanvasEnd(t)
}

func rtUiCanvasLine(instV: ptr, wIdx: int, x0: int, y0: int, x1: int, y1: int) {
    var t: RtUiCanvasTarget

    t = rtUiCanvasBegin(instV, wIdx)
    UiMoveTo(x0 + t.dx, y0 + t.dy)
    UiLineTo(x1 + t.dx, y1 + t.dy)
    rtUiCanvasEnd(t)
}

func rtUiCanvasRect(instV: ptr, wIdx: int, x: int, y: int, ww: int, hh: int, fill: bool) {
    var t: RtUiCanvasTarget
    var w: RtUiWinst
    var buf: RtUiCanvasBuf
    var r: ptr
    var pats: ptr

    t = rtUiCanvasBegin(instV, wIdx)
    w = RtUiWinst(instV)
    r = UiNewPtr(rtUiRectSize)
    UiSetRect(r, x + t.dx, y + t.dy, x + t.dx + ww, y + t.dy + hh)
    if fill {
        buf = RtUiCanvasBuf(rtUiCanvasBufAt(w, wIdx))
        pats = rtUiGrayPatsGet()
        UiFillRect(r, pats + buf.patLevel * 8)
    } else {
        UiFrameRect(r)
    }
    UiDisposePtr(r)
    rtUiCanvasEnd(t)
}

func rtUiCanvasFillCircle(instV: ptr, wIdx: int, x: int, y: int, radius: int) {
    var t: RtUiCanvasTarget
    var w: RtUiWinst
    var buf: RtUiCanvasBuf
    var box: ptr
    var pats: ptr

    t = rtUiCanvasBegin(instV, wIdx)
    w = RtUiWinst(instV)
    box = UiNewPtr(rtUiRectSize)
    UiSetRect(box, x + t.dx - radius, y + t.dy - radius, x + t.dx + radius, y + t.dy + radius)
    buf = RtUiCanvasBuf(rtUiCanvasBufAt(w, wIdx))
    pats = rtUiGrayPatsGet()
    UiFillOval(box, pats + buf.patLevel * 8)
    UiDisposePtr(box)
    rtUiCanvasEnd(t)
}

func rtUiCanvasCircle(instV: ptr, wIdx: int, x: int, y: int, radius: int) {
    var t: RtUiCanvasTarget
    var box: ptr

    t = rtUiCanvasBegin(instV, wIdx)
    box = UiNewPtr(rtUiRectSize)
    UiSetRect(box, x + t.dx - radius, y + t.dy - radius, x + t.dx + radius, y + t.dy + radius)
    UiFrameOval(box)
    UiDisposePtr(box)
    rtUiCanvasEnd(t)
}

func rtUiCanvasDrawText(instV: ptr, wIdx: int, x: int, y: int, s: ptr) {
    var t: RtUiCanvasTarget

    t = rtUiCanvasBegin(instV, wIdx)
    UiMoveTo(x + t.dx, y + t.dy)
    UiDrawString(s)
    rtUiCanvasEnd(t)
}

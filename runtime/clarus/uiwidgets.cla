// uiwidgets.cla: Toolbox extern trap block, continued from ui.cla (see that
// file's header comment for the full scope/exclusion/naming-collision/
// trap-resolution rationale -- it applies identically here, not repeated).
// This file holds Control Manager basics and QuickDraw drawing/geometry
// traps -- the ones widget layout/creation and canvas-drawing code needs
// (button/check/label/canvas, the four widget kinds in scope this slice) --
// plus the canvas offscreen GrafPort's own port-management primitives
// (OpenPort/ClosePort/PortSize/SetOrigin/SetPortBits), kept separate from
// ui.cla's universal SetPort/GetPort since these four are canvas-specific
// (Ch11, rt_ui_canvas_make/rt_ui_canvas_dispose), not general save/restore.
// Step 1 ONLY: extern declarations, no bodies, no `overlay record`s yet.

// ---- Control Manager ----
// rt_ui_make_widgets' button/check creation (:1175-1213 -- the in-scope
// slice of a function that runs 1175-1421 in full; 1213-1421's field/
// textview/popup/table NewControl calls are a later task's problem),
// rt_ui_layout (:789-926, MoveControl/SizeControl repositioning any
// control-backed widget generically), rt_ui_handle_activate (:2938-2971,
// HiliteControl dim/undim on window (de)activate), rt_ui_widget_set_bool's
// ENABLED/CHECKED props and rt_ui_widget_get_bool (:5339-5723,
// HiliteControl/SetControlValue/GetControlValue), rt_ui_widget_set_str's
// CAPTION prop (SetControlTitle), rt_ui_handle_update (:2760-2937,
// DrawControls). rt_ui_widget_set_int/get_int's popup SELECTED prop also
// uses SetControlValue/GetControlValue -- in the produces list (rtUiWidget
// SetInt/GetInt) even though no popup widget can be CREATED this slice.
external func UiNewControl(owningWindow: ptr, boundsRect: ptr, controlTitle: ptr, initiallyVisible: bool, initialValue: word, minimumValue: word, maximumValue: word, procId: word, controlReference: int): ptr = trap 0xA954
external func UiMoveControl(theControl: ptr, h: word, v: word) = trap 0xA959
external func UiSizeControl(theControl: ptr, w: word, h: word) = trap 0xA95C
external func UiHiliteControl(theControl: ptr, hiliteState: word) = trap 0xA95D
external func UiSetControlValue(theControl: ptr, newValue: word) = trap 0xA963
external func UiGetControlValue(theControl: ptr): word = trap 0xA960
external func UiSetControlTitle(theControl: ptr, title: ptr) = trap 0xA95F
external func UiDrawControls(theWindow: ptr) = trap 0xA969
// UiFindControl/UiTrackControl (Controls.h, trap 0xA96C/0xA968, PASCAL
// convention -- Task 7 Step 4 review fix, controller): missing from
// Step 1's own extern block despite being THE dispatch path
// rt_ui_handle_content_click (rt_ui.c:3236-3343) uses for every
// button/check click -- caught while porting that function. FindControl's
// `theControl` is itself an OUT-param (`ControlRef *`), needing the same
// scratch-slot-then-deref pattern as UiGetPort/UiFindWindow.
// TrackControl's `actionProc` is always `ptr(0)` (NULL) at every call
// site this slice makes -- no scrollbar/live-tracking action proc is
// needed for a plain button/check.
external func UiFindControl(testPoint: int, theWindow: ptr, theControl: ptr): word = trap 0xA96C
external func UiTrackControl(theControl: ptr, startPoint: int, actionProc: ptr): word = trap 0xA968

// ---- QuickDraw drawing / geometry ----

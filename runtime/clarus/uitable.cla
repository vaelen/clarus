// uitable.cla: List Manager tables, manual popups, and the hand-built LDEF
// stub -- native-5e Task 9 (slice C). Port target: rt_ui.c:759-773
// (rt_ui_popup_box), 928-1173 (LDEF section), 1248-1632 (POPUP/TABLE
// rt_ui_make_widgets cases + table relayout/select/hit/click/sync),
// 3143-3323+3374-3418 (popup/table click lanes), 4747-4791+4816-4827
// (teardown), 5505-5539+5569-5579 (set/get int). Creation (the switch cases
// this file's functions are CALLED FROM) lives in uiwidgets.cla's
// rtUiMakeWidgets, alongside every other widget kind; layout dispatch
// (rtUiTableRelayout's own call site) lives in uiwidgets.cla's rtUiLayout;
// draw dispatch lives in ui.cla's rtUiHandleUpdate; click dispatch lives in
// ui.cla's rtUiHandleContentClick; teardown ordering lives in ui.cla's
// rtUiTeardownWindow; property get/set lives in uiwidgets.cla's
// rtUiWidget{Get,Set}Int -- this file holds the TABLE/POPUP-internal
// machinery those call into by name (whole-program visibility, docs/
// clarus-language-reference.md:736).
//
// PARKED (rt_ui.c:242-268, RTUI_POPUP_CDEF): the System 7 popup-button
// Control Manager path is gated off on EVERY system in the C reference
// (manually verified non-functional without a real 'MENU' resource, see
// that comment's own evidence) -- this port carries only the gate's
// CONSEQUENCE (a popup's `ctrls[wIdx]` always stays ptr(0), so every
// downstream draw/hit/click/dispose site here keys on that, exactly like
// the oracle's own `!inst->ctrls[wIdx]` guards), not the dead CDEF branch
// itself. Flip only once clarusc/build-mac.sh emit a real per-popup 'MENU'
// resource (docs/TODO.md).
//
// Table row values are drawn straight from the bound record's own memory
// (ftype/offset/strCap/enumCount/enumLabels/enumValues, all read via
// uidesc.cla's Layout/EnumArrays accessors) -- mirrors rt_ser.inc's own
// ser_put_field byte layout exactly: a bool field is 1 byte at its base
// address (small-scalar-width phase, 2026-08-05), same as char.
// rtUiFtInt/Fixed/Bool/Char/Str/Enum
// (below) mirror ser.cla's own RtFtInt/Fixed/Bool/Char/Str/Enum numbering
// exactly (both read the SAME uibFieldTypeNum-numbered blob/serialized
// bytes, clarusc/uiblob.cla:269-291) but are this file's OWN constants,
// under this file's own `rtUi`-prefixed naming -- ser.cla is only spliced
// into a program's manifest when that program calls file.save/file.load
// (clarusc/main.cla's own `usesFileSaveLoad` gate), so a table-only
// program (no file I/O at all) would leave ser.cla's RtFt* names
// undefined; reusing them here would make uitable.cla's own always-needed
// constants depend on an unrelated, sometimes-absent module.

// ---- List Manager (rt_ui.c:928-1632, mac-target-4d Task 4's own oracle) --
// every routine below dispatches through the SAME single trap (0xA9E7,
// Retro68's own THREEWORDINLINE(0x3F3C, selector, 0xA9E7) encoding,
// verified against toolchain/multiversal/CIncludes/Multiverse.h:9669-9714
// and Retro68/InterfacesAndLibraries/Interfaces/CIncludes/Lists.h) -- the
// selector word is an encoding detail the real Toolbox call handles
// internally on the cprint/C lane (rt_ext_ wrapper calls the real C name
// directly, letting Retro68's own header glue push the selector), but
// NATIVE cg68k has no such wrapper: Task 14 (native-5e) added a `sel`
// extern clause (`= trap 0xA9E7 sel 0x0044`, cgCallExtPascal) specifically
// for this "Package 7"-dispatch shape, and every routine below now
// carries its own real selector word (verified against the SAME Lists.h
// THREEWORDINLINE/TWOWORDINLINE lines cited above) -- pre-fix, EVERY List
// Manager call here pushed NO selector at all, so the trap read whatever
// garbage happened to be on the stack, crashing "illegal instruction"
// before popuptable.cla's table widget (built during App.launch, before
// any window ever shows) finished construction. Point/Cell by-value
// params pack v (high 16) / h (low 16) into one `int`, same convention as
// every other by-value Point/Cell this port uses (ui.cla's rt_ext_ui_pt). ----
external func UiLNew(rView: ptr, dataBounds: ptr, cSize: int, theProc: word, theWindow: ptr, drawIt: bool, hasGrow: bool, scrollHoriz: bool, scrollVert: bool): ptr = trap 0xA9E7 sel 0x0044
external func UiLDispose(lHandle: ptr) = trap 0xA9E7 sel 0x0028
external func UiLAddRow(count: word, rowNum: word, lHandle: ptr): word = trap 0xA9E7 sel 0x0008
external func UiLDelRow(count: word, rowNum: word, lHandle: ptr) = trap 0xA9E7 sel 0x0024
external func UiLGetSelect(next: bool, theCell: ptr, lHandle: ptr): bool = trap 0xA9E7 sel 0x003C
external func UiLSetSelect(setIt: bool, theCell: int, lHandle: ptr) = trap 0xA9E7 sel 0x005C
external func UiLSize(listWidth: word, listHeight: word, lHandle: ptr) = trap 0xA9E7 sel 0x0060
external func UiLActivate(act: bool, lHandle: ptr) = trap 0xA9E7 sel 0x0000
external func UiLSetDrawingMode(drawIt: bool, lHandle: ptr) = trap 0xA9E7 sel 0x002C
external func UiLUpdate(theRgn: ptr, lHandle: ptr) = trap 0xA9E7 sel 0x0064
external func UiLClick(pt: int, modifiers: word, lHandle: ptr): bool = trap 0xA9E7 sel 0x0018

// ---- Menu Manager additions (SetMenuItemText/GetMenuHandle/PopUpMenuSelect
// -- ui.cla already declares NewMenu/AppendMenu/AppendMenuStr/InsertMenu/
// DeleteMenu/DisposeMenu/CountMItems/GetMenuItemText, reused here by name).
// Verified against Retro68's own Menus.h (SetMenuItemText 0xA947 @:2758,
// GetMenuHandle 0xA949 @:2487, PopUpMenuSelect 0xA80B @:2192-2193) and
// cross-checked against Multiverse.h (:6008-6091, same three trap words). --
external func UiSetMenuItemText(theMenu: ptr, item: word, itemString: ptr) = trap 0xA947
external func UiGetMenuHandle(menuId: word): ptr = trap 0xA949
external func UiPopUpMenuSelect(theMenu: ptr, top: word, left: word, popUpItem: word): int = trap 0xA80B

// ---- QuickDraw/QuickdrawText additions this slice's draw code needs.
// InvertRect 0xA8A4 (QuickDraw.h:3046, aliased MacInvertRect; Multiverse.h
// :2675-2676 agrees). DrawText 0xA885 (QuickdrawText.h:537, aliased
// MacDrawText; Multiverse.h:2871-2872 agrees). GetFontInfo 0xA88B
// (QuickdrawText.h, ONEWORDINLINE). LocalToGlobal 0xA870 (QuickDraw.h:3941;
// Multiverse.h:2527-2528 agrees) -- takes `Point *pt` (an IN-OUT pointer,
// unlike PopUpMenuSelect's own separate top/left shorts), needed for the
// popup anchor point (rt_ui.c:3400-3403). NumToString: Retro68's modern
// NumberFormatting.h declares it with NO inline trap clause at all (a real
// InterfaceLib call on that header's own terms), but Multiverse.h --
// already this codebase's cross-check reference for every other trap word
// -- gives it M68K_INLINE(0x3F3C, 0x0000, 0xA9EE) (:12342-12344), a
// selector-prefixed Package Manager trap exactly like the List Manager
// family above; ITS OWN `#pragma parameter NumToString(__D0, __A0)` line
// just above that (:12342) documents REGISTER convention on 68k, not the
// plain pascal-stack convention this bare `trap` clause declares -- same
// unresolved-for-native gap ui.cla's own Gestalt externs used to flag and
// defer to Task 12 (cg68k has no `reg` clause shape for "one ptr in
// A0, nothing in D-regs but the trap's own D0 selector" -- and note that
// `reg`'s named form has since landed, so this one is now expressible;
// it is simply still unexercised on the native lane); the cprint lane
// (this task's only exercised path) is unaffected, since cprint calls the
// real C `NumToString` name directly regardless of this clause. ----
external func UiInvertRect(r: ptr) = trap 0xA8A4
external func UiDrawText(textBuf: ptr, firstByte: word, byteCount: word) = trap 0xA885
external func UiGetFontInfo(info: ptr) = trap 0xA88B
external func UiLocalToGlobal(pt: ptr) = trap 0xA870
// UiNumToString (Task 14 fix, native-5e gate, formedit.cla): NOT a plain
// stack-based Pascal trap despite Inside Macintosh's own `pascal void
// NumToString(long theNum, Str255 theString)` signature -- it is one of
// the "Binary/Decimal Conversion Package" (Package 7) routines, which
// (like the Memory Manager's SetHandleSize-family this session's own `reg
// memerr` extern clause already fixed) pass BOTH args in REGISTERS
// (theNum in D0, theString in A0), never via a real stack push -- a plain
// `trap` declaration pushed both args onto the stack and executed the
// $A9EE trap word anyway, which the REAL Package 7 dispatcher (reading
// its args from D0/A0, never the stack) simply ignored, silently leaving
// `theString` untouched. First real exercise: formedit.cla's second `edit`
// session (kind=2, `bookmarks[i]`) is the first scenario that both fills
// AND validates a pre-populated INT field WITHOUT the user retyping it --
// a `new T`-kind edit's int field defaults happened to survive unnoticed
// because the user always retyped Port before ever hitting OK. `reg`
// (cgRegPassArgsAndTrap's generic by-kind register assignment: first
// non-ptr arg -> D0, first ptr arg -> A0) matches this routine's own
// convention exactly, no `sel` needed ($A9EE is NumToString's own
// dedicated trap word, not a shared Package-Manager dispatch point the
// way the List Manager's 0xA9E7 is).
external func UiNumToString(theNum: int, theString: ptr) = trap 0xA9EE reg

// ---- Reverse-waist / per-backend glue externs this file consumes ----
// UiTableRows: synthesized by clarusc/lower.cla's lowSynthTableRows (Task
// 6; arm set narrowed to list-typed globals only by Task 8b, layer1-
// compiler-perf, after the original one-arm-per-irGlobals-entry chain blew
// the 32KB segment limit at self-hosting scale) into clar_ui_fire_staterows,
// returning that global's OWN ADDRESS. Read through EVERY draw/sync call, never
// cached (rt_ui.h:250-267's double-indirection contract: the `rt_list *`
// stored at that address can be reassigned by the program at any time,
// e.g. a fresh `list of` value; this port never observes that case in a
// golden scenario, but the re-read discipline is unconditional regardless).
external func UiTableRows(rowsIdx: int): ptr
// UiCbAddr (Task 9, toolbox-integration Feature C: `callback func`
// migration): a trivial identity extern, ptr in, same ptr out. Its ONLY
// job is to satisfy checkCallbackFunc's decay rule (check.cla: a bare
// `callback func` name is legal ONLY as an extern call's ptr-typed
// argument) so rtUiMakeLdefStub below can turn rtUiLdefDraw's own glue
// address into a plain `ptr` value it can int()-convert and poke into the
// LDEF JMP-stub Handle. Resolves via the ordinary clause-less/nat_
// fallback on native (nat_UiCbAddr, this file) and rt_ext_UiCbAddr on the
// Mac C lane (rt_ext_mac.inc) -- no by-name special-casing anywhere,
// unlike the two OLD zero-arg glue-entry externs this replaces (deleted:
// each resolved to a HAND-WRITTEN pascal wrapper's own JT-slot address;
// the pascal marshaling now lives entirely in cprint's generated
// clar_cb_rtUiLdefDraw wrapper, Task 7/8's `callback func` glue).
external func UiCbAddr(cb: ptr): ptr

func nat_UiCbAddr(cb: ptr): ptr {
    return cb
}


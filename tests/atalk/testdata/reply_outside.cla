// AppleTalk phase, Task 8, runerr fixture: `reply` outside a request
// handler is a CONTRACT violation -- a program bug, not weather -- so it
// is a runtime error, not a `failed` event (spec %4.5).
var svc: service

on App.startCLI(args: list of string) {
    svc.reply(0, "too early")
}

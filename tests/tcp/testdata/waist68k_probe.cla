// waist68k_probe.cla: the user program half of tests/tcp/waist68k.sh.
// runtime/clarus/tcp_68k.cla is passed positionally beside it, so the
// waist compiles as ordinary user code and every rtTcpDev* entry point
// gets a real call site -- cg68k emits nothing for a function nobody
// names, so without these calls the test would prove only that the file
// parses.
//
// Nothing here RUNS: MacTCP is absent from every emulator this repo can
// boot (spec %2), so the whole body is behind `if false`. The check is
// the build, not the boot.

on App.startCLI(args: list of string) {
    var p: ptr
    var n: int
    var b: bool

    log("waist ok")
    if false {
        n = rtTcpDevInit()
        n = rtTcpDevCreate(0)
        n = rtTcpDevActiveOpen(0, 0x0A000001, 80)
        n = rtTcpDevPoll(0)
        n = rtTcpDevRecvLen(0)
        p = rtTcpDevRecvPtr(0)
        n = rtTcpDevRecvArm(0)
        b = rtTcpDevSendBusy(0)
        n = rtTcpDevSend(0, p, 1)
        n = rtTcpDevClose(0)
        rtTcpDevRelease(0)
        n = rtTcpDevLsnOpen(0, 8080)
        n = rtTcpDevLsnPoll(0)
        n = rtTcpDevLsnAccept(0, 0)
        rtTcpDevLsnDeny(0)
        rtTcpDevLsnClose(0)
        log(string(n) + string(int(p)))
        if b {
            log("busy")
        }
    }
}

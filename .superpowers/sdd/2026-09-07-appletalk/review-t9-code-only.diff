 func rtLsnDevRemove(slot: int) {
+    var aux: ptr
+
+    if rtAt68LsnRef[slot] == 0 {
+        return
+    }
+    aux = rtAt68DspAuxPb()
+    if aux != ptr(0) {
+        pokew(aux + dspIoCRefNum, rtAt68DspRef)
+        pokew(aux + pbCsCode, dspCLRemove)
+        pokew(aux + dspCcbRefNum, rtAt68LsnRef[slot])
+        pokeb(aux + dspCloseAbort, 1)
+        PBControlSync(aux)
+    }

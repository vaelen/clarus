+ * ConnHIdle either, so the reference costs nothing there. */
+int32_t rt_ext_AtalkHFd(void);
+
 void rt_ext_ConnHIdle(int32_t ms) {
     fd_set rfds;
     struct timeval tv;
     int maxfd;
     int i;
     int any;
+    int32_t afd;
 
     FD_ZERO(&rfds);
     maxfd = -1;
     any = 0;
     for (i = 0; i < RT_CONN_MAX; i++) {
         int fd = rt_conn_slots[i].fd;
         if (fd >= 0) {
             FD_SET(fd, &rfds);
             if (fd > maxfd) maxfd = fd;
             any = 1;
         }
     }
+    afd = rt_ext_AtalkHFd();
+    if (afd >= 0) {
+        FD_SET((int)afd, &rfds);
+        if ((int)afd > maxfd) maxfd = (int)afd;
+        any = 1;
+    }
     if (ms < 0) ms = 0;
     if (!any) {
         usleep((useconds_t)ms * 1000);
         return;
     }
     tv.tv_sec = ms / 1000;
     tv.tv_usec = (ms % 1000) * 1000;
     select(maxfd + 1, &rfds, NULL, NULL, &tv);
 }

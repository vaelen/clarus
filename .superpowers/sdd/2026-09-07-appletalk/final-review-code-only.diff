diff --git a/runtime/clarus/atalk.cla b/runtime/clarus/atalk.cla
new file mode 100644
index 0000000..70eaea9
--- /dev/null
+++ b/runtime/clarus/atalk.cla
@@ -0,0 +1,994 @@
+// Copyright 2026, Andrew C. Young <andrew@vaelen.org>
+// SPDX-License-Identifier: MIT
+
+// atalk.cla: the shared AppleTalk runtime (2026-09-06 appletalk spec,
+// %5.2-%5.7 -- docs/superpowers/specs/2026-09-06-appletalk-design.md).
+// Fixed slot tables for the three resource kinds the spec caps (2
+// listeners, 2 browsers, 2 services), a pump that turns device state into
+// the reverse-waist `clar_*_fire_*` events, and the ADSP waist conn.cla
+// dispatches to for transport 1. Lane-neutral: every device-facing
+// operation goes through the rtAtDev*/rtAdspDev*/rtLsnDev* functions
+// below, which atalk_c.cla (host, real, over runtime/host/rt_atalk.inc's
+// LToUDP stack) and atalk_68k.cla (native; stubs until Task 9) answer --
+// the conn.cla/conn_c.cla/conn_68k.cla precedent exactly.
+//
+// DORMANT this task: lowering (Task 8) is what routes `svc.serve`,
+// `b.find`, `l.register`, `c.open(appletalk ...)` and the event dispatch
+// here, and what roots rtAtalkPump/rtAtalkAlive in shake.cla the way
+// irUsesConn already roots rtConnPump/rtConnAlive. Nothing in the tree
+// calls any function below yet.
+//
+// Spliced (drive.cla) on the HOST lane whenever `usesConn or usesAtalk`,
+// after conn.cla (this file reads conn.cla's own rtConnState slot table
+// for listener accepts, and calls rtConnSetFailed), after ser.cla (reuses
+// its already-declared SerNewPtr/SerDisposePtr scratch externs rather
+// than redeclaring a duplicate pair) and after text.cla/core.cla
+// (text values, rtPanic/rtSetLastErr). NOT on the 68k lane this task --
+// Task 9 adds it there with the real atalk_68k.cla bodies.
+//
+// Error principle (spec %4.5, inherited from conn.cla): contract
+// violations are runtime errors -- use of a nil resource, `reply` outside
+// a handler, `reply` twice. Everything environmental (AppleTalk down, a
+// name already in use, no response, slot table full, ADSP absent) is a
+// `failed` event or `false` + `lastError`, never a panic. Events NEVER
+// fire from the call that caused them: failures are staged per slot and
+// drained by the next rtAtalkPump pass, exactly as conn.cla does it.
+//
+// Native contract (Task 1 probe findings, binding on atalk_68k.cla, which
+// records them in full): every per-slot parameter block is fully re-zeroed
+// before each reuse (a reused NBP parameter block hung the Mac), and NBP
+// registers the socket number verbatim -- which is why rtAtDevRegister
+// takes `sock` and rtLsnDevSocket exists at all.
+
+const rtLsnMax: int = 2
+const rtBrsMax: int = 2
+const rtSvcMax: int = 2
+
+// Lookup slots (rt_atalk.inc's RT_AT_NLK / the native lookup PB table),
+// eleven of them: 0-1 the two browsers (lk == browser slot), 2-9 the eight
+// connection slots' name-form ADSP opens (lk == conn slot + 2), and 10
+// rtSvcCallName's own synchronous slot. 10 and not 9 (fix round 1): an
+// ADSP name-open sits in rtAdspLookup ACROSS pump passes, so a
+// `call("Name:Type", ...)` made during that window would have restarted
+// conn slot 7's live lookup on top of it.
+const rtAtLookupMax: int = 11
+const rtAtNameCallLk: int = 10
+
+// errOpenDenied, reused as "this lane has no streams" -- the host twin's
+// whole rtAdspDev*/rtLsnDev* family returns it (spec %4.6: AppleTalk
+// stream open, register and therefore accepted fail with an event on the
+// host this phase).
+const rtAtErrNoHost: int = -1273
+
+// ATP's own hard limits (Inside AppleTalk 2nd ed.; RT_AT_MAXREQ /
+// RT_AT_MAXRESP). Enforced, never truncated (spec %4.4).
+const rtAtMaxReq: int = 578
+const rtAtMaxResp: int = 4624
+
+// The OSErrs the spec names by number.
+const rtAtErrNoConfirm: int = -1025    // nbpNoConfirm: no such name
+const rtAtErrDuplicate: int = -1027    // nbpDuplicate: name already in use
+const rtAtErrLenErr: int = -3106       // atpLenErr: request/reply over the limit
+const rtAtErrNoBridge: int = -93       // noBridgeErr: routerless net, zone is "*"
+const rtAtErrMemFull: int = -108       // memFullErr: scratch allocation failed
+
+// Slot states. Deliberately not conn.cla's stClosed/stOpen: those name a
+// device channel, these name "this resource variable is doing something"
+// (registered / searching / serving).
+const rtAtIdle: int = 0
+const rtAtActive: int = 1
+
+// ADSP per-slot open phases (rtAdspPhase below).
+const rtAdspNone: int = 0
+const rtAdspLookup: int = 1
+const rtAdspOpening: int = 2
+const rtAdspOpen: int = 3
+
+// ---- Reverse-waist synthesized dispatchers (Task 8 synthesizes their
+// bodies, self-rooted, exactly like conn.cla's own clar_conn_fire_*
+// family -- see that module's comment for the pattern). Bare externs with
+// literal names: these are the fixed cross-task interface. ----
+external func clar_lsn_fire_accepted(slot: int, c: int)
+external func clar_lsn_fire_failed(slot: int, code: int, msg: string)
+external func clar_brs_fire_found(slot: int, name: string, addr: int)
+external func clar_brs_fire_done(slot: int)
+external func clar_brs_fire_failed(slot: int, code: int, msg: string)
+external func clar_svc_fire_request(slot: int, op: int, req: text, from: int)
+external func clar_svc_fire_failed(slot: int, code: int, msg: string)
+
+// ---- State. Parallel fixed arrays (literal sizes -- parseType's array
+// grammar needs an int LITERAL, not a named const), conn.cla's own
+// convention. Every default (0/false/"") is already the correct rest
+// state. ----
+
+// rtAtUp: the stack has been brought up at least once. rtAtalkPump does
+// nothing at all until it is true, so a program that merely DECLARES a
+// service never opens a socket (and never calls into a null host stack).
+var rtAtUp: bool
+
+var rtLsnState: int[2]
+var rtLsnPendFailedCode: int[2]
+var rtLsnPendFailedMsg: string[2]
+
+var rtBrsState: int[2]
+var rtBrsPendFailedCode: int[2]
+var rtBrsPendFailedMsg: string[2]
+
+var rtSvcState: int[2]
+var rtSvcSock: int[2]
+// rtSvcArmed: a get-request is outstanding on this slot. The pump arms
+// only when it is false and clears it the moment a request is dequeued, so
+// rtAtDevAtpArm is called EXACTLY ONCE per outstanding get-request -- a
+// re-issue into a parameter block with a live async call is the reused-PB
+// hang the Task 1 probe recorded. (Added in fix round 1; still the initial
+// declaration of this table, since atalk.cla is not on the 68k lane yet
+// and no golden pins its globals.)
+var rtSvcArmed: bool[2]
+var rtSvcInHandler: bool[2]
+var rtSvcReplied: bool[2]
+var rtSvcPendFailedCode: int[2]
+var rtSvcPendFailedMsg: string[2]
+
+// rtSvcName/rtSvcType/rtLsnName/rtLsnType: the registered NBP entity, kept
+// so stop() can call rtAtDevRemove(obj, typ) -- that waist signature takes
+// the name from its caller (the native PRemoveName needs a fresh NTE), so
+// the name has to live somewhere, and nothing else on either lane
+// remembers it. (Deviation from the task brief's global table, which
+// listed no name storage: without these, `stop` could close the socket but
+// never remove the name, and spec %4.4/%5.4 both say stop removes it --
+// a restarted server would then fail with nbpDuplicate.)
+var rtSvcName: string[2]
+var rtSvcType: string[2]
+var rtLsnName: string[2]
+var rtLsnType: string[2]
+
+// rtAdspPhase: per CONNECTION slot (8, spec %4.1's grown slot table), not
+// per listener/browser/service. 0 none, 1 lookup pending, 2 open pending,
+// 3 open.
+var rtAdspPhase: int[8]
+// rtConnSlotTransport: 0 serial (or unused), 1 ADSP. Declared HERE rather
+// than in conn.cla so conn.cla gains no global of its own for a transport
+// it cannot reach without this module; conn.cla reads it from Task 9 on
+// (this module is always spliced alongside conn.cla, both lanes).
+var rtConnSlotTransport: int[8]
+
+// rtAtLastErr: the last device-layer error this module saw, kept for
+// diagnosis on both lanes (the native twin's own PB ioResult goes here
+// too). Never part of a public contract -- every user-visible failure
+// travels as a `failed` event or lastError.
+var rtAtLastErr: int
+
+// ---- Helpers ----
+
+// rtAtEnsureUp: lazily bring the stack up (host: open the LToUDP socket
+// and acquire a node; native: OpenDriver(".MPP"), never closed). 0 on
+// success. Cheap to call repeatedly -- both lanes short-circuit once up.
+func rtAtEnsureUp(): int {
+    var e: int
+
+    e = rtAtDevUp()
+    if e != 0 {
+        rtAtLastErr = e
+        return e
+    }
+    rtAtUp = true
+    return 0
+}
+
+// rtAtRegMsg: the message for a failed NBP registration. nbpDuplicate is
+// the one the spec names ("name in use"); anything else is generic.
+func rtAtRegMsg(code: int): string {
+    if code == rtAtErrDuplicate {
+        return "name in use"
+    }
+    return "could not register name"
+}
+
+func rtSvcSetFailed(slot: int, code: int, msg: string) {
+    // Keep-first, conn.cla's own rule: the EARLIEST undrained failure is
+    // the useful one. A 0 code is never a real failure on either lane, so
+    // the code field doubles as its own "nothing pending" flag.
+    if rtSvcPendFailedCode[slot] == 0 {
+        rtSvcPendFailedCode[slot] = code
+        rtSvcPendFailedMsg[slot] = msg
+    }
+    rtAtLastErr = code
+}
+
+func rtBrsSetFailed(slot: int, code: int, msg: string) {
+    if rtBrsPendFailedCode[slot] == 0 {
+        rtBrsPendFailedCode[slot] = code
+        rtBrsPendFailedMsg[slot] = msg
+    }
+    rtAtLastErr = code
+}
+
+// rtAdspFailed: put a connection slot back to "no AppleTalk here" -- no
+// pending phase and no transport tag. Every rtAdsp* failure path and
+// rtAdspClose route through it (fix round 1): a leftover tag would send a
+// later SERIAL open on the same variable down the ADSP waist.
+func rtAdspFailed(slot: int) {
+    rtAdspPhase[slot] = rtAdspNone
+    rtConnSlotTransport[slot] = 0
+}
+
+func rtLsnSetFailed(slot: int, code: int, msg: string) {
+    if rtLsnPendFailedCode[slot] == 0 {
+        rtLsnPendFailedCode[slot] = code
+        rtLsnPendFailedMsg[slot] = msg
+    }
+    rtAtLastErr = code
+}
+
+// rtAtTextToPtr: copy a text's bytes into a fresh scratch block, the
+// pokeb marshal rtConnSendText uses (the caller disposes). ptr(0) on a
+// zero-length text OR on an allocation failure -- callers that must tell
+// the two apart check the length themselves first.
+func rtAtTextToPtr(t: text): ptr {
+    var p: ptr
+    var i: int
+    var n: int
+
+    n = t.length
+    if n == 0 {
+        return ptr(0)
+    }
+    p = SerNewPtr(n)
+    if p == ptr(0) {
+        return ptr(0)
+    }
+    i = 0
+    while i < n {
+        pokeb(p + i, int(t[i]))
+        i = i + 1
+    }
+    return p
+}
+
+// rtAtAppendBytes: append n bytes from p to t, one Toolbox-free byte at a
+// time. ponytail: per-byte append -- the batched alternative
+// (rtTextFromBytes) takes a raw text POINTER and is not reachable from a
+// `text` value, so this loop is the whole vocabulary available here. At
+// ATP sizes (<= 4624) it is bounded and cheap.
+func rtAtAppendBytes(t: text, p: ptr, n: int) {
+    var i: int
+
+    if p == ptr(0) {
+        return
+    }
+    i = 0
+    while i < n {
+        t.append(char(peekb(p + i)))
+        i = i + 1
+    }
+}
+
+// ---- Services (spec %4.4, %5.5) ----
+
+// rtSvcServe: open an ATP socket, register the NBP name pointing AT that
+// socket (the Task 1 probe finding: NBP registers the socket verbatim),
+// then arm the first get-request. Every failure is a staged `failed`
+// event -- serving is environmental from end to end.
+func rtSvcServe(h: int, name: string, typ: string) {
+    var slot: int
+    var e: int
+    var sock: int
+
+    if h == 0 {
+        rtPanic("use of nil service")
+    }
+    slot = h - 1
+    if rtSvcState[slot] == rtAtActive {
+        // Re-serving a serving variable would leak the old socket and the
+        // old name. Weather, not a bug (conn.cla treats a reopen the same
+        // way), so it stages a `failed` instead of panicking.
+        rtSvcSetFailed(slot, rtConnErrAlreadyOpen, "service already serving")
+        return
+    }
+    e = rtAtEnsureUp()
+    if e != 0 {
+        rtSvcSetFailed(slot, e, "AppleTalk unavailable")
+        return
+    }
+    sock = rtAtDevAtpOpen()
+    if sock <= 0 {
+        rtSvcSetFailed(slot, rtAtDevLastErr(), "could not open socket")
+        return
+    }
+    e = rtAtDevRegister(name, typ, sock)
+    if e != 0 {
+        rtAtDevAtpClose(sock)
+        rtSvcSetFailed(slot, e, rtAtRegMsg(e))
+        return
+    }
+    rtSvcSock[slot] = sock
+    rtSvcName[slot] = name
+    rtSvcType[slot] = typ
+    rtSvcState[slot] = rtAtActive
+    rtSvcArmed[slot] = false
+    e = rtAtDevAtpArm(slot, sock)
+    if e != 0 {
+        // The socket and the name are live; only the receive arm failed.
+        // Stay serving and let the pump retry the arm each pass.
+        rtSvcSetFailed(slot, e, "could not receive requests")
+    } else {
+        rtSvcArmed[slot] = true
+    }
+}
+
+// rtSvcReply: the ONE contract-checked entry point in this file besides
+// the nil checks -- calling it outside a request handler, or twice inside
+// one, is a program bug (spec %4.4), so both panic. A reply over ATP's
+// 4624-byte ceiling is not a bug though: it is weather (a `failed` event)
+// PLUS the automatic -1 reply, so the requester never waits out its
+// timeout (spec %4.4's own wording).
+func rtSvcReply(h: int, code: int, data: text) {
+    var slot: int
+    var n: int
+    var e: int
+    var scratch: ptr
+
+    if h == 0 {
+        rtPanic("use of nil service")
+    }
+    slot = h - 1
+    if not rtSvcInHandler[slot] {
+        rtPanic("reply outside a request handler")
+    }
+    if rtSvcReplied[slot] {
+        rtPanic("reply already sent")
+    }
+    // Set BEFORE any early return below: every path from here answers the
+    // request exactly once, and the pump's own auto-reply must not add a
+    // second response on top of the -1 the over-length path sends.
+    rtSvcReplied[slot] = true
+    n = data.length
+    if n > rtAtMaxResp {
+        rtSvcSetFailed(slot, rtAtErrLenErr, "reply too long")
+        rtAtDevAtpRespond(slot, -1, ptr(0), 0)
+        return
+    }
+    if n == 0 {
+        e = rtAtDevAtpRespond(slot, code, ptr(0), 0)
+        if e != 0 {
+            rtSvcSetFailed(slot, e, "reply failed")
+        }
+        return
+    }
+    scratch = rtAtTextToPtr(data)
+    if scratch == ptr(0) {
+        rtSvcSetFailed(slot, rtAtErrMemFull, "reply failed")
+        rtAtDevAtpRespond(slot, -1, ptr(0), 0)
+        return
+    }
+    // rtAtDevAtpRespond copies into the slot's own reply buffer (native:
+    // the async PSendResponse reads from THAT buffer, not from here), so
+    // the scratch goes back immediately.
+    e = rtAtDevAtpRespond(slot, code, scratch, n)
+    SerDisposePtr(scratch)
+    if e != 0 {
+        rtSvcSetFailed(slot, e, "reply failed")
+    }
+}
+
+// rtSvcReplyStr: `string` converts to `text` at a call argument (Ch3), so
+// the string form is the text form with no second marshal path.
+func rtSvcReplyStr(h: int, code: int, s: string) {
+    rtSvcReply(h, code, s)
+}
+
+// rtSvcStop: remove the name, close the socket. Idempotent (spec %4.4).
+func rtSvcStop(h: int) {
+    var slot: int
+
+    if h == 0 {
+        rtPanic("use of nil service")
+    }
+    slot = h - 1
+    if rtSvcState[slot] != rtAtActive {
+        return
+    }
+    rtAtDevRemove(rtSvcName[slot], rtSvcType[slot])
+    rtAtDevAtpClose(rtSvcSock[slot])
+    rtSvcState[slot] = rtAtIdle
+    rtSvcArmed[slot] = false
+    rtSvcSock[slot] = 0
+    rtSvcName[slot] = ""
+    rtSvcType[slot] = ""
+}
+
+// rtSvcCallAddr: the synchronous requester (spec %4.4, Q3). true only when
+// a response arrived AND its code is 0; `reply` holds the payload either
+// way. Uses the requester's own socket, so a serving variable may call.
+func rtSvcCallAddr(h: int, addr: int, op: int, req: text, reply: text): bool {
+    var e: int
+    var n: int
+    var code: int
+    var p: ptr
+
+    if h == 0 {
+        rtPanic("use of nil service")
+    }
+    if req.length > rtAtMaxReq {
+        rtSetLastErr(rtAtErrLenErr, "request too long")
+        return false
+    }
+    e = rtAtEnsureUp()
+    if e != 0 {
+        rtSetLastErr(e, "AppleTalk unavailable")
+        return false
+    }
+    p = rtAtTextToPtr(req)
+    if p == ptr(0) and req.length > 0 {
+        rtSetLastErr(rtAtErrMemFull, "out of memory")
+        return false
+    }
+    // Blocks up to timeout x retries (2 s x 3, fixed this phase). Incoming
+    // requests queue while it blocks; they are answered from the pump.
+    n = rtAtDevAtpCall(addr, op, p, req.length)
+    if p != ptr(0) {
+        SerDisposePtr(p)
+    }
+    if n < 0 {
+        rtAtLastErr = n
+        rtSetLastErr(n, "no response")
+        return false
+    }
+    code = rtAtDevAtpCallCode()
+    reply.clear()
+    rtAtAppendBytes(reply, rtAtDevAtpCallPtr(), n)
+    if code != 0 {
+        rtSetLastErr(code, "service")
+        return false
+    }
+    return true
+}
+
+// rtSvcCallName: the "Name:Type" target form -- a SYNCHRONOUS NBP lookup
+// (lookup slot 9, borrowed for exactly the duration of this call) and then
+// the address form. The spin is what makes it synchronous: the host's
+// lookup window is 3 x 1 s of real time driven by rtAtDevPoll; the native
+// twin's PLookupName is issued sync and comes back done on the first
+// LookupDone call, so the loop body never runs there.
+//
+// A program can never call its OWN registered name on the host lane: the
+// LToUDP stack drops its own datagrams (rt_atalk.inc's sender id), so the
+// lookup finds nothing and this returns false with nbpNoConfirm. Call by
+// address, or from a second process, to reach a local service on the host.
+func rtSvcCallName(h: int, name: string, op: int, req: text, reply: text): bool {
+    var e: int
+    var addr: int
+    var idx: int
+
+    if h == 0 {
+        rtPanic("use of nil service")
+    }
+    // Hoisted above the lookup (Task 8 review, spec %4.4: an over-length
+    // request is rejected "before any packet leaves"). rtSvcCallAddr
+    // checks it too, but only after this function has already spent an
+    // NBP lookup on the wire finding a service it will refuse to call.
+    if req.length > rtAtMaxReq {
+        rtSetLastErr(rtAtErrLenErr, "request too long")
+        return false
+    }
+    // "Name:Type" -- split at the first colon (Clarus has no by-reference
+    // string out-params, and two locals beat a pair of scratch globals).
+    idx = name.indexOf(':')
+    if idx < 0 {
+        rtSetLastErr(rtAtErrNoConfirm, "name not found")
+        return false
+    }
+    e = rtAtEnsureUp()
+    if e != 0 {
+        rtSetLastErr(e, "AppleTalk unavailable")
+        return false
+    }
+    e = rtAtDevLookupStart(rtAtNameCallLk, name[0, idx], name[idx + 1, name.length - idx - 1], "*")
+    if e != 0 {
+        rtAtLastErr = e
+        rtSetLastErr(e, "name not found")
+        return false
+    }
+    while not rtAtDevLookupDone(rtAtNameCallLk) {
+        rtAtDevPoll()
+    }
+    if rtAtDevLookupCount(rtAtNameCallLk) == 0 {
+        rtSetLastErr(rtAtErrNoConfirm, "name not found")
+        return false
+    }
+    addr = rtAtDevLookupAddr(rtAtNameCallLk, 0)
+    return rtSvcCallAddr(h, addr, op, req, reply)
+}
+
+// ---- Service browsers (spec %4.3, %5.6) ----
+
+// rtBrsFind: an NBP lookup of "=:typ@zone" on the browser's own lookup
+// slot. `zone` is "*" from the one-argument form (lowering passes it);
+// an empty string is treated the same way rather than reaching the wire.
+func rtBrsFind(h: int, typ: string, zone: string) {
+    var slot: int
+    var e: int
+    var z: string
+
+    if h == 0 {
+        rtPanic("use of nil serviceBrowser")
+    }
+    slot = h - 1
+    z = zone
+    if z == "" {
+        z = "*"
+    }
+    e = rtAtEnsureUp()
+    if e != 0 {
+        rtBrsSetFailed(slot, e, "AppleTalk unavailable")
+        return
+    }
+    e = rtAtDevLookupStart(slot, "=", typ, z)
+    if e != 0 {
+        rtBrsSetFailed(slot, e, "lookup failed")
+        return
+    }
+    rtBrsState[slot] = rtAtActive
+}
+
+// rtBrsZones: synchronous, and never fails from the caller's point of
+// view -- a routerless LocalTalk net (noBridgeErr), a missing .XPP, or any
+// other error all yield the one-element list ["*"], so programs never
+// special-case the routerless case (spec %4.3). The host lane always takes
+// that path: its stack has no ZIP at all.
+func rtBrsZones(h: int, out: list of string) {
+    if h == 0 {
+        rtPanic("use of nil serviceBrowser")
+    }
+    out.clear()
+    if rtAtEnsureUp() != 0 or rtAtDevZones(out) != 0 or out.count == 0 {
+        out.clear()
+        out.add("*")
+    }
+}
+
+// ---- Listeners (spec %4.2, %5.4) ----
+
+// rtLsnRegister: an ADSP connection listener plus the NBP registration of
+// its own DDP socket. On the host lane rtLsnDevInit returns rtAtErrNoHost
+// and this stages the spec's own "streams not available on this lane"
+// failure before any name is registered.
+func rtLsnRegister(h: int, name: string, typ: string) {
+    var slot: int
+    var e: int
+
+    if h == 0 {
+        rtPanic("use of nil listener")
+    }
+    slot = h - 1
+    if rtLsnState[slot] == rtAtActive {
+        rtLsnSetFailed(slot, rtConnErrAlreadyOpen, "listener already registered")
+        return
+    }
+    e = rtAtEnsureUp()
+    if e != 0 {
+        rtLsnSetFailed(slot, e, "AppleTalk unavailable")
+        return
+    }
+    e = rtLsnDevInit(slot)
+    if e != 0 {
+        if e == rtAtErrNoHost {
+            rtLsnSetFailed(slot, e, "streams not available on this lane")
+        } else {
+            rtLsnSetFailed(slot, e, "could not start listener")
+        }
+        return
+    }
+    e = rtAtDevRegister(name, typ, rtLsnDevSocket(slot))
+    if e != 0 {
+        rtLsnDevRemove(slot)
+        rtLsnSetFailed(slot, e, rtAtRegMsg(e))
+        return
+    }
+    e = rtLsnDevListen(slot)
+    if e != 0 {
+        rtAtDevRemove(name, typ)
+        rtLsnDevRemove(slot)
+        rtLsnSetFailed(slot, e, "could not start listener")
+        return
+    }
+    rtLsnName[slot] = name
+    rtLsnType[slot] = typ
+    rtLsnState[slot] = rtAtActive
+}
+
+// rtLsnStop: remove the name and the listener. Idempotent (spec %4.2).
+func rtLsnStop(h: int) {
+    var slot: int
+
+    if h == 0 {
+        rtPanic("use of nil listener")
+    }
+    slot = h - 1
+    if rtLsnState[slot] != rtAtActive {
+        return
+    }
+    rtAtDevRemove(rtLsnName[slot], rtLsnType[slot])
+    rtLsnDevRemove(slot)
+    rtLsnState[slot] = rtAtIdle
+    rtLsnName[slot] = ""
+    rtLsnType[slot] = ""
+}
+
+// ---- ADSP: connection transport 1 (spec %4.1, %5.3) ----
+
+// rtAdspOpenName: `c.open(appletalk "Name:Type")`. Starts the NBP lookup
+// on the connection slot's own lookup slot (slot + 2); rtAdspPoll drives
+// the rest. 0 means "started", not "open".
+//
+// Both rtAdspOpen* own the slot's transport tag: they set it to 1 only
+// once the attempt is actually under way, and every failure path here and
+// in rtAdspPoll puts it (and the phase) back to 0/none, so a caller that
+// stages a `failed` and later reopens the same variable over SERIAL is
+// never dispatched to ADSP by a leftover tag.
+func rtAdspOpenName(slot: int, spec: string): int {
+    var e: int
+    var idx: int
+
+    idx = spec.indexOf(':')
+    if idx < 0 {
+        return rtAtErrNoConfirm
+    }
+    e = rtAtEnsureUp()
+    if e != 0 {
+        return e
+    }
+    e = rtAtDevLookupStart(slot + 2, spec[0, idx], spec[idx + 1, spec.length - idx - 1], "*")
+    if e != 0 {
+        rtAtLastErr = e
+        rtAdspFailed(slot)
+        return e
+    }
+    rtAdspPhase[slot] = rtAdspLookup
+    rtConnSlotTransport[slot] = 1
+    return 0
+}
+
+// rtAdspOpenAddr: `c.open(addr)` -- no lookup step, straight to the ADSP
+// open (spec %5.3).
+func rtAdspOpenAddr(slot: int, addr: int): int {
+    var e: int
+
+    e = rtAtEnsureUp()
+    if e != 0 {
+        return e
+    }
+    e = rtAdspDevOpen(slot, addr)
+    if e != 0 {
+        rtAtLastErr = e
+        rtAdspFailed(slot)
+        return e
+    }
+    rtAdspPhase[slot] = rtAdspOpening
+    rtConnSlotTransport[slot] = 1
+    return 0
+}
+
+// rtAdspPoll: one step of the per-slot open state machine, called from
+// conn.cla's pump (Task 9) for every slot whose transport is 1. 1 once the
+// connection BECAME open (reported exactly once -- an already-open slot
+// answers 0, so the pump cannot fire `opened` twice), 0 while pending,
+// the device error code (< 0) on failure.
+func rtAdspPoll(slot: int): int {
+    var e: int
+    var addr: int
+
+    if rtAdspPhase[slot] == rtAdspLookup {
+        if not rtAtDevLookupDone(slot + 2) {
+            return 0
+        }
+        if rtAtDevLookupCount(slot + 2) == 0 {
+            rtAdspFailed(slot)
+            return rtAtErrNoConfirm
+        }
+        addr = rtAtDevLookupAddr(slot + 2, 0)
+        e = rtAdspDevOpen(slot, addr)
+        if e != 0 {
+            rtAtLastErr = e
+            rtAdspFailed(slot)
+            return e
+        }
+        rtAdspPhase[slot] = rtAdspOpening
+        return 0
+    }
+    if rtAdspPhase[slot] == rtAdspOpening {
+        e = rtAdspDevOpenPoll(slot)
+        if e == 1 {
+            rtAdspPhase[slot] = rtAdspOpen
+            return 1
+        }
+        if e < 0 {
+            rtAtLastErr = e
+            rtAdspFailed(slot)
+            return e
+        }
+        return 0
+    }
+    return 0
+}
+
+func rtAdspAvail(slot: int): int {
+    return rtAdspDevAvail(slot)
+}
+
+// rtAdspReadInto: drain up to 1024 currently-available bytes into t with
+// ONE device read (spec %5.3's batched-read upgrade to conn.cla's
+// byte-at-a-time ponytail note). Returns the number of bytes appended.
+// The 1024 ceiling matches the per-slot ADSP receive queue.
+func rtAdspReadInto(slot: int, t: text): int {
+    var n: int
+    var got: int
+    var scratch: ptr
+
+    n = rtAdspDevAvail(slot)
+    if n <= 0 {
+        return 0
+    }
+    if n > 1024 {
+        n = 1024
+    }
+    scratch = SerNewPtr(n)
+    if scratch == ptr(0) {
+        rtAtLastErr = rtAtErrMemFull
+        return 0
+    }
+    got = rtAdspDevRead(slot, scratch, n)
+    if got < 0 {
+        rtAtLastErr = got
+        got = 0
+    }
+    rtAtAppendBytes(t, scratch, got)
+    SerDisposePtr(scratch)
+    return got
+}
+
+func rtAdspWrite(slot: int, p: ptr, n: int): int {
+    return rtAdspDevWrite(slot, p, n)
+}
+
+func rtAdspClose(slot: int) {
+    rtAdspDevClose(slot)
+    rtAdspFailed(slot)
+}
+
+func rtAdspGone(slot: int): bool {
+    return rtAdspDevGone(slot)
+}
+
+// rtConnOpenAddr: `connection.open(addr)` -- the address form of an
+// AppleTalk open, tagged transport 1 so conn.cla's pump (Task 9) polls
+// rtAdspPoll for this slot. An immediate failure stages conn.cla's own
+// pending `failed`; success is reported by that pump, never from here
+// (conn.cla's "not inside open itself" rule).
+func rtConnOpenAddr(h: int, addr: int) {
+    var slot: int
+    var e: int
+
+    if h == 0 {
+        rtPanic("use of nil connection")
+    }
+    slot = h - 1
+    // Same contract as rtConnOpen (conn.cla): reopening an already-open
+    // slot is weather, not a bug.
+    if rtConnState[slot] == stOpen {
+        rtConnSetFailed(slot, rtConnErrAlreadyOpen, "connection already open")
+        return
+    }
+    // rtAdspOpenAddr owns the slot's transport tag and phase, including
+    // putting both back on failure -- see its own comment.
+    e = rtAdspOpenAddr(slot, addr)
+    if e != 0 {
+        rtConnSetFailed(slot, e, "could not open connection")
+    }
+}
+
+// ---- The pump ----
+
+// rtAtalkPump: one event-loop pass. Called from the compiler-synthesized
+// clar_conn_pump() beside rtConnPump (spec %5.7), so neither the native UI
+// loop nor the host CLI loop needs a new hook.
+//
+// Per slot, in this order: drain a staged `failed` first (so a failure
+// always precedes whatever the device does next), then service the slot.
+// Services answer at most ONE request per pass and always answer it before
+// the next slot is polled -- the device layer answers "the last dequeued
+// request", so dequeuing a second one before replying would strand the
+// first (reqFailed, -1096).
+func rtAtalkPump() {
+    var i: int
+    var code: int
+    var pr: int
+    var n: int
+    var req: text
+    var free: int
+    var j: int
+    var e: int
+
+    if not rtAtUp {
+        return
+    }
+    rtAtDevPoll()
+
+    // ---- services ----
+    i = 0
+    while i < rtSvcMax {
+        if rtSvcPendFailedCode[i] != 0 {
+            code = rtSvcPendFailedCode[i]
+            rtSvcPendFailedCode[i] = 0
+            clar_svc_fire_failed(i, code, rtSvcPendFailedMsg[i])
+            rtSvcPendFailedMsg[i] = ""
+        }
+        if rtSvcState[i] == rtAtActive and not rtAtDevAtpRespBusy(i) {
+            pr = rtAtDevAtpPoll(i)
+            if pr < 0 {
+                // The get-request completed WITH an error, so the slot's
+                // parameter block is free again -- clearing armed is what
+                // lets the arm below re-issue it. Without this the slot
+                // silently stops serving after one native PGetRequest
+                // error (the host lane never returns < 0 here).
+                rtSvcArmed[i] = false
+                rtSvcSetFailed(i, pr, "request failed")
+            } else if pr == 1 {
+                rtSvcArmed[i] = false
+                n = rtAtDevAtpReqLen(i)
+                if n > rtAtMaxReq {
+                    n = rtAtMaxReq
+                }
+                req = ""
+                rtAtAppendBytes(req, rtAtDevAtpReqPtr(i), n)
+                rtSvcInHandler[i] = true
+                rtSvcReplied[i] = false
+                clar_svc_fire_request(i, rtAtDevAtpReqOp(i), req, rtAtDevAtpReqFrom(i))
+                rtSvcInHandler[i] = false
+                if not rtSvcReplied[i] {
+                    // Spec %4.4: a handler that returns without replying
+                    // gets an automatic empty reply with code -1, so the
+                    // requester never waits out its timeout.
+                    rtSvcReplied[i] = true
+                    rtAtDevAtpRespond(i, -1, ptr(0), 0)
+                }
+            }
+            // Re-arm only once the reply is off the wire (the native lane
+            // sends responses asynchronously, so this is checked fresh) AND
+            // only when nothing is armed already: rtAtDevAtpArm re-issues
+            // into the slot's own parameter block, and doing that while an
+            // async PGetRequest is live is the reused-PB hang.
+            if not rtSvcArmed[i] and not rtAtDevAtpRespBusy(i) {
+                if rtAtDevAtpArm(i, rtSvcSock[i]) == 0 {
+                    rtSvcArmed[i] = true
+                }
+            }
+        }
+        i = i + 1
+    }
+
+    // ---- browsers ----
+    i = 0
+    while i < rtBrsMax {
+        if rtBrsPendFailedCode[i] != 0 {
+            code = rtBrsPendFailedCode[i]
+            rtBrsPendFailedCode[i] = 0
+            clar_brs_fire_failed(i, code, rtBrsPendFailedMsg[i])
+            rtBrsPendFailedMsg[i] = ""
+        } else if rtBrsState[i] == rtAtActive and rtAtDevLookupDone(i) {
+            rtBrsState[i] = rtAtIdle
+            n = rtAtDevLookupCount(i)
+            j = 0
+            // The state test is the loop's real bound: a `found` handler may
+            // call find() again on this browser, which restarts THIS lookup
+            // slot (the device layer zeroes it), so every remaining tuple of
+            // the old search is already gone -- firing them would deliver
+            // empty names and address 0. They are dropped instead, and the
+            // new search owns the slot from here.
+            while j < n and rtBrsState[i] == rtAtIdle {
+                clar_brs_fire_found(i, rtAtDevLookupName(i, j), rtAtDevLookupAddr(i, j))
+                j = j + 1
+            }
+            // `done` in the SAME pass, right after the founds (spec %4.3's
+            // "then done") -- unless a `found` handler started a NEW search
+            // on this browser, which owns the slot from here and gets its
+            // own `done` when ITS window closes. Firing this one anyway
+            // would be a spurious early `done` for that search.
+            if rtBrsState[i] == rtAtIdle {
+                clar_brs_fire_done(i)
+            }
+        }
+        i = i + 1
+    }
+
+    // ---- listeners ----
+    i = 0
+    while i < rtLsnMax {
+        if rtLsnPendFailedCode[i] != 0 {
+            code = rtLsnPendFailedCode[i]
+            rtLsnPendFailedCode[i] = 0
+            clar_lsn_fire_failed(i, code, rtLsnPendFailedMsg[i])
+            rtLsnPendFailedMsg[i] = ""
+        }
+        if rtLsnState[i] == rtAtActive {
+            pr = rtLsnDevPoll(i)
+            if pr < 0 {
+                rtLsnSetFailed(i, pr, "listener failed")
+            } else if pr == 1 {
+                free = -1
+                j = 0
+                while j < rtConnMax {
+                    if free < 0 and rtConnState[j] == stClosed and rtAdspPhase[j] == rtAdspNone {
+                        free = j
+                    }
+                    j = j + 1
+                }
+                if free < 0 {
+                    // Spec %4.2: all slots taken -> deny, and the client's
+                    // own open fails. Not a failure of THIS program.
+                    rtLsnDevDeny(i)
+                } else {
+                    e = rtLsnDevAccept(i, free)
+                    if e != 0 {
+                        rtLsnSetFailed(i, e, "could not accept connection")
+                    } else {
+                        rtConnState[free] = stOpen
+                        rtConnSlotTransport[free] = 1
+                        rtAdspPhase[free] = rtAdspOpen
+                        // spec %4.2: no `opened` fires for an accepted
+                        // connection -- `accepted` IS the event.
+                        clar_lsn_fire_accepted(i, free + 1)
+                    }
+                }
+                rtLsnDevListen(i)
+            }
+        }
+        i = i + 1
+    }
+}
+
+// rtAtalkAlive: the host CLI pump loop's own lifetime condition (spec
+// %5.7) -- any service serving, any listener registered, any browser
+// searching, or any event still waiting to be drained.
+func rtAtalkAlive(): bool {
+    var i: int
+
+    i = 0
+    while i < rtSvcMax {
+        if rtSvcState[i] == rtAtActive or rtSvcPendFailedCode[i] != 0 {
+            return true
+        }
+        i = i + 1
+    }
+    i = 0
+    while i < rtBrsMax {
+        if rtBrsState[i] == rtAtActive or rtBrsPendFailedCode[i] != 0 {
+            return true
+        }
+        i = i + 1
+    }
+    // A connection slot mid-ADSP-open still owes an `opened` or a `failed`,
+    // and neither rtConnAlive (the slot is not stOpen yet, and conn.cla has
+    // nothing staged) nor anything above would hold the loop open for it.
+    i = 0
+    while i < rtConnMax {
+        if rtAdspPhase[i] != rtAdspNone and rtAdspPhase[i] != rtAdspOpen {
+            return true
+        }
+        i = i + 1
+    }
+    i = 0
+    while i < rtLsnMax {
+        if rtLsnState[i] == rtAtActive or rtLsnPendFailedCode[i] != 0 {
+            return true
+        }
+        i = i + 1
+    }
+    return false
+}
+
+// rtAtalkAddrStr: `string(addr)` (spec %4.3) -- "net.node.socket" from the
+// packed net<<16 | node<<8 | socket the whole waist passes addresses as.
+func rtAtalkAddrStr(addr: int): string {
+    return string((addr >> 16) & 0xFFFF) + "." + string((addr >> 8) & 0xFF) + "." + string(addr & 0xFF)
+}
diff --git a/runtime/clarus/atalk_68k.cla b/runtime/clarus/atalk_68k.cla
new file mode 100644
index 0000000..226cb42
--- /dev/null
+++ b/runtime/clarus/atalk_68k.cla
@@ -0,0 +1,1450 @@
+// Copyright 2026, Andrew C. Young <andrew@vaelen.org>
+// SPDX-License-Identifier: MIT
+
+// atalk_68k.cla: the native (68k) AppleTalk waist -- atalk_c.cla's twin,
+// same rtAtDev*/rtAdspDev*/rtLsnDev* names, one file spliced per lane
+// (the conn_68k.cla/conn_c.cla precedent). Real Device Manager Control /
+// Status calls against the four AppleTalk drivers, every csCode and
+// offset taken from toolbox/appletalk.cla (Task 6's catalog), which is
+// itself transcribed from Apple's Universal Interfaces.
+//
+// FIVE RULES this file obeys, all of them paid for on hardware:
+//
+// 1. EVERY parameter block is fully re-zeroed before EVERY reuse. A
+//    reused NBP block hung the emulated Mac three times in the Task 1
+//    probe wave. rtAt68Zero is the whole discipline; a block that is
+//    still async-live is never re-zeroed (see rule 2).
+// 2. An async parameter block belongs to the driver until its ioResult
+//    stops being 1. Nothing reissues into a live block: lookups spin the
+//    old one out first, PGetRequest is armed exactly once per
+//    outstanding request (atalk.cla's rtSvcArmed), and the calls that
+//    must run WHILE a block is live (dspCLDeny, dspCLRemove, dspClose,
+//    dspRemove) use the separate rtAt68DspAux block instead.
+// 3. `peekw` ZERO-extends, but ioResult and every other `word` that can
+//    be negative is signed: rtAt68SignW does the correction, and the
+//    "still pending" test is `== 1` (ioInProgress) rather than a sign-
+//    dependent comparison. `-39` read raw is 65497, which no `<= 0`
+//    completion poll would ever see.
+// 4. NBP registers the socket VERBATIM: a service writes its own ATP
+//    socket into the NTE's address+3 byte before registerName, and a
+//    listener writes its own DDP socket there. A program's own address
+//    is read back out of the same four bytes afterwards.
+// 5. `ptr` is not a legal container element (language reference,
+//    Ch13), so every per-slot block address lives in an `int[]` and
+//    round-trips through int()/ptr(). That is exact on this lane: a
+//    68k `int` is 32 bits and so is a 68k address. (The task brief's
+//    global table wrote these as `ptr[n]`; the language does not allow
+//    it, and atalk_c.cla's own header records the same constraint.)
+//
+// The .XPP and .DSP drivers ship in the AppleTalk System file, not in
+// ROM, so both may be ABSENT (-43) -- notably on LaunchAPPL's stripped
+// boot disk. rtAtDevUp tolerates that: rtAt68XppRef 0 makes rtAtDevZones
+// answer noBridgeErr (atalk.cla then substitutes ["*"]), and
+// rtAt68DspRef 0 makes every rtAdspDev*/rtLsnDev* entry answer
+// rtAtErrNoHost -- the spec's own ".DSP missing" path, identical to what
+// the host lane reports.
+
+include "../../toolbox/appletalk.cla"
+include "../../toolbox/devices.cla"
+include "../../toolbox/files.cla"
+include "../../toolbox/memory.cla"
+
+// ---- Block sizes ----
+//
+// rtAt68LkBufSz is 4096, not the plan's 2048: a LookupName reply tuple is
+// AddrBlock(4) + enumerator(1) + three packed Pascal strings of up to 32
+// bytes each, so 32 tuples (the plan's own maxToGet) is at most 32 x 104
+// = 3328 bytes. At 2048 a full zone would answer nbpBuffOvr instead of
+// the tuples -- the sizing trap cases_atalk.cla's own lookup comment
+// records. The buffer is allocated LAZILY per lookup slot, so a program
+// with one browser pays 4 KB, not 44.
+const rtAt68LkBufSz: int = 4096
+const rtAt68EntSz: int = 104      // three packed Pascal strings, 32 max each
+const rtAt68PbSz: int = 56        // atpSize -- the widest MPP/ATP block
+const rtAt68DspPbSz: int = 68     // sizeof(DSPParamBlock)
+const rtAt68ReqBufSz: int = 600   // >= atpMaxData (578)
+const rtAt68BdsSz: int = 96       // 8 x bdsEntrySz
+const rtAt68QSz: int = 1024       // ADSP send/receive queue
+
+// NBP parameter-block field offsets the catalog names only as record
+// FIELDS (interval/count sit inside the union-free prefix at 28/29). Kept
+// local rather than added to toolbox/appletalk.cla: the catalog's own
+// offset block is the "blocks allocated with NewPtrClear" surface Task 6
+// froze, and these two are only needed here.
+const rtAt68NbpInterval: int = 28
+const rtAt68NbpCount: int = 29
+
+// ATPParam offsets, for the two ATP blocks that must survive an async
+// call (PGetRequest, PSendResponse). Same bytes as the record fields of
+// the same names in toolbox/appletalk.cla; ATPmisc1/ATPmisc2's union arms
+// are already named there (atpBitMap/atpBdsSize/atpTransID).
+const rtAt68AtpSocket: int = 28
+const rtAt68AtpFlags: int = 29
+const rtAt68AtpAddrNet: int = 30
+const rtAt68AtpAddrNode: int = 32
+const rtAt68AtpAddrSkt: int = 33
+const rtAt68AtpReqLength: int = 34
+const rtAt68AtpReqPointer: int = 36
+const rtAt68AtpBdsPointer: int = 40
+const rtAt68AtpNumOfBuffs: int = 44
+
+// BDSElement offsets (AppleTalk.h:330-335), for the arrays built by hand.
+const rtAt68BdsBuffSize: int = 0
+const rtAt68BdsBuffPtr: int = 2
+const rtAt68BdsDataSize: int = 6
+const rtAt68BdsUserBytes: int = 8
+
+// ---- Driver refNums + liveness ----
+var rtAt68MppRef: int
+var rtAt68AtpRef: int
+var rtAt68XppRef: int
+var rtAt68DspRef: int
+var rtAt68Up: bool
+var rtAt68LastErr: int
+
+// ---- Lookup slots (atalk.cla's rtAtLookupMax = 11: 2 browsers, 8
+// connection slots at slot+2, and slot 10 for a synchronous name-call).
+// All three blocks per slot are allocated on first use and never freed --
+// a lookup slot is reused for the life of the program. ----
+var rtAt68LkPb: int[11]
+var rtAt68LkEntity: int[11]
+var rtAt68LkBuf: int[11]
+
+// ---- NBP registrations. A NamesTableEntry is linked into the driver's
+// own names table and must stay put until RemoveName, so it cannot be a
+// per-call local. rtAtDevRegister/-Remove take no slot index (the waist
+// signature is the host lane's), so this is a small pool: at most 2
+// services + 2 listeners can be registered at once (spec %4.5's caps).
+// Remove finds its entry by comparing the caller's object/type against
+// the PACKED ENTITY already sitting in the NTE, rather than keeping a
+// parallel string[4] pair -- two of those would be 2 KB of A5 globals in
+// every native program, spliced or not, for four names. ----
+var rtAt68Nte: int[4]
+var rtAt68NteUsed: bool[4]
+
+// ---- Service slots (2). getPb carries the async PGetRequest, respPb the
+// async PSendResponse; the request snapshot is taken at completion
+// because the block is re-armed underneath it. ----
+var rtAt68SvcGetPb: int[2]
+var rtAt68SvcReqBuf: int[2]
+var rtAt68SvcRespPb: int[2]
+var rtAt68SvcRespBuf: int[2]
+var rtAt68SvcBds: int[2]
+var rtAt68SvcSock: int[2]
+var rtAt68SvcGetLive: bool[2]
+var rtAt68SvcReqOp: int[2]
+var rtAt68SvcReqFrom: int[2]
+var rtAt68SvcReqLen: int[2]
+var rtAt68SvcTransID: int[2]
+var rtAt68SvcXO: int[2]
+
+// ---- Requester (rtSvcCallAddr is synchronous, so one set is enough). ----
+var rtAt68CallBuf: ptr
+var rtAt68CallBds: ptr
+var rtAt68CallCode: int
+
+// ---- Listener slots (2). ----
+var rtAt68LsnCcb: int[2]
+var rtAt68LsnPb: int[2]
+var rtAt68LsnRef: int[2]
+var rtAt68LsnLive: bool[2]
+
+// ---- Connection slots (8, spec %4.1's grown table). The CCB, the two
+// queues and the attention buffer are ADSP's for the life of the
+// connection end and come back on close (so Task 11's AdspLeak can prove
+// FreeMem flat); the parameter block is reused, re-zeroed, for open /
+// read / write / status. ----
+var rtAt68Ccb: int[8]
+var rtAt68Pb: int[8]
+var rtAt68SendQ: int[8]
+var rtAt68RecvQ: int[8]
+var rtAt68Attn: int[8]
+var rtAt68CcbRef: int[8]
+var rtAt68OpenLive: bool[8]
+
+// rtAt68DspAux: the one DSP block used by calls that must run while some
+// OTHER block on the same connection end is still async-live -- dspClose,
+// dspRemove, dspCLDeny, dspCLRemove (rule 2). Re-zeroed per use.
+var rtAt68DspAux: ptr
+
+// ---- Primitives ----
+
+// rtAt68SignW: peekw and a `word` field disagree -- peekw zero-extends,
+// so every 16-bit value that can be negative (ioResult, a driver refNum,
+// an OSErr) comes back through here.
+func rtAt68SignW(v: int): int {
+    if v >= 32768 {
+        return v - 65536
+    }
+    return v
+}
+
+// rtAt68Zero: rule 1. Longword-at-a-time with a byte tail.
+func rtAt68Zero(p: ptr, n: int) {
+    var i: int
+
+    if p == ptr(0) {
+        return
+    }
+    i = 0
+    while i + 4 <= n {
+        pokel(p + i, 0)
+        i = i + 4
+    }
+    while i < n {
+        pokeb(p + i, 0)
+        i = i + 1
+    }
+}
+
+// rtAt68Pending: true while the driver still owns this async block.
+// ioResult is exactly 1 (ioInProgress) until the call completes.
+func rtAt68Pending(pb: ptr): bool {
+    if pb == ptr(0) {
+        return false
+    }
+    return peekw(pb + pbIoResult) == 1
+}
+
+// rtAt68Result: the completed block's OSErr, sign-corrected.
+func rtAt68Result(pb: ptr): int {
+    return rtAt68SignW(peekw(pb + pbIoResult))
+}
+
+// rtAt68PStr writes s as a Pascal string at p (clamped to NBP's own
+// 32-byte name limit) and returns the address one byte past its end, so
+// three calls in a row build the PACKED object/type/zone entity NBP wants
+// -- cases_atalk.cla's `atPStr`, the hardware-proved original.
+func rtAt68PStr(p: ptr, s: string): ptr {
+    var i: int
+    var n: int
+
+    n = s.length
+    if n > 32 {
+        n = 32
+    }
+    pokeb(p, n)
+    i = 0
+    while i < n {
+        pokeb(p + 1 + i, int(s[i]))
+        i = i + 1
+    }
+    return p + 1 + n
+}
+
+// rtAt68GetPStr reads the Pascal string at p back out as a string.
+func rtAt68GetPStr(p: ptr): string {
+    var s: string
+    var i: int
+    var n: int
+
+    n = peekb(p)
+    i = 0
+    while i < n {
+        s = s + char(peekb(p + 1 + i))
+        i = i + 1
+    }
+    return s
+}
+
+// rtAt68SkipPStr: the address one byte past the Pascal string at p.
+func rtAt68SkipPStr(p: ptr): ptr {
+    return p + 1 + peekb(p)
+}
+
+// rtAt68PackAddr / the three unpackers: the whole waist passes an
+// AppleTalk address as net << 16 | node << 8 | socket (atalk.cla's
+// rtAtalkAddrStr prints exactly that), while the wire form is an
+// AddrBlock: net(2) node(1) socket(1).
+func rtAt68PackAddr(p: ptr): int {
+    return (peekw(p) << 16) + (peekb(p + 2) << 8) + peekb(p + 3)
+}
+
+func rtAt68PokeAddr(p: ptr, addr: int) {
+    pokew(p, (addr >> 16) & 0xFFFF)
+    pokeb(p + 2, (addr >> 8) & 0xFF)
+    pokeb(p + 3, addr & 0xFF)
+}
+
+// rtAt68OpenDrv: PBOpenSync a named driver. 0 (never a legal refNum) on
+// any failure, with the OSErr left in rtAt68LastErr -- .XPP and .DSP are
+// allowed to fail, so the caller decides what a 0 means.
+func rtAt68OpenDrv(name: string): int {
+    var pb: IOParam
+    var nm: ptr
+    var e: int
+
+    nm = NewPtrClear(40)
+    if nm == ptr(0) {
+        rtAt68LastErr = rtAtErrMemFull
+        return 0
+    }
+    rtAt68PStr(nm, name)
+    pb.ioNamePtr = nm
+    e = PBOpenSync(pb)
+    // The Device Manager copies nothing out of ioNamePtr past the open.
+    DisposePtr(nm)
+    if e != 0 {
+        rtAt68LastErr = e
+        return 0
+    }
+    return pb.ioRefNum
+}
+
+// ---- Bring-up ----
+
+func rtAtDevUp(): int {
+    if rtAt68Up {
+        return 0
+    }
+    // .MPP and .ATP are ROM-resident on every machine this targets, so a
+    // failure here really is "no AppleTalk".
+    rtAt68MppRef = rtAt68OpenDrv(".MPP")
+    if rtAt68MppRef == 0 {
+        if rtAt68LastErr == 0 {
+            rtAt68LastErr = rtAtErrNoHost
+        }
+        return rtAt68LastErr
+    }
+    rtAt68AtpRef = rtAt68OpenDrv(".ATP")
+    if rtAt68AtpRef == 0 {
+        if rtAt68LastErr == 0 {
+            rtAt68LastErr = rtAtErrNoHost
+        }
+        return rtAt68LastErr
+    }
+    // Both of these live in the AppleTalk System file. Absent is normal
+    // (see this file's header) and must not fail bring-up.
+    rtAt68XppRef = rtAt68OpenDrv(".XPP")
+    rtAt68DspRef = rtAt68OpenDrv(".DSP")
+    rtAt68LastErr = 0
+    rtAt68Up = true
+    return 0
+}
+
+// ---- NBP registration ----
+
+// rtAt68PStrEq: does the Pascal string at p equal s (clamped the same
+// way rtAt68PStr clamps when it writes one)?
+func rtAt68PStrEq(p: ptr, s: string): bool {
+    var i: int
+    var n: int
+
+    n = s.length
+    if n > 32 {
+        n = 32
+    }
+    if peekb(p) != n {
+        return false
+    }
+    i = 0
+    while i < n {
+        if peekb(p + 1 + i) != int(s[i]) {
+            return false
+        }
+        i = i + 1
+    }
+    return true
+}
+
+// rtAt68NteFind: the pool index registered under obj/typ, or -1 -- matched
+// against the packed entity in each live NTE (object then type; the zone
+// is always "*").
+func rtAt68NteFind(obj: string, typ: string): int {
+    var i: int
+    var ent: ptr
+
+    i = 0
+    while i < 4 {
+        if rtAt68NteUsed[i] and rtAt68Nte[i] != 0 {
+            ent = ptr(rtAt68Nte[i]) + nteEntity
+            if rtAt68PStrEq(ent, obj) and rtAt68PStrEq(rtAt68SkipPStr(ent), typ) {
+                return i
+            }
+        }
+        i = i + 1
+    }
+    return -1
+}
+
+func rtAtDevRegister(obj: string, typ: string, sock: int): int {
+    var pb: NBPRegParam
+    var nte: ptr
+    var end: ptr
+    var k: int
+    var e: int
+
+    if rtAt68MppRef == 0 {
+        return rtAtErrNoHost
+    }
+    k = 0
+    while k < 4 and rtAt68NteUsed[k] {
+        k = k + 1
+    }
+    if k >= 4 {
+        // Four names is two services plus two listeners -- the spec's own
+        // caps. Nothing can ask for a fifth.
+        return rtAtErrMemFull
+    }
+    if rtAt68Nte[k] == 0 {
+        rtAt68Nte[k] = int(NewPtrClear(nteSize))
+        if rtAt68Nte[k] == 0 {
+            return rtAtErrMemFull
+        }
+    }
+    nte = ptr(rtAt68Nte[k])
+    rtAt68Zero(nte, nteSize)
+    // Rule 4: the socket goes in VERBATIM, at nteAddress + 3.
+    pokeb(nte + nteAddress + 3, sock)
+    end = rtAt68PStr(nte + nteEntity, obj)
+    end = rtAt68PStr(end, typ)
+    end = rtAt68PStr(end, "*")
+    pb.ioRefNum = rtAt68MppRef
+    pb.csCode = registerName
+    pb.interval = 8
+    pb.count = 3
+    pb.ntQElPtr = nte
+    pb.verifyFlag = 1
+    e = PBControlSync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        return e
+    }
+    rtAt68NteUsed[k] = true
+    return 0
+}
+
+func rtAtDevRemove(obj: string, typ: string): int {
+    var pb: NBPParam
+    var k: int
+    var e: int
+
+    if rtAt68MppRef == 0 {
+        return rtAtErrNoHost
+    }
+    k = rtAt68NteFind(obj, typ)
+    if k < 0 {
+        return nbpNotFound
+    }
+    // RemoveName takes the ENTITY (the packed strings at NTE+9), the
+    // other arm of AppleTalk.h's `union NBPPtrs` at offset 30.
+    pb.ioRefNum = rtAt68MppRef
+    pb.csCode = removeName
+    pb.entityPtr = ptr(rtAt68Nte[k]) + nteEntity
+    e = PBControlSync(pb)
+    // The pool entry goes back either way: a name the driver no longer
+    // has must not pin a slot forever. The NTE block itself is kept for
+    // the next registration.
+    rtAt68NteUsed[k] = false
+    if e != 0 {
+        rtAt68LastErr = e
+    }
+    return e
+}
+
+// ---- NBP lookup ----
+
+func rtAt68LkEnsure(lk: int): bool {
+    if rtAt68LkPb[lk] == 0 {
+        rtAt68LkPb[lk] = int(NewPtrClear(rtAt68PbSz))
+    }
+    if rtAt68LkEntity[lk] == 0 {
+        rtAt68LkEntity[lk] = int(NewPtrClear(rtAt68EntSz))
+    }
+    if rtAt68LkBuf[lk] == 0 {
+        rtAt68LkBuf[lk] = int(NewPtrClear(rtAt68LkBufSz))
+    }
+    return rtAt68LkPb[lk] != 0 and rtAt68LkEntity[lk] != 0 and rtAt68LkBuf[lk] != 0
+}
+
+// rtAtDevLookupStart: every failure path returns BEFORE the slot's buffer
+// or entity is touched (atalk.cla's browser pump leans on that: a `found`
+// handler may call find() again, and a rejected restart must leave the
+// old results intact).
+//
+// ponytail: a restart while the slot's own lookup is still in flight
+// SPINS the old one out rather than cancelling it -- reissuing into a
+// live block is the probe's hang, and killNBP (csCode 254) is exactly the
+// shape of ROM call the probe found unimplemented on the Mac Plus
+// (killAllGetReq answered -17). NBP's own retry budget bounds the spin at
+// interval x count = 8 x 3 ticks, about 3 s worst case, and only a
+// re-entrant find can reach it. If that stall ever matters, the upgrade
+// is killNBP behind a hardware check that it works.
+func rtAtDevLookupStart(lk: int, obj: string, typ: string, zone: string): int {
+    var pb: ptr
+    var ent: ptr
+    var end: ptr
+    var z: string
+    var e: int
+
+    if rtAt68MppRef == 0 {
+        return rtAtErrNoHost
+    }
+    if not rtAt68LkEnsure(lk) {
+        return rtAtErrMemFull
+    }
+    pb = ptr(rtAt68LkPb[lk])
+    ent = ptr(rtAt68LkEntity[lk])
+    while rtAt68Pending(pb) {
+    }
+    rtAt68Zero(pb, rtAt68PbSz)
+    rtAt68Zero(ent, rtAt68EntSz)
+    z = zone
+    if z == "" {
+        z = "*"
+    }
+    end = rtAt68PStr(ent, obj)
+    end = rtAt68PStr(end, typ)
+    end = rtAt68PStr(end, z)
+    pokew(pb + pbIoRefNum, rtAt68MppRef)
+    pokew(pb + pbCsCode, lookupName)
+    pokeb(pb + rtAt68NbpInterval, 8)
+    pokeb(pb + rtAt68NbpCount, 3)
+    pokel(pb + nbpNtQElPtr, int(ent))
+    pokel(pb + nbpLookupRetBuffPtr, rtAt68LkBuf[lk])
+    pokew(pb + nbpLookupRetBuffSize, rtAt68LkBufSz)
+    pokew(pb + nbpLookupMaxToGet, 32)
+    e = PBControlAsync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        return e
+    }
+    return 0
+}
+
+func rtAtDevLookupDone(lk: int): bool {
+    if rtAt68LkPb[lk] == 0 {
+        return true
+    }
+    return not rtAt68Pending(ptr(rtAt68LkPb[lk]))
+}
+
+func rtAtDevLookupCount(lk: int): int {
+    var pb: ptr
+
+    if rtAt68LkPb[lk] == 0 {
+        return 0
+    }
+    pb = ptr(rtAt68LkPb[lk])
+    if rtAt68Pending(pb) {
+        return 0
+    }
+    if rtAt68Result(pb) < 0 {
+        // nbpBuffOvr and friends: report nothing rather than parsing a
+        // buffer the driver may have filled only partly.
+        rtAt68LastErr = rtAt68Result(pb)
+        return 0
+    }
+    return peekw(pb + nbpLookupNumGotten)
+}
+
+// rtAt68LkTuple: the address of reply tuple i, walking the packed
+// entities (a tuple is AddrBlock(4) + enumerator(1) + three Pascal
+// strings, so its length is data-dependent). ptr(0) when i is out of
+// range.
+func rtAt68LkTuple(lk: int, i: int): ptr {
+    var p: ptr
+    var j: int
+
+    if i < 0 or i >= rtAtDevLookupCount(lk) {
+        return ptr(0)
+    }
+    p = ptr(rtAt68LkBuf[lk])
+    j = 0
+    while j < i {
+        p = p + tupleEntity
+        p = rtAt68SkipPStr(p)
+        p = rtAt68SkipPStr(p)
+        p = rtAt68SkipPStr(p)
+        j = j + 1
+    }
+    return p
+}
+
+func rtAtDevLookupAddr(lk: int, i: int): int {
+    var t: ptr
+
+    t = rtAt68LkTuple(lk, i)
+    if t == ptr(0) {
+        return 0
+    }
+    return rtAt68PackAddr(t + tupleAddr)
+}
+
+// rtAtDevLookupName: "Object:Type", the same spelling the host lane's
+// AtalkHLookupName produces (tests grep for it).
+func rtAtDevLookupName(lk: int, i: int): string {
+    var t: ptr
+    var obj: string
+    var typ: string
+
+    t = rtAt68LkTuple(lk, i)
+    if t == ptr(0) {
+        return ""
+    }
+    obj = rtAt68GetPStr(t + tupleEntity)
+    typ = rtAt68GetPStr(rtAt68SkipPStr(t + tupleEntity))
+    return obj + ":" + typ
+}
+
+// ---- ZIP zones ----
+
+// rtAtDevZones: sync GetZoneList over .XPP, appending each returned
+// Pascal string, until zipLastFlag. A routerless net answers noBridgeErr
+// and atalk.cla substitutes ["*"]. The XCallParam local is REUSED across
+// the loop on purpose (rule 1's one exception, and not a violation of it:
+// the call is synchronous, so the block is never driver-owned between
+// iterations, and zipInfoField is ZIP's own continuation state, which the
+// caller must NOT clear between calls of one sequence).
+func rtAtDevZones(out: list of string): int {
+    var pb: XCallParam
+    var buf: ptr
+    var e: int
+    var n: int
+    var i: int
+    var p: ptr
+    var last: int
+    var guard: int
+
+    if rtAt68XppRef == 0 {
+        return rtAtErrNoBridge
+    }
+    buf = NewPtrClear(578)
+    if buf == ptr(0) {
+        return rtAtErrMemFull
+    }
+    last = 0
+    guard = 0
+    e = 0
+    while last == 0 and guard < 64 {
+        pb.ioRefNum = rtAt68XppRef
+        pb.csCode = xCall
+        pb.xppSubCode = zipGetZoneList
+        pb.xppTimeout = 3
+        pb.xppRetry = 4
+        pb.zipBuffPtr = buf
+        e = PBControlSync(pb)
+        if e != 0 {
+            rtAt68LastErr = e
+            DisposePtr(buf)
+            return e
+        }
+        n = pb.zipNumZones
+        p = buf
+        i = 0
+        while i < n {
+            out.add(rtAt68GetPStr(p))
+            p = rtAt68SkipPStr(p)
+            i = i + 1
+        }
+        last = pb.zipLastFlag
+        guard = guard + 1
+    }
+    DisposePtr(buf)
+    return 0
+}
+
+// ---- ATP: sockets ----
+
+func rtAtDevAtpOpen(): int {
+    var pb: ATPParam
+    var e: int
+
+    if rtAt68AtpRef == 0 {
+        rtAt68LastErr = rtAtErrNoHost
+        return 0
+    }
+    pb.ioRefNum = rtAt68AtpRef
+    pb.csCode = openATPSkt
+    // atpSocket 0 asks for any free dynamic socket (DDP's 128..254).
+    pb.atpSocket = 0
+    e = PBControlSync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        return 0
+    }
+    return pb.atpSocket
+}
+
+func rtAtDevAtpClose(sock: int) {
+    var pb: ATPParam
+
+    if rtAt68AtpRef == 0 or sock == 0 {
+        return
+    }
+    pb.ioRefNum = rtAt68AtpRef
+    pb.csCode = closeATPSkt
+    pb.atpSocket = sock
+    PBControlSync(pb)
+}
+
+// ---- ATP: the service (request) side ----
+
+func rtAt68SvcEnsure(slot: int): bool {
+    if rtAt68SvcGetPb[slot] == 0 {
+        rtAt68SvcGetPb[slot] = int(NewPtrClear(rtAt68PbSz))
+    }
+    if rtAt68SvcReqBuf[slot] == 0 {
+        rtAt68SvcReqBuf[slot] = int(NewPtrClear(rtAt68ReqBufSz))
+    }
+    if rtAt68SvcRespPb[slot] == 0 {
+        rtAt68SvcRespPb[slot] = int(NewPtrClear(rtAt68PbSz))
+    }
+    if rtAt68SvcRespBuf[slot] == 0 {
+        rtAt68SvcRespBuf[slot] = int(NewPtrClear(rtAtMaxResp))
+    }
+    if rtAt68SvcBds[slot] == 0 {
+        rtAt68SvcBds[slot] = int(NewPtrClear(rtAt68BdsSz))
+    }
+    return rtAt68SvcGetPb[slot] != 0 and rtAt68SvcReqBuf[slot] != 0 and rtAt68SvcRespPb[slot] != 0 and rtAt68SvcRespBuf[slot] != 0 and rtAt68SvcBds[slot] != 0
+}
+
+// rtAtDevAtpArm: async PGetRequest into the slot's own request buffer.
+// atalk.cla's rtSvcArmed guarantees exactly one outstanding get-request
+// per slot, so the block is free here -- and it is re-zeroed anyway
+// (rule 1).
+func rtAtDevAtpArm(slot: int, sock: int): int {
+    var pb: ptr
+    var e: int
+
+    if rtAt68AtpRef == 0 {
+        return rtAtErrNoHost
+    }
+    if not rtAt68SvcEnsure(slot) {
+        return rtAtErrMemFull
+    }
+    pb = ptr(rtAt68SvcGetPb[slot])
+    if rtAt68Pending(pb) {
+        // Defensive: never reissue into a live block (rule 2). The pump
+        // treats a nonzero return as "arm failed, retry next pass".
+        return rtAtErrNoHost
+    }
+    rtAt68Zero(pb, rtAt68PbSz)
+    rtAt68SvcSock[slot] = sock
+    pokew(pb + pbIoRefNum, rtAt68AtpRef)
+    pokew(pb + pbCsCode, getRequest)
+    pokeb(pb + rtAt68AtpSocket, sock)
+    pokew(pb + rtAt68AtpReqLength, rtAtMaxReq)
+    pokel(pb + rtAt68AtpReqPointer, rtAt68SvcReqBuf[slot])
+    e = PBControlAsync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        return e
+    }
+    rtAt68SvcGetLive[slot] = true
+    return 0
+}
+
+// rtAtDevAtpPoll: 1 when a request was dequeued (reported exactly once
+// per arm -- rtAt68SvcGetLive is what stops a completed-but-not-yet-
+// re-armed block from being read twice), 0 while pending or idle, the
+// OSErr (< 0) when the get-request itself failed.
+func rtAtDevAtpPoll(slot: int): int {
+    var pb: ptr
+    var res: int
+
+    if not rtAt68SvcGetLive[slot] {
+        return 0
+    }
+    pb = ptr(rtAt68SvcGetPb[slot])
+    if rtAt68Pending(pb) {
+        return 0
+    }
+    rtAt68SvcGetLive[slot] = false
+    res = rtAt68Result(pb)
+    if res < 0 {
+        rtAt68LastErr = res
+        return res
+    }
+    rtAt68SvcReqOp[slot] = peekl(pb + atpUserData)
+    rtAt68SvcReqFrom[slot] = rtAt68PackAddr(pb + rtAt68AtpAddrNet)
+    rtAt68SvcReqLen[slot] = peekw(pb + rtAt68AtpReqLength)
+    rtAt68SvcTransID[slot] = peekw(pb + atpTransID)
+    rtAt68SvcXO[slot] = peekb(pb + rtAt68AtpFlags) & atpXOvalue
+    return 1
+}
+
+func rtAtDevAtpReqOp(slot: int): int {
+    return rtAt68SvcReqOp[slot]
+}
+
+func rtAtDevAtpReqFrom(slot: int): int {
+    return rtAt68SvcReqFrom[slot]
+}
+
+func rtAtDevAtpReqLen(slot: int): int {
+    return rtAt68SvcReqLen[slot]
+}
+
+func rtAtDevAtpReqPtr(slot: int): ptr {
+    return ptr(rtAt68SvcReqBuf[slot])
+}
+
+// rtAtDevAtpRespond: copy the payload into the slot's own reply buffer,
+// build the BDS over it, and send ASYNC. Async is load-bearing for an
+// exactly-once transaction: a SYNC PSendResponse in XO mode only
+// completes when the requester's TRel arrives or the 30 s release timer
+// fires, which would stall the whole event loop (spec %5.5).
+func rtAtDevAtpRespond(slot: int, code: int, p: ptr, n: int): int {
+    var pb: ptr
+    var bds: ptr
+    var buf: ptr
+    var nb: int
+    var i: int
+    var off: int
+    var ds: int
+    var cnt: int
+    var e: int
+
+    if rtAt68AtpRef == 0 {
+        return rtAtErrNoHost
+    }
+    if not rtAt68SvcEnsure(slot) {
+        return rtAtErrMemFull
+    }
+    pb = ptr(rtAt68SvcRespPb[slot])
+    if rtAt68Pending(pb) {
+        // atalk.cla's pump never dispatches a request while the previous
+        // response is outstanding, so this is unreachable in practice --
+        // and reissuing anyway would be the probe's hang.
+        return rtAtErrNoHost
+    }
+    bds = ptr(rtAt68SvcBds[slot])
+    buf = ptr(rtAt68SvcRespBuf[slot])
+    cnt = n
+    if cnt < 0 {
+        cnt = 0
+    }
+    if cnt > rtAtMaxResp {
+        cnt = rtAtMaxResp
+    }
+    if cnt > 0 and p != ptr(0) {
+        BlockMoveData(p, buf, cnt)
+    }
+    rtAt68Zero(pb, rtAt68PbSz)
+    rtAt68Zero(bds, rtAt68BdsSz)
+    // At least one BDS entry always: a zero-length reply still carries
+    // the application code in its user bytes.
+    nb = (cnt + atpMaxData - 1) / atpMaxData
+    if nb < 1 {
+        nb = 1
+    }
+    if nb > atpMaxNum {
+        nb = atpMaxNum
+    }
+    i = 0
+    while i < nb {
+        off = i * atpMaxData
+        ds = cnt - off
+        if ds > atpMaxData {
+            ds = atpMaxData
+        }
+        if ds < 0 {
+            ds = 0
+        }
+        pokew(bds + i * bdsEntrySz + rtAt68BdsBuffSize, atpMaxData)
+        pokel(bds + i * bdsEntrySz + rtAt68BdsBuffPtr, int(buf) + off)
+        pokew(bds + i * bdsEntrySz + rtAt68BdsDataSize, ds)
+        if i == 0 {
+            pokel(bds + i * bdsEntrySz + rtAt68BdsUserBytes, code)
+        }
+        i = i + 1
+    }
+    pokew(pb + pbIoRefNum, rtAt68AtpRef)
+    pokew(pb + pbCsCode, sendResponse)
+    pokeb(pb + rtAt68AtpSocket, rtAt68SvcSock[slot])
+    // XO (only when the request itself was exactly-once) PLUS EOM. The
+    // task brief listed XO alone; Inside Macintosh's PSendResponse takes
+    // atpEOMvalue too, and it is load-bearing rather than decorative:
+    // ATP's requester completes on "every bitmap packet received AND an
+    // end-of-message packet seen", so a response with no EOM anywhere
+    // leaves the requester spinning out its full retry budget. The host
+    // lane's own stack states that rule in code
+    // (runtime/host/rt_atalk.inc, rt_at_rq_done: `eom_seq >= 0 &&
+    // bitmap == 0`), which is the peer Task 10 drives this against. The
+    // driver puts the flag on the LAST packet of the response.
+    pokeb(pb + rtAt68AtpFlags, rtAt68SvcXO[slot] + atpEOMvalue)
+    rtAt68PokeAddr(pb + rtAt68AtpAddrNet, rtAt68SvcReqFrom[slot])
+    pokel(pb + rtAt68AtpBdsPointer, int(bds))
+    pokeb(pb + rtAt68AtpNumOfBuffs, nb)
+    pokeb(pb + atpBdsSize, nb)
+    pokew(pb + atpTransID, rtAt68SvcTransID[slot])
+    e = PBControlAsync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        return e
+    }
+    return 0
+}
+
+func rtAtDevAtpRespBusy(slot: int): bool {
+    if rtAt68SvcRespPb[slot] == 0 {
+        return false
+    }
+    return rtAt68Pending(ptr(rtAt68SvcRespPb[slot]))
+}
+
+// ---- ATP: the requester side ----
+
+func rtAt68CallEnsure(): bool {
+    if rtAt68CallBuf == ptr(0) {
+        rtAt68CallBuf = NewPtrClear(rtAtMaxResp)
+    }
+    if rtAt68CallBds == ptr(0) {
+        rtAt68CallBds = NewPtrClear(rtAt68BdsSz)
+    }
+    return rtAt68CallBuf != ptr(0) and rtAt68CallBds != ptr(0)
+}
+
+// rtAtDevAtpCall: sync PSendRequest, exactly-once, 2 s x 3 retries. On
+// success the numOfResps responses are COMPACTED into the front of the
+// response buffer (each lands at its own 578-byte slot, so a short
+// response leaves a gap the caller must not see) and the byte count is
+// returned; the application code is the first response's user bytes.
+func rtAtDevAtpCall(addr: int, op: int, req: ptr, reqLen: int): int {
+    var pb: ATPParam
+    var i: int
+    var nresp: int
+    var total: int
+    var ds: int
+    var e: int
+
+    if rtAt68AtpRef == 0 {
+        return rtAtErrNoHost
+    }
+    if not rtAt68CallEnsure() {
+        return rtAtErrMemFull
+    }
+    rtAt68Zero(rtAt68CallBds, rtAt68BdsSz)
+    i = 0
+    while i < atpMaxNum {
+        pokew(rtAt68CallBds + i * bdsEntrySz + rtAt68BdsBuffSize, atpMaxData)
+        pokel(rtAt68CallBds + i * bdsEntrySz + rtAt68BdsBuffPtr, int(rtAt68CallBuf) + i * atpMaxData)
+        i = i + 1
+    }
+    rtAt68CallCode = 0
+    pb.ioRefNum = rtAt68AtpRef
+    pb.csCode = sendRequest
+    pb.userData = op
+    pb.atpFlags = atpXOvalue
+    pb.addrNet = (addr >> 16) & 0xFFFF
+    pb.addrNode = (addr >> 8) & 0xFF
+    pb.addrSocket = addr & 0xFF
+    pb.reqLength = reqLen
+    pb.reqPointer = req
+    pb.bdsPointer = rtAt68CallBds
+    pb.numOfBuffs = atpMaxNum
+    pb.timeOutVal = 2
+    pb.retryCount = 3
+    e = PBControlSync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        return e
+    }
+    nresp = pb.numOfResps
+    if nresp > atpMaxNum {
+        nresp = atpMaxNum
+    }
+    total = 0
+    i = 0
+    while i < nresp {
+        ds = peekw(rtAt68CallBds + i * bdsEntrySz + rtAt68BdsDataSize)
+        if total != i * atpMaxData and ds > 0 {
+            BlockMoveData(rtAt68CallBuf + i * atpMaxData, rtAt68CallBuf + total, ds)
+        }
+        total = total + ds
+        i = i + 1
+    }
+    rtAt68CallCode = peekl(rtAt68CallBds + rtAt68BdsUserBytes)
+    return total
+}
+
+func rtAtDevAtpCallCode(): int {
+    return rtAt68CallCode
+}
+
+func rtAtDevAtpCallPtr(): ptr {
+    return rtAt68CallBuf
+}
+
+func rtAtDevLastErr(): int {
+    return rtAt68LastErr
+}
+
+// rtAtDevPoll: a no-op natively -- the Toolbox drivers run their own
+// async parameter blocks, so there is nothing to drain here; the pump
+// polls ioResult per slot instead.
+func rtAtDevPoll() {
+}
+
+// ---- ADSP ----
+
+func rtAt68DspAuxPb(): ptr {
+    if rtAt68DspAux == ptr(0) {
+        rtAt68DspAux = NewPtrClear(rtAt68DspPbSz)
+    }
+    if rtAt68DspAux != ptr(0) {
+        rtAt68Zero(rtAt68DspAux, rtAt68DspPbSz)
+    }
+    return rtAt68DspAux
+}
+
+func rtAt68CcbEnsure(slot: int): bool {
+    if rtAt68Ccb[slot] == 0 {
+        rtAt68Ccb[slot] = int(NewPtrClear(ccbSize))
+    }
+    if rtAt68Pb[slot] == 0 {
+        rtAt68Pb[slot] = int(NewPtrClear(rtAt68DspPbSz))
+    }
+    if rtAt68SendQ[slot] == 0 {
+        rtAt68SendQ[slot] = int(NewPtrClear(rtAt68QSz))
+    }
+    if rtAt68RecvQ[slot] == 0 {
+        rtAt68RecvQ[slot] = int(NewPtrClear(rtAt68QSz))
+    }
+    if rtAt68Attn[slot] == 0 {
+        rtAt68Attn[slot] = int(NewPtrClear(attnBufSize))
+    }
+    return rtAt68Ccb[slot] != 0 and rtAt68Pb[slot] != 0 and rtAt68SendQ[slot] != 0 and rtAt68RecvQ[slot] != 0 and rtAt68Attn[slot] != 0
+}
+
+// rtAt68DspFree: give a connection slot's four ADSP blocks back (the
+// parameter block is kept -- it is small and the slot may be reopened).
+func rtAt68DspFree(slot: int) {
+    if rtAt68Ccb[slot] != 0 {
+        DisposePtr(ptr(rtAt68Ccb[slot]))
+        rtAt68Ccb[slot] = 0
+    }
+    if rtAt68SendQ[slot] != 0 {
+        DisposePtr(ptr(rtAt68SendQ[slot]))
+        rtAt68SendQ[slot] = 0
+    }
+    if rtAt68RecvQ[slot] != 0 {
+        DisposePtr(ptr(rtAt68RecvQ[slot]))
+        rtAt68RecvQ[slot] = 0
+    }
+    if rtAt68Attn[slot] != 0 {
+        DisposePtr(ptr(rtAt68Attn[slot]))
+        rtAt68Attn[slot] = 0
+    }
+    rtAt68CcbRef[slot] = 0
+}
+
+// rtAt68DspInitEnd: dspInit a connection end on `slot`. Sync; on success
+// the slot's ccbRefNum is stored. Returns the OSErr.
+func rtAt68DspInitEnd(slot: int): int {
+    var pb: ptr
+    var e: int
+
+    if not rtAt68CcbEnsure(slot) {
+        return rtAtErrMemFull
+    }
+    pb = ptr(rtAt68Pb[slot])
+    if rtAt68Pending(pb) {
+        // Rule 2. The only way to get here is a reopen while a previous
+        // dspOpen on this slot is somehow still queued (dspRemove with
+        // abort should have completed it), and re-zeroing it under the
+        // driver is the probe's hang -- fail the open instead.
+        return rtAtErrNoHost
+    }
+    rtAt68Zero(pb, rtAt68DspPbSz)
+    rtAt68Zero(ptr(rtAt68Ccb[slot]), ccbSize)
+    pokew(pb + dspIoCRefNum, rtAt68DspRef)
+    pokew(pb + pbCsCode, dspInit)
+    pokel(pb + dspInitCcbPtr, rtAt68Ccb[slot])
+    pokel(pb + dspInitUserRoutine, 0)
+    pokew(pb + dspInitSendQSize, rtAt68QSz)
+    pokel(pb + dspInitSendQueue, rtAt68SendQ[slot])
+    pokew(pb + dspInitRecvQSize, rtAt68QSz)
+    pokel(pb + dspInitRecvQueue, rtAt68RecvQ[slot])
+    pokel(pb + dspInitAttnPtr, rtAt68Attn[slot])
+    pokeb(pb + dspInitLocalSocket, 0)
+    e = PBControlSync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        return e
+    }
+    rtAt68CcbRef[slot] = peekw(pb + dspCcbRefNum)
+    return 0
+}
+
+// rtAt68DspRemoveEnd: dspRemove through the AUX block (rule 2 -- the
+// slot's own block may still hold a pending dspOpen).
+func rtAt68DspRemoveEnd(slot: int) {
+    var aux: ptr
+
+    if rtAt68CcbRef[slot] == 0 {
+        return
+    }
+    aux = rtAt68DspAuxPb()
+    if aux != ptr(0) {
+        pokew(aux + dspIoCRefNum, rtAt68DspRef)
+        pokew(aux + pbCsCode, dspRemove)
+        pokew(aux + dspCcbRefNum, rtAt68CcbRef[slot])
+        pokeb(aux + dspCloseAbort, 1)
+        PBControlSync(aux)
+    }
+    rtAt68CcbRef[slot] = 0
+}
+
+// rtAdspDevOpen: dspInit then an ASYNC dspOpen(ocRequest). 0 means
+// "started"; rtAdspDevOpenPoll reports the outcome.
+func rtAdspDevOpen(slot: int, addr: int): int {
+    var pb: ptr
+    var e: int
+
+    if rtAt68DspRef == 0 {
+        return rtAtErrNoHost
+    }
+    e = rtAt68DspInitEnd(slot)
+    if e != 0 {
+        return e
+    }
+    pb = ptr(rtAt68Pb[slot])
+    rtAt68Zero(pb, rtAt68DspPbSz)
+    pokew(pb + dspIoCRefNum, rtAt68DspRef)
+    pokew(pb + pbCsCode, dspOpen)
+    pokew(pb + dspCcbRefNum, rtAt68CcbRef[slot])
+    rtAt68PokeAddr(pb + dspOpenRemoteAddress, addr)
+    pokel(pb + dspOpenFilterAddress, 0)
+    pokeb(pb + dspOpenOcMode, ocRequest)
+    pokeb(pb + dspOpenOcInterval, 6)
+    pokeb(pb + dspOpenOcMaximum, 3)
+    e = PBControlAsync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        rtAt68DspRemoveEnd(slot)
+        rtAt68DspFree(slot)
+        return e
+    }
+    rtAt68OpenLive[slot] = true
+    return 0
+}
+
+// rtAdspDevOpenPoll: 1 once open, 0 while pending, the OSErr (< 0) on
+// failure -- and a failure tears the half-built connection end down, so
+// the slot can be reopened.
+func rtAdspDevOpenPoll(slot: int): int {
+    var pb: ptr
+    var res: int
+
+    if rtAt68DspRef == 0 {
+        return rtAtErrNoHost
+    }
+    if not rtAt68OpenLive[slot] {
+        return rtAtErrNoHost
+    }
+    pb = ptr(rtAt68Pb[slot])
+    if rtAt68Pending(pb) {
+        return 0
+    }
+    rtAt68OpenLive[slot] = false
+    res = rtAt68Result(pb)
+    if res < 0 {
+        rtAt68LastErr = res
+        rtAt68DspRemoveEnd(slot)
+        rtAt68DspFree(slot)
+        return res
+    }
+    return 1
+}
+
+func rtAdspDevAvail(slot: int): int {
+    var pb: ptr
+
+    if rtAt68DspRef == 0 or rtAt68CcbRef[slot] == 0 {
+        return 0
+    }
+    pb = ptr(rtAt68Pb[slot])
+    if rtAt68Pending(pb) {
+        return 0
+    }
+    rtAt68Zero(pb, rtAt68DspPbSz)
+    pokew(pb + dspIoCRefNum, rtAt68DspRef)
+    pokew(pb + pbCsCode, dspStatus)
+    pokew(pb + dspCcbRefNum, rtAt68CcbRef[slot])
+    pokel(pb + dspStatusCcb, rtAt68Ccb[slot])
+    if PBControlSync(pb) != 0 {
+        return 0
+    }
+    return peekw(pb + dspStatusRecvQPending)
+}
+
+func rtAdspDevRead(slot: int, p: ptr, n: int): int {
+    var pb: ptr
+    var e: int
+
+    if rtAt68DspRef == 0 or rtAt68CcbRef[slot] == 0 {
+        return 0
+    }
+    if n <= 0 {
+        return 0
+    }
+    pb = ptr(rtAt68Pb[slot])
+    if rtAt68Pending(pb) {
+        return 0
+    }
+    rtAt68Zero(pb, rtAt68DspPbSz)
+    pokew(pb + dspIoCRefNum, rtAt68DspRef)
+    pokew(pb + pbCsCode, dspRead)
+    pokew(pb + dspCcbRefNum, rtAt68CcbRef[slot])
+    pokew(pb + dspIoReqCount, n)
+    pokel(pb + dspIoDataPtr, int(p))
+    e = PBControlSync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        return 0
+    }
+    return peekw(pb + dspIoActCount)
+}
+
+func rtAdspDevWrite(slot: int, p: ptr, n: int): int {
+    var pb: ptr
+    var e: int
+
+    if rtAt68DspRef == 0 or rtAt68CcbRef[slot] == 0 {
+        return rtAtErrNoHost
+    }
+    if n <= 0 {
+        return 0
+    }
+    pb = ptr(rtAt68Pb[slot])
+    if rtAt68Pending(pb) {
+        return rtAtErrNoHost
+    }
+    rtAt68Zero(pb, rtAt68DspPbSz)
+    pokew(pb + dspIoCRefNum, rtAt68DspRef)
+    pokew(pb + pbCsCode, dspWrite)
+    pokew(pb + dspCcbRefNum, rtAt68CcbRef[slot])
+    pokew(pb + dspIoReqCount, n)
+    pokel(pb + dspIoDataPtr, int(p))
+    pokeb(pb + dspIoEom, 0)
+    pokeb(pb + dspIoFlush, 1)
+    e = PBControlSync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+    }
+    return e
+}
+
+// rtAdspDevGone: the CCB's own state word. sClosing (5) and sClosed (6)
+// both mean the peer is gone; TRCCB.state is a UInt16, so peekw is right.
+func rtAdspDevGone(slot: int): bool {
+    if rtAt68CcbRef[slot] == 0 or rtAt68Ccb[slot] == 0 {
+        return true
+    }
+    return peekw(ptr(rtAt68Ccb[slot]) + ccbState) >= sClosing
+}
+
+// rtAdspDevClose: an orderly dspClose, then dspRemove, then the memory
+// back. Both control calls go through the AUX block: the slot's own may
+// still hold a pending dspOpen if the program closed mid-open.
+func rtAdspDevClose(slot: int) {
+    var aux: ptr
+
+    if rtAt68CcbRef[slot] == 0 {
+        rtAt68DspFree(slot)
+        rtAt68OpenLive[slot] = false
+        return
+    }
+    aux = rtAt68DspAuxPb()
+    if aux != ptr(0) {
+        pokew(aux + dspIoCRefNum, rtAt68DspRef)
+        pokew(aux + pbCsCode, dspClose)
+        pokew(aux + dspCcbRefNum, rtAt68CcbRef[slot])
+        pokeb(aux + dspCloseAbort, 0)
+        PBControlSync(aux)
+    }
+    rtAt68DspRemoveEnd(slot)
+    rtAt68DspFree(slot)
+    rtAt68OpenLive[slot] = false
+}
+
+// ---- ADSP connection listener ----
+
+func rtAt68LsnEnsure(slot: int): bool {
+    if rtAt68LsnCcb[slot] == 0 {
+        rtAt68LsnCcb[slot] = int(NewPtrClear(ccbSize))
+    }
+    if rtAt68LsnPb[slot] == 0 {
+        rtAt68LsnPb[slot] = int(NewPtrClear(rtAt68DspPbSz))
+    }
+    return rtAt68LsnCcb[slot] != 0 and rtAt68LsnPb[slot] != 0
+}
+
+func rtLsnDevInit(slot: int): int {
+    var pb: ptr
+    var e: int
+
+    if rtAt68DspRef == 0 {
+        return rtAtErrNoHost
+    }
+    if not rtAt68LsnEnsure(slot) {
+        return rtAtErrMemFull
+    }
+    pb = ptr(rtAt68LsnPb[slot])
+    if rtAt68Pending(pb) {
+        return rtAtErrNoHost
+    }
+    rtAt68Zero(pb, rtAt68DspPbSz)
+    rtAt68Zero(ptr(rtAt68LsnCcb[slot]), ccbSize)
+    pokew(pb + dspIoCRefNum, rtAt68DspRef)
+    pokew(pb + pbCsCode, dspCLInit)
+    pokel(pb + dspInitCcbPtr, rtAt68LsnCcb[slot])
+    pokeb(pb + dspInitLocalSocket, 0)
+    e = PBControlSync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        return e
+    }
+    rtAt68LsnRef[slot] = peekw(pb + dspCcbRefNum)
+    return 0
+}
+
+func rtLsnDevListen(slot: int): int {
+    var pb: ptr
+    var e: int
+
+    if rtAt68DspRef == 0 or rtAt68LsnRef[slot] == 0 {
+        return rtAtErrNoHost
+    }
+    pb = ptr(rtAt68LsnPb[slot])
+    if rtAt68Pending(pb) {
+        return 0
+    }
+    rtAt68Zero(pb, rtAt68DspPbSz)
+    pokew(pb + dspIoCRefNum, rtAt68DspRef)
+    pokew(pb + pbCsCode, dspCLListen)
+    pokew(pb + dspCcbRefNum, rtAt68LsnRef[slot])
+    pokel(pb + dspOpenFilterAddress, 0)
+    e = PBControlAsync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        return e
+    }
+    rtAt68LsnLive[slot] = true
+    return 0
+}
+
+// rtLsnDevPoll: 1 when a connection request is waiting (accept or deny
+// it, then re-listen), 0 while pending, the OSErr (< 0) on failure.
+func rtLsnDevPoll(slot: int): int {
+    var pb: ptr
+    var res: int
+
+    if not rtAt68LsnLive[slot] {
+        return 0
+    }
+    pb = ptr(rtAt68LsnPb[slot])
+    if rtAt68Pending(pb) {
+        return 0
+    }
+    rtAt68LsnLive[slot] = false
+    res = rtAt68Result(pb)
+    if res < 0 {
+        rtAt68LastErr = res
+        return res
+    }
+    return 1
+}
+
+// rtLsnDevAccept: build a connection end on `connSlot` and dspOpen it in
+// ocAccept mode, carrying the remote CID, address and sequence numbers
+// the completed dspCLListen left in the listener's block. Synchronous:
+// the handshake is already half done, and ocInterval 6 / ocMaximum 3
+// bound it at about 3 s.
+func rtLsnDevAccept(slot: int, connSlot: int): int {
+    var lpb: ptr
+    var pb: ptr
+    var e: int
+
+    if rtAt68DspRef == 0 or rtAt68LsnRef[slot] == 0 {
+        return rtAtErrNoHost
+    }
+    lpb = ptr(rtAt68LsnPb[slot])
+    e = rtAt68DspInitEnd(connSlot)
+    if e != 0 {
+        return e
+    }
+    pb = ptr(rtAt68Pb[connSlot])
+    rtAt68Zero(pb, rtAt68DspPbSz)
+    pokew(pb + dspIoCRefNum, rtAt68DspRef)
+    pokew(pb + pbCsCode, dspOpen)
+    pokew(pb + dspCcbRefNum, rtAt68CcbRef[connSlot])
+    pokew(pb + dspOpenRemoteCID, peekw(lpb + dspOpenRemoteCID))
+    pokel(pb + dspOpenRemoteAddress, peekl(lpb + dspOpenRemoteAddress))
+    pokel(pb + dspOpenFilterAddress, 0)
+    pokel(pb + dspOpenSendSeq, peekl(lpb + dspOpenSendSeq))
+    pokew(pb + dspOpenSendWindow, peekw(lpb + dspOpenSendWindow))
+    pokel(pb + dspOpenAttnSendSeq, peekl(lpb + dspOpenAttnSendSeq))
+    pokeb(pb + dspOpenOcMode, ocAccept)
+    pokeb(pb + dspOpenOcInterval, 6)
+    pokeb(pb + dspOpenOcMaximum, 3)
+    e = PBControlSync(pb)
+    if e != 0 {
+        rtAt68LastErr = e
+        rtAt68DspRemoveEnd(connSlot)
+        rtAt68DspFree(connSlot)
+        return e
+    }
+    return 0
+}
+
+// rtLsnDevDeny: refuse the request the completed listen delivered (no
+// free connection slot). Through the AUX block, so the listener's own is
+// free to be re-armed straight afterwards.
+func rtLsnDevDeny(slot: int): int {
+    var lpb: ptr
+    var aux: ptr
+    var e: int
+
+    if rtAt68DspRef == 0 or rtAt68LsnRef[slot] == 0 {
+        return rtAtErrNoHost
+    }
+    lpb = ptr(rtAt68LsnPb[slot])
+    aux = rtAt68DspAuxPb()
+    if aux == ptr(0) {
+        return rtAtErrMemFull
+    }
+    pokew(aux + dspIoCRefNum, rtAt68DspRef)
+    pokew(aux + pbCsCode, dspCLDeny)
+    pokew(aux + dspCcbRefNum, rtAt68LsnRef[slot])
+    pokew(aux + dspOpenRemoteCID, peekw(lpb + dspOpenRemoteCID))
+    pokel(aux + dspOpenRemoteAddress, peekl(lpb + dspOpenRemoteAddress))
+    e = PBControlSync(aux)
+    if e != 0 {
+        rtAt68LastErr = e
+    }
+    return e
+}
+
+func rtLsnDevRemove(slot: int) {
+    var aux: ptr
+
+    if rtAt68LsnRef[slot] == 0 {
+        return
+    }
+    aux = rtAt68DspAuxPb()
+    if aux != ptr(0) {
+        pokew(aux + dspIoCRefNum, rtAt68DspRef)
+        pokew(aux + pbCsCode, dspCLRemove)
+        pokew(aux + dspCcbRefNum, rtAt68LsnRef[slot])
+        pokeb(aux + dspCloseAbort, 1)
+        PBControlSync(aux)
+    }
+    rtAt68LsnRef[slot] = 0
+    rtAt68LsnLive[slot] = false
+    if rtAt68LsnCcb[slot] != 0 {
+        DisposePtr(ptr(rtAt68LsnCcb[slot]))
+        rtAt68LsnCcb[slot] = 0
+    }
+}
+
+// rtLsnDevSocket: the DDP socket dspCLInit assigned -- what the listener
+// registers with NBP (rule 4).
+func rtLsnDevSocket(slot: int): int {
+    if rtAt68LsnCcb[slot] == 0 {
+        return 0
+    }
+    return peekb(ptr(rtAt68LsnCcb[slot]) + ccbLocalSocket)
+}
diff --git a/runtime/clarus/atalk_c.cla b/runtime/clarus/atalk_c.cla
new file mode 100644
index 0000000..4c26aa3
--- /dev/null
+++ b/runtime/clarus/atalk_c.cla
@@ -0,0 +1,313 @@
+// Copyright 2026, Andrew C. Young <andrew@vaelen.org>
+// SPDX-License-Identifier: MIT
+
+// atalk_c.cla: the C-lane AppleTalk waist (2026-09-06 appletalk spec %6),
+// eighteen `AtalkH`-prefixed externs (the family-prefix convention
+// conn_c.cla/ser.cla explain: a bare short name could collide with a user
+// program's own `external func` once everything is one translation unit)
+// rendering as rt_ext_AtalkH* in runtime/host/rt_atalk.inc -- a real
+// LocalTalk-over-UDP peer, so a host program is a genuine peer of the
+// emulators. atalk_68k.cla is this file's native twin: same rtAtDev*/
+// rtAdspDev*/rtLsnDev* names, real Toolbox _Control calls.
+//
+// What this lane does NOT have (spec %4.6, %6.1): ADSP and therefore
+// streams. Every rtAdspDev*/rtLsnDev* function below returns
+// rtAtErrNoHost, so `connection.open(appletalk ...)`, `listener.register`
+// and `accepted` fail with an event on the host, exactly as specified.
+// Zones are the same story: no ZIP, no router, so rtAtDevZones always
+// reports noBridgeErr and atalk.cla substitutes ["*"].
+//
+// Never spliced onto the native lane (drive.cla adds this module only for
+// non-68k builds), so it can freely assume the host stack.
+
+external func AtalkHUp(): int
+external func AtalkHNode(): int
+external func AtalkHRegister(obj: string, typ: string, sock: int): int
+external func AtalkHRemove(obj: string, typ: string): int
+external func AtalkHLookupStart(lk: int, obj: string, typ: string, zone: string): int
+external func AtalkHLookupDone(lk: int): int
+external func AtalkHLookupCount(lk: int): int
+external func AtalkHLookupAddr(lk: int, i: int): int
+external func AtalkHLookupName(lk: int, i: int, out: ptr)
+external func AtalkHAtpOpen(): int
+external func AtalkHAtpClose(sock: int)
+external func AtalkHAtpGetRequest(sock: int, buf: ptr, cap: int): int
+external func AtalkHAtpReqOp(): int
+external func AtalkHAtpReqFrom(): int
+external func AtalkHAtpSendResponse(sock: int, code: int, buf: ptr, n: int): int
+external func AtalkHAtpCall(addr: int, op: int, req: ptr, reqLen: int, resp: ptr, respCap: int): int
+external func AtalkHAtpCallCode(): int
+external func AtalkHPoll()
+
+// Scratch buffers, allocated once on the first successful Up (SerNewPtr /
+// SerDisposePtr are ser.cla's already-spliced NewPtr/DisposePtr externs --
+// conn.cla's own precedent for reusing them rather than redeclaring a
+// duplicate pair). One 578-byte request buffer per service slot, one
+// shared 4624-byte response buffer for the requester (rtSvcCallAddr is
+// synchronous, so one is enough), and a 68-byte Pascal-string buffer for
+// lookup names. `ptr` cannot be a container element, so the two request
+// buffers are two scalars behind rtAtCReqBuf() rather than an array.
+var rtAtCReqBuf0: ptr
+var rtAtCReqBuf1: ptr
+var rtAtCRespBuf: ptr
+var rtAtCNameBuf: ptr
+var rtAtCBufsOk: bool
+
+// Per-service-slot device state. The host stack's own request state is
+// process-global ("the LAST request AtalkHAtpGetRequest dequeued"), so
+// each slot snapshots op/from/len at poll time and atalk.cla's pump
+// answers one request before polling the next slot.
+var rtAtCSock: int[2]
+var rtAtCReqLen: int[2]
+var rtAtCReqOp: int[2]
+var rtAtCReqFrom: int[2]
+
+// rtAtCLastErr: the AtpOpen failure code, since that waist entry reports
+// "0 plus rtAtDevLastErr()" rather than returning the OSErr itself.
+var rtAtCLastErr: int
+
+func rtAtCReqBuf(slot: int): ptr {
+    if slot == 0 {
+        return rtAtCReqBuf0
+    }
+    return rtAtCReqBuf1
+}
+
+func rtAtDevUp(): int {
+    var e: int
+
+    e = AtalkHUp()
+    if e != 0 {
+        rtAtCLastErr = e
+        return e
+    }
+    if not rtAtCBufsOk {
+        if rtAtCReqBuf0 == ptr(0) {
+            rtAtCReqBuf0 = SerNewPtr(578)
+        }
+        if rtAtCReqBuf1 == ptr(0) {
+            rtAtCReqBuf1 = SerNewPtr(578)
+        }
+        if rtAtCRespBuf == ptr(0) {
+            rtAtCRespBuf = SerNewPtr(4624)
+        }
+        if rtAtCNameBuf == ptr(0) {
+            rtAtCNameBuf = SerNewPtr(68)
+        }
+        if rtAtCReqBuf0 == ptr(0) or rtAtCReqBuf1 == ptr(0) or rtAtCRespBuf == ptr(0) or rtAtCNameBuf == ptr(0) {
+            // memFullErr. Whatever DID allocate is kept, so a retry only
+            // asks for the blocks still missing.
+            rtAtCLastErr = -108
+            return -108
+        }
+        rtAtCBufsOk = true
+    }
+    return 0
+}
+
+func rtAtDevRegister(obj: string, typ: string, sock: int): int {
+    // Blocks ~3 s: the stack runs a verify lookup before claiming the
+    // name, exactly as the Mac's PRegisterName with verify does.
+    return AtalkHRegister(obj, typ, sock)
+}
+
+func rtAtDevRemove(obj: string, typ: string): int {
+    return AtalkHRemove(obj, typ)
+}
+
+func rtAtDevLookupStart(lk: int, obj: string, typ: string, zone: string): int {
+    return AtalkHLookupStart(lk, obj, typ, zone)
+}
+
+func rtAtDevLookupDone(lk: int): bool {
+    return AtalkHLookupDone(lk) != 0
+}
+
+func rtAtDevLookupCount(lk: int): int {
+    return AtalkHLookupCount(lk)
+}
+
+func rtAtDevLookupAddr(lk: int, i: int): int {
+    return AtalkHLookupAddr(lk, i)
+}
+
+// rtAtDevLookupName: "obj:type" as a Pascal string in the 68-byte scratch
+// buffer, read back byte by byte -- fileh_c.cla's rtFhDevListNext idiom.
+func rtAtDevLookupName(lk: int, i: int): string {
+    var s: string
+    var n: int
+    var j: int
+
+    if rtAtCNameBuf == ptr(0) {
+        return ""
+    }
+    AtalkHLookupName(lk, i, rtAtCNameBuf)
+    n = peekb(rtAtCNameBuf)
+    j = 0
+    while j < n {
+        s = s + char(peekb(rtAtCNameBuf + 1 + j))
+        j = j + 1
+    }
+    return s
+}
+
+// rtAtDevZones: this lane has no ZIP and no router, so the answer is
+// always noBridgeErr and atalk.cla substitutes ["*"] (spec %4.6). `out` is
+// deliberately untouched.
+func rtAtDevZones(out: list of string): int {
+    return rtAtErrNoBridge
+}
+
+func rtAtDevAtpOpen(): int {
+    var sock: int
+
+    sock = AtalkHAtpOpen()
+    if sock <= 0 {
+        rtAtCLastErr = sock
+        return 0
+    }
+    return sock
+}
+
+func rtAtDevAtpClose(sock: int) {
+    AtalkHAtpClose(sock)
+}
+
+// rtAtDevAtpArm: nothing to arm on this lane -- the host get-request is a
+// non-blocking poll, not an async parameter block -- so this only records
+// which socket rtAtDevAtpPoll should drain for the slot.
+func rtAtDevAtpArm(slot: int, sock: int): int {
+    rtAtCSock[slot] = sock
+    return 0
+}
+
+// rtAtDevAtpPoll: -1 from the glue means "nothing queued". A 0 is a
+// genuine ZERO-LENGTH request and must be dispatched like any other, so
+// the test is `< 0`, never `<= 0`.
+func rtAtDevAtpPoll(slot: int): int {
+    var n: int
+
+    if rtAtCSock[slot] == 0 {
+        return 0
+    }
+    n = AtalkHAtpGetRequest(rtAtCSock[slot], rtAtCReqBuf(slot), 578)
+    if n < 0 {
+        return 0
+    }
+    rtAtCReqLen[slot] = n
+    rtAtCReqOp[slot] = AtalkHAtpReqOp()
+    rtAtCReqFrom[slot] = AtalkHAtpReqFrom()
+    return 1
+}
+
+func rtAtDevAtpReqOp(slot: int): int {
+    return rtAtCReqOp[slot]
+}
+
+func rtAtDevAtpReqFrom(slot: int): int {
+    return rtAtCReqFrom[slot]
+}
+
+func rtAtDevAtpReqLen(slot: int): int {
+    return rtAtCReqLen[slot]
+}
+
+func rtAtDevAtpReqPtr(slot: int): ptr {
+    return rtAtCReqBuf(slot)
+}
+
+// rtAtDevAtpRespond: answers the request the last successful poll
+// dequeued (the glue's own contract), synchronously -- so a response is
+// never outstanding once this returns and rtAtDevAtpRespBusy is always
+// false on this lane.
+func rtAtDevAtpRespond(slot: int, code: int, p: ptr, n: int): int {
+    return AtalkHAtpSendResponse(rtAtCSock[slot], code, p, n)
+}
+
+func rtAtDevAtpRespBusy(slot: int): bool {
+    return false
+}
+
+// rtAtDevAtpCall: blocks up to 2 s x 3 retries inside the glue; incoming
+// requests queue meanwhile but are not answered until the next pump pass.
+func rtAtDevAtpCall(addr: int, op: int, req: ptr, reqLen: int): int {
+    return AtalkHAtpCall(addr, op, req, reqLen, rtAtCRespBuf, 4624)
+}
+
+func rtAtDevAtpCallCode(): int {
+    return AtalkHAtpCallCode()
+}
+
+func rtAtDevAtpCallPtr(): ptr {
+    return rtAtCRespBuf
+}
+
+func rtAtDevLastErr(): int {
+    return rtAtCLastErr
+}
+
+// rtAtDevPoll: drain the UDP socket and run the stack's timers. Guarded on
+// rtAtCBufsOk so it can never reach a stack that was never opened.
+func rtAtDevPoll() {
+    if rtAtCBufsOk {
+        AtalkHPoll()
+    }
+}
+
+// ---- ADSP + listener: absent on this lane (spec %4.6). Every entry
+// reports rtAtErrNoHost / 0 / false, which atalk.cla turns into the
+// "streams not available on this lane" failed event. ----
+
+func rtAdspDevOpen(slot: int, addr: int): int {
+    return rtAtErrNoHost
+}
+
+func rtAdspDevOpenPoll(slot: int): int {
+    return rtAtErrNoHost
+}
+
+func rtAdspDevAvail(slot: int): int {
+    return 0
+}
+
+func rtAdspDevRead(slot: int, p: ptr, n: int): int {
+    return 0
+}
+
+func rtAdspDevWrite(slot: int, p: ptr, n: int): int {
+    return rtAtErrNoHost
+}
+
+func rtAdspDevClose(slot: int) {
+}
+
+func rtAdspDevGone(slot: int): bool {
+    return true
+}
+
+func rtLsnDevInit(slot: int): int {
+    return rtAtErrNoHost
+}
+
+func rtLsnDevListen(slot: int): int {
+    return rtAtErrNoHost
+}
+
+func rtLsnDevPoll(slot: int): int {
+    return 0
+}
+
+func rtLsnDevAccept(slot: int, connSlot: int): int {
+    return rtAtErrNoHost
+}
+
+func rtLsnDevDeny(slot: int): int {
+    return rtAtErrNoHost
+}
+
+func rtLsnDevRemove(slot: int) {
+}
+
+func rtLsnDevSocket(slot: int): int {
+    return 0
+}
diff --git a/runtime/clarus/conn.cla b/runtime/clarus/conn.cla
index b3cdd43..db194e4 100644
--- a/runtime/clarus/conn.cla
+++ b/runtime/clarus/conn.cla
@@ -29,31 +29,29 @@
 // events as the spec itself distinguishes -- NOT interchangeable. Send on
 // a non-open slot panics (a bug); every OPEN failure (bad spec, device
 // error, already-open) is a `failed` event (weather), never a panic. A
 // WRITE failure on an already-open slot (spec %3: "failed(err) -- open
 // errors AND I/O errors") is weather too, staged as a pending `failed`
 // exactly like an open failure -- but the slot stays open (only the

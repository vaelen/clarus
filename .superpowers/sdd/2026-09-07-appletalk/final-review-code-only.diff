new file mode 100644
index 0000000..36ed5b8
--- /dev/null
+++ b/examples/atalkchat.cla
@@ -0,0 +1,305 @@
+// Copyright 2026, Andrew C. Young <andrew@vaelen.org>
+// SPDX-License-Identifier: MIT
+
+// atalkchat.cla (2026-09-06 appletalk spec 8.5, Task 11): the AppleTalk
+// phase's STREAM acceptance app -- one program that is either end of an
+// ADSP conversation, and the subject of tests/mactest/adsp_68k.sh's two
+// Mini vMac boots.
+//
+// Which end it is, is chosen at runtime by the button clicked:
+//
+//   Serve    lsn.register("Chat-<n>", "ClarusChat"), then echo every
+//            chunk that arrives back to the client with a '>' prepended,
+//            and quit when the client closes the stream.
+//   Connect  brs.find("ClarusChat"), then open(appletalk "Name:Type") to
+//            the first match, send a 0..255 byte sweep, check the echo
+//            byte for byte, send "hello", check that echo too, close.
+//
+// The registered name carries a per-run suffix (spec 8.4: multicast
+// LocalTalk sees every other session on the machine, so a fixed name
+// would collide with Andrew's own running copies), and the client takes
+// the FIRST "ClarusChat" entity NBP hands it -- it cannot know the
+// server's suffix, so it logs the name it picked and the test reads that
+// back.
+//
+// Both ends write the same shaped log, which is what adsp_68k.sh parses
+// out of the boot capture:
+//
+//   server   serving <name> / accepted / received 256 / received 5 /
+//            closed
+//   client   connecting / found <name> <net.node.socket> / opened /
+//            received 257 / echo ok / received 6 / echo ok / closing
+//
+// The exchange is deliberately LOCK-STEP -- the client sends "hello"
+// only after the sweep's echo has come back -- so each `received` length
+// is deterministic. Sending both up front would let ADSP coalesce them
+// into one 261-byte delivery on a slow pass, which is a legal stream
+// behavior but makes the per-chunk lengths unassertable.
+//
+// Not runnable on the host `cc` lane: this is a UI program, and the host
+// C lane only compiles non-UI programs (see examples/serialecho.cla's
+// own header for that gap). Build it with scripts/build-68k.sh, or with
+// `--events` for the scripted two-boot test.
+include "toolbox/osutils.cla"
+
+app AtalkChat {
+    name: "AtalkChat"
+    version: "1.0"
+    author: "Andrew C. Young <andrew@vaelen.org>"
+    about: "Two-Mac AppleTalk chat over ADSP."
+    id: "ACHT"
+}
+
+// Content top-left = ((512 - width) / 2, 44) for a window that fits on
+// screen unclamped (ui.cla's rtUiOpen), so (106, 44) here; a button's
+// default size is 80x20 (testsuite/toolbox/gui.cla's own derivation).
+// -> Serve   (116,54)-(196,74), center (156,64)
+//    Connect (206,54)-(286,74), center (246,64)
+// which is exactly what testdata/ui/atalkchat_{server,client}.events
+// click.
+window Chat {
+    title: "AppleTalk Chat"
+    size: 300, 160
+
+    button Serve   { at: 10, 10;  caption: "Serve" }
+    button Connect { at: 100, 10; caption: "Connect" }
+    label Status   { at: 10, 45; width: 280; text: "idle" }
+    label Peer     { at: 10, 70; width: 280; text: "" }
+}
+
+menu File {
+    item Quit "Quit" key "Q"
+}
+
+var chatType: string = "ClarusChat"
+
+const roleIdle: int = 0
+const roleServer: int = 1
+const roleClient: int = 2
+
+var lsn: listener
+var brs: serviceBrowser
+var chat: connection
+
+var role: int = 0
+var dialed: bool = false
+var tries: int = 0
+var sent: text
+var out: text
+var beats: int = 0
+var quitAt: int = 0
+
+// The watchdog exists for the same reason testdata/atalk/selfserve.cla's
+// does: every end state here is reached by a network event, so a waist
+// body that never completes would otherwise sit in the event loop until
+// the boot deadline -- a timeout instead of a readable log line.
+var maxBeats: int = 380
+
+func setStatus(s: string) {
+    var w: Chat = Chat.front
+
+    if w != nil {
+        w.Status.text = s
+    }
+}
+
+func setPeer(s: string) {
+    var w: Chat = Chat.front
+
+    if w != nil {
+        w.Peer.text = s
+    }
+}
+
+on App.launch {
+    open Chat
+}
+
+extend Chat {
+    on Serve.click {
+        var name: string
+
+        if role == roleIdle {
+            role = roleServer
+            // `mod` is a remainder, and a Mac whose clock was never
+            // set reads back a NEGATIVE `now()` (the stripped LaunchAPPL
+            // boot disk does exactly that -- the first real run of this
+            // registered "Chat--8422"), so fold it back into 0..9999.
+            name = "Chat-" + string(((now() mod 10000) + 10000) mod 10000)
+            lsn.register(name, chatType)
+            log("serving " + name)
+            Status.text = "serving " + name
+        }
+    }
+    on Connect.click {
+        if role == roleIdle {
+            role = roleClient
+            log("connecting")
+            Status.text = "looking for a chat server"
+            brs.find(chatType)
+        }
+    }
+}
+
+extend File {
+    on Quit.select { quit }
+}
+
+// ---- server side ----
+
+on lsn.accepted(c: connection) {
+    // spec 4.2: the connection arrives already open, so no `opened`
+    // fires for it. It lands in the program's one connection slot --
+    // `chat` is the only `connection` global, so slot 0 is both what the
+    // pre-pass gave `chat` and the free slot the accept picks, which is
+    // what makes the `on chat.received` handler below fire for it.
+    chat = c
+    log("accepted")
+    setStatus("client connected")
+}
+
+on lsn.failed(err: error) {
+    log("failed " + string(err.code) + " " + err.message)
+    setStatus("listener failed: " + err.message)
+    quit
+}
+
+// ---- client side ----
+
+on brs.found(name: string, addr: address) {
+    if not dialed {
+        dialed = true
+        log("found " + name + " " + string(addr))
+        setPeer(name + " " + string(addr))
+        chat.open(appletalk name + ":" + chatType)
+    }
+}
+
+on brs.done {
+    if not dialed {
+        // The server may not have finished registering its name yet --
+        // it boots first, but NBP registration is itself a couple of
+        // seconds of network traffic. Each retry is a full lookup, so
+        // this is self-paced, not a spin.
+        tries = tries + 1
+        if tries >= 8 {
+            log("no server found")
+            quit
+        }
+        brs.find(chatType)
+    }
+}
+
+on brs.failed(err: error) {
+    log("failed " + string(err.code) + " " + err.message)
+    quit
+}
+
+on chat.opened {
+    var i: int = 0
+
+    log("opened")
+    setStatus("connected")
+    sent.clear()
+    sent.reserve(256)
+    while i < 256 {
+        sent.append(char(i))
+        i = i + 1
+    }
+    chat.send(sent)
+}
+
+// ---- shared ----
+
+// echoOk: the server's echo of `sent` is those same bytes with a '>'
+// prepended. This is the byte-exactness half of spec 8.2's "byte-exact
+// echo both ways" -- a length check alone would pass on a stream that
+// dropped or reordered bytes.
+func echoOk(data: text): bool {
+    var i: int = 0
+
+    if data.length != sent.length + 1 {
+        return false
+    }
+    if data[0] != '>' {
+        return false
+    }
+    while i < sent.length {
+        if data[i + 1] != sent[i] {
+            return false
+        }
+        i = i + 1
+    }
+    return true
+}
+
+on chat.received(data: text) {
+    log("received " + string(data.length))
+    if role == roleServer {
+        out.clear()
+        out.append('>')
+        out.append(data)
+        chat.send(out)
+    } else {
+        if echoOk(data) {
+            log("echo ok")
+        } else {
+            log("echo bad")
+        }
+        if sent.length == 256 {
+            sent.clear()
+            sent.append("hello")
+            chat.send(sent)
+        } else {
+            chat.close()
+            log("closing")
+            setStatus("done")
+            // Not `quit` outright: the close has to reach the server for
+            // its own `closed` to fire, and quitting inside this handler
+            // would tear the slot down first.
+            quitAt = beats + 6
+        }
+    }
+}
+
+on chat.closed {
+    log("closed")
+    setStatus("peer closed")
+    quit
+}
+
+on chat.failed(err: error) {
+    log("failed " + string(err.code) + " " + err.message)
+    setStatus("failed: " + err.message)
+    quit
+}
+
+// A REAL app would not have this Delay. It exists only because a
+// `--events` build's ticks are VIRTUAL (uiscript.cla's rtUiVirtualTicks:
+// the real clock is never consulted in scripted mode, and each script
+// line does exactly one pump pass), so without it the whole event script
+// would run out in well under a second -- before the peer has even
+// finished booting -- and the program would quit with nothing to show.
+// Delay(10) is a sixth of a second, so a 400-line `tick 12` script is
+// ~66 s of real overlap between the two boots.
+//
+// The 12-tick period is deliberately LONGER than the 10-tick Delay:
+// blocking for longer than the beat's own period would peg the duty
+// cycle at 100% and starve WaitNextEvent outright. As written the beat
+// blocks 10 ticks out of every 12 -- ~83% -- which in a real
+// interactive build means the event loop sees ~5 free ticks a second
+// and a click can wait up to ~167 ms. That is the honest cost, and it
+// is paid on a beat the app spends waiting for the network anyway.
+every 12 ticks {
+    var slept: int // result ignored; Delay is called for its blocking
+
+    slept = Delay(10)
+    beats = beats + 1
+    if quitAt != 0 and beats >= quitAt {
+        quit
+    }
+    if beats >= maxBeats {
+        log("watchdog role " + string(role))
+        quit
+    }
+}
diff --git a/examples/atalkclock.cla b/examples/atalkclock.cla
new file mode 100644
index 0000000..5619ccb
--- /dev/null
+++ b/examples/atalkclock.cla
@@ -0,0 +1,175 @@
+// Copyright 2026, Andrew C. Young <andrew@vaelen.org>
+// SPDX-License-Identifier: MIT
+
+// atalkclock.cla: the AppleTalk phase's NATIVE acceptance app (spec
+// %8.5) -- one small Macintosh program that is BOTH ends of a service.
+// It advertises a clock of its own under an NBP name, answers two
+// operations on it, browses the zone for every other clock, and asks
+// each of them for the time.
+//
+//     scripts/build-68k.sh examples/atalkclock.cla    # a real .bin
+//
+// Nothing in here is Toolbox knowledge: `service`, `serviceBrowser` and
+// `address` are the whole surface (docs/clarus-language-reference.md,
+// Chapter 12's "Service Discovery" and "Services" sections), and the
+// program never polls -- `found`/`done` arrive from the event loop, and
+// `request` fires once per incoming call.
+//
+// The served name carries a per-launch suffix. NBP names are global to
+// the zone and registration VERIFIES uniqueness, so two Macs (or two
+// launches after a crash left a stale name) must not both ask for
+// "Clock". `now()` is the Mac clock in seconds, so the low 12 bits of it
+// change every launch that is at least a second apart -- the same reason
+// the test scripts give their own names a per-run suffix (spec %8.4).
+//
+// tests/mactest/atalk_68k.sh boots this against `atalkdrive` on the
+// host, driving it from testdata/atalk/clockdrive.cla rather than a
+// scripted-event file: scripted mode advances a VIRTUAL tick counter and
+// never waits, and every assertion here needs real seconds to pass while
+// NBP and ATP round-trip against a real peer.
+
+app AtalkClock {
+    name: "AtalkClock"
+    version: "1.0"
+    author: "Andrew C. Young <andrew@vaelen.org>"
+    about: "Serves the time over AppleTalk, and asks its neighbours for theirs."
+    id: "ACLK"
+}
+
+// The operations this service answers. The checked conversion below is
+// guarded, so an operation number off the wire can never raise a runtime
+// error -- Chapter 12's own idiom for a `request` handler.
+enum ClockOp { Time 1 "Time", Echo 2 "Echo" }
+
+var clock: service
+var browser: serviceBrowser
+var myName: string             // "Clock-1234", once serving
+var myEntity: string           // "Clock-1234:ClarusClock", once serving
+var peers: list of string      // every "Name:Type" the last find turned up
+var zoneNames: list of string
+var reply: text
+var shown: text
+
+window Clock {
+    title: "Clock"
+    size: 320, 200
+
+    label Zones { at: 10, 10; width: 296; text: "Zones:" }
+    textview Peers { fill: both; scrollbar: vertical }
+    button Find { at: 10, bottom;   caption: "Find" }
+    button Call { at: next, bottom; caption: "Call" }
+    button Quit { at: next, bottom; caption: "Quit" }
+}
+
+// atClockRepaint: the window is optional -- every entry point below
+// works whether or not it is open, so a `nil` front window is not an
+// error here.
+func atClockRepaint() {
+    var w: Clock = Clock.front
+    var i: int = 0
+    var line: string = "Zones:"
+
+    if w == nil {
+        return
+    }
+    shown.clear()
+    while i < peers.count {
+        shown.append(peers[i])
+        shown.append("\n")
+        i = i + 1
+    }
+    w.Peers.text = shown
+    i = 0
+    while i < zoneNames.count {
+        line = line + " " + zoneNames[i]
+        i = i + 1
+    }
+    w.Zones.text = line
+}
+
+// atClockFind: start a fresh browse of the zone. `find` returns at once;
+// `found` then fires once per match and `done` always follows.
+func atClockFind() {
+    peers.clear()
+    atClockRepaint()
+    browser.find("ClarusClock")
+}
+
+// atClockCall: ask every OTHER clock for its time. `call` is synchronous
+// (it blocks for up to a couple of seconds per peer), which is why it is
+// a button and not something the browse does on its own.
+func atClockCall() {
+    var i: int = 0
+    var n: int = 0
+
+    while i < peers.count {
+        if peers[i] != myEntity {
+            if clock.call(peers[i], 1, "", reply) {
+                // A reply is a `text` and may be up to 4624 bytes; a
+                // `string` holds 255, and slicing past the end is a
+                // runtime error, not a truncation. A clock's answer is a
+                // couple of dozen characters, so clamp to 60 and log
+                // that -- never `reply[0, reply.length]`, which raises
+                // "slice out of range" the first time a peer answers
+                // with something long.
+                n = reply.length
+                if n > 60 {
+                    n = 60
+                }
+                log("remote " + peers[i] + " " + reply[0, n])
+            } else {
+                log("remote " + peers[i] + " failed " + string(lastError.code) + " " + lastError.message)
+            }
+        }
+        i = i + 1
+    }
+}
+
+on App.launch {
+    open Clock
+    myName = "Clock-" + string(now() & 0xFFF)
+    myEntity = myName + ":ClarusClock"
+    clock.serve(myName, "ClarusClock")
+    log("serving " + myEntity)
+    browser.zones(zoneNames)
+    atClockFind()
+}
+
+on clock.request(op: int, req: text, from: address) {
+    if op < 1 or op > 2 {
+        clock.reply(-1, "")
+        return
+    }
+    switch ClockOp(op) {
+    case Time {
+        clock.reply(0, dateTimeStr(now()))
+    }
+    case Echo {
+        clock.reply(0, req)
+    }
+    }
+}
+
+on clock.failed(err: error) {
+    log("clock failed " + string(err.code) + " " + err.message)
+}
+
+on browser.found(name: string, addr: address) {
+    peers.add(name)
+    log("found " + name + " " + string(addr))
+}
+
+on browser.done {
+    atClockRepaint()
+    log("browse done " + string(peers.count))
+}
+
+on browser.failed(err: error) {
+    log("browse failed " + string(err.code) + " " + err.message)
+}
+
+extend Clock {
+    on Find.click { atClockFind() }
+    on Call.click { atClockCall() }
+    on Quit.click { quit }
+}
diff --git a/examples/atalkfind.cla b/examples/atalkfind.cla
new file mode 100644
index 0000000..c48f98b
--- /dev/null
+++ b/examples/atalkfind.cla
@@ -0,0 +1,55 @@
+// Copyright 2026, Andrew C. Young <andrew@vaelen.org>
+// SPDX-License-Identifier: MIT
+
+// atalkfind.cla: the AppleTalk phase's HOST acceptance program (Task 8) --
+// the AppleTalk counterpart of `atlookup`/`nbplkup`, in 30 lines of
+// Clarus with no Toolbox knowledge anywhere in it.
+//
+//     scripts/clarus-run.sh examples/atalkfind.cla            # every entity
+//     scripts/clarus-run.sh examples/atalkfind.cla -- ClockSrv # one type
+//
+// It prints the router's zone list (the single zone "*" on a routerless
+// network -- which is every LocalTalk network without a bridge, and every
+// host-lane run), then does one NBP lookup of `=:type@*`, printing every
+// match as `name  net.node.socket`. The default type is "=", which
+// matches every registered entity of every type: AppleTalk has no
+// node-enumeration protocol of its own, and this lookup is what "list the
+// machines" means on it.
+//
+// The whole program is event-driven and never polls: `find` returns
+// immediately, `found` fires once per match from the pump loop, and
+// `done` always arrives -- even with no matches at all -- which is what
+// ends the program, since the host CLI stays alive exactly as long as a
+// search is in flight (Chapter 12's lifetime rule).
+var browser: serviceBrowser
+var zoneNames: list of string
+var hits: int
+
+on App.startCLI(args: list of string) {
+    var i: int = 0
+
+    browser.zones(zoneNames)
+    while i < zoneNames.count {
+        log("zone " + zoneNames[i])
+        i = i + 1
+    }
+    if args.count > 0 {
+        browser.find(args[0])
+    } else {
+        browser.find("=")
+    }
+}
+
+on browser.found(name: string, addr: address) {
+    hits = hits + 1
+    log(name + "  " + string(addr))
+}
+
+on browser.done {
+    log("done, " + string(hits) + " found")
+}
+
+on browser.failed(err: error) {
+    log("lookup failed: " + err.message + " (" + string(err.code) + ")")
+    quit 1
+}

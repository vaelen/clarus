diff --git a/toolbox/appletalk.cla b/toolbox/appletalk.cla
new file mode 100644
index 0000000..893114c
--- /dev/null
+++ b/toolbox/appletalk.cla
@@ -0,0 +1,586 @@
+// Copyright 2026, Andrew C. Young <andrew@vaelen.org>
+// SPDX-License-Identifier: MIT
+
+// toolbox/appletalk.cla: curated AppleTalk driver declarations -- the
+// .MPP (LAP/DDP/NBP), .ATP, .XPP (ZIP) and .DSP (ADSP) drivers -- for
+// the AppleTalk phase, Task 6. Every AppleTalk call is an ordinary
+// Device Manager Control/Status call against one of those four named
+// drivers, dispatched on the parameter block's own `csCode` field, NOT a
+// trap of its own: the routines that issue them are PBOpenSync /
+// PBControlSync / PBStatusSync / PBKillIOSync from toolbox/devices.cla
+// (compose both files), plus the ONE new form this file adds,
+// PBControlAsync. Inside Macintosh II ch. 10 ("The AppleTalk Manager"),
+// Inside Macintosh V ch. 28, Inside Macintosh VI ch. 32 (ADSP + ZIP) and
+// Inside Macintosh: Networking (1994) are the prose sources; the numbers
+// come from the headers cited per declaration.
+//
+// Every constant and struct layout below is confirmed directly against
+// Apple's own Universal Interfaces 3.4 (Retro68/InterfacesAndLibraries/
+// Interfaces/CIncludes/{AppleTalk,ADSP,MacErrors,Devices}.h), read via
+// `LC_ALL=C tr '\r' '\n' < AppleTalk.h` -- those headers have CR-only
+// line endings and MacRoman bytes, so a plain `grep -n` silently reports
+// nothing against them (toolbox/devices.cla's header comment records the
+// same trap). Line numbers below are from that reflow, matching the
+// headers' own native numbering 1:1. Read on 2026-09-07.
+//
+// ---- THREE RULES a caller must follow (all three cost real boots) ----
+//
+// 1. **Every AppleTalk parameter block is at least 52 bytes.** The
+//    Device Manager's ParamBlockRec union is larger than the fields any
+//    one AppleTalk call names, and the driver writes into fields the
+//    caller never set (ATP's SendReqparms alone is 52 bytes,
+//    AppleTalk.h:816-841). Every `extern record` below is therefore
+//    padded to at least 52 bytes even where the named fields stop far
+//    short -- the same discipline toolbox/devices.cla's header comment
+//    states for CntrlParam's 50, raised to 52 for this family. A short
+//    record is a stack overrun waiting to stomp its neighbours.
+//    (BDSElement is the one exception below and is not a parameter
+//    block -- see its own comment.)
+//
+// 2. **NEVER reuse a parameter block for a second call without
+//    re-zeroing the WHOLE block.** Task 1's probe wave
+//    (task-1-report.md Amendment 2) hung the emulated Mac hard, three
+//    boots in a row with no bomb and no error, by issuing a second
+//    `lookupName` on the same block a first `lookupName` had just
+//    completed on, rewriting only the call fields. The stale queue
+//    fields (qLink@0 / qType@4, which the driver owns) are the likely
+//    culprit. A fresh zero-initialized `extern record` local per call is
+//    the cheapest correct answer for sync code (an extern record local
+//    is zero-initialized on declaration -- language reference, "extern
+//    record"); a long-lived block allocated with NewPtrClear must be
+//    cleared IN FULL between calls, not just in the fields being set.
+//
+// 3. **NBP registers the socket you give it, verbatim.** `registerName`
+//    fills in the NTE's `nteAddress` net and node itself, but copies
+//    `aSocket` (NTE+7, i.e. nteAddress+3) straight through. A real
+//    service must write its own listening socket -- the ATP socket
+//    `openATPSkt` handed back, or the ADSP socket -- into NTE+7 BEFORE
+//    calling `registerName`, or every client that looks the name up gets
+//    an address with socket 0 and cannot connect (task-1-report.md
+//    Amendment 1, observed on the wire).
+//
+// Two further facts recorded by the same probe wave, load-bearing for
+// anything built on this catalog:
+//   - `registerName` is also the cheapest way for a program to learn its
+//     OWN address: afterwards NTE+4..7 holds net(2) node(1) socket(1).
+//     No GetNodeAddress glue and no low-memory poking is needed
+//     (Amendment 4).
+//   - The Mac Plus ROM .MPP does NOT implement `setSelfSend` (csCode
+//     256 returns -17, controlErr) and never answers its own NBP
+//     lookups. The constant is declared below for completeness; do not
+//     build on it without a Gestalt-style runtime check.
+//   - `lookupName` runs ALL its retries even after an answer arrives:
+//     a lookup costs about `count x interval x 8` ticks regardless.
+//     At the classic interval 8 / count 3 that is ~3.2 seconds.
+
+// ---- The one new trap: the ASYNC Control call ----
+//
+//   PBControlAsync Devices.h:1307-1310 (pragma 1307, trap 1310):
+//                  `#pragma parameter __D0 PBControlAsync(__A0)` ...
+//                  `EXTERN_API( OSErr ) PBControlAsync(ParmBlkPtr
+//                  paramBlock) ONEWORDINLINE(0xA404);` -- pb in A0,
+//                  OSErr in D0, bit 11 clear (0xA404 & 0x0800 == 0) -->
+//                  OS/register convention, bare `reg`, the same shape as
+//                  toolbox/devices.cla's own PBxxxSync declarations. The
+//                  0x0400 bit versus PBControlSync's 0xA004 is the
+//                  Device Manager's async bit (bit 10). The call returns
+//                  immediately with 0 = "queued"; the real result lands
+//                  in the block's own ioResult@16 (pbIoResult below),
+//                  which stays 1 (ioInProgress) until the driver
+//                  completes the request. Rule 2 above applies with
+//                  full force: an async block is owned by the driver
+//                  until ioResult stops being 1.
+//
+// PBOpenSync / PBControlSync / PBStatusSync / PBKillIOSync are NOT
+// redeclared here -- they come from toolbox/devices.cla, which every
+// AppleTalk build must compose alongside this file (two declarations of
+// the same extern name in one build is a real hazard, not a cosmetic
+// one; see that file's own header comment).
+external func PBControlAsync(paramBlock: ptr): int = trap 0xA404 reg
+
+// ---- The four drivers, and their refNums (AppleTalk.h:58-63) ----
+//
+// A caller opens each BY NAME through PBOpenSync (toolbox/devices.cla
+// documents the NewPtr+pokeb Pascal-string pattern `ioNamePtr` needs,
+// and testsuite/toolbox/cases_serial.cla's `serPName` is the worked
+// example) and then reads the OS-assigned refNum back out of the
+// paramBlock. The names themselves -- ".MPP", ".ATP", ".XPP", ".DSP" --
+// are Inside Macintosh prose convention, not header symbols, so no
+// `const string` is declared for them (same discipline as
+// toolbox/serial.cla's four serial driver names). The refNum constants
+// ARE header symbols and are declared, so a caller can assert the
+// driver it got is the driver it asked for.
+//
+// ADSP's refNum is dynamic -- the header's own comment says so -- so
+// there is no `dspRefNum`; ".DSP" hands back whatever the Device
+// Manager assigned it.
+//
+// Availability, measured (task-1-report.md P1): .MPP (-10) and .ATP
+// (-11) live in the Mac Plus ROM and open on any AppleTalk-capable
+// machine. .XPP and .DSP live in the `AppleTalk` System file and return
+// -43 (fnfErr) if that file is not in the resource chain -- which it is
+// NOT on LaunchAPPL's stripped boot disk.
+const mppRefNum: int = -10   // AppleTalk.h:60 -- .MPP (LAP/DDP/NBP)
+const atpRefNum: int = -11   // AppleTalk.h:61 -- .ATP
+const xppRefNum: int = -41   // AppleTalk.h:62 -- .XPP (ASP/AFP/ZIP)
+
+// ---- .MPP csCodes (AppleTalk.h:65-86) ----
+//
+// Only the DDP and NBP codes a Clarus program plausibly issues are
+// declared; the resident LAP codes (lookupReply 242, writeLAP 243,
+// detachPH 244, attachPH 245, loadNBP/lastResident 249, unloadNBP 255)
+// and the System 7 additions (SetMyZone 257, GetATalkInfo 258,
+// ATalkClosePrep 259) are recorded here in prose rather than redeclared,
+// on the "declare what the phase's abstractions actually reach" rule.
+const writeDDP: int = 246      // AppleTalk.h:71 -- Control: write out a DDP datagram
+const closeSkt: int = 247      // AppleTalk.h:72 -- Control: close a DDP socket
+const openSkt: int = 248       // AppleTalk.h:73 -- Control: open a DDP socket
+const confirmName: int = 250   // AppleTalk.h:76 -- Control: NBP ConfirmName
+const lookupName: int = 251    // AppleTalk.h:77 -- Control: NBP LookupName
+const removeName: int = 252    // AppleTalk.h:78 -- Control: NBP RemoveName
+const registerName: int = 253  // AppleTalk.h:79 -- Control: NBP RegisterName
+const killNBP: int = 254       // AppleTalk.h:80 -- Control: cancel an outstanding NBP request
+const setSelfSend: int = 256   // AppleTalk.h:82 -- Control: allow sends to self; -17 on the Mac Plus ROM (see header)
+
+// ---- .ATP csCodes (AppleTalk.h:88-102) ----
+const nSendRequest: int = 248   // AppleTalk.h:90 -- NSendRequest (extended send request)
+const relRspCB: int = 249       // AppleTalk.h:91 -- release a response control block
+const closeATPSkt: int = 250    // AppleTalk.h:92 -- close an ATP socket
+const addResponse: int = 251    // AppleTalk.h:93 -- add a response to an open transaction
+const sendResponse: int = 252   // AppleTalk.h:94 -- send the response to a request
+const getRequest: int = 253     // AppleTalk.h:95 -- receive a request (issue ASYNC; see PBControlAsync)
+const openATPSkt: int = 254     // AppleTalk.h:96 -- open an ATP socket (atpSocket 0 = "any dynamic")
+const sendRequest: int = 255    // AppleTalk.h:97 -- send a request, block for the response
+const relTCB: int = 256         // AppleTalk.h:98 -- release a transaction control block
+const killGetReq: int = 257     // AppleTalk.h:99 -- cancel one GetRequest
+const killSendReq: int = 258    // AppleTalk.h:100 -- cancel one SendRequest
+const killAllGetReq: int = 259  // AppleTalk.h:101 -- cancel every GetRequest on a socket; -17 on the Mac Plus ROM (task-1-report.md P3b) -- use PBKillIOSync instead
+
+// ---- .XPP csCode + the ZIP sub-codes (AppleTalk.h:104-115, 200-204) ----
+//
+// The zone calls are `xCall` (csCode 246) with the real selector in the
+// block's own `xppSubCode`@28 -- XCallParam below. The other .XPP
+// csCodes (openSess 255 ... closeAll 247) are ASP/AFP session calls this
+// phase does not reach and are not redeclared.
+const xCall: int = 246              // AppleTalk.h:115 -- .XPP extended calls (ZIP lives here)
+const zipGetLocalZones: int = 5     // AppleTalk.h:201 -- xppSubCode: zones on the local net
+const zipGetZoneList: int = 6       // AppleTalk.h:202 -- xppSubCode: every zone on the internet
+const zipGetMyZone: int = 7         // AppleTalk.h:203 -- xppSubCode: this node's own zone
+
+// ---- .DSP (ADSP) csCodes (ADSP.h:52-67) ----
+const dspInit: int = 255       // ADSP.h:53 -- create a connection end
+const dspRemove: int = 254     // ADSP.h:54 -- remove a connection end
+const dspOpen: int = 253       // ADSP.h:55 -- open a connection
+const dspClose: int = 252      // ADSP.h:56 -- close a connection
+const dspCLInit: int = 251     // ADSP.h:57 -- create a connection listener
+const dspCLRemove: int = 250   // ADSP.h:58 -- remove a connection listener
+const dspCLListen: int = 249   // ADSP.h:59 -- post a listener request
+const dspCLDeny: int = 248     // ADSP.h:60 -- deny an open-connection request
+const dspStatus: int = 247     // ADSP.h:61 -- status of a connection end
+const dspRead: int = 246       // ADSP.h:62 -- read data from the connection
+const dspWrite: int = 245      // ADSP.h:63 -- write data on the connection
+const dspAttention: int = 244  // ADSP.h:64 -- send an attention message
+const dspOptions: int = 243    // ADSP.h:65 -- set connection-end options
+const dspReset: int = 242      // ADSP.h:66 -- forward-reset the connection
+const dspNewCID: int = 241     // ADSP.h:67 -- generate a connection id
+
+// ---- ATP flags and sizes ----
+//
+// atpMaxData/atpMaxNum/bdsEntrySz are the three sizes an ATP caller
+// needs that AppleTalk.h does NOT name as enum constants; each is
+// derived from the header and cross-checked against Inside Macintosh:
+//   atpMaxData 578 -- the maximum ATP response-data size. NOT a header
+//     symbol under any name: the source is Inside Macintosh II ch. 10's
+//     own ATP section (each response carries up to 578 bytes of data).
+//     AppleTalk.h:780 is only INDIRECT corroboration -- it is
+//     XCallParam's zipBuffPtr comment, "pointer to buffer (must be 578
+//     bytes)", which reads 578 precisely because a ZIP reply is itself
+//     one ATP response.
+//   atpMaxNum 8 -- responses per transaction, i.e. the BDS array's
+//     length: AppleTalk.h:337 `typedef BDSElement BDSType[8]`.
+//   bdsEntrySz 12 -- one BDSElement, AppleTalk.h:330-335 (short + Ptr +
+//     short + long, 68k-packed) -- see the BDSElement record below.
+const atpXOvalue: int = 32         // AppleTalk.h:193 -- atpFlags: exactly-once transaction
+const atpEOMvalue: int = 16        // AppleTalk.h:194 -- atpFlags: end-of-message
+const atpSTSvalue: int = 8         // AppleTalk.h:195 -- atpFlags: send transmission status
+const atpTIDValidvalue: int = 2    // AppleTalk.h:196 -- atpFlags: transaction ID valid
+const atpSendChkvalue: int = 1     // AppleTalk.h:197 -- atpFlags: send checksum
+const atpMaxData: int = 578        // IM II ch.10 (see above) -- max bytes per ATP response
+const atpMaxNum: int = 8           // AppleTalk.h:337 (BDSType[8]) -- max responses per transaction
+const bdsEntrySz: int = 12         // AppleTalk.h:330-335 -- one BDSElement, 68k-packed
+
+// ---- ADSP open modes, states, event flags and sizes ----
+//
+// ccbSize 242 is likewise not a header enum: it is sizeof(TRCCB),
+// ADSP.h:105-116 -- ccbLink(4) refNum(2) state(2) userFlags(1)
+// localSocket(1) remoteAddress(4) attnCode(2) attnSize(2) attnPtr(4)
+// reserved[220] = 242. A client allocates the CCB (NewPtrClear) and
+// hands ADSP the pointer in dspInitCcbPtr; ADSP owns it thereafter.
+const ocRequest: int = 1       // ADSP.h:72 -- ocMode: request a connection with the remote end
+const ocPassive: int = 2       // ADSP.h:73 -- ocMode: wait for a connection request
+const ocAccept: int = 3        // ADSP.h:74 -- ocMode: accept a request a listener delivered
+const ocEstablish: int = 4     // ADSP.h:75 -- ocMode: consider the connection already open
+const sListening: int = 1      // ADSP.h:80 -- ccbState: connection listener
+const sPassive: int = 2        // ADSP.h:81 -- ccbState: waiting for a connection request
+const sOpening: int = 3        // ADSP.h:82 -- ccbState: requesting a connection
+const sOpen: int = 4           // ADSP.h:83 -- ccbState: connection is open
+const sClosing: int = 5        // ADSP.h:84 -- ccbState: connection is being torn down
+const sClosed: int = 6         // ADSP.h:85 -- ccbState: closed
+const eClosed: int = 128       // ADSP.h:90 -- ccbUserFlags 0x80: connection-closed advice received
+const eTearDown: int = 64      // ADSP.h:91 -- ccbUserFlags 0x40: connection broken
+const eAttention: int = 32     // ADSP.h:92 -- ccbUserFlags 0x20: attention message received
+const eFwdReset: int = 16      // ADSP.h:93 -- ccbUserFlags 0x10: forward-reset advice received
+const attnBufSize: int = 570   // ADSP.h:98 -- required size of the client attention buffer
+const minDSPQueueSize: int = 100  // ADSP.h:99 -- minimum send/receive queue size
+const ccbSize: int = 242       // ADSP.h:105-116 (sizeof TRCCB) -- allocate with NewPtrClear
+
+// ---- Error codes (MacErrors.h) ----
+const ddpSktErr: int = -91         // MacErrors.h:204 -- bad socket number
+const noBridgeErr: int = -93       // MacErrors.h:206 -- no router for a non-local send
+const portInUse: int = -97         // MacErrors.h:210 -- driver open: port already in use
+const portNotCf: int = -98         // MacErrors.h:211 -- driver open: PRAM not configured for this port
+const nbpBuffOvr: int = -1024      // MacErrors.h:622 -- LookupName reply buffer overflowed
+const nbpNoConfirm: int = -1025    // MacErrors.h:623 -- ConfirmName found nothing
+const nbpConfDiff: int = -1026     // MacErrors.h:624 -- name confirmed at a different socket
+const nbpDuplicate: int = -1027    // MacErrors.h:625 -- RegisterName: name already in use
+const nbpNotFound: int = -1028     // MacErrors.h:626 -- RemoveName: name not in the table
+const nbpNISErr: int = -1029       // MacErrors.h:627 -- could not open the Names Information Socket
+const reqFailed: int = -1096       // MacErrors.h:644 -- ATP SendRequest: retry count exhausted
+const tooManyReqs: int = -1097     // MacErrors.h:645 -- too many concurrent ATP requests

+const noDataArea: int = -1104      // MacErrors.h:652 -- no data area available
+const reqAborted: int = -1105      // MacErrors.h:653 -- request aborted
+const errRefNum: int = -1280       // MacErrors.h:659 -- ADSP: bad connection refNum
+const errAborted: int = -1279      // MacErrors.h:660 -- ADSP: control call aborted
+const errState: int = -1278        // MacErrors.h:661 -- ADSP: wrong connection state for this call
+const errOpening: int = -1277      // MacErrors.h:662 -- ADSP: open-connection request failed
+const errAttention: int = -1276    // MacErrors.h:663 -- ADSP: attention message too long
+const errFwdReset: int = -1275     // MacErrors.h:664 -- ADSP: read terminated by a forward reset
+const errDSPQueueSize: int = -1274 // MacErrors.h:665 -- ADSP: send/receive queue too small
+const errOpenDenied: int = -1273   // MacErrors.h:666 -- ADSP: open request denied by the remote end
+const atpLenErr: int = -3106       // MacErrors.h:1222 -- ATP: bad length
+const atpBadRsp: int = -3107       // MacErrors.h:1223 -- ATP: bad response
+const sktClosedErr: int = -3109    // MacErrors.h:1225 -- ATP: socket closed
+
+// ---- Parameter blocks ----
+//
+// Same house style toolbox/devices.cla established for CntrlParam and
+// toolbox/files.cla for FileParam/VolumeParam/IOParam: `extern record`
+// has no array field type and no union, so a single record cannot name
+// every csCode's payload at its own offset. One record per PAYLOAD
+// SHAPE, each padded out to at least the 52-byte floor Rule 1 above
+// states, each carrying the identical Device Manager prefix
+// (AppleTalk.h:565-580 for the NBP family):
+//   qLink@0(4) qType@4(2) ioTrap@6(2) ioCmdAddr@8(4) ioCompletion@12(4)
+//   ioResult@16(2) userData@18(4) reqTID@22(2) ioRefNum@24(2)
+//   csCode@26(2)
+// -- field names transcribed verbatim from the header. Note the
+// AppleTalk family's prefix differs from IOParam's/CntrlParam's after
+// ioResult: where those carry ioNamePtr@18 + ioVRefNum@22, the MPP/ATP
+// blocks carry `userData`@18 (the ATP user bytes) and `reqTID`@22.
+// The one exception is DSPParam, which uses the ordinary
+// ioNamePtr/ioVRefNum/ioCRefNum prefix (ADSP.h:193-216).
+//
+// A caller declares one of these as a LOCAL per call (zero-initialized
+// on declaration, so Rule 2 is satisfied by construction). Code that
+// must keep a block alive across an async call allocates it with
+// NewPtrClear instead and reaches its fields through the offset
+// constants at the bottom of this file.
+
+// NBPParam -- the plain NBP shape: RegisterName's own union arm is
+// `ntQElPtr` and RemoveName/LookupName/ConfirmName's is `entityPtr`
+// (AppleTalk.h:545-549, `union NBPPtrs`), both at offset 30, so this
+// record names it `entityPtr` and NBPRegParam below names the same
+// 4 bytes `ntQElPtr`. Use this one for RemoveName and KillNBP, which
+// need nothing past offset 30. Real NBPparms is 44 bytes
+// (AppleTalk.h:565-580); padded to 52 per Rule 1.
+extern record NBPParam {
+    qLink: ptr
+    qType: word
+    ioTrap: word
+    ioCmdAddr: ptr
+    ioCompletion: ptr
+    ioResult: word
+    userData: int
+    reqTID: word
+    ioRefNum: word
+    csCode: word
+    interval: byte
+    count: byte
+    entityPtr: ptr
+    pad[18]
+}
+
+// NBPRegParam -- RegisterName (csCode 253) and ConfirmName (250).
+// `verifyFlag`@34 is `LookupConfirmParams.verifyFlag`
+// (AppleTalk.h:550-551): non-zero asks NBP to broadcast `count` lookups
+// at `interval` first and fail with nbpDuplicate if anyone answers.
+// That verification costs the full retry budget -- about 3.2 s at
+// interval 8 / count 3, measured (task-1-report.md P2).
+extern record NBPRegParam {
+    qLink: ptr
+    qType: word
+    ioTrap: word
+    ioCmdAddr: ptr
+    ioCompletion: ptr
+    ioResult: word
+    userData: int
+    reqTID: word
+    ioRefNum: word
+    csCode: word
+    interval: byte
+    count: byte
+    ntQElPtr: ptr
+    verifyFlag: byte
+    pad[17]
+}
+
+// NBPLookupParam -- LookupName (csCode 251), the Lookup arm of
+// LookupConfirmParams (AppleTalk.h:552-557): retBuffPtr@34,
+// retBuffSize@38, maxToGet@40, numGotten@42. `entityPtr`@30 points at a
+// PACKED three-Pascal-string entity (see the NTE note below);
+// `retBuffPtr` receives `numGotten` tuples, each `AddrBlock`(4) +
+// enumerator(1) + a packed entity (tupleAddr/tupleEnum/tupleEntity
+// below). Real NBPparms is 44 bytes; padded to 52 per Rule 1.
+extern record NBPLookupParam {
+    qLink: ptr
+    qType: word
+    ioTrap: word
+    ioCmdAddr: ptr
+    ioCompletion: ptr
+    ioResult: word
+    userData: int
+    reqTID: word
+    ioRefNum: word
+    csCode: word
+    interval: byte
+    count: byte
+    entityPtr: ptr
+    retBuffPtr: ptr
+    retBuffSize: word
+    maxToGet: word
+    numGotten: word
+    pad[8]
+}
+
+// ATPParam -- AppleTalk.h:816-841 (`SendReqparms`, the widest ATP arm at
+// 52 bytes), which is a strict superset of ATPparms (797-814). One
+// record covers every ATP csCode this catalog names; the three narrow
+// variant arms (ATPmisc1's bitMap/numOfBuffs/rspNum union at 44,
+// ATPmisc2's bdsSize@45 + transID@46, Killparms' aKillQEl@44) land
+// inside the same bytes and are reached by the atpBitMap / atpRspNum /
+// atpBdsSize / atpTransID offset constants below. AddrBlock@30
+// (AppleTalk.h:319-323) is aNet(2) aNode(1) aSocket(1), split here into
+// three named fields because `extern record` reads a nested record's
+// fields but a caller wants them individually. Padded to 56, the
+// header's own `atpSize` (AppleTalk.h:189), comfortably over the
+// 52-byte floor.
+extern record ATPParam {
+    qLink: ptr
+    qType: word
+    ioTrap: word
+    ioCmdAddr: ptr
+    ioCompletion: ptr
+    ioResult: word
+    userData: int
+    reqTID: word
+    ioRefNum: word
+    csCode: word
+    atpSocket: byte
+    atpFlags: byte
+    addrNet: word
+    addrNode: byte
+    addrSocket: byte
+    reqLength: word
+    reqPointer: ptr
+    bdsPointer: ptr
+    numOfBuffs: byte
+    timeOutVal: byte
+    numOfResps: byte
+    retryCount: byte
+    intBuff: word
+    TRelTime: byte
+    pad[5]
+}
+
+// XCallParam -- AppleTalk.h:765-786, the .XPP `xCall` block. The ZIP
+// zone calls (zipGetMyZone / zipGetLocalZones / zipGetZoneList) put
+// their selector in xppSubCode@28 and their reply in a caller-supplied
+// 578-byte buffer at zipBuffPtr@34. zipInfoField (70 bytes @42) is
+// ZIP's own continuation state: the caller zeroes its first word before
+// the first call of a sequence and then leaves it alone. Real size 112.
+extern record XCallParam {
+    qLink: ptr
+    qType: word
+    ioTrap: word
+    ioCmdAddr: ptr
+    ioCompletion: ptr
+    ioResult: word
+    cmdResult: int
+    ioVRefNum: word
+    ioRefNum: word
+    csCode: word
+    xppSubCode: word
+    xppTimeout: byte
+    xppRetry: byte
+    filler1: word
+    zipBuffPtr: ptr
+    zipNumZones: word
+    zipLastFlag: byte
+    filler2: byte
+    pad[70]
+}
+
+// DSPParam -- ADSP.h:193-216. Unlike the MPP/ATP blocks this one uses
+// the ordinary Device Manager prefix (ioNamePtr@18, ioVRefNum@22,
+// ioCRefNum@24) and adds qStatus@28 (ADSP internal) + ccbRefNum@32.
+// Everything past 34 is a union of eight variant arms (TRinitParams,
+// TRopenParams, TRcloseParams, TRioParams, TRattnParams,
+// TRstatusParams, TRoptionParams, TRnewcidParams, ADSP.h:124-192) whose
+// widest member ends at 68; it is captured here as one 34-byte pad and
+// reached through the dspXxx offset constants below. Real size 68.
+extern record DSPParam {
+    qLink: ptr
+    qType: word
+    ioTrap: word
+    ioCmdAddr: ptr
+    ioCompletion: ptr
+    ioResult: word
+    ioNamePtr: ptr
+    ioVRefNum: word
+    ioCRefNum: word
+    csCode: word
+    qStatus: int
+    ccbRefNum: word
+    pad[34]
+}
+
+// BDSElement -- AppleTalk.h:330-335. NOT a parameter block: it is one
+// element of the response-buffer descriptor ARRAY an ATP caller points
+// `bdsPointer`@40 at (BDSType is exactly 8 of these, AppleTalk.h:337),
+// so Rule 1's 52-byte floor does not apply -- its size is fixed at 12
+// by the wire contract. `extern record` cannot be an array element
+// (language reference, "extern record"), so a multi-entry BDS is built
+// with NewPtrClear + bdsEntrySz arithmetic and poked by offset; this
+// record is the one-entry case and the offset documentation for both.
+extern record BDSElement {
+    buffSize: word
+    buffPtr: ptr
+    dataSize: word
+    userBytes: int
+}
+
+// ---- Field offsets, for blocks allocated with NewPtrClear ----
+//
+// Async code (PBControlAsync above) and per-slot runtime state cannot
+// use the `extern record` locals above -- an extern record is never a
+// container element and has no address-of operator outside an
+// `external func` call site -- so it allocates its blocks with
+// NewPtrClear and reaches fields by offset with peekb/peekw/peekl and
+// pokeb/pokew/pokel. Every offset below is the same byte offset the
+// corresponding record field above occupies; they are stated separately
+// so that neither form is derived from the other by hand.
+
+// Device Manager prefix fields common to every block above.
+const pbIoResult: int = 16    // ioResult -- 1 (ioInProgress) until an async call completes
+const pbIoRefNum: int = 24    // ioRefNum / ioCRefNum
+const pbCsCode: int = 26      // csCode -- the call selector
+
+// NBP (AppleTalk.h:545-580).
+const nbpNtQElPtr: int = 30          // union NBPPtrs: ntQElPtr (register) / entityPtr (lookup, remove, confirm)
+const nbpVerifyFlag: int = 34        // LookupConfirmParams.verifyFlag
+const nbpLookupRetBuffPtr: int = 34  // LookupConfirmParams.Lookup.retBuffPtr
+const nbpLookupRetBuffSize: int = 38 // LookupConfirmParams.Lookup.retBuffSize
+const nbpLookupMaxToGet: int = 40    // LookupConfirmParams.Lookup.maxToGet
+const nbpLookupNumGotten: int = 42   // LookupConfirmParams.Lookup.numGotten
+const nbpConfirmAddr: int = 34       // LookupConfirmParams.Confirm.confirmAddr (AddrBlock)
+const nbpConfirmNewSocket: int = 38  // LookupConfirmParams.Confirm.newSocket
+const nbpSetSelfNewFlag: int = 28    // SetSelfparms.newSelfFlag (AppleTalk.h:582-595); oldSelfFlag is at 29
+
+// ATP (AppleTalk.h:797-908). atpBitMap/atpRspNum are the same union
+// byte under ATPmisc1's two names; atpBdsSize/atpTransID are ATPmisc2's.
+const atpUserData: int = 18   // userData -- the 4 ATP user bytes
+const atpReqTID: int = 22     // reqTID -- request transaction ID
+const atpBitMap: int = 44     // ATPmisc1.u.bitMap (GetRequest)
+const atpRspNum: int = 44     // ATPmisc1.u.rspNum (AddResponse) -- same byte
+const atpBdsSize: int = 45    // ATPmisc2.bdsSize
+const atpTransID: int = 46    // ATPmisc2.transID
+
+// ADSP DSPParamBlock variant arms (ADSP.h:124-216).
+const dspIoCRefNum: int = 24          // ioCRefNum (the .DSP driver refNum)
+const dspCcbRefNum: int = 32          // ccbRefNum
+const dspInitCcbPtr: int = 34         // TRinitParams.ccbPtr
+const dspInitUserRoutine: int = 38    // TRinitParams.userRoutine
+const dspInitSendQSize: int = 42      // TRinitParams.sendQSize
+const dspInitSendQueue: int = 44      // TRinitParams.sendQueue
+const dspInitRecvQSize: int = 48      // TRinitParams.recvQSize
+const dspInitRecvQueue: int = 50      // TRinitParams.recvQueue
+const dspInitAttnPtr: int = 54        // TRinitParams.attnPtr (attnBufSize bytes)
+const dspInitLocalSocket: int = 58    // TRinitParams.localSocket
+const dspOpenLocalCID: int = 34       // TRopenParams.localCID
+const dspOpenRemoteCID: int = 36      // TRopenParams.remoteCID
+const dspOpenRemoteAddress: int = 38  // TRopenParams.remoteAddress (AddrBlock)
+const dspOpenFilterAddress: int = 42  // TRopenParams.filterAddress (AddrBlock)
+const dspOpenSendSeq: int = 46        // TRopenParams.sendSeq
+const dspOpenSendWindow: int = 50     // TRopenParams.sendWindow
+const dspOpenRecvSeq: int = 52        // TRopenParams.recvSeq
+const dspOpenAttnSendSeq: int = 56    // TRopenParams.attnSendSeq
+const dspOpenAttnRecvSeq: int = 60    // TRopenParams.attnRecvSeq
+const dspOpenOcMode: int = 64         // TRopenParams.ocMode (ocRequest/ocPassive/ocAccept/ocEstablish)
+const dspOpenOcInterval: int = 65     // TRopenParams.ocInterval
+const dspOpenOcMaximum: int = 66      // TRopenParams.ocMaximum
+const dspCloseAbort: int = 34         // TRcloseParams.abort
+const dspIoReqCount: int = 34         // TRioParams.reqCount
+const dspIoActCount: int = 36         // TRioParams.actCount
+const dspIoDataPtr: int = 38          // TRioParams.dataPtr
+const dspIoEom: int = 42              // TRioParams.eom
+const dspIoFlush: int = 43            // TRioParams.flush
+const dspStatusCcb: int = 34          // TRstatusParams.statusCCB
+const dspStatusSendQPending: int = 38 // TRstatusParams.sendQPending
+const dspStatusSendQFree: int = 40    // TRstatusParams.sendQFree
+const dspStatusRecvQPending: int = 42 // TRstatusParams.recvQPending
+const dspStatusRecvQFree: int = 44    // TRstatusParams.recvQFree
+
+// ADSP connection control block, TRCCB (ADSP.h:105-116). ccbSize bytes,
+// allocated by the client with NewPtrClear and owned by ADSP after
+// dspInit. ccbLink@0 and refNum@4 are ADSP's; the rest is readable
+// state.
+const ccbState: int = 6           // TRCCB.state (sListening .. sClosed)
+const ccbUserFlags: int = 8       // TRCCB.userFlags (eClosed/eTearDown/eAttention/eFwdReset)
+const ccbLocalSocket: int = 9     // TRCCB.localSocket
+const ccbRemoteAddress: int = 10  // TRCCB.remoteAddress (AddrBlock)
+const ccbAttnCode: int = 14       // TRCCB.attnCode
+const ccbAttnSize: int = 16       // TRCCB.attnSize
+const ccbAttnPtr: int = 18        // TRCCB.attnPtr
+
+// ---- Names Table Entry and lookup tuples: PACKED, not Str32Field ----
+//
+// AppleTalk.h:305-310 says so in the header's own words: "Real
+// definition of EntityName is 3 PACKED strings of any length (32 is just
+// an example) ... So this will generate correct looking interfaces for
+// Pascal and C, but they will not be the same, which is OK since they
+// are not used." So `struct EntityName` (AppleTalk.h:312-316, three
+// Str32Field slots) must NOT be transcribed as an extern record -- the
+// wire and the driver both want object, type and zone as three Pascal
+// strings back to back, each exactly (length byte + length) long.
+//
+// A NamesTableEntry (AppleTalk.h:450-453 over NTElement, 444-448) is
+// therefore built with NewPtrClear(nteSize) + pokeb:
+//   qNext@0 (4, driver-owned)  nteAddress@4 (AddrBlock: net(2) node(1)
+//   socket(1))  filler@8 (1)  entityData@9 (99 bytes: the packed
+//   object/type/zone). 4+4+1+99 = 108 = nteSize.
+// Write the service's own socket to nteAddress+3 (= NTE+7) before
+// RegisterName -- Rule 3 above -- and read the node's own address back
+// out of nteAddress+0..3 afterwards.
+//
+// A LookupName reply tuple in retBuffPtr's buffer is the same idea
+// without the queue link: AddrBlock@0, enumerator@4, packed entity@5.
+const nteQNext: int = 0     // NamesTableEntry.qNext
+const nteAddress: int = 4   // NTElement.nteAddress -- net(2) node(1) socket(1)
+const nteEntity: int = 9    // NTElement.entityData -- packed object/type/zone
+const nteSize: int = 108    // sizeof(NamesTableEntry)
+const tupleAddr: int = 0    // LookupName reply tuple: AddrBlock
+const tupleEnum: int = 4    // LookupName reply tuple: enumerator byte
+const tupleEntity: int = 5  // LookupName reply tuple: packed object/type/zone

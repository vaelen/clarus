diff --git a/tests/tools/atalkdrive.c b/tests/tools/atalkdrive.c
new file mode 100644
index 0000000..1568108
--- /dev/null
+++ b/tests/tools/atalkdrive.c
@@ -0,0 +1,250 @@
+/* tests/tools/atalkdrive.c -- a real AppleTalk peer for the test scripts
+ * and the T2 emulator boots (2026-09-06 appletalk spec %6.2, Task 2), the
+ * sibling of tcpdrive. One process, no threads: it links the host's own
+ * LocalTalk-over-UDP stack (runtime/host/rt_atalk.inc, via rt.c) and
+ * drives it from a small CLI, so a test can register a name, look one up,
+ * call a service or BE a service without any Clarus program involved.
+ *
+ * usage: atalkdrive lookup TYPE [ZONE]
+ *        atalkdrive register OBJ TYPE SECS
+ *        atalkdrive call OBJ TYPE OP [--timeout S] [--retries N]
+ *        atalkdrive serve OBJ TYPE SECS SCRIPT
+ *
+ * Exit 0 on success, 1 on a transaction failure (reqFailed / name not
+ * found), 2 on a usage or argument error, 3 when `call` completed but the
+ * service answered a nonzero code (the reply is still written out), and 77
+ * with "SKIP: multicast unavailable" when the stack cannot open at all --
+ * the harness's own skip code, which the scripts propagate.
+ *
+ * CLARUS_ATALK_IFACE selects the interface on a multi-homed host, exactly
+ * as it does for a Clarus program.
+ */
+#include "rt.h"
+#include "rt_atalk.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/time.h>
+
+#define MAXOPS 32
+
+static const char USAGE[] =
+"usage: atalkdrive lookup TYPE [ZONE]\n"
+"       atalkdrive register OBJ TYPE SECS\n"
+"       atalkdrive call OBJ TYPE OP [--timeout S] [--retries N]\n"
+"       atalkdrive serve OBJ TYPE SECS SCRIPT\n"
+"\n"
+"lookup   prints one line per entity: \"net.node.socket obj:type@zone\"\n"
+"register registers OBJ:TYPE on a fresh ATP socket, prints\n"
+"         \"registered node=N sock=S\", idles SECS, then removes it\n"
+"call     request body on stdin, reply on stdout, \"code N\" on stderr\n"
+"serve    SCRIPT lines are \"OP CODE REPLYFILE\"; an op the script does not\n"
+"         name is answered with code -1 and an empty reply. Each request is\n"
+"         logged to stderr as \"request op=N len=L from=A\".\n"
+"\n"
+"exit 0 = ok; 1 = transaction failed; 2 = usage; 3 = call answered a\n"
+"nonzero code; 77 = multicast unavailable (SKIP).\n";
+
+static int usage(void) { fputs(USAGE, stderr); return 2; }
+
+static rt_atalk *A;
+
+static double now_s(void) {
+    struct timeval tv;
+    gettimeofday(&tv, NULL);
+    return (double)tv.tv_sec + (double)tv.tv_usec / 1e6;
+}
+
+/* pump: poll the stack for `secs` seconds (10 ms granularity). */
+static void pump(double secs) {
+    double end = now_s() + secs;
+    do {
+        rt_at_poll(A);
+        usleep(10000);
+    } while (now_s() < end);
+}
+
+static int open_stack(void) {
+    A = rt_at_open(getenv("CLARUS_ATALK_IFACE"));
+    if (A == NULL) {
+        fprintf(stderr, "SKIP: multicast unavailable (%s)\n", strerror(errno));
+        return 77;
+    }
+    return 0;
+}
+
+/* wait_lookup: pump until the lookup's own 3 x 1 s window closes. */
+static void wait_lookup(int lk) {
+    double guard = now_s() + 10.0;
+    while (!rt_at_nbp_lookup_done(A, lk) && now_s() < guard) pump(0.05);
+}
+
+static int cmd_lookup(const char *type, const char *zone) {
+    int i, n;
+    rt_at_nbp_lookup_start(A, 0, "=", type, zone);
+    wait_lookup(0);
+    n = rt_at_nbp_lookup_count(A, 0);
+    for (i = 0; i < n; i++) {
+        const rt_at_tuple *t = rt_at_nbp_lookup_get(A, 0, i);
+        printf("%u.%u.%u %s:%s@%s\n", (unsigned)t->addr.net, (unsigned)t->addr.node,
+               (unsigned)t->addr.socket, t->obj, t->type, t->zone);
+    }
+    fflush(stdout);
+    return 0;
+}
+
+static int cmd_register(const char *obj, const char *type, double secs) {
+    int sock = rt_at_atp_open(A), rc;
+    if (sock < 0) { fprintf(stderr, "atp_open: %d\n", sock); return 1; }
+    rc = rt_at_nbp_register(A, obj, type, (uint8_t)sock);
+    if (rc != 0) { fprintf(stderr, "register: %d\n", rc); return 1; }
+    printf("registered node=%u sock=%d\n", (unsigned)rt_at_node(A), sock);
+    fflush(stdout);
+    pump(secs);
+    rt_at_nbp_remove(A, obj, type);
+    return 0;
+}
+
+/* find_one: NBP-resolve obj:type to a single address. 0 on success. */
+static int find_one(const char *obj, const char *type, rt_at_addr *out) {
+    const rt_at_tuple *t;
+    rt_at_nbp_lookup_start(A, 0, obj, type, "*");
+    wait_lookup(0);
+    if (rt_at_nbp_lookup_count(A, 0) < 1) return -1;
+    t = rt_at_nbp_lookup_get(A, 0, 0);
+    *out = t->addr;
+    return 0;
+}
+
+static int cmd_call(const char *obj, const char *type, int op, int timeout_s, int retries) {
+    uint8_t req[RT_AT_MAXREQ], resp[RT_AT_MAXRESP];
+    rt_at_addr to;
+    size_t reqlen;
+    int rlen = 0, rc;
+    int32_t code = 0;
+
+    reqlen = fread(req, 1, sizeof(req), stdin);
+    if (find_one(obj, type, &to) != 0) {
+        fprintf(stderr, "not found: %s:%s\n", obj, type);
+        return 1;
+    }
+    rc = rt_at_atp_call(A, to, op, req, (int)reqlen, resp, (int)sizeof(resp),
+                        &rlen, &code, timeout_s, retries);
+    if (rc != 0) {
+        fprintf(stderr, "call failed: %d\n", rc);
+        return 1;
+    }
+    if (rlen > 0) fwrite(resp, 1, (size_t)rlen, stdout);
+    fflush(stdout);
+    fprintf(stderr, "code %d\n", (int)code);
+    return code != 0 ? 3 : 0;
+}
+
+/* --- serve: the op table ------------------------------------------- */
+typedef struct {
+    int     op;
+    int32_t code;
+    uint8_t body[RT_AT_MAXRESP];
+    int     len;
+} op_entry;
+
+static op_entry ops[MAXOPS];
+static int nops;
+
+/* load_script: lines "OP CODE REPLYFILE"; blanks and #-comments ignored.
+ * REPLYFILE "-" means an empty reply. */
+static int load_script(const char *path) {
+    char line[1024];
+    FILE *f = fopen(path, "r");
+    if (f == NULL) { fprintf(stderr, "cannot open script %s\n", path); return 2; }
+    while (fgets(line, sizeof(line), f) != NULL) {
+        char file[512];
+        int op, code;
+        if (line[0] == '#' || line[0] == '\n' || line[0] == '\0') continue;
+        if (sscanf(line, "%d %d %511s", &op, &code, file) != 3) continue;
+        if (nops >= MAXOPS) { fprintf(stderr, "too many ops\n"); fclose(f); return 2; }
+        ops[nops].op = op;
+        ops[nops].code = code;
+        ops[nops].len = 0;
+        if (strcmp(file, "-") != 0) {
+            FILE *r = fopen(file, "rb");
+            if (r == NULL) { fprintf(stderr, "cannot open reply %s\n", file); fclose(f); return 2; }
+            ops[nops].len = (int)fread(ops[nops].body, 1, sizeof(ops[nops].body), r);
+            fclose(r);
+        }
+        nops++;
+    }
+    fclose(f);
+    return 0;
+}
+
+static int cmd_serve(const char *obj, const char *type, double secs, const char *script) {
+    int sock, rc, i;
+    double end;
+
+    rc = load_script(script);
+    if (rc != 0) return rc;
+    sock = rt_at_atp_open(A);
+    if (sock < 0) { fprintf(stderr, "atp_open: %d\n", sock); return 1; }
+    rc = rt_at_nbp_register(A, obj, type, (uint8_t)sock);
+    if (rc != 0) { fprintf(stderr, "register: %d\n", rc); return 1; }
+    printf("serving node=%u sock=%d\n", (unsigned)rt_at_node(A), sock);
+    fflush(stdout);
+
+    end = now_s() + secs;
+    while (now_s() < end) {
+        rt_at_req req;
+        rt_at_poll(A);
+        while (rt_at_atp_get_request(A, sock, &req)) {
+            const op_entry *e = NULL;
+            fprintf(stderr, "request op=%d len=%d from=%u.%u.%u\n",
+                    (int)req.userbytes, req.len, (unsigned)req.from.net,
+                    (unsigned)req.from.node, (unsigned)req.from.socket);
+            for (i = 0; i < nops; i++) if (ops[i].op == (int)req.userbytes) e = &ops[i];
+            if (e != NULL) rt_at_atp_send_response(A, sock, &req, e->code, e->body, e->len);
+            else           rt_at_atp_send_response(A, sock, &req, -1, NULL, 0);
+        }
+        usleep(10000);
+    }
+    rt_at_nbp_remove(A, obj, type);
+    rt_at_atp_close(A, sock);
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    int rc;
+
+    if (argc < 2) return usage();
+
+    if (strcmp(argv[1], "lookup") == 0) {
+        if (argc < 3 || argc > 4) return usage();
+        rc = open_stack(); if (rc != 0) return rc;
+        rc = cmd_lookup(argv[2], argc == 4 ? argv[3] : "*");
+    } else if (strcmp(argv[1], "register") == 0) {
+        if (argc != 5) return usage();
+        rc = open_stack(); if (rc != 0) return rc;
+        rc = cmd_register(argv[2], argv[3], atof(argv[4]));
+    } else if (strcmp(argv[1], "call") == 0) {
+        int timeout_s = 2, retries = 3, i;
+        if (argc < 5) return usage();
+        for (i = 5; i < argc; i++) {
+            if (strcmp(argv[i], "--timeout") == 0 && i + 1 < argc) timeout_s = atoi(argv[++i]);
+            else if (strcmp(argv[i], "--retries") == 0 && i + 1 < argc) retries = atoi(argv[++i]);
+            else return usage();
+        }
+        rc = open_stack(); if (rc != 0) return rc;
+        rc = cmd_call(argv[2], argv[3], atoi(argv[4]), timeout_s, retries);
+    } else if (strcmp(argv[1], "serve") == 0) {
+        if (argc != 6) return usage();
+        rc = open_stack(); if (rc != 0) return rc;
+        rc = cmd_serve(argv[2], argv[3], atof(argv[4]), argv[5]);
+    } else {
+        return usage();
+    }
+
+    rt_at_close(A);
+    return rc;
+}
diff --git a/testsuite/toolbox/cases_atalk.cla b/testsuite/toolbox/cases_atalk.cla
new file mode 100644
index 0000000..31f3df6
--- /dev/null
+++ b/testsuite/toolbox/cases_atalk.cla
@@ -0,0 +1,222 @@
+// Copyright 2026, Andrew C. Young <andrew@vaelen.org>
+// SPDX-License-Identifier: MIT
+
+// cases_atalk.cla: AtalkSelf (AppleTalk phase Task 6) -- hardware-proves
+// the shipped toolbox/appletalk.cla catalog against real ROM AppleTalk,
+// in-process, the same "the catalog files supply the externs, this case
+// only calls them" discipline cases_catalog.cla and cases_serial.cla
+// already establish. It opens the real .MPP and .ATP drivers, registers
+// an NBP name with verification on, reads its own net/node back out of
+// the Names Table Entry, looks up a type nothing has registered, removes
+// the name, then opens and closes a dynamic ATP socket.
+//
+// WHAT THIS CASE DELIBERATELY DOES NOT DO, and why. The design spec's
+// original sketch was a self-lookup (find our own registered name) and
+// an ATP self-transaction (async getRequest + sync sendRequest to our
+// own address). Task 1's probe wave (task-1-report.md P3, Amendment 3)
+// proved all three legs of that unavailable on the Mac Plus ROM .MPP,
+// which is what this suite boots:
+//   - `setSelfSend` (csCode 256) returns -17 (controlErr): the ROM .MPP
+//     does not implement it, and the AppleTalk 58 System file whose
+//     .MPP would is not on LaunchAPPL's stripped boot disk (P1).
+//   - a self-lookup therefore returns err 0 with numGotten 0, before and
+//     after that call.
+//   - a self-directed ATP sendRequest fails -1096 (reqFailed) after its
+//     full retry budget, and the paired async getRequest never
+//     completes.
+// So the assertions below are exactly Amendment 3's table -- every row
+// of it, and nothing that was not observed on real hardware. Note in
+// particular that the node number is NOT asserted against a fixed value:
+// it is acquired by LLAP at boot and differs run to run (106 and 18 were
+// both seen). .XPP and .DSP are not opened at all: both are -43 (fnfErr)
+// on this boot disk, and a harness fix for that is scheduled separately.
+//
+// Runtime cost: about 6.5 seconds. `registerName` with verifyFlag on
+// broadcasts `count` lookups at `interval` before returning, and
+// `lookupName` runs its full retry budget even when an answer arrives
+// early (task-1-report.md P2) -- ~3.2 s each at interval 8 / count 3.
+//
+// Every parameter block below is a FRESH extern-record local, one per
+// call, never reused: toolbox/appletalk.cla's Rule 2, which cost Task 1
+// three hard hangs of the emulated Mac before it was understood. An
+// extern record local is zero-initialized on declaration (language
+// reference, "extern record"), so this shape satisfies the rule by
+// construction.
+
+// atPStr writes `s` as a Pascal string at `p` and returns the address
+// one byte past its end -- so three back-to-back calls build the PACKED
+// object/type/zone entity NBP actually wants (toolbox/appletalk.cla's
+// own NTE note: `struct EntityName`'s three Str32Field slots are a
+// Pascal/C interface fiction, per AppleTalk.h's own comment). Same
+// NewPtr+pokeb technique toolbox/devices.cla documents for ioNamePtr and
+// cases_serial.cla's `serPName` demonstrates; kept local to this file
+// rather than shared, so each case file stands on its own.
+func atPStr(p: ptr, s: string): ptr {
+    var i: int
+    pokeb(p, s.length)
+    i = 0
+    while i < s.length {
+        pokeb(p + 1 + i, int(s[i]))
+        i = i + 1
+    }
+    return p + 1 + s.length
+}
+
+func caseAtalkSelf(): TestResult {
+    var mppPb: IOParam
+    var atpPb: IOParam
+    var regPb: NBPRegParam
+    var lkPb: NBPLookupParam
+    var rmPb: NBPParam
+    var skOpenPb: ATPParam
+    var skClosePb: ATPParam
+    var nm: ptr
+    var end: ptr
+    var nte: ptr
+    var lkEntity: ptr
+    var lkBuf: ptr
+    var err: int
+    var mppRef: int
+    var atpRef: int
+    var net: int
+    var node: int
+    var sock: int
+    var detail: string
+
+    // -- 1. Open .MPP. It lives in the Mac Plus ROM, so this works with
+    // no AppleTalk System file present, and the OS hands back the
+    // documented static refNum.
+    nm = NewPtrClear(8)
+    end = atPStr(nm, ".MPP")
+    mppPb.ioNamePtr = nm
+    err = PBOpenSync(mppPb)
+    mppRef = mppPb.ioRefNum
+    if err != 0 or mppRef != mppRefNum {
+        detail = "open .MPP err " + tkIntToStr(err)
+        detail = detail + " refNum " + tkIntToStr(mppRef)
+        return tkFail("AtalkSelf", detail)
+    }
+
+    // -- 2. Register "AtalkSelf:ClarusSuite@*" with verification on.
+    // The NTE is 108 bytes: qNext(4) nteAddress(4) filler(1) then the
+    // packed entity at +9. Rule 3 of toolbox/appletalk.cla says a real
+    // service must poke its own listening socket into NTE+7
+    // (nteAddress + 3) BEFORE this call, because NBP copies that byte
+    // through verbatim. This case leaves it 0 on purpose: the name
+    // exists only long enough to prove register/lookup/remove, and
+    // nothing ever connects to it.
+    // The object name carries a TickCount suffix (toolbox/events.cla's
+    // TickCount, the same trap cases_catalog.cla uses). A fixed name
+    // only collides if two suite boots share one LocalTalk net at the
+    // same moment -- which Task 11's two-emulator harness is about to
+    // make possible -- and a collision would fail registerName with
+    // nbpDuplicate, since verifyFlag is on.
+    nte = NewPtrClear(nteSize)
+    end = atPStr(nte + nteEntity, "AtalkSelf-" + string(TickCount() mod 10000))
+    end = atPStr(end, "ClarusSuite")
+    end = atPStr(end, "*")
+    regPb.ioRefNum = mppRef
+    regPb.csCode = registerName
+    regPb.interval = 8
+    regPb.count = 3
+    regPb.ntQElPtr = nte
+    regPb.verifyFlag = 1
+    err = PBControlSync(regPb)
+    if err != 0 {
+        detail = "registerName err " + tkIntToStr(err)
+        return tkFail("AtalkSelf", detail)
+    }
+
+    // -- 3. registerName filled our own address into the NTE
+    // (task-1-report.md Amendment 4 -- the cheapest way to learn it, no
+    // GetNodeAddress glue and no low-memory poking). Net is 0 on a
+    // routerless LocalTalk net, which is what the emulator lane is; the
+    // node is acquired per boot, so only its legal range is asserted.
+    net = peekw(nte + nteAddress)
+    node = peekb(nte + nteAddress + 2)
+    if net != 0 or node < 1 or node > 254 {
+        detail = "nteAddress net " + tkIntToStr(net)
+        detail = detail + " node " + tkIntToStr(node)
+        return tkFail("AtalkSelf", detail)
+    }
+
+    // -- 4. Look up a type nothing has registered. This is the honest
+    // no-peer NBP proof available on this ROM: the CALL succeeds (err 0)
+    // and finds nothing (numGotten 0). A lookup of our OWN type would
+    // also return 0 gotten here -- the ROM never answers its own
+    // lookups -- so it would prove nothing this does not.
+    lkEntity = NewPtrClear(64)
+    end = atPStr(lkEntity, "=")
+    end = atPStr(end, "ClarusNoSuch")
+    end = atPStr(end, "*")
+    // 8, not 16: a reply tuple is AddrBlock(4) + enumerator(1) + three
+    // packed Pascal strings, at most 104 bytes, so maxToGet and
+    // retBuffSize have to agree -- 8 x 104 = 832 fits in 1024, 16 would
+    // not (1664) and NBP would answer nbpBuffOvr instead of 0 gotten.
+    lkBuf = NewPtrClear(1024)
+    lkPb.ioRefNum = mppRef
+    lkPb.csCode = lookupName
+    lkPb.interval = 8
+    lkPb.count = 3
+    lkPb.entityPtr = lkEntity
+    lkPb.retBuffPtr = lkBuf
+    lkPb.retBuffSize = 1024
+    lkPb.maxToGet = 8
+    err = PBControlSync(lkPb)
+    if err != 0 or lkPb.numGotten != 0 {
+        detail = "lookupName err " + tkIntToStr(err)
+        detail = detail + " numGotten " + tkIntToStr(lkPb.numGotten)
+        return tkFail("AtalkSelf", detail)
+    }
+
+    // -- 5. Remove the name. RemoveName takes the ENTITY (the packed
+    // object/type/zone at NTE+9), not the NTE itself -- the other arm of
+    // AppleTalk.h's `union NBPPtrs` at the same offset 30.
+    rmPb.ioRefNum = mppRef
+    rmPb.csCode = removeName
+    rmPb.entityPtr = nte + nteEntity
+    err = PBControlSync(rmPb)
+    if err != 0 {
+        detail = "removeName err " + tkIntToStr(err)
+        return tkFail("AtalkSelf", detail)
+    }
+
+    // -- 6. Open .ATP -- also ROM-resident, also a static refNum.
+    nm = NewPtrClear(8)
+    end = atPStr(nm, ".ATP")
+    atpPb.ioNamePtr = nm
+    err = PBOpenSync(atpPb)
+    atpRef = atpPb.ioRefNum
+    if err != 0 or atpRef != atpRefNum {
+        detail = "open .ATP err " + tkIntToStr(err)
+        detail = detail + " refNum " + tkIntToStr(atpRef)
+        return tkFail("AtalkSelf", detail)
+    }
+
+    // -- 7. openATPSkt with atpSocket 0 asks for any free dynamic
+    // socket; DDP's dynamic range is 128..254 (Inside Macintosh II
+    // ch. 10). Task 1 saw 202.
+    skOpenPb.ioRefNum = atpRef
+    skOpenPb.csCode = openATPSkt
+    skOpenPb.atpSocket = 0
+    err = PBControlSync(skOpenPb)
+    sock = skOpenPb.atpSocket
+    if err != 0 or sock < 128 or sock > 254 {
+        detail = "openATPSkt err " + tkIntToStr(err)
+        detail = detail + " socket " + tkIntToStr(sock)
+        return tkFail("AtalkSelf", detail)
+    }
+
+    // -- 8. Close it again, from a FRESH block (Rule 2). The suite boot
+    // must leave no ATP socket behind for later cases.
+    skClosePb.ioRefNum = atpRef
+    skClosePb.csCode = closeATPSkt
+    skClosePb.atpSocket = sock
+    err = PBControlSync(skClosePb)
+    if err != 0 {
+        detail = "closeATPSkt err " + tkIntToStr(err)
+        return tkFail("AtalkSelf", detail)
+    }
+
+    return tkPass("AtalkSelf")
+}

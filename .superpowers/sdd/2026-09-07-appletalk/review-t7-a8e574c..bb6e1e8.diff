@@ -0,0 +1,16 @@
+// Copyright 2026, Andrew C. Young <andrew@vaelen.org>
+// SPDX-License-Identifier: MIT
+
+// AppleTalk phase, Task 7: the splice fixture. Declares the two resource
+// types that set the checker's usesAtalk and NOTHING else -- no method
+// call, because lowering every AppleTalk method is still fenced until
+// Task 8. That is enough to require the whole host splice (conn.cla,
+// conn_c.cla, atalk.cla, atalk_c.cla), so tests/atalk/splice.sh's build
+// is the proof that all four modules check and compile together.
+
+var svc: service
+var brs: serviceBrowser
+
+on App.startCLI(args: list of string) {
+    log("atalk splice fixture")
+}

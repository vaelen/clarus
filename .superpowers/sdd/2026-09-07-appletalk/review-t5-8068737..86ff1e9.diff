+    idleRegs.add(-1)
+    irRegisterExtern(intern("ConnHIdle"), irVoidT, idleTys, -1, 0, -1, idleRegs, -1)
+
+    head = -1
+    tail = -1
+    idx = 0
+    e = irEveryHead
